# SPDX-License-Identifier: MIT-0

# Normalize line endings to LF in the repository and checkout.
* text=auto eol=lf

# Preserve binary artifacts byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# The delivered research packages are archived byte-for-byte: seven of them ship
# a SHA256 manifest over their own files, which line-ending normalization would
# invalidate on checkout.
docs/reports/** -text
