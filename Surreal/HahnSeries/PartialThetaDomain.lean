import Mathlib.Algebra.Group.Submonoid.Pointwise
import Mathlib.Algebra.Order.Archimedean.Class
import Mathlib.Data.Finset.MulAntidiagonal
import Mathlib.Tactic.LinearCombination
import Surreal.HahnSeries.EscapeChain
import Surreal.HahnSeries.ScaleIdeal

/-!
# Exact strong evaluation domain of the partial theta series

This file formalizes `hol:thm:thetadomain` of
`docs/surcomplex/holonomic-rigidity-for-entire-hahn-functions/article.tex`, with the displayed
equations around it, the monoid certificate `hol:lem:certificate` (b) on which its proof rests,
and the positive halves of `hol:main:q` and `hol:cor:detect` that the partial theta series
witnesses.

The value group `Γ` is an arbitrary linearly ordered abelian group; neither divisibility nor
`Γ ≠ 0` is assumed (`hol:conv:group`). The coefficient field `ℂ` of the source is generalized
to any semiring without zero divisors for the domain theorem, to any commutative (semi)ring for
the formal identities, and to any field where `q⁻¹` occurs. As in `EscapeChain.lean`, the
valuation `v` is `HahnSeries.order`. Some statements (`thetaMonoid`, `thetaExponent`,
`support_theta_term`, `stronglySummable_partialTheta_of_le`) take orders of possibly zero
elements, which have Mathlib's junk value `order 0 = 0`; they remain true in that case (for
`x = 0` this is noted at `stronglySummable_partialTheta_of_le`). The hypotheses `0 < p.order`
and `IsOrderUnit |q.order|` force `p` and `q` to be nonzero.

* `scaleSubgroup β` is `Δ_β` of `hol:eq:delta`. It is convex
  (`mem_scaleSubgroup_of_le_of_le`), contains `β` when `β ≥ 0`, and lies in every convex
  subgroup containing `β` (`scaleSubgroup_le`), so it is the smallest such subgroup. It is
  everything exactly for an order unit (`isOrderUnit_iff_scaleSubgroup_eq_top`), it coincides
  with Mathlib's closed Archimedean ball of `β`, and positive elements outside it dominate
  every `Nβ` (`nsmul_lt_of_notMem_scaleSubgroup`, `hol:eq:dominates`). It is the same
  subgroup as `Surreal.ScaleIdeal.scaleSubgroup β`
  (`scaleSubgroup_eq_scaleIdeal_scaleSubgroup`).
* The ordered quotient `Γ/Δ_β` is represented through its nonnegative cone `QuotNonneg`: the
  class of `δ` is nonnegative when `δ` lies above some element of the subgroup, which for a
  convex subgroup means that the class is zero or the class of a positive element
  (`quotNonneg_mk_iff_of_convex`). The order on the quotient is not constructed as a
  `LinearOrder` instance.
* `stronglySummable_of_support_subset` is `hol:lem:certificate` (b) for an arbitrary index
  type and an arbitrary partially well-ordered offset set `M`;
  `stronglySummable_of_support_subset_closure` is the source form with `M = M(S)`, where only
  `S ≥ 0` (not `S > 0`) is needed. `stronglySummable_of_finite_order_le` is criterion (a) of
  the same lemma, again for an arbitrary index type.
* `partialTheta p` is `Θ_p` of `hol:eq:theta`; `partialTheta_eq_one_add_X_mul` is
  `hol:eq:thetafirst`, `partialTheta_hom` is `hol:eq:thetahom` and `partialTheta_inv_hom` is
  `hol:eq:inverseq`, all as identities of formal power series over the Hahn ring.
* `support_theta_term` and `order_theta_term` are `hol:eq:thetasupport`, with the common
  monoid `thetaMonoid p x` generated by the normalized supports of `p` and `x`.
* `mem_strongDomain_partialTheta_iff`, `strongDomain_partialTheta` and
  `strongDomain_partialTheta_eq_quotNonneg` are `hol:thm:thetadomain` with both lines of
  `hol:eq:thetadomain`, and `isStronglyEntire_partialTheta_iff` is its order-unit clause.
  Over a field, `strongDomain_partialTheta_eq_coarseValuationSubring` states the second line
  as "`Dom(Θ_p)` is the valuation ring `Surreal.ScaleIdeal.coarseValuationSubring β` of
  `v mod Δ_β`". No monomial hypothesis on `p` or `x` is made.
* `IsQDifferenceFinite` is linear `q`-difference finiteness, the `q`-difference half of
  `hol:def:operators` (`hol:eq:qlinear`); D-finiteness (`hol:eq:dlinear`) is not defined here.
  `exists_nonpolynomial_entire_of_isOrderUnit` is the implication (ii) ⇒ (i) of `hol:main:q`,
  with the witness named: it is the partial theta series with parameter `q` or `q⁻¹`.
  `exists_nontorsion_of_isOrderUnit` is the implication (i) ⇒ (ii) of `hol:cor:detect`.

The converse implications of `hol:main:q` and `hol:cor:detect` (which rest on
`hol:cor:unitrigid` and `hol:prop:noncofinal`), the uniform exterior obstruction of
`hol:main:q`, the block-grouping clause of `hol:lem:certificate`, and the
remarks `hol:rem:thetasecond` and `hol:rem:thetacoarse` are not formalized here.
-/

namespace Surreal.Holonomic

open _root_.HahnSeries
open scoped Pointwise

noncomputable section

section ScaleSubgroup

variable {Γ : Type*} [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]

/-- `hol:eq:delta`: `Δ_β = {γ ∈ Γ : |γ| ≤ Nβ for some N ∈ ℕ}`, as an additive subgroup. -/
def scaleSubgroup (β : Γ) : AddSubgroup Γ where
  carrier := {γ | ∃ N : ℕ, |γ| ≤ N • β}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro a b ⟨N, hN⟩ ⟨M, hM⟩
    refine ⟨N + M, (abs_add_le a b).trans ?_⟩
    rw [add_nsmul]
    exact add_le_add hN hM
  neg_mem' := by
    rintro a ⟨N, hN⟩
    exact ⟨N, by rwa [abs_neg]⟩

theorem mem_scaleSubgroup {β γ : Γ} : γ ∈ scaleSubgroup β ↔ ∃ N : ℕ, |γ| ≤ N • β :=
  Iff.rfl

theorem self_mem_scaleSubgroup {β : Γ} (hβ : 0 ≤ β) : β ∈ scaleSubgroup β :=
  ⟨1, by rw [abs_of_nonneg hβ, one_nsmul]⟩

/-- `Δ_β` is the scale subgroup `H_β` of `epd:def:orderunit`, formalized as
`Surreal.ScaleIdeal.scaleSubgroup`; both have the carrier `{γ | ∃ N, |γ| ≤ N • β}`. -/
theorem scaleSubgroup_eq_scaleIdeal_scaleSubgroup (β : Γ) :
    scaleSubgroup β = Surreal.ScaleIdeal.scaleSubgroup β := by
  ext γ
  exact Iff.rfl

/-- `Δ_β` is convex. -/
theorem mem_scaleSubgroup_of_le_of_le {β a b c : Γ} (ha : a ∈ scaleSubgroup β)
    (hb : b ∈ scaleSubgroup β) (hac : a ≤ c) (hcb : c ≤ b) : c ∈ scaleSubgroup β := by
  obtain ⟨N, hN⟩ := ha
  obtain ⟨M, hM⟩ := hb
  refine ⟨N + M, ?_⟩
  rw [add_nsmul]
  calc |c| ≤ max |a| |b| := abs_le_max_abs_abs hac hcb
    _ ≤ |a| + |b| := max_le_add_of_nonneg (abs_nonneg a) (abs_nonneg b)
    _ ≤ N • β + M • β := add_le_add hN hM

/-- `Δ_β` lies in every convex subgroup containing `β`; together with
`mem_scaleSubgroup_of_le_of_le` and `self_mem_scaleSubgroup`, it is the smallest convex subgroup
containing `β ≥ 0`, as stated after `hol:eq:delta`. -/
theorem scaleSubgroup_le {β : Γ} {H : AddSubgroup Γ} (hβ : β ∈ H)
    (hconv : ∀ a ∈ H, ∀ b ∈ H, ∀ c, a ≤ c → c ≤ b → c ∈ H) : scaleSubgroup β ≤ H := by
  rintro γ ⟨N, hN⟩
  have habs : |γ| ∈ H := hconv 0 H.zero_mem _ (H.nsmul_mem hβ N) _ (abs_nonneg γ) hN
  rcases abs_choice γ with h | h
  · rwa [h] at habs
  · rw [h] at habs
    exact neg_mem_iff.mp habs

/-- `Δ_β` is Mathlib's closed Archimedean ball of `β` when `β > 0`. -/
theorem scaleSubgroup_eq_closedBallAddSubgroup {β : Γ} (hβ : 0 < β) :
    scaleSubgroup β = ArchimedeanClass.closedBallAddSubgroup (ArchimedeanClass.mk β) := by
  ext γ
  rw [ArchimedeanClass.mem_closedBallAddSubgroup_iff, ArchimedeanClass.mk_le_mk,
    abs_of_pos hβ]
  exact Iff.rfl

/-- After `hol:eq:delta`: `Δ_β` is all of `Γ` exactly when `β` is an order unit. -/
theorem isOrderUnit_iff_scaleSubgroup_eq_top {β : Γ} (hβ : 0 < β) :
    IsOrderUnit β ↔ scaleSubgroup β = ⊤ := by
  constructor
  · rintro ⟨-, hu⟩
    exact eq_top_iff.mpr fun γ _ => hu γ
  · intro h
    refine ⟨hβ, fun γ => ?_⟩
    rw [← mem_scaleSubgroup, h]
    exact AddSubgroup.mem_top γ

/-- `hol:eq:dominates`: a positive element outside `Δ_β` exceeds every ordinary multiple
of `β`. -/
theorem nsmul_lt_of_notMem_scaleSubgroup {β γ : Γ} (hγ : 0 < γ) (hΔ : γ ∉ scaleSubgroup β)
    (N : ℕ) : N • β < γ := by
  by_contra h
  exact hΔ ⟨N, by rw [abs_of_pos hγ]; exact not_lt.mp h⟩

/-- The nonnegative cone of the quotient order on `Γ ⧸ H`: the class `c` is nonnegative when
one of its representatives lies above some element of `H`. For a convex subgroup this is the
set of classes that are zero or positive in the ordered quotient group, see
`quotNonneg_mk_iff_of_convex`. -/
def QuotNonneg (H : AddSubgroup Γ) (c : Γ ⧸ H) : Prop :=
  ∃ δ : Γ, (δ : Γ ⧸ H) = c ∧ ∃ d ∈ H, d ≤ δ

/-- Nonnegativity of a class does not depend on the chosen representative. -/
theorem quotNonneg_mk_iff {H : AddSubgroup Γ} {δ : Γ} :
    QuotNonneg H (δ : Γ ⧸ H) ↔ ∃ d ∈ H, d ≤ δ := by
  constructor
  · rintro ⟨δ', hδ', d, hd, hle⟩
    rw [QuotientAddGroup.eq] at hδ'
    refine ⟨d + (-δ' + δ), H.add_mem hd hδ', ?_⟩
    calc d + (-δ' + δ) ≤ δ' + (-δ' + δ) := add_le_add hle le_rfl
      _ = δ := by abel
  · rintro ⟨d, hd, hle⟩
    exact ⟨δ, rfl, d, hd, hle⟩

/-- For a convex subgroup, the class of `δ` is nonnegative exactly when it is the zero class
or the class of a positive element. -/
theorem quotNonneg_mk_iff_of_convex {H : AddSubgroup Γ}
    (hconv : ∀ a ∈ H, ∀ b ∈ H, ∀ c, a ≤ c → c ≤ b → c ∈ H) {δ : Γ} :
    QuotNonneg H (δ : Γ ⧸ H) ↔ δ ∈ H ∨ 0 < δ := by
  rw [quotNonneg_mk_iff]
  constructor
  · rintro ⟨d, hd, hle⟩
    rcases le_or_gt δ 0 with h | h
    · exact Or.inl (hconv d hd 0 H.zero_mem δ hle h)
    · exact Or.inr h
  · rintro (h | h)
    · exact ⟨δ, h, le_rfl⟩
    · exact ⟨0, H.zero_mem, h.le⟩

/-- The final step of the proof of `hol:thm:thetadomain`: `δ ≥ -Nβ` for some `N ∈ ℕ` says
exactly that the image of `δ` in `Γ / Δ_β` is nonnegative. -/
theorem exists_neg_nsmul_le_iff_quotNonneg {β δ : Γ} (hβ : 0 ≤ β) :
    (∃ N : ℕ, -(N • β) ≤ δ) ↔ QuotNonneg (scaleSubgroup β) (δ : Γ ⧸ scaleSubgroup β) := by
  rw [quotNonneg_mk_iff]
  constructor
  · rintro ⟨N, hN⟩
    exact ⟨-(N • β), ⟨N, by rw [abs_neg, abs_of_nonneg (nsmul_nonneg hβ N)]⟩, hN⟩
  · rintro ⟨d, ⟨N, hN⟩, hle⟩
    exact ⟨N, (abs_le.mp hN).1.trans hle⟩

/-- The same condition, as in the proof of `hol:thm:thetadomain`: the class of `δ` modulo
`Δ_β` is zero or positive. -/
theorem exists_neg_nsmul_le_iff_mem_or_pos {β δ : Γ} (hβ : 0 ≤ β) :
    (∃ N : ℕ, -(N • β) ≤ δ) ↔ δ ∈ scaleSubgroup β ∨ 0 < δ := by
  rw [exists_neg_nsmul_le_iff_quotNonneg hβ,
    quotNonneg_mk_iff_of_convex fun _ ha _ hb _ hac hcb =>
      mem_scaleSubgroup_of_le_of_le ha hb hac hcb]

end ScaleSubgroup

section Certificate

variable {Γ R : Type*} [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ] [AddCommMonoid R]

/-- `hol:lem:certificate` (b), general form: if every support satisfies
`supp(b_i) ⊆ h_i + M` for a partially well-ordered `M`, the set of values of `h` is partially
well ordered, and each value of `h` is taken by only finitely many indices, then `(b_i)` is
strongly summable. -/
theorem stronglySummable_of_support_subset {ι : Type*} (b : ι → R⟦Γ⟧) (h : ι → Γ) {M : Set Γ}
    (hM : M.IsPWO) (hH : (Set.range h).IsPWO) (hfib : ∀ g : Γ, {i | h i = g}.Finite)
    (hsupp : ∀ i, (b i).support ⊆ (h i + ·) '' M) : StronglySummable b := by
  rw [stronglySummable_iff]
  refine ⟨(hH.add hM).mono (Set.iUnion_subset fun i g hg => ?_), fun g => ?_⟩
  · obtain ⟨m, hm, rfl⟩ := hsupp i hg
    exact Set.add_mem_add (Set.mem_range_self i) hm
  · refine ((Set.AddAntidiagonal.finite_of_isPWO hH hM g).biUnion
      fun a _ => hfib a.1).subset fun i hi => ?_
    obtain ⟨m, hm, hg⟩ := hsupp i ((mem_support _ _).mpr hi)
    exact Set.mem_biUnion (x := (h i, m)) ⟨Set.mem_range_self i, hm, hg⟩
      (show h i = (h i, m).1 from rfl)

/-- `hol:lem:certificate` (b): if `supp(b_i) ⊆ h_i + M(S)` for a well-ordered `S` of
nonnegative elements, where `M(S)` is the additive monoid generated by `S`, the set of values
of `h` is well ordered and each value is taken by only finitely many indices, then `(b_i)` is
strongly summable. The source takes `S ⊆ Γ_{>0}`; nonnegativity suffices. -/
theorem stronglySummable_of_support_subset_closure {ι : Type*} (b : ι → R⟦Γ⟧) (h : ι → Γ)
    {S : Set Γ} (hS : S.IsPWO) (hpos : ∀ s ∈ S, 0 ≤ s) (hH : (Set.range h).IsPWO)
    (hfib : ∀ g : Γ, {i | h i = g}.Finite)
    (hsupp : ∀ i, (b i).support ⊆ (h i + ·) '' (AddSubmonoid.closure S : Set Γ)) :
    StronglySummable b :=
  stronglySummable_of_support_subset b h (hS.addSubmonoid_closure hpos) hH hfib hsupp

omit [IsOrderedAddMonoid Γ] in
/-- `hol:lem:certificate` (a): if the orders of the nonzero members tend cofinally to `+∞`,
meaning that for each `β` only finitely many nonzero `b_i` satisfy `v(b_i) ≤ β`, then `(b_i)`
is strongly summable. -/
theorem stronglySummable_of_finite_order_le {ι : Type*} (b : ι → R⟦Γ⟧)
    (hfin : ∀ β : Γ, {i | b i ≠ 0 ∧ (b i).order ≤ β}.Finite) : StronglySummable b := by
  have hmem : ∀ i g, g ∈ (b i).support → b i ≠ 0 ∧ (b i).order ≤ g := fun i g hg =>
    ⟨fun h0 => by simp [h0] at hg, order_le_of_coeff_ne_zero hg⟩
  rw [stronglySummable_iff_isWF]
  refine ⟨Set.isWF_iff_no_descending_seq.mpr fun f hf hU => ?_,
    fun g => (hfin g).subset fun i hi => hmem i g ((mem_support _ _).mpr hi)⟩
  have hF : (⋃ i ∈ (hfin (f 0)).toFinset, (b i).support).IsWF :=
    (Finset.isWF_bUnion _).mpr fun i _ => (b i).isWF_support
  refine Set.isWF_iff_no_descending_seq.mp hF f hf fun n => ?_
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hU n)
  obtain ⟨hne, hle⟩ := hmem i (f n) hi
  exact Set.mem_iUnion₂.mpr ⟨i, (Set.Finite.mem_toFinset _).mpr
    ⟨hne, hle.trans (hf.antitone (Nat.zero_le n))⟩, hi⟩

omit [AddCommGroup Γ] [IsOrderedAddMonoid Γ] in
/-- A sequence that is strictly increasing from the index `K` on has a well-ordered set of
values. -/
theorem isPWO_range_of_strictMono_add {f : ℕ → Γ} (K : ℕ)
    (hf : StrictMono fun m => f (K + m)) : (Set.range f).IsPWO := by
  have h1 : (f '' Set.Iio K).IsPWO := ((Set.finite_Iio K).image f).isPWO
  have h2 : (Set.range fun m => f (K + m)).IsPWO := by
    rw [← Set.image_univ]
    exact (Set.isPWO_of_wellQuasiOrderedLE _).image_of_monotone hf.monotone
  refine (h1.union h2).mono ?_
  rintro _ ⟨n, rfl⟩
  rcases lt_or_ge n K with hn | hn
  · exact Or.inl ⟨n, hn, rfl⟩
  · refine Or.inr ⟨n - K, ?_⟩
    show f (K + (n - K)) = f n
    rw [Nat.add_sub_of_le hn]

omit [AddCommGroup Γ] [IsOrderedAddMonoid Γ] in
/-- A sequence that is strictly increasing from the index `K` on takes each value only
finitely often. -/
theorem finite_fiber_of_strictMono_add {f : ℕ → Γ} (K : ℕ)
    (hf : StrictMono fun m => f (K + m)) (g : Γ) : {n | f n = g}.Finite := by
  have hsub : {m | f (K + m) = g}.Subsingleton := fun a ha b hb =>
    hf.injective ((show f (K + a) = g from ha).trans (show f (K + b) = g from hb).symm)
  refine ((Set.finite_Iio K).union (hsub.finite.image (K + ·))).subset fun n hn => ?_
  rcases lt_or_ge n K with hlt | hge
  · exact Or.inl hlt
  · refine Or.inr ⟨n - K, ?_, Nat.add_sub_of_le hge⟩
    show f (K + (n - K)) = g
    rw [Nat.add_sub_of_le hge]
    exact hn

end Certificate

section Theta

variable {Γ R : Type*} [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]

/-- The coefficient identity `binom(n+1, 2) = binom(n, 2) + n` behind `hol:eq:thetafirst`. -/
theorem choose_two_succ (n : ℕ) : (n + 1).choose 2 = n.choose 2 + n := by
  have h := Nat.choose_succ_succ' n 1
  simp only [Nat.reduceAdd, Nat.choose_one_right] at h
  omega

section Semiring

variable [Semiring R]

/-- `hol:eq:theta`: the partial theta series `Θ_p(z) = ∑_{n ≥ 0} p^{binom(n, 2)} z^n`. -/
def partialTheta (p : R⟦Γ⟧) : PowerSeries R⟦Γ⟧ :=
  PowerSeries.mk fun n => p ^ n.choose 2

theorem coeff_partialTheta (p : R⟦Γ⟧) (n : ℕ) :
    PowerSeries.coeff n (partialTheta p) = p ^ n.choose 2 :=
  PowerSeries.coeff_mk _ _

/-- Support arithmetic for products: if `supp(x) ⊆ a + M` and `supp(y) ⊆ b + M` for an additive
submonoid `M`, then `supp(xy) ⊆ a + b + M`. -/
theorem sub_mem_of_mem_support_mul {M : AddSubmonoid Γ} {x y : R⟦Γ⟧} {a b : Γ}
    (hx : ∀ g ∈ x.support, g - a ∈ M) (hy : ∀ g ∈ y.support, g - b ∈ M) :
    ∀ g ∈ (x * y).support, g - (a + b) ∈ M := by
  intro g hg
  obtain ⟨i, hi, j, hj, rfl⟩ := support_mul_subset hg
  rw [show i + j - (a + b) = (i - a) + (j - b) by abel]
  exact M.add_mem (hx i hi) (hy j hj)

/-- Support arithmetic for powers: if `supp(x) ⊆ a + M`, then `supp(x^n) ⊆ na + M`. -/
theorem sub_mem_of_mem_support_pow {M : AddSubmonoid Γ} {x : R⟦Γ⟧} {a : Γ}
    (hx : ∀ g ∈ x.support, g - a ∈ M) : ∀ n : ℕ, ∀ g ∈ (x ^ n).support, g - n • a ∈ M
  | 0, g, hg => by
    rw [pow_zero, ← single_zero_one] at hg
    rw [Set.mem_singleton_iff.mp (support_single_subset hg), zero_nsmul, sub_zero]
    exact M.zero_mem
  | n + 1, g, hg => by
    rw [pow_succ] at hg
    rw [succ_nsmul]
    exact sub_mem_of_mem_support_mul (sub_mem_of_mem_support_pow hx n) hx g hg

/-- The monoid `M = M(S)` of the proof of `hol:thm:thetadomain`, generated by the supports of
`p` and `x` shifted to start at `0`. These shifted supports are `{0} ∪ supp(u)` and
`{0} ∪ supp(w)` in the source's notation `p = c t^β (1 + u)`, `x = d t^δ (1 + w)`; adjoining `0`
does not change the generated monoid. -/
def thetaMonoid (p x : R⟦Γ⟧) : AddSubmonoid Γ :=
  AddSubmonoid.closure ((fun g => g - p.order) '' p.support ∪ (fun g => g - x.order) '' x.support)

/-- The monoid `M(S)` of the proof of `hol:thm:thetadomain` is well ordered. -/
theorem isPWO_thetaMonoid (p x : R⟦Γ⟧) : ((thetaMonoid p x : AddSubmonoid Γ) : Set Γ).IsPWO := by
  refine Set.IsPWO.addSubmonoid_closure ?_ ?_
  · rintro _ (⟨g, hg, rfl⟩ | ⟨g, hg, rfl⟩)
    · exact sub_nonneg.mpr (order_le_of_coeff_ne_zero hg)
    · exact sub_nonneg.mpr (order_le_of_coeff_ne_zero hg)
  · exact (p.isPWO_support.image_of_monotone fun _ _ h => sub_le_sub_right h _).union
      (x.isPWO_support.image_of_monotone fun _ _ h => sub_le_sub_right h _)

omit [IsOrderedAddMonoid Γ] in
/-- `supp(p) ⊆ v(p) + M`. -/
theorem sub_order_mem_thetaMonoid_left (p x : R⟦Γ⟧) :
    ∀ g ∈ p.support, g - p.order ∈ thetaMonoid p x :=
  fun g hg => AddSubmonoid.subset_closure (Or.inl ⟨g, hg, rfl⟩)

omit [IsOrderedAddMonoid Γ] in
/-- `supp(x) ⊆ v(x) + M`. -/
theorem sub_order_mem_thetaMonoid_right (p x : R⟦Γ⟧) :
    ∀ g ∈ x.support, g - x.order ∈ thetaMonoid p x :=
  fun g hg => AddSubmonoid.subset_closure (Or.inr ⟨g, hg, rfl⟩)

/-- The leading exponents `h_n = binom(n, 2) β + n δ` of `hol:eq:thetasupport`. -/
def thetaExponent (β δ : Γ) (n : ℕ) : Γ :=
  n.choose 2 • β + n • δ

omit [LinearOrder Γ] [IsOrderedAddMonoid Γ] in
/-- `h_{n+1} - h_n = nβ + δ`. -/
theorem thetaExponent_succ (β δ : Γ) (n : ℕ) :
    thetaExponent β δ (n + 1) = thetaExponent β δ n + (n • β + δ) := by
  rw [thetaExponent, thetaExponent, choose_two_succ, add_nsmul, succ_nsmul]
  abel

/-- `hol:eq:thetasupport`, support clause: `supp(p^{binom(n,2)} x^n) ⊆ h_n + M`. -/
theorem support_theta_term (p x : R⟦Γ⟧) (n : ℕ) :
    ∀ g ∈ (PowerSeries.coeff n (partialTheta p) * x ^ n).support,
      g - thetaExponent p.order x.order n ∈ thetaMonoid p x := by
  rw [coeff_partialTheta]
  exact sub_mem_of_mem_support_mul
    (sub_mem_of_mem_support_pow (sub_order_mem_thetaMonoid_left p x) _)
    (sub_mem_of_mem_support_pow (sub_order_mem_thetaMonoid_right p x) _)

/-- Sufficiency in `hol:thm:thetadomain`: if `v(p) > 0` and `v(x) ≥ -Nβ` for some `N ∈ ℕ`,
the evaluation family of `Θ_p` at `x` is strongly summable. This includes `x = 0`, whose junk
order is `0`. The proof is the monoid certificate `hol:lem:certificate` (b). -/
theorem stronglySummable_partialTheta_of_le {p x : R⟦Γ⟧} (hp : 0 < p.order) {N : ℕ}
    (hN : -(N • p.order) ≤ x.order) :
    StronglySummable fun n => PowerSeries.coeff n (partialTheta p) * x ^ n := by
  have hmono : StrictMono fun m => thetaExponent p.order x.order (N + 1 + m) := by
    refine strictMono_nat_of_lt_succ fun m => ?_
    show thetaExponent p.order x.order (N + 1 + m) < thetaExponent p.order x.order (N + 1 + m + 1)
    rw [thetaExponent_succ, lt_add_iff_pos_right]
    have h1 : 0 ≤ N • p.order + x.order := neg_le_iff_add_nonneg'.mp hN
    have h2 : 0 < (1 + m) • p.order := nsmul_pos hp (by omega)
    calc 0 < (1 + m) • p.order + (N • p.order + x.order) := add_pos_of_pos_of_nonneg h2 h1
      _ = (N + 1 + m) • p.order + x.order := by
        rw [show N + 1 + m = N + (1 + m) by omega, add_nsmul p.order N (1 + m)]
        abel
  exact stronglySummable_of_support_subset _ (thetaExponent p.order x.order)
    (isPWO_thetaMonoid p x) (isPWO_range_of_strictMono_add _ hmono)
    (finite_fiber_of_strictMono_add _ hmono) fun n g hg =>
      ⟨g - thetaExponent p.order x.order n, support_theta_term p x n g hg, add_sub_cancel _ _⟩

variable [NoZeroDivisors R]

/-- `hol:eq:thetasupport`, valuation clause: for `p, x ≠ 0` the `n`th evaluation term is
nonzero with order `h_n`. -/
theorem order_theta_term {p x : R⟦Γ⟧} (hp : p ≠ 0) (hx : x ≠ 0) (n : ℕ) :
    PowerSeries.coeff n (partialTheta p) * x ^ n ≠ 0 ∧
      (PowerSeries.coeff n (partialTheta p) * x ^ n).order = thetaExponent p.order x.order n := by
  rw [coeff_partialTheta]
  refine ⟨mul_ne_zero (pow_ne_zero _ hp) (pow_ne_zero _ hx), ?_⟩
  rw [order_mul (pow_ne_zero _ hp) (pow_ne_zero _ hx), order_pow, order_pow]
  rfl

/-- Necessity in `hol:thm:thetadomain`: if `x ≠ 0` and `v(x) < -Nβ` for every `N ∈ ℕ`, the
leading exponents `h_n` strictly decrease and the evaluation family is not strongly summable
(`hol:lem:nonincreasing`). -/
theorem not_stronglySummable_partialTheta {p x : R⟦Γ⟧} (hp : 0 < p.order) (hx : x ≠ 0)
    (h : ∀ N : ℕ, x.order < -(N • p.order)) :
    ¬ StronglySummable fun n => PowerSeries.coeff n (partialTheta p) * x ^ n := by
  have hp0 : p ≠ 0 := fun h0 => by rw [h0, order_zero] at hp; exact lt_irrefl 0 hp
  refine not_stronglySummable_of_order_succ_le (idx := id) Function.injective_id
    (fun n => (order_theta_term hp0 hx n).1) fun n => ?_
  simp only [id]
  rw [(order_theta_term hp0 hx (n + 1)).2, (order_theta_term hp0 hx n).2, thetaExponent_succ]
  exact add_le_of_nonpos_right (lt_neg_iff_add_neg'.mp (h n)).le

/-- `hol:thm:thetadomain`, pointwise form of the first line of `hol:eq:thetadomain`: for
`v(p) > 0` (which forces `p ≠ 0`), `x ∈ Dom(Θ_p)` iff `x = 0` or `v(x) ≥ -Nβ` for some
`N ∈ ℕ`. -/
theorem mem_strongDomain_partialTheta_iff {p : R⟦Γ⟧} (hp : 0 < p.order) (x : R⟦Γ⟧) :
    x ∈ strongDomain (partialTheta p) ↔ x = 0 ∨ ∃ N : ℕ, -(N • p.order) ≤ x.order := by
  constructor
  · intro hs
    by_contra hcon
    rw [not_or, not_exists] at hcon
    exact not_stronglySummable_partialTheta hp hcon.1 (fun N => not_le.mp (hcon.2 N)) hs
  · rintro (rfl | ⟨N, hN⟩)
    · exact stronglySummable_partialTheta_of_le hp (N := 0) (by simp)
    · exact stronglySummable_partialTheta_of_le hp hN

/-- `hol:thm:thetadomain`, first line of `hol:eq:thetadomain`:
`Dom(Θ_p) = {0} ∪ {x ∈ K^× : v(x) ≥ -Nβ for some N ∈ ℕ}`. -/
theorem strongDomain_partialTheta {p : R⟦Γ⟧} (hp : 0 < p.order) :
    strongDomain (partialTheta p) = {0} ∪ {x | x ≠ 0 ∧ ∃ N : ℕ, -(N • p.order) ≤ x.order} := by
  ext x
  rw [mem_strongDomain_partialTheta_iff hp, Set.mem_union, Set.mem_singleton_iff,
    Set.mem_setOf_eq]
  tauto

/-- `hol:thm:thetadomain`, second line of `hol:eq:thetadomain`:
`Dom(Θ_p) = {0} ∪ {x ∈ K^× : (v mod Δ_β)(x) ≥ 0}`, with nonnegativity in `Γ / Δ_β` expressed
by `QuotNonneg`. -/
theorem strongDomain_partialTheta_eq_quotNonneg {p : R⟦Γ⟧} (hp : 0 < p.order) :
    strongDomain (partialTheta p) = {0} ∪
      {x | x ≠ 0 ∧ QuotNonneg (scaleSubgroup p.order) (x.order : Γ ⧸ scaleSubgroup p.order)} := by
  rw [strongDomain_partialTheta hp]
  ext x
  simp only [Set.mem_union, Set.mem_setOf_eq, exists_neg_nsmul_le_iff_quotNonneg hp.le]

/-- `hol:thm:thetadomain`, second line of `hol:eq:thetadomain` as a valuation ring: over a
field, `Dom(Θ_p)` is the valuation ring `Surreal.ScaleIdeal.coarseValuationSubring β` of the
coarsened valuation `v mod Δ_β`, where `β = v(p) > 0`. -/
theorem strongDomain_partialTheta_eq_coarseValuationSubring {K : Type*} [Field K] {p : K⟦Γ⟧}
    (hp : 0 < p.order) :
    strongDomain (partialTheta p) =
      (Surreal.ScaleIdeal.coarseValuationSubring (k := K) p.order : Set K⟦Γ⟧) := by
  ext x
  rw [mem_strongDomain_partialTheta_iff hp, SetLike.mem_coe,
    Surreal.ScaleIdeal.mem_coarseValuationSubring]
  rcases eq_or_ne x 0 with rfl | hx
  · exact iff_of_true (Or.inl rfl) ⟨0, zero_mem _, by simp⟩
  · rw [← order_eq_orderTop_of_ne_zero hx, ← scaleSubgroup_eq_scaleIdeal_scaleSubgroup]
    simp only [hx, false_or, WithTop.coe_le_coe]
    rw [exists_neg_nsmul_le_iff_quotNonneg hp.le, quotNonneg_mk_iff]

/-- `hol:thm:thetadomain`, final clause: `Θ_p` is strongly entire iff `β = v(p)` is an order
unit of `Γ`. -/
theorem isStronglyEntire_partialTheta_iff {p : R⟦Γ⟧} (hp : 0 < p.order) :
    IsStronglyEntire (partialTheta p) ↔ IsOrderUnit p.order := by
  have hp0 : p ≠ 0 := fun h0 => by rw [h0, order_zero] at hp; exact lt_irrefl 0 hp
  have hc : p.coeff p.order ≠ 0 := coeff_order_eq_zero.not.mpr hp0
  constructor
  · intro hE
    refine ⟨hp, fun γ => ?_⟩
    have hmem : single (-|γ|) (p.coeff p.order) ∈ strongDomain (partialTheta p) := by
      rw [hE]
      exact Set.mem_univ _
    rcases (mem_strongDomain_partialTheta_iff hp _).mp hmem with h0 | ⟨N, hN⟩
    · exact absurd h0 (single_ne_zero hc)
    · rw [order_single hc, neg_le_neg_iff] at hN
      exact ⟨N, hN⟩
  · rintro ⟨-, hu⟩
    refine Set.eq_univ_of_forall fun x => (mem_strongDomain_partialTheta_iff hp x).mpr (Or.inr ?_)
    obtain ⟨N, hN⟩ := hu x.order
    exact ⟨N, (abs_le.mp hN).1⟩

/-- `Θ_p` is not a polynomial: none of its coefficients vanishes when `p ≠ 0`. -/
theorem partialTheta_ne_coe {p : R⟦Γ⟧} (hp : p ≠ 0) (P : Polynomial R⟦Γ⟧) :
    partialTheta p ≠ (P : PowerSeries R⟦Γ⟧) := by
  intro h
  have hc := congrArg (PowerSeries.coeff (P.natDegree + 1)) h
  rw [coeff_partialTheta, Polynomial.coeff_coe,
    Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_succ_self _)] at hc
  exact pow_ne_zero _ hp hc

end Semiring

section Identities

/-- `X(az) = aX`, over a commutative semiring (Mathlib states this for commutative rings). -/
theorem rescale_X_eq_C_mul_X {S : Type*} [CommSemiring S] (a : S) :
    PowerSeries.rescale a PowerSeries.X = PowerSeries.C a * PowerSeries.X := by
  ext n
  simp only [PowerSeries.coeff_rescale, PowerSeries.coeff_C_mul, PowerSeries.coeff_X]
  split_ifs with h <;> simp [h]

/-- `hol:eq:thetafirst`: `Θ_p(z) = 1 + z Θ_p(pz)`. -/
theorem partialTheta_eq_one_add_X_mul [CommSemiring R] (p : R⟦Γ⟧) :
    partialTheta p = 1 + PowerSeries.X * PowerSeries.rescale p (partialTheta p) := by
  ext n
  rcases n with _ | n
  · rw [map_add, PowerSeries.coeff_zero_X_mul, coeff_partialTheta, PowerSeries.coeff_one,
      if_pos rfl, add_zero]
    simp
  · rw [map_add, PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_rescale, coeff_partialTheta,
      coeff_partialTheta, PowerSeries.coeff_one, if_neg n.succ_ne_zero, zero_add,
      choose_two_succ, pow_add, mul_comm]

/-- `hol:eq:thetafirst` after the substitution `z ↦ az`:
`Θ_p(az) = 1 + az Θ_p(paz)`. -/
theorem rescale_partialTheta [CommSemiring R] (p a : R⟦Γ⟧) :
    PowerSeries.rescale a (partialTheta p) =
      1 + PowerSeries.C a * PowerSeries.X * PowerSeries.rescale (p * a) (partialTheta p) := by
  conv_lhs => rw [partialTheta_eq_one_add_X_mul p]
  rw [map_add, map_one, map_mul, rescale_X_eq_C_mul_X, PowerSeries.rescale_rescale]

/-- `hol:eq:thetahom`: `Θ_p(z) - (1 + z) Θ_p(pz) + pz Θ_p(p²z) = 0`. -/
theorem partialTheta_hom [CommRing R] (p : R⟦Γ⟧) :
    partialTheta p - (1 + PowerSeries.X) * PowerSeries.rescale p (partialTheta p) +
      PowerSeries.C p * PowerSeries.X * PowerSeries.rescale (p ^ 2) (partialTheta p) = 0 := by
  have h1 := partialTheta_eq_one_add_X_mul p
  have h2 := rescale_partialTheta p p
  rw [← sq] at h2
  linear_combination h1 - h2

/-- `hol:eq:inverseq`: with `p = q⁻¹`,
`Θ_{q⁻¹}(q²z) - (1 + q²z) Θ_{q⁻¹}(qz) + qz Θ_{q⁻¹}(z) = 0`. -/
theorem partialTheta_inv_hom {K : Type*} [Field K] {q : K⟦Γ⟧} (hq : q ≠ 0) :
    PowerSeries.rescale (q ^ 2) (partialTheta q⁻¹) -
        (1 + PowerSeries.C (q ^ 2) * PowerSeries.X) * PowerSeries.rescale q (partialTheta q⁻¹) +
      PowerSeries.C q * PowerSeries.X * partialTheta q⁻¹ = 0 := by
  have e1 := rescale_partialTheta q⁻¹ q
  have e2 := rescale_partialTheta q⁻¹ (q ^ 2)
  rw [inv_mul_cancel₀ hq, PowerSeries.rescale_one, RingHom.id_apply] at e1
  rw [show q⁻¹ * q ^ 2 = q by rw [sq, ← mul_assoc, inv_mul_cancel₀ hq, one_mul]] at e2
  linear_combination e2 - e1

end Identities

section QDifference

/-- The `q`-difference half of `hol:def:operators` (equation `hol:eq:qlinear`): `f` is linearly
`q`-difference finite if `∑_{ℓ=0}^r p_ℓ(z) f(q^ℓ z) = 0` for polynomials `p_ℓ` that are not
all zero. As in the source, the definition is stated for every `q`, but it is meaningful only
for nontorsion `q` (the hypothesis of `hol:main:q`): for `q = 1` and a nontrivial coefficient
ring, the choice `P = ![1, -1]` works for every `f`. -/
def IsQDifferenceFinite [CommSemiring R] (q : R⟦Γ⟧) (f : PowerSeries R⟦Γ⟧) : Prop :=
  ∃ (r : ℕ) (P : Fin (r + 1) → Polynomial R⟦Γ⟧), P ≠ 0 ∧
    ∑ l : Fin (r + 1), (P l : PowerSeries R⟦Γ⟧) * PowerSeries.rescale (q ^ (l : ℕ)) f = 0

/-- `hol:eq:thetahom` makes `Θ_p` linearly `p`-difference finite. -/
theorem isQDifferenceFinite_partialTheta [CommRing R] [Nontrivial R] (p : R⟦Γ⟧) :
    IsQDifferenceFinite p (partialTheta p) := by
  refine ⟨2, ![1, -(1 + Polynomial.X), Polynomial.C p * Polynomial.X], fun h => ?_, ?_⟩
  · have h0 := congrFun h 0
    simp at h0
  · have hneg : ((-(1 + Polynomial.X) : Polynomial R⟦Γ⟧) : PowerSeries R⟦Γ⟧) =
        -(1 + PowerSeries.X) := by
      rw [← Polynomial.coeToPowerSeries.ringHom_apply, map_neg, map_add, map_one,
        Polynomial.coeToPowerSeries.ringHom_apply, Polynomial.coe_X]
    rw [Fin.sum_univ_three]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero,
      pow_one, PowerSeries.rescale_one, RingHom.id_apply, Polynomial.coe_one,
      Polynomial.coe_mul, Polynomial.coe_C, Polynomial.coe_X, hneg]
    linear_combination partialTheta_hom p

/-- `hol:eq:inverseq` makes `Θ_{q⁻¹}` linearly `q`-difference finite, using only nonnegative
powers of the dilation. -/
theorem isQDifferenceFinite_partialTheta_inv {K : Type*} [Field K] {q : K⟦Γ⟧} (hq : q ≠ 0) :
    IsQDifferenceFinite q (partialTheta q⁻¹) := by
  refine ⟨2, ![Polynomial.C q * Polynomial.X, -(1 + Polynomial.C (q ^ 2) * Polynomial.X), 1],
    fun h => ?_, ?_⟩
  · have h2 := congrFun h 2
    simp at h2
  · have hneg : ((-(1 + Polynomial.C (q ^ 2) * Polynomial.X) : Polynomial K⟦Γ⟧) :
        PowerSeries K⟦Γ⟧) = -(1 + PowerSeries.C (q ^ 2) * PowerSeries.X) := by
      rw [← Polynomial.coeToPowerSeries.ringHom_apply, map_neg, map_add, map_one, map_mul,
        Polynomial.coeToPowerSeries.ringHom_apply, Polynomial.coeToPowerSeries.ringHom_apply,
        Polynomial.coe_C, Polynomial.coe_X]
    rw [Fin.sum_univ_three]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero,
      pow_one, PowerSeries.rescale_one, RingHom.id_apply, Polynomial.coe_one,
      Polynomial.coe_mul, Polynomial.coe_C, Polynomial.coe_X, hneg]
    linear_combination partialTheta_inv_hom hq

/-- `hol:main:q`, implication (ii) ⇒ (i): if `|v(q)|` is an order unit of `Γ` (which forces
`q ≠ 0` and `v(q) ≠ 0`), some `f` equal to the partial theta series with parameter `q` or
`q⁻¹` is a nonpolynomial strongly entire solution of a nonzero polynomial-coefficient linear
`q`-difference equation. The proof takes `Θ_q` when `v(q) > 0` and `Θ_{q⁻¹}` when
`v(q) < 0`. -/
theorem exists_nonpolynomial_entire_of_isOrderUnit {K : Type*} [Field K] {q : K⟦Γ⟧}
    (hu : IsOrderUnit |q.order|) :
    ∃ f : PowerSeries K⟦Γ⟧, (f = partialTheta q ∨ f = partialTheta q⁻¹) ∧ IsStronglyEntire f ∧
      (∀ P : Polynomial K⟦Γ⟧, f ≠ (P : PowerSeries K⟦Γ⟧)) ∧ IsQDifferenceFinite q f := by
  have hne : q.order ≠ 0 := fun h => by
    have := hu.1
    rw [h, abs_zero] at this
    exact lt_irrefl 0 this
  have hq : q ≠ 0 := fun h => hne (by rw [h, order_zero])
  rcases lt_or_gt_of_ne hne with hneg | hpos
  · have hinv : q⁻¹.order = -q.order := by
      have h := order_mul hq (inv_ne_zero hq)
      rw [mul_inv_cancel₀ hq, order_one] at h
      exact eq_neg_of_add_eq_zero_right h.symm
    have hp : 0 < q⁻¹.order := by
      rw [hinv]
      exact neg_pos.mpr hneg
    refine ⟨partialTheta q⁻¹, Or.inr rfl, (isStronglyEntire_partialTheta_iff hp).mpr ?_,
      partialTheta_ne_coe (inv_ne_zero hq), isQDifferenceFinite_partialTheta_inv hq⟩
    rw [hinv, ← abs_of_neg hneg]
    exact hu
  · refine ⟨partialTheta q, Or.inl rfl, (isStronglyEntire_partialTheta_iff hpos).mpr ?_,
      partialTheta_ne_coe hq, isQDifferenceFinite_partialTheta q⟩
    rwa [abs_of_pos hpos] at hu

/-- `hol:cor:detect`, implication (i) ⇒ (ii): if `Γ` has an order unit `μ`, some nonzero
nontorsion parameter `q` (in the proof, `q = t^μ`) admits a nonpolynomial strongly entire
solution of a nonzero polynomial-coefficient linear `q`-difference equation. -/
theorem exists_nontorsion_of_isOrderUnit {K : Type*} [Field K] {μ : Γ} (hμ : IsOrderUnit μ) :
    ∃ q : K⟦Γ⟧, q ≠ 0 ∧ ¬ IsOfFinOrder q ∧ ∃ f : PowerSeries K⟦Γ⟧, IsStronglyEntire f ∧
      (∀ P : Polynomial K⟦Γ⟧, f ≠ (P : PowerSeries K⟦Γ⟧)) ∧ IsQDifferenceFinite q f := by
  have h1 : (1 : K) ≠ 0 := one_ne_zero
  obtain ⟨f, -, hf⟩ := exists_nonpolynomial_entire_of_isOrderUnit (q := single μ (1 : K))
    (by rwa [order_single h1, abs_of_pos hμ.1])
  refine ⟨single μ 1, single_ne_zero h1, ?_, f, hf⟩
  rw [isOfFinOrder_iff_pow_eq_one]
  rintro ⟨n, hn, h⟩
  have h' := congrArg order h
  rw [order_pow, order_single h1, order_one] at h'
  exact (nsmul_pos hμ.1 hn.ne').ne' h'

end QDifference

