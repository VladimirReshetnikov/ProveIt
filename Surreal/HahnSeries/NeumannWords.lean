import Mathlib.Algebra.Group.Submonoid.Pointwise
import Mathlib.Data.Finset.MulAntidiagonal
import Mathlib.RingTheory.HahnSeries.Summable

/-!
# Neumann's lemma for words, and strongly summable labeled products

This file proves the classical support lemma stated as `lem:neumann` in both
`docs/surcomplex/wick-summability-certificates/article.tex` and
`docs/surreal/hahn-valued-measures-and-probability/article.tex`, together with
`lem:labeled` of the latter report.

For a partially well-ordered set `S` of strictly positive elements of an ordered
cancellative monoid, the generated additive monoid is partially well-ordered, and
every element has only finitely many representations as an ordered finite word
in `S`, hence only finitely many as a finite multiset. No Archimedean property is
assumed: word lengths are not bounded by comparison with a least element, and
finiteness is proved by well-founded induction on the generated monoid through
finite antidiagonals.

For a strongly summable Hahn family whose nonzero members have positive order,
the products over all finite labeled words of indices form a strongly summable
family. Subfamilies, such as products over finite subsets, are therefore also
strongly summable.
-/

namespace Surreal.HahnSeries

open _root_.HahnSeries

noncomputable section

section Words

variable {Γ : Type*} [AddCommMonoid Γ] [LinearOrder Γ] [IsOrderedCancelAddMonoid Γ]
  {S : Set Γ}

/-- `lem:neumann`: the additive monoid generated by a partially well-ordered set of
positive elements is partially well-ordered. -/
theorem isPWO_closure_of_pos (hS : S.IsPWO) (hpos : ∀ s ∈ S, 0 < s) :
    (AddSubmonoid.closure S : Set Γ).IsPWO :=
  hS.addSubmonoid_closure fun s hs => (hpos s hs).le

omit [LinearOrder Γ] [IsOrderedCancelAddMonoid Γ] in
theorem list_sum_mem_closure {w : List Γ} (hw : ∀ s ∈ w, s ∈ S) :
    w.sum ∈ AddSubmonoid.closure S :=
  AddSubmonoid.list_sum_mem _ fun s hs => AddSubmonoid.subset_closure (hw s hs)

/-- The ordered words in `S` with a prescribed sum. -/
def wordsWithSum (S : Set Γ) (γ : Γ) : Set (List Γ) :=
  {w | (∀ s ∈ w, s ∈ S) ∧ w.sum = γ}

/-- `lem:neumann`: each exponent has only finitely many representations as an
ordered finite word in a partially well-ordered set of positive elements. -/
theorem finite_wordsWithSum (hS : S.IsPWO) (hpos : ∀ s ∈ S, 0 < s) (γ : Γ) :
    (wordsWithSum S γ).Finite := by
  classical
  have hC := isPWO_closure_of_pos hS hpos
  by_cases hγ : γ ∈ (AddSubmonoid.closure S : Set Γ)
  swap
  · refine Set.finite_empty.subset fun w hw => hγ ?_
    exact hw.2 ▸ list_sum_mem_closure hw.1
  refine hC.isWF.induction hγ (P := fun x => (wordsWithSum S x).Finite) fun x _ ih => ?_
  refine (((Finset.antidiagonal hS hC x).finite_toSet.biUnion
    (t := fun p => (List.cons p.1) '' wordsWithSum S p.2) fun p hp => ?_).union
    (Set.finite_singleton ([] : List Γ))).subset ?_
  · obtain ⟨hp1, hp2, hsum⟩ := Finset.mem_antidiagonal.mp hp
    refine (ih p.2 hp2 ?_).image _
    rw [← hsum]
    exact lt_add_of_pos_left _ (hpos _ hp1)
  · rintro (_ | ⟨s, w⟩) ⟨hw, hsum⟩
    · exact Set.mem_union_right _ rfl
    · refine Set.mem_union_left _ (Set.mem_biUnion (x := (s, w.sum)) ?_ ⟨w, ⟨?_, rfl⟩, rfl⟩)
      · rw [Finset.mem_coe, Finset.mem_antidiagonal]
        refine ⟨hw s List.mem_cons_self, list_sum_mem_closure fun t ht => hw t
          (List.mem_cons_of_mem s ht), ?_⟩
        simpa using hsum
      · exact fun t ht => hw t (List.mem_cons_of_mem s ht)

/-- `lem:neumann`, multiset form used in the Wick report: each exponent has only
finitely many representations as a finite multiset of members of `S`. -/
theorem finite_multisetsWithSum (hS : S.IsPWO) (hpos : ∀ s ∈ S, 0 < s) (γ : Γ) :
    {m : Multiset Γ | (∀ s ∈ m, s ∈ S) ∧ m.sum = γ}.Finite := by
  refine ((finite_wordsWithSum hS hpos γ).image (fun w : List Γ => (w : Multiset Γ))).subset ?_
  intro m hm
  obtain ⟨w, rfl⟩ := Quot.exists_rep m
  exact ⟨w, ⟨fun s hs => hm.1 s hs, by simpa using hm.2⟩, rfl⟩

end Words

section Labeled

variable {Γ R I : Type*} [AddCommMonoid Γ] [LinearOrder Γ] [IsOrderedCancelAddMonoid Γ]
  [CommRing R]

/-- The product attached to a finite labeled word of indices. -/
def wordProduct (a : I → R⟦Γ⟧) (w : List I) : R⟦Γ⟧ :=
  (w.map a).prod

theorem support_wordProduct_subset (a : I → R⟦Γ⟧) (w : List I) :
    (wordProduct a w).support ⊆ AddSubmonoid.closure (⋃ i, (a i).support) := by
  induction w with
  | nil =>
    intro g hg
    simp only [wordProduct, List.map_nil, List.prod_nil, mem_support, coeff_one] at hg
    split_ifs at hg with h
    · exact h ▸ AddSubmonoid.zero_mem _
    · exact absurd rfl hg
  | cons i w ih =>
    intro g hg
    simp only [wordProduct, List.map_cons, List.prod_cons] at hg
    obtain ⟨x, hx, y, hy, rfl⟩ := support_mul_subset hg
    exact AddSubmonoid.add_mem _ (AddSubmonoid.subset_closure (Set.mem_iUnion.mpr ⟨i, hx⟩))
      (ih hy)

/-- A nonzero coefficient of a word product is witnessed by an exponent word whose
letters lie in the supports of the corresponding factors. -/
theorem exists_exponents_of_coeff_wordProduct_ne_zero (a : I → R⟦Γ⟧) :
    ∀ (w : List I) {γ : Γ}, (wordProduct a w).coeff γ ≠ 0 →
      ∃ e : List Γ, List.Forall₂ (fun i g => g ∈ (a i).support) w e ∧ e.sum = γ
  | [], γ, h => by
    refine ⟨[], List.Forall₂.nil, ?_⟩
    simp only [wordProduct, List.map_nil, List.prod_nil, coeff_one] at h
    split_ifs at h with hγ
    · exact hγ.symm
    · exact absurd rfl h
  | i :: w, γ, h => by
    simp only [wordProduct, List.map_cons, List.prod_cons] at h
    obtain ⟨x, hx, y, hy, rfl⟩ := support_mul_subset ((mem_support _ _).mpr h)
    obtain ⟨e, he, hsum⟩ := exists_exponents_of_coeff_wordProduct_ne_zero a w
      ((mem_support _ _).mp hy)
    exact ⟨x :: e, List.Forall₂.cons hx he, by simp [hsum]⟩

theorem exists_mem_of_forall₂ {α β : Type*} {r : α → β → Prop} :
    ∀ {w : List α} {e : List β}, List.Forall₂ r w e → ∀ g ∈ e, ∃ i ∈ w, r i g
  | _, _, .nil, _, hg => absurd hg List.not_mem_nil
  | _, _, .cons hr h, g, hg => by
    rcases List.mem_cons.mp hg with rfl | hg
    · exact ⟨_, List.mem_cons_self, hr⟩
    · obtain ⟨i, hi, hri⟩ := exists_mem_of_forall₂ h g hg
      exact ⟨i, List.mem_cons_of_mem _ hi, hri⟩

omit [AddCommMonoid Γ] [IsOrderedCancelAddMonoid Γ] in
/-- For a fixed exponent word, only finitely many index words have letters in the
coefficient fibers of a strongly summable family. -/
theorem finite_forall₂ (s : SummableFamily Γ R I) :
    ∀ e : List Γ, {w : List I | List.Forall₂ (fun i g => g ∈ (s i).support) w e}.Finite
  | [] => (Set.finite_singleton ([] : List I)).subset fun w hw => by
      simpa using hw
  | g :: e => by
    refine (((s.finite_co_support g).biUnion fun i _ =>
      (finite_forall₂ s e).image (List.cons i))).subset ?_
    intro w hw
    cases w with
    | nil => simp at hw
    | cons i w =>
      simp only [Set.mem_setOf_eq, List.forall₂_cons] at hw
      exact Set.mem_biUnion (x := i) ((mem_support _ _).mp hw.1) ⟨w, hw.2, rfl⟩

/-- `lem:labeled`: the products over all finite labeled words of a strongly
summable family whose members have positive order form a strongly summable
family. The empty word contributes `1`. -/
def labeledWordFamily (s : SummableFamily Γ R I) (hpos : ∀ i, 0 < (s i).orderTop) :
    SummableFamily Γ R (List I) where
  toFun := wordProduct s
  isPWO_iUnion_support' := by
    refine (isPWO_closure_of_pos (S := ⋃ i, (s i).support) s.isPWO_iUnion_support
      ?_).mono (Set.iUnion_subset fun w => support_wordProduct_subset s w)
    intro g hg
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hg
    exact WithTop.coe_lt_coe.mp ((hpos i).trans_le (orderTop_le_of_coeff_ne_zero
      ((mem_support _ _).mp hi)))
  finite_co_support' γ := by
    have hS : ∀ g ∈ ⋃ i, (s i).support, 0 < g := by
      intro g hg
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hg
      exact WithTop.coe_lt_coe.mp ((hpos i).trans_le (orderTop_le_of_coeff_ne_zero
        ((mem_support _ _).mp hi)))
    refine ((finite_wordsWithSum s.isPWO_iUnion_support hS γ).biUnion
      fun e _ => finite_forall₂ s e).subset ?_
    intro w hw
    obtain ⟨e, he, hsum⟩ := exists_exponents_of_coeff_wordProduct_ne_zero s w hw
    refine Set.mem_biUnion ⟨fun g hg => ?_, hsum⟩ he
    obtain ⟨i, -, hi⟩ := exists_mem_of_forall₂ he g hg
    exact Set.mem_iUnion.mpr ⟨i, hi⟩

@[simp]
theorem labeledWordFamily_apply (s : SummableFamily Γ R I) (hpos : ∀ i, 0 < (s i).orderTop)
    (w : List I) : labeledWordFamily s hpos w = (w.map s).prod := rfl

end Labeled

end

end Surreal.HahnSeries
