import Surreal.Algebra.MvPowerSeriesPolynomialFactorLifting
import Surreal.Algebra.PolynomialFiniteFactorLifting
import Mathlib.Algebra.Polynomial.Lifts
import Surreal.Algebra.PolynomialUniversalPerturbation
import Surreal.HahnSeries.MvEvaluation
import Surreal.HahnSeries.PolynomialFactorUniqueness

/-!
# Coprime polynomial factor lifting in Hahn fields

Every monic polynomial over the nonnegative-order Hahn ring lifts a coprime
factorization of its residue polynomial. One formal parameter for each
lower coefficient reduces existence to multivariate formal factor lifting,
and strong Hahn evaluation evaluates the resulting factors at the actual
coefficient errors. Uniqueness holds among all monic candidates with the
specified residues. No restriction on their support presentation is assumed.

This proves binary and finite-family Hahn factor existence and uniqueness,
and binary support containment, from `polynomial:thm:hensel`. Transfer to the
actual surreal field still requires its infinite normal-form/evaluation bridge.
-/

namespace Surreal.HahnSeries

open Polynomial
open _root_.HahnSeries

noncomputable section

variable {Γ K σ : Type*} [AddCommGroup Γ] [LinearOrder Γ]
  [IsOrderedAddMonoid Γ] [Field K]

/-- Constants as elements of the nonnegative-order Hahn ring. -/
def constantNonnegative : K →+* nonnegativeSubring Γ K :=
  (_root_.HahnSeries.C : K →+* K⟦Γ⟧).codRestrict _ (fun _ => orderTop_single_le)

@[simp] theorem coe_constantNonnegative (a : K) :
    (constantNonnegative (Γ := Γ) a : K⟦Γ⟧) = single 0 a := rfl

@[simp] theorem standardPart_constantNonnegative (a : K) :
    standardPart Γ K (constantNonnegative a) = a := coeff_single_same 0 a

/-- Strong finite-variable evaluation lands in the nonnegative-order ring. -/
def mvEvaluateNonnegative [Fintype σ] (x : σ → K⟦Γ⟧)
    (hx : ∀ i, 0 < (x i).orderTop) : MvPowerSeries σ K →+* nonnegativeSubring Γ K :=
  (mvEvaluate x hx).toRingHom.codRestrict _ (orderTop_mvEvaluate_nonneg x hx)

@[simp] theorem coe_mvEvaluateNonnegative [Fintype σ] (x : σ → K⟦Γ⟧)
    (hx : ∀ i, 0 < (x i).orderTop) (F : MvPowerSeries σ K) :
    (mvEvaluateNonnegative x hx F : K⟦Γ⟧) = mvEvaluate x hx F := rfl

@[simp] theorem standardPart_mvEvaluateNonnegative [Fintype σ] (x : σ → K⟦Γ⟧)
    (hx : ∀ i, 0 < (x i).orderTop) (F : MvPowerSeries σ K) :
    standardPart Γ K (mvEvaluateNonnegative x hx F) = MvPowerSeries.constantCoeff F :=
  coeff_zero_mvEvaluate x hx F

/-- Residue followed by constant inclusion is a section on coefficient constants. -/
theorem standardPart_comp_constantNonnegative :
    (standardPart Γ K).comp constantNonnegative = RingHom.id K := by
  ext a
  exact standardPart_constantNonnegative a

/-- Evaluation followed by reduction is exactly formal constant specialization. -/
theorem standardPart_comp_mvEvaluateNonnegative [Fintype σ] (x : σ → K⟦Γ⟧)
    (hx : ∀ i, 0 < (x i).orderTop) :
    (standardPart Γ K).comp (mvEvaluateNonnegative x hx) = MvPowerSeries.constantCoeff := by
  ext F
  exact standardPart_mvEvaluateNonnegative x hx F

private theorem degree_sub_constant_residue_lt (H : Polynomial (nonnegativeSubring Γ K))
    (hH : H.Monic) :
    (H - (H.map (standardPart Γ K)).map constantNonnegative).degree < (H.natDegree : WithBot ℕ) := by
  have hmon : ((H.map (standardPart Γ K)).map (constantNonnegative (Γ := Γ))).Monic :=
    (hH.map _).map _
  have hdeg : H.degree = ((H.map (standardPart Γ K)).map (constantNonnegative (Γ := Γ))).degree := by
    rw [Polynomial.degree_eq_natDegree hmon.ne_zero, Polynomial.degree_eq_natDegree hH.ne_zero,
      (hH.map _).natDegree_map, hH.natDegree_map]
  simpa only [Polynomial.degree_eq_natDegree hH.ne_zero] using
    Polynomial.degree_sub_lt hdeg hH.ne_zero (hH.trans hmon.symm)

/-- Every coefficient error after reduction has strictly positive Hahn order. -/
theorem orderTop_coeff_sub_constant_residue_pos
    (H : Polynomial (nonnegativeSubring Γ K)) (n : ℕ) :
    0 < ((H - (H.map (standardPart Γ K)).map constantNonnegative).coeff n : K⟦Γ⟧).orderTop := by
  simp only [Polynomial.coeff_sub, Polynomial.coeff_map]
  exact orderTop_sub_standardPart_pos (H.coeff n)

/-- The additive monoid generated by all coefficient errors from their residues. -/
def residueErrorSupport (H : Polynomial (nonnegativeSubring Γ K)) : AddSubmonoid Γ :=
  AddSubmonoid.closure (⋃ n : ℕ,
    ((H - (H.map (standardPart Γ K)).map constantNonnegative).coeff n : K⟦Γ⟧).support)

/-- Coprime factors can be constructed with all their Hahn supports inside the
additive monoid generated by the input coefficient errors. -/
theorem exists_monic_factorization_with_support_of_standardPart
    (p q : K[X]) (hp : p.Monic) (hq : q.Monic) (hpq : IsCoprime p q)
    (H : Polynomial (nonnegativeSubring Γ K)) (hH : H.Monic)
    (hred : H.map (standardPart Γ K) = p * q) :
    ∃ PQ : Polynomial (nonnegativeSubring Γ K) × Polynomial (nonnegativeSubring Γ K),
      PQ.1.Monic ∧ PQ.2.Monic ∧ PQ.1.natDegree = p.natDegree ∧ PQ.2.natDegree = q.natDegree ∧
      PQ.1.map (standardPart Γ K) = p ∧ PQ.2.map (standardPart Γ K) = q ∧
      IsCoprime PQ.1 PQ.2 ∧ PQ.1 * PQ.2 = H ∧
      (∀ n, (PQ.1.coeff n : K⟦Γ⟧).support ⊆ residueErrorSupport H) ∧
      (∀ n, (PQ.2.coeff n : K⟦Γ⟧).support ⊆ residueErrorSupport H) := by
  let E := H - (p * q).map (constantNonnegative (Γ := Γ))
  have hEd : E.degree < (p * q).natDegree := by
    have h := degree_sub_constant_residue_lt H hH
    rwa [hred, ← hH.natDegree_map (standardPart Γ K), hred] at h
  have hEpos (n : ℕ) : 0 < (E.coeff n : K⟦Γ⟧).orderTop := by
    simpa only [E, ← hred] using orderTop_coeff_sub_constant_residue_pos H n
  let x : Fin (p * q).natDegree → K⟦Γ⟧ := fun i => E.coeff i.val
  have hx (i : Fin (p * q).natDegree) : 0 < (x i).orderTop := hEpos i.val
  let φ := mvEvaluateNonnegative x hx
  have hC : φ.comp MvPowerSeries.C = constantNonnegative (Γ := Γ) := by
    apply RingHom.ext
    intro a
    apply Subtype.ext
    exact mvEvaluate_C x hx a
  have hX (i : Fin (p * q).natDegree) : φ (MvPowerSeries.X i) = E.coeff i.val := by
    apply Subtype.ext
    exact mvEvaluate_X x hx i
  have hinput : (FinitePolynomial.universalMonicPerturbation (p * q)).map φ = H := by
    rw [FinitePolynomial.universalMonicPerturbation_map _ E hEd _ φ hC hX]
    exact add_sub_cancel _ _
  obtain ⟨⟨P, Q⟩, ⟨hP, hQ, hPd, hQd, hP₀, hQ₀, hPQ, hmul⟩, _⟩ :=
    FinitePolynomial.existsUnique_monic_factorization_over_mvPowerSeries p q hp hq hpq
      (FinitePolynomial.universalMonicPerturbation (p * q))
      (FinitePolynomial.universalMonicPerturbation_monic (hp.mul hq))
      (FinitePolynomial.universalMonicPerturbation_map_constantCoeff (p * q))
  have hPred : (P.map φ).map (standardPart Γ K) = p := by
    rw [Polynomial.map_map, standardPart_comp_mvEvaluateNonnegative, hP₀]
  have hQred : (Q.map φ).map (standardPart Γ K) = q := by
    rw [Polynomial.map_map, standardPart_comp_mvEvaluateNonnegative, hQ₀]
  have hprod : P.map φ * Q.map φ = H := by
    rw [← Polynomial.map_mul, hmul, hinput]
  have hS (i : Fin (p * q).natDegree) : (x i).support ⊆ residueErrorSupport H := by
    intro g hg
    apply AddSubmonoid.subset_closure
    apply Set.mem_iUnion.mpr
    refine ⟨i.val, ?_⟩
    simpa only [x, E, hred] using hg
  refine ⟨⟨P.map φ, Q.map φ⟩,
    hP.map φ, hQ.map φ, (hP.natDegree_map φ).trans hPd,
    (hQ.natDegree_map φ).trans hQd, hPred, hQred,
    hPQ.map (Polynomial.mapRingHom φ), hprod, ?_, ?_⟩
  · intro n
    change ((P.map φ).coeff n : K⟦Γ⟧).support ⊆ residueErrorSupport H
    rw [Polynomial.coeff_map]
    exact support_mvEvaluate_subset_addSubmonoid x hx (P.coeff n) _ hS
  · intro n
    change ((Q.map φ).coeff n : K⟦Γ⟧).support ⊆ residueErrorSupport H
    rw [Polynomial.coeff_map]
    exact support_mvEvaluate_subset_addSubmonoid x hx (Q.coeff n) _ hS

/-- Hensel factorization in the nonnegative-order Hahn ring. The formal factors
are evaluated at the actual finitely many coefficient errors. Uniqueness
compares every monic candidate with these residues, without a support condition. -/
theorem existsUnique_monic_factorization_of_standardPart
    (p q : K[X]) (hp : p.Monic) (hq : q.Monic) (hpq : IsCoprime p q)
    (H : Polynomial (nonnegativeSubring Γ K)) (hH : H.Monic)
    (hred : H.map (standardPart Γ K) = p * q) :
    ∃! PQ : Polynomial (nonnegativeSubring Γ K) × Polynomial (nonnegativeSubring Γ K),
      PQ.1.Monic ∧ PQ.2.Monic ∧ PQ.1.natDegree = p.natDegree ∧ PQ.2.natDegree = q.natDegree ∧
      PQ.1.map (standardPart Γ K) = p ∧ PQ.2.map (standardPart Γ K) = q ∧
      IsCoprime PQ.1 PQ.2 ∧ PQ.1 * PQ.2 = H := by
  obtain ⟨⟨P, Q⟩, hP, hQ, hPd, hQd, hPred, hQred, hcop, hprod, _, _⟩ :=
    exists_monic_factorization_with_support_of_standardPart p q hp hq hpq H hH hred
  refine ⟨⟨P, Q⟩, ⟨hP, hQ, hPd, hQd, hPred, hQred, hcop, hprod⟩, ?_⟩
  rintro ⟨P', Q'⟩ ⟨hP', hQ', _, _, hP'red, hQ'red, _, hprod'⟩
  obtain ⟨h1, h2⟩ := monic_factorization_unique_of_standardPart
    hP hQ hP' hQ' (by rw [hPred, hQred]; exact hpq)
    (hP'red.trans hPred.symm) (hQ'red.trans hQred.symm) (hprod.trans hprod'.symm)
  exact Prod.ext h1 h2


/-- Finite coprime residue factorizations lift uniquely, including an empty
family and factors of degree zero. -/
theorem existsUnique_monic_finite_factorization_of_standardPart {ι : Type*} [Fintype ι]
    (p : ι → K[X]) (hp : ∀ i, (p i).Monic)
    (hcop : Pairwise fun i j => IsCoprime (p i) (p j))
    (H : Polynomial (nonnegativeSubring Γ K)) (hH : H.Monic)
    (hred : H.map (standardPart Γ K) = ∏ i, p i) :
    ∃! P : ι → Polynomial (nonnegativeSubring Γ K),
      (∀ i, (P i).Monic ∧ (P i).map (standardPart Γ K) = p i ∧
        (P i).natDegree = (p i).natDegree) ∧
      (Pairwise fun i j => IsCoprime (P i) (P j)) ∧ ∏ i, P i = H := by
  apply FinitePolynomial.existsUnique_coprime_monic_finite_factorization_of_binary
    (standardPart Γ K) standardPart_reflects_units ?_ p hp hcop H hH hred
  intro f g hf hg hfg F hF hFred
  obtain ⟨⟨P, Q⟩, ⟨hP, hQ, _, _, hPred, hQred, _, hPQ⟩, _⟩ :=
    existsUnique_monic_factorization_of_standardPart f g hf hg hfg F hF hFred
  exact ⟨P, Q, hP, hQ, hPred, hQred, hPQ⟩

/-- The ambient Hahn-polynomial form, with nonnegative coefficients and
residue data stated coefficientwise. -/
theorem exists_monic_factorization_of_nonnegative_coefficients
    (p q : K[X]) (hp : p.Monic) (hq : q.Monic) (hpq : IsCoprime p q)
    (H : Polynomial K⟦Γ⟧) (hH : H.Monic)
    (hc : ∀ n, 0 ≤ (H.coeff n).orderTop)
    (hred : ∀ n, (H.coeff n).coeff 0 = (p * q).coeff n) :
    ∃ P Q : Polynomial K⟦Γ⟧,
      P.Monic ∧ Q.Monic ∧ P.natDegree = p.natDegree ∧ Q.natDegree = q.natDegree ∧
      (∀ n, 0 ≤ (P.coeff n).orderTop) ∧ (∀ n, 0 ≤ (Q.coeff n).orderTop) ∧
      (∀ n, (P.coeff n).coeff 0 = p.coeff n) ∧
      (∀ n, (Q.coeff n).coeff 0 = q.coeff n) ∧ IsCoprime P Q ∧ P * Q = H := by
  have hlift : H ∈ lifts (nonnegativeSubring Γ K).subtype := by
    apply (lifts_iff_coeff_lifts H).mpr
    intro n
    exact ⟨⟨H.coeff n, hc n⟩, rfl⟩
  obtain ⟨H₀, hH₀, _, hH₀monic⟩ := lifts_and_degree_eq_and_monic hlift hH
  have hcoeff (n : ℕ) : (H₀.coeff n : K⟦Γ⟧) = H.coeff n := by
    have h := congrArg (fun P => P.coeff n) hH₀
    rw [Polynomial.coeff_map] at h
    exact h
  have hred₀ : H₀.map (standardPart Γ K) = p * q := by
    apply Polynomial.ext
    intro n
    rw [Polynomial.coeff_map, standardPart_apply, hcoeff, hred]
  obtain ⟨⟨P, Q⟩, ⟨hP, hQ, hPd, hQd, hPred, hQred, hcop, hprod⟩, _⟩ :=
    existsUnique_monic_factorization_of_standardPart p q hp hq hpq H₀ hH₀monic hred₀
  let f := (nonnegativeSubring Γ K).subtype
  refine ⟨P.map f, Q.map f, hP.map f, hQ.map f,
    (hP.natDegree_map f).trans hPd, (hQ.natDegree_map f).trans hQd,
    ?_, ?_, ?_, ?_, hcop.map (Polynomial.mapRingHom f), ?_⟩
  · intro n
    rw [Polynomial.coeff_map]
    exact (P.coeff n).property
  · intro n
    rw [Polynomial.coeff_map]
    exact (Q.coeff n).property
  · intro n
    rw [Polynomial.coeff_map]
    have h := congrArg (fun F => F.coeff n) hPred
    rw [Polynomial.coeff_map] at h
    exact h
  · intro n
    rw [Polynomial.coeff_map]
    have h := congrArg (fun F => F.coeff n) hQred
    rw [Polynomial.coeff_map] at h
    exact h
  · rw [← Polynomial.map_mul, hprod]
    exact hH₀

/-- An arbitrary positive-order lower-degree error of a coprime constant
product has actual monic Hahn factors with the prescribed residues. -/
theorem exists_monic_factorization_of_positive_error
    (p q : K[X]) (hp : p.Monic) (hq : q.Monic) (hpq : IsCoprime p q)
    (E : Polynomial K⟦Γ⟧)
    (hEd : E.degree < (p.natDegree + q.natDegree : ℕ))
    (hE : ∀ n, 0 < (E.coeff n).orderTop) :
    ∃ P Q : Polynomial K⟦Γ⟧,
      P.Monic ∧ Q.Monic ∧ P.natDegree = p.natDegree ∧ Q.natDegree = q.natDegree ∧
      (∀ n, 0 ≤ (P.coeff n).orderTop) ∧ (∀ n, 0 ≤ (Q.coeff n).orderTop) ∧
      (∀ n, (P.coeff n).coeff 0 = p.coeff n) ∧
      (∀ n, (Q.coeff n).coeff 0 = q.coeff n) ∧ IsCoprime P Q ∧
      P * Q = (p * q).map (_root_.HahnSeries.C : K →+* K⟦Γ⟧) + E := by
  apply exists_monic_factorization_of_nonnegative_coefficients p q hp hq hpq
  · apply ((hp.mul hq).map _).add_of_left
    simpa only [Polynomial.degree_eq_natDegree ((hp.mul hq).map _).ne_zero,
      (hp.mul hq).natDegree_map, hp.natDegree_mul hq] using hEd
  · intro n
    rw [Polynomial.coeff_add, Polynomial.coeff_map]
    exact (le_min orderTop_single_le (hE n).le).trans min_orderTop_le_orderTop_add
  · intro n
    simp only [Polynomial.coeff_add, Polynomial.coeff_map, HahnSeries.coeff_add,
      _root_.HahnSeries.C_apply, coeff_single_same,
      coeff_eq_zero_of_lt_orderTop (hE n), add_zero]

end

end Surreal.HahnSeries
