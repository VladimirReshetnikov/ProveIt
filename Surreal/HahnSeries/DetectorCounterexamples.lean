import Surreal.Algebra.DetectorCounterexamples
import Surreal.HahnSeries.PolynomialEvaluation
import Surreal.HahnSeries.QuadraticIdealBoundary
import Surreal.HahnSeries.DiophantineConstants
import Surreal.HahnSeries.IntersectiveDetector

/-!
# Hahn realizations of the detector counterexamples

The two intermediate-ring examples in `odg:def:rem:rootneeded`.
The rational example has quotient Q by `1 + omega` and still defines
the ordinary integers by Xi. The real integer-polynomial example has
nonzero constant term without a detector certificate, even though its
ambient coefficient field contains a root of Lambda. Both are realized
at `single (-1) 1` in the manuscript's integer-exponent Hahn workspace.
-/

namespace Surreal.HahnSeries

open Polynomial IntersectivePolynomial

noncomputable section

variable {Γ K : Type*} [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ] [Field K]

/-- The image of `Z + X Q[X]` under polynomial evaluation at a Hahn element. -/
def rationalPolynomialPullback (f : nonpositiveSupportSubring Γ ℚ) :
    Subring (nonpositiveSupportSubring Γ ℚ) :=
  DetectorCounterexamples.rationalPullback.map (supportPolynomialEval f)

/-- The image is literally `Z + f Q[f]`, with the polynomial factor displayed. -/
theorem mem_rationalPolynomialPullback_iff (f x : nonpositiveSupportSubring Γ ℚ) :
    x ∈ rationalPolynomialPullback f ↔
      ∃ n : ℤ, ∃ q : ℚ[X], x = nonpositiveConstants (n : ℚ) + f * supportPolynomialEval f q := by
  constructor
  · rintro ⟨p, hp, rfl⟩
    obtain ⟨n, q, rfl⟩ := DetectorCounterexamples.mem_rationalPullback_iff p |>.mp hp
    exact ⟨n, q, by simp⟩
  · rintro ⟨n, q, rfl⟩
    refine ⟨C (n : ℚ) + X * q, ?_, by simp⟩
    exact (DetectorCounterexamples.mem_rationalPullback_iff _).mpr ⟨n, q, rfl⟩

/-- Faithful evaluation identifies the rational polynomial pullback with its Hahn image. -/
def rationalPolynomialEquiv (f : nonpositiveSupportSubring Γ ℚ) (hf : f.val.order < 0) :
    DetectorCounterexamples.rationalPullback ≃+* rationalPolynomialPullback f :=
  DetectorCounterexamples.rationalPullback.equivMapOfInjective (supportPolynomialEval f)
    (supportPolynomialEval_injective f hf)

/-- The rejected element of the rational intermediate Hahn ring. -/
def rationalPolynomialGenerator (f : nonpositiveSupportSubring Γ ℚ) :
    rationalPolynomialPullback f :=
  ⟨1 + f, (mem_rationalPolynomialPullback_iff f _).mpr ⟨1, 1, by simp⟩⟩

@[simp] theorem rationalPolynomialEquiv_generator (f : nonpositiveSupportSubring Γ ℚ)
    (hf : f.val.order < 0) :
    rationalPolynomialEquiv f hf DetectorCounterexamples.generator = rationalPolynomialGenerator f := by
  apply Subtype.ext
  change supportPolynomialEval f (1 + X) = 1 + f
  simp

/-- Evaluating the polynomial representative at minus one is a Hahn subring homomorphism. -/
def rationalPolynomialMinusOne (f : nonpositiveSupportSubring Γ ℚ) (hf : f.val.order < 0) :
    rationalPolynomialPullback f →+* ℚ :=
  DetectorCounterexamples.evaluateMinusOne.comp (rationalPolynomialEquiv f hf).symm.toRingHom

theorem rationalPolynomialMinusOne_surjective (f : nonpositiveSupportSubring Γ ℚ)
    (hf : f.val.order < 0) : Function.Surjective (rationalPolynomialMinusOne f hf) :=
  DetectorCounterexamples.evaluateMinusOne_surjective.comp
    (rationalPolynomialEquiv f hf).symm.surjective

@[simp] theorem rationalPolynomialMinusOne_generator (f : nonpositiveSupportSubring Γ ℚ)
    (hf : f.val.order < 0) : rationalPolynomialMinusOne f hf (rationalPolynomialGenerator f) = 0 := by
  change DetectorCounterexamples.evaluateMinusOne
    ((rationalPolynomialEquiv f hf).symm (rationalPolynomialGenerator f)) = 0
  rw [← rationalPolynomialEquiv_generator f hf, RingEquiv.symm_apply_apply]
  exact DetectorCounterexamples.evaluateMinusOne_generator

/-- The kernel is exactly the ideal generated by `1 + f`. -/
theorem rationalPolynomialMinusOne_ker (f : nonpositiveSupportSubring Γ ℚ)
    (hf : f.val.order < 0) :
    RingHom.ker (rationalPolynomialMinusOne f hf) = Ideal.span {rationalPolynomialGenerator f} := by
  ext p
  rw [RingHom.mem_ker, Ideal.mem_span_singleton]
  constructor
  · intro hp
    have hm : (rationalPolynomialEquiv f hf).symm p ∈
        RingHom.ker DetectorCounterexamples.evaluateMinusOne := hp
    rw [DetectorCounterexamples.evaluateMinusOne_ker, Ideal.mem_span_singleton] at hm
    obtain ⟨q, hq⟩ := hm
    refine ⟨rationalPolynomialEquiv f hf q, ?_⟩
    rw [← rationalPolynomialEquiv_generator f hf, ← map_mul, ← hq]
    exact ((rationalPolynomialEquiv f hf).apply_symm_apply p).symm
  · rintro ⟨q, rfl⟩
    rw [map_mul, rationalPolynomialMinusOne_generator, zero_mul]

/-- The source's quotient by `1 + f` is the rational field. -/
def rationalPolynomialQuotientEquiv (f : nonpositiveSupportSubring Γ ℚ) (hf : f.val.order < 0) :
    rationalPolynomialPullback f ⧸ Ideal.span {rationalPolynomialGenerator f} ≃+* ℚ :=
  (Ideal.quotEquivOfEq (rationalPolynomialMinusOne_ker f hf).symm).trans
    ((rationalPolynomialMinusOne f hf).quotientKerEquivOfSurjective
      (rationalPolynomialMinusOne_surjective f hf))

theorem rationalPolynomial_quotient_root_free (f : nonpositiveSupportSubring Γ ℚ)
    (hf : f.val.order < 0)
    (t : rationalPolynomialPullback f ⧸ Ideal.span {rationalPolynomialGenerator f}) : value t ≠ 0 := by
  intro ht
  have hm := congrArg (rationalPolynomialQuotientEquiv f hf).toRingHom ht
  rw [map_value, map_zero] at hm
  exact DetectorCounterexamples.rational_value_ne_zero _ hm

/-- A negative-order generator gives the same detector obstruction in the Hahn image. -/
theorem rationalPolynomial_not_detects (f : nonpositiveSupportSubring Γ ℚ)
    (hf : f.val.order < 0) : ¬ Detects (rationalPolynomialGenerator f) :=
  DetectorCounterexamples.not_detects_of_root_free_image (rationalPolynomialMinusOne f hf)
    DetectorCounterexamples.rational_value_ne_zero _ (rationalPolynomialMinusOne_generator f hf)

/-- The constant intersection of this intermediate ring consists exactly of integers. -/
theorem rationalPolynomial_constants (f : nonpositiveSupportSubring Γ ℚ)
    (hc : nonpositiveConstantCoeff f = 0) (c : ℚ) :
    nonpositiveConstants c ∈ rationalPolynomialPullback f ↔ c ∈ (Int.castRingHom ℚ).range := by
  rw [mem_rationalPolynomialPullback_iff]
  constructor
  · rintro ⟨n, q, he⟩
    have hct := congrArg (nonpositiveConstantCoeff (Γ := Γ) (R := ℚ)) he
    simp only [map_add, map_mul, nonpositiveConstantCoeff_constants, hc, zero_mul, add_zero] at hct
    exact ⟨n, hct.symm⟩
  · rintro ⟨n, rfl⟩
    exact ⟨n, 0, by simp⟩

/-- Xi still defines the ordinary integers inside the rational Hahn example. -/
theorem rationalPolynomial_xi_iff (f : nonpositiveSupportSubring Γ ℚ)
    (hc : nonpositiveConstantCoeff f = 0) (x : rationalPolynomialPullback f) :
    DiophantineConstants.Xi x ↔ ∃ n : ℤ, x.val = nonpositiveConstants (n : ℚ) :=
  integer_intermediate_xi_iff _ (rationalPolynomial_constants f hc) x

/-- Constant term one and failure of the detector hold simultaneously. -/
theorem rationalPolynomial_boundary (f : nonpositiveSupportSubring Γ ℚ)
    (hf : f.val.order < 0) (hc : nonpositiveConstantCoeff f = 0) :
    nonpositiveConstantCoeff (rationalPolynomialGenerator f).val = 1 ∧
      ¬ Detects (rationalPolynomialGenerator f) := by
  refine ⟨?_, rationalPolynomial_not_detects f hf⟩
  change nonpositiveConstantCoeff (1 + f) = 1
  rw [map_add, map_one, hc, add_zero]

/-- The rational-coefficient omega in the integer-exponent Hahn workspace. -/
def rationalIntegerExponentOmega : nonpositiveSupportSubring ℤ ℚ :=
  ⟨_root_.HahnSeries.single (-1) 1, by
    intro a ha
    rw [_root_.HahnSeries.coeff_single_of_ne (by omega : a ≠ -1)]⟩

theorem rationalIntegerExponentOmega_order : rationalIntegerExponentOmega.val.order < 0 := by
  change (_root_.HahnSeries.single (-1 : ℤ) (1 : ℚ)).order < 0
  rw [_root_.HahnSeries.order_single one_ne_zero]
  norm_num

theorem rationalIntegerExponentOmega_constant :
    nonpositiveConstantCoeff rationalIntegerExponentOmega = 0 := by
  change (_root_.HahnSeries.single (-1 : ℤ) (1 : ℚ)).coeff 0 = 0
  simp

/-- The concrete rational Hahn quotient from the manuscript. -/
def rationalOmegaQuotientEquiv :
    rationalPolynomialPullback rationalIntegerExponentOmega ⧸
      Ideal.span {rationalPolynomialGenerator rationalIntegerExponentOmega} ≃+* ℚ :=
  rationalPolynomialQuotientEquiv _ rationalIntegerExponentOmega_order

theorem rationalOmega_boundary :
    nonpositiveConstantCoeff (rationalPolynomialGenerator rationalIntegerExponentOmega).val = 1 ∧
      ¬ Detects (rationalPolynomialGenerator rationalIntegerExponentOmega) :=
  rationalPolynomial_boundary _ rationalIntegerExponentOmega_order rationalIntegerExponentOmega_constant

theorem rationalOmega_xi_iff (x : rationalPolynomialPullback rationalIntegerExponentOmega) :
    DiophantineConstants.Xi x ↔ ∃ n : ℤ, x.val = nonpositiveConstants (n : ℚ) :=
  rationalPolynomial_xi_iff _ rationalIntegerExponentOmega_constant x

/-- Integer evaluation agrees with coefficient-field evaluation after mapping coefficients. -/
theorem supportPolynomialEval_map_int [CharZero K] (f : nonpositiveSupportSubring Γ K)
    (P : ℤ[X]) :
    supportPolynomialEval f (P.map (Int.castRingHom K)) = integerPolynomialEval f P := by
  change (P.map (Int.castRingHom K)).eval₂ nonpositiveConstants f = P.eval₂ _ f
  rw [Polynomial.eval₂_map]

/-- The generated integer ring lies inside the ambient coefficient-field polynomial ring. -/
theorem integerPolynomialRange_le_polynomialRange [CharZero K]
    (f : nonpositiveSupportSubring Γ K) :
    (integerPolynomialEval f).range ≤ (supportPolynomialEval f).range := by
  rintro _ ⟨P, rfl⟩
  exact ⟨P.map (Int.castRingHom K), supportPolynomialEval_map_int f P⟩

/-- Integer polynomial evaluation identifies Z[X] with the subring it generates. -/
def integerPolynomialRangeEquiv [CharZero K] (f : nonpositiveSupportSubring Γ K)
    (hf : f.val.order < 0) : ℤ[X] ≃+* (integerPolynomialEval f).range :=
  RingEquiv.ofBijective (integerPolynomialEval f).rangeRestrict
    ⟨fun _ _ h => integerPolynomialEval_injective f hf (congrArg Subtype.val h),
      (integerPolynomialEval f).rangeRestrict_surjective⟩

/-- The element `1 + f`, considered internally to the generated integer polynomial ring. -/
def integerPolynomialGenerator [CharZero K] (f : nonpositiveSupportSubring Γ K) :
    (integerPolynomialEval f).range := (integerPolynomialEval f).rangeRestrict (1 + X)

@[simp] theorem integerPolynomialGenerator_val [CharZero K]
    (f : nonpositiveSupportSubring Γ K) : (integerPolynomialGenerator f).val = 1 + f := by
  change integerPolynomialEval f (1 + X) = 1 + f
  simp [integerPolynomialEval]

/-- Pulling a certificate back to Z[X] contradicts evaluation at minus one. -/
theorem integerPolynomial_not_detects [CharZero K] (f : nonpositiveSupportSubring Γ K)
    (hf : f.val.order < 0) : ¬ Detects (integerPolynomialGenerator f) := by
  intro h
  have hm := h.map (integerPolynomialRangeEquiv f hf).symm.toRingHom
  have hg : integerPolynomialGenerator f = integerPolynomialRangeEquiv f hf (1 + X) := rfl
  change Detects ((integerPolynomialRangeEquiv f hf).symm (integerPolynomialGenerator f)) at hm
  rw [hg, RingEquiv.symm_apply_apply] at hm
  exact DetectorCounterexamples.integer_polynomial_not_detects hm

/-- The generated integer polynomial ring is contained in the full coefficient pullback. -/
theorem integerPolynomialRange_le_restricted [CharZero K] (f : nonpositiveSupportSubring Γ K)
    (hc : nonpositiveConstantCoeff f = 0) :
    (integerPolynomialEval f).range ≤ coefficientRestrictedSubring (Γ := Γ) (Int.castRingHom K) := by
  rintro _ ⟨P, rfl⟩
  exact ⟨P.coeff 0, (constantCoeff_integerPolynomialEval f hc P).symm⟩

/-- In an ambient field with sqrt(13), the polynomial ring is a proper subring of the pullback. -/
theorem integerPolynomialRange_lt_restricted [CharZero K] (r : K) (hr : r ^ 2 = 13)
    (f : nonpositiveSupportSubring Γ K) (hf : f.val.order < 0)
    (hc : nonpositiveConstantCoeff f = 0) :
    (integerPolynomialEval f).range < coefficientRestrictedSubring (Γ := Γ) (Int.castRingHom K) := by
  refine lt_of_le_of_ne (integerPolynomialRange_le_restricted f hc) ?_
  intro he
  have hd : ∀ a : (integerPolynomialEval f).range,
      Detects a ↔ nonpositiveConstantCoeff a.val ≠ 0 := by
    rw [he]
    exact integerRestricted_detector_iff r hr
  apply integerPolynomial_not_detects f hf
  apply (hd (integerPolynomialGenerator f)).mpr
  rw [integerPolynomialGenerator_val, map_add, map_one, hc, add_zero]
  exact one_ne_zero

/-- The real Hahn coefficient field supplies an ambient constant root of Lambda. -/
theorem realHahn_coefficient_root :
    value (nonpositiveConstants (Γ := Γ) (Real.sqrt 13)) = 0 := by
  rw [← map_value, DetectorCounterexamples.real_coefficient_root, map_zero]

/-- The real omega used in the manuscript has strictly negative Hahn order. -/
theorem integerExponentOmega_order : integerExponentOmega.val.order < 0 := by
  change (_root_.HahnSeries.single (-1 : ℤ) (1 : ℝ)).order < 0
  rw [_root_.HahnSeries.order_single one_ne_zero]
  norm_num

/-- The concrete Z[omega] example has nonzero constant term without a detector certificate. -/
theorem integerOmega_detector_boundary :
    nonpositiveConstantCoeff (integerPolynomialGenerator integerExponentOmega).val = 1 ∧
      ¬ Detects (integerPolynomialGenerator integerExponentOmega) := by
  refine ⟨?_, integerPolynomial_not_detects _ integerExponentOmega_order⟩
  rw [integerPolynomialGenerator_val, map_add, map_one, integerExponentOmega_boundary.2.1, add_zero]

/-- Z[omega] is strictly smaller than the full real Hahn integer-constant pullback. -/
theorem integerOmega_lt_restricted :
    (integerPolynomialEval integerExponentOmega).range <
      coefficientRestrictedSubring (Γ := ℤ) (Int.castRingHom ℝ) :=
  integerPolynomialRange_lt_restricted (Real.sqrt 13) (by norm_num [Real.sq_sqrt])
    _ integerExponentOmega_order integerExponentOmega_boundary.2.1

end
end Surreal.HahnSeries
