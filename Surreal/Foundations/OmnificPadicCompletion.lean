import Surreal.Foundations.OmnificConstantRigidity
import Mathlib.RingTheory.AdicCompletion.Algebra
import Mathlib.NumberTheory.Padics.RingHoms

/-!
# The ordinary p-adic completion of the actual omnific ring

The p-adic clause of `odg:eq:profinite`. We use Mathlib's `AdicCompletion`
for the actual principal ideal and `PadicInt` for the target. Compatibility with all
quotient projections determines both inverse maps and the canonical map.
-/

universe u
namespace Surreal.Foundations.SignSequence

noncomputable section

/-- The ideal generated by the ordinary prime in the actual omnific ring. -/
def omnificPadicIdeal (p : ℕ) : Ideal OmnificInteger.{u} := Ideal.span {omnificIntCast (p : ℤ)}

/-- Every ideal-power quotient is its ordinary residue ring. -/
def omnificPadicQuotientEquiv (p : ℕ) [hp : Fact p.Prime] (k : ℕ) :
    OmnificInteger.{u} ⧸ (omnificPadicIdeal p) ^ k ≃+* ZMod (p ^ k) :=
  (Ideal.quotEquivOfEq (show (omnificPadicIdeal p) ^ k =
    Ideal.span {omnificIntCast ((p ^ k : ℕ) : ℤ)} by
      rw [omnificPadicIdeal, Ideal.span_singleton_pow, ← map_pow, ← Int.natCast_pow])).trans
    ((omnificQuotientIntEquiv (p ^ k : ℕ) (by exact_mod_cast pow_ne_zero k hp.out.ne_zero)).trans
      (Int.quotientSpanNatEquivZMod (p ^ k)))

/-- On actual representatives, the quotient equivalence takes the integer constant residue. -/
@[simp] theorem omnificPadicQuotientEquiv_mk (p : ℕ) [Fact p.Prime] (k : ℕ)
    (x : OmnificInteger.{u}) :
    omnificPadicQuotientEquiv p k (Ideal.Quotient.mk _ x) = (omnificConstantCoeff x : ZMod (p ^ k)) := by
  simp only [omnificPadicQuotientEquiv, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
    omnificQuotientIntEquiv_mk]
  exact RingHom.congr_fun (Int.quotientSpanNatEquivZMod_comp_Quotient_mk (p ^ k))
    (omnificConstantCoeff x)

/-- All transition maps agree with ordinary reduction between prime-power residues. -/
theorem omnificPadicQuotientEquiv_compatible (p : ℕ) [Fact p.Prime]
    {m n : ℕ} (h : m ≤ n) (x : OmnificInteger.{u} ⧸ (omnificPadicIdeal p) ^ n) :
    ZMod.castHom (pow_dvd_pow p h) _ (omnificPadicQuotientEquiv p n x) =
      omnificPadicQuotientEquiv p m (Ideal.Quotient.factorPow (omnificPadicIdeal p) h x) := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  simp only [Ideal.Quotient.factor_mk, omnificPadicQuotientEquiv_mk, map_intCast]

/-- The actual p-adic completion, using Mathlib's ideal-adic construction. -/
abbrev OmnificPadicCompletion (p : ℕ) := AdicCompletion (omnificPadicIdeal.{u} p) OmnificInteger.{u}

/-- The ordinary residue projection from the actual adic completion. -/
def omnificPadicProjection (p : ℕ) [Fact p.Prime] (k : ℕ) :
    OmnificPadicCompletion.{u} p →+* ZMod (p ^ k) :=
  (omnificPadicQuotientEquiv p k).toRingHom.comp
    (AdicCompletion.evalₐ (omnificPadicIdeal p) k).toRingHom

private theorem adic_eval_compatible {R : Type*} [CommRing R] (I : Ideal R)
    {m n : ℕ} (h : m ≤ n) (x : AdicCompletion I R) :
    Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
  obtain ⟨r, rfl⟩ := AdicCompletion.mk_surjective I R x
  simp only [AdicCompletion.evalₐ_mk, Ideal.Quotient.factor_mk]
  exact AdicCompletion.Ideal.mk_eq_mk I h r

/-- The completion projections form a compatible family of ordinary residues. -/
theorem omnificPadicProjection_compatible (p : ℕ) [Fact p.Prime] (m n : ℕ) (h : m ≤ n) :
    (ZMod.castHom (pow_dvd_pow p h) _).comp (omnificPadicProjection.{u} p n) =
      omnificPadicProjection p m := by
  apply RingHom.ext
  intro x
  change ZMod.castHom (pow_dvd_pow p h) _
    (omnificPadicQuotientEquiv p n (AdicCompletion.evalₐ _ n x)) = _
  rw [omnificPadicQuotientEquiv_compatible p h, adic_eval_compatible]
  rfl

/-- Map the actual completion to Mathlib's p-adic integers by its universal property. -/
def omnificCompletionToPadic (p : ℕ) [Fact p.Prime] : OmnificPadicCompletion.{u} p →+* ℤ_[p] :=
  PadicInt.lift (omnificPadicProjection_compatible p)

/-- The map to p-adic integers preserves each prime-power projection. -/
@[simp] theorem toZModPow_omnificCompletionToPadic (p : ℕ) [Fact p.Prime]
    (k : ℕ) (x : OmnificPadicCompletion.{u} p) :
    PadicInt.toZModPow k (omnificCompletionToPadic p x) = omnificPadicProjection p k x :=
  RingHom.congr_fun (PadicInt.lift_spec (omnificPadicProjection_compatible p) k) x

private def padicToOmnificQuotient (p : ℕ) [Fact p.Prime] (k : ℕ) :
    ℤ_[p] →+* OmnificInteger.{u} ⧸ (omnificPadicIdeal p) ^ k :=
  (omnificPadicQuotientEquiv p k).symm.toRingHom.comp (PadicInt.toZModPow k)

private theorem padicToOmnificQuotient_compatible (p : ℕ) [Fact p.Prime]
    {m n : ℕ} (h : m ≤ n) :
    (Ideal.Quotient.factorPow (omnificPadicIdeal p) h).comp (padicToOmnificQuotient.{u} p n) =
      padicToOmnificQuotient p m := by
  apply RingHom.ext
  intro x
  apply (omnificPadicQuotientEquiv p m).injective
  change omnificPadicQuotientEquiv p m
    (Ideal.Quotient.factorPow (omnificPadicIdeal p) h ((omnificPadicQuotientEquiv p n).symm
      (PadicInt.toZModPow n x))) = _
  rw [← omnificPadicQuotientEquiv_compatible, RingEquiv.apply_symm_apply]
  change ZMod.castHom _ _ (PadicInt.toZModPow n x) =
    omnificPadicQuotientEquiv p m ((omnificPadicQuotientEquiv p m).symm (PadicInt.toZModPow m x))
  rw [RingEquiv.apply_symm_apply]
  exact RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow m n h) x

/-- Lift all the compatible p-adic residues back to the actual omnific adic completion. -/
def padicToOmnificCompletion (p : ℕ) [Fact p.Prime] : ℤ_[p] →+* OmnificPadicCompletion.{u} p :=
  AdicCompletion.liftRingHom (omnificPadicIdeal p) (padicToOmnificQuotient p)
    (padicToOmnificQuotient_compatible p)

/-- The inverse lift recovers the original ordinary residue at every level. -/
@[simp] theorem omnificPadicProjection_padicToOmnificCompletion (p : ℕ) [Fact p.Prime]
    (k : ℕ) (x : ℤ_[p]) :
    omnificPadicProjection p k (padicToOmnificCompletion.{u} p x) = PadicInt.toZModPow k x := by
  change omnificPadicQuotientEquiv p k
    (AdicCompletion.evalₐ _ k (AdicCompletion.liftRingHom _ (padicToOmnificQuotient p)
      (padicToOmnificQuotient_compatible p) x)) = _
  rw [AdicCompletion.evalₐ_liftRingHom]
  exact (omnificPadicQuotientEquiv p k).apply_symm_apply _

/-- The p-adic completion of the actual omnific ring is ring-isomorphic to ordinary p-adic integers. -/
def omnificPadicCompletionEquiv (p : ℕ) [Fact p.Prime] : OmnificPadicCompletion.{u} p ≃+* ℤ_[p] :=
  { omnificCompletionToPadic p with
    invFun := padicToOmnificCompletion p
    left_inv := by
      intro x
      apply AdicCompletion.ext_evalₐ
      intro k
      apply (omnificPadicQuotientEquiv p k).injective
      change omnificPadicProjection p k (padicToOmnificCompletion p (omnificCompletionToPadic p x)) = _
      rw [omnificPadicProjection_padicToOmnificCompletion, toZModPow_omnificCompletionToPadic]
      rfl
    right_inv := by
      intro x
      apply PadicInt.ext_of_toZModPow.mp
      intro k
      change PadicInt.toZModPow k (omnificCompletionToPadic p (padicToOmnificCompletion p x)) = _
      rw [toZModPow_omnificCompletionToPadic, omnificPadicProjection_padicToOmnificCompletion] }

/-- The completion map is integer constant extraction followed by the ordinary p-adic embedding. -/
theorem omnificPadicCompletionEquiv_of (p : ℕ) [Fact p.Prime] (x : OmnificInteger.{u}) :
    omnificPadicCompletionEquiv p (AdicCompletion.of (omnificPadicIdeal p) OmnificInteger x) =
      (omnificConstantCoeff x : ℤ_[p]) := by
  apply PadicInt.ext_of_toZModPow.mp
  intro k
  change PadicInt.toZModPow k (omnificCompletionToPadic p _) = _
  rw [toZModPow_omnificCompletionToPadic]
  change omnificPadicQuotientEquiv p k (AdicCompletion.evalₐ _ k (AdicCompletion.of _ _ x)) = _
  rw [AdicCompletion.evalₐ_of, omnificPadicQuotientEquiv_mk, map_intCast]

/-- Exactly the purely infinite ideal vanishes in the p-adic completion. -/
theorem omnific_padic_completion_eq_zero_iff (p : ℕ) [Fact p.Prime] (x : OmnificInteger.{u}) :
    AdicCompletion.of (omnificPadicIdeal p) OmnificInteger x = 0 ↔ x ∈ omnificPurelyInfiniteIdeal := by
  rw [← (omnificPadicCompletionEquiv p).injective.eq_iff, map_zero, omnificPadicCompletionEquiv_of]
  change (omnificConstantCoeff x : ℤ_[p]) = 0 ↔ omnificConstantCoeff x = 0
  exact Int.cast_eq_zero

end
end Surreal.Foundations.SignSequence
