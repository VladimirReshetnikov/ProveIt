import Surreal.Foundations.OmnificResidues
import Surreal.Foundations.OmnificIntegerDivisors
import Mathlib.RingTheory.Ideal.Int
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Ordinary primes, mixed gcds and Chinese remainders

The full `odg:cor:mixedgcd`. These results concern ordinary integer moduli
inside the actual omnific ring; no global gcd structure on that ring is
assumed. The ideal and quotient constructions reuse Mathlib's Bézout and
finite-family Chinese remainder theorems.
-/

universe u v
namespace Surreal.Foundations.SignSequence

noncomputable section

/-- An ordinary prime generates a maximal ideal of the actual omnific ring. -/
theorem omnific_prime_span_isMaximal (p : ℕ) [hp : Fact p.Prime] :
    (Ideal.span {omnificIntCast (p : ℤ)} : Ideal OmnificInteger.{u}).IsMaximal := by
  apply Ideal.Quotient.maximal_of_isField
  exact (omnificQuotientIntEquiv p (by exact_mod_cast hp.out.ne_zero)).toMulEquiv.isField
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient _ |>.mp inferInstance)

/-- Every positive ordinary prime remains a prime element of the actual omnific ring. -/
theorem omnific_prime (p : ℕ) [hp : Fact p.Prime] :
    Prime (omnificIntCast (p : ℤ) : OmnificInteger.{u}) := by
  apply (Ideal.span_singleton_prime ?_).mp (omnific_prime_span_isMaximal p).isPrime
  intro h
  have hz := congrArg omnificConstantCoeff h
  simp only [omnificConstantCoeff_intCast, map_zero] at hz
  exact hp.out.ne_zero (Int.natCast_eq_zero.mp hz)

/-- Removing the purely infinite part does not change an ideal containing a nonzero integer. -/
theorem omnific_span_pair_eq_constants (n : ℤ) (hn : n ≠ 0) (x : OmnificInteger.{u}) :
    Ideal.span {omnificIntCast n, x} =
      Ideal.span {omnificIntCast n, omnificIntCast (omnificConstantCoeff x)} := by
  have hd : omnificIntCast n ∣ x - omnificIntCast (omnificConstantCoeff x) := by
    rw [omnific_int_dvd_iff n hn, map_sub, omnificConstantCoeff_intCast, _root_.sub_self]
    exact dvd_zero n
  obtain ⟨y, hy⟩ := hd
  have hx : x = omnificIntCast (omnificConstantCoeff x) + omnificIntCast n * y := by
    rw [← hy]
    abel
  conv_lhs => rw [hx]
  exact Ideal.span_pair_add_left_mul _ _ _

/-- The mixed ideal is generated by the ordinary gcd of the modulus and constant term. -/
theorem omnific_span_pair_eq_gcd (n : ℤ) (hn : n ≠ 0) (x : OmnificInteger.{u}) :
    Ideal.span {omnificIntCast n, x} =
      Ideal.span {omnificIntCast (Int.gcd n (omnificConstantCoeff x) : ℤ)} := by
  rw [omnific_span_pair_eq_constants n hn x]
  have h := congrArg (Ideal.map omnificIntCast) (_root_.span_gcd n (omnificConstantCoeff x))
  simpa only [Ideal.map_span, Set.image_insert_eq, Set.image_singleton, ← Int.coe_gcd] using h.symm

/-- The ordinary mixed gcd divides both generators and is divisible by every common divisor. -/
theorem omnific_mixed_gcd (n : ℤ) (hn : n ≠ 0) (x : OmnificInteger.{u}) :
    let g := omnificIntCast (Int.gcd n (omnificConstantCoeff x) : ℤ)
    g ∣ omnificIntCast n ∧ g ∣ x ∧
      ∀ d : OmnificInteger.{u}, d ∣ omnificIntCast n → d ∣ x → d ∣ g := by
  dsimp only
  have hs := omnific_span_pair_eq_gcd n hn x
  constructor
  · apply Ideal.mem_span_singleton.mp
    rw [← hs]
    exact Ideal.subset_span (by simp)
  constructor
  · apply Ideal.mem_span_singleton.mp
    rw [← hs]
    exact Ideal.subset_span (by simp)
  · intro d hd hx
    have hle : Ideal.span {omnificIntCast n, x} ≤ Ideal.span {d} := by
      apply Ideal.span_le.mpr
      intro y hy
      rcases Set.mem_insert_iff.mp hy with rfl | hy
      · exact Ideal.mem_span_singleton.mpr hd
      · rcases Set.mem_singleton_iff.mp hy with rfl
        exact Ideal.mem_span_singleton.mpr hx
    rw [hs] at hle
    exact Ideal.mem_span_singleton.mp (hle (Ideal.mem_span_singleton_self _))

/-- Coprime ordinary constants generate comaximal omnific ideals. -/
theorem omnific_int_spans_isCoprime (m n : ℤ) (h : IsCoprime m n) :
    IsCoprime (Ideal.span {omnificIntCast m} : Ideal OmnificInteger.{u})
      (Ideal.span {omnificIntCast n}) :=
  (Ideal.isCoprime_span_singleton_iff _ _).mpr (h.map omnificIntCast)

/-- Chinese remainders for any finite family of pairwise coprime nonzero ordinary moduli. -/
def omnificChineseRemainder {ι : Type v} [Finite ι] (n : ι → ℤ)
    (hn : ∀ i, n i ≠ 0) (hc : Pairwise (fun i j => IsCoprime (n i) (n j))) :
    OmnificInteger.{u} ⧸ (⨅ i, Ideal.span {omnificIntCast (n i)}) ≃+*
      ((i : ι) → ℤ ⧸ Ideal.span ({n i} : Set ℤ)) :=
  (Ideal.quotientInfRingEquivPiQuotient (fun i => Ideal.span {omnificIntCast (n i)})
    (fun i j hij => omnific_int_spans_isCoprime (n i) (n j) (hc hij))).trans
      (RingEquiv.piCongrRight (fun i => omnificQuotientIntEquiv (n i) (hn i)))

/-- Each component of the Chinese remainder map is the ordinary constant-term residue. -/
@[simp] theorem omnificChineseRemainder_mk {ι : Type v} [Finite ι] (n : ι → ℤ)
    (hn : ∀ i, n i ≠ 0) (hc : Pairwise (fun i j => IsCoprime (n i) (n j)))
    (x : OmnificInteger.{u}) (i : ι) :
    omnificChineseRemainder n hn hc (Ideal.Quotient.mk _ x) i =
      Ideal.Quotient.mk (Ideal.span {n i}) (omnificConstantCoeff x) := by
  change omnificQuotientIntEquiv (n i) (hn i) (Ideal.Quotient.mk _ x) = _
  exact omnificQuotientIntEquiv_mk _ _ _

/-- The intersection of the coprime principal ideals is generated by the product of the moduli. -/
theorem iInf_omnific_coprime_int_spans {ι : Type v} [Fintype ι] (n : ι → ℤ)
    (hc : Pairwise (fun i j => IsCoprime (n i) (n j))) :
    (⨅ i, Ideal.span {omnificIntCast (n i)} : Ideal OmnificInteger.{u}) =
      Ideal.span {omnificIntCast (∏ i, n i)} := by
  rw [Ideal.iInf_span_singleton (fun i j hij => (hc hij).map omnificIntCast), map_prod]

/-- The product-modulus form of the Chinese remainder isomorphism. -/
def omnificChineseRemainderProduct {ι : Type v} [Fintype ι] (n : ι → ℤ)
    (hn : ∀ i, n i ≠ 0) (hc : Pairwise (fun i j => IsCoprime (n i) (n j))) :
    OmnificInteger.{u} ⧸ Ideal.span {omnificIntCast (∏ i, n i)} ≃+*
      ((i : ι) → ℤ ⧸ Ideal.span ({n i} : Set ℤ)) :=
  (Ideal.quotEquivOfEq (iInf_omnific_coprime_int_spans n hc).symm).trans
    (omnificChineseRemainder n hn hc)

end
end Surreal.Foundations.SignSequence
