import Surreal.Foundations.OmnificCongruenceTopology

/-!
# The arithmetic topologies on the separated omnific quotients

The separated-quotient assertion following `odg:eq:profinite`, including
its topology. Constant extraction induces both the ordinary congruence
topology and the topology of each ordinary prime. The existing separation
ring equivalences are homeomorphisms to the corresponding topologies on `ℤ`.
All topologies are explicit, leaving the order topologies unchanged.
-/

universe u
namespace Surreal.Foundations.SignSequence

open Topology

noncomputable section

/-- The ordinary integer ideal for a positive congruence modulus. -/
def integerCongruenceIdeal (n : {n : ℕ // 0 < n}) : Ideal ℤ :=
  Ideal.span {(n.val : ℤ)}

/-- Products of positive moduli refine their ordinary integer congruence ideals. -/
theorem integerCongruenceIdeal_directed (m n : {n : ℕ // 0 < n}) :
    ∃ k, integerCongruenceIdeal k ≤ integerCongruenceIdeal m ⊓ integerCongruenceIdeal n := by
  refine ⟨⟨m.val * n.val, Nat.mul_pos m.property n.property⟩, ?_⟩
  apply le_inf
  · rw [integerCongruenceIdeal, integerCongruenceIdeal,
      Ideal.span_singleton_le_span_singleton, Nat.cast_mul]
    exact dvd_mul_right _ _
  · rw [integerCongruenceIdeal, integerCongruenceIdeal,
      Ideal.span_singleton_le_span_singleton, Nat.cast_mul]
    exact dvd_mul_left _ _

/-- The topology on ordinary integers generated by all positive-modulus congruences. -/
@[implicit_reducible] def integerCongruenceTopology : TopologicalSpace ℤ :=
  IdealCongruenceTopology.topology integerCongruenceIdeal integerCongruenceIdeal_directed

/-- Ordinary integer congruences define a topological ring. -/
theorem integerCongruenceTopology_isTopologicalRing :
    @IsTopologicalRing ℤ integerCongruenceTopology _ :=
  IdealCongruenceTopology.isTopologicalRing _ _

/-- Integer constant extraction induces exactly the ordinary omnific congruence topology. -/
theorem isInducing_omnificConstantCoeff_congruence :
    @IsInducing OmnificInteger.{u} ℤ omnificCongruenceTopology integerCongruenceTopology
      omnificConstantCoeff := by
  letI := omnificCongruenceTopology.{u}
  letI := integerCongruenceTopology
  apply IdealCongruenceTopology.isInducing_of_hasBasis omnificCongruenceIdeal
    integerCongruenceIdeal omnificConstantCoeff
    (IdealCongruenceTopology.hasBasis_nhds _ omnificCongruenceIdeal_directed)
    (IdealCongruenceTopology.hasBasis_nhds _ integerCongruenceIdeal_directed)
  intro n x
  simp only [omnificCongruenceIdeal, integerCongruenceIdeal, Ideal.mem_span_singleton]
  exact omnific_int_dvd_iff _ (by exact_mod_cast n.property.ne') x

section Congruence

local instance : TopologicalSpace OmnificInteger.{u} := omnificCongruenceTopology
local instance : IsTopologicalRing OmnificInteger.{u} := omnificCongruenceTopology_isTopologicalRing
local instance : TopologicalSpace ℤ := integerCongruenceTopology

/-- The congruence separation ring equivalence preserves the arithmetic topologies. -/
def omnificCongruenceSeparationHomeomorph : SeparationQuotient OmnificInteger.{u} ≃ₜ ℤ :=
  IdealCongruenceTopology.separationHomeomorph omnificCongruenceSeparationEquiv
    omnificConstantCoeff omnificCongruenceSeparationEquiv_mk
    isInducing_omnificConstantCoeff_congruence omnificConstantCoeff_surjective

/-- This homeomorphism uses exactly the earlier ring identification. -/
@[simp] theorem omnificCongruenceSeparationHomeomorph_apply
    (x : SeparationQuotient OmnificInteger.{u}) :
    omnificCongruenceSeparationHomeomorph x = omnificCongruenceSeparationEquiv x := rfl

/-- The topological separation map sends an omnific integer to its integer constant. -/
@[simp] theorem omnificCongruenceSeparationHomeomorph_mk (x : OmnificInteger.{u}) :
    omnificCongruenceSeparationHomeomorph (SeparationQuotient.mk x) =
      omnificConstantCoeff x := omnificCongruenceSeparationEquiv_mk x

end Congruence

/-- The ordinary integer topology defined by powers of the ideal `(p)`. -/
@[implicit_reducible] def integerPadicTopology (p : ℕ) : TopologicalSpace ℤ :=
  (Ideal.span {(p : ℤ)}).adicTopology

/-- The ordinary ideal-adic topology makes the integers a topological ring. -/
theorem integerPadicTopology_isTopologicalRing (p : ℕ) :
    @IsTopologicalRing ℤ (integerPadicTopology p) _ :=
  (Ideal.span {(p : ℤ)}).ringFilterBasis.isTopologicalRing

private theorem adic_hasBasis_sub {R : Type*} [CommRing R] (I : Ideal R) (x : R) :
    (@nhds R I.adicTopology x).HasBasis (fun _ : ℕ => True)
      (fun k => {y | y - x ∈ I ^ k}) := by
  apply (I.hasBasis_nhds_adic x).congr (fun _ => Iff.rfl)
  intro k _
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩
    change x + z - x ∈ I ^ k
    rw [add_sub_cancel_left]
    exact hz
  · intro hy
    exact ⟨y - x, hy, add_sub_cancel _ _⟩

/-- Each ordinary prime's omnific topology is induced by its integer constant map. -/
theorem isInducing_omnificConstantCoeff_padic (p : ℕ) [Fact p.Prime] :
    @IsInducing OmnificInteger.{u} ℤ (omnificPadicTopology p) (integerPadicTopology p)
      omnificConstantCoeff := by
  letI := omnificPadicTopology.{u} p
  letI := integerPadicTopology p
  apply IdealCongruenceTopology.isInducing_of_hasBasis
    (fun k => (omnificPadicIdeal p) ^ k) (fun k => (Ideal.span {(p : ℤ)}) ^ k)
    omnificConstantCoeff (adic_hasBasis_sub _) (adic_hasBasis_sub _)
  intro k x
  simp only [omnificPadicIdeal, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  rw [← map_pow]
  exact omnific_int_dvd_iff _ (pow_ne_zero _ (by exact_mod_cast (Fact.out : p.Prime).ne_zero)) x

/-- The p-adic separation ring equivalence is a homeomorphism for the ideal-adic topologies. -/
def omnificPadicSeparationHomeomorph (p : ℕ) [Fact p.Prime] :
    letI := omnificPadicTopology.{u} p
    letI := integerPadicTopology p
    SeparationQuotient OmnificInteger.{u} ≃ₜ ℤ := by
  letI := omnificPadicTopology.{u} p
  letI := omnificPadicTopology_isTopologicalRing.{u} p
  letI := integerPadicTopology p
  exact IdealCongruenceTopology.separationHomeomorph (omnificPadicSeparationEquiv p)
    omnificConstantCoeff (omnificPadicSeparationEquiv_mk p)
    (isInducing_omnificConstantCoeff_padic p) omnificConstantCoeff_surjective

/-- The p-adic homeomorphism has exactly the previously proved ring equivalence as its function. -/
@[simp] theorem omnificPadicSeparationHomeomorph_apply (p : ℕ) [Fact p.Prime] :
    letI := omnificPadicTopology.{u} p
    letI := omnificPadicTopology_isTopologicalRing.{u} p
    ∀ x : SeparationQuotient OmnificInteger.{u},
      omnificPadicSeparationHomeomorph p x = omnificPadicSeparationEquiv p x := by
  intro x
  rfl

/-- The p-adic topological separation map is integer constant extraction. -/
@[simp] theorem omnificPadicSeparationHomeomorph_mk (p : ℕ) [Fact p.Prime]
    (x : OmnificInteger.{u}) :
    letI := omnificPadicTopology.{u} p
    omnificPadicSeparationHomeomorph p (SeparationQuotient.mk x) =
      omnificConstantCoeff x := omnificPadicSeparationEquiv_mk p x

end
end Surreal.Foundations.SignSequence
