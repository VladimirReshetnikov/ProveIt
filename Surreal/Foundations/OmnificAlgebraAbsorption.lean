import Surreal.Algebra.IdealAbsorption
import Surreal.Algebra.IntegralReciprocal
import Surreal.Foundations.OmnificSupportBounds

/-!
# Uniform algebra denominators and complete integral closure

The actual surreal clauses of `osq:nm:thm:onedenominator` and
`osq:nm:thm:complete`. A single positive monomial clears the algebra
generated by a lower-universe-small set into the purely infinite ideal.
Every surreal is therefore almost integral over the actual omnific ring.
The reciprocal obstruction `osq:nm:lem:reciprocal` separates this complete
closure from the ordinary integral closure.
-/

universe u
namespace Surreal.Foundations.SignSequence
noncomputable section

/-- One monomial absorbs the entire algebra generated by a small set into the infinite ideal. -/
theorem omnific_adjoin_monomial_clearing (s : Set SignSequence.{u}) [Small.{u} s] :
    ∃ h : SignSequence.{u}, 0 < h ∧ ∀ x ∈ Algebra.adjoin OmnificInteger s,
      ∃ z ∈ omnificPurelyInfiniteIdeal, omnificToSurreal z = omegaPower h * x := by
  obtain ⟨h, hh, hs⟩ := omnific_monomial_clearing
    (fun x : Algebra.adjoin ℤ s => (x : SignSequence.{u}))
  refine ⟨h, hh, IdealAbsorption.adjoin omnificPurelyInfiniteIdeal s (omegaPower h) ?_⟩
  intro x hx
  exact hs ⟨x, hx⟩

/-- The absorbing monomial is a nonzero conductor element for the generated algebra. -/
theorem omnific_adjoin_conductor_nonzero (s : Set SignSequence.{u}) [Small.{u} s] :
    ∃ d : OmnificInteger.{u}, d ≠ 0 ∧ d ∈ omnificPurelyInfiniteIdeal ∧
      ∀ x ∈ Algebra.adjoin OmnificInteger s,
        ∃ z ∈ omnificPurelyInfiniteIdeal, omnificToSurreal z = omnificToSurreal d * x := by
  obtain ⟨h, hh, hs⟩ := omnific_adjoin_monomial_clearing s
  exact ⟨omnificMonomial h hh, omnificMonomial_ne_zero h hh,
    omnificMonomial_mem_purelyInfinite h hh, by simpa only [omnificToSurreal_monomial] using hs⟩

/-- Every surreal is almost integral, using one denominator for all its ordinary finite powers. -/
theorem omnific_isAlmostIntegral (x : SignSequence.{u}) : IsAlmostIntegral OmnificInteger x := by
  obtain ⟨d, hd, _, hs⟩ := omnific_adjoin_conductor_nonzero {x}
  refine ⟨d, mem_nonZeroDivisors_iff_ne_zero.mpr hd, fun n => ?_⟩
  obtain ⟨z, _, hz⟩ := hs (x ^ n)
    ((Algebra.adjoin OmnificInteger {x}).pow_mem (Algebra.subset_adjoin rfl) n)
  exact ⟨z, hz⟩

/-- The native complete integral closure of the actual omnific ring is the whole surreal field. -/
theorem omnific_completeIntegralClosure_eq_top :
    completeIntegralClosure OmnificInteger.{u} SignSequence.{u} = ⊤ := by
  apply top_unique
  intro x _
  exact omnific_isAlmostIntegral x

/-- Every intermediate ring has the same complete integral closure in the surreal field. -/
theorem omnific_intermediate_completeIntegralClosure_eq_top
    (A : Subalgebra OmnificInteger.{u} SignSequence.{u}) :
    completeIntegralClosure A SignSequence.{u} = ⊤ := by
  apply top_unique
  intro x _
  exact IdealAbsorption.almostIntegral_intermediate (omnific_isAlmostIntegral x) A

/-- Every intermediate ring has the surreal field as both fraction field and complete closure. -/
theorem omnific_intermediate_fraction_and_complete
    (A : Subalgebra OmnificInteger.{u} SignSequence.{u}) :
    IsFractionRing A SignSequence.{u} ∧ completeIntegralClosure A SignSequence.{u} = ⊤ :=
  ⟨inferInstance, omnific_intermediate_completeIntegralClosure_eq_top A⟩

/-- The inverse of a nonzero omnific nonunit is not integral over the omnific ring. -/
theorem omnific_inv_not_isIntegral (a : OmnificInteger.{u}) (ha : a ≠ 0)
    (hu : ¬ IsUnit a) : ¬ IsIntegral OmnificInteger (omnificToSurreal a)⁻¹ :=
  fun h => hu ((IntegralReciprocal.isIntegral_inv_iff a ha).mp h)

/-- One half is almost integral but not integral over the actual omnific ring. -/
theorem omnific_half_almost_not_integral :
    IsAlmostIntegral OmnificInteger.{u} (2⁻¹ : SignSequence.{u}) ∧
      ¬ IsIntegral OmnificInteger.{u} (2⁻¹ : SignSequence.{u}) := by
  refine ⟨omnific_isAlmostIntegral _, ?_⟩
  have hu : ¬ IsUnit (2 : OmnificInteger.{u}) := by
    rw [omnific_isUnit_iff]
    norm_num
  simpa only [map_ofNat] using omnific_inv_not_isIntegral 2 (by norm_num) hu

/-- Ordinary integral closure is strictly smaller than complete integral closure. -/
theorem omnific_integralClosure_lt_completeIntegralClosure :
    integralClosure OmnificInteger.{u} SignSequence.{u} <
      completeIntegralClosure OmnificInteger.{u} SignSequence.{u} := by
  refine lt_of_le_of_ne integralClosure_le_completeIntegralClosure ?_
  intro he
  apply omnific_half_almost_not_integral.2
  change (2⁻¹ : SignSequence.{u}) ∈ integralClosure OmnificInteger.{u} SignSequence.{u}
  rw [he]
  exact omnific_half_almost_not_integral.1

end
end Surreal.Foundations.SignSequence
