import Surreal.Algebra.IdealCongruenceTopology
import Surreal.Foundations.OmnificPadicCompletion
import Mathlib.Topology.Algebra.Nonarchimedean.AdicTopology

/-!
# The non-Hausdorff congruence topologies on the actual omnific ring

The topology assertions following `odg:eq:profinite`. We construct the
ordinary congruence topology with neighborhoods `n Oz`, and use Mathlib's
ideal-adic topology for each ordinary prime. In either topology the closure
of zero is exactly the purely infinite ideal; indistinguishable elements
have exactly the same ordinary integer constant term.

The topologies are explicit parameters, so neither replaces the inherited
order topology of the actual omnific ring.
-/

universe u
namespace Surreal.Foundations.SignSequence

open Topology

noncomputable section

/-- The ordinary congruence ideal for a positive modulus. -/
def omnificCongruenceIdeal (n : {n : ℕ // 0 < n}) : Ideal OmnificInteger.{u} :=
  Ideal.span {omnificIntCast (n.val : ℤ)}

/-- Products of positive moduli refine both congruence ideals. -/
theorem omnificCongruenceIdeal_directed (m n : {n : ℕ // 0 < n}) :
    ∃ k, omnificCongruenceIdeal.{u} k ≤ omnificCongruenceIdeal m ⊓ omnificCongruenceIdeal n := by
  refine ⟨⟨m.val * n.val, Nat.mul_pos m.property n.property⟩, ?_⟩
  apply le_inf
  · rw [omnificCongruenceIdeal, omnificCongruenceIdeal,
      Ideal.span_singleton_le_span_singleton, Nat.cast_mul, map_mul]
    exact dvd_mul_right _ _
  · rw [omnificCongruenceIdeal, omnificCongruenceIdeal,
      Ideal.span_singleton_le_span_singleton, Nat.cast_mul, map_mul]
    exact dvd_mul_left _ _

/-- The topology generated by ordinary positive-modulus congruences. -/
@[implicit_reducible] def omnificCongruenceTopology : TopologicalSpace OmnificInteger.{u} :=
  IdealCongruenceTopology.topology omnificCongruenceIdeal omnificCongruenceIdeal_directed

/-- The ordinary congruence topology makes the actual omnific ring a topological ring. -/
theorem omnificCongruenceTopology_isTopologicalRing :
    @IsTopologicalRing OmnificInteger.{u} omnificCongruenceTopology _ :=
  IdealCongruenceTopology.isTopologicalRing _ _

/-- Ordinary congruence classes are exactly a neighborhood basis at any omnific integer. -/
theorem omnificCongruenceTopology_hasBasis (x : OmnificInteger.{u}) :
    (@nhds OmnificInteger omnificCongruenceTopology x).HasBasis
      (fun _ : {n : ℕ // 0 < n} => True)
      (fun n => {y | omnificIntCast (n.val : ℤ) ∣ y - x}) := by
  simpa only [omnificCongruenceIdeal, Ideal.mem_span_singleton] using
    IdealCongruenceTopology.hasBasis_nhds omnificCongruenceIdeal omnificCongruenceIdeal_directed x

/-- The closure of zero in the ordinary congruence topology is the purely infinite ideal. -/
theorem omnificCongruenceTopology_closure_zero :
    @closure OmnificInteger.{u} omnificCongruenceTopology {0} =
      (omnificPurelyInfiniteIdeal : Set OmnificInteger) := by
  rw [IdealCongruenceTopology.closure_zero]
  exact congrArg (fun I : Ideal OmnificInteger => (I : Set OmnificInteger))
    iInf_omnific_int_multiples

/-- Ordinary congruences distinguish exactly the integer constant terms. -/
theorem omnificCongruenceTopology_inseparable_iff (x y : OmnificInteger.{u}) :
    @Inseparable OmnificInteger omnificCongruenceTopology x y ↔
      omnificConstantCoeff x = omnificConstantCoeff y := by
  rw [IdealCongruenceTopology.inseparable_iff]
  change x - y ∈ (⨅ n : {n : ℕ // 0 < n}, Ideal.span {omnificIntCast (n.val : ℤ)}) ↔ _
  rw [iInf_omnific_int_multiples]
  change omnificConstantCoeff (x - y) = 0 ↔ _
  rw [map_sub, _root_.sub_eq_zero]

/-- The ordinary congruence topology is not Hausdorff. -/
theorem omnificCongruenceTopology_not_t2Space :
    ¬ @T2Space OmnificInteger.{u} omnificCongruenceTopology := by
  rw [IdealCongruenceTopology.t2Space_iff]
  change (⨅ n : {n : ℕ // 0 < n}, Ideal.span {omnificIntCast (n.val : ℤ)}) ≠ ⊥
  rw [iInf_omnific_int_multiples]
  exact omnificPurelyInfiniteIdeal_ne_bot

/-- The prime-power ideal intersection, including the zeroth power, is the infinite ideal. -/
theorem iInf_omnificPadicIdeal_pow (p : ℕ) [Fact p.Prime] :
    (⨅ k : ℕ, (omnificPadicIdeal.{u} p) ^ k) = omnificPurelyInfiniteIdeal := by
  ext x
  simp only [Ideal.mem_iInf, omnificPadicIdeal, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  rw [← omnific_dvd_all_prime_powers_iff p x]
  constructor
  · exact fun h k _ => h k
  · intro h k
    cases k with
    | zero => simp
    | succ k => exact h (k + 1) (Nat.succ_pos k)

/-- The ordinary p-adic topology is Mathlib's topology of the principal ideal `(p)`. -/
@[implicit_reducible] def omnificPadicTopology (p : ℕ) : TopologicalSpace OmnificInteger.{u} :=
  (omnificPadicIdeal p).adicTopology

/-- The ordinary p-adic topology is compatible with the actual ring operations. -/
theorem omnificPadicTopology_isTopologicalRing (p : ℕ) :
    @IsTopologicalRing OmnificInteger.{u} (omnificPadicTopology p) _ :=
  (omnificPadicIdeal p).ringFilterBasis.isTopologicalRing

/-- Prime-power ideals form the neighborhood basis at zero. -/
theorem omnificPadicTopology_hasBasis_zero (p : ℕ) :
    (@nhds OmnificInteger.{u} (omnificPadicTopology p) 0).HasBasis
      (fun _ : ℕ => True) (fun k => (((omnificPadicIdeal p) ^ k : Ideal OmnificInteger) :
        Set OmnificInteger)) :=
  (omnificPadicIdeal p).hasBasis_nhds_zero_adic

/-- The p-adic closure of zero is exactly the purely infinite ideal. -/
theorem omnificPadicTopology_closure_zero (p : ℕ) [Fact p.Prime] :
    @closure OmnificInteger.{u} (omnificPadicTopology p) {0} =
      (omnificPurelyInfiniteIdeal : Set OmnificInteger) := by
  letI := omnificPadicTopology p
  letI := omnificPadicTopology_isTopologicalRing p
  rw [IdealCongruenceTopology.closure_zero_of_hasBasis (fun k => (omnificPadicIdeal p) ^ k)
    (omnificPadicTopology_hasBasis_zero p), iInf_omnificPadicIdeal_pow]

/-- A single ordinary prime detects exactly the same indistinguishability relation. -/
theorem omnificPadicTopology_inseparable_iff (p : ℕ) [Fact p.Prime]
    (x y : OmnificInteger.{u}) :
    @Inseparable OmnificInteger (omnificPadicTopology p) x y ↔
      omnificConstantCoeff x = omnificConstantCoeff y := by
  letI := omnificPadicTopology p
  letI := omnificPadicTopology_isTopologicalRing p
  rw [addGroup_inseparable_iff]
  change x - y ∈ closure ({0} : Set OmnificInteger) ↔ _
  rw [omnificPadicTopology_closure_zero]
  change omnificConstantCoeff (x - y) = 0 ↔ _
  rw [map_sub, _root_.sub_eq_zero]

/-- For each ordinary prime the actual omnific p-adic topology is not Hausdorff. -/
theorem omnificPadicTopology_not_t2Space (p : ℕ) [Fact p.Prime] :
    ¬ @T2Space OmnificInteger.{u} (omnificPadicTopology p) := by
  letI := omnificPadicTopology p
  letI := omnificPadicTopology_isTopologicalRing p
  rw [IsTopologicalAddGroup.t2Space_iff_zero_closed, ← closure_eq_iff_isClosed,
    omnificPadicTopology_closure_zero]
  intro h
  exact omnificPurelyInfiniteIdeal_ne_bot (SetLike.coe_injective h)

section CongruenceSeparation

local instance : TopologicalSpace OmnificInteger.{u} := omnificCongruenceTopology
local instance : IsTopologicalRing OmnificInteger.{u} := omnificCongruenceTopology_isTopologicalRing

/-- The ordinary congruence topology's separation quotient is the ordinary integer ring. -/
def omnificCongruenceSeparationEquiv : SeparationQuotient OmnificInteger.{u} ≃+* ℤ :=
  (IdealCongruenceTopology.separationQuotientEquiv omnificPurelyInfiniteIdeal
    omnificCongruenceTopology_closure_zero).trans omnificQuotientEquiv

/-- The map to the ordinary congruence separation quotient extracts the integer constant. -/
@[simp] theorem omnificCongruenceSeparationEquiv_mk (x : OmnificInteger.{u}) :
    omnificCongruenceSeparationEquiv (SeparationQuotient.mk x) = omnificConstantCoeff x := by
  simp only [omnificCongruenceSeparationEquiv, RingEquiv.trans_apply,
    IdealCongruenceTopology.separationQuotientEquiv_mk, omnificQuotientEquiv]
  exact RingHom.quotientKerEquivOfSurjective_apply_mk omnificConstantCoeff_surjective x

end CongruenceSeparation

/-- The p-adic topology's separation quotient is the ordinary integer ring. -/
def omnificPadicSeparationEquiv (p : ℕ) [Fact p.Prime] :
    letI := omnificPadicTopology.{u} p
    letI := omnificPadicTopology_isTopologicalRing.{u} p
    SeparationQuotient OmnificInteger.{u} ≃+* ℤ := by
  letI := omnificPadicTopology.{u} p
  letI := omnificPadicTopology_isTopologicalRing.{u} p
  exact (IdealCongruenceTopology.separationQuotientEquiv omnificPurelyInfiniteIdeal
    (omnificPadicTopology_closure_zero p)).trans omnificQuotientEquiv

/-- The p-adic separation quotient also has the integer constant as its canonical map. -/
@[simp] theorem omnificPadicSeparationEquiv_mk (p : ℕ) [Fact p.Prime] (x : OmnificInteger.{u}) :
    letI := omnificPadicTopology.{u} p
    letI := omnificPadicTopology_isTopologicalRing.{u} p
    omnificPadicSeparationEquiv p (SeparationQuotient.mk x) = omnificConstantCoeff x := by
  letI := omnificPadicTopology.{u} p
  letI := omnificPadicTopology_isTopologicalRing.{u} p
  simp only [omnificPadicSeparationEquiv, RingEquiv.trans_apply,
    IdealCongruenceTopology.separationQuotientEquiv_mk, omnificQuotientEquiv]
  exact RingHom.quotientKerEquivOfSurjective_apply_mk omnificConstantCoeff_surjective x


end
end Surreal.Foundations.SignSequence
