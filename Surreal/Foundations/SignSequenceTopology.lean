import Surreal.Foundations.SignSequenceCutOperation
import Mathlib.Logic.Small.Set
import Mathlib.Topology.DiscreteSubset
import Mathlib.Topology.Order.DenselyOrdered

/-!
# Small subsets in the order topology of sign sequences

This proves the order-topology specialization of the first two clauses of
`found:thm:discrete`: lower-universe-small subsets are closed and discrete,
and a convergent function with a small index type is eventually equal to
its limit. Small cut filling supplies an interval which avoids the small
set except possibly at its centre. The whole carrier has no isolated
points and does not have the discrete topology.

The topology here is Mathlib's native order topology on the actual sign
carrier. No identification with a field-valued ball topology, surcomplex
topology, or Cauchy structure is asserted.
-/

universe u v

namespace Surreal.Foundations.SignSequence

noncomputable section

open Set Filter Topology

/-- The native topology generated by numerical order intervals. -/
instance signSequenceTopologicalSpace : TopologicalSpace SignSequence.{u} :=
  Preorder.topology SignSequence.{u}

instance signSequenceOrderTopology : OrderTopology SignSequence.{u} := ⟨rfl⟩

instance signSequenceNontrivial : Nontrivial SignSequence.{u} := by
  obtain ⟨x, hx⟩ := exists_gt (0 : SignSequence.{u})
  exact nontrivial_of_lt _ _ hx

/-- A small set can be avoided near any point, except for that point itself.
The two endpoints are obtained by filling small separated cuts. -/
theorem exists_Ioo_inter_subset_singleton (s : Set SignSequence.{u}) [Small.{u} s]
    (p : SignSequence.{u}) :
    ∃ a b, p ∈ Ioo a b ∧ Ioo a b ∩ s ⊆ {p} := by
  letI : Small.{u} (s ∩ Iio p : Set SignSequence.{u}) := small_subset inter_subset_left
  letI : Small.{u} (s ∩ Ioi p : Set SignSequence.{u}) := small_subset inter_subset_left
  obtain ⟨a, ha, hap⟩ := exists_separator_of_small_sets (s ∩ Iio p) {p}
    (by intro x hx y hy; simpa only [mem_Iio, mem_singleton_iff.mp hy] using hx.2)
  obtain ⟨b, hpb, hb⟩ := exists_separator_of_small_sets {p} (s ∩ Ioi p)
    (by intro x hx y hy; simpa only [mem_Ioi, mem_singleton_iff.mp hx] using hy.2)
  refine ⟨a, b, ⟨hap p (mem_singleton p), hpb p (mem_singleton p)⟩, ?_⟩
  rintro x ⟨hax, hxs⟩
  apply mem_singleton_iff.mpr
  rcases lt_trichotomy x p with hxp | hxp | hpx
  · exact False.elim ((ha x ⟨hxs, hxp⟩).not_gt hax.1)
  · exact hxp
  · exact False.elim ((hb x ⟨hxs, hpx⟩).not_gt hax.2)

/-- Every lower-universe-small subset is closed in the full order topology. -/
theorem isClosed_of_small (s : Set SignSequence.{u}) [Small.{u} s] : IsClosed s := by
  apply isOpen_compl_iff.mp
  apply isOpen_iff_mem_nhds.mpr
  intro p hp
  obtain ⟨a, b, hpab, havoid⟩ := exists_Ioo_inter_subset_singleton s p
  apply mem_of_superset (Ioo_mem_nhds hpab.1 hpab.2)
  intro x hx hxs
  have hxp : x = p := mem_singleton_iff.mp (havoid ⟨hx, hxs⟩)
  exact hp (hxp ▸ hxs)

/-- Each point of a small subset is isolated in the induced topology. -/
theorem isDiscrete_of_small (s : Set SignSequence.{u}) [Small.{u} s] : IsDiscrete s := by
  apply isDiscrete_iff_forall_mem_exists_isOpen.mpr
  intro p hp
  obtain ⟨a, b, hpab, havoid⟩ := exists_Ioo_inter_subset_singleton s p
  refine ⟨Ioo a b, isOpen_Ioo, Subset.antisymm havoid ?_⟩
  intro x hx
  simpa only [mem_singleton_iff.mp hx] using (show p ∈ Ioo a b ∩ s from ⟨hpab, hp⟩)

/-- The induced topology on a small subtype is the discrete topology. -/
theorem discreteTopology_of_small (s : Set SignSequence.{u}) [Small.{u} s] :
    DiscreteTopology s :=
  isDiscrete_iff_discreteTopology.mp (isDiscrete_of_small s)

/-- Smallness of the range alone makes convergence equivalent to eventual
equality, along any filter, including the bottom filter. -/
theorem tendsto_nhds_iff_eventually_eq_of_small_range {I : Type v}
    (f : I → SignSequence.{u}) [Small.{u} (Set.range f)] (l : Filter I)
    (p : SignSequence.{u}) :
    Tendsto f l (𝓝 p) ↔ ∀ᶠ i in l, f i = p := by
  constructor
  · intro h
    obtain ⟨a, b, hpab, havoid⟩ := exists_Ioo_inter_subset_singleton (Set.range f) p
    exact (h.eventually (Ioo_mem_nhds hpab.1 hpab.2)).mono
      (fun i hi => mem_singleton_iff.mp (havoid ⟨hi, mem_range_self i⟩))
  · exact tendsto_nhds_of_eventually_eq

/-- In particular, a net with a lower-universe-small index type converges
exactly when it is eventually equal to the proposed limit. -/
theorem tendsto_nhds_iff_eventually_eq {I : Type v} [Small.{u} I]
    (f : I → SignSequence.{u}) (l : Filter I) (p : SignSequence.{u}) :
    Tendsto f l (𝓝 p) ↔ ∀ᶠ i in l, f i = p :=
  tendsto_nhds_iff_eventually_eq_of_small_range f l p

/-- Dense numerical order ensures that no point of the whole carrier is
isolated, despite the discreteness of all lower-universe-small subsets. -/
theorem punctured_nhds_neBot (p : SignSequence.{u}) : NeBot (𝓝[≠] p) := by
  infer_instance

/-- No singleton is open in the full order topology. -/
theorem singleton_not_isOpen (p : SignSequence.{u}) : ¬ IsOpen ({p} : Set SignSequence.{u}) :=
  not_isOpen_singleton p

/-- Small-subset discreteness cannot be extended to the whole carrier. -/
theorem not_discreteTopology : ¬ DiscreteTopology SignSequence.{u} := by
  intro h
  exact singleton_not_isOpen 0 ((discreteTopology_iff_isOpen_singleton.mp h) 0)

end

end Surreal.Foundations.SignSequence
