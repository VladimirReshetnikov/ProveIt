import Mathlib.ModelTheory.Algebra.Ring.Basic
import Mathlib.ModelTheory.Semantics

/-!
# Positive existential formulas preserved by homomorphisms

The logical clause of `odg:thm:transfer`. We use Mathlib's native terms,
bounded formulas, and realization. The predicate below identifies the
fragment generated by equality, truth, falsehood, finite conjunction and
disjunction, and existential quantification; no separate syntax or
semantics is introduced.
-/

namespace Surreal

open FirstOrder FirstOrder.Language

variable {L : Language} {α : Type*}

/-- The equality-based positive existential fragment of native first-order formulas. -/
inductive IsPositiveExistential : ∀ {n}, L.BoundedFormula α n → Prop
  | equal {n} (t s : L.Term (α ⊕ Fin n)) : IsPositiveExistential (.equal t s)
  | bot {n} : IsPositiveExistential (⊥ : L.BoundedFormula α n)
  | top {n} : IsPositiveExistential (⊤ : L.BoundedFormula α n)
  | inf {n} {φ ψ : L.BoundedFormula α n} :
      IsPositiveExistential φ → IsPositiveExistential ψ → IsPositiveExistential (φ ⊓ ψ)
  | sup {n} {φ ψ : L.BoundedFormula α n} :
      IsPositiveExistential φ → IsPositiveExistential ψ → IsPositiveExistential (φ ⊔ ψ)
  | ex {n} {φ : L.BoundedFormula α (n + 1)} :
      IsPositiveExistential φ → IsPositiveExistential φ.ex

/-- Homomorphisms preserve positive existential formulas, carrying witnesses to their images. -/
theorem IsPositiveExistential.realize_hom {M N : Type*} [L.Structure M] [L.Structure N]
    {n : ℕ} {φ : L.BoundedFormula α n} (hφ : IsPositiveExistential φ)
    (f : L.Hom M N) {v : α → M} {xs : Fin n → M} :
    φ.Realize v xs → φ.Realize (f ∘ v) (f ∘ xs) := by
  induction hφ with
  | equal t s =>
    simp only [BoundedFormula.Realize, ← Sum.comp_elim, HomClass.realize_term]
    exact congrArg f
  | bot => simp
  | top => simp
  | inf _ _ ihφ ihψ =>
    simp only [BoundedFormula.realize_inf]
    exact fun h => ⟨ihφ h.1, ihψ h.2⟩
  | sup _ _ ihφ ihψ =>
    simp only [BoundedFormula.realize_sup]
    exact Or.imp ihφ ihψ
  | ex _ ih =>
    simp only [BoundedFormula.realize_ex]
    rintro ⟨a, ha⟩
    refine ⟨f a, ?_⟩
    rw [← Fin.comp_snoc]
    exact ih ha

/-- Positive existential truth at parameters from a retract is unchanged by its inclusion. -/
theorem IsPositiveExistential.realize_retraction {M N : Type*}
    [L.Structure M] [L.Structure N] {n : ℕ} {φ : L.BoundedFormula α n}
    (hφ : IsPositiveExistential φ) (i : L.Hom M N) (f : L.Hom N M)
    (hi : Function.LeftInverse f i) (v : α → M) (xs : Fin n → M) :
    φ.Realize (i ∘ v) (i ∘ xs) ↔ φ.Realize v xs := by
  constructor
  · intro h
    have hv : f ∘ (i ∘ v) = v := funext fun a => hi (v a)
    have hx : f ∘ (i ∘ xs) = xs := funext fun a => hi (xs a)
    simpa only [hv, hx] using hφ.realize_hom f h
  · exact hφ.realize_hom i

/-- A ring homomorphism is a homomorphism of Mathlib's first-order ring structures. -/
def ringLanguageHom {R S : Type*} [Ring R] [Ring S]
    [FirstOrder.Ring.CompatibleRing R] [FirstOrder.Ring.CompatibleRing S]
    (f : R →+* S) : Language.ring.Hom R S where
  toFun := f
  map_fun' := by intro n g; cases g <;> simp
  map_rel' := by intro n g; cases g

end Surreal
