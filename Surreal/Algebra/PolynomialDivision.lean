import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.Algebra.Polynomial.Splits
import Mathlib.FieldTheory.Perfect

/-!
# Division, greatest common divisors, and squarefreeness

This file formalizes the Euclidean division, monic greatest common divisor,
Bézout identity, principal ideal, squarefree criterion, and grouped gcd
factorization clauses of
`polynomial:thm:fta` in `docs/surcomplex/polynomial-algebra/article.tex`.

The first four clauses hold over every field. The squarefree criterion holds
over every perfect field, in particular every field of characteristic zero.
The grouped gcd factorization uses characteristic zero and an explicit
splitting hypothesis, supplied by algebraic closedness in the manuscript.
The polynomial and ideal structures are Mathlib's existing structures. The
greatest common divisor is Mathlib's normalized `gcd`, so its nonzero values
are monic; the unnormalized Euclidean algorithm is not used as the final gcd.
These are finite algebraic results, independent of the pending construction
of a surreal field or an algebraically closed Hahn workspace.
-/

namespace Surreal
namespace FinitePolynomial

open Polynomial

variable {K : Type*} [Field K]

noncomputable section

local instance polynomialDivisionDecidableEq : DecidableEq K := Classical.decEq K

/-- The quotient and remainder in `polynomial:thm:fta` agree with Mathlib's
division operations whenever their defining equation and degree bound hold. -/
theorem div_mod_unique (A B Q R : K[X]) (hB : B ≠ 0)
    (h : A = B * Q + R) (hR : R.degree < B.degree) :
    A / B = Q ∧ A % B = R := by
  have hr : A % B = R := by
    rw [h, Polynomial.add_mod, EuclideanDomain.mod_eq_zero.mpr (dvd_mul_right B Q),
      zero_add, (Polynomial.mod_eq_self_iff hB).mpr hR]
  refine ⟨?_, hr⟩
  have heq := EuclideanDomain.div_add_mod A B
  rw [hr] at heq
  exact mul_left_cancel₀ hB (add_right_cancel (heq.trans h))

/-- Existence and simultaneous uniqueness of the quotient and remainder,
the division clause of `polynomial:thm:fta`. Polynomial degree uses `⊥` for
the zero polynomial, so zero remainders are included without an exception. -/
theorem exists_unique_division (A B : K[X]) (hB : B ≠ 0) :
    ∃! qr : K[X] × K[X], A = B * qr.1 + qr.2 ∧ qr.2.degree < B.degree := by
  refine ⟨(A / B, A % B), ⟨(EuclideanDomain.div_add_mod A B).symm,
    Polynomial.degree_mod_lt A hB⟩, ?_⟩
  rintro ⟨Q, R⟩ ⟨h, hR⟩
  obtain ⟨hQ, hR⟩ := div_mod_unique A B Q R hB h hR
  exact Prod.ext hQ.symm hR.symm

/-- The normalized gcd of a pair not identically zero is monic, as required
by `polynomial:thm:fta`. -/
theorem gcd_monic (A B : K[X]) (h : A ≠ 0 ∨ B ≠ 0) :
    (gcd A B).Monic := by
  classical
  have hD : gcd A B ≠ 0 := h.elim gcd_ne_zero_of_left gcd_ne_zero_of_right
  simpa only [normalize_gcd] using Polynomial.monic_normalize hD

/-- Bézout coefficients for the monic gcd in `polynomial:thm:fta`. -/
theorem gcd_bezout (A B : K[X]) :
    ∃ U V : K[X], gcd A B = U * A + V * B := by
  obtain ⟨U, V, h⟩ := exists_gcd_eq_mul_add_mul A B
  exact ⟨U, V, by simpa only [mul_comm] using h⟩

/-- The monic gcd, its universal divisibility property, and its Bézout
certificate together give the full gcd clause of `polynomial:thm:fta`. -/
theorem exists_monic_gcd (A B : K[X]) (h : A ≠ 0 ∨ B ≠ 0) :
    ∃ D U V : K[X], D.Monic ∧ D ∣ A ∧ D ∣ B ∧
      (∀ E : K[X], E ∣ A → E ∣ B → E ∣ D) ∧ D = U * A + V * B := by
  obtain ⟨U, V, hbezout⟩ := gcd_bezout A B
  exact ⟨gcd A B, U, V, gcd_monic A B h, gcd_dvd_left A B,
    gcd_dvd_right A B, fun _ hA hB => dvd_gcd hA hB, hbezout⟩

/-- Every polynomial ideal over a field is generated by one polynomial,
the principal ideal clause of `polynomial:thm:fta`. -/
theorem ideal_principal (I : Ideal K[X]) :
    ∃ P : K[X], I = Ideal.span ({P} : Set K[X]) := by
  exact ⟨Submodule.IsPrincipal.generator I, (Ideal.span_singleton_generator I).symm⟩

/-- The normalized gcd generates the ideal of the pair; this records the
compatibility of the Bézout and principal ideal clauses of
`polynomial:thm:fta`. -/
theorem ideal_pair_eq_span_gcd (A B : K[X]) :
    Ideal.span ({A, B} : Set K[X]) = Ideal.span ({gcd A B} : Set K[X]) :=
  (span_gcd A B).symm

/-- The squarefree criterion of `polynomial:thm:fta`. Perfectness suffices;
characteristic zero in the manuscript supplies this hypothesis. -/
theorem squarefree_iff_gcd_derivative_eq_one [PerfectField K] (P : K[X]) :
    Squarefree P ↔ gcd P P.derivative = 1 := by
  rw [← PerfectField.separable_iff_squarefree, Polynomial.separable_def,
    ← gcd_isUnit_iff, ← normalize_eq_one, normalize_gcd]

/-- Root multiplicity in the gcd is the smaller of the two multiplicities.
This is the finite divisibility lemma used for the gcd factorization in
`polynomial:eq:logderivative`. -/
theorem gcd_rootMultiplicity (A B : K[X]) (hA : A ≠ 0) (hB : B ≠ 0) (a : K) :
    (gcd A B).rootMultiplicity a = min (A.rootMultiplicity a) (B.rootMultiplicity a) := by
  apply le_antisymm
  · exact le_min
      (rootMultiplicity_le_rootMultiplicity_of_dvd hA (gcd_dvd_left A B) a)
      (rootMultiplicity_le_rootMultiplicity_of_dvd hB (gcd_dvd_right A B) a)
  · apply (le_rootMultiplicity_iff (gcd_ne_zero_of_left hA)).mpr
    exact dvd_gcd
      ((le_rootMultiplicity_iff hA).mp (min_le_left _ _))
      ((le_rootMultiplicity_iff hB).mp (min_le_right _ _))

/-- Each root loses exactly one copy in the gcd with the derivative, the
multiplicity assertion behind `polynomial:eq:logderivative`. A nonroot has
zero multiplicity on both sides. -/
theorem gcd_derivative_rootMultiplicity [CharZero K] (P : K[X]) (hP : P ≠ 0) (a : K) :
    (gcd P P.derivative).rootMultiplicity a = P.rootMultiplicity a - 1 := by
  by_cases hd : P.derivative = 0
  · have hm : P.rootMultiplicity a = 0 := by
      rw [Polynomial.eq_C_of_derivative_eq_zero hd, rootMultiplicity_C]
    apply le_antisymm
    · simpa only [hm, Nat.zero_sub] using
        (rootMultiplicity_le_rootMultiplicity_of_dvd hP (gcd_dvd_left P P.derivative) a)
    · simp only [hm, Nat.zero_sub, Nat.zero_le]
  · rw [gcd_rootMultiplicity P P.derivative hP hd a]
    by_cases hr : P.IsRoot a
    · rw [Polynomial.derivative_rootMultiplicity_of_root hr]
      exact min_eq_right (Nat.sub_le _ _)
    · rw [rootMultiplicity_eq_zero hr]
      simp

/-- The exact grouped product for the gcd in `polynomial:eq:logderivative`.
It holds for every nonzero split polynomial in characteristic zero because
Mathlib's gcd is normalized to be monic, whether or not `P` itself is monic.
The finite set indexes distinct roots and the exponents are multiplicities
minus one. -/
theorem gcd_derivative_eq_prod [CharZero K] (P : K[X]) (hP : P ≠ 0) (hs : P.Splits) :
    gcd P P.derivative =
      ∏ a ∈ P.roots.toFinset, (X - C a) ^ (P.rootMultiplicity a - 1) := by
  have hd : gcd P P.derivative ∣ P := gcd_dvd_left P P.derivative
  have hsub : (gcd P P.derivative).roots.toFinset ⊆ P.roots.toFinset := by
    intro a ha
    exact Multiset.mem_toFinset.mpr
      ((Multiset.subset_of_le (Polynomial.roots.le_of_dvd hP hd))
        (Multiset.mem_toFinset.mp ha))
  calc
    gcd P P.derivative = ((gcd P P.derivative).roots.map (X - C ·)).prod :=
      (hs.of_dvd hP hd).eq_prod_roots_of_monic (gcd_monic P P.derivative (Or.inl hP))
    _ = ∏ a ∈ (gcd P P.derivative).roots.toFinset,
        (X - C a) ^ (gcd P P.derivative).roots.count a :=
      Finset.prod_multiset_map_count _ _
    _ = ∏ a ∈ P.roots.toFinset, (X - C a) ^ (gcd P P.derivative).roots.count a := by
      apply Finset.prod_subset hsub
      intro a _ ha
      rw [Multiset.count_eq_zero.mpr (by simpa only [Multiset.mem_toFinset] using ha), pow_zero]
    _ = ∏ a ∈ P.roots.toFinset, (X - C a) ^ (P.rootMultiplicity a - 1) := by
      apply Finset.prod_congr rfl
      intro a _
      rw [Polynomial.count_roots, gcd_derivative_rootMultiplicity P hP a]

end

end FinitePolynomial
end Surreal
