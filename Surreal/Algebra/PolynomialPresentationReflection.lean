import Surreal.Algebra.QuotientReflection
import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# Polynomial presentations preserve coefficient reflection

Generic algebra for `osq:thm:presentations`. A split coefficient map with
universal target factorization gives the same correspondence for arbitrary
multivariate polynomial quotients. Targets may be noncommutative; only
the smallness conclusion needs small coefficients and a small variable type.
-/

universe u v w t z
namespace Surreal.PolynomialPresentationReflection
noncomputable section
variable {A : Type v} {D : Type w} [CommRing A] [CommRing D]
  (r : A →+* D) (s : D →+* A) (hs : ∀ d, r (s d) = d) (σ : Type t)

include hs in
/-- A split coefficient map remains split on finite polynomials in arbitrary variables. -/
theorem map_retraction (p : MvPolynomial σ D) : MvPolynomial.map r (MvPolynomial.map s p) = p := by
  have he : (MvPolynomial.map r).comp (MvPolynomial.map s) = RingHom.id (MvPolynomial σ D) := by
    apply MvPolynomial.ringHom_ext
    · intro d
      simp only [RingHom.comp_apply, MvPolynomial.map_C, hs, RingHom.id_apply]
    · intro i
      simp only [RingHom.comp_apply, MvPolynomial.map_X, RingHom.id_apply]
  exact RingHom.congr_fun he p

include hs in
/-- Coefficient-wise reflection is onto before imposing relations. -/
theorem map_surjective : Function.Surjective (MvPolynomial.map (σ := σ) r) :=
  MvPolynomial.map_surjective r (fun d => ⟨s d, hs d⟩)

variable {S : Type z} [Ring S]
  (hfactor : ∀ (φ : A →+* S) (a : A), φ a = φ (s (r a)))

include hfactor in
/-- A map that forgets the coefficient kernel also forgets it in every polynomial. -/
theorem polynomial_factorization (φ : MvPolynomial σ A →+* S) (p : MvPolynomial σ A) :
    φ p = φ (MvPolynomial.map s (MvPolynomial.map r p)) := by
  have he : φ = φ.comp ((MvPolynomial.map s).comp (MvPolynomial.map r)) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simpa only [RingHom.comp_apply, MvPolynomial.map_C] using hfactor (φ.comp MvPolynomial.C) a
    · intro i
      simp only [RingHom.comp_apply, MvPolynomial.map_X]
  exact RingHom.congr_fun he p

/-- Imposing arbitrary polynomial relations preserves the target-map correspondence. -/
def homEquiv (I : Ideal (MvPolynomial σ A)) :
    ((MvPolynomial σ A ⧸ I) →+* S) ≃
      ((MvPolynomial σ D ⧸ I.map (MvPolynomial.map r)) →+* S) :=
  QuotientReflection.homEquiv (MvPolynomial.map r) (MvPolynomial.map s)
    (map_retraction r s hs σ) (polynomial_factorization r s σ hfactor) I

/-- The canonical presentation reflection is the quotient of coefficient-wise reflection. -/
def reflection (I : Ideal (MvPolynomial σ A)) :
    (MvPolynomial σ A ⧸ I) →+* MvPolynomial σ D ⧸ I.map (MvPolynomial.map r) :=
  QuotientReflection.reflection (MvPolynomial.map r) I

/-- Reflection sends the class of a polynomial to the class of its coefficient-wise image. -/
@[simp] theorem reflection_mk (I : Ideal (MvPolynomial σ A)) (p : MvPolynomial σ A) :
    reflection r σ I (Ideal.Quotient.mk I p) =
      Ideal.Quotient.mk (I.map (MvPolynomial.map r)) (MvPolynomial.map r p) := rfl

include hs in
/-- The canonical presentation reflection is surjective. -/
theorem reflection_surjective (I : Ideal (MvPolynomial σ A)) :
    Function.Surjective (reflection r σ I) :=
  QuotientReflection.reflection_surjective _ (map_surjective r s hs σ) I

/-- The inverse Hom correspondence is literal precomposition with presentation reflection. -/
theorem homEquiv_symm_apply (I : Ideal (MvPolynomial σ A))
    (ψ : (MvPolynomial σ D ⧸ I.map (MvPolynomial.map r)) →+* S) :
    (homEquiv r s hs σ hfactor I).symm ψ = ψ.comp (reflection r σ I) := rfl

/-- The reflected ideal of a family of relations is generated by their reflected polynomials. -/
theorem map_span_range {E : Type*} (f : E → MvPolynomial σ A) :
    (Ideal.span (Set.range f)).map (MvPolynomial.map r) =
      Ideal.span (Set.range (fun j => MvPolynomial.map r (f j))) := by
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

/-- Small coefficients and variables make the entire reflected presentation small. -/
theorem small_reflected_quotient [Small.{u} D] [Small.{u} σ] (I : Ideal (MvPolynomial σ A)) :
    Small.{u} (MvPolynomial σ D ⧸ I.map (MvPolynomial.map r)) :=
  small_of_surjective (Ideal.Quotient.mk_surjective)

end
end Surreal.PolynomialPresentationReflection
