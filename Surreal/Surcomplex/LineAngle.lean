import Surreal.Surcomplex.AngleGroup
import Surreal.Surcomplex.DirectionNormalization
import Surreal.Surcomplex.FiniteTrigonometryIdentities

/-!
# Directed angles modulo an ordinary half turn

The directed-angle clause of `trigonometry:prop:inscribed` takes its values in finite actual
surreal angles modulo ordinary integer multiples of `pi`. Squaring the phase identifies this
quotient with the actual unit circle. Halving induces an equivalence from the full-turn angle
quotient to this half-turn quotient; it does not require choosing representatives.
-/

universe u

namespace Surreal.Surcomplex

open Foundations

noncomputable section

/-- The phase of twice a finite angle, expressed as a homomorphism. -/
def linePhaseHom : Multiplicative SignSequence.FiniteElement.{u} →* UnitCircle.{u} where
  toFun θ := finitePhaseHom θ ^ 2
  map_one' := by rw [map_one, one_pow]
  map_mul' θ φ := by rw [map_mul, mul_pow]

/-- Squaring the phase is the phase of the doubled actual angle. -/
theorem linePhaseHom_apply (θ : Multiplicative SignSequence.FiniteElement.{u}) :
    linePhaseHom θ = finitePhaseHom (Multiplicative.ofAdd (θ.toAdd + θ.toAdd)) := by
  change finitePhaseHom θ ^ 2 = _
  rw [pow_two, ← map_mul]
  rfl

/-- Doubling finite actual angles still reaches every unit direction. -/
theorem linePhaseHom_surjective : Function.Surjective linePhaseHom.{u} := by
  intro z
  obtain ⟨θ, hθ⟩ := finitePhaseHom_surjective z
  refine ⟨Multiplicative.ofAdd (finiteHalf θ.toAdd), ?_⟩
  rw [linePhaseHom_apply]
  change finitePhaseHom
    (Multiplicative.ofAdd (finiteHalf θ.toAdd + finiteHalf θ.toAdd)) = z
  rw [finiteHalf_add_finiteHalf]
  exact hθ

/-- The subgroup of ordinary half-turn periods. -/
def lineAnglePeriods : Subgroup (Multiplicative SignSequence.FiniteElement.{u}) :=
  linePhaseHom.ker

/-- The kernel contains precisely ordinary integer multiples of `pi`. -/
theorem mem_lineAnglePeriods_iff (θ : Multiplicative SignSequence.FiniteElement.{u}) :
    θ ∈ lineAnglePeriods ↔ ∃ n : ℤ,
      θ.toAdd.val = SignSequence.ofReal ((n : ℝ) * Real.pi) := by
  change linePhaseHom θ = 1 ↔ _
  rw [linePhaseHom_apply]
  change Multiplicative.ofAdd (θ.toAdd + θ.toAdd) ∈ finitePhaseHom.ker ↔ _
  rw [mem_finitePhaseHom_ker_iff]
  change (∃ n : ℤ, θ.toAdd.val + θ.toAdd.val =
    SignSequence.ofReal ((n : ℝ) * (2 * Real.pi))) ↔ _
  have hconst (n : ℤ) :
      SignSequence.ofReal ((n : ℝ) * (2 * Real.pi)) =
        2 * SignSequence.ofReal ((n : ℝ) * Real.pi) := by
    rw [show (n : ℝ) * (2 * Real.pi) = 2 * ((n : ℝ) * Real.pi) by ring,
      map_mul, map_ofNat]
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    rw [hconst] at hn
    linarith only [hn]
  · rintro ⟨n, hn⟩
    exact ⟨n, by rw [hconst, hn, two_mul]⟩

/-- The half-turn kernel is the subgroup generated by the ordinary angle `pi`. -/
theorem lineAnglePeriods_eq_zpowers : lineAnglePeriods.{u} =
    Subgroup.zpowers (Multiplicative.ofAdd (SignSequence.finiteOfReal Real.pi)) := by
  ext θ
  rw [mem_lineAnglePeriods_iff, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    change n • SignSequence.finiteOfReal Real.pi = θ.toAdd
    rw [← map_zsmul, zsmul_eq_mul]
    exact ArchimedeanClass.FiniteElement.ext hn.symm
  · rintro ⟨n, hn⟩
    change n • SignSequence.finiteOfReal Real.pi = θ.toAdd at hn
    rw [← map_zsmul, zsmul_eq_mul] at hn
    exact ⟨n, congrArg (fun x : SignSequence.FiniteElement.{u} => x.val) hn.symm⟩

/-- Finite actual directed angles modulo ordinary integer half turns. -/
abbrev LineAngle := Multiplicative SignSequence.FiniteElement.{u} ⧸ lineAnglePeriods

/-- The half-turn class of a finite actual angle. -/
def lineAngle (θ : SignSequence.FiniteElement.{u}) : LineAngle.{u} :=
  QuotientGroup.mk (Multiplicative.ofAdd θ)

/-- Equality of line angles means an ordinary integral multiple of `pi`, exactly. -/
theorem lineAngle_eq_iff (θ φ : SignSequence.FiniteElement.{u}) :
    lineAngle θ = lineAngle φ ↔ ∃ n : ℤ,
      θ.val - φ.val = SignSequence.ofReal ((n : ℝ) * Real.pi) := by
  unfold lineAngle
  rw [QuotientGroup.eq_iff_div_mem, mem_lineAnglePeriods_iff]
  rfl

/-- Doubled phase identifies the actual half-turn quotient with the full unit circle. -/
def lineAngleQuotientEquiv : LineAngle.{u} ≃* UnitCircle.{u} :=
  QuotientGroup.quotientKerEquivOfSurjective linePhaseHom linePhaseHom_surjective

@[simp] theorem lineAngleQuotientEquiv_mk
    (θ : Multiplicative SignSequence.FiniteElement.{u}) :
    lineAngleQuotientEquiv (QuotientGroup.mk θ) = linePhaseHom θ := rfl

@[simp] theorem lineAngleQuotientEquiv_lineAngle (θ : SignSequence.FiniteElement.{u}) :
    lineAngleQuotientEquiv (lineAngle θ) = linePhaseHom (Multiplicative.ofAdd θ) := rfl

/-- Halving descends from full-turn classes to half-turn classes as an equivalence. -/
def halveAngleQuotient :
    (Multiplicative SignSequence.FiniteElement.{u} ⧸ anglePeriods) ≃* LineAngle.{u} :=
  angleQuotientEquiv.trans lineAngleQuotientEquiv.symm

/-- This equivalence is actual halving on every finite representative. -/
@[simp] theorem halveAngleQuotient_mk
    (θ : Multiplicative SignSequence.FiniteElement.{u}) :
    halveAngleQuotient (QuotientGroup.mk θ) = lineAngle (finiteHalf θ.toAdd) := by
  apply lineAngleQuotientEquiv.injective
  change lineAngleQuotientEquiv
    (lineAngleQuotientEquiv.symm (angleQuotientEquiv (QuotientGroup.mk θ))) = _
  rw [MulEquiv.apply_symm_apply, angleQuotientEquiv_mk,
    lineAngleQuotientEquiv_lineAngle, linePhaseHom_apply]
  change finitePhaseHom θ = finitePhaseHom
    (Multiplicative.ofAdd (finiteHalf θ.toAdd + finiteHalf θ.toAdd))
  rw [finiteHalf_add_finiteHalf]
  rfl

/-- The directed line angle of a nonzero actual surcomplex number. -/
def directedLineAngle : Surcomplex.{u}ˣ →* LineAngle.{u} where
  toFun z := lineAngleQuotientEquiv.symm (unitDirection z ^ 2)
  map_one' := by rw [map_one, one_pow, map_one]
  map_mul' z w := by rw [map_mul, mul_pow, map_mul]

@[simp] theorem lineAngleQuotientEquiv_directedLineAngle (z : Surcomplex.{u}ˣ) :
    lineAngleQuotientEquiv (directedLineAngle z) = unitDirection z ^ 2 :=
  lineAngleQuotientEquiv.apply_symm_apply _

/-- Squared normalization removes any nonzero actual real factor, of either sign. -/
theorem unitDirection_sq_eq_of_real_phase (z : Surcomplex.{u}ˣ)
    (r : SignSequence.{u}) (θ : SignSequence.FiniteElement.{u})
    (hz : (z : Surcomplex.{u}) = ofReal r * finitePhase θ) :
    unitDirection z ^ 2 = linePhaseHom (Multiplicative.ofAdd θ) := by
  have hr : r ≠ 0 := by
    intro hr
    apply z.ne_zero
    rw [hz, hr, map_zero, zero_mul]
  apply Subtype.ext
  change (unitDirection z).val ^ 2 = finitePhase θ ^ 2
  rw [coe_unitDirection, hz, modulus_mul, modulus_ofReal, modulus_finitePhase, mul_one,
    div_pow, mul_pow]
  rw [show ofReal |r| ^ 2 = ofReal r ^ 2 by rw [← map_pow, sq_abs, map_pow]]
  field_simp [(map_ne_zero ofReal).mpr hr]

/-- A nonzero real multiple of a phase has exactly that directed angle modulo `pi`. -/
theorem directedLineAngle_eq_of_real_phase (z : Surcomplex.{u}ˣ)
    (r : SignSequence.{u}) (θ : SignSequence.FiniteElement.{u})
    (hz : (z : Surcomplex.{u}) = ofReal r * finitePhase θ) :
    directedLineAngle z = lineAngle θ := by
  apply lineAngleQuotientEquiv.injective
  rw [lineAngleQuotientEquiv_directedLineAngle, lineAngleQuotientEquiv_lineAngle]
  exact unitDirection_sq_eq_of_real_phase z r θ hz

/-- Multiplication by any nonzero actual real factor preserves a directed line angle. -/
theorem directedLineAngle_eq_of_real_mul (z w : Surcomplex.{u}ˣ) (r : SignSequence.{u})
    (hw : (w : Surcomplex.{u}) = ofReal r * (z : Surcomplex.{u})) :
    directedLineAngle w = directedLineAngle z := by
  obtain ⟨θ, hθ⟩ := exists_polar (z : Surcomplex.{u}) z.ne_zero
  have hw' : (w : Surcomplex.{u}) = ofReal (r * modulus z) * finitePhase θ := by
    calc
      (w : Surcomplex.{u}) = ofReal r * (z : Surcomplex.{u}) := hw
      _ = ofReal r * (ofReal (modulus z) * finitePhase θ) :=
        congrArg (fun x => ofReal r * x) hθ
      _ = ofReal (r * modulus z) * finitePhase θ := by rw [map_mul, mul_assoc]
  rw [directedLineAngle_eq_of_real_phase w _ θ hw',
    directedLineAngle_eq_of_real_phase z _ θ hθ]

end
end Surreal.Surcomplex
