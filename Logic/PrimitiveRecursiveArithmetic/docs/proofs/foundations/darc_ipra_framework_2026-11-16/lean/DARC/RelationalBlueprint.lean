import DARC.BoundedReflectionBlueprint
import IPRADerivations.Core.Search

/-! Blueprint: finite backward viability and least compatible paths. -/
namespace LeanProofs.IPRA.DARC

open LeanProofs.ConciseIPRA LeanProofs.IPRA Syn
open scoped Fm

structure LayeredRelation where
  horizon : ℕ
  bound : Fin (horizon + 1) → PR 1
  edge : Fin horizon → PR 3

/-- Backward viability bit generated by primitive recursion on the remaining
horizon. -/
def LayeredRelation.viable (R : LayeredRelation) : Fin (R.horizon + 1) → PR 2 :=
  compileBackwardViability R

/-- A viable state before the terminal layer has a viable successor. -/
theorem viable_step (R : LayeredRelation) (i : Fin R.horizon) :
    ([] : List (Fm PTm 2)) ⊢[PRAAx]
      (app (R.viable i.castSucc) var ≐ num 1) ⟶
        boundedEx (app (R.bound i.succ) ![var 1])
          ((app (R.edge i) ![var 0, var 1, var 2] ≐ num 1) ⋏
           (app (R.viable i.succ) ![var 0, var 2] ≐ num 1)) := by
  sorry

/-- Least-search assembly of a finite compatible path. -/
theorem least_path (R : LayeredRelation) :
    ([] : List (Fm PTm 1)) ⊢[PRAAx]
      (app (R.viable 0) ![var 0, zero] ≐ num 1) ⟶
        pathValid R (leastPathCode R (var 0)) := by
  sorry

end LeanProofs.IPRA.DARC
