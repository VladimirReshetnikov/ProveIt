{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ipra-staged-contract.schema.json",
  "title": "Staged iPRA contract graph",
  "type": "object",
  "required": ["name", "global_arity", "base_context", "nodes", "final_node"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "global_arity": {"type": "integer", "minimum": 0},
    "base_context": {
      "type": "array",
      "items": {"type": "string"}
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "final_node": {"type": "string"},
    "boundary_data": {
      "type": "array",
      "items": {"$ref": "#/$defs/boundary"},
      "default": []
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "local_arity",
        "local_context",
        "local_goal",
        "substitution",
        "dependencies",
        "proof_constant"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "deterministic",
            "bounded_search",
            "loop",
            "relational",
            "stable_observable",
            "gap_exactness",
            "boundary"
          ]
        },
        "local_arity": {"type": "integer", "minimum": 0},
        "local_context": {
          "type": "array",
          "items": {"type": "string"}
        },
        "local_goal": {"type": "string"},
        "substitution": {
          "type": "array",
          "items": {"type": "string"}
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "proof_constant": {"type": "string", "minLength": 1},
        "demand_transformer": {"type": "string"},
        "resource_bound": {"type": "string"},
        "invariant": {"type": "string"},
        "status": {
          "enum": ["planned", "human_proved", "host_checked", "prf_praax", "kernel_checked"],
          "default": "planned"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "loop"}}},
          "then": {"required": ["resource_bound", "invariant"]}
        }
      ],
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["name", "formula", "producer_status"],
      "properties": {
        "name": {"type": "string"},
        "formula": {"type": "string"},
        "producer_status": {
          "enum": ["supplied_input", "primitive_recursive", "conditional", "unknown"]
        },
        "verifier": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
