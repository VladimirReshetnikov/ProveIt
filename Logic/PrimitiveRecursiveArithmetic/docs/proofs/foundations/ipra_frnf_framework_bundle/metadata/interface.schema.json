{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/frnf-interface.schema.json",
  "title": "Finitary Realizer Normal Form interface",
  "type": "object",
  "required": ["name", "inputs", "outputs", "read_horizon", "justification_horizon", "nodes", "object_goal"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/presentation"}
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/presentation"}
    },
    "read_horizon": {"$ref": "#/$defs/prSymbol"},
    "justification_horizon": {"$ref": "#/$defs/prSymbol"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "object_goal": {"type": "string"},
    "boundary_assumptions": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "status": {
      "enum": ["specified", "host-tested", "host-checked", "object-checked", "native-exported"]
    }
  },
  "$defs": {
    "prSymbol": {
      "type": "object",
      "required": ["name", "arity"],
      "properties": {
        "name": {"type": "string"},
        "arity": {"type": "integer", "minimum": 0},
        "definition": {"type": "string"}
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["name", "kind", "evaluator", "validity_formula"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["exact", "regular-name", "finite-cloud", "certified-setoid", "finite-net", "trace"]},
        "evaluator": {"$ref": "#/$defs/prSymbol"},
        "validity_formula": {"type": "string"},
        "equality_or_stability": {"type": "string"},
        "apartness_or_gap": {"type": "string"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "dependencies", "local_object_formula", "local_proof_constructor"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["exact-transducer", "bounded-search", "clocked-loop", "relational-cloud", "stable-observer", "boundary", "finalizer"]},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "local_object_formula": {"type": "string"},
        "local_proof_constructor": {"type": "string"},
        "read_transformer": {"$ref": "#/$defs/prSymbol"},
        "justification_transformer": {"$ref": "#/$defs/prSymbol"},
        "invariant": {"type": "string"},
        "fuel": {"$ref": "#/$defs/prSymbol"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
