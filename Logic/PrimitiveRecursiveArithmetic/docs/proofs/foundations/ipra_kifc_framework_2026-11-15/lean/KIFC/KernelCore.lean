import IPRADerivations.Core.Basic

/-!
# Kernel-facing core for KIFC

This file is intentionally small.  Its public objects contain actual
`Prf PRAAx` derivations.  It targets ProveIt commit
`8649990597d73657bde480b6c389de7f85bc0cb0`.

The file was written against the inspected API, but Lean is not installed in
this artifact's build environment; see `../FORMALIZATION_PLAN.md` and
`../STATUS.md` for the validation boundary.
-/

namespace LeanProofs.KIFC

open LeanProofs.ConciseIPRA
open LeanProofs.IPRA
open Syn
open scoped Fm
open LeanProofs.ConciseIPRA.PTm (zero succ)

/-- A local proof-producing rule. -/
structure KernelRule (n : ℕ) where
  premises : List (Fm PTm n)
  conclusion : Fm PTm n
  sound : premises ⊢[PRAAx] conclusion

namespace KernelRule

variable {n : ℕ} {Γ : List (Fm PTm n)}

/-- Supply derivations of every premise and cut them into the local rule. -/
theorem use (r : KernelRule n)
    (supply : ∀ ψ ∈ r.premises, Γ ⊢[PRAAx] ψ) :
    Γ ⊢[PRAAx] r.conclusion :=
  r.sound.trans supply

end KernelRule

/-- A simple implication-style contract. -/
structure ImpContract (n : ℕ) where
  pre : Fm PTm n
  post : Fm PTm n
  sound : ([] : List (Fm PTm n)) ⊢[PRAAx] pre ⟶ post

namespace ImpContract

variable {n : ℕ}

/-- Identity contract. -/
def refl (φ : Fm PTm n) : ImpContract n where
  pre := φ
  post := φ
  sound := .impI Prf.hyp0

/-- Composition is derived implication transitivity. -/
def comp (c₁ c₂ : ImpContract n) (h : c₁.post = c₂.pre) : ImpContract n where
  pre := c₁.pre
  post := c₂.post
  sound :=
    Prf.impTrans c₁.sound (by simpa [h] using c₂.sound)

end ImpContract

/-- A proof schedule.  `have_` adds one proved intermediate formula to the
context used by the remainder of the schedule. -/
inductive Schedule (n : ℕ) (Γ : List (Fm PTm n)) : Fm PTm n → Type
  | done {φ : Fm PTm n} (h : Γ ⊢[PRAAx] φ) : Schedule n Γ φ
  | have_ {ψ φ : Fm PTm n} (hψ : Γ ⊢[PRAAx] ψ)
      (rest : Schedule n (ψ :: Γ) φ) : Schedule n Γ φ

namespace Schedule

variable {n : ℕ} {Γ : List (Fm PTm n)} {φ : Fm PTm n}

/-- Compile a schedule by repeatedly applying derived simultaneous cut. -/
noncomputable def compile : Schedule n Γ φ → Γ ⊢[PRAAx] φ
  | .done h => h
  | .have_ hψ rest =>
      (compile rest).trans
        (List.forall_mem_cons.2 ⟨hψ, fun χ hχ => Prf.hyp hχ⟩)

end Schedule

/-- Exactly the data needed by `LeanProofs.IPRA.ind`. -/
structure LoopCertificate (k : ℕ) where
  inv : Fm PTm (k + 1)
  qf : inv.QF
  zeroCase : ([] : List (Fm PTm k)) ⊢[PRAAx]
    inv.subst (Syn.inst zero)
  succCase : [inv] ⊢[PRAAx]
    inv.subst (Syn.repl (succ (Syn.var 0)))

namespace LoopCertificate

variable {k n : ℕ} {Γ : List (Fm PTm n)}

/-- The open invariant theorem generated by quantifier-free induction. -/
def compile (c : LoopCertificate k) :
    ([] : List (Fm PTm (k + 1))) ⊢[PRAAx] c.inv :=
  LeanProofs.IPRA.ind c.inv c.qf c.zeroCase c.succCase

/-- Instantiate the open invariant at arbitrary terms under arbitrary
hypotheses. -/
theorem at (c : LoopCertificate k) (σ : Fin (k + 1) → PTm n) :
    Γ ⊢[PRAAx] c.inv.subst σ :=
  LeanProofs.IPRA.inst c.compile σ

end LoopCertificate

end LeanProofs.KIFC
