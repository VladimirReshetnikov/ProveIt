{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kifc-graph.schema.json",
  "title": "KIFC fixed proof graph",
  "type": "object",
  "required": ["name", "version", "terminal", "nodes"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "terminal": {"type": "string", "minLength": 1},
    "parameters": {"type": "array", "items": {"type": "string"}},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "dependencies", "certificate"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["algebra", "boolean", "search", "loop", "relation", "observer"]
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "demand": {"type": ["string", "null"]},
          "state": {"type": ["string", "null"]},
          "formula": {"type": ["string", "null"]},
          "certificate": {"type": "string", "minLength": 1},
          "guard": {"type": ["string", "null"]},
          "status": {
            "enum": ["inherited_checked", "source_complete", "lean_outline", "conditional"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
