{
  "name": "Certified Finitary Interface Framework",
  "version": "2026-11-15",
  "provenance": {
    "repository": "VladimirReshetnikov/ProveIt",
    "commit": "9df5cbdf39e6220be823f611987bd584d37711fd"
  },
  "layers": [
    "fixed primitive-recursive representations",
    "Boolean/bounded-search kernel",
    "proof-producing finite traces",
    "backward demand compilation",
    "finite relational presentations",
    "stable-observable or shrinking extraction",
    "application-specific quantitative adapter",
    "Prf PRAAx endpoint and native export"
  ],
  "output_modes": [
    "exact-code",
    "finite-relation",
    "stable-observation",
    "coherent-name"
  ],
  "core_records": {
    "PRTraceSystem": ["good", "init", "bound", "step", "inv", "accept"],
    "PRDemandSystem": ["demand", "base", "step"],
    "PRLayeredRelation": ["bound", "good", "compat"],
    "PRStablePresentation": ["bound", "cert", "obs", "dist", "err"]
  },
  "decision_order": [
    "attempt direct pairwise stable-observable proof",
    "if adjacent refinement matters, use finite viability",
    "if viable clouds shrink with a modulus, construct a coherent name",
    "otherwise retain the relation",
    "recover exact labels only under a positive gap"
  ],
  "residual_categories": [
    "finite-kernel-engineering",
    "quantitative-mathematical-estimate",
    "certificate-producer",
    "impossible-discontinuous-selector"
  ]
}
