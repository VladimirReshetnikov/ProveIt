{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tapir-plan.schema.json",
  "title": "TAPIR finite contract graph",
  "type": "object",
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "conclusion"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "conclusion": {"type": "string"},
          "deps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "residuals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "kind": {"type": "string"},
          "certificate": {
            "type": "object",
            "properties": {
              "appears_in_public": {"type": "boolean", "default": false},
              "observer_proved": {"type": "boolean", "default": false},
              "explicitly_named": {"type": "boolean", "default": false}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "compiled": {"type": "object"}
  },
  "additionalProperties": false
}
