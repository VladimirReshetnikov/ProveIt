import IPRADerivations.Core.Basic

/-!
# KIFC-R kernel-facing core

Source-oriented outline against ProveIt commit
`31784f0710fa04ccd8ee863ce9bad91fb1d8cf88`.

Every public proof field below has the embedded type `Prf PRAAx`.  The graph,
residual metadata, and source generator live in Lean's metatheory; no object-
level universal evaluator or theorem-reflection axiom is introduced.

This artifact did not compile the file because Lean is unavailable in the
artifact environment.  The definitions use the current inspected API and are
intended as the first integration gate.
-/

namespace LeanProofs.KIFCR

open LeanProofs.ConciseIPRA
open LeanProofs.IPRA
open Syn
open scoped Fm
open LeanProofs.ConciseIPRA.PTm (zero succ)

/-- A theorem-specific local rule whose soundness is already an object proof. -/
structure KernelRule (n : ℕ) where
  premises : List (Fm PTm n)
  conclusion : Fm PTm n
  sound : premises ⊢[PRAAx] conclusion

namespace KernelRule

variable {n : ℕ} {Γ : List (Fm PTm n)}

/-- Supply every local premise from one ambient context and cut them in. -/
theorem use (r : KernelRule n)
    (supply : ∀ ψ ∈ r.premises, Γ ⊢[PRAAx] ψ) :
    Γ ⊢[PRAAx] r.conclusion :=
  r.sound.trans supply

end KernelRule

/-- A proof schedule.  `have_` adds one derived formula for the remainder. -/
inductive Schedule (n : ℕ) (Γ : List (Fm PTm n)) : Fm PTm n → Type
  | done {φ : Fm PTm n} (h : Γ ⊢[PRAAx] φ) : Schedule n Γ φ
  | have_ {ψ φ : Fm PTm n} (hψ : Γ ⊢[PRAAx] ψ)
      (rest : Schedule n (ψ :: Γ) φ) : Schedule n Γ φ

namespace Schedule

variable {n : ℕ} {Γ : List (Fm PTm n)} {φ : Fm PTm n}

/-- Repeated derived simultaneous cut. -/
noncomputable def compile : Schedule n Γ φ → Γ ⊢[PRAAx] φ
  | .done h => h
  | .have_ hψ rest =>
      (compile rest).trans
        (List.forall_mem_cons.2 ⟨hψ, fun χ hχ => Prf.hyp hχ⟩)

end Schedule

/-- A conditional theorem with an explicit residual boundary context. -/
structure ConditionalTheorem (n : ℕ) where
  residuals : List (Fm PTm n)
  permanent : List (Fm PTm n)
  conclusion : Fm PTm n
  proof : residuals ++ permanent ⊢[PRAAx] conclusion

namespace ConditionalTheorem

variable {n : ℕ} {Δ : List (Fm PTm n)}

/-- Close a residualized theorem once every residual and permanent premise has
an actual derivation in the target context. -/
theorem close (t : ConditionalTheorem n)
    (hres : ∀ ψ ∈ t.residuals, Δ ⊢[PRAAx] ψ)
    (hperm : ∀ ψ ∈ t.permanent, Δ ⊢[PRAAx] ψ) :
    Δ ⊢[PRAAx] t.conclusion :=
  t.proof.trans (fun ψ hψ =>
    (List.mem_append.mp hψ).elim
      (fun hr => hres ψ hr)
      (fun hp => hperm ψ hp))

end ConditionalTheorem

/-- Exactly the data consumed by the current `LeanProofs.IPRA.ind`. -/
structure LoopCertificate (k : ℕ) where
  inv : Fm PTm (k + 1)
  qf : inv.QF
  zeroCase : ([] : List (Fm PTm k)) ⊢[PRAAx]
    inv.subst (Syn.inst zero)
  succCase : [inv] ⊢[PRAAx]
    inv.subst (Syn.repl (succ (Syn.var 0)))

namespace LoopCertificate

variable {k n : ℕ} {Γ : List (Fm PTm n)}

/-- Open invariant theorem generated by quantifier-free induction. -/
def compile (c : LoopCertificate k) :
    ([] : List (Fm PTm (k + 1))) ⊢[PRAAx] c.inv :=
  LeanProofs.IPRA.ind c.inv c.qf c.zeroCase c.succCase

/-- Instantiate the open invariant at arbitrary object terms. -/
theorem at (c : LoopCertificate k) (σ : Fin (k + 1) → PTm n) :
    Γ ⊢[PRAAx] c.inv.subst σ :=
  LeanProofs.IPRA.inst c.compile σ

end LoopCertificate

/-- Metalevel provenance for one residual formula.  Only `formula` enters the
object-theory context; the other fields make generated packets auditable. -/
structure Boundary (n : ℕ) where
  key : String
  formula : Fm PTm n
  origin : String
  expectedProducer : String
  deriving Repr

end LeanProofs.KIFCR
