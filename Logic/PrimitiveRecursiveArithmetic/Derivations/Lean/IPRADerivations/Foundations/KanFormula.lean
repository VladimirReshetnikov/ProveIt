import IPRADerivations.Foundations.SplitEquivalence

/-!
# The left Kan extension formula on representatives (`ipra_categorical_methods`, Section 4)

Packet: `foundations/ipra_categorical_methods`, Subsection "Finite Kan extensions, explicitly".
For `K : C → D`, `F : C → Set`, the left Kan extension at `d` is a quotient of the triples
`(c, k, x)`, `k : Kc → d`, `x ∈ F(c)`, by the relation generated by

`(c, k, x) ∼ (c', k', F(a) x)` if `a : c → c'` and `k' ∘ K(a) = k`.   (K)

For `G : D → Set` and a natural `α : F → G K` the packet defines
`α̂_d[c, k, x] = G(k)(α_c(x))` (KL), and proves that it is well defined, natural in `d`, that
"(KL) at the identity recovers `α`", and that "naturality at `k : Kc → d` recovers (KL)" for an
arbitrary natural `β`, so that "restriction and (KL) are inverse".

This module derives those four statements on representatives, for presented categories `C`, `D`
(`Foundations/PresentedCategory`), a specified functor `K` (`Fun` of `Foundations/Adjunction`)
and covariant presented families `F`, `G`:

* `CoFam`: a carrier formula `Car(c, x)`, an equivalence `Sim(c, x, x')` and an action term
  `act(c, c', a, x) = F(a)(x)`; `CoFam.Laws`: the functor laws as rules;
* `TrLaws`: a specified natural transformation `α(c, x)` from `F` to `G K`;
* `kl`: the term (KL); `kl_car`, `kl_congr`;
* `kl_generator`: (KL) takes equivalent values on the two sides of a generator (K);
* `kl_natural`: (KL) is natural in `d`: `α̂_{d'}[c, v ∘ k, x] ≃ G(v)(α̂_d[c, k, x])`;
* `kl_unit`: `α̂_{Kc}[c, 1, x] ≃ α_c(x)`;
* `unit_natural`: the generator relating `(c, K(a), x)` and `(c', 1_{Kc'}, F(a) x)`, which is
  the naturality of the universal transformation `x ↦ [c, 1_{Kc}, x]`;
* `BLaws`, `beta_formula`: a term `β(d, c, k, x)` on triples that respects equivalent `k` and is
  natural in `d` satisfies `β_d[c, k, x] ≃ G(k)(β_{Kc}[c, 1, x])`: it is (KL) of its restriction.

For the right Kan extension, whose elements at `d` are the tuples `(x_{c,k})`, `k : d → Kc`,
with `F(a) x_{c,k} = x_{c', K(a) ∘ k}` (KR), and a natural `α : G K → F` (`RTrLaws`):

* `kr`: the coordinate `α̂_d(y)_{c,k} = α_c(G(k) y)`;
* `kr_coherent`: these coordinates satisfy (KR);
* `kr_counit`: the coordinate at `1_{Kc}` is `α_c(y)`;
* `kr_natural`: the coordinates of `G(v) y` are the reindexed coordinates of `y`.

Instance with every hypothesis discharged, over any presented category: the constant family
with trivial action (`constFam`, `const_laws`) and the identity transformation along the
identity functor (`idTr_laws`, `idTr_rlaws`).

The quotient itself is the coequalizer of `Foundations/FiniteCoequalizer`; that (KL) descends to
it follows from `kl_generator` by the cocone property there. Not derived: the assembly of the
two (the finite table functors `Lan_K F` and `Ran_K F` as codes, the latter as a filtered
product), the converse reconstruction for the right Kan extension, and the explicit size
bounds of the packet.
-/

namespace LeanProofs.IPRA.Foundations.KanFormula

open_ipra exports
open LeanProofs.IPRA.Foundations.PresentedCategory
open LeanProofs.IPRA.Foundations.Adjunction
open LeanProofs.IPRA.Foundations.SplitEquivalence (idFun idFun_o idFun_m idFun_laws)

/-- A covariant presented family: a functor to sets given by formulas and an action term. -/
structure CoFam where
  /-- `Car(c, x)`: `x ∈ F(c)`; variables `0 = c`, `1 = x`. -/
  Car : Fm PTm 2
  /-- `Sim(c, x, x')`: `x ≃ x'` in `F(c)`; variables `0 = c`, `1 = x`, `2 = x'`. -/
  Sim : Fm PTm 3
  /-- `act(c, c', a, x) = F(a)(x)` for `a : c → c'`; variables `0 = c`, `1 = c'`, `2 = a`,
  `3 = x`. -/
  act : PTm 4

namespace CoFam

variable (F : CoFam) {n : ℕ}

/-- `x ∈ F(c)`. -/
def car (c x : PTm n) : Fm PTm n := F.Car.subst ![c, x]
/-- `x ≃ x'` in `F(c)`. -/
def sim (c x x' : PTm n) : Fm PTm n := F.Sim.subst ![c, x, x']
/-- `F(a)(x)` for `a : c → c'`. -/
def ac (c c' a x : PTm n) : PTm n := Syn.subst ![c, c', a, x] F.act

/-- The laws of a covariant family over the presented category `C`. -/
structure Laws (C : Pres) : Prop where
  sim_refl : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c x : PTm n},
    (Γ ⊢[PRAAx] F.car c x) → (Γ ⊢[PRAAx] F.sim c x x)
  sim_symm : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c x y : PTm n},
    (Γ ⊢[PRAAx] F.sim c x y) → (Γ ⊢[PRAAx] F.sim c y x)
  sim_trans : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c x y z : PTm n},
    (Γ ⊢[PRAAx] F.sim c x y) → (Γ ⊢[PRAAx] F.sim c y z) → (Γ ⊢[PRAAx] F.sim c x z)
  act_car : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c c' a x : PTm n},
    (Γ ⊢[PRAAx] C.hom c c' a) → (Γ ⊢[PRAAx] F.car c x) → (Γ ⊢[PRAAx] F.car c' (F.ac c c' a x))
  act_congr : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c c' a a' x x' : PTm n},
    (Γ ⊢[PRAAx] C.eqv c c' a a') → (Γ ⊢[PRAAx] F.sim c x x') →
      (Γ ⊢[PRAAx] F.sim c' (F.ac c c' a x) (F.ac c c' a' x'))
  act_id : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c x : PTm n},
    (Γ ⊢[PRAAx] F.car c x) → (Γ ⊢[PRAAx] F.sim c (F.ac c c (C.id1 c) x) x)
  act_comp : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c c' c'' a b x : PTm n},
    (Γ ⊢[PRAAx] C.hom c c' a) → (Γ ⊢[PRAAx] C.hom c' c'' b) → (Γ ⊢[PRAAx] F.car c x) →
      (Γ ⊢[PRAAx] F.sim c'' (F.ac c c'' (C.comp c c' c'' b a) x)
        (F.ac c' c'' b (F.ac c c' a x)))

end CoFam

/-- The laws of a specified natural transformation `α(c, x)` from `F` to `G ∘ K`. -/
structure TrLaws (C D : Pres) (K : Fun) (F G : CoFam) (α : PTm 2) : Prop where
  al_car : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c x : PTm n},
    (Γ ⊢[PRAAx] C.obj c) → (Γ ⊢[PRAAx] F.car c x) → (Γ ⊢[PRAAx] G.car (K.o c) (inst2 α c x))
  al_congr : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c x x' : PTm n},
    (Γ ⊢[PRAAx] F.sim c x x') → (Γ ⊢[PRAAx] G.sim (K.o c) (inst2 α c x) (inst2 α c x'))
  natural : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c c' a x : PTm n},
    (Γ ⊢[PRAAx] C.hom c c' a) → (Γ ⊢[PRAAx] F.car c x) →
      (Γ ⊢[PRAAx] G.sim (K.o c') (inst2 α c' (F.ac c c' a x))
        (G.ac (K.o c) (K.o c') (K.m c c' a) (inst2 α c x)))

/-- Formula (KL): `α̂_d[c, k, x] = G(k)(α_c(x))`. -/
abbrev kl (K : Fun) (G : CoFam) (α : PTm 2) {n : ℕ} (c d k x : PTm n) : PTm n :=
  G.ac (K.o c) d k (inst2 α c x)

section KL

variable {C D : Pres} {K : Fun} {F G : CoFam} {α : PTm 2} {n : ℕ} {Γ : List (Fm PTm n)}

/-- (KL) lands in `G(d)`. -/
theorem kl_car (GL : G.Laws D) (T : TrLaws C D K F G α) {c d k x : PTm n}
    (hc : Γ ⊢[PRAAx] C.obj c) (hk : Γ ⊢[PRAAx] D.hom (K.o c) d k)
    (hx : Γ ⊢[PRAAx] F.car c x) : Γ ⊢[PRAAx] G.car d (kl K G α c d k x) :=
  GL.act_car hk (T.al_car hc hx)

/-- (KL) respects equivalent arrows and equivalent elements. -/
theorem kl_congr (GL : G.Laws D) (T : TrLaws C D K F G α) {c d k k' x x' : PTm n}
    (hk : Γ ⊢[PRAAx] D.eqv (K.o c) d k k') (hx : Γ ⊢[PRAAx] F.sim c x x') :
    Γ ⊢[PRAAx] G.sim d (kl K G α c d k x) (kl K G α c d k' x') :=
  GL.act_congr hk (T.al_congr hx)

/-- (KL) is well defined on a generator (K): for `a : c → c'` with `k' ∘ K(a) = k`,
`G(k')(α_{c'}(F(a) x)) ≃ G(k)(α_c(x))`. -/
theorem kl_generator (LD : D.Laws) (KL : K.Laws C D) (GL : G.Laws D)
    (T : TrLaws C D K F G α) {c c' d a k k' x : PTm n} (hc : Γ ⊢[PRAAx] C.obj c)
    (ha : Γ ⊢[PRAAx] C.hom c c' a) (hk' : Γ ⊢[PRAAx] D.hom (K.o c') d k')
    (hx : Γ ⊢[PRAAx] F.car c x)
    (hK : Γ ⊢[PRAAx] D.eqv (K.o c) d (D.comp (K.o c) (K.o c') d k' (K.m c c' a)) k) :
    Γ ⊢[PRAAx] G.sim d (kl K G α c' d k' (F.ac c c' a x)) (kl K G α c d k x) := by
  have hax := T.al_car hc hx
  -- `G(k')(α_{c'}(F(a) x)) ≃ G(k')(G(K a)(α_c x))`: naturality of `α`
  have s₁ := GL.act_congr (LD.eqv_refl hk') (T.natural ha hx)
  -- `G(k')(G(K a)(α_c x)) ≃ G(k' ∘ K a)(α_c x)`: functoriality of `G`
  have s₂ := GL.sim_symm (GL.act_comp (KL.ar_hom ha) hk' hax)
  -- `G(k' ∘ K a)(α_c x) ≃ G(k)(α_c x)`: the generator
  have s₃ := GL.act_congr hK (GL.sim_refl hax)
  exact GL.sim_trans s₁ (GL.sim_trans s₂ s₃)

/-- (KL) is natural in `d`: `α̂_{d'}[c, v ∘ k, x] ≃ G(v)(α̂_d[c, k, x])`. -/
theorem kl_natural (GL : G.Laws D) (T : TrLaws C D K F G α) {c d d' k v x : PTm n}
    (hc : Γ ⊢[PRAAx] C.obj c) (hk : Γ ⊢[PRAAx] D.hom (K.o c) d k)
    (hv : Γ ⊢[PRAAx] D.hom d d' v) (hx : Γ ⊢[PRAAx] F.car c x) :
    Γ ⊢[PRAAx] G.sim d' (kl K G α c d' (D.comp (K.o c) d d' v k) x)
      (G.ac d d' v (kl K G α c d k x)) :=
  GL.act_comp hk hv (T.al_car hc hx)

/-- (KL) at the identity recovers `α`. -/
theorem kl_unit (GL : G.Laws D) (T : TrLaws C D K F G α) {c x : PTm n}
    (hc : Γ ⊢[PRAAx] C.obj c) (hx : Γ ⊢[PRAAx] F.car c x) :
    Γ ⊢[PRAAx] G.sim (K.o c) (kl K G α c (K.o c) (D.id1 (K.o c)) x) (inst2 α c x) :=
  GL.act_id (T.al_car hc hx)

/-- The generator between `(c, K(a), x)` and `(c', 1_{Kc'}, F(a) x)`, evaluated by (KL): the
naturality of the universal transformation `x ↦ [c, 1_{Kc}, x]`. -/
theorem unit_natural (LD : D.Laws) (KL : K.Laws C D) (GL : G.Laws D)
    (T : TrLaws C D K F G α) {c c' a x : PTm n} (hc : Γ ⊢[PRAAx] C.obj c)
    (hc' : Γ ⊢[PRAAx] C.obj c') (ha : Γ ⊢[PRAAx] C.hom c c' a) (hx : Γ ⊢[PRAAx] F.car c x) :
    Γ ⊢[PRAAx] G.sim (K.o c') (kl K G α c' (K.o c') (D.id1 (K.o c')) (F.ac c c' a x))
      (kl K G α c (K.o c') (K.m c c' a) x) :=
  kl_generator LD KL GL T hc ha (LD.id_hom (KL.ob_obj hc')) hx (LD.id_left (KL.ar_hom ha))

end KL

/-! ## Every natural transformation on triples is (KL) of its restriction -/

/-- The component `β_d[c, k, x]` of a term on triples; variables `0 = d`, `1 = c`, `2 = k`,
`3 = x`. -/
def be {n : ℕ} (β : PTm 4) (d c k x : PTm n) : PTm n := Syn.subst ![d, c, k, x] β

/-- The laws of a transformation on triples: it respects equivalent `k` and is natural in
`d`. -/
structure BLaws (C D : Pres) (K : Fun) (F G : CoFam) (β : PTm 4) : Prop where
  be_congr : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {d c k k' x : PTm n},
    (Γ ⊢[PRAAx] D.eqv (K.o c) d k k') → (Γ ⊢[PRAAx] G.sim d (be β d c k x) (be β d c k' x))
  be_natural : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {d d' c k v x : PTm n},
    (Γ ⊢[PRAAx] C.obj c) → (Γ ⊢[PRAAx] D.hom (K.o c) d k) → (Γ ⊢[PRAAx] D.hom d d' v) →
      (Γ ⊢[PRAAx] F.car c x) →
      (Γ ⊢[PRAAx] G.sim d' (be β d' c (D.comp (K.o c) d d' v k) x)
        (G.ac d d' v (be β d c k x)))

section Converse

variable {C D : Pres} {K : Fun} {F G : CoFam} {β : PTm 4} {n : ℕ} {Γ : List (Fm PTm n)}

/-- Naturality at `k : Kc → d` recovers (KL): `β_d[c, k, x] ≃ G(k)(β_{Kc}[c, 1, x])`. -/
theorem beta_formula (LD : D.Laws) (KL : K.Laws C D) (GL : G.Laws D)
    (B : BLaws C D K F G β) {c d k x : PTm n} (hc : Γ ⊢[PRAAx] C.obj c)
    (hk : Γ ⊢[PRAAx] D.hom (K.o c) d k) (hx : Γ ⊢[PRAAx] F.car c x) :
    Γ ⊢[PRAAx] G.sim d (be β d c k x)
      (G.ac (K.o c) d k (be β (K.o c) c (D.id1 (K.o c)) x)) :=
  GL.sim_trans (B.be_congr (LD.eqv_symm (LD.id_right hk)))
    (B.be_natural hc (LD.id_hom (KL.ob_obj hc)) hk hx)

end Converse

/-! ## The right Kan extension formula -/

/-- The laws of a specified natural transformation `α(c, y)` from `G ∘ K` to `F`. -/
structure RTrLaws (C D : Pres) (K : Fun) (F G : CoFam) (α : PTm 2) : Prop where
  al_car : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c y : PTm n},
    (Γ ⊢[PRAAx] C.obj c) → (Γ ⊢[PRAAx] G.car (K.o c) y) → (Γ ⊢[PRAAx] F.car c (inst2 α c y))
  al_congr : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c y y' : PTm n},
    (Γ ⊢[PRAAx] G.sim (K.o c) y y') → (Γ ⊢[PRAAx] F.sim c (inst2 α c y) (inst2 α c y'))
  natural : ∀ {n : ℕ} {Γ : List (Fm PTm n)} {c c' a y : PTm n},
    (Γ ⊢[PRAAx] C.hom c c' a) → (Γ ⊢[PRAAx] G.car (K.o c) y) →
      (Γ ⊢[PRAAx] F.sim c' (inst2 α c' (G.ac (K.o c) (K.o c') (K.m c c' a) y))
        (F.ac c c' a (inst2 α c y)))

/-- The coordinate `α̂_d(y)_{c,k} = α_c(G(k) y)` for `k : d → Kc`. -/
abbrev kr (K : Fun) (G : CoFam) (α : PTm 2) {n : ℕ} (c d k y : PTm n) : PTm n :=
  inst2 α c (G.ac d (K.o c) k y)

section KR

variable {C D : Pres} {K : Fun} {F G : CoFam} {α : PTm 2} {n : ℕ} {Γ : List (Fm PTm n)}

/-- The tuple `(α_c(G(k) y))_{c,k}` satisfies (KR): for `a : c → c'`,
`F(a)(x_{c,k}) ≃ x_{c', K(a) ∘ k}`. -/
theorem kr_coherent (KL : K.Laws C D) (FL : F.Laws C) (GL : G.Laws D)
    (T : RTrLaws C D K F G α) {c c' d a k y : PTm n} (ha : Γ ⊢[PRAAx] C.hom c c' a)
    (hk : Γ ⊢[PRAAx] D.hom d (K.o c) k) (hy : Γ ⊢[PRAAx] G.car d y) :
    Γ ⊢[PRAAx] F.sim c' (F.ac c c' a (kr K G α c d k y))
      (kr K G α c' d (D.comp d (K.o c) (K.o c') (K.m c c' a) k) y) :=
  FL.sim_trans (FL.sim_symm (T.natural ha (GL.act_car hk hy)))
    (T.al_congr (GL.sim_symm (GL.act_comp hk (KL.ar_hom ha) hy)))

/-- The counit coordinate: `x_{c, 1_{Kc}} ≃ α_c(y)` for `y ∈ G(Kc)`. -/
theorem kr_counit (GL : G.Laws D) (T : RTrLaws C D K F G α) {c y : PTm n}
    (hy : Γ ⊢[PRAAx] G.car (K.o c) y) :
    Γ ⊢[PRAAx] F.sim c (kr K G α c (K.o c) (D.id1 (K.o c)) y) (inst2 α c y) :=
  T.al_congr (GL.act_id hy)

/-- Reindexing along `v : d → d'`: the `(c, k')` coordinate of the tuple of `G(v) y` is the
`(c, k' ∘ v)` coordinate of the tuple of `y`. -/
theorem kr_natural (GL : G.Laws D) (T : RTrLaws C D K F G α) {c d d' k' v y : PTm n}
    (hv : Γ ⊢[PRAAx] D.hom d d' v) (hk' : Γ ⊢[PRAAx] D.hom d' (K.o c) k')
    (hy : Γ ⊢[PRAAx] G.car d y) :
    Γ ⊢[PRAAx] F.sim c (kr K G α c d' k' (G.ac d d' v y))
      (kr K G α c d (D.comp d d' (K.o c) k' v) y) :=
  T.al_congr (GL.sim_symm (GL.act_comp hv hk' hy))

end KR

/-! ## An instance: the constant family and the identity transformation -/

/-- The constant family: every number is an element, equivalence is equality, and every arrow
acts as the identity. -/
def constFam : CoFam where
  Car := (var 1 : PTm 2) ≐ var 1
  Sim := (var 1 : PTm 3) ≐ var 2
  act := var 3

section Instance

variable {n : ℕ} {Γ : List (Fm PTm n)}

theorem const_car (c x : PTm n) : constFam.car c x = (x ≐ x) := by
  simp [CoFam.car, constFam]

theorem const_sim (c x y : PTm n) : constFam.sim c x y = (x ≐ y) := by
  simp [CoFam.sim, constFam]

theorem const_ac (c c' a x : PTm n) : constFam.ac c c' a x = x := by
  simp [CoFam.ac, constFam]

/-- The constant family satisfies the laws over every presented category. -/
theorem const_laws (C : Pres) : constFam.Laws C where
  sim_refl := fun _ => by simp only [const_sim]; exact .eqRefl _
  sim_symm := fun h => by simp only [const_sim] at h ⊢; exact h.eqSymm
  sim_trans := fun h₁ h₂ => by simp only [const_sim] at h₁ h₂ ⊢; exact h₁.eqTrans h₂
  act_car := fun _ _ => by simp only [const_car]; exact .eqRefl _
  act_congr := fun _ h => by simp only [const_sim, const_ac] at h ⊢; exact h
  act_id := fun _ => by simp only [const_sim, const_ac]; exact .eqRefl _
  act_comp := fun _ _ _ => by simp only [const_sim, const_ac]; exact .eqRefl _

/-- The identity transformation `α(c, x) = x`. -/
def idTr : PTm 2 := var 1

theorem inst2_idTr (c x : PTm n) : inst2 idTr c x = x := by simp [inst2, idTr]

/-- The identity transformation of the constant family along the identity functor. -/
theorem idTr_laws (C : Pres) : TrLaws C C idFun constFam constFam idTr where
  al_car := fun _ _ => by simp only [const_car]; exact .eqRefl _
  al_congr := fun h => by simp only [const_sim, inst2_idTr] at h ⊢; exact h
  natural := fun _ _ => by simp only [const_sim, const_ac, inst2_idTr]; exact .eqRefl _

/-- The same transformation, read from `G ∘ K` to `F`. -/
theorem idTr_rlaws (C : Pres) : RTrLaws C C idFun constFam constFam idTr where
  al_car := fun _ _ => by simp only [const_car]; exact .eqRefl _
  al_congr := fun h => by simp only [const_sim, inst2_idTr] at h ⊢; exact h
  natural := fun _ _ => by simp only [const_sim, const_ac, inst2_idTr]; exact .eqRefl _

/-- (KL) for the instance: `α̂_d[c, k, x] = x`. -/
theorem kl_const (c d k x : PTm n) : kl idFun constFam idTr c d k x = x := by
  simp only [kl, const_ac, inst2_idTr]

end Instance

end LeanProofs.IPRA.Foundations.KanFormula
