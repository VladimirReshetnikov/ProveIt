import IPRADerivations.Foundations.MasterCertificate

/-!
# Realizing fixed bounded strategies

Packet `foundations/fiber_ipra_2026-11-16`, Theorem `thm:strategy`.

A fixed quantifier pattern has bounded-formula leaves. An existential node
stores a response and a child strategy in a pair. A universal node stores an
actual length-prefixed sequence of child strategies, decoded by
`MasterCertificate.entry`. The primitive recursive verifier checks the
response bounds, table lengths and every relevant leaf. Its soundness proof
is generated by external recursion on the fixed pattern, with all move bounds,
strategy codes and runtime data internal to iPRA. Dependent bounds and leaves
read the preceding moves from the packed parameter.
-/

set_option linter.unusedSimpArgs false

namespace LeanProofs.IPRA.Foundations.StrategyRealization

open LeanProofs.ConciseIPRA LeanProofs.IPRA
open LeanProofs.IPRA.Foundations.BoundedFormulas
open LeanProofs.IPRA.Foundations.BoundedReflection
open LeanProofs.IPRA.Foundations.MasterCertificate (entry subst_entry)
open Syn
open scoped Fm
open ConciseIPRA.PTm (zero succ)
open LeanProofs.IPRA.PTm (monus)

variable {n : ℕ} {Γ : List (Fm PTm n)}

/-- The quantifier pattern is fixed at proof-generation time; all its bounds
are terms evaluated at the current packed move history. -/
inductive Pattern where
  | leaf (A : BF)
  | ex (bound : PTm 1) (body : Pattern)
  | all (bound : PTm 1) (body : Pattern)

/-- The bounded source formula realized by the strategy. -/
def formula : Pattern → BF
  | .leaf A => A
  | .ex b P => .ex b (formula P)
  | .all b P => .all b (formula P)

/-- The finite verifier before its final Boolean normalization. -/
def check : Pattern → (m : ℕ) → PTm m → PTm m → PTm m
  | .leaf A, m, _, x => bitAt A m x
  | .ex b P, m, code, x =>
      eqb (monus (succ (fstT code)) (at1 b x)) zero *
        check P m (sndT code) (pairT (fstT code) x)
  | .all b P, _, code, x =>
      eqb (fstT code) (at1 b x) *
        allB
          (eqb (check P 2 (entry (fstT (var 1)) (var 0))
            (pairT (var 0) (sndT (var 1)))) one)
          (at1 b x) (pairT code x)

theorem subst_check (P : Pattern) : ∀ {m k : ℕ} (σ : Fin m → PTm k) (c x : PTm m),
    Syn.subst σ (check P m c x) = check P k (Syn.subst σ c) (Syn.subst σ x) := by
  induction P with
  | leaf A => intro m k σ c x; exact bitAt_subst A σ x
  | ex b P ih =>
    intro m k σ c x
    simp only [check, PTm.subst_mul, subst_eqb, PTm.subst_monus,
      ConciseIPRA.PTm.subst_succ, ConciseIPRA.PTm.subst_zero,
      subst_fstT, subst_sndT, at1_subst, subst_pairT, ih]
  | all b P _ =>
    intro m k σ c x
    simp only [check, PTm.subst_mul, subst_eqb, subst_fstT, at1_subst,
      subst_ap2, subst_pairT]

private theorem check_congr (P : Pattern) {c c' x x' : PTm n}
    (hc : Γ ⊢[PRAAx] c ≐ c') (hx : Γ ⊢[PRAAx] x ≐ x') :
    Γ ⊢[PRAAx] check P n c x ≐ check P n c' x' := by
  have h := congrInst2 (check P 2 (var 0) (var 1)) hc hx
  simpa only [inst2, subst_check, Syn.subst_var,
    Matrix.cons_val_zero, Matrix.cons_val_one] using h

private theorem pair_congr {a a' b b' : PTm n}
    (ha : Γ ⊢[PRAAx] a ≐ a') (hb : Γ ⊢[PRAAx] b ≐ b') :
    Γ ⊢[PRAAx] pairT a b ≐ pairT a' b' :=
  congrAdd (congrMul (congrAdd ha hb) (congrAdd ha hb)) ha

private theorem eqb_congr {a a' b b' : PTm n}
    (ha : Γ ⊢[PRAAx] a ≐ a') (hb : Γ ⊢[PRAAx] b ≐ b') :
    Γ ⊢[PRAAx] eqb a b ≐ eqb a' b' :=
  congrMonus (.eqRefl _) (congrAdd (congrMonus ha hb) (congrMonus hb ha))

private theorem entry_congr {c c' i i' : PTm n}
    (hc : Γ ⊢[PRAAx] c ≐ c') (hi : Γ ⊢[PRAAx] i ≐ i') :
    Γ ⊢[PRAAx] entry c i ≐ entry c' i' := by
  have h := congrInst2 (entry (var 0) (var 1) : PTm 2) hc hi
  simpa only [inst2, subst_entry, Syn.subst_var,
    Matrix.cons_val_zero, Matrix.cons_val_one] using h

/-- If a Boolean guard times another value is one, both accepted parts are one. -/
private theorem split_guard {a b rest : PTm n}
    (h : Γ ⊢[PRAAx] eqb a b * rest ≐ one) :
    (Γ ⊢[PRAAx] eqb a b ≐ one) ∧ (Γ ⊢[PRAAx] rest ≐ one) := by
  have oneGuard : Γ ⊢[PRAAx] eqb a b ≐ one := by
    refine .orE (eqb_cases a b) ?_ Prf.hyp0
    exact one_ne_zero _ (h.wk.eqSymm.eqTrans
      ((congrMul Prf.hyp0 (.eqRefl _)).eqTrans (zero_mul _)))
  exact ⟨oneGuard, ((congrMul oneGuard (.eqRefl _)).eqTrans (one_mul _)).eqSymm.eqTrans h⟩

/-- The universal-node verifier body at one move. -/
private abbrev allBody (P : Pattern) : PTm 2 :=
  eqb (check P 2 (entry (fstT (var 1)) (var 0))
    (pairT (var 0) (sndT (var 1)))) one

private theorem allBody_at (P : Pattern) (code i x : PTm n) :
    Γ ⊢[PRAAx] inst2 (allBody P) i (pairT code x) ≐
      eqb (check P n (entry code i) (pairT i x)) one := by
  simp only [allBody, inst2, subst_eqb, subst_check, subst_entry,
    subst_fstT, subst_sndT, subst_pairT, Syn.subst_var,
    Matrix.cons_val_zero, Matrix.cons_val_one, ConciseIPRA.PTm.subst_succ,
    ConciseIPRA.PTm.subst_zero]
  exact eqb_congr
    (check_congr P (entry_congr (fst_pair _ _) (.eqRefl _))
      (pair_congr (.eqRefl _) (snd_pair _ _))) (.eqRefl _)

/-- Generated soundness of the actual finite strategy checker. -/
theorem check_sound (P : Pattern) : ∀ {m : ℕ} {Δ : List (Fm PTm m)} (code x : PTm m),
    (Δ ⊢[PRAAx] check P m code x ≐ one) → (Δ ⊢[PRAAx] fmAt (formula P) m x) := by
  induction P with
  | leaf A => intro m Δ code x h; exact Prf.impE (reflect A x).2.1 h
  | ex b P ih =>
    intro m Δ code x h
    have guard := split_guard h
    have bound : Δ ⊢[PRAAx] lt (fstT code) (at1 b x) := eq_of_eqb guard.1
    have child := ih (sndT code) (pairT (fstT code) x) guard.2
    apply Prf.exI (fstT code)
    simpa only [formula, fmAt, Fm.subst_and, subst_lt, fmAt_subst,
      subst_pairT, Syn.subst_var, Syn.inst_zero, Syn.subst_inst_shift] using
      (Prf.andI bound child)
  | all b P ih =>
    intro m Δ code x h
    have accepted := (split_guard h).2
    have shifted : Δ.map Fm.shift ⊢[PRAAx]
        allB (allBody P) (Syn.shift (at1 b x)) (pairT (Syn.shift code) (Syn.shift x)) ≐ one := by
      simpa only [Fm.shift, Fm.subst_eq, subst_ap2, subst_pairT,
        Syn.shift, ConciseIPRA.PTm.subst_succ, ConciseIPRA.PTm.subst_zero] using accepted.shift
    refine .allI (.impI ?_)
    let C := lt (var 0) (Syn.shift (at1 b x)) :: Δ.map Fm.shift
    have nonzero : C ⊢[PRAAx] neg (inst2 (allBody P) (var 0)
        (pairT (Syn.shift code) (Syn.shift x)) ≐ zero) :=
      all_elim (allBody P) shifted.wk Prf.hyp0
    have acceptedChild : C ⊢[PRAAx]
        eqb (check P (m + 1) (entry (Syn.shift code) (var 0))
          (pairT (var 0) (Syn.shift x))) one ≐ one := by
      let child := check P (m + 1) (entry (Syn.shift code) (var 0)) (pairT (var 0) (Syn.shift x))
      refine .orE (eqb_cases child one) ?_ Prf.hyp0
      have unaccepted : ((eqb child one ≐ zero) :: C) ⊢[PRAAx]
          inst2 (allBody P) (var 0) (pairT (Syn.shift code) (Syn.shift x)) ≐ zero :=
        (allBody_at P (Syn.shift code) (var 0) (Syn.shift x)).eqTrans Prf.hyp0
      exact .botE _ (Prf.impE nonzero.wk unaccepted)
    exact ih (entry (Syn.shift code) (var 0)) (pairT (var 0) (Syn.shift x))
      (eq_of_eqb acceptedChild)

/-- The public verifier is a Boolean term. -/
def verifier (P : Pattern) (code x : PTm n) : PTm n := eqb (check P n code x) one

@[simp] theorem subst_verifier (P : Pattern) {m : ℕ} (σ : Fin n → PTm m) (code x : PTm n) :
    Syn.subst σ (verifier P code x) = verifier P (Syn.subst σ code) (Syn.subst σ x) := by
  simp only [verifier, subst_eqb, subst_check, ConciseIPRA.PTm.subst_succ,
    ConciseIPRA.PTm.subst_zero]

/-- The explicit binary primitive recursive verifier symbol for the pattern. -/
def verifierF (P : Pattern) : PR 2 := PTm.toPR (verifier P (var 0) (var 1))

theorem verifier_at (P : Pattern) (code x : PTm n) :
    Γ ⊢[PRAAx] ap2 (verifierF P) code x ≐ verifier P code x := by
  have h := toPR_eq (Γ := Γ) (verifier P (var 0) (var 1) : PTm 2) ![code, x]
  simpa only [verifierF, ap2, subst_verifier, Syn.subst_var,
    Matrix.cons_val_zero, Matrix.cons_val_one] using h

theorem verifier_cases (P : Pattern) (code x : PTm n) :
    Γ ⊢[PRAAx] (verifier P code x ≐ zero) ⋎ (verifier P code x ≐ one) :=
  eqb_cases _ _

theorem strategy_sound (P : Pattern) (code x : PTm n)
    (h : Γ ⊢[PRAAx] verifier P code x ≐ one) :
    Γ ⊢[PRAAx] fmAt (formula P) n x :=
  check_sound P code x (eq_of_eqb h)

/-- All natural strategy codes and runtime histories are internally quantified. -/
def strategyFormula (P : Pattern) : Fm PTm 2 :=
  (verifier P (var 0) (var 1) ≐ one) ⟶ fmAt (formula P) 2 (var 1)

theorem bounded_strategy (P : Pattern) :
    ([] : List (Fm PTm 0)) ⊢[PRAAx] univ 2 (strategyFormula P) :=
  closeUniv 2 (.impI (strategy_sound P (var 0) (var 1) Prf.hyp0))

/-- The source endpoint explicitly calls the generated primitive recursive
program, with its code and all preceding moves as internal data. -/
def programFormula (P : Pattern) : Fm PTm 2 :=
  (ap2 (verifierF P) (var 0) (var 1) ≐ one) ⟶ fmAt (formula P) 2 (var 1)

theorem bounded_strategy_program (P : Pattern) :
    ([] : List (Fm PTm 0)) ⊢[PRAAx] univ 2 (programFormula P) :=
  closeUniv 2 (.impI (strategy_sound P (var 0) (var 1)
    ((verifier_at P (var 0) (var 1)).eqSymm.eqTrans Prf.hyp0)))

#print axioms check_sound
#print axioms verifier_cases
#print axioms bounded_strategy
#print axioms bounded_strategy_program

end LeanProofs.IPRA.Foundations.StrategyRealization
