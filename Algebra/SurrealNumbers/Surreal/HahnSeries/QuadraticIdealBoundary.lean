import Surreal.Algebra.QuadraticIdealBoundary
import Surreal.HahnSeries.QuadraticIdealDefinition
import Surreal.HahnSeries.NonpositivePolynomialDegree

/-!
# Boundary examples for the quadratic ideal definition

The two examples following `odg:def:thm:ideal`. A literal Hahn realization
of Z[omega] is an intermediate ring containing a purely infinite element
without a quadratic witness. If the constant ring is Z[sqrt(2)], its
nonzero constant sqrt(2) has a witness but is outside the purely infinite ideal.
-/

namespace Surreal.HahnSeries

open _root_.HahnSeries

noncomputable section

variable {Γ K : Type*} [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]
  [Field K] [CharZero K]

/-- Integer polynomials evaluated at a support-ring element. -/
def integerPolynomialEval (f : nonpositiveSupportSubring Γ K) :
    Polynomial ℤ →+* nonpositiveSupportSubring Γ K :=
  Polynomial.eval₂RingHom (nonpositiveConstants.comp (Int.castRingHom K)) f

omit [CharZero K] in
/-- The evaluation range is precisely the native subring generated by the chosen element. -/
theorem integerPolynomialEval_range (f : nonpositiveSupportSubring Γ K) :
    (integerPolynomialEval f).range = Subring.closure {f} := by
  apply le_antisymm
  · rintro _ ⟨P, rfl⟩
    induction P using Polynomial.induction_on' with
    | add P Q hP hQ =>
      rw [map_add]
      exact (Subring.closure {f}).add_mem hP hQ
    | monomial n a =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
      apply (Subring.closure {f}).mul_mem
      · simp [integerPolynomialEval]
      · apply (Subring.closure {f}).pow_mem
        simpa [integerPolynomialEval] using
          (Subring.subset_closure (Set.mem_singleton f) : f ∈ Subring.closure {f})
  · apply Subring.closure_le.mpr
    intro x hx
    have hx' : x = f := Set.mem_singleton_iff.mp hx
    subst x
    exact ⟨Polynomial.X, by simp [integerPolynomialEval]⟩

/-- Negative Hahn order makes integer polynomial evaluation faithful. -/
theorem integerPolynomialEval_injective (f : nonpositiveSupportSubring Γ K) (hf : f.val.order < 0) :
    Function.Injective (integerPolynomialEval f) := by
  have hker (P : Polynomial ℤ) (h : integerPolynomialEval f P = 0) : P = 0 := by
    by_contra hp
    have hp' : P.map (Int.castRingHom K) ≠ 0 :=
      (Polynomial.map_ne_zero_iff Int.cast_injective).mpr hp
    have he : (P.map (Int.castRingHom K)).eval₂ nonpositiveConstants f = 0 := by
      rw [Polynomial.eval₂_map]
      exact h
    have hv := congrArg Subtype.val he
    rw [nonpositiveSupport_eval_val] at hv
    exact (polynomial_eval_negative_order _ hp' f.val hf).1 hv
  intro P Q h
  exact sub_eq_zero.mp (hker (P - Q) (by rw [map_sub, h, sub_self]))

omit [CharZero K] in
/-- The constant term of an integer polynomial in a zero-constant series is an integer. -/
theorem constantCoeff_integerPolynomialEval (f : nonpositiveSupportSubring Γ K)
    (hf : nonpositiveConstantCoeff f = 0) (P : Polynomial ℤ) :
    nonpositiveConstantCoeff (integerPolynomialEval f P) = (P.coeff 0 : K) := by
  change nonpositiveConstantCoeff (P.eval₂ _ f) = _
  rw [Polynomial.hom_eval₂, hf]
  have hi : (nonpositiveConstantCoeff (Γ := Γ)).comp
      (nonpositiveConstants.comp (Int.castRingHom K)) =
      Int.castRingHom K := Subsingleton.elim _ _
  rw [hi]
  simp

omit [CharZero K] in
/-- The generated polynomial subring has exactly the ordinary integers as its constants. -/
theorem integerPolynomialRange_constants (f : nonpositiveSupportSubring Γ K)
    (hf : nonpositiveConstantCoeff f = 0) (c : K) :
    nonpositiveConstants c ∈ (integerPolynomialEval f).range ↔ ∃ z : ℤ, (z : K) = c := by
  constructor
  · rintro ⟨P, hP⟩
    have h := congrArg nonpositiveConstantCoeff hP
    rw [constantCoeff_integerPolynomialEval f hf, nonpositiveConstantCoeff_constants] at h
    exact ⟨P.coeff 0, h⟩
  · rintro ⟨z, rfl⟩
    exact ⟨Polynomial.C z, by simp [integerPolynomialEval]⟩

/-- A negative-order, zero-constant generator is purely infinite in its generated integer
polynomial ring, but has no quadratic witness there. -/
theorem integerPolynomialRange_boundary (f : nonpositiveSupportSubring Γ K)
    (ho : f.val.order < 0) (hc : nonpositiveConstantCoeff f = 0) :
    f ∈ (integerPolynomialEval f).range ∧ f ∈ purelyInfiniteIdeal ∧
      ¬ ∃ y : (integerPolynomialEval f).range,
        ((integerPolynomialEval f).rangeRestrict Polynomial.X) ^ 2 = 2 * y ^ 2 := by
  refine ⟨⟨Polynomial.X, by simp [integerPolynomialEval]⟩, hc, ?_⟩
  exact QuadraticIdeal.polynomial_range_no_quadratic_witness _ (integerPolynomialEval_injective f ho)

/-- The source's omega in the integer-exponent Hahn workspace: t to the power minus one. -/
def integerExponentOmega : nonpositiveSupportSubring ℤ ℝ :=
  ⟨single (-1) 1, by
    intro a ha
    rw [coeff_single_of_ne (by omega : a ≠ -1)]⟩

/-- The concrete Z[omega] example has zero constant term and no witness in Z[omega]. -/
theorem integerExponentOmega_boundary :
    integerExponentOmega ∈ (integerPolynomialEval integerExponentOmega).range ∧
      integerExponentOmega ∈ purelyInfiniteIdeal ∧
      ¬ ∃ y : (integerPolynomialEval integerExponentOmega).range,
        ((integerPolynomialEval integerExponentOmega).rangeRestrict Polynomial.X) ^ 2 =
          2 * y ^ 2 := by
  apply integerPolynomialRange_boundary
  · change (single (-1 : ℤ) (1 : ℝ)).order < 0
    rw [order_single one_ne_zero]
    norm_num
  · change (single (-1 : ℤ) (1 : ℝ)).coeff 0 = 0
    simp

/-- The concrete generated subring is an intermediate ring for Z inside the real Hahn ring. -/
theorem integerExponentOmega_constants (c : ℝ) :
    nonpositiveConstants c ∈ (integerPolynomialEval integerExponentOmega).range ↔
      ∃ z : ℤ, (z : ℝ) = c :=
  integerPolynomialRange_constants integerExponentOmega
    integerExponentOmega_boundary.2.1 c

/-- The ordinary constant ring Z[sqrt(2)] inside R. -/
def sqrtTwoSubring : Subring ℝ := Subring.closure {Real.sqrt 2}

/-- The nonzero constant sqrt(2) belongs to the full pullback with constants Z[sqrt(2)]. -/
def sqrtTwoRestrictedConstant : coefficientRestrictedSubring (Γ := Γ) sqrtTwoSubring.subtype :=
  coefficientRestrictedConstants sqrtTwoSubring.subtype
    ⟨Real.sqrt 2, Subring.subset_closure (Set.mem_singleton _)⟩

/-- Once the constant ring contains sqrt(2), the quadratic formula has a non-purely-infinite
solution, witnessed by the ordinary constant one. -/
theorem sqrtTwoRestrictedConstant_boundary :
    (sqrtTwoRestrictedConstant (Γ := Γ)) ^ 2 = 2 * (1 : coefficientRestrictedSubring
      (Γ := Γ) sqrtTwoSubring.subtype) ^ 2 ∧
      (sqrtTwoRestrictedConstant (Γ := Γ)).val ∉ purelyInfiniteIdeal := by
  constructor
  · apply Subtype.ext
    change (nonpositiveConstants (Real.sqrt 2) : nonpositiveSupportSubring Γ ℝ) ^ 2 = 2 * 1 ^ 2
    rw [← map_pow, Real.sq_sqrt (by norm_num), map_ofNat]
    ring
  · change nonpositiveConstantCoeff (nonpositiveConstants (Γ := Γ) (Real.sqrt 2)) ≠ 0
    rw [nonpositiveConstantCoeff_constants]
    exact Real.sqrt_ne_zero'.mpr (by norm_num)

end
end Surreal.HahnSeries
