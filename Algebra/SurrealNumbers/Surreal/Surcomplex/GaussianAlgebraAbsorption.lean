import Surreal.Algebra.IdealAbsorption
import Surreal.Algebra.IntegralReciprocal
import Surreal.Surcomplex.GaussianFractionField

/-!
# Uniform Gaussian algebra denominators and complete integral closure

The actual surcomplex clauses of `osq:nm:thm:onedenominator` and
`osq:nm:thm:complete`. The denominator is a real positive monomial;
its products with the whole generated algebra have purely infinite support.
The reciprocal obstruction `osq:nm:lem:reciprocal` distinguishes complete
integral closure from ordinary integral closure.
-/

universe u
namespace Surreal.Surcomplex
open Foundations
noncomputable section

/-- One real monomial clears the whole Gaussian algebra generated by a small surcomplex set. -/
theorem gaussianOmnific_adjoin_monomial_clearing (s : Set Surcomplex.{u}) [Small.{u} s] :
    ∃ h : SignSequence.{u}, 0 < h ∧ ∀ x ∈ Algebra.adjoin GaussianOmnificInteger s,
      ∃ z ∈ RingHom.ker (gaussianOmnificConstantCoeff.{u}),
        gaussianOmnificToSurcomplex z = ofReal (SignSequence.omegaPower h) * x := by
  obtain ⟨h, hh, hs⟩ := gaussianOmnific_monomial_clearing
    (fun x : Algebra.adjoin ℤ s => (x : Surcomplex.{u}))
  refine ⟨h, hh, IdealAbsorption.adjoin (RingHom.ker (gaussianOmnificConstantCoeff.{u})) s
    (ofReal (SignSequence.omegaPower h)) ?_⟩
  intro x hx
  exact hs ⟨x, hx⟩

/-- The monomial gives a nonzero conductor element whose products land in the infinite ideal. -/
theorem gaussianOmnific_adjoin_conductor_nonzero (s : Set Surcomplex.{u}) [Small.{u} s] :
    ∃ d : GaussianOmnificInteger.{u}, d ≠ 0 ∧ d ∈ RingHom.ker (gaussianOmnificConstantCoeff.{u}) ∧
      ∀ x ∈ Algebra.adjoin GaussianOmnificInteger s,
        ∃ z ∈ RingHom.ker (gaussianOmnificConstantCoeff.{u}),
          gaussianOmnificToSurcomplex z = gaussianOmnificToSurcomplex d * x := by
  obtain ⟨h, hh, hs⟩ := gaussianOmnific_adjoin_monomial_clearing s
  obtain ⟨d, hd, he⟩ := (isPurelyInfinite_real_omegaPower h hh).exists_gaussianOmnific_kernel
  refine ⟨d, ?_, hd, ?_⟩
  · intro hz
    have hn : ofReal (SignSequence.omegaPower h) ≠ (0 : Surcomplex.{u}) :=
      (map_ne_zero_iff ofReal ofReal_injective).mpr (SignSequence.omegaPower_ne_zero h)
    exact hn (he.symm.trans (by rw [hz, map_zero]))
  · simpa only [he] using hs

/-- Every surcomplex number is almost integral over the actual Gaussian omnific ring. -/
theorem gaussianOmnific_isAlmostIntegral (x : Surcomplex.{u}) :
    IsAlmostIntegral GaussianOmnificInteger x := by
  obtain ⟨d, hd, _, hs⟩ := gaussianOmnific_adjoin_conductor_nonzero {x}
  refine ⟨d, mem_nonZeroDivisors_iff_ne_zero.mpr hd, fun n => ?_⟩
  obtain ⟨z, _, hz⟩ := hs (x ^ n)
    ((Algebra.adjoin GaussianOmnificInteger {x}).pow_mem (Algebra.subset_adjoin rfl) n)
  exact ⟨z, hz⟩

/-- The native complete integral closure is the whole actual surcomplex field. -/
theorem gaussianOmnific_completeIntegralClosure_eq_top :
    completeIntegralClosure GaussianOmnificInteger.{u} Surcomplex.{u} = ⊤ := by
  apply top_unique
  intro x _
  exact gaussianOmnific_isAlmostIntegral x

/-- Every intermediate ring has complete integral closure equal to the full surcomplex field. -/
theorem gaussianOmnific_intermediate_completeIntegralClosure_eq_top
    (A : Subalgebra GaussianOmnificInteger.{u} Surcomplex.{u}) :
    completeIntegralClosure A Surcomplex.{u} = ⊤ := by
  apply top_unique
  intro x _
  exact IdealAbsorption.almostIntegral_intermediate (gaussianOmnific_isAlmostIntegral x) A

/-- Intermediate Gaussian rings have the surcomplex field as fraction field and complete closure. -/
theorem gaussianOmnific_intermediate_fraction_and_complete
    (A : Subalgebra GaussianOmnificInteger.{u} Surcomplex.{u}) :
    IsFractionRing A Surcomplex.{u} ∧ completeIntegralClosure A Surcomplex.{u} = ⊤ :=
  ⟨inferInstance, gaussianOmnific_intermediate_completeIntegralClosure_eq_top A⟩

/-- A nonzero Gaussian omnific nonunit has no integral reciprocal. -/
theorem gaussianOmnific_inv_not_isIntegral (a : GaussianOmnificInteger.{u}) (ha : a ≠ 0)
    (hu : ¬ IsUnit a) : ¬ IsIntegral GaussianOmnificInteger (gaussianOmnificToSurcomplex a)⁻¹ :=
  fun h => hu ((IntegralReciprocal.isIntegral_inv_iff a ha).mp h)

/-- One half is almost integral but not integral over the Gaussian omnific ring. -/
theorem gaussianOmnific_half_almost_not_integral :
    IsAlmostIntegral GaussianOmnificInteger.{u} (2⁻¹ : Surcomplex.{u}) ∧
      ¬ IsIntegral GaussianOmnificInteger.{u} (2⁻¹ : Surcomplex.{u}) := by
  refine ⟨gaussianOmnific_isAlmostIntegral _, ?_⟩
  have hu : ¬ IsUnit (2 : GaussianOmnificInteger.{u}) := by
    intro h
    have hg : IsUnit (2 : GaussianInt) := by
      simpa only [map_ofNat] using h.map gaussianOmnificConstantCoeff
    rw [Zsqrtd.isUnit_iff_norm_isUnit] at hg
    norm_num [Zsqrtd.norm, Int.isUnit_iff] at hg
  simpa only [map_ofNat] using gaussianOmnific_inv_not_isIntegral 2 (by norm_num) hu

/-- Gaussian ordinary integral closure is strictly smaller than complete integral closure. -/
theorem gaussianOmnific_integralClosure_lt_completeIntegralClosure :
    integralClosure GaussianOmnificInteger.{u} Surcomplex.{u} <
      completeIntegralClosure GaussianOmnificInteger.{u} Surcomplex.{u} := by
  refine lt_of_le_of_ne integralClosure_le_completeIntegralClosure ?_
  intro he
  apply gaussianOmnific_half_almost_not_integral.2
  change (2⁻¹ : Surcomplex.{u}) ∈ integralClosure GaussianOmnificInteger.{u} Surcomplex.{u}
  rw [he]
  exact gaussianOmnific_half_almost_not_integral.1

end
end Surreal.Surcomplex
