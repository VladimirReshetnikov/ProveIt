import Mathlib.NumberTheory.Zsqrtd.GaussianInt
import Mathlib.Algebra.Ring.Subring.Basic

/-!
# Maps from ordinary integer and Gaussian integer rings

The ordinary algebra underlying `osq:cor:Oz` and `osq:cor:gaussian`.
Integer nonunital maps correspond to idempotents. Gaussian unital maps
correspond to square roots of minus one even in noncommutative targets;
Mathlib's commutative lift is applied inside the subring generated by the root.
-/

universe u
namespace Surreal.OrdinaryRingMaps
noncomputable section

/-- An idempotent determines a nonunital integer map by ordinary additive multiples. -/
def integerMap {S : Type u} [NonUnitalRing S] (e : S) (he : e * e = e) : ℤ →ₙ+* S where
  toFun n := n • e
  map_zero' := zero_zsmul e
  map_add' a b := add_zsmul e a b
  map_mul' a b := by
    rw [smul_mul_assoc, mul_smul_comm, he, smul_smul]

/-- The image of one parametrizes all nonunital integer maps, without commutativity. -/
def integerNonUnitalHomEquiv (S : Type u) [NonUnitalRing S] :
    (ℤ →ₙ+* S) ≃ {e : S // e * e = e} where
  toFun φ := ⟨φ 1, by rw [← map_mul, one_mul]⟩
  invFun e := integerMap e.val e.property
  left_inv φ := by
    ext n
    change n • φ 1 = φ n
    simpa using (map_zsmul φ n 1).symm
  right_inv e := by
    apply Subtype.ext
    exact one_zsmul e.val

open scoped IsMulCommutative in
/-- A root in a noncommutative ring defines a Gaussian map through its commutative generated subring. -/
def gaussianMap {S : Type u} [Ring S] (j : S) (hj : j ^ 2 = -1) : GaussianInt →+* S := by
  let A := Subring.closure ({j} : Set S)
  letI : IsMulCommutative A := Subring.isMulCommutative_closure (by
    intro x hx y hy
    have hx' : x = j := Set.mem_singleton_iff.mp hx
    have hy' : y = j := Set.mem_singleton_iff.mp hy
    rw [hx', hy'])
  let r : A := ⟨j, Subring.subset_closure (Set.mem_singleton j)⟩
  have hr : r * r = ((-1 : ℤ) : A) := by
    apply Subtype.ext
    change j * j = ((-1 : ℤ) : S)
    simpa only [Int.cast_neg, Int.cast_one, pow_two] using hj
  exact A.subtype.comp (Zsqrtd.lift ⟨r, hr⟩)

/-- The Gaussian map has the expected coordinate formula. -/
theorem gaussianMap_apply {S : Type u} [Ring S] (j : S) (hj : j ^ 2 = -1) (z : GaussianInt) :
    gaussianMap j hj z = (z.re : S) + (z.im : S) * j := rfl

/-- In particular the chosen root is the image of the ordinary imaginary unit. -/
theorem gaussianMap_sqrtd {S : Type u} [Ring S] (j : S) (hj : j ^ 2 = -1) :
    gaussianMap j hj Zsqrtd.sqrtd = j := by
  rw [gaussianMap_apply]
  simp only [Zsqrtd.re_sqrtd, Zsqrtd.im_sqrtd, Int.cast_zero, Int.cast_one, one_mul, zero_add]

/-- Unital Gaussian maps correspond to all roots of minus one, without a centrality requirement. -/
def gaussianRingHomEquiv (S : Type u) [Ring S] :
    (GaussianInt →+* S) ≃ {j : S // j ^ 2 = -1} where
  toFun φ := ⟨φ Zsqrtd.sqrtd, by
    rw [pow_two, ← map_mul, Zsqrtd.dmuld, map_intCast, Int.cast_neg, Int.cast_one]⟩
  invFun j := gaussianMap j.val j.property
  left_inv φ := Zsqrtd.hom_ext _ _ (gaussianMap_sqrtd _ _)
  right_inv j := Subtype.ext (gaussianMap_sqrtd _ _)

end
end Surreal.OrdinaryRingMaps
