import Mathlib.NumberTheory.Pell

/-!
# The ordinary Pell sequence generated by 3 + 2 sqrt(2)

The ordinary arithmetic in `odg:ex:pell2`. Use Mathlib's group of Pell
solutions and its fundamental-solution theorem to classify all solutions
by natural powers and independent coordinate signs.
-/

namespace Surreal.PellTwo

noncomputable section

/-- The fundamental ordinary Pell solution at D = 2. -/
def fundamental : Pell.Solution₁ 2 := Pell.Solution₁.mk 3 2 (by norm_num)

/-- There is no positive nontrivial solution with x less than 3. -/
theorem fundamental_isFundamental : Pell.IsFundamental fundamental := by
  refine ⟨by norm_num [fundamental], by norm_num [fundamental], ?_⟩
  intro b hb
  change 3 ≤ b.x
  by_contra hn
  have hx : b.x = 2 := by omega
  have he := b.prop
  rw [hx] at he
  omega

/-- The first coordinate of the kth ordinary power. -/
def X (k : ℕ) : ℤ := (fundamental ^ k).x

/-- The second coordinate of the kth ordinary power. -/
def Y (k : ℕ) : ℤ := (fundamental ^ k).y

/-- Every term of the sequence satisfies the ordinary Pell equation. -/
theorem equation (k : ℕ) : X k ^ 2 - 2 * Y k ^ 2 = 1 :=
  (fundamental ^ k).prop

/-- The native Pell-group powers are the manuscript's real powers of 3 + 2 sqrt(2). -/
theorem real_power (k : ℕ) :
    (X k : ℝ) + (Y k : ℝ) * Real.sqrt 2 = (3 + 2 * Real.sqrt 2) ^ k := by
  let r : {r : ℝ // r * r = (2 : ℤ)} :=
    ⟨Real.sqrt 2, by norm_num [← sq, Real.sq_sqrt]⟩
  let f : Zsqrtd 2 →+* ℝ := Zsqrtd.lift r
  have h := map_pow (f.toMonoidHom.comp (unitary (Zsqrtd 2)).subtype) fundamental k
  exact h

/-- Every native Pell solution has independently signed coordinates of a natural power. -/
theorem solution_coordinates (a : Pell.Solution₁ 2) :
    ∃ k : ℕ, (a.x = X k ∨ a.x = -X k) ∧ (a.y = Y k ∨ a.y = -Y k) := by
  obtain ⟨b, hbx, hby, hb⟩ := a.exists_pos_variant (by norm_num)
  obtain ⟨k, rfl⟩ := fundamental_isFundamental.eq_pow_of_nonneg hbx hby
  refine ⟨k, ?_⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
  rcases hb with rfl | rfl | rfl | rfl <;> simp [X, Y]

/-- Exact classification of the ordinary integer solutions, including every independent sign. -/
theorem integer_solutions_iff (x y : ℤ) :
    x ^ 2 - 2 * y ^ 2 = 1 ↔
      ∃ k : ℕ, (x = X k ∨ x = -X k) ∧ (y = Y k ∨ y = -Y k) := by
  constructor
  · intro h
    exact solution_coordinates (Pell.Solution₁.mk x y h)
  · rintro ⟨k, hx, hy⟩
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;>
      simpa only [neg_sq] using equation k

end
end Surreal.PellTwo
