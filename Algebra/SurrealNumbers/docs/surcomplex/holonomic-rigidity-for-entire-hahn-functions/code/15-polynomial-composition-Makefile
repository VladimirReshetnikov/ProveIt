.PHONY: all verify clean
all: article.pdf

article.pdf: article.tex
	pdflatex -interaction=nonstopmode -halt-on-error article.tex
	pdflatex -interaction=nonstopmode -halt-on-error article.tex
	pdflatex -interaction=nonstopmode -halt-on-error article.tex

verify:
	python verify.py --output verification.json

clean:
	rm -f article.aux article.log article.out article.toc
