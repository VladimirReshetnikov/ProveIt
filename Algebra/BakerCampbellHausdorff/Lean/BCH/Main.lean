/-
# The Baker–Campbell–Hausdorff formula (Theorem 1.1)

This file states the Baker–Campbell–Hausdorff formula itself, in the two forms
of Theorem 1.1 of the accompanying article (`docs/combined`, equations (1.1)
and (1.2)), assembling the results of the rest of the library. Nothing new is
proved here.

`Zₙ(X, Y)` is `BCH.bchHom 𝕂 X Y n`, the homogeneous component of total degree
`n` of `log(e^X e^Y)`, defined by the degree recursion of `BCH.Series` in any
`𝕂`-algebra, `𝕂 = ℝ` or `ℂ`.

* `bch_formula_formal`, the formal statement (1.2): in the free algebra
  `𝕂⟨X, Y⟩` each `Zₙ` is homogeneous of degree `n`, is a Lie polynomial, and
  equals `(1/n) ∑_{|w| = n} c(w) R(w)`, where `R(w)` is the right-nested
  bracket of the word `w` and `c(w)` is the coefficient of `w` in `Zₙ`, given
  by the finite word-cut sum. Together these say that `log(e^X e^Y)` is a Lie
  series with completely specified coefficients.
* `bch_formula`, the analytic statement (1.1): in a Banach algebra, for
  `‖X‖ + ‖Y‖ < log 2` the series `∑ₙ Zₙ(X, Y)` converges absolutely, its sum
  `Z` is the unique element of norm `< log 2` with `e^Z = e^X e^Y`, every `Zₙ`
  lies in every closed Lie subalgebra containing `X` and `Y`, and the first
  three terms are `X + Y`, `½⁅X, Y⁆`, `1/12⁅X, ⁅X, Y⁆⁆ + 1/12⁅Y, ⁅Y, X⁆⁆`.
-/
import BCH.LowDegree
import BCH.LieCoeff
import BCH.Unique
import BCH.Formal.Dynkin
import BCH.Formal.WordCut

open NormedSpace Finset

attribute [local instance 100] LieRing.ofAssociativeRing

namespace BCH

section Formal

variable {𝕂 : Type*} [RCLike 𝕂]

/-- **The Baker–Campbell–Hausdorff formula, formal form** (article Theorem 1.1, equation
(1.2)). In the free algebra `𝕂⟨X, Y⟩` the homogeneous component `Zₙ(X, Y)` of
`log(e^X e^Y)` of total degree `n ≥ 1`

* is homogeneous of degree `n`;
* is a Lie polynomial in `X` and `Y`, that is, lies in the Lie subalgebra generated by the
  two letters;
* equals `(1/n) ∑_w c(w) R(w)`, `R(w)` the right-nested bracket of the word `w` and `c(w)`
  the coefficient of `w` in `Zₙ` (Dynkin's formula);
* has those coefficients given by the finite word-cut sum over the cuts of `w` into blocks
  `X^{r₁}Y^{s₁} ⋯ X^{r_k}Y^{s_k}`, and `Zₙ = ∑_{|w| = n} c(w) w`.
-/
theorem bch_formula_formal {n : ℕ} (hn : 0 < n) :
    IsHomogeneous n (bchHom 𝕂 (genX 𝕂) (genY 𝕂) n) ∧
    bchHom 𝕂 (genX 𝕂) (genY 𝕂) n ∈ lieGen 𝕂 ∧
    bchHom 𝕂 (genX 𝕂) (genY 𝕂) n =
      (n : 𝕂)⁻¹ • (bchHom 𝕂 (genX 𝕂) (genY 𝕂) n).coeff.sum (fun w c => c • rb 𝕂 w) ∧
    (∀ w : FreeMonoid (Fin 2), (bchHom 𝕂 (genX 𝕂) (genY 𝕂) n).coeff w =
      if FreeMonoid.length w = n then wordCoeff 𝕂 w else 0) ∧
    (∀ w : FreeMonoid (Fin 2), wordCoeff 𝕂 w =
      ∑ k ∈ range (FreeMonoid.length w), ((-1 : 𝕂) ^ k * ((k + 1 : ℕ) : 𝕂)⁻¹) *
        ∑ rs ∈ (blockTuples (k + 1) (FreeMonoid.length w)).filter
          (fun rs => blockMonoid rs = w), blockWeight 𝕂 rs) :=
  ⟨bchHom_isHomogeneous genX_isHomogeneous genY_isHomogeneous n,
    bchHom_mem_lieGen n,
    bchHom_eq_dynkin hn,
    coeff_bchHom_eq_wordCoeff n,
    wordCoeff_eq⟩

end Formal

section Analytic

variable {𝕂 𝔸 : Type*} [RCLike 𝕂] [NormedRing 𝔸] [NormedAlgebra 𝕂 𝔸] [CompleteSpace 𝔸]

/-- **The Baker–Campbell–Hausdorff formula, analytic form** (article Theorem 1.1, equation
(1.1)). For `X, Y` in a Banach algebra over `ℝ` or `ℂ` with `‖X‖ + ‖Y‖ < log 2`:

* the series `∑ₙ Zₙ(X, Y)` converges absolutely;
* its sum `Z` satisfies `e^Z = e^X e^Y`;
* `Z` is the only element of norm `< log 2` with that property;
* every `Zₙ(X, Y)` lies in every closed Lie subalgebra of `𝔸` containing `X` and `Y`
  (a closed subspace closed under the commutator), so `Z` does too;
* `Z₁ = X + Y`, `Z₂ = ½⁅X, Y⁆`, `Z₃ = 1/12⁅X, ⁅X, Y⁆⁆ + 1/12⁅Y, ⁅Y, X⁆⁆`, as displayed
  in (1.1).
-/
theorem bch_formula {X Y : 𝔸} (hs : ‖X‖ + ‖Y‖ < Real.log 2) :
    (Summable fun n => ‖bchHom 𝕂 X Y n‖) ∧
    exp (∑' n, bchHom 𝕂 X Y n) = exp X * exp Y ∧
    (∀ Z₀ : 𝔸, ‖Z₀‖ < Real.log 2 →
      (exp Z₀ = exp X * exp Y ↔ Z₀ = ∑' n, bchHom 𝕂 X Y n)) ∧
    (∀ 𝔤 : Submodule 𝕂 𝔸, IsClosedLieSubalgebra 𝔤 → X ∈ 𝔤 → Y ∈ 𝔤 →
      (∀ n, bchHom 𝕂 X Y n ∈ 𝔤) ∧ (∑' n, bchHom 𝕂 X Y n) ∈ 𝔤) ∧
    bchHom 𝕂 X Y 1 = X + Y ∧
    bchHom 𝕂 X Y 2 = (2 : 𝕂)⁻¹ • ⁅X, Y⁆ ∧
    bchHom 𝕂 X Y 3 = (12 : 𝕂)⁻¹ • ⁅X, ⁅X, Y⁆⁆ + (12 : 𝕂)⁻¹ • ⁅Y, ⁅Y, X⁆⁆ := by
  refine ⟨summable_norm_bchHom hs, exp_tsum_bchHom hs,
    fun Z₀ hZ => exp_eq_iff_eq_tsum_bchHom hs hZ, fun 𝔤 h𝔤 hX hY => ⟨fun n => ?_, ?_⟩,
    bchHom_one X Y, bchHom_two_lie X Y, bchHom_three_lie X Y⟩
  · exact bchHom_mem h𝔤 hX hY n
  · exact h𝔤.isClosed.mem_of_tendsto (summable_norm_bchHom (𝕂 := 𝕂) hs).of_norm.hasSum
      (Filter.Eventually.of_forall fun s =>
        Submodule.sum_mem _ fun n _ => bchHom_mem h𝔤 hX hY n)

end Analytic

end BCH
