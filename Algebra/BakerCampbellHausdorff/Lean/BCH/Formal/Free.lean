/-
# The free algebra on two generators and its grading

This file sets up the formal side of the BCH theorem (Sections 2 and 3 of the
accompanying article, `docs/combined`): the free associative algebra
`𝕂⟨X, Y⟩` is modelled as the monoid algebra of the free monoid on two letters,
`FreeTwo 𝕂 = MonoidAlgebra 𝕂 (FreeMonoid (Fin 2))`, with generators `genX`,
`genY`. Words of length `n` span the homogeneous component of degree `n`.

* `IsHomogeneous n a`: `a` is supported on words of length `n`; closed under
  sums, scalars, and products (degrees add).
* `proj n`: the linear projection onto the degree-`n` component.
* `bchHom_isHomogeneous`: the formal component `Zₙ(X, Y) = bchHom 𝕂 genX genY n`
  is homogeneous of degree `n`.
* `proj_mem_lieSpan`: the Lie subalgebra `lieGen 𝕂` generated by `X, Y` (the
  Lie polynomials) is graded: the degree-`n` component of a Lie polynomial is
  a Lie polynomial.
-/
import BCH.Series
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.Algebra.FreeMonoid.Basic
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Algebra.Lie.Subalgebra

open Finset

attribute [local instance 100] LieRing.ofAssociativeRing

namespace BCH

section Free

variable (𝕂 : Type*) [Field 𝕂]

/-- The free associative algebra `𝕂⟨X, Y⟩` on two generators, as a monoid algebra. -/
abbrev FreeTwo := MonoidAlgebra 𝕂 (FreeMonoid (Fin 2))

/-- The generator `X`. -/
noncomputable def genX : FreeTwo 𝕂 := MonoidAlgebra.single (FreeMonoid.of 0) 1

/-- The generator `Y`. -/
noncomputable def genY : FreeTwo 𝕂 := MonoidAlgebra.single (FreeMonoid.of 1) 1

variable {𝕂}

/-- `a` is homogeneous of degree `n`: supported on words of length `n`. -/
def IsHomogeneous (n : ℕ) (a : FreeTwo 𝕂) : Prop :=
  ∀ w ∈ a.coeff.support, FreeMonoid.length w = n

namespace IsHomogeneous

lemma zero (n : ℕ) : IsHomogeneous n (0 : FreeTwo 𝕂) := by
  intro w hw
  simp at hw

lemma add {n : ℕ} {a b : FreeTwo 𝕂} (ha : IsHomogeneous n a) (hb : IsHomogeneous n b) :
    IsHomogeneous n (a + b) := by
  classical
  intro w hw
  rw [MonoidAlgebra.coeff_add] at hw
  rcases Finset.mem_union.mp (Finsupp.support_add hw) with h | h
  · exact ha w h
  · exact hb w h

lemma smul {n : ℕ} {a : FreeTwo 𝕂} (c : 𝕂) (ha : IsHomogeneous n a) :
    IsHomogeneous n (c • a) := by
  intro w hw
  rw [MonoidAlgebra.coeff_smul] at hw
  exact ha w (Finsupp.support_smul hw)

lemma sum {n : ℕ} {ι : Type*} (s : Finset ι) {f : ι → FreeTwo 𝕂}
    (h : ∀ i ∈ s, IsHomogeneous n (f i)) : IsHomogeneous n (∑ i ∈ s, f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using zero n
  | insert i s hi ih =>
    rw [Finset.sum_insert hi]
    exact (h i (Finset.mem_insert_self i s)).add
      (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

lemma mul {p q : ℕ} {a b : FreeTwo 𝕂} (ha : IsHomogeneous p a) (hb : IsHomogeneous q b) :
    IsHomogeneous (p + q) (a * b) := by
  classical
  intro w hw
  have hne := Finsupp.mem_support_iff.mp hw
  rw [MonoidAlgebra.coeff_mul] at hne
  simp only [Finsupp.sum] at hne
  obtain ⟨u, hu, hne1⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
  obtain ⟨v, hv, hne2⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne1
  have huv : u * v = w := by
    by_contra h
    exact hne2 (if_neg h)
  rw [← huv, FreeMonoid.length_mul, ha u hu, hb v hv]

lemma single (w : FreeMonoid (Fin 2)) (c : 𝕂) :
    IsHomogeneous (FreeMonoid.length w) (MonoidAlgebra.single w c : FreeTwo 𝕂) := by
  intro v hv
  rw [MonoidAlgebra.coeff_single] at hv
  rw [Finset.mem_singleton.mp (Finsupp.support_single_subset hv)]

lemma one : IsHomogeneous 0 (1 : FreeTwo 𝕂) := by
  have := single (𝕂 := 𝕂) (1 : FreeMonoid (Fin 2)) 1
  rwa [FreeMonoid.length_one, ← MonoidAlgebra.one_def] at this

lemma pow {p : ℕ} {a : FreeTwo 𝕂} (ha : IsHomogeneous p a) :
    ∀ r : ℕ, IsHomogeneous (r * p) (a ^ r)
  | 0 => by simpa using one
  | r + 1 => by
    have := (pow ha r).mul ha
    rw [pow_succ]
    convert this using 1
    ring

lemma of_eq {m n : ℕ} {a : FreeTwo 𝕂} (ha : IsHomogeneous m a) (h : m = n) :
    IsHomogeneous n a := h ▸ ha

end IsHomogeneous

lemma genX_isHomogeneous : IsHomogeneous 1 (genX 𝕂) := by
  have := IsHomogeneous.single (𝕂 := 𝕂) (FreeMonoid.of 0) 1
  rwa [FreeMonoid.length_of] at this

lemma genY_isHomogeneous : IsHomogeneous 1 (genY 𝕂) := by
  have := IsHomogeneous.single (𝕂 := 𝕂) (FreeMonoid.of 1) 1
  rwa [FreeMonoid.length_of] at this

/-! ### Homogeneity of the BCH components -/

section Components

variable {X Y : FreeTwo 𝕂} (hX : IsHomogeneous 1 X) (hY : IsHomogeneous 1 Y)
include hX hY

lemma expBlock_isHomogeneous (d : ℕ) : IsHomogeneous d (expBlock 𝕂 X Y d) := by
  unfold expBlock
  refine IsHomogeneous.sum _ fun p hp => ?_
  rw [Finset.mem_antidiagonal] at hp
  refine IsHomogeneous.smul _ ?_
  have := (hX.pow p.1).mul (hY.pow p.2)
  refine this.of_eq ?_
  rw [mul_one, mul_one, hp]

lemma uBlock_isHomogeneous (d : ℕ) : IsHomogeneous d (uBlock 𝕂 X Y d) := by
  unfold uBlock
  split_ifs
  · exact IsHomogeneous.zero d
  · exact expBlock_isHomogeneous hX hY d

lemma powBlock_isHomogeneous : ∀ k n : ℕ, IsHomogeneous n (powBlock 𝕂 X Y k n)
  | 0, n => by
    rw [powBlock_zero]
    split_ifs with h
    · subst h; exact IsHomogeneous.one
    · exact IsHomogeneous.zero n
  | k + 1, n => by
    rw [powBlock_succ]
    refine IsHomogeneous.sum _ fun p hp => ?_
    rw [Finset.mem_antidiagonal] at hp
    exact ((uBlock_isHomogeneous hX hY p.1).mul (powBlock_isHomogeneous k p.2)).of_eq hp

/-- The formal component `Zₙ(X, Y)` is homogeneous of degree `n`. -/
theorem bchHom_isHomogeneous (n : ℕ) : IsHomogeneous n (bchHom 𝕂 X Y n) := by
  unfold bchHom
  exact IsHomogeneous.sum _ fun k _ =>
    IsHomogeneous.smul _ (powBlock_isHomogeneous hX hY (k + 1) n)

end Components

/-! ### The degree projections -/

/-- The projection onto the homogeneous component of degree `n`. -/
noncomputable def proj (n : ℕ) : FreeTwo 𝕂 →ₗ[𝕂] FreeTwo 𝕂 where
  toFun a := MonoidAlgebra.ofCoeff (Finsupp.filter (fun w => FreeMonoid.length w = n) a.coeff)
  map_add' a b := by
    apply MonoidAlgebra.coeff_injective
    simp only [MonoidAlgebra.coeff_add, Finsupp.filter_add]
  map_smul' c a := by
    apply MonoidAlgebra.coeff_injective
    simp only [MonoidAlgebra.coeff_smul, Finsupp.filter_smul, RingHom.id_apply]

lemma proj_coeff (n : ℕ) (a : FreeTwo 𝕂) (w : FreeMonoid (Fin 2)) :
    (proj n a).coeff w = if FreeMonoid.length w = n then a.coeff w else 0 := rfl

lemma proj_isHomogeneous (n : ℕ) (a : FreeTwo 𝕂) : IsHomogeneous n (proj n a) := by
  intro w hw
  have := Finsupp.mem_support_iff.mp hw
  rw [proj_coeff] at this
  by_contra h
  exact this (if_neg h)

lemma proj_of_isHomogeneous {n : ℕ} {a : FreeTwo 𝕂} (ha : IsHomogeneous n a) :
    proj n a = a := by
  apply MonoidAlgebra.coeff_injective
  ext w
  rw [proj_coeff]
  split_ifs with h
  · rfl
  · by_contra h'
    exact h (ha w (Finsupp.mem_support_iff.mpr (Ne.symm h')))

lemma proj_of_isHomogeneous_ne {m n : ℕ} {a : FreeTwo 𝕂} (ha : IsHomogeneous m a) (h : m ≠ n) :
    proj n a = 0 := by
  apply MonoidAlgebra.coeff_injective
  ext w
  rw [proj_coeff]
  split_ifs with hw
  · by_contra h'
    exact h ((ha w (Finsupp.mem_support_iff.mpr h')).symm.trans hw)
  · rfl

/-- `a` is the sum of its homogeneous components of degrees `≤ N` when it is supported on
words of length `≤ N`. -/
lemma sum_proj_eq {a : FreeTwo 𝕂} {N : ℕ}
    (hN : ∀ w ∈ a.coeff.support, FreeMonoid.length w ≤ N) :
    ∑ p ∈ range (N + 1), proj p a = a := by
  apply MonoidAlgebra.coeff_injective
  ext w
  rw [MonoidAlgebra.coeff_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
  simp only [proj_coeff]
  rw [Finset.sum_ite_eq (range (N + 1)) (FreeMonoid.length w) (fun _ => a.coeff w)]
  split_ifs with h
  · rfl
  · by_contra h'
    exact h (Finset.mem_range_succ_iff.mpr
      (hN w (Finsupp.mem_support_iff.mpr (Ne.symm h'))))

/-- Every element is supported in bounded degree. -/
lemma exists_bound (a : FreeTwo 𝕂) : ∃ N, ∀ w ∈ a.coeff.support, FreeMonoid.length w ≤ N :=
  ⟨a.coeff.support.sup FreeMonoid.length, fun _ hw => Finset.le_sup hw⟩

/-- The projection of a product of two elements onto degree `n`. -/
lemma proj_mul {a b : FreeTwo 𝕂} {N M : ℕ}
    (hN : ∀ w ∈ a.coeff.support, FreeMonoid.length w ≤ N)
    (hM : ∀ w ∈ b.coeff.support, FreeMonoid.length w ≤ M) (n : ℕ) :
    proj n (a * b) = ∑ p ∈ range (N + 1), ∑ q ∈ range (M + 1),
      if p + q = n then proj p a * proj q b else 0 := by
  conv_lhs => rw [← sum_proj_eq hN, ← sum_proj_eq hM]
  rw [Finset.sum_mul_sum, map_sum]
  refine sum_congr rfl fun p _ => ?_
  rw [map_sum]
  refine sum_congr rfl fun q _ => ?_
  have h := (proj_isHomogeneous p a).mul (proj_isHomogeneous q b)
  split_ifs with hpq
  · exact proj_of_isHomogeneous (h.of_eq hpq)
  · exact proj_of_isHomogeneous_ne h hpq

/-- The projection of a commutator onto degree `n`. -/
lemma proj_lie (x y : FreeTwo 𝕂) (n : ℕ) :
    ∃ N M : ℕ, proj n ⁅x, y⁆ = ∑ p ∈ range (N + 1), ∑ q ∈ range (M + 1),
      if p + q = n then ⁅proj p x, proj q y⁆ else 0 := by
  obtain ⟨N, hN⟩ := exists_bound x
  obtain ⟨M, hM⟩ := exists_bound y
  refine ⟨N, M, ?_⟩
  have h2 := proj_mul hM hN n
  rw [Finset.sum_comm] at h2
  rw [Ring.lie_def, map_sub, proj_mul hN hM, h2, ← Finset.sum_sub_distrib]
  refine sum_congr rfl fun p _ => ?_
  rw [← Finset.sum_sub_distrib]
  refine sum_congr rfl fun q _ => ?_
  by_cases h : p + q = n
  · rw [if_pos h, if_pos (by rw [add_comm]; exact h), if_pos h, Ring.lie_def]
  · rw [if_neg h, if_neg (by rw [add_comm]; exact h), if_neg h, sub_zero]

/-! ### The Lie subalgebra generated by the generators is graded -/

/-- The Lie subalgebra of `𝕂⟨X, Y⟩` generated by `X` and `Y` (the Lie polynomials). -/
noncomputable abbrev lieGen (𝕂 : Type*) [Field 𝕂] : LieSubalgebra 𝕂 (FreeTwo 𝕂) :=
  LieSubalgebra.lieSpan 𝕂 (FreeTwo 𝕂) {genX 𝕂, genY 𝕂}

lemma genX_mem_lieGen : genX 𝕂 ∈ lieGen 𝕂 :=
  LieSubalgebra.subset_lieSpan (Set.mem_insert _ _)

lemma genY_mem_lieGen : genY 𝕂 ∈ lieGen 𝕂 :=
  LieSubalgebra.subset_lieSpan (Set.mem_insert_of_mem _ (Set.mem_singleton _))

lemma proj_mem_of_isHomogeneous {m : ℕ} {a : FreeTwo 𝕂} (ha : IsHomogeneous m a)
    (hmem : a ∈ lieGen 𝕂) (n : ℕ) : proj n a ∈ lieGen 𝕂 := by
  by_cases h : m = n
  · subst h; rwa [proj_of_isHomogeneous ha]
  · rw [proj_of_isHomogeneous_ne ha h]; exact (lieGen 𝕂).zero_mem

lemma sum_mem_lieGen {ι : Type*} (s : Finset ι) {f : ι → FreeTwo 𝕂}
    (h : ∀ i ∈ s, f i ∈ lieGen 𝕂) : ∑ i ∈ s, f i ∈ lieGen 𝕂 := by
  rw [← LieSubalgebra.mem_toSubmodule]
  exact (lieGen 𝕂).toSubmodule.sum_mem fun i hi =>
    (LieSubalgebra.mem_toSubmodule _).mpr (h i hi)

/-- **The Lie polynomials are graded**: every homogeneous component of a Lie polynomial is a
Lie polynomial. -/
theorem proj_mem_lieSpan {a : FreeTwo 𝕂} (ha : a ∈ lieGen 𝕂) (n : ℕ) :
    proj n a ∈ lieGen 𝕂 := by
  induction ha using LieSubalgebra.lieSpan_induction generalizing n with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact proj_mem_of_isHomogeneous genX_isHomogeneous genX_mem_lieGen n
    · exact proj_mem_of_isHomogeneous genY_isHomogeneous genY_mem_lieGen n
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact (lieGen 𝕂).add_mem (hx n) (hy n)
  | smul c x _ hx => rw [map_smul]; exact (lieGen 𝕂).smul_mem c (hx n)
  | lie x y _ _ hx hy =>
    obtain ⟨N, M, key⟩ := proj_lie x y n
    rw [key]
    refine sum_mem_lieGen _ fun p _ => sum_mem_lieGen _ fun q _ => ?_
    split_ifs
    · exact (lieGen 𝕂).lie_mem (hx p) (hy q)
    · exact (lieGen 𝕂).zero_mem

end Free

end BCH
