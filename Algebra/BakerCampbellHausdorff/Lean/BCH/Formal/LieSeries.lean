/-
# The formal Baker–Campbell–Hausdorff theorem: every `Zₙ` is a Lie polynomial

This file proves Theorem 3.6 of the accompanying article (`docs/combined`), the
formal BCH theorem: every homogeneous component `Zₙ(X, Y)` of
`log(e^X e^Y)` in the free algebra `𝕂⟨X, Y⟩` is a Lie polynomial, i.e. lies in
the Lie subalgebra generated by `X` and `Y` (`bchHom_mem_lieGen`).

## Method

Instead of the Hopf-algebraic argument of the article (Friedrichs' criterion
and the Poincaré–Birkhoff–Witt theorem), the proof uses the analytic
Lie-series property of `BCH.LieCoeff`: in the finite-dimensional Banach algebra
of operators on the space of words of length `≤ n`, the image of the Lie
polynomials is a closed Lie subalgebra containing the images of `X` and `Y`,
hence it contains the image of `Zₙ(X, Y)`. So `Zₙ(X, Y) - L` lies in the kernel
of the truncated representation for some Lie polynomial `L`; the kernel has no
components in degrees `≤ n` and `Zₙ` is homogeneous of degree `n`, so
`Zₙ(X, Y)` equals the degree-`n` component of `L`, which is a Lie polynomial
because the Lie polynomials are graded (`BCH.Formal.Free`).
-/
import BCH.Formal.Trunc

open Finset

attribute [local instance 100] LieRing.ofAssociativeRing

namespace BCH

variable {𝕂 : Type*} [RCLike 𝕂]

/-- **Theorem 3.6 (formal BCH theorem)**: every homogeneous component `Zₙ(X, Y)` of the BCH
series `log(e^X e^Y)` in the free algebra `𝕂⟨X, Y⟩` is a Lie polynomial in `X` and `Y`. -/
theorem bchHom_mem_lieGen (n : ℕ) : bchHom 𝕂 (genX 𝕂) (genY 𝕂) n ∈ lieGen 𝕂 := by
  set ρ := rho 𝕂 n with hρ
  -- the image of the Lie polynomials is a closed Lie subalgebra of the operator algebra
  let 𝔤 : LieSubalgebra 𝕂 (V 𝕂 n →L[𝕂] V 𝕂 n) := (lieGen 𝕂).map ρ.toLieHom
  have h𝔤 : IsClosedLieSubalgebra 𝔤.toSubmodule :=
    ⟨Submodule.closed_of_finiteDimensional _,
      fun a ha b hb => (LieSubalgebra.mem_toSubmodule _).mpr
        (𝔤.lie_mem ((LieSubalgebra.mem_toSubmodule _).mp ha)
          ((LieSubalgebra.mem_toSubmodule _).mp hb))⟩
  have hx : ρ (genX 𝕂) ∈ 𝔤.toSubmodule :=
    (LieSubalgebra.mem_toSubmodule _).mpr ((LieSubalgebra.mem_map _ _ _).mpr ⟨_, genX_mem_lieGen, rfl⟩)
  have hy : ρ (genY 𝕂) ∈ 𝔤.toSubmodule :=
    (LieSubalgebra.mem_toSubmodule _).mpr ((LieSubalgebra.mem_map _ _ _).mpr ⟨_, genY_mem_lieGen, rfl⟩)
  have hmem := bchHom_mem h𝔤 hx hy n
  rw [← map_bchHom, LieSubalgebra.mem_toSubmodule, LieSubalgebra.mem_map] at hmem
  obtain ⟨L, hL, hρL⟩ := hmem
  rw [AlgHom.toLieHom_apply] at hρL
  -- `Zₙ - L` lies in the kernel of `ρ`
  have hker : ρ (bchHom 𝕂 (genX 𝕂) (genY 𝕂) n - L) = 0 := by
    rw [map_sub, ← hρL, sub_self]
  have hproj := proj_eq_zero_of_rho_eq_zero 𝕂 n hker (le_refl n)
  rw [map_sub, proj_of_isHomogeneous (bchHom_isHomogeneous genX_isHomogeneous genY_isHomogeneous n),
    sub_eq_zero] at hproj
  rw [hproj]
  exact proj_mem_lieSpan hL n

end BCH
