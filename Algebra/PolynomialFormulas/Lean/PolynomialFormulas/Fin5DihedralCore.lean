import PolynomialFormulas.QuinticX5Add20XAdd32DihedralFinite

/-!
# Minimal `C₅`/`D₅` interface in `S₅`

This module exposes the small dihedral interface needed by the Section 5
exact-stabilizer and low-degree arguments.  The executable ten-element model
and its cardinality come from
`QuinticX5Add20XAdd32DihedralFinite`; no transitive-subgroup classification is
imported here.
-/

namespace LeanProofs.PolynomialFormulas.Fin5DihedralCore

open Equiv Subgroup

/- Lean 4.32 has no `namespace X := Long.Namespace` alias syntax.  Re-export
only the committed finite-model declarations used below. -/
namespace Finite
export LeanProofs.PolynomialFormulas.QuinticX5Add20XAdd32Dihedral.Classification
  (S5 d5Elements fiveCycle mem_standardD5_iff natCard_standardD5 reflection
    standardD5)
end Finite

abbrev S5 := Finite.S5
abbrev fiveCycle : S5 := Finite.fiveCycle
abbrev reflection : S5 := Finite.reflection
abbrev standardC5 : Subgroup S5 := Fin5Solvable.standardC5
abbrev standardD5 : Subgroup S5 := Finite.standardD5
abbrev c5Elements : Finset S5 := Fin5TransitiveC5.c5Elements
abbrev d5Elements : Finset S5 := Finite.d5Elements

theorem mem_c5Elements_iff (g : S5) :
    g ∈ c5Elements ↔ g ∈ standardC5 :=
  Fin5TransitiveC5.mem_c5Elements_iff g

@[simp] theorem mem_standardD5_iff (g : S5) :
    g ∈ standardD5 ↔ g ∈ d5Elements :=
  Finite.mem_standardD5_iff g

theorem fiveCycle_mem_standardC5 : fiveCycle ∈ standardC5 :=
  Subgroup.mem_zpowers fiveCycle

theorem fiveCycle_mem_standardD5 : fiveCycle ∈ standardD5 := by
  rw [mem_standardD5_iff]
  decide

theorem reflection_mem_standardD5 : reflection ∈ standardD5 := by
  rw [mem_standardD5_iff]
  decide

/-- The executable ten-element subgroup is generated by the standard
rotation and reflection. -/
theorem standardD5_eq_closure :
    standardD5 = Subgroup.closure ({fiveCycle, reflection} : Set S5) := by
  apply le_antisymm
  · intro g hg
    obtain ⟨ab, _, hab⟩ := Finset.mem_image.mp
      ((mem_standardD5_iff g).mp hg)
    rw [← hab]
    change fiveCycle ^ (ab.1 : ℕ) * reflection ^ (ab.2 : ℕ) ∈
      Subgroup.closure ({fiveCycle, reflection} : Set S5)
    exact Subgroup.mul_mem _
      (Subgroup.pow_mem _
        (Subgroup.subset_closure (by simp)) _)
      (Subgroup.pow_mem _
        (Subgroup.subset_closure (by simp)) _)
  · rw [Subgroup.closure_le]
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨fiveCycle_mem_standardD5, reflection_mem_standardD5⟩

theorem standardC5_le_standardD5 : standardC5 ≤ standardD5 := by
  change Subgroup.zpowers fiveCycle ≤ standardD5
  exact Subgroup.zpowers_le.mpr fiveCycle_mem_standardD5

theorem natCard_standardD5 : Nat.card standardD5 = 10 :=
  Finite.natCard_standardD5

theorem natCard_S5 : Nat.card S5 = 120 := by
  rw [show Nat.card S5 = Fintype.card S5 by
    exact Nat.card_eq_fintype_card]
  norm_num [S5, Fintype.card_perm]

end LeanProofs.PolynomialFormulas.Fin5DihedralCore
