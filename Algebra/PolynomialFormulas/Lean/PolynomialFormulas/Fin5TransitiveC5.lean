import PolynomialFormulas.Fin5Solvable
import Mathlib.GroupTheory.PGroup

/-!
# Transitive subgroups of `S₅` contain a regular `C₅`

This module supplies the elementary group-theoretic input used by quintic
resolvent arguments. Orbit--stabilizer and Cauchy's theorem show that every
transitive subgroup of `Perm (Fin 5)` contains an element of order five.
Conjugacy of five-cycles then identifies the subgroup it generates with a
conjugate of the standard regular `C₅`.

For computations on `S₅ / F₂₀`, the module also gives six explicit left-coset
representatives

`1, (0 1 2), (0 2 1), (0 1), (1 2), (0 2)`

and proves that they are exhaustive and distinct. The action of the standard
five-cycle on their cosets is recorded by the table `[0, 5, 3, 4, 1, 2]`.
The finite calculations use kernel reduction with `decide`, without native-code
evaluation.
-/

namespace LeanProofs.PolynomialFormulas.Fin5TransitiveC5

open Equiv MulAction Subgroup
open Fin5Solvable
open scoped IsMulCommutative

/-- Orbit--stabilizer forces five to divide the order of a transitive subgroup
of `S₅`. -/
theorem five_dvd_natCard_of_pretransitive (H : Subgroup S5)
    [MulAction.IsPretransitive H (Fin 5)] : 5 ∣ Nat.card H := by
  classical
  letI := Fintype.ofFinite H
  letI := Fintype.ofFinite (MulAction.orbit H (0 : Fin 5))
  have hcard :=
    MulAction.card_orbit_mul_card_stabilizer_eq_card_group H (0 : Fin 5)
  have hcard' : Nat.card (MulAction.orbit H (0 : Fin 5)) *
      Nat.card (MulAction.stabilizer H (0 : Fin 5)) = Nat.card H := by
    simpa only [Nat.card_eq_fintype_card] using hcard
  have horbit : MulAction.orbit H (0 : Fin 5) = Set.univ :=
    MulAction.orbit_eq_univ (M := H) (0 : Fin 5)
  have horbitCard : Nat.card (MulAction.orbit H (0 : Fin 5)) = 5 := by
    rw [horbit]
    simp
  rw [horbitCard] at hcard'
  refine ⟨Nat.card (MulAction.stabilizer H (0 : Fin 5)), ?_⟩
  exact hcard'.symm

/-- Cauchy's theorem produces an element of order five in every transitive
subgroup of `S₅`. -/
theorem exists_orderOf_five_of_pretransitive (H : Subgroup S5)
    [MulAction.IsPretransitive H (Fin 5)] : ∃ a : H, orderOf a = 5 := by
  letI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  exact exists_prime_orderOf_dvd_card' 5 (five_dvd_natCard_of_pretransitive H)

/-- Every transitive subgroup of `S₅` contains a conjugate of the standard
regular subgroup generated by `(0 1 2 3 4)`. -/
theorem exists_map_conj_standardC5_le_of_pretransitive (H : Subgroup S5)
    [MulAction.IsPretransitive H (Fin 5)] :
    ∃ g : S5, standardC5.map (MulAut.conj g).toMonoidHom ≤ H := by
  obtain ⟨a, ha⟩ := exists_orderOf_five_of_pretransitive H
  have haOrder : orderOf (a : S5) = 5 := (Subgroup.orderOf_coe a).trans ha
  have haCycle : (a : S5).IsCycle :=
    Equiv.Perm.isCycle_of_prime_order'' (by norm_num) haOrder
  have hcycleType : fiveCycle.cycleType = (a : S5).cycleType := by
    rw [isCycle_fiveCycle.cycleType, haCycle.cycleType,
      ← isCycle_fiveCycle.orderOf, ← haCycle.orderOf,
      orderOf_fiveCycle, haOrder]
  obtain ⟨g, hg⟩ :=
    isConj_iff.mp (Equiv.Perm.isConj_iff_cycleType_eq.mpr hcycleType)
  refine ⟨g, ?_⟩
  rw [standardC5, MonoidHom.map_zpowers]
  change Subgroup.zpowers (g * fiveCycle * g⁻¹) ≤ H
  rw [hg]
  exact Subgroup.zpowers_le.mpr a.property

section Representatives

/-- The left-coset space `S₅ / F₂₀`. -/
abbrev Cosets := S5 ⧸ standardF20

/-- The three-cycle `(0 1 2)` in the multiplication convention used by
`Equiv.Perm`. -/
def threeCycle : S5 := Equiv.swap 0 1 * Equiv.swap 1 2

/-- Six explicit representatives for the left cosets of `standardF20`. -/
def representative : Fin 6 → S5 :=
  ![1, threeCycle, threeCycle⁻¹,
    Equiv.swap 0 1, Equiv.swap 1 2, Equiv.swap 0 2]

/-- A computable enumeration of the elements of `standardC5`. -/
def c5Elements : Finset S5 :=
  (Finset.range 5).image (fiveCycle ^ ·)

theorem mem_c5Elements_iff (g : S5) :
    g ∈ c5Elements ↔ g ∈ standardC5 := by
  rw [standardC5,
    (isOfFinOrder_of_finite fiveCycle).mem_zpowers_iff_mem_range_orderOf,
    orderOf_fiveCycle]
  rfl

/-- Computable membership in the normalizer of `standardC5`. -/
def normalizesC5B (g : S5) : Bool :=
  decide (∀ h : S5, h ∈ c5Elements → g * h * g⁻¹ ∈ c5Elements)

theorem normalizesC5B_eq_true (g : S5) :
    normalizesC5B g = true ↔ g ∈ standardF20 := by
  simp only [normalizesC5B, decide_eq_true_eq]
  rw [standardF20]
  constructor
  · intro hg
    apply Subgroup.mem_normalizer_fintype
    intro h hh
    change g * h * g⁻¹ ∈ standardC5
    rw [← mem_c5Elements_iff]
    exact hg h ((mem_c5Elements_iff h).mpr hh)
  · intro hg h hh
    rw [mem_c5Elements_iff] at hh ⊢
    exact (Subgroup.mem_normalizer_iff.mp hg h).mp hh

/-- A computable enumeration of `standardF20`. -/
def f20Elements : Finset S5 :=
  Finset.univ.filter (normalizesC5B ·)

theorem mem_f20Elements_iff (g : S5) :
    g ∈ f20Elements ↔ g ∈ standardF20 := by
  simp only [f20Elements, Finset.mem_filter, Finset.mem_univ, true_and]
  exact normalizesC5B_eq_true g

set_option maxRecDepth 100000 in
theorem card_f20Elements : f20Elements.card = 20 := by
  decide

noncomputable def standardF20EquivElements :
    standardF20 ≃ {g : S5 // g ∈ f20Elements} where
  toFun g := ⟨g.1, (mem_f20Elements_iff g.1).mpr g.2⟩
  invFun g := ⟨g.1, (mem_f20Elements_iff g.1).mp g.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem natCard_standardF20 : Nat.card standardF20 = 20 := by
  rw [Nat.card_congr standardF20EquivElements]
  simpa only [Nat.card_pos, Nat.card_pos_iff, Fintype.card_coe,
    Nat.card_eq_fintype_card] using card_f20Elements

theorem natCard_cosets : Nat.card Cosets = 6 := by
  have hcard := Subgroup.card_eq_card_quotient_mul_card_subgroup standardF20
  have hS5 : Nat.card S5 = 120 := by
    rw [show Nat.card S5 = Fintype.card S5 by exact Nat.card_eq_fintype_card]
    norm_num [S5, Fintype.card_perm]
  rw [hS5, natCard_standardF20] at hcard
  apply Nat.mul_right_cancel (by norm_num : 0 < 20)
  calc
    Nat.card Cosets * 20 = 120 := hcard.symm
    _ = 6 * 20 := by norm_num

/-- The standard Frobenius subgroup `F₂₀` is solvable. -/
theorem standardF20_isSolvable : IsSolvable standardF20 := by
  let N : Subgroup standardF20 := standardC5.subgroupOf standardF20
  letI : N.Normal := by
    change (standardC5.subgroupOf (Subgroup.normalizer standardC5)).Normal
    infer_instance
  have hNcard : Nat.card N = 5 := by
    calc
      Nat.card N = Nat.card standardC5 :=
        Nat.card_congr
          (Subgroup.subgroupOfEquivOfLe Subgroup.le_normalizer).toEquiv
      _ = 5 := natCard_standardC5
  letI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  letI : IsCyclic N := isCyclic_of_prime_card hNcard
  letI : IsSolvable N := isSolvable_of_comm fun a b ↦ mul_comm a b
  have hQcard : Nat.card (standardF20 ⧸ N) = 4 := by
    have hcard := Subgroup.card_eq_card_quotient_mul_card_subgroup N
    rw [natCard_standardF20, hNcard] at hcard
    omega
  letI : Fact (Nat.Prime 2) := ⟨by norm_num⟩
  letI : IsMulCommutative (standardF20 ⧸ N) :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) (by
      simpa using hQcard)
  letI : IsSolvable (standardF20 ⧸ N) :=
    isSolvable_of_comm fun a b ↦ mul_comm a b
  exact solvable_of_ker_le_range N.subtype (QuotientGroup.mk' N) (by
    rw [QuotientGroup.ker_mk', N.range_subtype])

/-- Boolean equality test for the left cosets represented by `g` and `h`. -/
def sameCosetB (g h : S5) : Bool := normalizesC5B (g⁻¹ * h)

theorem sameCosetB_eq_true (g h : S5) :
    sameCosetB g h = true ↔ (g : Cosets) = (h : Cosets) := by
  rw [sameCosetB, normalizesC5B_eq_true]
  constructor
  · exact fun hmem ↦ Quotient.sound' (QuotientGroup.leftRel_apply.mpr hmem)
  · exact fun heq ↦ QuotientGroup.leftRel_apply.mp (Quotient.exact' heq)

set_option maxRecDepth 100000 in
theorem representative_injectiveB :
    ∀ i j : Fin 6,
      sameCosetB (representative i) (representative j) = true → i = j := by
  decide

/-- The six displayed representatives determine distinct cosets. -/
theorem representative_cosets_injective : Function.Injective
    (fun i : Fin 6 ↦ (representative i : Cosets)) := by
  intro i j hij
  exact representative_injectiveB i j ((sameCosetB_eq_true _ _).mpr hij)

/-- Every left coset of `standardF20` has one of the six displayed
representatives. -/
theorem representative_cosets_exhaustive (g : S5) :
    ∃ i : Fin 6, (g : Cosets) = (representative i : Cosets) := by
  letI : Fintype Cosets := Fintype.ofFinite _
  have hcard : Fintype.card (Fin 6) = Fintype.card Cosets := by
    rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, natCard_cosets]
  have hbij : Function.Bijective
      (fun i : Fin 6 ↦ (representative i : Cosets)) :=
    (Fintype.bijective_iff_injective_and_card _).mpr
      ⟨representative_cosets_injective, hcard⟩
  obtain ⟨i, hi⟩ := hbij.surjective (g : Cosets)
  exact ⟨i, hi.symm⟩

/-- Index action of the standard five-cycle on the six displayed cosets. -/
def fiveCycleOnRepresentatives : Fin 6 → Fin 6 := ![0, 5, 3, 4, 1, 2]

set_option maxRecDepth 100000 in
theorem fiveCycle_representative_tableB (i : Fin 6) :
    sameCosetB (fiveCycle * representative i)
      (representative (fiveCycleOnRepresentatives i)) = true := by
  fin_cases i <;> decide

/-- The standard five-cycle acts on the six representative cosets according
to `fiveCycleOnRepresentatives`. -/
theorem fiveCycle_smul_representative_coset (i : Fin 6) :
    fiveCycle • (representative i : Cosets) =
      (representative (fiveCycleOnRepresentatives i) : Cosets) := by
  exact (sameCosetB_eq_true _ _).mp (fiveCycle_representative_tableB i)

end Representatives

/-- For a transitive subgroup of `S₅`, solvability is equivalent to lying in
a conjugate of the Frobenius subgroup `F₂₀`.  The forward implication is the
classification in `Fin5Solvable`; the reverse implication uses solvability of
`F₂₀` and permanence under isomorphisms and subgroups. -/
theorem solvable_iff_le_conjugate_standardF20 (H : Subgroup S5)
    [MulAction.IsPretransitive H (Fin 5)] :
    IsSolvable H ↔
      ∃ g : S5, H ≤ standardF20.map (MulAut.conj g).toMonoidHom := by
  constructor
  · intro h
    letI : IsSolvable H := h
    exact solvable_transitive_le_map_conj_standardF20 H
  · rintro ⟨g, hg⟩
    letI : IsSolvable standardF20 := standardF20_isSolvable
    let e : standardF20 ≃*
        standardF20.map (MulAut.conj g).toMonoidHom :=
      (MulAut.conj g).subgroupMap standardF20
    letI : IsSolvable
        (standardF20.map (MulAut.conj g).toMonoidHom) :=
      solvable_of_solvable_injective (f := e.symm.toMonoidHom) e.symm.injective
    exact solvable_of_solvable_injective
      (f := Subgroup.inclusion hg) (Subgroup.inclusion_injective hg)

end LeanProofs.PolynomialFormulas.Fin5TransitiveC5
