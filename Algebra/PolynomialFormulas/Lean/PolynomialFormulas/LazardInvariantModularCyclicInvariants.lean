/-!
# The orbit-sum spaces are the actual homogeneous C6 invariants

The action and the degree-seven enumeration are kept in dependency-first
modules so that the large executable certificates are checked once.  This
file supplies the remaining low-degree partition certificates and the
uniform semantic reconstruction theorem for all degrees at most seven.

The result identifies the span of the canonical cyclic orbit sums with the
homogeneous subspace fixed by the concrete six-cycle.  All computations in
this file use ordinary kernel reduction.
-/

namespace LeanProofs.PolynomialFormulas.LazardInvariantModularCyclicInvariants

open scoped BigOperators
open Finset MvPolynomial
open LazardInvariantModule
open LazardInvariantModularCounterexample
open LazardInvariantModularOrbitCoordinates
open LazardInvariantModularProductBridge

set_option autoImplicit false

noncomputable section

/-! ## Order and cardinality of the concrete cyclic group -/

/-- The displayed generator is an honest six-cycle. -/
theorem cycleSixGeneratorPermutation_orderOf :
    orderOf cycleSixGeneratorPermutation = 6 := by
  rw [orderOf_eq_iff (by omega)]
  constructor
  · ext i
    fin_cases i <;> rfl
  · intro m hm hpos
    have hm_lower : 1 ≤ m := hpos
    have hm_upper : m ≤ 5 := by omega
    interval_cases m <;> decide

/-- A concrete finite enumeration of the subgroup, obtained from the
finiteness of the ambient permutation group. -/
noncomputable instance cyclicSixFintype : Fintype cyclicSix :=
  Fintype.ofFinite cyclicSix

/-- The subgroup generated by the displayed six-cycle has six elements. -/
theorem cyclicSix_card : Fintype.card cyclicSix = 6 := by
  rw [← Nat.card_eq_fintype_card, cyclicSix, Nat.card_zpowers,
    cycleSixGeneratorPermutation_orderOf]

/-! ## Semantic orbit partitions and representative degrees -/

/-- The base-eight encoding is injective when all six digits are smaller
than eight. -/
theorem exponentCode_injective_of_lt_eight {a b : Exponent}
    (ha : ∀ i, a i < 8) (hb : ∀ i, b i < 8)
    (h : exponentCode a = exponentCode b) : a = b := by
  have ha0 := ha 0
  have ha1 := ha 1
  have ha2 := ha 2
  have ha3 := ha 3
  have ha4 := ha 4
  have ha5 := ha 5
  have hb0 := hb 0
  have hb1 := hb 1
  have hb2 := hb 2
  have hb3 := hb 3
  have hb4 := hb 4
  have hb5 := hb 5
  simp [exponentCode, Fin.sum_univ_succ] at h
  funext i
  fin_cases i
  · change a 0 = b 0
    omega
  · change a 1 = b 1
    omega
  · change a 2 = b 2
    omega
  · change a 3 = b 3
    omega
  · change a 4 = b 4
    omega
  · change a 5 = b 5
    omega

theorem exponentCode_exponentMin_le_left (a b : Exponent) :
    exponentCode (exponentMin a b) ≤ exponentCode a := by
  simp only [exponentMin]
  split <;> omega

theorem exponentCode_exponentMin_le_right (a b : Exponent) :
    exponentCode (exponentMin a b) ≤ exponentCode b := by
  simp only [exponentMin]
  split <;> omega

theorem exponentCode_foldl_exponentMin_le_initial
    (l : List Exponent) (a : Exponent) :
    exponentCode (l.foldl exponentMin a) ≤ exponentCode a := by
  induction l generalizing a with
  | nil => rfl
  | cons b l ih =>
      exact (ih (exponentMin a b)).trans
        (exponentCode_exponentMin_le_left a b)

theorem exponentCode_foldl_exponentMin_le_of_mem
    (l : List Exponent) (a b : Exponent) (hb : b ∈ l) :
    exponentCode (l.foldl exponentMin a) ≤ exponentCode b := by
  induction l generalizing a with
  | nil => simp at hb
  | cons c l ih =>
      simp only [List.mem_cons] at hb
      rcases hb with rfl | hb
      · exact (exponentCode_foldl_exponentMin_le_initial l
          (exponentMin a b)).trans
            (exponentCode_exponentMin_le_right a b)
      · exact ih (exponentMin a c) hb

theorem exponentCode_canonicalExponent_le_of_mem
    (a b : Exponent) (hb : b ∈ cyclicOrbitSupport a) :
    exponentCode (canonicalExponent a) ≤ exponentCode b := by
  apply exponentCode_foldl_exponentMin_le_of_mem
  simpa [cyclicOrbitSupport] using hb

/-- A six-entry list is recovered without loss by `exponentOfList`. -/
theorem sum_exponentOfList_of_length_six (values : List ℕ)
    (hvalues : values.length = 6) :
    ∑ i : Fin 6, exponentOfList values i = values.sum := by
  cases values with
  | nil => simp at hvalues
  | cons v0 t0 =>
      cases t0 with
      | nil => simp at hvalues
      | cons v1 t1 =>
          cases t1 with
          | nil => simp at hvalues
          | cons v2 t2 =>
              cases t2 with
              | nil => simp at hvalues
              | cons v3 t3 =>
                  cases t3 with
                  | nil => simp at hvalues
                  | cons v4 t4 =>
                      cases t4 with
                      | nil => simp at hvalues
                      | cons v5 t5 =>
                          cases t5 with
                          | nil =>
                              simp [exponentOfList, Fin.sum_univ_succ]
                          | cons v6 t6 => simp at hvalues

theorem sum_eq_of_mem_degreeExponents {d : ℕ} {a : Exponent}
    (ha : a ∈ degreeExponents d) :
    ∑ i : Fin 6, a i = d := by
  simp only [degreeExponents, List.mem_map] at ha
  rcases ha with ⟨values, hvalues, rfl⟩
  have hsemantics := (mem_weakCompositions_iff 6 d values).mp hvalues
  rw [sum_exponentOfList_of_length_six values hsemantics.1,
    hsemantics.2]

theorem sum_eq_of_mem_cyclicOrbitSupport_raw (a b : Exponent)
    (hb : b ∈ cyclicOrbitSupport a) :
    ∑ i : Fin 6, b i = ∑ i : Fin 6, a i := by
  simp only [cyclicOrbitSupport, List.mem_toFinset, cyclicOrbit,
    List.mem_eraseDups, List.mem_map] at hb
  rcases hb with ⟨k, hk, rfl⟩
  exact sum_rotateExponent_of_lt_six a k (List.mem_range.mp hk)

theorem orbitRepresentative_eq_canonical {d : ℕ}
    (r : OrbitRepresentative d) :
    ∃ a ∈ degreeExponents d, r.1 = canonicalExponent a := by
  have hr : r.1 ∈ orbitRepresentatives d := by
    simpa only [List.mem_toFinset] using r.2
  simp only [orbitRepresentatives, List.mem_eraseDups, List.mem_map] at hr
  rcases hr with ⟨a, ha, hcanonical⟩
  exact ⟨a, ha, hcanonical.symm⟩

/-- Every canonical representative has the total degree advertised by its
list.  This proof is semantic and works in every degree. -/
theorem orbitRepresentative_sum_semantic {d : ℕ}
    (r : OrbitRepresentative d) :
    ∑ i : Fin 6, r.1 i = d := by
  rcases orbitRepresentative_eq_canonical r with ⟨a, ha, hra⟩
  calc
    ∑ i : Fin 6, r.1 i = ∑ i : Fin 6, canonicalExponent a i := by
      rw [hra]
    _ = ∑ i : Fin 6, a i :=
      sum_eq_of_mem_cyclicOrbitSupport_raw a (canonicalExponent a)
        (canonicalExponent_mem_cyclicOrbitSupport a)
    _ = d := sum_eq_of_mem_degreeExponents ha

theorem orbitRepresentative_code_le_of_mem {d : ℕ}
    (r : OrbitRepresentative d) (b : Exponent)
    (hb : b ∈ cyclicOrbitSupport r.1) :
    exponentCode r.1 ≤ exponentCode b := by
  rcases orbitRepresentative_eq_canonical r with ⟨a, _ha, hra⟩
  have hrmem : r.1 ∈ cyclicOrbitSupport a := by
    rw [hra]
    exact canonicalExponent_mem_cyclicOrbitSupport a
  rw [hra]
  exact exponentCode_canonicalExponent_le_of_mem a b
    (mem_cyclicOrbitSupport_trans hrmem hb)

theorem coordinate_lt_eight_of_sum {a : Exponent} {d : ℕ}
    (hsum : ∑ i : Fin 6, a i = d) (hd : d < 8) (i : Fin 6) :
    a i < 8 := by
  simp [Fin.sum_univ_succ] at hsum
  fin_cases i
  · change a 0 < 8
    omega
  · change a 1 < 8
    omega
  · change a 2 < 8
    omega
  · change a 3 < 8
    omega
  · change a 4 < 8
    omega
  · change a 5 < 8
    omega

/-- Distinct canonical representatives of degree at most seven have
disjoint cyclic orbits. -/
theorem orbitRepresentative_mem_orbit_iff (d : Fin 8)
    (r s : OrbitRepresentative d.1) :
    s.1 ∈ cyclicOrbitSupport r.1 ↔ r = s := by
  constructor
  · intro hrs
    apply Subtype.ext
    apply exponentCode_injective_of_lt_eight
    · exact coordinate_lt_eight_of_sum
        (orbitRepresentative_sum_semantic r) d.isLt
    · exact coordinate_lt_eight_of_sum
        (orbitRepresentative_sum_semantic s) d.isLt
    · apply Nat.le_antisymm
      · exact orbitRepresentative_code_le_of_mem r s.1 hrs
      · exact orbitRepresentative_code_le_of_mem s r.1
          (mem_cyclicOrbitSupport_symm hrs)
  · rintro rfl
    exact self_mem_cyclicOrbitSupport r.1

/-- Every explicit degree-`d` exponent, for `d ≤ 7`, lies in exactly one
canonical orbit. -/
theorem uniqueOrbitRepresentative (d : Fin 8)
    (a : ExplicitDegreeExponent d.1) :
    ∃! r : OrbitRepresentative d.1,
      a.1 ∈ cyclicOrbitSupport r.1 := by
  let c : OrbitRepresentative d.1 :=
    ⟨canonicalExponent a.1,
      canonicalExponent_mem_orbitRepresentatives d.1 a.1 a.2⟩
  have hcanonical : c.1 ∈ cyclicOrbitSupport a.1 :=
    canonicalExponent_mem_cyclicOrbitSupport a.1
  have ha : a.1 ∈ cyclicOrbitSupport c.1 :=
    mem_cyclicOrbitSupport_symm hcanonical
  refine ⟨c, ha, ?_⟩
  intro r hr
  apply (orbitRepresentative_mem_orbit_iff d r c).mp
  exact mem_cyclicOrbitSupport_trans hr hcanonical

theorem uniqueOrbitRepresentative_zero :
    ∀ a : ExplicitDegreeExponent 0,
      ∃! r : OrbitRepresentative 0,
        a.1 ∈ cyclicOrbitSupport r.1 :=
  fun a : ExplicitDegreeExponent 0 =>
    uniqueOrbitRepresentative (0 : Fin 8) a

theorem uniqueOrbitRepresentative_one :
    ∀ a : ExplicitDegreeExponent 1,
      ∃! r : OrbitRepresentative 1,
        a.1 ∈ cyclicOrbitSupport r.1 :=
  fun a : ExplicitDegreeExponent 1 =>
    uniqueOrbitRepresentative (1 : Fin 8) a

theorem uniqueOrbitRepresentative_two :
    ∀ a : ExplicitDegreeExponent 2,
      ∃! r : OrbitRepresentative 2,
        a.1 ∈ cyclicOrbitSupport r.1 :=
  fun a : ExplicitDegreeExponent 2 =>
    uniqueOrbitRepresentative (2 : Fin 8) a

theorem uniqueOrbitRepresentative_three :
    ∀ a : ExplicitDegreeExponent 3,
      ∃! r : OrbitRepresentative 3,
        a.1 ∈ cyclicOrbitSupport r.1 :=
  fun a : ExplicitDegreeExponent 3 =>
    uniqueOrbitRepresentative (3 : Fin 8) a

theorem uniqueOrbitRepresentative_four :
    ∀ a : ExplicitDegreeExponent 4,
      ∃! r : OrbitRepresentative 4,
        a.1 ∈ cyclicOrbitSupport r.1 :=
  fun a : ExplicitDegreeExponent 4 =>
    uniqueOrbitRepresentative (4 : Fin 8) a

theorem uniqueOrbitRepresentative_five :
    ∀ a : ExplicitDegreeExponent 5,
      ∃! r : OrbitRepresentative 5,
        a.1 ∈ cyclicOrbitSupport r.1 :=
  fun a : ExplicitDegreeExponent 5 =>
    uniqueOrbitRepresentative (5 : Fin 8) a

theorem uniqueOrbitRepresentative_six :
    ∀ a : ExplicitDegreeExponent 6,
      ∃! r : OrbitRepresentative 6,
        a.1 ∈ cyclicOrbitSupport r.1 :=
  fun a : ExplicitDegreeExponent 6 =>
    uniqueOrbitRepresentative (6 : Fin 8) a

theorem orbitRepresentative_sum_zero (r : OrbitRepresentative 0) :
    ∑ i : Fin 6, r.1 i = 0 := orbitRepresentative_sum_semantic r

theorem orbitRepresentative_sum_one (r : OrbitRepresentative 1) :
    ∑ i : Fin 6, r.1 i = 1 := orbitRepresentative_sum_semantic r

theorem orbitRepresentative_sum_two (r : OrbitRepresentative 2) :
    ∑ i : Fin 6, r.1 i = 2 := orbitRepresentative_sum_semantic r

theorem orbitRepresentative_sum_three (r : OrbitRepresentative 3) :
    ∑ i : Fin 6, r.1 i = 3 := orbitRepresentative_sum_semantic r

theorem orbitRepresentative_sum_four (r : OrbitRepresentative 4) :
    ∑ i : Fin 6, r.1 i = 4 := orbitRepresentative_sum_semantic r

theorem orbitRepresentative_sum_five (r : OrbitRepresentative 5) :
    ∑ i : Fin 6, r.1 i = 5 := orbitRepresentative_sum_semantic r

theorem orbitRepresentative_sum_six (r : OrbitRepresentative 6) :
    ∑ i : Fin 6, r.1 i = 6 := orbitRepresentative_sum_semantic r

theorem orbitRepresentative_sum (d : Fin 8)
    (r : OrbitRepresentative d.1) :
    ∑ i : Fin 6, r.1 i = d.1 := orbitRepresentative_sum_semantic r

/-- Every exponent in the orbit of a degree-`d` representative still has
degree `d`. -/
theorem sum_eq_of_mem_cyclicOrbitSupport (d : Fin 8)
    (r : OrbitRepresentative d.1) (a : Exponent)
    (ha : a ∈ cyclicOrbitSupport r.1) :
    ∑ i : Fin 6, a i = d.1 := by
  simp only [cyclicOrbitSupport, List.mem_toFinset, cyclicOrbit,
    List.mem_eraseDups, List.mem_map] at ha
  rcases ha with ⟨k, hk, rfl⟩
  rw [sum_rotateExponent_of_lt_six r.1 k (List.mem_range.mp hk),
    orbitRepresentative_sum d r]

/-! ## Homogeneity and fixedness of the orbit sums -/

theorem cyclicOrbitPolynomial_isHomogeneous (d : Fin 8)
    (r : OrbitRepresentative d.1) :
    (cyclicOrbitPolynomial r.1).IsHomogeneous d.1 := by
  apply IsHomogeneous.sum
  intro a ha
  apply MvPolynomial.isHomogeneous_monomial
  rw [Finsupp.degree_eq_sum]
  simpa using sum_eq_of_mem_cyclicOrbitSupport d r a ha

theorem cyclicOrbitPolynomial_fixed (d : Fin 8)
    (r : OrbitRepresentative d.1) :
    cycleSixRenameLinear (cyclicOrbitPolynomial r.1) =
      cyclicOrbitPolynomial r.1 :=
  cyclicOrbitPolynomial_fixed_general r.1

/-! ## Reconstruction and equality with the actual fixed subspace -/

/-- Degree-`d` homogeneous polynomials fixed by the explicit generator. -/
def cyclicFixedHomogeneousSubspace (d : ℕ) :
    Submodule F3 (MvPolynomial (Fin 6) F3) :=
  MvPolynomial.homogeneousSubmodule (Fin 6) F3 d ⊓
    cycleSixRenameLinear.fixedSubmodule

/-- This fixed-subspace definition is exactly the degree-`d` part of the
actual `cyclicSix` invariant subalgebra. -/
theorem mem_cyclicFixedHomogeneousSubspace_iff (d : ℕ)
    (p : MvPolynomial (Fin 6) F3) :
    p ∈ cyclicFixedHomogeneousSubspace d ↔
      p.IsHomogeneous d ∧
        p ∈ invariantSubalgebra F3 (Fin 6) cyclicSix := by
  rw [cyclicFixedHomogeneousSubspace, Submodule.mem_inf,
    LinearMap.mem_fixedSubmodule_iff,
    mem_cyclicSix_invariantSubalgebra_iff]
  rfl

/-- Reconstruct a homogeneous invariant from its coefficients at the
canonical orbit representatives. -/
def orbitReconstruction (d : ℕ) (p : MvPolynomial (Fin 6) F3) :
    MvPolynomial (Fin 6) F3 :=
  ∑ r : OrbitRepresentative d,
    p.coeff (Finsupp.equivFunOnFinite.symm r.1) •
      cyclicOrbitPolynomial r.1

/-- Coefficientwise reconstruction of every fixed homogeneous polynomial in
degrees at most seven. -/
theorem orbitReconstruction_eq (d : Fin 8)
    (p : MvPolynomial (Fin 6) F3)
    (hhomogeneous : p.IsHomogeneous d.1)
    (hfixed : cycleSixRenameLinear p = p) :
    orbitReconstruction d.1 p = p := by
  apply MvPolynomial.ext
  intro m
  by_cases hm : m.degree = d.1
  · let a : ExplicitDegreeExponent d.1 :=
      ⟨Finsupp.equivFunOnFinite m,
        exponentFunction_mem_degreeExponents d m hm⟩
    rcases uniqueOrbitRepresentative d a with ⟨r, hr, hunique⟩
    have horbit_iff (q : OrbitRepresentative d.1) :
        Finsupp.equivFunOnFinite m ∈ cyclicOrbitSupport q.1 ↔ q = r := by
      constructor
      · exact hunique q
      · intro hqr
        simpa [hqr] using hr
    have hcoefficient :
        p.coeff m = p.coeff (Finsupp.equivFunOnFinite.symm r.1) := by
      simpa using coeff_eq_of_mem_cyclicOrbitSupport p hfixed r.1
        (Finsupp.equivFunOnFinite m) hr
    have horbitCoefficient (q : OrbitRepresentative d.1) :
        (cyclicOrbitPolynomial q.1).coeff m =
          if Finsupp.equivFunOnFinite m ∈ cyclicOrbitSupport q.1
          then 1 else 0 := by
      simpa using coeff_cyclicOrbitPolynomial q.1
        (Finsupp.equivFunOnFinite m)
    simp [orbitReconstruction, MvPolynomial.coeff_sum,
      horbitCoefficient,
      horbit_iff, hcoefficient, eq_comm]
  · have hcoefficient : p.coeff m = 0 :=
      hhomogeneous.coeff_eq_zero hm
    have hnotOrbit (r : OrbitRepresentative d.1) :
        Finsupp.equivFunOnFinite m ∉ cyclicOrbitSupport r.1 := by
      intro hmem
      apply hm
      rw [Finsupp.degree_eq_sum]
      simpa using sum_eq_of_mem_cyclicOrbitSupport d r
        (Finsupp.equivFunOnFinite m) hmem
    have horbitCoefficient (q : OrbitRepresentative d.1) :
        (cyclicOrbitPolynomial q.1).coeff m =
          if Finsupp.equivFunOnFinite m ∈ cyclicOrbitSupport q.1
          then 1 else 0 := by
      simpa using coeff_cyclicOrbitPolynomial q.1
        (Finsupp.equivFunOnFinite m)
    simp [orbitReconstruction, MvPolynomial.coeff_sum,
      horbitCoefficient,
      hnotOrbit, hcoefficient]

/-- In every degree `d ≤ 7`, the explicit orbit-sum span is precisely the
actual homogeneous fixed subspace for the concrete regular `C6` action. -/
theorem cyclicOrbitSumSubspace_eq_cyclicFixedHomogeneousSubspace
    (d : Fin 8) :
    cyclicOrbitSumSubspace d.1 = cyclicFixedHomogeneousSubspace d.1 := by
  apply le_antisymm
  · rw [cyclicOrbitSumSubspace]
    apply Submodule.span_le.mpr
    rintro _ ⟨r, rfl⟩
    exact ⟨cyclicOrbitPolynomial_isHomogeneous d r,
      LinearMap.mem_fixedSubmodule_iff.mpr
        (cyclicOrbitPolynomial_fixed d r)⟩
  · intro p hp
    have hreconstruct := orbitReconstruction_eq d p hp.1
      (LinearMap.mem_fixedSubmodule_iff.mp hp.2)
    rw [← hreconstruct]
    apply Submodule.sum_mem
    intro r _
    exact Submodule.smul_mem _ _
      (Submodule.subset_span (Set.mem_range_self r))

end

