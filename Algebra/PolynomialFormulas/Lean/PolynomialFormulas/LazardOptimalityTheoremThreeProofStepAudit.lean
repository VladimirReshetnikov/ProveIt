import Mathlib.Tactic.NormNum
import PolynomialFormulas.LazardOptimalityTheoremThreeFormulaBridge

/-!
# Line-by-line audit of the prime-exponent step in Lazard's Theorem 3

The proof printed after Theorem 3 uses the following invalid implication:

* `5 ∣ [K(z) : K]`;
* `z ^ p ∈ K` for a prime `p`;
* therefore `p = 5` and `K(z) = K(⁵√y) = K(x)`.

The honest consequence of the power-membership hypothesis is only the upper
bound `[K(z) : K] ≤ p`.  The concrete choice `z = ζ₁₁` gives a literal
counterexample: `z ^ 11 = 1`, `ℚ(z)` has degree ten, and it contains the
degree-five real cyclotomic field generated by `z + z⁻¹`.

The last part also audits the next displayed equality after adjoining a
primitive fifth root.  In the common `55`th-cyclotomic ambient field,
`ℚ(ζ₁₁, ζ₅)` is the whole degree-forty ambient field, while
`ℚ(ζ₁₁ + ζ₁₁⁻¹, ζ₅)` has degree twenty.
-/

namespace LeanProofs.PolynomialFormulas.LazardOptimalityTheoremThreeProofStepAudit

open IntermediateField
open LeanProofs.PolynomialFormulas.LazardQuintic
open LeanProofs.PolynomialFormulas.LazardOptimalityCyclotomicCounterexample
open LeanProofs.PolynomialFormulas.LazardOptimalityCyclicQuinticCounterexample
open LeanProofs.PolynomialFormulas.LazardOptimalityTheoremThreeCounterexample

set_option autoImplicit false

/- `Ambient` is the `55`th cyclotomic field.  The constructor for its
cyclotomic-extension instance needs the conductor to be nonzero in the
base field; the corresponding instances in the source counterexample are
intentionally local to that file, so the audit records them again here. -/
local instance conductor_neZero : NeZero (55 : ℚ) := ⟨by norm_num⟩

noncomputable local instance ambient_isCyclotomicExtension :
    IsCyclotomicExtension {55} ℚ Ambient :=
  CyclotomicField.isCyclotomicExtension 55 ℚ

/-! ## The corrected generic degree bound -/

/-- If `z ^ p` belongs to an intermediate field `K`, then adjoining `z` to
`K` has degree at most `p`.  Primality is included to match the paper's
simple-radical-step hypothesis; the proof uses only its positivity.

This is the precise conclusion supplied by the displayed power equation.  It
does not say that the adjoining degree equals, or divides, `p`. -/
theorem finrank_adjoin_le_prime_exponent_of_pow_mem
    {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (K : IntermediateField F Ω) {z : Ω} {p : ℕ}
    (hp : p.Prime) (hzp : z ^ p ∈ K) :
    Module.finrank K K⟮z⟯ ≤ p := by
  let y : K := ⟨z ^ p, hzp⟩
  exact finrank_adjoin_simple_le_of_pow_eq K Ω p hp.pos
    (x := z) (a := y) rfl

/-! ## The literal prime-eleven witness -/

/-- The chosen primitive eleventh root has its eleventh power in the rational
base field of the common ambient extension. -/
theorem zeta11_pow_eleven_mem_rationalBase :
    zeta11 ^ 11 ∈ (⊥ : IntermediateField ℚ Ambient) := by
  rw [zeta11_isPrimitiveRoot.pow_eq_one]
  exact one_mem _

/-- The exact numerical counterexample to the prime-exponent inference in
the printed proof: the radical exponent is the prime `11`, the adjoining
degree is `10` and hence is divisible by `5`, but `11 ≠ 5`. -/
theorem theoremThree_primeExponent_inference_counterexample :
    Nat.Prime 11 ∧
      zeta11 ^ 11 ∈ (⊥ : IntermediateField ℚ Ambient) ∧
      Module.finrank ℚ ElevenField = 10 ∧
      5 ∣ Module.finrank ℚ ElevenField ∧
      11 ≠ 5 := by
  refine ⟨by norm_num, zeta11_pow_eleven_mem_rationalBase,
    elevenField_finrank, ?_, by norm_num⟩
  rw [elevenField_finrank]
  norm_num

/-! ## Failure of `K(z) = K(x)` -/

/-- The literal real-cyclotomic field `ℚ(ζ₁₁ + ζ₁₁⁻¹)` inside the common
ambient field. -/
noncomputable def RealElevenField : IntermediateField ℚ Ambient :=
  ℚ⟮zeta11 + zeta11⁻¹⟯

/-- The existing cyclic-quintic generator is the displayed real-cyclotomic
generator after embedding it into the common ambient field. -/
theorem cyclicQuinticRootAmbient_eq_realGenerator :
    cyclicQuinticRootAmbient = zeta11 + zeta11⁻¹ := by
  simp [cyclicQuinticRootAmbient, cyclicQuinticRoot,
    zeta11InElevenField]

theorem realElevenField_eq_cyclicQuinticField :
    RealElevenField = CyclicQuinticField := by
  simp only [RealElevenField, CyclicQuinticField,
    cyclicQuinticRootAmbient_eq_realGenerator]

theorem realElevenField_finrank :
    Module.finrank ℚ RealElevenField = 5 := by
  rw [realElevenField_eq_cyclicQuinticField, cyclicQuinticField_finrank]

/-- The first disputed intermediate-field equality fails literally:
`ℚ(ζ₁₁)` has degree ten, whereas
`ℚ(ζ₁₁ + ζ₁₁⁻¹)` has degree five. -/
theorem elevenField_ne_realElevenField :
    ElevenField ≠ RealElevenField := by
  intro h
  have hdim := congrArg
    (fun L : IntermediateField ℚ Ambient => Module.finrank ℚ L) h
  rw [elevenField_finrank, realElevenField_finrank] at hdim
  norm_num at hdim

/-- More directly, the degree-ten field `ℚ(ζ₁₁)` cannot be generated by any
single fifth radical over `ℚ`: such a simple adjunction has degree at most
five.  This refutes `K(z) = K(⁵√y)` independently of the particular fifth
root notation used in the paper. -/
theorem elevenField_ne_adjoin_fifthRadical
    {r : Ambient} {y : ℚ}
    (hr : r ^ 5 = algebraMap ℚ Ambient y) :
    ElevenField ≠ ℚ⟮r⟯ := by
  intro fields_eq
  have hle : Module.finrank ℚ ℚ⟮r⟯ ≤ 5 :=
    finrank_adjoin_simple_le_of_pow_eq ℚ Ambient 5 (by norm_num) hr
  rw [← fields_eq, elevenField_finrank] at hle
  norm_num at hle

/-! ## Failure after adjoining the primitive fifth root -/

/-- The left side of the paper's next displayed equality,
`ℚ(ζ₅, ζ₁₁)`. -/
noncomputable def ElevenFifthCompositum : IntermediateField ℚ Ambient :=
  ElevenField ⊔ FifthCyclotomicField

/-- Bezout at the exponents `5` and `11`: the two displayed roots recover
the chosen primitive `55`th root because `5 * 9 + 11 = 55 + 1`. -/
theorem zeta11_pow_nine_mul_zeta5 :
    zeta11 ^ 9 * zeta5 = zeta55 := by
  calc
    zeta11 ^ 9 * zeta5 =
        zeta55 ^ (5 * 9) * zeta55 ^ 11 := by
      simp only [zeta11, zeta5, ← pow_mul]
    _ = zeta55 ^ (5 * 9 + 11) := (pow_add zeta55 (5 * 9) 11).symm
    _ = zeta55 ^ (55 + 1) := by norm_num
    _ = zeta55 ^ 55 * zeta55 ^ 1 := pow_add zeta55 55 1
    _ = zeta55 := by
      rw [zeta55_isPrimitiveRoot.pow_eq_one, pow_one, one_mul]

theorem zeta55_mem_elevenFifthCompositum :
    zeta55 ∈ ElevenFifthCompositum := by
  have hz11 : zeta11 ∈ ElevenFifthCompositum := by
    change zeta11 ∈ ElevenField ⊔ FifthCyclotomicField
    exact (le_sup_left : ElevenField ≤
      ElevenField ⊔ FifthCyclotomicField)
        (mem_adjoin_simple_self ℚ zeta11)
  have hz5 : zeta5 ∈ ElevenFifthCompositum := by
    change zeta5 ∈ ElevenField ⊔ FifthCyclotomicField
    exact (le_sup_right : FifthCyclotomicField ≤
      ElevenField ⊔ FifthCyclotomicField)
        (mem_adjoin_simple_self ℚ zeta5)
  rw [← zeta11_pow_nine_mul_zeta5]
  exact ElevenFifthCompositum.mul_mem
    (pow_mem hz11 9) hz5

/-- Adjoining `ζ₁₁` and `ζ₅` recovers the entire `55`th-cyclotomic ambient
field. -/
theorem elevenFifthCompositum_eq_top :
    ElevenFifthCompositum = (⊤ : IntermediateField ℚ Ambient) := by
  have hgen : ℚ⟮zeta55⟯ = (⊤ : IntermediateField ℚ Ambient) :=
    IntermediateField.adjoin_eq_top_of_algebra ℚ ({zeta55} : Set Ambient)
      (IsCyclotomicExtension.adjoin_primitive_root_eq_top
        zeta55_isPrimitiveRoot)
  apply top_unique
  rw [← hgen, adjoin_simple_le_iff]
  exact zeta55_mem_elevenFifthCompositum

theorem elevenFifthCompositum_finrank :
    Module.finrank ℚ ElevenFifthCompositum = 40 := by
  rw [elevenFifthCompositum_eq_top]
  rw [IntermediateField.finrank_top']
  rw [IsCyclotomicExtension.finrank Ambient
    (Polynomial.cyclotomic.irreducible_rat (by norm_num : 0 < 55))]
  rw [show 55 = 5 * 11 by norm_num,
    Nat.totient_mul (by norm_num : Nat.Coprime 5 11),
    Nat.totient_prime (by norm_num : Nat.Prime 5),
    Nat.totient_prime (by norm_num : Nat.Prime 11)]

/-- The second disputed equality also fails literally:
`ℚ(ζ₅, ζ₁₁)` has degree forty, while
`ℚ(ζ₅, ζ₁₁ + ζ₁₁⁻¹)` has degree twenty. -/
theorem elevenFifthCompositum_ne_cyclicQuinticCompositum :
    ElevenFifthCompositum ≠
      CyclicQuinticField ⊔ FifthCyclotomicField := by
  intro h
  have hdim := congrArg
    (fun L : IntermediateField ℚ Ambient => Module.finrank ℚ L) h
  rw [elevenFifthCompositum_finrank,
    cyclicQuinticCompositum_finrank] at hdim
  norm_num at hdim

/-! ## Failure of the final all-roots equality -/

/-- The field generated by the full ambient root set of the concrete cyclic
quintic. -/
noncomputable def CyclicQuinticAllRootsField :
    IntermediateField ℚ Ambient :=
  IntermediateField.adjoin ℚ (cyclicQuinticQ.rootSet Ambient)

theorem cyclicQuinticAllRootsField_le_elevenField :
    CyclicQuinticAllRootsField ≤ ElevenField := by
  rw [CyclicQuinticAllRootsField, IntermediateField.adjoin_le_iff]
  exact cyclicQuinticQ_rootSet_subset_elevenField

theorem zeta5_not_mem_cyclicQuinticAllRootsField :
    zeta5 ∉ CyclicQuinticAllRootsField := by
  intro hzeta5
  exact zeta5_not_mem_elevenField
    (cyclicQuinticAllRootsField_le_elevenField hzeta5)

/-- The last field display in the paper fails in the same example.  The left
side `ℚ(ζ₅, x)` contains `ζ₅`; the field generated by all five roots is
contained in `ℚ(ζ₁₁)` and therefore does not. -/
theorem cyclicQuinticCompositum_ne_allRootsField :
    CyclicQuinticField ⊔ FifthCyclotomicField ≠
      CyclicQuinticAllRootsField := by
  intro fields_eq
  apply zeta5_not_mem_cyclicQuinticAllRootsField
  rw [← fields_eq]
  exact (le_sup_right : FifthCyclotomicField ≤
    CyclicQuinticField ⊔ FifthCyclotomicField)
      (mem_adjoin_simple_self ℚ zeta5)

end LeanProofs.PolynomialFormulas.LazardOptimalityTheoremThreeProofStepAudit
