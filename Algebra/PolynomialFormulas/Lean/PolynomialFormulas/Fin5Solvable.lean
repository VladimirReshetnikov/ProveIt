import Mathlib.GroupTheory.GroupAction.Primitive
import Mathlib.GroupTheory.GroupAction.Quotient
import Mathlib.GroupTheory.Perm.Cycle.Type
import Mathlib.GroupTheory.Perm.Fin
import Mathlib.GroupTheory.Perm.Subgroup
import Mathlib.GroupTheory.Solvable
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.Tactic

/-!
# Solvable transitive subgroups of `S₅`

This module proves the finite-group classification needed on the group-theoretic
side of solvable-quintic criteria: every solvable subgroup of `Perm (Fin 5)`
whose natural action is transitive lies in a conjugate of the normalizer of a
standard regular subgroup of order five.

The result is purely about finite permutation groups. In particular, this
module neither associates a permutation subgroup to a polynomial nor proves a
resolvent criterion, a Galois-theoretic equivalence, or an expressibility-in-
radicals theorem. Those bridges require separate algebraic developments.
-/

namespace LeanProofs.PolynomialFormulas.Fin5Solvable

open Equiv MulAction Subgroup
open scoped IsMulCommutative

abbrev S5 := Equiv.Perm (Fin 5)

/-- The standard cycle `(0 1 2 3 4)`. -/
def fiveCycle : S5 := finRotate 5

/-- The standard regular subgroup of order five. -/
def standardC5 : Subgroup S5 := Subgroup.zpowers fiveCycle

/-- The Frobenius subgroup `F₂₀`, represented intrinsically as the
normalizer of the standard regular `C₅`. -/
def standardF20 : Subgroup S5 := Subgroup.normalizer standardC5

lemma isCycle_fiveCycle : fiveCycle.IsCycle :=
  isCycle_finRotate_of_le (by norm_num)

lemma orderOf_fiveCycle : orderOf fiveCycle = 5 := by
  rw [isCycle_fiveCycle.orderOf]
  simp [fiveCycle]

lemma natCard_standardC5 : Nat.card standardC5 = 5 := by
  rw [standardC5, Nat.card_zpowers, orderOf_fiveCycle]

lemma normal_nontrivial_isPretransitive (H : Subgroup S5)
    [MulAction.IsPretransitive H (Fin 5)] (A : Subgroup H) [A.Normal]
    (hA : A ≠ ⊥) : MulAction.IsPretransitive A (Fin 5) := by
  letI : MulAction.IsPreprimitive H (Fin 5) :=
    MulAction.IsPreprimitive.of_prime_card (by
      simpa using (show Nat.Prime 5 by norm_num))
  apply MulAction.IsQuasiPreprimitive.isPretransitive_of_normal
  intro hfixed
  apply hA
  rw [Subgroup.eq_bot_iff_forall]
  intro a ha
  apply Subtype.ext
  apply Equiv.ext
  intro x
  have hx : x ∈ MulAction.fixedPoints A (Fin 5) := by
    rw [hfixed]
    exact Set.mem_univ x
  exact MulAction.mem_fixedPoints.mp hx ⟨a, ha⟩

lemma stabilizer_eq_bot_of_commutative_pretransitive (A : Subgroup S5)
    [MulAction.IsPretransitive A (Fin 5)] [IsMulCommutative A] (x : Fin 5) :
    MulAction.stabilizer A x = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro s hs
  apply Subtype.ext
  apply Equiv.ext
  intro y
  obtain ⟨a, rfl⟩ := MulAction.exists_smul_eq A x y
  have hsx : s • x = x := MulAction.mem_stabilizer_iff.mp hs
  calc
    s • a • x = (s * a) • x := by rw [mul_smul]
    _ = (a * s) • x := by rw [mul_comm s a]
    _ = a • s • x := by rw [mul_smul]
    _ = a • x := by rw [hsx]

lemma natCard_eq_five_of_commutative_pretransitive (A : Subgroup S5)
    [MulAction.IsPretransitive A (Fin 5)] [IsMulCommutative A] :
    Nat.card A = 5 := by
  classical
  letI := Fintype.ofFinite A
  letI := Fintype.ofFinite (MulAction.orbit A (0 : Fin 5))
  have h := MulAction.card_orbit_mul_card_stabilizer_eq_card_group A (0 : Fin 5)
  have h' : Nat.card (MulAction.orbit A (0 : Fin 5)) *
      Nat.card (MulAction.stabilizer A (0 : Fin 5)) = Nat.card A := by
    simpa only [Nat.card_eq_fintype_card] using h
  have hstabCard : Nat.card (MulAction.stabilizer A (0 : Fin 5)) = 1 := by
    rw [stabilizer_eq_bot_of_commutative_pretransitive A 0]
    exact Subgroup.card_bot
  have horbit : MulAction.orbit A (0 : Fin 5) = Set.univ :=
    MulAction.orbit_eq_univ (M := A) (0 : Fin 5)
  have horbitCard : Nat.card (MulAction.orbit A (0 : Fin 5)) = 5 := by
    rw [horbit]
    simp
  rw [horbitCard, hstabCard] at h'
  simpa using h'.symm

/-- Every abelian transitive subgroup of `S₅` is conjugate to the standard
regular subgroup generated by `(0 1 2 3 4)`. -/
lemma exists_map_conj_standardC5_eq_of_commutative_pretransitive
    (A : Subgroup S5) [MulAction.IsPretransitive A (Fin 5)] [IsMulCommutative A] :
    ∃ g : S5, standardC5.map (MulAut.conj g).toMonoidHom = A := by
  have hcard : Nat.card A = 5 := natCard_eq_five_of_commutative_pretransitive A
  letI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  letI : IsCyclic A := isCyclic_of_prime_card hcard
  obtain ⟨a, ha⟩ := (A.isCyclic_iff_exists_zpowers_eq_top).mp (inferInstance : IsCyclic A)
  have haOrder : orderOf a = 5 := by
    rw [← Nat.card_zpowers a, ha, hcard]
  have haCycle : a.IsCycle :=
    Equiv.Perm.isCycle_of_prime_order'' (by norm_num) haOrder
  have hcycleType : fiveCycle.cycleType = a.cycleType := by
    rw [isCycle_fiveCycle.cycleType, haCycle.cycleType,
      ← isCycle_fiveCycle.orderOf, ← haCycle.orderOf, orderOf_fiveCycle, haOrder]
  obtain ⟨g, hg⟩ :=
    isConj_iff.mp (Equiv.Perm.isConj_iff_cycleType_eq.mpr hcycleType)
  refine ⟨g, ?_⟩
  rw [standardC5, MonoidHom.map_zpowers]
  change Subgroup.zpowers (g * fiveCycle * g⁻¹) = A
  rw [hg, ha]

/-- In a nontrivial solvable group, the last nontrivial term of the derived
series is a nontrivial abelian normal subgroup. -/
lemma exists_nontrivial_commutative_normal_derived (H : Subgroup S5)
    [IsSolvable H] [Nontrivial H] :
    ∃ A : Subgroup H, A ≠ ⊥ ∧ IsMulCommutative A ∧ A.Normal := by
  classical
  let hs : ∃ n : ℕ, derivedSeries H n = ⊥ :=
    (isSolvable_def H).mp (inferInstance : IsSolvable H)
  let n := Nat.find hs
  have hn : derivedSeries H n = ⊥ := Nat.find_spec hs
  have hn0 : n ≠ 0 := by
    intro hn0
    have htop : (⊤ : Subgroup H) = ⊥ := by
      simpa only [hn0, derivedSeries_zero] using hn
    exact top_ne_bot htop
  obtain ⟨m, hnSucc⟩ := Nat.exists_eq_succ_of_ne_zero hn0
  have hmlt : m < n := by omega
  have hm : derivedSeries H m ≠ ⊥ := Nat.find_min hs hmlt
  rw [hnSucc] at hn
  have hcomm : IsMulCommutative (derivedSeries H m) :=
    Subgroup.commutator_self_eq_bot_iff.mp (by
      simpa only [derivedSeries_succ] using hn)
  exact ⟨derivedSeries H m, hm, hcomm, derivedSeries_normal H m⟩

/-- Mapping a subgroup of `H` into the ambient permutation group does not
change the action it induces. -/
lemma map_subtype_isPretransitive (H : Subgroup S5) (A : Subgroup H)
    [MulAction.IsPretransitive A (Fin 5)] :
    MulAction.IsPretransitive (A.map H.subtype) (Fin 5) := by
  constructor
  intro x y
  obtain ⟨a, ha⟩ := MulAction.exists_smul_eq A x y
  let b : A.map H.subtype :=
    ⟨(a : S5), ⟨(a : H), a.property, rfl⟩⟩
  exact ⟨b, ha⟩

/-- A normal subgroup of `H`, mapped into the ambient group, is normalized by
all of `H`. -/
lemma le_normalizer_map_subtype_of_normal (H : Subgroup S5) (A : Subgroup H)
    [A.Normal] : H ≤ Subgroup.normalizer (A.map H.subtype) := by
  rw [Subgroup.le_normalizer_iff]
  intro h hh a ha
  obtain ⟨a', ha', rfl⟩ := ha
  let h' : H := ⟨h, hh⟩
  refine ⟨h' * a' * h'⁻¹, (inferInstance : A.Normal).conj_mem a' ha' h', ?_⟩
  rfl

/-- Every solvable transitive subgroup of `S₅` is contained in a conjugate
of the standard Frobenius group `F₂₀ = N_{S₅}(C₅)`. -/
theorem solvable_transitive_le_map_conj_standardF20 (H : Subgroup S5)
    [IsSolvable H] [MulAction.IsPretransitive H (Fin 5)] :
    ∃ g : S5, H ≤ standardF20.map (MulAut.conj g).toMonoidHom := by
  have hH : H ≠ ⊥ := by
    intro hbot
    obtain ⟨h, hh⟩ := MulAction.exists_smul_eq H (0 : Fin 5) (1 : Fin 5)
    have hone : (h : S5) = 1 := by
      apply Subgroup.mem_bot.mp
      rw [← hbot]
      exact h.property
    have hh' : (h : S5) (0 : Fin 5) = 1 := hh
    rw [hone] at hh'
    norm_num at hh'
  letI : Nontrivial H := H.nontrivial_iff_ne_bot.mpr hH
  obtain ⟨A, hA, hAcomm, hAnormal⟩ :=
    exists_nontrivial_commutative_normal_derived H
  letI : IsMulCommutative A := hAcomm
  letI : A.Normal := hAnormal
  letI : MulAction.IsPretransitive A (Fin 5) :=
    normal_nontrivial_isPretransitive H A hA
  let B : Subgroup S5 := A.map H.subtype
  letI : MulAction.IsPretransitive B (Fin 5) :=
    map_subtype_isPretransitive H A
  obtain ⟨g, hg⟩ :=
    exists_map_conj_standardC5_eq_of_commutative_pretransitive B
  refine ⟨g, ?_⟩
  change H ≤ (Subgroup.normalizer standardC5).map (MulAut.conj g).toMonoidHom
  rw [Subgroup.map_equiv_normalizer_eq, hg]
  exact le_normalizer_map_subtype_of_normal H A

end LeanProofs.PolynomialFormulas.Fin5Solvable
