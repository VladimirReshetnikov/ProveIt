import PolynomialFormulas.FrobeniusDummitResolvent
import PolynomialFormulas.Fin5TransitiveClassificationCertificates
import Mathlib.GroupTheory.GroupAction.MultipleTransitivity
import Mathlib.GroupTheory.Sylow
import Mathlib.GroupTheory.SpecificGroups.Alternating

/-!
# The transitive subgroups of `S₅`

This file states the corrected form of the subgroup classification used in
Section 5 of Lazard's paper.  There are five, not four, conjugacy classes of
transitive subgroups of `S₅`:

* the regular cyclic group `C₅`;
* the dihedral group `D₅` of order ten;
* the Frobenius group `F₂₀`;
* `A₅`;
* `S₅` itself.

Lazard's four-item list is therefore the classification of *proper*
transitive subgroups.  We keep that as a separate theorem with an explicit
properness hypothesis.

The finite certificates use ordinary kernel reduction with `decide`; there is
no `native_decide`, axiom, or opaque external certificate.  The bounded,
generated certificate modules normalize a transitive group so that it contains
the standard `C₅`, split `S₅` into eight double cosets, and check the short
generation computation for one representative of each coset.
-/

namespace LeanProofs.PolynomialFormulas.Fin5TransitiveClassification

open Equiv MulAction Subgroup

abbrev S5 := Fin5Solvable.S5
abbrev fiveCycle : S5 := Fin5Solvable.fiveCycle
abbrev standardC5 : Subgroup S5 := Fin5Solvable.standardC5
abbrev standardF20 : Subgroup S5 := Fin5Solvable.standardF20
abbrev standardA5 : Subgroup S5 := alternatingGroup (Fin 5)
abbrev multiplierTwo : S5 := FrobeniusDummitResolvent.multiplierTwo
abbrev c5Elements : Finset S5 := Fin5TransitiveC5.c5Elements
abbrev f20Elements : Finset S5 := Fin5TransitiveC5.f20Elements

theorem mem_c5Elements_iff (g : S5) :
    g ∈ c5Elements ↔ g ∈ standardC5 :=
  Fin5TransitiveC5.mem_c5Elements_iff g

theorem mem_f20Elements_iff (g : S5) :
    g ∈ f20Elements ↔ g ∈ standardF20 :=
  Fin5TransitiveC5.mem_f20Elements_iff g

/-! ## The explicit standard `D₅` -/

/-- The involution `x ↦ -x` in the affine model of `F₂₀`. -/
abbrev reflection : S5 := Fin5DihedralCore.reflection

/-- The ten affine maps `x ↦ ±x+a`. -/
abbrev d5Element : Fin 5 × Fin 2 → S5 :=
  QuinticX5Add20XAdd32Dihedral.Classification.d5Element

abbrev d5Elements : Finset S5 := Fin5DihedralCore.d5Elements

set_option maxRecDepth 100000 in
theorem d5Element_injective : Function.Injective d5Element := by
  decide

set_option maxRecDepth 100000 in
theorem card_d5Elements : d5Elements.card = 10 := by
  exact
    QuinticX5Add20XAdd32Dihedral.Classification.card_d5Elements

set_option maxRecDepth 100000 in
theorem one_mem_d5Elements : (1 : S5) ∈ d5Elements := by
  exact
    QuinticX5Add20XAdd32Dihedral.Classification.one_mem_d5Elements

set_option maxRecDepth 100000 in
theorem d5Elements_mul_closed :
    ∀ a b : S5, a ∈ d5Elements → b ∈ d5Elements → a * b ∈ d5Elements := by
  exact
    QuinticX5Add20XAdd32Dihedral.Classification.d5Elements_mul_closed

set_option maxRecDepth 100000 in
theorem d5Elements_inv_closed :
    ∀ a : S5, a ∈ d5Elements → a⁻¹ ∈ d5Elements := by
  exact
    QuinticX5Add20XAdd32Dihedral.Classification.d5Elements_inv_closed

/-- The standard dihedral subgroup generated by translations and `x ↦ -x`.
Its carrier is definitionally the ten-element executable table above. -/
abbrev standardD5 : Subgroup S5 := Fin5DihedralCore.standardD5

@[simp] theorem mem_standardD5_iff (g : S5) :
    g ∈ standardD5 ↔ g ∈ d5Elements :=
  Fin5DihedralCore.mem_standardD5_iff g

theorem reflection_sq : reflection ^ 2 = (1 : S5) := by
  decide

theorem reflection_conj_fiveCycle :
    reflection * fiveCycle * reflection⁻¹ = fiveCycle⁻¹ := by
  decide

theorem fiveCycle_mem_standardD5 : fiveCycle ∈ standardD5 := by
  exact Fin5DihedralCore.fiveCycle_mem_standardD5

theorem reflection_mem_standardD5 : reflection ∈ standardD5 := by
  exact Fin5DihedralCore.reflection_mem_standardD5

/-- The executable ten-element subgroup really is generated by a rotation
and a reflection, so the name `D₅` does not rest only on its cardinality. -/
theorem standardD5_eq_closure :
    standardD5 = Subgroup.closure ({fiveCycle, reflection} : Set S5) := by
  exact Fin5DihedralCore.standardD5_eq_closure

noncomputable def standardD5EquivElements :
    standardD5 ≃ {g : S5 // g ∈ d5Elements} where
  toFun g := ⟨g.1, g.2⟩
  invFun g := ⟨g.1, g.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem natCard_standardD5 : Nat.card standardD5 = 10 := by
  exact Fin5DihedralCore.natCard_standardD5

set_option maxRecDepth 100000 in
theorem c5Elements_subset_d5Elements :
    ∀ g : S5, g ∈ c5Elements → g ∈ d5Elements := by
  intro g hg
  exact (mem_standardD5_iff g).mp
    (Fin5DihedralCore.standardC5_le_standardD5
      ((mem_c5Elements_iff g).mp hg))

set_option maxRecDepth 100000 in
theorem d5Elements_subset_f20Elements :
    ∀ g : S5, g ∈ d5Elements → g ∈ f20Elements := by
  decide

theorem standardC5_le_standardD5 : standardC5 ≤ standardD5 := by
  exact Fin5DihedralCore.standardC5_le_standardD5

theorem standardD5_le_standardF20 : standardD5 ≤ standardF20 := by
  intro g hg
  exact (mem_f20Elements_iff g).mp
    (d5Elements_subset_f20Elements g ((mem_standardD5_iff g).mpr hg))

theorem relIndex_standardC5_standardD5 :
    standardC5.relIndex standardD5 = 2 := by
  have hcardSub :
      Nat.card (standardC5.subgroupOf standardD5) = 5 := by
    calc
      Nat.card (standardC5.subgroupOf standardD5) = Nat.card standardC5 :=
        Nat.card_congr
          (Subgroup.subgroupOfEquivOfLe standardC5_le_standardD5).toEquiv
      _ = 5 := Fin5Solvable.natCard_standardC5
  have h := (standardC5.subgroupOf standardD5).index_mul_card
  change standardC5.relIndex standardD5 *
      Nat.card (standardC5.subgroupOf standardD5) = Nat.card standardD5 at h
  rw [hcardSub, natCard_standardD5] at h
  omega

theorem relIndex_standardD5_standardF20 :
    standardD5.relIndex standardF20 = 2 := by
  have hcardSub :
      Nat.card (standardD5.subgroupOf standardF20) = 10 := by
    calc
      Nat.card (standardD5.subgroupOf standardF20) = Nat.card standardD5 :=
        Nat.card_congr
          (Subgroup.subgroupOfEquivOfLe standardD5_le_standardF20).toEquiv
      _ = 10 := natCard_standardD5
  have h := (standardD5.subgroupOf standardF20).index_mul_card
  change standardD5.relIndex standardF20 *
      Nat.card (standardD5.subgroupOf standardF20) = Nat.card standardF20 at h
  rw [hcardSub, Fin5TransitiveC5.natCard_standardF20] at h
  omega

/-! ## Transitivity and the sharp affine action -/

set_option maxRecDepth 100000 in
theorem c5_transitive_certificate :
    ∀ x y : Fin 5,
      ∃ g : S5, g ∈ c5Elements ∧ g x = y := by
  decide

theorem standardC5_isPretransitive :
    MulAction.IsPretransitive standardC5 (Fin 5) := by
  constructor
  intro x y
  obtain ⟨g, hg, hxy⟩ := c5_transitive_certificate x y
  exact ⟨⟨g, (mem_c5Elements_iff g).mp hg⟩, hxy⟩

theorem isPretransitive_of_standardC5_le (H : Subgroup S5)
    (hC : standardC5 ≤ H) : MulAction.IsPretransitive H (Fin 5) := by
  constructor
  intro x y
  obtain ⟨g, hg, hxy⟩ := c5_transitive_certificate x y
  exact ⟨⟨g, hC ((mem_c5Elements_iff g).mp hg)⟩, hxy⟩

set_option maxRecDepth 100000 in
theorem f20_two_pretransitive_certificate :
    ∀ {a b c d : Fin 5}, a ≠ b → c ≠ d →
      ∃ g : S5, g ∈ f20Elements ∧ g a = c ∧ g b = d := by
  decide

/-- The standard affine `F₂₀` is two-transitive on five points. -/
theorem standardF20_isTwoPretransitive :
    MulAction.IsMultiplyPretransitive standardF20 (Fin 5) 2 := by
  rw [MulAction.is_two_pretransitive_iff]
  intro a b c d hab hcd
  obtain ⟨g, hg, hac, hbd⟩ :=
    f20_two_pretransitive_certificate hab hcd
  exact ⟨⟨g, (mem_f20Elements_iff g).mp hg⟩, hac, hbd⟩

set_option maxRecDepth 100000 in
theorem f20_sharp_two_pretransitive_certificate :
    ∀ {a b : Fin 5}, a ≠ b →
      ∀ g h : S5, g ∈ f20Elements → h ∈ f20Elements →
        g a = h a → g b = h b → g = h := by
  intro a b hab
  letI : Fintype standardF20 := Fintype.ofFinite _
  let Pair := {p : Fin 5 × Fin 5 // p.1 ≠ p.2}
  let ev : standardF20 → Pair := fun u =>
    ⟨(u.1 a, u.1 b), fun huv => hab (u.1.injective huv)⟩
  have hsurj : Function.Surjective ev := by
    intro y
    obtain ⟨u, hu, hua, hub⟩ :=
      f20_two_pretransitive_certificate hab y.2
    refine ⟨⟨u, (mem_f20Elements_iff u).mp hu⟩, ?_⟩
    apply Subtype.ext
    exact Prod.ext hua hub
  have hcardDom : Fintype.card standardF20 = 20 := by
    simpa only [Nat.card_eq_fintype_card] using
      Fin5TransitiveC5.natCard_standardF20
  have hcardPair : Fintype.card Pair = 20 := by
    decide
  have hinj : Function.Injective ev :=
    ((Fintype.bijective_iff_surjective_and_card ev).mpr
      ⟨hsurj, hcardDom.trans hcardPair.symm⟩).injective
  intro g h hg hh hga hgb
  let g' : standardF20 := ⟨g, (mem_f20Elements_iff g).mp hg⟩
  let h' : standardF20 := ⟨h, (mem_f20Elements_iff h).mp hh⟩
  have hgh : g' = h' := hinj (by
    apply Subtype.ext
    exact Prod.ext hga hgb)
  exact congrArg Subtype.val hgh

/-- The affine action is sharply two-transitive: an element is uniquely
determined by its values on two distinct points. -/
theorem standardF20_existsUnique_map_pair
    {a b c d : Fin 5} (hab : a ≠ b) (hcd : c ≠ d) :
    ∃! g : standardF20, g • a = c ∧ g • b = d := by
  obtain ⟨g, hg, hac, hbd⟩ :=
    f20_two_pretransitive_certificate hab hcd
  let g' : standardF20 := ⟨g, (mem_f20Elements_iff g).mp hg⟩
  refine ⟨g', ⟨hac, hbd⟩, ?_⟩
  intro h hh
  apply Subtype.ext
  exact (f20_sharp_two_pretransitive_certificate hab g h
    hg ((mem_f20Elements_iff h).mpr h.property)
    (hac.trans hh.1.symm) (hbd.trans hh.2.symm)).symm

/-! ## The normalized finite classification -/

/-- One breadth step using the four letters
`fiveCycle`, `fiveCycle⁻¹`, `g`, and `g⁻¹`. -/
def generationStep (g : S5) (s : Finset S5) : Finset S5 :=
  s ∪ s.image (fun x ↦ fiveCycle * x) ∪
    s.image (fun x ↦ fiveCycle⁻¹ * x) ∪
    s.image (fun x ↦ g * x) ∪
    s.image (fun x ↦ g⁻¹ * x)

def generatedStage (g : S5) : ℕ → Finset S5
  | 0 => {1}
  | n + 1 => generationStep g (generatedStage g n)

lemma generationStep_subset_subgroup (H : Subgroup S5) (g : S5)
    (hfive : fiveCycle ∈ H) (hg : g ∈ H) (s : Finset S5)
    (hs : ∀ x ∈ s, x ∈ H) :
    ∀ x ∈ generationStep g s, x ∈ H := by
  intro x hx
  simp only [generationStep, Finset.mem_union] at hx
  rcases hx with ((((hx | hx) | hx) | hx) | hx)
  · exact hs x hx
  · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
    exact H.mul_mem hfive (hs y hy)
  · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
    exact H.mul_mem (H.inv_mem hfive) (hs y hy)
  · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
    exact H.mul_mem hg (hs y hy)
  · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
    exact H.mul_mem (H.inv_mem hg) (hs y hy)

lemma generatedStage_subset_subgroup (H : Subgroup S5) (g : S5)
    (hfive : fiveCycle ∈ H) (hg : g ∈ H) :
    ∀ n x, x ∈ generatedStage g n → x ∈ H := by
  intro n
  induction n with
  | zero =>
      intro x hx
      have hx' : x = 1 := by simpa [generatedStage] using hx
      simpa [hx'] using H.one_mem
  | succ n ih =>
      exact generationStep_subset_subgroup H g hfive hg
        (generatedStage g n) ih

def evenElements : Finset S5 :=
  Finset.univ.filter (fun g ↦ Equiv.Perm.sign g = 1)

theorem mem_evenElements_iff (g : S5) :
    g ∈ evenElements ↔ g ∈ standardA5 := by
  change g ∈ evenElements ↔ Equiv.Perm.sign g = 1
  simp [evenElements]

/-- The group generated by the standard `C₅` and one further permutation,
described by the first class in the chain which contains that permutation. -/
def expectedGenerated (g : S5) : Subgroup S5 :=
  if g ∈ c5Elements then standardC5
  else if g ∈ d5Elements then standardD5
  else if g ∈ f20Elements then standardF20
  else if Equiv.Perm.sign g = 1 then standardA5
  else ⊤

theorem expectedGenerated_le_of_standardC5_le
    (H : Subgroup S5) (g : S5) (hC : standardC5 ≤ H) (hg : g ∈ H) :
    expectedGenerated g ≤ H := by
  intro x hx
  apply
    Fin5TransitiveClassificationCertificates.classElements_le_of_standardC5_le
      H g hC hg x
  by_cases hgC : g ∈ c5Elements
  · have hxC : x ∈ c5Elements := (mem_c5Elements_iff x).mpr (by
      simpa [expectedGenerated, hgC] using hx)
    simpa [Fin5TransitiveClassificationCertificates.elementClass,
      Fin5TransitiveClassificationCertificates.classElements, hgC] using hxC
  · by_cases hgD : g ∈ d5Elements
    · have hxD : x ∈ d5Elements := (mem_standardD5_iff x).mp (by
        simpa [expectedGenerated, hgC, hgD] using hx)
      simpa [Fin5TransitiveClassificationCertificates.elementClass,
        Fin5TransitiveClassificationCertificates.classElements, hgC, hgD]
        using hxD
    · by_cases hgF : g ∈ f20Elements
      · have hxF : x ∈ f20Elements := (mem_f20Elements_iff x).mpr (by
          simpa [expectedGenerated, hgC, hgD, hgF] using hx)
        simpa [Fin5TransitiveClassificationCertificates.elementClass,
          Fin5TransitiveClassificationCertificates.classElements,
          hgC, hgD, hgF] using hxF
      · by_cases hgA : Equiv.Perm.sign g = 1
        · have hxA : Equiv.Perm.sign x = 1 := by
            have hxA' : x ∈ standardA5 := by
              simpa [expectedGenerated, hgC, hgD, hgF, hgA] using hx
            exact Equiv.Perm.mem_alternatingGroup.mp hxA'
          simpa [Fin5TransitiveClassificationCertificates.elementClass,
            Fin5TransitiveClassificationCertificates.classElements,
            Fin5TransitiveClassificationCertificates.evenElements,
            evenElements, hgC, hgD, hgF, hgA] using hxA
        · simp [Fin5TransitiveClassificationCertificates.elementClass,
            Fin5TransitiveClassificationCertificates.classElements,
            hgC, hgD, hgF, hgA]

inductive TransitiveClass
  | cyclic
  | dihedral
  | frobenius
  | alternating
  | symmetric
  deriving DecidableEq, Fintype

def classSubgroup : TransitiveClass → Subgroup S5
  | .cyclic => standardC5
  | .dihedral => standardD5
  | .frobenius => standardF20
  | .alternating => standardA5
  | .symmetric => ⊤

def classCard : TransitiveClass → ℕ
  | .cyclic => 5
  | .dihedral => 10
  | .frobenius => 20
  | .alternating => 60
  | .symmetric => 120

theorem natCard_standardA5 : Nat.card standardA5 = 60 := by
  rw [nat_card_alternatingGroup]
  norm_num

theorem natCard_S5 : Nat.card S5 = 120 := by
  rw [show Nat.card S5 = Fintype.card S5 by exact Nat.card_eq_fintype_card]
  norm_num [S5, Fintype.card_perm]

theorem natCard_classSubgroup (c : TransitiveClass) :
    Nat.card (classSubgroup c) = classCard c := by
  cases c with
  | cyclic => exact Fin5Solvable.natCard_standardC5
  | dihedral => exact natCard_standardD5
  | frobenius => exact Fin5TransitiveC5.natCard_standardF20
  | alternating => exact natCard_standardA5
  | symmetric =>
      rw [classSubgroup, Subgroup.card_top]
      exact natCard_S5

theorem classCard_injective : Function.Injective classCard := by
  decide

/-- A subgroup containing `A₅` is either `A₅` or all of `S₅`. -/
theorem eq_top_of_standardA5_le_of_not_le
    (H : Subgroup S5) (hA : standardA5 ≤ H) (hnot : ¬ H ≤ standardA5) :
    H = ⊤ := by
  rw [SetLike.not_le_iff_exists] at hnot
  obtain ⟨g, hgH, hgA⟩ := hnot
  have hgOdd : Equiv.Perm.sign g = -1 := by
    rcases Int.units_eq_one_or (Equiv.Perm.sign g) with hgEven | hgOdd
    · exact (hgA (Equiv.Perm.mem_alternatingGroup.mpr hgEven)).elim
    · exact hgOdd
  apply top_unique
  intro x _
  rcases Int.units_eq_one_or (Equiv.Perm.sign x) with hxEven | hxOdd
  · exact hA (Equiv.Perm.mem_alternatingGroup.mpr hxEven)
  · have hEven : g⁻¹ * x ∈ standardA5 := by
      rw [Equiv.Perm.mem_alternatingGroup, map_mul, map_inv, hgOdd, hxOdd]
      norm_num
    simpa using H.mul_mem hgH (hA hEven)

/-- Classification after conjugating a contained regular `C₅` to the
standard one. -/
theorem normalized_classification (H : Subgroup S5)
    (hC : standardC5 ≤ H) :
    ∃ c : TransitiveClass, H = classSubgroup c := by
  by_cases hHF : H ≤ standardF20
  · by_cases hHD : H ≤ standardD5
    · by_cases hHC : H ≤ standardC5
      · exact ⟨.cyclic, le_antisymm hHC hC⟩
      · rw [SetLike.not_le_iff_exists] at hHC
        obtain ⟨g, hgH, hgC⟩ := hHC
        have hgC' : g ∉ c5Elements := fun hg ↦
          hgC ((mem_c5Elements_iff g).mp hg)
        have hgD' : g ∈ d5Elements :=
          (mem_standardD5_iff g).mpr (hHD hgH)
        have hexpected : expectedGenerated g = standardD5 := by
          simp [expectedGenerated, hgC', hgD']
        have hDH : standardD5 ≤ H := by
          rw [← hexpected]
          exact expectedGenerated_le_of_standardC5_le H g hC hgH
        exact ⟨.dihedral, le_antisymm hHD hDH⟩
    · rw [SetLike.not_le_iff_exists] at hHD
      obtain ⟨g, hgH, hgD⟩ := hHD
      have hgC' : g ∉ c5Elements := fun hg ↦
        hgD (standardC5_le_standardD5 ((mem_c5Elements_iff g).mp hg))
      have hgD' : g ∉ d5Elements := fun hg ↦
        hgD ((mem_standardD5_iff g).mpr hg)
      have hgF' : g ∈ f20Elements :=
        (mem_f20Elements_iff g).mpr (hHF hgH)
      have hexpected : expectedGenerated g = standardF20 := by
        simp [expectedGenerated, hgC', hgD', hgF']
      have hFH : standardF20 ≤ H := by
        rw [← hexpected]
        exact expectedGenerated_le_of_standardC5_le H g hC hgH
      exact ⟨.frobenius, le_antisymm hHF hFH⟩
  · rw [SetLike.not_le_iff_exists] at hHF
    obtain ⟨g, hgH, hgF⟩ := hHF
    have hgC' : g ∉ c5Elements := fun hg ↦
      hgF (standardC5_le_standardD5.trans standardD5_le_standardF20
        ((mem_c5Elements_iff g).mp hg))
    have hgD' : g ∉ d5Elements := fun hg ↦
      hgF (standardD5_le_standardF20 ((mem_standardD5_iff g).mpr hg))
    have hgF' : g ∉ f20Elements := fun hg ↦
      hgF ((mem_f20Elements_iff g).mp hg)
    by_cases hgEven : Equiv.Perm.sign g = 1
    · have hexpected : expectedGenerated g = standardA5 := by
        simp [expectedGenerated, hgC', hgD', hgF', hgEven]
      have hAH : standardA5 ≤ H := by
        rw [← hexpected]
        exact expectedGenerated_le_of_standardC5_le H g hC hgH
      by_cases hHA : H ≤ standardA5
      · exact ⟨.alternating, le_antisymm hHA hAH⟩
      · exact ⟨.symmetric, eq_top_of_standardA5_le_of_not_le H hAH hHA⟩
    · have hexpected : expectedGenerated g = (⊤ : Subgroup S5) := by
        simp [expectedGenerated, hgC', hgD', hgF', hgEven]
      have htop : (⊤ : Subgroup S5) ≤ H := by
        rw [← hexpected]
        exact expectedGenerated_le_of_standardC5_le H g hC hgH
      exact ⟨.symmetric, top_unique htop⟩

/-- `H` is an inner conjugate of `K`. -/
def IsConjugateTo (H K : Subgroup S5) : Prop :=
  ∃ g : S5, K.map (MulAut.conj g).toMonoidHom = H

theorem natCard_eq_of_isConjugateTo {H K : Subgroup S5}
    (h : IsConjugateTo H K) : Nat.card H = Nat.card K := by
  obtain ⟨g, hg⟩ := h
  calc
    Nat.card H = Nat.card (K.map (MulAut.conj g).toMonoidHom) := by
      rw [hg]
    _ = Nat.card K :=
      Subgroup.card_map_of_injective (K := K) (MulAut.conj g).injective

theorem transitive_classification_exists (H : Subgroup S5)
    [MulAction.IsPretransitive H (Fin 5)] :
    ∃ c : TransitiveClass, IsConjugateTo H (classSubgroup c) := by
  obtain ⟨g, hg⟩ :=
    Fin5TransitiveC5.exists_map_conj_standardC5_le_of_pretransitive H
  let e : MulAut S5 := MulAut.conj g
  let K : Subgroup S5 := H.map e.symm.toMonoidHom
  have hCK : standardC5 ≤ K := by
    have hm := Subgroup.map_mono (f := e.symm.toMonoidHom) hg
    simpa [K, e, Subgroup.map_map] using hm
  obtain ⟨c, hc⟩ := normalized_classification K hCK
  refine ⟨c, g, ?_⟩
  calc
    (classSubgroup c).map e.toMonoidHom = K.map e.toMonoidHom :=
      congrArg (fun L : Subgroup S5 ↦ L.map e.toMonoidHom) hc.symm
    _ = H := by simp [K, Subgroup.map_map]

/-- Correct classification: every transitive subgroup of `S₅` is conjugate
to exactly one of `C₅`, `D₅`, `F₂₀`, `A₅`, and `S₅`. -/
theorem transitive_classification (H : Subgroup S5)
    [MulAction.IsPretransitive H (Fin 5)] :
    ∃! c : TransitiveClass, IsConjugateTo H (classSubgroup c) := by
  obtain ⟨c, hc⟩ := transitive_classification_exists H
  refine ⟨c, hc, ?_⟩
  intro d hd
  apply classCard_injective
  rw [← natCard_classSubgroup c, ← natCard_classSubgroup d]
  exact (natCard_eq_of_isConjugateTo hd).symm.trans
    (natCard_eq_of_isConjugateTo hc)

inductive LazardProperClass
  | cyclic
  | dihedral
  | frobenius
  | alternating
  deriving DecidableEq, Fintype

def LazardProperClass.toFull : LazardProperClass → TransitiveClass
  | .cyclic => .cyclic
  | .dihedral => .dihedral
  | .frobenius => .frobenius
  | .alternating => .alternating

def properClassSubgroup (c : LazardProperClass) : Subgroup S5 :=
  classSubgroup c.toFull

theorem LazardProperClass.toFull_injective :
    Function.Injective LazardProperClass.toFull := by
  decide

/-- Lazard's four-item list, with its missing hypothesis made explicit: it is
the classification of proper transitive subgroups. -/
theorem proper_transitive_classification (H : Subgroup S5)
    [MulAction.IsPretransitive H (Fin 5)] (hproper : H ≠ ⊤) :
    ∃! c : LazardProperClass, IsConjugateTo H (properClassSubgroup c) := by
  obtain ⟨c, hc⟩ := transitive_classification_exists H
  have hexists : ∃ c : LazardProperClass,
      IsConjugateTo H (properClassSubgroup c) := by
    cases c with
    | cyclic => exact ⟨.cyclic, hc⟩
    | dihedral => exact ⟨.dihedral, hc⟩
    | frobenius => exact ⟨.frobenius, hc⟩
    | alternating => exact ⟨.alternating, hc⟩
    | symmetric =>
        obtain ⟨g, hg⟩ := hc
        have : H = ⊤ := by simpa [classSubgroup] using hg.symm
        exact (hproper this).elim
  obtain ⟨c, hc⟩ := hexists
  refine ⟨c, hc, ?_⟩
  intro d hd
  apply LazardProperClass.toFull_injective
  exact (transitive_classification H).unique
    (by simpa [properClassSubgroup] using hd)
    (by simpa [properClassSubgroup] using hc)

/-! ## Maximal solvability and the six conjugates of `F₂₀` -/

/-- No strictly larger subgroup of `S₅` containing the standard `F₂₀` is
solvable. -/
theorem standardF20_maximal_solvable (H : Subgroup S5)
    (hFH : standardF20 ≤ H) (hsolvable : IsSolvable H) :
    H = standardF20 := by
  letI : MulAction.IsPretransitive H (Fin 5) :=
    isPretransitive_of_standardC5_le H
      (standardC5_le_standardD5.trans (standardD5_le_standardF20.trans hFH))
  letI : IsSolvable H := hsolvable
  obtain ⟨g, hHg⟩ :=
    Fin5Solvable.solvable_transitive_le_map_conj_standardF20 H
  have hcardContainer :
      Nat.card (standardF20.map (MulAut.conj g).toMonoidHom) = 20 := by
    rw [Subgroup.card_map_of_injective (MulAut.conj g).injective,
      Fin5TransitiveC5.natCard_standardF20]
  have hcardH : Nat.card H ≤ 20 := by
    have h := Nat.card_le_card_of_injective
      (Subgroup.inclusion hHg) (Subgroup.inclusion_injective hHg)
    simpa only [hcardContainer] using h
  symm
  apply Subgroup.eq_of_le_of_card_ge hFH
  simpa only [Fin5TransitiveC5.natCard_standardF20] using hcardH

theorem standardF20_is_maximal_solvable :
    IsSolvable standardF20 ∧
      ∀ H : Subgroup S5, standardF20 ≤ H → IsSolvable H → H = standardF20 :=
  ⟨Fin5TransitiveC5.standardF20_isSolvable,
    fun H hFH hsolvable ↦ standardF20_maximal_solvable H hFH hsolvable⟩

/-- Executable membership test for the normalizer of `F₂₀`. -/
def normalizesF20B (g : S5) : Bool :=
  decide (∀ h : S5, h ∈ f20Elements → g * h * g⁻¹ ∈ f20Elements)

theorem normalizesF20B_eq_true_iff_normalizer (g : S5) :
    normalizesF20B g = true ↔ g ∈ Subgroup.normalizer standardF20 := by
  simp only [normalizesF20B, decide_eq_true_eq]
  constructor
  · intro hg
    apply Subgroup.mem_normalizer_fintype
    intro h hh
    apply (mem_f20Elements_iff _).mp
    exact hg h ((mem_f20Elements_iff h).mpr hh)
  · intro hg h hh
    rw [mem_f20Elements_iff] at hh ⊢
    exact (Subgroup.mem_normalizer_iff.mp hg h).mp hh

private theorem normalizer_standardF20_core :
    Subgroup.normalizer standardF20 = standardF20 := by
  letI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hindex : standardC5.index = 24 := by
    have h := standardC5.index_mul_card
    rw [Fin5Solvable.natCard_standardC5, natCard_S5] at h
    omega
  have hP : IsPGroup 5 standardC5 :=
    IsPGroup.of_card (n := 1) (by
      simpa using Fin5Solvable.natCard_standardC5)
  let P : Sylow 5 S5 := hP.toSylow (by
    rw [hindex]
    norm_num)
  change Subgroup.normalizer
      (Subgroup.normalizer (standardC5 : Set S5) : Set S5) =
    Subgroup.normalizer (standardC5 : Set S5)
  have hPcoe : (P : Subgroup S5) = standardC5 := rfl
  rw [← hPcoe]
  exact P.normalizer_normalizer

theorem normalizesF20B_certificate :
    ∀ g : S5, normalizesF20B g = true ↔ g ∈ f20Elements := by
  intro g
  rw [normalizesF20B_eq_true_iff_normalizer,
    normalizer_standardF20_core, ← mem_f20Elements_iff]

/-- `F₂₀` is self-normalizing in `S₅`. -/
theorem normalizer_standardF20 :
    Subgroup.normalizer standardF20 = standardF20 :=
  normalizer_standardF20_core

/-- The permutations fixing `0` and `1` pointwise; this is the copy of `S₃`
which permutes the remaining three letters. -/
def pointwiseStabilizer01 : Subgroup S5 where
  carrier := {g | g 0 = 0 ∧ g 1 = 1}
  one_mem' := by simp
  mul_mem' := by
    intro g h hg hh
    constructor <;> simp [hg.1, hg.2, hh.1, hh.2]
  inv_mem' := by
    intro g hg
    constructor
    · apply g.injective
      simp [hg.1]
    · apply g.injective
      simp [hg.2]

@[simp] theorem mem_pointwiseStabilizer01_iff (g : S5) :
    g ∈ pointwiseStabilizer01 ↔ g 0 = 0 ∧ g 1 = 1 :=
  Iff.rfl

def pointwiseElements : Finset S5 :=
  Finset.univ.filter (fun g ↦ g 0 = 0 ∧ g 1 = 1)

theorem mem_pointwiseElements_iff (g : S5) :
    g ∈ pointwiseElements ↔ g ∈ pointwiseStabilizer01 := by
  simp [pointwiseElements]

set_option maxRecDepth 100000 in
theorem card_pointwiseElements : pointwiseElements.card = 6 := by
  decide

noncomputable def pointwiseStabilizer01EquivElements :
    pointwiseStabilizer01 ≃ {g : S5 // g ∈ pointwiseElements} where
  toFun g := ⟨g.1, (mem_pointwiseElements_iff g.1).mpr g.2⟩
  invFun g := ⟨g.1, (mem_pointwiseElements_iff g.1).mp g.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem natCard_pointwiseStabilizer01 :
    Nat.card pointwiseStabilizer01 = 6 := by
  rw [Nat.card_congr pointwiseStabilizer01EquivElements]
  simpa only [Fintype.card_coe, Nat.card_eq_fintype_card] using
    card_pointwiseElements

/-- Sharp two-transitivity says that the pointwise stabilizer of two points
meets `F₂₀` trivially. -/
theorem standardF20_inf_pointwiseStabilizer01 :
    standardF20 ⊓ pointwiseStabilizer01 = ⊥ := by
  ext g
  rw [Subgroup.mem_inf, Subgroup.mem_bot,
    ← mem_f20Elements_iff, mem_pointwiseStabilizer01_iff]
  change (g ∈ f20Elements ∧ g 0 = 0 ∧ g 1 = 1) ↔ g = 1
  constructor
  · rintro ⟨hgF, hg0, hg1⟩
    exact f20_sharp_two_pretransitive_certificate
      (a := 0) (b := 1) (by decide) g 1 hgF
      ((mem_f20Elements_iff 1).mpr standardF20.one_mem)
      (by simpa using hg0) (by simpa using hg1)
  · rintro rfl
    simp [mem_f20Elements_iff]

abbrev F20Cosets := S5 ⧸ standardF20

def pointwiseToF20Coset (g : pointwiseStabilizer01) : F20Cosets :=
  (g.1 : F20Cosets)

theorem pointwiseToF20Coset_injective :
    Function.Injective pointwiseToF20Coset := by
  intro g h hgh
  have hF : (g.1 : S5)⁻¹ * h.1 ∈ standardF20 :=
    QuotientGroup.leftRel_apply.mp (Quotient.exact' hgh)
  have hP : (g.1 : S5)⁻¹ * h.1 ∈ pointwiseStabilizer01 :=
    pointwiseStabilizer01.mul_mem
      (pointwiseStabilizer01.inv_mem g.2) h.2
  have hbot : (g.1 : S5)⁻¹ * h.1 ∈ (⊥ : Subgroup S5) := by
    rw [← standardF20_inf_pointwiseStabilizer01]
    exact ⟨hF, hP⟩
  apply Subtype.ext
  exact inv_mul_eq_one.mp (Subgroup.mem_bot.mp hbot)

/-- The six permutations fixing `0,1` give a complete transversal for
`S₅/F₂₀`. -/
theorem pointwiseToF20Coset_bijective :
    Function.Bijective pointwiseToF20Coset := by
  classical
  letI : Fintype F20Cosets := Fintype.ofFinite _
  apply (Fintype.bijective_iff_injective_and_card _).mpr
  refine ⟨pointwiseToF20Coset_injective, ?_⟩
  rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
    natCard_pointwiseStabilizer01, Fin5TransitiveC5.natCard_cosets]

/-- A computable carrier for the conjugate `g F₂₀ g⁻¹`. -/
def conjugateF20Elements (g : S5) : Finset S5 :=
  f20Elements.image (fun h ↦ g * h * g⁻¹)

theorem mem_conjugateF20Elements_iff (g x : S5) :
    x ∈ conjugateF20Elements g ↔
      x ∈ standardF20.map (MulAut.conj g).toMonoidHom := by
  constructor
  · intro hx
    obtain ⟨h, hh, rfl⟩ := Finset.mem_image.mp hx
    exact ⟨h, (mem_f20Elements_iff h).mp hh, rfl⟩
  · intro hx
    obtain ⟨h, hh, rfl⟩ := hx
    exact Finset.mem_image.mpr
      ⟨h, (mem_f20Elements_iff h).mpr hh, rfl⟩

set_option maxRecDepth 100000 in
theorem pointwise_conjugates_distinct_certificate :
    ∀ g h : S5, g ∈ pointwiseElements → h ∈ pointwiseElements →
      conjugateF20Elements g = conjugateF20Elements h → g = h := by
  decide

/-- The six elements of the pointwise `S₃` also give six distinct conjugates
of `F₂₀`; self-normality shows that these are all its conjugates. -/
theorem pointwise_conjugates_injective : Function.Injective
    (fun g : pointwiseStabilizer01 ↦
      standardF20.map (MulAut.conj g.1).toMonoidHom) := by
  intro g h hgh
  apply Subtype.ext
  apply pointwise_conjugates_distinct_certificate g.1 h.1
      ((mem_pointwiseElements_iff g.1).mpr g.2)
      ((mem_pointwiseElements_iff h.1).mpr h.2)
  ext x
  rw [mem_conjugateF20Elements_iff g.1 x,
    mem_conjugateF20Elements_iff h.1 x]
  exact SetLike.ext_iff.mp hgh x

theorem sameF20Coset_conjugateF20Elements :
    ∀ g h : S5,
      Fin5TransitiveC5.sameCosetB g h = true →
        conjugateF20Elements g = conjugateF20Elements h := by
  intro g h hsame
  have hcoset : (g : F20Cosets) = (h : F20Cosets) :=
    (Fin5TransitiveC5.sameCosetB_eq_true g h).mp hsame
  set k : S5 := g⁻¹ * h with hkdef
  have hk : k ∈ standardF20 := by
    rw [hkdef]
    exact QuotientGroup.leftRel_apply.mp (Quotient.exact' hcoset)
  have hh : h = g * k := by
    rw [hkdef]
    simp
  apply Finset.ext
  intro x
  simp only [conjugateF20Elements, Finset.mem_image]
  constructor
  · rintro ⟨a, ha, rfl⟩
    refine ⟨k⁻¹ * a * k, ?_, ?_⟩
    · apply (mem_f20Elements_iff _).mpr
      exact standardF20.mul_mem
        (standardF20.mul_mem (standardF20.inv_mem hk)
          ((mem_f20Elements_iff a).mp ha)) hk
    · rw [hh]
      simp [mul_assoc]
  · rintro ⟨a, ha, rfl⟩
    refine ⟨k * a * k⁻¹, ?_, ?_⟩
    · apply (mem_f20Elements_iff _).mpr
      exact standardF20.mul_mem
        (standardF20.mul_mem hk ((mem_f20Elements_iff a).mp ha))
        (standardF20.inv_mem hk)
    · rw [hh]
      simp [mul_assoc]

/-- Every conjugate of `F₂₀` has a unique representative among the six
permutations fixing `0` and `1`. -/
theorem existsUnique_pointwise_standardF20_conjugate (g : S5) :
    ∃! h : pointwiseStabilizer01,
      standardF20.map (MulAut.conj h.1).toMonoidHom =
        standardF20.map (MulAut.conj g).toMonoidHom := by
  obtain ⟨h, hh⟩ := pointwiseToF20Coset_bijective.2 (g : F20Cosets)
  have hsame : Fin5TransitiveC5.sameCosetB h.1 g = true :=
    (Fin5TransitiveC5.sameCosetB_eq_true h.1 g).mpr hh
  have hcarrier : conjugateF20Elements h.1 = conjugateF20Elements g :=
    sameF20Coset_conjugateF20Elements h.1 g hsame
  have hconj : standardF20.map (MulAut.conj h.1).toMonoidHom =
      standardF20.map (MulAut.conj g).toMonoidHom := by
    ext x
    rw [← mem_conjugateF20Elements_iff h.1 x,
      ← mem_conjugateF20Elements_iff g x, hcarrier]
  refine ⟨h, hconj, ?_⟩
  intro k hk
  exact pointwise_conjugates_injective (hk.trans hconj.symm)

theorem six_distinct_standardF20_conjugates :
    Nat.card pointwiseStabilizer01 = 6 ∧
      Function.Injective
        (fun g : pointwiseStabilizer01 ↦
          standardF20.map (MulAut.conj g.1).toMonoidHom) :=
  ⟨natCard_pointwiseStabilizer01, pointwise_conjugates_injective⟩

end LeanProofs.PolynomialFormulas.Fin5TransitiveClassification
