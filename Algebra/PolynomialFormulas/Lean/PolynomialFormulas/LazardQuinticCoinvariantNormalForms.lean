def reconstructed (j : Fin 6) : SparsePolynomial :=
  (normalForm j).add (SparsePolynomial.sum [
    (quotient j 0).mul (relation 0),
    (quotient j 1).mul (relation 1),
    (quotient j 2).mul (relation 2),
    (quotient j 3).mul (relation 3),
    (quotient j 4).mul (relation 4)
  ])

set_option maxRecDepth 200000 in
set_option maxHeartbeats 40000000 in
theorem reduction_certificate (j : Fin 6) :
    SparsePolynomial.normalize (candidateSource j) =
      SparsePolynomial.normalize (reconstructed j) := by
  fin_cases j <;> decide

theorem eval_reconstructed {R : Type*} [CommRing R]
    (j : Fin 6) (x : Fin 5 → R) :
    SparsePolynomial.eval (candidateSource j) x =
      SparsePolynomial.eval (reconstructed j) x :=
  SparsePolynomial.eval_eq_of_normalize_eq (reduction_certificate j) x

def powersDegree (a : Powers) : ℕ :=
  a.p0 + a.p1 + a.p2 + a.p3 + a.p4

def sparseCoefficient (p : SparsePolynomial) (a : Powers) : ℤ :=
  ((p.filter fun term ↦ term.powers = a).map SparseTerm.coeff).sum

def signedCoefficient (p : SparsePolynomial) (a : Powers) : ℤ :=
  (-1 : ℤ) ^ powersDegree a * sparseCoefficient p a

def explicitPivotPowers : Fin 6 → Powers := ![
  ⟨0, 0, 0, 0, 0⟩,
  ⟨0, 1, 2, 1, 0⟩,
  ⟨0, 2, 2, 1, 0⟩,
  ⟨1, 2, 2, 1, 0⟩,
  ⟨2, 2, 2, 1, 0⟩,
  ⟨3, 2, 2, 1, 0⟩
]

def expectedPivotDiagonal : Fin 6 → ℤ := ![1, 2, 2, 2, 2, 4]

theorem signedCoefficient_normalForm_explicitPivot (row column : Fin 6) :
    signedCoefficient (normalForm column) (explicitPivotPowers row) =
      if row = column then expectedPivotDiagonal row else 0 := by
  fin_cases row <;> fin_cases column <;> decide

def IsStandardPowers (a : Powers) : Prop :=
  a.p0 < 5 ∧ a.p1 < 4 ∧ a.p2 < 3 ∧ a.p3 < 2 ∧ a.p4 < 1

theorem normalForm_standard (j : Fin 6) :
    ∀ term ∈ normalForm j, IsStandardPowers term.powers := by
  fin_cases j <;> simp [normalForm, IsStandardPowers]

