import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
import Mathlib.Tactic.NormNum
import PolynomialFormulas.LazardOptimality

/-!
# The cyclotomic obstruction to Lazard's stated optimality argument

Lazard's Definition 1 permits a simple radical step obtained by adjoining
`z` whenever `z ^ p` lies in the preceding field for *some prime* `p`.
It does not require the resulting extension to have degree `p`.

This file records a concrete obstruction in one common ambient field.  In
the `55`th cyclotomic field, adjoining a primitive `11`th root is a literal
one-step radical extension of `ℚ`, but that subfield does not contain the
primitive fifth root already present in the ambient field.  Consequently,
radicality in the sense of Definition 1 cannot by itself force the fifth
root of unity used in Lazard's Theorems 3 and 4.

The later quintic counterexample uses the cyclic quintic real subfield of
this `11`th-cyclotomic subfield.  The results here isolate and kernel-check
the exact invalid inference independently of that explicit polynomial.
-/

namespace LeanProofs.PolynomialFormulas.LazardOptimalityCyclotomicCounterexample

open IntermediateField
open LeanProofs.PolynomialFormulas.LazardOptimality

set_option autoImplicit false

/-- A common ambient field containing primitive roots of orders `11` and
`5`. -/
abbrev Ambient := CyclotomicField 55 ℚ

/- `CyclotomicField.isCyclotomicExtension` currently requires the
non-vanishing of the conductor in the base field as an explicit instance.
Record that elementary fact locally so the chosen cyclotomic generator is
available without adding it as a hypothesis to every statement below. -/
local instance conductor_neZero : NeZero (55 : ℚ) := ⟨by norm_num⟩

local instance eleven_prime : Fact (Nat.Prime 11) := ⟨by decide⟩

noncomputable local instance ambient_isCyclotomicExtension :
    IsCyclotomicExtension {55} ℚ Ambient :=
  CyclotomicField.isCyclotomicExtension 55 ℚ

/-- Mathlib's chosen primitive `55`th root in the common ambient field. -/
noncomputable def zeta55 : Ambient :=
  IsCyclotomicExtension.zeta 55 ℚ Ambient

/-- The primitive `11`th root obtained from `zeta55`. -/
noncomputable def zeta11 : Ambient := zeta55 ^ 5

/-- The primitive fifth root obtained from `zeta55`. -/
noncomputable def zeta5 : Ambient := zeta55 ^ 11

theorem zeta55_isPrimitiveRoot : IsPrimitiveRoot zeta55 55 := by
  exact IsCyclotomicExtension.zeta_spec 55 ℚ Ambient

theorem zeta11_isPrimitiveRoot : IsPrimitiveRoot zeta11 11 := by
  exact IsPrimitiveRoot.pow (by norm_num : 0 < 55)
    zeta55_isPrimitiveRoot (by norm_num : 55 = 5 * 11)

theorem zeta5_isPrimitiveRoot : IsPrimitiveRoot zeta5 5 := by
  exact IsPrimitiveRoot.pow (by norm_num : 0 < 55)
    zeta55_isPrimitiveRoot (by norm_num : 55 = 11 * 5)

/-- The `11`th-cyclotomic subfield inside the common ambient field. -/
noncomputable abbrev ElevenField : IntermediateField ℚ Ambient :=
  ℚ⟮zeta11⟯

/-- The subfield generated by `zeta11` is, intrinsically, an `11`th
cyclotomic extension of `ℚ`. -/
noncomputable instance elevenField_isCyclotomicExtension :
    IsCyclotomicExtension {11} ℚ ElevenField := by
  have hAlgebra :
      ElevenField.algebra =
        (DivisionRing.toRatAlgebra : Algebra ℚ ElevenField) :=
    Subsingleton.elim _ _
  rw [← hAlgebra]
  simpa only [ElevenField] using
    zeta11_isPrimitiveRoot.intermediateField_adjoin_isCyclotomicExtension ℚ

/-- Adjoining `zeta11` is a simple radical step under Lazard's literal
Definition 1: the prime exponent is `11` and `zeta11 ^ 11 = 1`. -/
theorem elevenField_isSimpleRadicalStep :
    IsSimpleRadicalStep ℚ Ambient
      (⊥ : IntermediateField ℚ Ambient) ElevenField := by
  refine ⟨zeta11, 11, by decide, ?_, ?_⟩
  · rw [zeta11_isPrimitiveRoot.pow_eq_one]
    exact one_mem _
  · simp [ElevenField]

theorem elevenField_isRadicalExtension :
    IsRadicalExtension ℚ Ambient
      (⊥ : IntermediateField ℚ Ambient) ElevenField :=
  elevenField_isSimpleRadicalStep.isRadicalExtension

/-- The extension generated by `zeta11` has degree `10`, not degree `11`
and not degree `5`.  This is the numerical failure in the proof of Lazard's
Theorem 3. -/
theorem elevenField_finrank : Module.finrank ℚ ElevenField = 10 := by
  rw [IsCyclotomicExtension.finrank ElevenField
    (Polynomial.cyclotomic.irreducible_rat (by norm_num : 0 < 11))]
  exact (Nat.totient_prime (by decide : Nat.Prime 11)).trans (by decide)

/-- No primitive fifth root in the common ambient field can belong to the
`11`th-cyclotomic subfield. -/
theorem primitiveFifthRoot_not_mem_elevenField
    {xi : Ambient} (hxi : IsPrimitiveRoot xi 5) : xi ∉ ElevenField := by
  intro hximem
  let xiInElevenField : ElevenField := ⟨xi, hximem⟩
  have hprimitive : IsPrimitiveRoot xiInElevenField 5 := by
    apply IsPrimitiveRoot.coe_submonoidClass_iff.mp
    simpa only [xiInElevenField] using hxi
  have hdiv : 5 ∣ 2 * 11 :=
    hprimitive.dvd_of_isCyclotomicExtension (n := 11) (by decide)
  norm_num at hdiv

/-- Although the ambient field contains `zeta5`, the radical subfield
generated by `zeta11` does not. -/
theorem zeta5_not_mem_elevenField : zeta5 ∉ ElevenField :=
  primitiveFifthRoot_not_mem_elevenField zeta5_isPrimitiveRoot

/-- A concise formal refutation of the inference "a radical extension in
Lazard's sense must contain the primitive fifth root in the ambient field".
The left conjunct is the literal radical tower; the right conjunct says the
displayed primitive fifth root is absent from it. -/
theorem radicalExtension_without_primitiveFifthRoot :
    IsRadicalExtension ℚ Ambient
        (⊥ : IntermediateField ℚ Ambient) ElevenField ∧
      IsPrimitiveRoot zeta5 5 ∧ zeta5 ∉ ElevenField :=
  ⟨elevenField_isRadicalExtension, zeta5_isPrimitiveRoot,
    zeta5_not_mem_elevenField⟩

end LeanProofs.PolynomialFormulas.LazardOptimalityCyclotomicCounterexample
