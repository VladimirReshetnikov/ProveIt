/-- The row computed directly from the executable polynomial combinatorics.
It is retained as a diagnostic reference; the public certificate uses the
sparse row below, whose literal polynomial semantics are checked in
`LazardInvariantModularProductBridge`. -/
def degreeSevenComputedProductRow (i : Fin 159) :
    DegreeSevenCoordinates := fun j =>
  (productRow 7 (degreeSevenProductSource i)).getD j.1 0

/-- The sparse, kernel-evaluable row used by the dual certificate.  The
product bridge checks, in sixteen independent blocks, that every such row
denotes the advertised elementary-symmetric product. -/
def degreeSevenProductRow (i : Fin 159) : DegreeSevenCoordinates := fun j =>
  if j ∈ productOneSupport i then 1
  else if j ∈ productTwoSupport i then 2
  else 0

