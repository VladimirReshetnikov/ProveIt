def dualVector (i : Fin 17) : DegreeSevenCoordinates := fun j =>
  if j ∈ dualOneSupport i then 1
  else if j ∈ dualTwoSupport i then 2
  else 0

def testVector (i : Fin 17) : DegreeSevenCoordinates :=
  Pi.single (testCoordinate i) 1

/-- Sum the selected coordinate projections without traversing all 132
coordinates. -/
def supportLinear (support : List (Fin 132)) :
    DegreeSevenCoordinates →ₗ[F3] F3 :=
  support.foldr
    (fun j total =>
      (LinearMap.proj j : DegreeSevenCoordinates →ₗ[F3] F3) + total)
    0

/-- Sparse realization of the functional with coefficients one and two. -/
def dualLinear (i : Fin 17) : DegreeSevenCoordinates →ₗ[F3] F3 :=
  supportLinear (dualOneSupport i) +
    (2 : F3) • supportLinear (dualTwoSupport i)

