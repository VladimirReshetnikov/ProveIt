/-! ## The quotient lower bound -/

def degreeSevenProductSubspace : Submodule F3 DegreeSevenCoordinates :=
  Submodule.span F3 (Set.range degreeSevenProductRow)

theorem degreeSeven_testClasses_linearIndependent :
    LinearIndependent F3 fun j =>
      degreeSevenProductSubspace.mkQ (testVector j) :=
  quotient_linearIndependent_of_dual_certificate
    degreeSevenProductRow testVector dualLinear
    dual_annihilates_degreeSevenProductRow dual_pairs_testVector

theorem degreeSeven_productQuotient_finrank_ge_seventeen :
    17 ≤ Module.finrank F3
      (DegreeSevenCoordinates ⧸ degreeSevenProductSubspace) := by
  simpa using degreeSeven_testClasses_linearIndependent.fintype_card_le_finrank

/-- No family of sixteen quotient classes can span the degree-seven
coordinate quotient certified above.  This is the precise linear-algebraic
form of the `17 > 16` obstruction; it does not rely on the diagnostic
Gaussian eliminator in `LazardInvariantModularCounterexample`. -/
theorem degreeSeven_productQuotient_not_spanned_by_sixteen
    (generators : Fin 16 →
      DegreeSevenCoordinates ⧸ degreeSevenProductSubspace) :
    Submodule.span F3 (Set.range generators) ≠ ⊤ := by
  intro hspan
  have hle : Module.finrank F3
      (DegreeSevenCoordinates ⧸ degreeSevenProductSubspace) ≤ 16 := by
    simpa using finrank_le_of_span_eq_top hspan
  have hge := degreeSeven_productQuotient_finrank_ge_seventeen
  omega

