$MaxExtraPrecision=1000;
ClearAll[x,t,L,k,m,j,n];
wp=100;degree=130;delta=1/10;
base=-1-EulerGamma x+Sum[(-1)^r Zeta[r]x^r,{r,2,degree}];
rows={};
Do[poly=Normal[Series[base^k,{x,0,degree}]];coeff=Table[Coefficient[poly,x,j],{j,0,degree}];
local=N[Sum[coeff[[j+1]]delta^(j-k+1)/(j-k+1),{j,k,degree}],wp];
pole=N[Sum[coeff[[j+1]]/(j-k+1),{j,0,k-2}],wp];
fun[y_?NumericQ]:=PolyGamma[0,y]^k-Sum[N[coeff[[j+1]],wp]y^(j-k),{j,0,k-1}];
ordinary=NIntegrate[fun[t],{t,delta,3/10,3/5,1},WorkingPrecision->wp,AccuracyGoal->65,PrecisionGoal->65];
value=pole+local+ordinary;
AppendTo[rows,<|"power"->k,"coordinate_finite_part"->ToString[value,InputForm],"working_precision"->wp|>];Print["power ",k," complete"],{k,{1,2,3,4,5,6}}];
q1=Abs[rows[[1]]["coordinate_finite_part"]//ToExpression];
q2=Abs[ToExpression[rows[[2]]["coordinate_finite_part"]]-N[2 StieltjesGamma[1]-2 Zeta[2],wp]];
q5=Abs[ToExpression[rows[[5]]["coordinate_finite_part"]]-N[ToExpression["-8.690303962624538266295589662365653576770293544923884292661591581220051685190663849631"],wp]];
exact=Table[TrueQ[FullSimplify[Residue[(L-Pi Cot[Pi x])^k,{x,0}]+((L+I Pi)^k-(L-I Pi)^k)/(2 I Pi)]===0],{k,1,10}];
control=TrueQ[FullSimplify[(2 StieltjesGamma[1]-2 Zeta[2]+1)-(2 StieltjesGamma[1]-2 Zeta[2])]===1];
record=<|"engine"->$Version,"exact_closed_residue_polynomials"->10,"exact_results"->exact,"all_exact_passed"->And@@exact,"local_taylor_degree"->degree,"local_split"->ToString[delta,InputForm],"working_precision"->wp,"powers"->rows,"checked_moment_diagnostics"->3,"Q1_absolute_residual"->ToString[q1,InputForm],"Q2_absolute_residual"->ToString[q2,InputForm],"Q5_independent_arithmetic_residual"->ToString[q5,InputForm],"corruption_controls"->1,"corruption_detected"->control,"interval_certified"->False,"all_pass"->(And@@exact&&control&&TrueQ[q1<10^-60&&q2<10^-60&&q5<10^-50]),"scope"->"Exact residue polynomials through degree ten; coordinate finite parts from local pole subtraction, a fixed Taylor split and ordinary quadrature through power six. Q1/Q2 are checked against known constants and Q5 against separately replayed independent harmonic arithmetic. Powers three, four and six are exploratory values here. Working precision and truncated-series agreement are not interval certificates or proofs of decimal accuracy."|>;
Export[FileNameJoin[{DirectoryName[$InputFileName],"digamma-powers-native.json"}],record,"RawJSON"];Print[<|"exact"->Length[exact],"diagnostics"->3,"all_pass"->record["all_pass"]|>];Exit[If[TrueQ[record["all_pass"]],0,1]];
