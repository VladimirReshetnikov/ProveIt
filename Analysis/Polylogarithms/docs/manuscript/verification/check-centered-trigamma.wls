$MaxExtraPrecision=1000;
ClearAll[z,x,j,k,r,n,t,u];
exact={};
aa=z-z^2/2+Sum[BernoulliB[2 k] z^(2 k+1),{k,1,16}];
Do[ss=(BernoulliB[2 j,1/z+1]-BernoulliB[2 j])/(2 j);
AppendTo[exact,TrueQ[Expand[Coefficient[Expand[aa ss],z,0]-(3-2 j)BernoulliB[2 j-2]/4]===0]];
AppendTo[exact,TrueQ[Expand[Coefficient[Expand[aa^2],z,2 j+1]+BernoulliB[2 j-2]]===0]],{j,1,12}];
value[r_]:=3 BernoulliB[2 r,1/2] Zeta[3]-Sum[Binomial[2 r,2 j](2 j-1)BernoulliB[2 r-2 j,1/2]BernoulliB[2 j-2]/(2(2 j+1)),{j,1,r}];
printed={3 Zeta[3],-Zeta[3]/4-1/6,7 Zeta[3]/80+1/30,-31 Zeta[3]/448+1/672,127 Zeta[3]/1280-17/540};
Do[AppendTo[exact,TrueQ[FullSimplify[value[r]-printed[[r+1]]]===0]],{r,0,4}];
cc[k_]:=cc[k]=Sum[BernoulliB[2 i,1/2]BernoulliB[2 k-2-2 i,1/2],{i,0,k-1}];
wp=85;
head[r_,nn_]:=Sum[N[(n+1/2)^(2 r)PolyGamma[1,n+1]^2-Sum[cc[k](n+1/2)^(2 r-2 k),{k,1,r}],wp],{n,0,nn-1}];
tail[r_,nn_,mm_]:=Sum[N[cc[k]Zeta[2 k-2 r,nn+1/2],wp],{k,r+1,mm}];
rows={};
Do[v1=head[r,120]+tail[r,120,24];v2=head[r,160]+tail[r,160,30];err=Abs[v2-N[value[r],wp]];ref=Abs[v1-v2];
AppendTo[rows,<|"kind"->"ordinary-subtracted-trigamma-square","r"->r,"absolute_residual"->ToString[err,InputForm],"refinement_difference"->ToString[ref,InputForm],"passed"->TrueQ[err<10^-38&&ref<10^-38]|>];Print["moment ",r," complete"],{r,0,3}];
Do[fun[v_?NumericQ]:=If[v==0,0,(tt-v)v^2 Coth[v/2]];
val=tt/(2 Sinh[tt/2])(3 Zeta[3]-NIntegrate[fun[u],{u,0,tt},WorkingPrecision->wp,AccuracyGoal->50,PrecisionGoal->50]/(4 tt));
target=tt/(2 Sinh[tt/2])(2 Zeta[3]-tt^3/48-tt PolyLog[2,Exp[-tt]]/2-2 PolyLog[3,Exp[-tt]]+3(Zeta[4]-PolyLog[4,Exp[-tt]])/tt);
err=Abs[val-N[target,wp]];AppendTo[rows,<|"kind"->"polylogarithmic-generator-quadrature","t"->ToString[tt,InputForm],"absolute_residual"->ToString[err,InputForm],"passed"->TrueQ[err<10^-45]|>],{tt,{1/3,7/6,5/2}}];
control=TrueQ[FullSimplify[value[1]-(printed[[2]]+1)]===-1];
record=<|"engine"->$Version,"exact_checks"->Length[exact],"exact_results"->exact,"exact_passed"->And@@exact,"corruption_controls"->1,"corruption_detected"->control,"working_precision"->wp,"series_heads"->{120,160},"asymptotic_tail_orders"->{24,30},"numerical_checks"->Length[rows],"rows"->rows,"interval_certified"->False,"all_pass"->(And@@exact&&control&&And@@Lookup[rows,"passed"]),"scope"->"Independent native finite Bernoulli constant-term algebra; ordinary subtracted trigamma series with two head/tail settings; ordinary quadrature versus the classical-polylogarithm generator. Refinements are diagnostics, not rigorous interval remainder bounds. All-order identities are established by finite summation and analytic continuation in the manuscript."|>;
Export[FileNameJoin[{DirectoryName[$InputFileName],"centered-trigamma-native.json"}],record,"RawJSON"];Print[<|"exact_checks"->Length[exact],"numerical_checks"->Length[rows],"all_pass"->record["all_pass"]|>];Exit[If[TrueQ[record["all_pass"]],0,1]];
