import Lib.PadicHodge.PeriodRings.Ainf

/-!
# The period rings A, B⁺, B and B_dR⁺: θ, Frobenius, domains and contraction

`New.Period.Ainf` is `A_inf`, for the prime `p` supplied by the class `ThePrime p`. In it, `ξ`
(`New.Period.xi`) generates the kernel of Fontaine's `θ`, `μ = [ε] - 1 = ξ τ` with
`τ = [ε^(1/p)] - 1`, where `ε ∈ O^♭` is a compatible system `(1, ζ_p, ζ_{p²}, …)` of `p`-power roots
of unity and `[·]` is the Teichmüller lift, and `φ` is the Frobenius. The map `θ` is defined on `A`,
`B⁺` and `B_dR⁺` (`New.Period.thetaBdR`). The file studies `A` modulo `p` and its divisibility by
powers of `p`. It shows that `θ` has kernel `ξ B⁺` on `B⁺` and that `B_dR⁺` is a discrete valuation
ring. It deduces that `A`, `B⁺` and `B` are domains.

## Main definitions and results

* `New.Period.Amax`: `A`, the `p`-adic completion of `A_inf[X] / (p X - ξ)`, with the existence half
  of its universal property, `New.Period.Amax.exists_lift`.
* `New.Period.BPlus`: `B⁺ = A[1/p]`; `New.Period.Bmax`: `B = B⁺[1/μ]`; `New.Period.BdRPlus`: the
  `ξ`-adic completion `B_dR⁺` of `B⁺`.
* `New.Period.actBmax`: the monoid `New.Period.FrobGal = ℕ × G_p`, with `G_p` the absolute Galois
  group of `ℚ_p`, in which `(n, g)` stands for `φ^n g`, acts on `A`, `B⁺` and `B`. On `B` this needs
  `New.Period.isUnit_smul_of_dvd_mu`, which rests on `New.Period.associated_p_frobEnd_xi`: `φ ξ` is
  `p` times a unit.
* `New.Period.thetaBPlus`: `θ` extends to `A`, with `X ↦ 0`, and to a map from `B⁺` onto `ℂ_[p]`
  (`New.Period.thetaBPlus_surjective`).
* `New.Period.BdRPlus.prime_xi`: `ξ` is prime in `B_dR⁺`, so `B_dR⁺` is a discrete valuation ring
  with uniformiser `ξ`.
* `New.Period.exists_Ainf_eq_of_contraction`: let `V ⊆ B⁺` (`New.Period.BPlus`) lie in the image
  `New.Period.amaxImage` of the period ring `A`, and let every `v ∈ V` satisfy `ξ ^ n v = u φ(w)`
  for some `w ∈ V`, with `u ∈ A_inf` fixed and `φ` the Frobenius. Then `p ^ (n + 1) V` lies in the
  image of `A_inf`: each application of `φ` improves an approximation by `A_inf` by one power of
  `p`.

Notions from other files:
* `New.Period.Ainf`: the ring `A_inf` of `p`-typical Witt vectors over the tilt `O^♭` of the ring of
  integers of `ℂ_p`.
* `New.Period.xi`: the element `ξ = ∑_{i < p} [ε^{1/p}]^i` of `A_inf`, so that `ξ τ = μ`.
* `New.Period.theta`: Fontaine's ring homomorphism `θ` from `A_inf` onto the ring `New.OC p` of
  integers of `ℂ_p`, sending the Teichmüller lift `[x]` to `x^♯`.

## Relation to the literature

Known; see `Lib.PadicHodge.PeriodRings.DeRhamPeriods` for sources.
-/

noncomputable section

section PeriodRings

namespace New.Period

open Ideal Polynomial AdjoinRoot nonZeroDivisors Adic Localization IsScalarTower algebraMap

variable {p : ℕ} [ThePrime p] (m : FrobGal) (a : Ainf)
  {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-! ### The rings -/

/-- The period ring A (Colmez's A_max): the p-adic completion of A_inf[X]/(pX − ξ). -/
def Amax : Type := PrincipalCompletion (AdjoinRoot (C p.cast * X - C xi)) p
deriving CommRing, Algebra Ainf, Algebra ℤ_[p], IsScalarTower ℤ_[p] Ainf

/-- The period ring B^+ = A[1/p], where A is `New.Period.Amax`. -/
def BPlus : Type := Away (p : Amax)
  deriving CommRing, Algebra Ainf, Algebra ℤ_[p], Algebra Amax, IsScalarTower ℤ_[p] Ainf,
  IsScalarTower Ainf Amax, IsScalarTower ℤ_[p] Amax

/-- The period ring B = B^+[1/μ] (Colmez's B_max), over which crystalline representations are
defined here. It is used in place of Fontaine's B_cris. The two rings are known to give the same
crystalline representations; that comparison is neither proved nor used here. -/
def Bmax : Type := Away (algebraMap Ainf BPlus mu)

/-! ### The ring `B_dR⁺` -/

/-- The ring B_dR^+, defined as the completion of B^+ with respect to the ideal generated by the
image of ξ. -/
def BdRPlus : Type := PrincipalCompletion BPlus (algebraMap Ainf BPlus xi)

variable [Algebra R BPlus] [Algebra S BPlus] [IsScalarTower R S BPlus] in
deriving instance CommRing, Algebra R, IsScalarTower R S for @Bmax p _, @BdRPlus p _

-- These instances apply to every ring `R` that `New.Period.BPlus` is an algebra over, so they are
-- tried late.
attribute [instance 50] instAlgebraBmaxOfBPlus instAlgebraBdRPlusOfBPlus

/-- The period ring A is `p`-adically complete, for the ideal generated by `p` in any ring `R` over
which it is an algebra. -/
instance [Algebra R Amax] : IsAdicComplete (span {(p : R)}) Amax :=
  isAdicComplete_over_base isAdicComplete

/-- The image of the period ring A in B^+ = A[1/p], as an A_inf-subalgebra. -/
def amaxImage : Subalgebra Ainf BPlus := (toAlgHom Ainf Amax BPlus).range

lemma mem_amaxImage_iff {y : BPlus} : y ∈ amaxImage ↔ ∃ b : Amax, algebraMap Amax BPlus b = y :=
  Iff.rfl

/-- The element X = ξ/p of the period ring A: the image of the variable of A_inf[X]/(pX − ξ). -/
def Amax.xiDivP : Amax := .of _ _ (root _)

open Amax IsLocalization Away Function MulSemiringAction

/-- B⁺ is the localization of the period ring A at the powers of p. -/
instance isLocalizationAway_p_bPlus : IsLocalization.Away (p : Amax) BPlus := isLocalization

/-- B is the localization of B⁺ at the powers of μ. -/
instance : IsLocalization.Away (mu : BPlus) Bmax := isLocalization

@[simp]
lemma BPlus.isUnit_p : IsUnit (p : BPlus) := mod_cast algebraMap_isUnit (p : Amax)

/-- For a commutative Z_p-algebra R and a ring homomorphism f: R → O_C, the composite of f with
the inclusion O_C ⊂ C_p, as a Z_p-algebra homomorphism R → C_p. -/
abbrev OC.toPadicIntAlgHom [Algebra ℤ_[p] R] (f : R →+* OC) : R →ₐ[ℤ_[p]] ℂ_[p] :=
  ⟨(valRingCp p).subtype.comp f, fun a ↦ by
    -- The canonical map `ℤ_[p] → ℂ_[p]` has values of norm at most one, so it lands in `OC`.
    have h_mem (b : ℤ_[p]) : algebraMap ℤ_[p] ℂ_[p] b ∈ valRingCp p := by
      have h_norm : ‖algebraMap ℤ_[p] ℂ_[p] b‖ ≤ 1 :=
        (norm_algebraMap' ℂ_[p] (b : ℚ_[p])).trans_le b.2
      simpa
    -- It agrees with `f` on the natural numbers, which approximate any `b` modulo `p ^ n`.
    have h_eq :
        f.comp (algebraMap ℤ_[p] R) =
          RingHom.codRestrict (algebraMap ℤ_[p] ℂ_[p]) (valRingCp p) h_mem :=
      ringHom_ext_of_approx fun b n ↦ ⟨b.appr n, by simp, mem_span_singleton.1 (b.appr_spec n)⟩
    exact congr(($h_eq a).1)⟩

@[simp ←]
lemma p_mul_X : p * Amax.xiDivP = xi :=
  -- the root of `p X - ξ` satisfies `p X = ξ` in `A_inf[X] / (p X - ξ)`; map it to the completion
  congr(.of _ _ $(sub_eq_zero.mp mk_self))

/-- The prime p is not a zero divisor in the period ring A, so A is p-torsion free. -/
lemma Amax.p_mem_nonZeroDivisors : ↑p ∈ Amax⁰ := by
  -- The ring obtained by adjoining a root of `p X - ξ` has no `p`-torsion, and this passes to its
  -- `p`-adic completion.
  have h_reg : IsSMulRegular (AdjoinRoot (C (p : Ainf) * .X - C xi)) p := by
    refine .of_right_eq_zero_of_smul fun y hy ↦ ?_
    obtain ⟨f, rfl⟩ := mk_surjective y
    have h_dvd : C (p : Ainf) * .X - C xi ∣ C (p : Ainf) * f :=
      mk_eq_zero.mp ((nsmul_eq_mul p _).symm.trans hy)
    -- `p` is prime in the polynomial ring: it divides `p X - ξ`, or `p X - ξ` divides `f`
    rcases (prime_C_iff.mpr Ainf.prime_p).left_dvd_or_dvd_right_of_dvd_mul h_dvd with
      hp_dvd | h_dvd_f
    · -- impossible: on constant coefficients, `p` would divide `ξ`
      have h_const : (p : Ainf) ∣ xi := by simpa using map_dvd constantCoeff hp_dvd
      exact absurd h_const not_p_dvd_xi
    · exact mk_eq_zero.mpr h_dvd_f
  refine mem_nonZeroDivisors_iff_left.mpr fun x hx ↦ ?_
  exact (isSMulRegular_completion h_reg).right_eq_zero_of_smul ((nsmul_eq_mul p x).trans hx)

/-- The universal property of `A`: a ring map `f` from `A_inf` to a `p`-adically complete ring, with
an `x` such that `p x = f ξ`, extends to `A` with `X ↦ x`. -/
lemma Amax.exists_lift [IsAdicComplete (span {(p : R)}) R] (f : Ainf →+* R) (x : R)
    (h_xi : f xi = p * x) :
    ∃ F : Amax →+* R, (∀ a : Ainf, F ↑a = f a) ∧ F xiDivP = x := by
  -- Send the root of `p X - ξ` to `x`, pass to the `p`-adic completions, and use that `R` is
  -- complete.
  have h_root : (C (p : Ainf) * .X - C xi).eval₂ f x = 0 := by simp [h_xi]
  let F₀ : AdjoinRoot (C (p : Ainf) * .X - C xi) →+* R := AdjoinRoot.lift f x h_root
  let e : R ≃ₐ[R] AdicCompletion (span {(p : R)}) R := AdicCompletion.ofAlgEquiv (span {(p : R)})
  refine ⟨e.symm.toRingHom.comp (adicMap F₀ (by simp)), fun a ↦ ?_, ?_⟩
  -- `erw`: the composite is typed through `Amax`, which is the completion only by definition, so a
  -- plain `rw` finds no type-correct motive.
  all_goals
    erw [RingHom.comp_apply, adicMap_algebraMap]
    simp [F₀, e]

/-- The image in `A` of an element of `(p, ξ) ^ n` is divisible by `p ^ n`. -/
lemma Amax.p_pow_dvd_of_mem_pow {n : ℕ} {a : Ainf} (h_mem : a ∈ span {↑p, xi} ^ n) :
    (p : Amax) ^ n ∣ a := by
  -- In `Amax` both `p` and `ξ = p X` are multiples of `p`.
  have h_le : span {(p : Ainf), xi} ≤ (span {(p : Amax)}).comap (algebraMap _ Amax) := by
    simp [span_insert, mul_mem_right, ← p_mul_X]
  simpa [span_singleton_pow, mem_span_singleton] using
    le_comap_pow _ n (pow_right_mono h_le n h_mem)

/-- Every element of `A` is congruent modulo `p ^ n` to a polynomial in `X = ξ / p` with
coefficients in `A_inf`. -/
lemma Amax.exists_p_pow_dvd_sub_aeval (a : Amax) (n : ℕ) :
    ∃ P : Ainf[X], (p : Amax) ^ n ∣ a - aeval xiDivP P := by
  -- `a` is congruent modulo `p ^ n` to an element `P(X)` of `A_inf[X] / (p X - ξ)`
  obtain ⟨y, hy⟩ := Adic.exists_approx a n
  obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective y
  refine ⟨P, ?_⟩
  -- `A` is that completion, and `X` the image of the root, by definition
  simp only [← AdjoinRoot.aeval_eq, ← aeval_algebraMap_apply] at hy
  exact hy

/-- For every `y` in the period ring A and every `n`, some `p ^ d (y - p ^ n w)`, with `w` in A, is
the image of an element of `A_inf`. -/
lemma Amax.exists_algebraMap_eq_p_pow_mul_sub (y : Amax) (n : ℕ) :
    ∃ d : ℕ, ∃ a : Ainf, ∃ w : Amax, (a : Amax) = p ^ d * (y - p ^ n * w) := by
  -- Approximate `y` modulo `p ^ n` by a polynomial `f` in `X`. As `p * X = xi`, the product
  -- `p ^ f.natDegree * f X` is the value of `f.scaleRoots p` at `xi`, which lies in `Ainf`.
  obtain ⟨f, c, hc⟩ : ∃ (f : Ainf[X]) (c : Amax), y - aeval xiDivP f = p ^ n * c :=
    y.exists_p_pow_dvd_sub_aeval n
  have h_scale :
      algebraMap _ Amax ((f.scaleRoots p).eval xi) = p ^ f.natDegree * aeval xiDivP f := by
    -- `eval₂` of `f.scaleRoots p` at `p X = ξ` is `p ^ deg f * f(X)`
    have h_eval := scaleRoots_eval₂_mul (p := f) (algebraMap Ainf Amax) xiDivP (p : Ainf)
    rwa [map_natCast, p_mul_X, eval₂_at_apply, ← aeval_def] at h_eval
  exact ⟨f.natDegree, (f.scaleRoots p).eval xi, c, by rwa [← hc, sub_sub_cancel]⟩

/-! ### The action of Frobenius and of the Galois group -/

/-- Frobenius and `G_p` act on `A`. -/
instance actAmax : MulSemiringAction FrobGal Amax := by
  -- Each `m : FrobGal` acts by the endomorphism given by `exists_lift`: it extends the action of
  -- `m` on `Ainf` and sends `X = ξ / p` to `(m • ξ) / p`. The quotient exists since `m • ξ` lies in
  -- the ideal `(p, ξ)`.
  refine extendAction FrobGal (algebraMap Ainf Amax) _
    (fun _ ↦
      (exists_lift ((algebraMap Ainf Amax).comp (toRingHom FrobGal Ainf _)) _
        (pow_one (p : Amax) ▸ p_pow_dvd_of_mem_pow (by simp
          [smul_xi_mem_span])).choose_spec).choose_spec.1)
    fun {F G} h ↦ ringHom_ext_of_approx (p := p) fun y n ↦ ?_
  -- Endomorphisms that agree on `Ainf` are equal: `y` is congruent modulo `p ^ n` to an element
  -- `a / p ^ d` with `a` in `Ainf`, where they agree as `p` is not a zero divisor.
  obtain ⟨d, a, w, ha⟩ := exists_algebraMap_eq_p_pow_mul_sub y n
  refine ⟨y - p ^ n * w, ?_, w, sub_sub_cancel ..⟩
  simpa [ha, pow_mem, mul_cancel_left_mem_nonZeroDivisors, p_mem_nonZeroDivisors] using h a

/-- The action on A extends the action on `A_inf`. -/
instance : SMulDistribClass FrobGal Ainf Amax :=
  smulDistribClass_of_tower <| by
    -- the endomorphisms chosen in `actAmax` extend the action on `Ainf`
    delta actAmax
    generalize_proofs
    tauto

/-- Frobenius and `G_p` act on `B⁺`. -/
instance actBPlus : MulSemiringAction FrobGal BPlus := locAction _ (p : Amax) (by simp)

/-- The action on B⁺ extends the action on A. -/
instance : SMulDistribClass FrobGal Amax BPlus := smulDistribClass_of_tower (lift_eq _)

/-- The action on B⁺ extends the action on `A_inf`. -/
instance : SMulDistribClass FrobGal Ainf BPlus := smulDistribClass_of_tower (lift_eq _)

/-- B⁺ is a `ℚ_p`-algebra, since `p` is a unit of B⁺. -/
instance : Algebra ℚ_[p] BPlus :=
  (lift (g := algebraMap ℤ_[p] BPlus) fun y : ℤ_[p]⁰ ↦ by
    -- `y` is a unit times a power of `p`, and `p` is a unit of `BPlus`
    rw [PadicInt.unitCoeff_spec (coe_ne_zero y)]
    simp [IsUnit.map, IsUnit.pow]).toAlgebra

/-- The `ℤ_p`-algebra structure of B⁺ factors through `ℚ_p`. -/
instance : IsScalarTower ℤ_[p] ℚ_[p] BPlus := of_algHom ⟨_, lift_eq _⟩

/-- The image of φ(ξ) in the period ring A equals p up to a unit of A. -/
lemma associated_p_frobEnd_xi : Associated (p : Amax) ↑(frobEnd xi) := by
  -- Write `ξ = t + p u` with `t` a Teichmüller lift and `u` a unit. Then `φ ξ = t ^ p + p φ u`, and
  -- `t ^ p = p ^ 2 c` in `Amax`, so `φ ξ = p (p c + φ u)`, where the second factor is a unit.
  set t : Ainf := .teichmuller p (WittVector.constantCoeff xi) with ht
  obtain ⟨u, hu⟩ : ∃ u : Ainfˣ, p * u.val = xi - t := associated_p_xi_sub_teichmuller
  have h_mem : t ∈ span {(p : Ainf), xi} := by simp [ht, Witt.mem_span_pair_iff]
  obtain ⟨c, hc⟩ : (p : Amax) ^ 2 ∣ algebraMap _ _ (t ^ p) :=
    p_pow_dvd_of_mem_pow (pow_le_pow_right (Fact.out : p.Prime).two_le (pow_mem_pow h_mem p))
  set v : Amax := algebraMap _ Amax (frobEnd (u : Ainf)) with hv
  have h_eq : algebraMap _ Amax (frobEnd xi) = p * (p * c + v) := by
    rw [eq_add_of_sub_eq' hu.symm, map_add, frobEnd_teichmuller, map_add, hc]
    simp [hv, sq, mul_assoc, ← mul_add]
  -- `p c + φ u` is congruent to a unit modulo `p`, in a `p`-adically complete ring
  have h_dvd_sub : (p : Amax) ∣ p * c + v - v := ⟨c, add_sub_cancel_right _ _⟩
  have h_unit : IsUnit (p * c + v) := isUnit_of_dvd_sub ((u.isUnit.map _).map _) h_dvd_sub
  exact ⟨h_unit.unit, h_eq.symm⟩

/-- If `a ∈ A_inf` divides `μ`, then for every `m = (n, g)` in `FrobGal = ℕ × G_p` the image of
`m • a = φ^n (g a)` in B = B^+[1/μ] is a unit. -/
lemma isUnit_smul_of_dvd_mu {a : Ainf} (ha : a ∣ mu) : IsUnit (↑(m • a) : Bmax) := by
  -- With `m = (n, g)`: `φ^n (g a)` divides `μ` in `BPlus`, and `μ` is inverted in `Bmax`.
  obtain ⟨n, g⟩ := m
  have h_dvd (k : ℕ) : algebraMap _ BPlus (frobEnd^[k] (g • a)) ∣ algebraMap _ _ mu := by
    induction k with
    | zero =>
      -- `g a` divides `g μ = φ (g τ)`, and `g τ` is `τ` up to a unit, with `φ τ = μ`
      have h_smul : g • a ∣ g • mu := map_dvd (MulSemiringAction.toRingHom _ _ g) ha
      have h_mu : g • mu ∣ mu := by grw [← frobEnd_tau, smul_frobEnd, associated_smul_tau.dvd]
      exact map_dvd _ (h_smul.trans h_mu)
    | succ k ih =>
      -- apply `φ`: `φ μ = φ ξ * φ τ = φ ξ * μ`, and `φ ξ` divides `p` in `Amax`, so it is a unit of
      -- `BPlus = Amax[1/p]`
      have h_unit : IsUnit (algebraMap _ BPlus (algebraMap _ Amax (frobEnd xi))) :=
        isUnit_of_dvd _ associated_p_frobEnd_xi.symm.dvd
      rw [← h_unit.dvd_mul_left, iterate_succ_apply']
      show algebraMap Ainf BPlus (frobEnd (frobEnd^[k] (g • a))) ∣
        algebraMap Amax BPlus (algebraMap Ainf Amax (frobEnd xi)) * algebraMap Ainf BPlus mu
      simpa [← xi_mul_tau, Algebra.cast, ← IsScalarTower.algebraMap_apply, -isUnit_map_iff] using
        map_dvd frobEnd ih
  -- `(n, g) • a = φ^n (g a)`, and the coercion to `Bmax` goes through `BPlus`
  have h_unit_B :
      IsUnit (algebraMap BPlus Bmax (algebraMap Ainf BPlus (frobEnd^[n.toAdd] (g • a)))) :=
    isUnit_of_dvd (S := Bmax) _ (h_dvd n.toAdd)
  simpa [← FrobGal.smul_def, Algebra.cast, ← IsScalarTower.algebraMap_apply, -isUnit_map_iff] using
    h_unit_B

open scoped Classical in
/-- Frobenius and `G_p` act on `B`. -/
instance actBmax : MulSemiringAction FrobGal Bmax :=
  locAction _ (mu : BPlus) (by simp [← algebraMap_apply, isUnit_smul_of_dvd_mu])

/-- If the action on B⁺ extends an action on a ring `R` below it, so does the action on B. -/
instance [SMul FrobGal R] [Algebra R BPlus] [SMulDistribClass FrobGal R BPlus] :
    SMulDistribClass FrobGal R Bmax :=
  smulDistribClass_of_tower (lift_eq _)

/-! ### The map `θ` -/

/-- The ring homomorphism from the period ring A to the integers of C_p that extends Fontaine's
θ on A_inf and sends X = ξ/p to 0. -/
def thetaAmax : Amax →+* OC := (exists_lift theta 0 (by simp)).choose

/-- The ring homomorphism θ: B^+ = A[1/p] → C_p extending `New.Period.thetaAmax`. -/
def thetaBPlus : BPlus →ₐ[ℚ_[p]] ℂ_[p] :=
  (Away.liftAlgHom (p : Amax) (f := OC.toPadicIntAlgHom thetaAmax)
      (by simp [NeZero.ne])).extendScalarsOfIsLocalization ℚ_[p] ℤ_[p]⁰

/-- On `A_inf`, `θ` of the period ring A is Fontaine's `θ`. -/
@[simp]
lemma thetaAmax_algebraMap : thetaAmax a = theta a := by grind [thetaAmax]

/-- On A, `θ` of B⁺ is `θ` of A followed by the inclusion of `O_C` into `ℂ_p`. -/
@[simp]
lemma thetaBPlus_algebraMap_Amax (a : Amax) : thetaBPlus a = (thetaAmax a).val := lift_eq _ a

/-- On `A_inf`, `θ` of B⁺ is Fontaine's `θ` followed by the inclusion of `O_C` into `ℂ_p`. -/
@[simp]
lemma thetaBPlus_ainf : thetaBPlus a = (theta a).val :=
  (thetaBPlus_algebraMap_Amax _).trans (by simp)

/-- The map `thetaBPlus` : B⁺ → ℂ_p is onto. It is Fontaine's θ on the period ring B⁺ = A[1/p],
where A is `Amax`, and it extends θ on `Amax`. -/
lemma thetaBPlus_surjective : Surjective thetaBPlus := by
  -- Write `x = a / p ^ n` with `a` in `OC` and lift `a` to `b` along `theta`; then `b / p ^ n` maps
  -- to `x`.
  refine (lift_surjective_iff _).2 fun x ↦ ?_
  obtain ⟨n, a, ha⟩ : ∃ (n : ℕ) (a : OC),
      x * algebraMap OC ℂ_[p] (p : OC) ^ n = algebraMap OC ℂ_[p] a :=
    surj (p : OC) x
  obtain ⟨b, rfl⟩ : ∃ b : Ainf, theta b = a := theta_surjective a
  let d : Submonoid.powers (p : Amax) := ⟨p ^ n, n, rfl⟩
  have h_frac : x * OC.toPadicIntAlgHom thetaAmax d = OC.toPadicIntAlgHom thetaAmax b := by
    simpa [d] using ha
  exact ⟨((b : Amax), d), h_frac⟩

end New.Period

end PeriodRings

/-!
## Structure of A: reduction modulo p and divisibility by powers of p

* `New.Period.Amax.exists_reduction_mod_p`: modulo `p` the ring A is the polynomial ring over
  `A_inf / (p, ξ)`.
* `New.Period.Amax.mem_span_pow_of_p_pow_dvd`: divisibility by `p ^ m` in A, of an element of
  `A_inf`, means membership in `(p, ξ) ^ m`.
-/

namespace New.Period.Amax

open algebraMap Ideal Quotient Polynomial Set

variable {p : ℕ} [ThePrime p] {f : Ainf[X]}

/-- Let A (`Amax`) be the p-adic completion of A_inf[X]/(pX − ξ), and write `X` also for the image
of the variable in A, so that p·X = ξ. There is a ring homomorphism from A to (A_inf/(p, ξ))[X] with
kernel pA that sends P(X) to the reduction of P for every polynomial P over A_inf; so
A/p = (A_inf/(p, ξ))[X]. -/
lemma exists_reduction_mod_p :
    ∃ F : Amax →+* (Ainf ⧸ span {(p : Ainf), xi})[X],
      (∀ P : Ainf[X], F (aeval xiDivP P) = P.map (mk (span {↑p, xi}))) ∧
      ∀ y : Amax, ↑p ∣ y ↔ F y = 0 := by
  let R : Type := (Ainf ⧸ span {(p : Ainf), xi})[X]
  -- `p` and `ξ` vanish in `A_inf / (p, ξ)`, hence in `R`
  have h_zero {c : Ainf} (hc : c ∈ span {(p : Ainf), xi}) : algebraMap Ainf R c = 0 := by
    rw [Polynomial.algebraMap_apply, Quotient.algebraMap_eq, eq_zero_iff_mem.mpr hc, map_zero]
  have h_p_zero : (p : R) = 0 := by
    rw [← map_natCast (algebraMap Ainf R) p, h_zero (subset_span (by simp))]
  have h_xi : algebraMap Ainf R xi = p * .X := by
    rw [h_zero (subset_span (by simp)), h_p_zero, zero_mul]
  -- `R` is killed by `p`, so it is `p`-adically complete, and the universal property of `A` applies
  have h_complete : IsAdicComplete (span {(p : R)}) R := by
    rw [h_p_zero, Set.singleton_zero, span_zero]
    infer_instance
  obtain ⟨F, hF_alg, hF_X⟩ :
      ∃ F : Amax →+* R, (∀ c : Ainf, F c = algebraMap Ainf R c) ∧ F xiDivP = .X :=
    exists_lift (algebraMap Ainf R) .X h_xi
  have hF (P : Ainf[X]) : F (aeval xiDivP P) = P.map (mk (span {↑p, xi})) := by
    simp [R, hF_alg, hF_X, aeval_def, eval₂, sum, Polynomial.map]
  refine ⟨F, hF, fun y ↦ ⟨?_, fun hy ↦ ?_⟩⟩
  · rintro ⟨c, rfl⟩
    rw [map_mul, map_natCast, h_p_zero, zero_mul]
  -- write `y = P(X) + p c`; if `F y = 0` then the reduction of `P` vanishes
  obtain ⟨P, c, hc⟩ : ∃ (P : Ainf[X]) (c : Amax), y - aeval xiDivP P = p ^ 1 * c :=
    exists_p_pow_dvd_sub_aeval y 1
  obtain rfl : y = aeval xiDivP P + p * c := by linear_combination hc
  have h_map_zero : P.map (mk (span {↑p, xi})) = 0 := by
    rwa [map_add, map_mul, map_natCast, h_p_zero, zero_mul, add_zero, hF] at hy
  -- so every coefficient of `P` lies in `(p, ξ)`
  have hP_map : P ∈ (span {(p : Ainf), xi}).map C :=
    mem_map_C_iff.mpr fun i ↦ eq_zero_iff_mem.mp (by rw [← coeff_map, h_map_zero, coeff_zero])
  have hP_mem : P ∈ span {↑p, C xi} := by rwa [map_span, image_pair, map_natCast] at hP_map
  obtain ⟨a, b, rfl⟩ : ∃ a b : Ainf[X], a * p + b * C xi = P := mem_span_pair.mp hP_mem
  -- and `ξ = p X` is divisible by `p` in `Amax`
  refine ⟨aeval xiDivP a + aeval xiDivP b * xiDivP + c, ?_⟩
  rw [map_add, map_mul, map_mul, map_natCast, aeval_C]
  linear_combination -aeval xiDivP b * p_mul_X (p := p)

/-- Let `f` be a monic polynomial over `A_inf` and `X = ξ / p` (`xiDivP`). If `p ^ m` divides
`f(X) y` in the period ring A, then it divides `y`. -/
lemma p_pow_dvd_of_dvd_aeval_mul (hf_monic : f.Monic) (y : Amax) (m : ℕ)
    (h_dvd : (p : Amax) ^ m ∣ aeval xiDivP f * y) : (p : Amax) ^ m ∣ y := by
  -- it suffices to treat one factor `p`, which is a non-zero-divisor
  suffices h_one : ∀ z : Amax, (p : Amax) ∣ aeval xiDivP f * z → (p : Amax) ∣ z from
    pow_dvd_of_map (mul_left_comm _ _) p_mem_nonZeroDivisors h_one h_dvd
  -- modulo `p` we are in a polynomial ring, where the monic image of `f` is regular
  obtain ⟨F, hF, h_ker⟩ := exists_reduction_mod_p (p := p)
  simp [hF, h_ker, (hf_monic.map _).isRegular]

/-- Let `Amax` be the period ring A, the p-adic completion of A_inf[X]/(pX − ξ), and let `ν ∈ A_inf`
with `ξ` in the ideal `(p, ν)`, that is, `ν ∣ ξ - p b` for some `b ∈ A_inf`. For every `n` and every
`y` in A there are `a ∈ A_inf` and `z` in A with `p ^ n y = a + ν ^ n z`. -/
lemma exists_p_pow_mul_eq_add {ν : Ainf} (h_xi : ∃ b : Ainf, ν ∣ xi - p * b) (n : ℕ) (y : Amax) :
    ∃ (a : Ainf) (z : Amax), p ^ n * y = a + ν ^ n * z := by
  -- With `ξ - p b = ν g` we have `p (X - b) = ν g`. Divide by `X - b` with remainder in `Ainf`,
  -- so that each factor `p` yields a factor `ν`, up to an element of `Ainf`.
  obtain ⟨b, g, hξ⟩ := h_xi
  -- Every `z` is `c + (X - b) w` with `c` in `Ainf`. By `mem_range_of_approx` it suffices to show
  -- this modulo `p`, given that `shiftDiff` is onto for the source `Ainf × Amax`.
  have h_surj : Fact (shiftDiff (Ainf × Amax) (p : Ainf)).Surjective := ⟨fun u ↦ by
    obtain ⟨a, ha⟩ := (Fact.out : (shiftDiff Ainf (p : Ainf)).Surjective) fun j ↦ (u j).fst
    obtain ⟨z, hz⟩ := (Fact.out : (shiftDiff Amax (p : Ainf)).Surjective) fun j ↦ (u j).snd
    exact ⟨fun j ↦ (a j, z j), funext fun j ↦ Prod.ext (congrFun ha j) (congrFun hz j)⟩⟩
  let f : Ainf × Amax →+ Amax := (algebraMap Ainf Amax).toAddMonoidHom.coprod
    (.mulLeft (xiDivP - b))
  have h_div (z : Amax) : ∃ c : Ainf × Amax, f c = z := by
    refine mem_range_of_approx f (map_natCast_smul _ Ainf ℤ p) id (fun x ↦ ?_) z
    -- modulo `p` an element is a polynomial in `X`: divide that by `X - b`
    obtain ⟨P, y, hP⟩ := exists_p_pow_dvd_sub_aeval x 1
    -- `P = P(b) + (X - b) (P /ₘ (X - b))`, evaluated at `X`
    have h_divmod :
        aeval xiDivP P = ((P.eval b : Ainf) : Amax) + (xiDivP - b) * aeval xiDivP
          (P /ₘ (.X - C b)) := by
      simpa [modByMonic_X_sub_C_eq_C_eval] using
        congrArg (aeval xiDivP) (P.modByMonic_add_div (.X - C b)).symm
    have hx : x = aeval xiDivP P + p * y := by linear_combination hP
    refine ⟨(P.eval b, aeval xiDivP (P /ₘ (.X - C b))), y, ?_⟩
    simp [hx, h_divmod, f]
  have h_pX : (p : Amax) * (xiDivP - b) = ν * g := by
    simpa [mul_sub] using congrArg (algebraMap Ainf Amax) hξ
  induction n with
  | zero => exact ⟨0, by simp⟩
  | succ n ih =>
    obtain ⟨a, z, hy⟩ := ih
    obtain ⟨⟨c, w⟩, rfl⟩ := h_div z
    -- multiply `a + ν ^ n (c + (X - b) w)` by `p` and use `h_pX`
    refine ⟨p * (a + ν ^ n * c), g * w, ?_⟩
    have h_f : f (c, w) = (c : Amax) + (xiDivP - b) * w := rfl
    calc (p : Amax) ^ (n + 1) * y = p * (p ^ n * y) := by ring
      _ = p * (a + ν ^ n * c) + ν ^ n * (p * (xiDivP - b)) * w := by
        rw [hy, h_f]
        ring
      _ = ((p * (a + ν ^ n * c) : Ainf) : Amax) + ν ^ (n + 1) * (g * w) := by
        rw [h_pX]
        push_cast
        ring

/-- If the image in the period ring A of an element `a` of `A_inf` is divisible by `p ^ m`, then `a`
lies in the ideal `(p, ξ) ^ m` of `A_inf`. -/
lemma mem_span_pow_of_p_pow_dvd {a : Ainf} {m : ℕ} (h_dvd : (p : Amax) ^ m ∣ a) :
    a ∈ span {↑p, xi} ^ m := by
  induction m generalizing a with
  | zero => simp
  | succ m ih =>
    -- `θ a` is divisible by `p ^ (m + 1)`, so `a = ξ w + p ^ (m + 1) c`
    obtain ⟨c, hc⟩ :
        ∃ c : Ainf, thetaAmax (a : Amax) = thetaAmax ((p : Amax) ^ (m + 1)) * theta c :=
      theta_surjective.exists.mp (map_dvd thetaAmax h_dvd)
    have h_theta : theta (a - p ^ (m + 1) * c) = 0 := by aesop
    obtain ⟨w, hw⟩ : xi ∣ a - p ^ (m + 1) * c := theta_eq_zero_iff_xi_dvd.mp h_theta
    obtain rfl : a = xi * w + p * (p ^ m * c) := by linear_combination hw
    -- as `ξ = p X` and `p` is regular, `p ^ m` divides `X w`, hence `w`
    have h_Xw : (p : Amax) ^ m ∣ xiDivP * w := by
      simpa [pow_succ', mul_assoc, dvd_add_left,
        dvd_cancel_left_mem_nonZeroDivisors p_mem_nonZeroDivisors, -isUnit_map_iff] using h_dvd
    have hw_mem : w ∈ span {↑p, xi} ^ m :=
      ih (p_pow_dvd_of_dvd_aeval_mul monic_X w m (by rwa [aeval_X]))
    have hc_mem : p ^ m * c ∈ span {↑p, xi} ^ m := ih (by simp)
    rw [pow_succ']
    exact add_mem (mul_mem_mul (subset_span (by simp)) hw_mem)
      (mul_mem_mul (subset_span (by simp)) hc_mem)

end New.Period.Amax

/-!
## The kernel of θ on B⁺ and B_dR⁺; B_dR⁺ is a discrete valuation ring

* `New.Period.thetaBPlus_eq_zero_iff`, `New.Period.thetaBdR_eq_zero_iff`: on `B⁺` and on
  `B_dR⁺` the kernel of `θ` is generated by `ξ`.
* `New.Period.BdRPlus.isUnit_iff`: the units of `B_dR⁺` are the `x` with `θ x ≠ 0`.
* `New.Period.BdRPlus.prime_xi`: `ξ` is prime in `B_dR⁺`, which is a discrete valuation ring;
  `A`, `B⁺` and `B` are domains.
-/

section BdRPlus

namespace New.Period

open algebraMap Adic Ideal Polynomial IsLocalization.Away IsScalarTower Algebra Amax Function BPlus

variable {p : ℕ} {R : Type*} [ThePrime p]
  {y : BPlus} [CommRing R] [Algebra R BPlus] {x : BdRPlus} {a : Ainf}

/-- The natural map from the period ring `Amax` (Colmez's `A_max`, the p-adic completion of
`A_inf[X]/(pX − ξ)`) to `B⁺ = Amax[1/p]` is injective, since `p` is not a zero divisor in `Amax`. -/
lemma injective_Amax_BPlus : Injective ((↑) : Amax → BPlus) :=
  IsLocalization.injective _ (Submonoid.powers_le.mpr p_mem_nonZeroDivisors)

/-! ### The ring `B⁺` -/

/-- For every `y` in `B⁺ = A[1/p]` there is a power `p ^ m` such that `p ^ m * y` is the image of
an element `b` of the period ring `A`. -/
lemma BPlus.exists_p_pow_mul_eq_amax : ∃ (m : ℕ) (b : Amax), p ^ m * y = (b : BPlus) := by
  obtain ⟨m, b, hb⟩ : ∃ (m : ℕ) (b : Amax),
      y * algebraMap Amax BPlus (p : Amax) ^ m = algebraMap Amax BPlus b :=
    surj (p : Amax) y
  refine ⟨m, b, ?_⟩
  rw [mul_comm, ← map_natCast (algebraMap Amax BPlus) p]
  exact hb

/-- `τ = [ε^(1/p)] - 1` divides `ξ - p`: each of the `p` terms `[ε^(1/p)] ^ i` of `ξ` is congruent
to `1` modulo `τ`. -/
lemma tau_dvd_xi_sub_p : tau ∣ xi - p := by
  have h_sum : xi - p = ∑ i ∈ Finset.range p, (WittVector.teichmuller p epsRoot ^ i - 1) := by
    simp [xi]
  rw [h_sum, tau]
  exact Finset.dvd_sum fun i _ ↦ sub_one_dvd_pow_sub_one _ i

/-- `τ` divides `ξ - p * b` for some `b` in `A_inf` (namely `b = 1`): `ξ` lies in the ideal
`(p, τ)`. -/
lemma exists_tau_dvd_xi_sub_p_mul : ∃ b : Ainf, tau ∣ xi - p * b :=
  ⟨1, by simpa using tau_dvd_xi_sub_p⟩

/-! ### `A_inf ∩ y B⁺ = y A_inf`: reduction modulo `(y, p ^ n)` extends to `Amax` -/

omit [ThePrime p] in
/-- A commutative ring in which a power of `p` vanishes is `p`-adically complete. -/
lemma isAdicComplete_of_p_pow_eq_zero {Q : Type*} [CommRing Q] {n : ℕ}
    (h_zero : (p : Q) ^ n = 0) : IsAdicComplete (span {(p : Q)}) Q := by
  -- From `n` on, the powers of the ideal `(p)` are zero.
  have h_bot (k : ℕ) (h_le : n ≤ k) : (span {(p : Q)} ^ k • ⊤ : Submodule Q Q) = ⊥ := by
    simp [span_singleton_pow, pow_eq_zero_of_le h_le h_zero]
  refine { haus' := fun x hx ↦ ?_, prec' := fun f hf ↦ ⟨f n, fun k ↦ ?_⟩ }
  · have hx_n : x ≡ 0 [SMOD (span {(p : Q)} ^ n • ⊤ : Submodule Q Q)] := hx n
    rwa [h_bot n le_rfl, SModEq.bot] at hx_n
  · rcases le_total k n with h_le | h_le
    · exact hf h_le
    · have h_eq : f n ≡ f k [SMOD (span {(p : Q)} ^ n • ⊤ : Submodule Q Q)] := hf h_le
      rw [h_bot n le_rfl, SModEq.bot] at h_eq
      rw [h_bot k h_le, SModEq.bot]
      exact h_eq.symm

/-- Let `ξ ≡ p b` modulo `y` in `A_inf`. Then for every `n` the reduction of `A_inf` modulo the
ideal `(y, p ^ n)` extends to a ring homomorphism on the period ring `Amax`. -/
lemma Amax.exists_lift_quotient {y b : Ainf} (hb : y ∣ xi - p * b) (n : ℕ) :
    ∃ F : Amax →+* Ainf ⧸ span {y, (p : Ainf) ^ n},
      ∀ c : Ainf, F (algebraMap Ainf Amax c) = Ideal.Quotient.mk (span {y, (p : Ainf) ^ n}) c := by
  have hy_mem : y ∈ span {y, (p : Ainf) ^ n} := subset_span (Set.mem_insert y _)
  have hp_mem : (p : Ainf) ^ n ∈ span {y, (p : Ainf) ^ n} :=
    subset_span (Set.mem_insert_of_mem y (Set.mem_singleton _))
  -- The quotient is `p`-adically complete, as `p ^ n` vanishes in it.
  have h_pow : (p : Ainf ⧸ span {y, (p : Ainf) ^ n}) ^ n = 0 := by
    simpa using Ideal.Quotient.eq_zero_iff_mem.mpr hp_mem
  have h_complete : IsAdicComplete (span {(p : Ainf ⧸ span {y, (p : Ainf) ^ n})})
      (Ainf ⧸ span {y, (p : Ainf) ^ n}) :=
    isAdicComplete_of_p_pow_eq_zero h_pow
  -- In the quotient `ξ = p b`.
  have h_xi : Ideal.Quotient.mk (span {y, (p : Ainf) ^ n}) xi =
      p * Ideal.Quotient.mk (span {y, (p : Ainf) ^ n}) b := by
    have h_zero : Ideal.Quotient.mk (span {y, (p : Ainf) ^ n}) (xi - p * b) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (mem_of_dvd _ hb hy_mem)
    rwa [map_sub, map_mul, map_natCast, sub_eq_zero] at h_zero
  obtain ⟨F, hF, -⟩ := Amax.exists_lift (Ideal.Quotient.mk _) _ h_xi
  exact ⟨F, hF⟩

/-- Powers of a prime `q` of `A_inf` that does not divide `y` cancel: if `y` divides `q ^ k * a`,
then `y` divides `a`. -/
lemma dvd_of_dvd_prime_pow_mul {q y a : Ainf} {k : ℕ} (hq : Prime q) (hy : ¬q ∣ y)
    (h_dvd : y ∣ q ^ k * a) : y ∣ a := by
  induction k with
  | zero => simpa using h_dvd
  | succ k ih =>
    rw [pow_succ', mul_assoc] at h_dvd
    exact ih ((hq.left_dvd_or_dvd_right_of_dvd_mul h_dvd).resolve_left hy)

/-- `A_inf ∩ y B⁺ = y A_inf`. Let `y` in `A_inf` not be divisible by `p`, and let `ξ` lie in the
ideal `(p, y)`, that is, `y ∣ ξ - p b` for some `b`. If `a` is in `A_inf` and `y` divides `a` in
`B⁺ = Amax[1/p]`, then `y` divides `a` in `A_inf`. -/
lemma dvd_of_algebraMap_BPlus_dvd {y a : Ainf} (hy_p : ¬(p : Ainf) ∣ y)
    (hy_xi : ∃ b : Ainf, y ∣ xi - p * b)
    (h_dvd : algebraMap Ainf BPlus y ∣ algebraMap Ainf BPlus a) : y ∣ a := by
  -- Clear the denominator: `p ^ k * a = y * w` in the period ring `Amax`.
  obtain ⟨v, hv⟩ := h_dvd
  obtain ⟨k, w, hw⟩ : ∃ (k : ℕ) (w : Amax), (p : BPlus) ^ k * v = algebraMap Amax BPlus w :=
    BPlus.exists_p_pow_mul_eq_amax
  have h_bplus : algebraMap Amax BPlus (algebraMap Ainf Amax ((p : Ainf) ^ k * a)) =
      algebraMap Amax BPlus (algebraMap Ainf Amax y * w) := by
    rw [map_mul (algebraMap Amax BPlus), ← hw, ← IsScalarTower.algebraMap_apply Ainf Amax BPlus,
      ← IsScalarTower.algebraMap_apply Ainf Amax BPlus, map_mul, hv, map_pow, map_natCast]
    ring
  have h_amax : algebraMap Ainf Amax ((p : Ainf) ^ k * a) = algebraMap Ainf Amax y * w :=
    injective_Amax_BPlus h_bplus
  -- Reduce through `Amax` modulo `(y, p ^ n)`: there `y` vanishes, hence so does `p ^ k * a`.
  obtain ⟨b, hb⟩ := hy_xi
  have h_mem (n : ℕ) : (p : Ainf) ^ k * a ∈ span {y, (p : Ainf) ^ n} := by
    obtain ⟨F, hF⟩ := Amax.exists_lift_quotient hb n
    have hy_zero : Ideal.Quotient.mk (span {y, (p : Ainf) ^ n}) y = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (subset_span (Set.mem_insert y _))
    have h_zero : Ideal.Quotient.mk (span {y, (p : Ainf) ^ n}) ((p : Ainf) ^ k * a) = 0 := by
      rw [← hF, h_amax, map_mul, hF, hy_zero, zero_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mp h_zero
  -- So `p ^ k * a` is approximated by multiples of `y` to every order in `p`; the ideal `y A_inf`
  -- is `p`-adically closed (`dvd_of_forall_exists_sub_mem_span_pow`), and `p ^ k` cancels.
  have h_approx (m : ℕ) :
      ∃ x : Ainf, (p : Ainf) ^ k * a - y * x ∈ span {(p : Ainf), (p : Ainf)} ^ m := by
    obtain ⟨u, u', huu'⟩ : ∃ u u' : Ainf, u * y + u' * (p : Ainf) ^ m = (p : Ainf) ^ k * a :=
      mem_span_pair.mp (h_mem m)
    have h_eq : (p : Ainf) ^ k * a - y * u = (p : Ainf) ^ m * u' := by
      rw [← huu']
      ring
    refine ⟨u, ?_⟩
    rw [Set.pair_eq_singleton, span_singleton_pow, Ideal.mem_span_singleton]
    exact ⟨u', h_eq⟩
  have h_dvd_pow : y ∣ (p : Ainf) ^ k * a :=
    dvd_of_forall_exists_sub_mem_span_pow Ainf.prime_p.not_isUnit Ainf.prime_p.not_isUnit hy_p
      h_approx
  exact dvd_of_dvd_prime_pow_mul Ainf.prime_p hy_p h_dvd_pow

/-! ### Approximation by `A_inf` and the kernel of `θ` on `B⁺` -/

/-- Let `p` be a prime (`ThePrime p`), let `e` in `A_inf` divide `μ = [ε] - 1`, and let `y` be in
`B⁺ = A[1/p]`, where `A` is the period ring `Amax`. If `e ^ n • y` lies in the image `amaxImage` of
`A` in `B⁺`, then so does `p ^ (2 * n) * y`. -/
lemma amaxImage.p_pow_mul_mem_of_dvd_mu {e : Ainf} {n : ℕ} (he_dvd_mu : e ∣ mu)
    (h_mem : e ^ n • y ∈ amaxImage) : p ^ (2 * n) * y ∈ amaxImage := by
  obtain ⟨c, hc⟩ : ∃ c : Amax, (c : BPlus) = e ^ n • y := h_mem
  -- `e` divides `μ = ξ τ`, and `τ` divides `ξ - p`.
  obtain ⟨t, ht⟩ : e ∣ xi * (xi - p) := by
    grw [← xi_mul_tau, tau_dvd_xi_sub_p] at he_dvd_mu
    exact he_dvd_mu
  obtain ⟨m, b, hb⟩ : ∃ (m : ℕ) (b : Amax), p ^ m * (p ^ (2 * n) * y) = (b : BPlus) :=
    BPlus.exists_p_pow_mul_eq_amax
  -- With `X = ξ / p` and `g = X (X - 1)` we have `p² g = ξ (ξ - p) = e t`.
  let g : Amax := xiDivP * (xiDivP - 1)
  have h_g : (p : Amax) ^ 2 * g = e * t :=
    calc (p : Amax) ^ 2 * g = p * xiDivP * (p * xiDivP - p) := by ring
      _ = ((xi * (xi - p) : Ainf) : Amax) := by simp
      _ = e * t := by rw [ht, algebraMap.coe_mul]
  have h_g_bplus : (p : BPlus) ^ 2 * g = e * t := by
    simpa [← IsScalarTower.algebraMap_apply] using congrArg (algebraMap Amax BPlus) h_g
  have h_mul_eq : g ^ n * b = p ^ m * (t ^ n * c) := by
    apply injective_Amax_BPlus
    calc ((g ^ n * b : Amax) : BPlus)
        = g ^ n * (p ^ m * (p ^ (2 * n) * y)) := by simp [hb]
      _ = p ^ m * ((p ^ 2 * g) ^ n * y) := by ring
      _ = p ^ m * (t ^ n * (e ^ n * y)) := by
        rw [h_g_bplus]
        ring
      _ = ((p ^ m * (t ^ n * c) : Amax) : BPlus) := by
        simp [hc, smul_def, ← IsScalarTower.algebraMap_apply]
  -- A monic polynomial in `X` is regular modulo `pᵐ`; hence `pᵐ ∣ b`, and `pᵐ` cancels in `hb`.
  have h_dvd : (p : Amax) ^ m ∣ aeval xiDivP ((.X * (.X - C 1)) ^ n : Ainf[X]) * b :=
    ⟨t ^ n * c, by simpa [g] using h_mul_eq⟩
  obtain ⟨b', rfl⟩ : (p : Amax) ^ m ∣ b :=
    b.p_pow_dvd_of_dvd_aeval_mul ((monic_X.mul (monic_X_sub_C 1)).pow n) m h_dvd
  have h_cancel : (p : BPlus) ^ m * ((b' : Amax) : BPlus) = p ^ m * (p ^ (2 * n) * y) := by
    rw [hb]
    push_cast
    rfl
  exact ⟨b', (BPlus.isUnit_p.pow m).mul_left_cancel h_cancel⟩

/-- Let `p` be a prime (`ThePrime p`) and `B⁺ = A[1/p]`, where `A` is the period ring `Amax`. For
`y` in `B⁺` and natural numbers `k`, `n` there are `m`, an element `a` of `A_inf` and an element `w`
of the image `amaxImage` of `A` in `B⁺` with `p ^ m * y = a + p ^ (m + k) * μ ^ n * w`, where
`μ = [ε] - 1`. -/
lemma BPlus.exists_Ainf_approx (y : BPlus) (k n : ℕ) :
    ∃ (m : ℕ) (a : Ainf), ∃ w ∈ amaxImage, p ^ m * y = (a : BPlus) + p ^ (m + k) * mu ^ n * w := by
  obtain ⟨m, b, hb⟩ : ∃ (m : ℕ) (b : Amax), p ^ m * y = (b : BPlus) := y.exists_p_pow_mul_eq_amax
  obtain ⟨d, c, w, hw⟩ : ∃ (d : ℕ) (c : Ainf) (w : Amax),
      (c : Amax) = p ^ d * (b - p ^ (m + k + n + n) * w) :=
    b.exists_algebraMap_eq_p_pow_mul_sub (m + k + n + n)
  -- Split the error term twice, to gain the factor `τⁿ ξⁿ = μⁿ` at the price of `p²ⁿ`.
  obtain ⟨a, z, hz⟩ : ∃ (a : Ainf) (z : Amax), p ^ n * w = a + tau ^ n * z :=
    w.exists_p_pow_mul_eq_add exists_tau_dvd_xi_sub_p_mul n
  obtain ⟨a', z', hz'⟩ : ∃ (a' : Ainf) (z' : Amax), p ^ n * z = a' + xi ^ n * z' :=
    z.exists_p_pow_mul_eq_add ⟨0, by simp⟩ n
  have h_mu : (mu : Amax) = xi * tau := by rw [← xi_mul_tau, algebraMap.coe_mul]
  have h_w : p ^ (n + n) * w = p ^ n * a + tau ^ n * a' + mu ^ n * z' :=
    calc p ^ (n + n) * w = p ^ n * (p ^ n * w) := by ring
      _ = p ^ n * a + tau ^ n * (p ^ n * z) := by
        rw [hz]
        ring
      _ = p ^ n * a + tau ^ n * a' + mu ^ n * z' := by
        rw [hz', h_mu]
        ring
  -- Substitute this into `pᵈ b = c + p ^ (d + m + k) * (p²ⁿ w)` and map to `BPlus`.
  have h_b : p ^ d * b =
      c + p ^ (d + m + k) * (p ^ n * a + tau ^ n * a') + p ^ (d + m + k) * mu ^ n * z' := by
    linear_combination -hw + (p : Amax) ^ (d + m + k) * h_w
  refine ⟨d + m, c + p ^ (d + m + k) * (p ^ n * a + tau ^ n * a'), (z' : BPlus), ⟨z', rfl⟩, ?_⟩
  rw [pow_add, mul_assoc, hb]
  simpa [← IsScalarTower.algebraMap_apply] using congrArg (algebraMap Amax BPlus) h_b

/-- For `a` in `A_inf` and every `j`, applying the Frobenius `φ` (`frobEnd`) `j` times to the image
of `a` in the period ring `B⁺ = Amax[1/p]` gives the image of `φ^j a`. Here `Amax` is Colmez's
`A_max`, the p-adic completion of `A_inf[X]/(pX − ξ)`, and `A_inf` maps to `B⁺` through `Amax`. -/
@[simp]
lemma BPlus.iterate_frobEnd_algebraMap (j : ℕ) : frobEnd^[j] (a : BPlus) = frobEnd^[j] a := by
  induction j generalizing a with
  | zero => simp
  | succ j ih => rw [iterate_succ_apply, iterate_succ_apply, frobEnd_algebraMap, ih]

/-- Let `ν` be in `A_inf` and `s : ℕ → ℕ`, and suppose `ν` divides every `a` in `A_inf` with
`θ (φ^[s j] a) = 0` for all `j`, where `φ` is the Frobenius. Then `ν` divides in `B⁺` every `y`
with `θ (φ^[s j] y) = 0` for all `j`. -/
lemma BPlus.dvd_of_thetaBPlus_frobEnd_eq_zero (y : BPlus) {ν : Ainf} {s : ℕ → ℕ}
    (hν : ∀ {a : Ainf}, (∀ j : ℕ, theta (frobEnd^[s j] a) = 0) → ν ∣ a)
    (hθ : ∀ j : ℕ, thetaBPlus (frobEnd^[s j] y) = 0) :
    ↑ν ∣ y := by
  -- Write `pⁿ y = a + pⁿ μ z`. All `θ φ^(s j)` kill `μ`, so `a` passes the same test as `y`.
  obtain ⟨n, a, z, -, hy⟩ :
      ∃ (n : ℕ) (a : Ainf), ∃ z ∈ amaxImage, p ^ n * y = a + p ^ n * mu * z := by
    simpa using y.exists_Ainf_approx 0 1
  have hθ_mu : ∀ j : ℕ, theta (frobEnd^[s j] mu) = 0 := by simp
  have hμ : ν ∣ mu := hν hθ_mu
  have ha : ν ∣ a := by
    refine hν fun j ↦ ?_
    have h_eq : thetaBPlus (frobEnd^[s j] (a + p ^ n * mu * z : BPlus)) =
        thetaBPlus (frobEnd^[s j] (p ^ n * y)) := by
      rw [hy]
    simpa [hθ, iterate_frobEnd_algebraMap] using h_eq
  have h_dvd_p_pow_mul : (ν : BPlus) ∣ p ^ n * y := by
    rw [hy]
    exact dvd_add (map_dvd (algebraMap Ainf BPlus) ha)
      (((map_dvd (algebraMap Ainf BPlus) hμ).mul_left _).mul_right _)
  -- `p` is a unit of `BPlus`.
  have hp_unit : IsUnit ((p : BPlus) ^ n) := BPlus.isUnit_p.pow n
  rwa [hp_unit.dvd_mul_left] at h_dvd_p_pow_mul

/-- For `y` in `B⁺`, `θ y = 0` if and only if `ξ` divides `y` in `B⁺`; that is, the kernel of
`θ : B⁺ → ℂ_p` is `ξ B⁺`. -/
@[local simp ←]
lemma thetaBPlus_eq_zero_iff : thetaBPlus y = 0 ↔ ↑xi ∣ y := by
  constructor
  · intro hy
    -- On `A_inf` the kernel of `θ` is generated by `ξ`. This passes to `B⁺` by
    -- `dvd_of_thetaBPlus_frobEnd_eq_zero` with no Frobenius twist, that is, for `s = 0`.
    refine y.dvd_of_thetaBPlus_frobEnd_eq_zero (s := 0) (fun {a} ha ↦ ?_) fun _ ↦ hy
    have h_theta : theta a = 0 := ha 0
    exact theta_eq_zero_iff_xi_dvd.mp h_theta
  · rintro ⟨c, rfl⟩
    simp [theta_xi]

/-- Let `a ∈ A_inf`. An element `y` of `B⁺` divisible by `(ξ - p a) ^ n` for every `n` is zero. -/
lemma BPlus.eq_zero_of_forall_pow_dvd (a : Ainf)
    (h_pow_dvd : ∀ n : ℕ, algebraMap Ainf BPlus (xi - p * a) ^ n ∣ y) :
    y = 0 := by
  -- Write `p ^ n * y = p ^ k * c` with `c` in `A = Amax` not divisible by `p`. As
  -- `ξ - p a = p (X - a)`, all powers of `X - a` divide `c`, hence its nonzero image in the
  -- polynomial ring `A / p`: absurd.
  by_contra hy
  obtain ⟨n, b, hb⟩ := y.exists_p_pow_mul_eq_amax
  have hb_ne : b ≠ 0 := by
    rintro rfl
    have h_zero : (p : BPlus) ^ n * y = 0 := by rwa [algebraMap.coe_zero] at hb
    exact hy ((BPlus.isUnit_p.pow n).mul_right_eq_zero.mp h_zero)
  have h_not_dvd : ¬∀ m : ℕ, (p : Amax) ^ m ∣ b := mt Adic.eq_zero_of_forall_pow_dvd hb_ne
  obtain ⟨k, c, rfl, hc⟩ := exists_eq_pow_mul_of_not_forall_dvd _ b h_not_dvd
  -- `F : A → (A_inf / (p, ξ))[X]` has kernel `p A` and sends `P (ξ / p)` to the reduction of `P`
  obtain ⟨F, hF, hF_ker⟩ := Amax.exists_reduction_mod_p (p := p)
  -- divisibility holds in `BPlus`, where `p` is a unit
  have h_loc (m : ℕ) : algebraMap Amax BPlus (aeval Amax.xiDivP ((.X - C a) ^ m)) ∣ ↑c := by
    have h_dvd : algebraMap Ainf BPlus (xi - p * a) ^ m ∣ y := h_pow_dvd m
    grw [algebraMap_apply _ Amax, Dvd.intro_left _ hb] at h_dvd
    simpa [← mul_sub, mul_pow, IsUnit.pow] using h_dvd
  -- the quotient lies in `A`, since `(X - a) ^ m` is monic (`Amax.p_pow_dvd_of_dvd_aeval_mul`)
  have h_int (m : ℕ) : aeval Amax.xiDivP ((.X - C a) ^ m) ∣ c := by
    -- `hw : c = (X - a) ^ m * w` in `B⁺`
    obtain ⟨w, hw⟩ := h_loc m
    obtain ⟨l, d, hd⟩ := w.exists_p_pow_mul_eq_amax
    have h_mul_eq : aeval Amax.xiDivP ((.X - C a) ^ m) * d = p.cast ^ l * c := by
      apply injective_Amax_BPlus
      calc ((aeval Amax.xiDivP ((.X - C a) ^ m) * d : Amax) : BPlus)
          = algebraMap Amax BPlus (aeval Amax.xiDivP ((.X - C a) ^ m)) * (p ^ l * w) := by
            rw [algebraMap.coe_mul, ← hd]
        _ = p ^ l * c := by
            rw [hw]
            ring
        _ = ((p.cast ^ l * c : Amax) : BPlus) := by
            push_cast
            rfl
    obtain ⟨e, he⟩ : (p : Amax) ^ l ∣ d :=
      d.p_pow_dvd_of_dvd_aeval_mul ((monic_X_sub_C a).pow m) l ⟨c, h_mul_eq⟩
    have hw_eq : w = (e : BPlus) := by
      have h_mul : (p : BPlus) ^ l * w = (p : BPlus) ^ l * e := by
        rw [hd, he]
        push_cast
        rfl
      exact (BPlus.isUnit_p.pow l).mul_left_cancel h_mul
    refine ⟨e, injective_Amax_BPlus ?_⟩
    show (c : BPlus) = ((aeval Amax.xiDivP ((.X - C a) ^ m) * e : Amax) : BPlus)
    rw [hw, hw_eq, algebraMap.coe_mul]
  -- a nonzero polynomial is not divisible by `X - a` to its root multiplicity plus one
  have hFc_ne : F c ≠ 0 := fun h_zero ↦ hc ((hF_ker c).mpr h_zero)
  set r : ℕ := rootMultiplicity (Ideal.Quotient.mk (span {(p : Ainf), xi}) a) (F c) + 1
  have h_map : F (aeval Amax.xiDivP ((.X - C a) ^ r)) ∣ F c := map_dvd F (h_int r)
  rw [hF] at h_map
  have h_dvd_F : (Polynomial.X - C (Ideal.Quotient.mk (span {(p : Ainf), xi}) a)) ^ r ∣ F c := by
    simpa using h_map
  exact pow_rootMultiplicity_not_dvd hFc_ne _ h_dvd_F

-- The module `Ainf` is given explicitly in `IsHausdorff.eq_iff_smodEq`, so that the separatedness
-- used is that of `Ainf`, not of `Amax`.
open scoped Classical in
instance : FaithfulSMul Ainf BPlus := by
  refine .of_injective (ofId Ainf BPlus) (injective_Amax_BPlus.comp ?_)
  -- elements with the same image in `Amax` agree modulo every `(p, ξ) ^ m`
  -- (`mem_span_pow_of_p_pow_dvd`), and `Ainf` is `(p, ξ)`-adically separated
  simp_all [Injective, IsHausdorff.eq_iff_smodEq (I := span {↑p, xi}) (M := Ainf),
    mem_span_pow_of_p_pow_dvd, SModEq.sub_mem]

lemma BPlus.mu_ne_zero : (mu : BPlus) ≠ 0 := mod_cast ne_zero_of_map constantCoeff_mu_ne_zero

open scoped Classical in
/-- The isomorphism of `ℚ_p`-algebras `B⁺ ⧸ span {ξ} ≃ₐ[ℚ_[p]] ℂ_[p]` induced by the surjective
map `θ : B⁺ → ℂ_p`, whose kernel is generated by `ξ`. -/
def thetaEquiv :=
  (quotientEquivAlgOfEq ℚ_[p] (by aesop (add simp mem_span_singleton) : span {↑xi} = _)).trans
    (quotientKerAlgEquivOfSurjective thetaBPlus_surjective)

/-- The ring homomorphism `θ` from `B_dR⁺` to `ℂ_p`: the projection to `B⁺ / ξ B⁺` followed by
the isomorphism `thetaEquiv` of that quotient with `ℂ_p`. -/
def thetaBdR : BdRPlus →ₐ[ℚ_[p]] ℂ_[p] :=
  AlgHom.comp thetaEquiv ⟨(AdicCompletion.evalOneₐ (span {(algebraMap Ainf BPlus) xi})).toRingHom,
    by tauto⟩

/-- On `B⁺`, `θ` of `B_dR⁺` is `θ` of `B⁺`. -/
@[simp]
lemma thetaBdR_algebraMap_BPlus : thetaBdR y = thetaBPlus y := (rfl)

/-- On `A_inf`, `θ` of `B_dR⁺` is Fontaine's `θ` followed by the inclusion of `O_C` into `ℂ_p`. -/
@[simp]
lemma thetaBdR_ainf : thetaBdR a = (theta a).val := thetaBPlus_ainf a

/-- For `y` in `B⁺` and a natural number `n`, `ξ ^ n` divides the image of `y` in `B_dR⁺` if and
only if `ξ ^ n` divides `y` in `B⁺`. -/
lemma BdRPlus.xi_pow_dvd_iff {n : ℕ} : (xi : BdRPlus) ^ n ∣ y ↔ (xi : BPlus) ^ n ∣ y :=
  pow_dvd_iff (y := y)

open BdRPlus

/-- Every element of `B_dR⁺` is congruent modulo `ξ ^ n` to an element of `B⁺`. -/
lemma BdRPlus.exists_xi_pow_dvd_sub (x : BdRPlus) (n : ℕ) :
    ∃ y : BPlus, (xi : BdRPlus) ^ n ∣ x - y :=
  Adic.exists_approx x n

/-- For every `x` in `B_dR⁺` and every natural number `n` there are a natural number `m` and `r`
in `A_inf` such that `ξ ^ n` divides `p ^ m * x - r` in `B_dR⁺`. -/
lemma BdRPlus.exists_Ainf_approx (x : BdRPlus) (n : ℕ) :
    ∃ m : ℕ, ∃ r : Ainf, (xi : BdRPlus) ^ n ∣ p ^ m * x - r := by
  -- approximate `x` by `z ∈ BPlus`, and `p ^ m * z` by `a` modulo `μ ^ n = (ξ τ) ^ n`
  -- `hz : x - z = ξ ^ n * c`
  obtain ⟨z, c, hz⟩ := x.exists_xi_pow_dvd_sub n
  obtain ⟨m, a, v, -, ha⟩ : ∃ (m : ℕ) (a : Ainf), ∃ v ∈ amaxImage,
      p ^ m * z = a + p ^ m * mu ^ n * v := by
    simpa using z.exists_Ainf_approx 0 n
  refine ⟨m, a, ?_⟩
  -- in `B_dR⁺`, `p ^ m z = a + p ^ m ξ ^ n τ ^ n v`, as `μ = ξ τ`
  have h_z : (p : BdRPlus) ^ m * z = a + p ^ m * (xi ^ n * tau ^ n) * v := by
    simpa [← xi_mul_tau, mul_pow, ← IsScalarTower.algebraMap_apply] using
      congrArg (algebraMap BPlus BdRPlus) ha
  -- so `p ^ m x - a = p ^ m (x - z) + p ^ m μ ^ n v`, and `ξ ^ n` divides `x - z`
  have h_eq : (p : BdRPlus) ^ m * x - a = xi ^ n * (p ^ m * c + p ^ m * tau ^ n * v) := by
    linear_combination (p : BdRPlus) ^ m * hz + h_z
  rw [h_eq]
  exact dvd_mul_right _ _

/-- For `x` in `B_dR⁺`, `θ x = 0` if and only if `ξ` divides `x`: the kernel of
`θ : B_dR⁺ → ℂ_p` is `ξ B_dR⁺`. -/
@[local simp ←]
lemma thetaBdR_eq_zero_iff : thetaBdR x = 0 ↔ ↑xi ∣ x := by
  -- `x = y + ξ c` with `y ∈ B⁺`; both sides of the statement for `x` are those for `y`, and there
  -- the statement is `thetaBPlus_eq_zero_iff`
  -- `hc : x - y = ξ ^ 1 * c`
  obtain ⟨y, c, hc⟩ := x.exists_xi_pow_dvd_sub 1
  have hx : x = y + xi * c := by linear_combination hc
  have h_theta : thetaBdR x = thetaBPlus y := by simp [hx, theta_xi]
  have h_dvd_y : (xi : BdRPlus) ∣ y ↔ (xi : BPlus) ∣ y := by
    simpa only [pow_one] using xi_pow_dvd_iff (y := y) (n := 1)
  have h_dvd : (xi : BdRPlus) ∣ x ↔ (xi : BPlus) ∣ y := by
    rw [hx, dvd_add_left (dvd_mul_right _ _), h_dvd_y]
  rw [h_theta, h_dvd, thetaBPlus_eq_zero_iff]

/-- An element `x` of `B_dR⁺` is a unit if and only if `θ x ≠ 0`. -/
@[simp]
lemma BdRPlus.isUnit_iff : IsUnit x ↔ thetaBdR x ≠ 0 := by
  constructor
  · intro hx_unit
    exact (hx_unit.map thetaBdR).ne_zero
  · intro hx
    -- if `θ b = (θ x)⁻¹`, then `x * b ≡ 1` modulo `ξ`; by `ξ`-adic completeness `x * b` is a unit
    obtain ⟨b, hb⟩ : ∃ b : BPlus, thetaBPlus b = (thetaBdR x)⁻¹ := thetaBPlus_surjective _
    have h_theta : thetaBdR (x * b - 1) = 0 := by
      rw [map_sub, map_mul, map_one, thetaBdR_algebraMap_BPlus, hb, mul_inv_cancel₀ hx, sub_self]
    have h_dvd : (xi : BdRPlus) ∣ x * b - 1 := thetaBdR_eq_zero_iff.mp h_theta
    -- The `ξ`-adic completeness of `B_dR⁺` is given explicitly.
    have h_unit : IsUnit (x * b) :=
      @isUnit_of_dvd_sub _ _ _ _ _ isAdicComplete isUnit_one h_dvd
    exact isUnit_of_mul_isUnit_left h_unit

/-- Every nonzero element of `B_dR⁺` is a power of `ξ` times a unit. -/
lemma BdRPlus.exists_associated_xi_pow (hx : x ≠ 0) : ∃ n : ℕ, Associated (xi ^ n : BdRPlus) x := by
  -- `x = ξ ^ n * u` with `ξ ∤ u`, that is, `θ u ≠ 0`: so `u` is a unit
  have h_not_dvd : ¬∀ m : ℕ, (xi : BdRPlus) ^ m ∣ x :=
    fun h_all ↦ hx (Adic.eq_zero_of_forall_pow_dvd h_all)
  obtain ⟨n, u, rfl, hu⟩ := exists_eq_pow_mul_of_not_forall_dvd (xi : BdRPlus) x h_not_dvd
  have hu_unit : IsUnit u := by
    rw [isUnit_iff, Ne, thetaBdR_eq_zero_iff]
    exact hu
  exact ⟨n, associated_mul_unit_right _ _ hu_unit⟩

open scoped Classical in
instance [FaithfulSMul R BPlus] : FaithfulSMul R BdRPlus := by
  -- an element of `BPlus` that vanishes in `BdRPlus` is divisible by all powers of `ξ`
  refine .of_injective (toAlgHom R BPlus BdRPlus) ((injective_iff_map_eq_zero _).2 fun y hy ↦ ?_)
  apply BPlus.eq_zero_of_forall_pow_dvd 0
  intro n
  have hy_zero : (y : BdRPlus) = 0 := by simpa using hy
  have h_dvd : (xi : BdRPlus) ^ n ∣ y := by
    rw [hy_zero]
    exact dvd_zero _
  simpa using xi_pow_dvd_iff.mp h_dvd

/-! ### `B_dR⁺` is a discrete valuation ring; the period rings are domains -/

/-- The element `ξ` is prime in `B_dR⁺`. -/
lemma BdRPlus.prime_xi : Prime (xi : BdRPlus) := by
  simp [Prime, Ainf.prime_xi.ne_zero, -isUnit_map_iff]

instance : IsDomain BdRPlus := by
  have h_nontrivial : Nontrivial BdRPlus := ⟨xi, 0, prime_xi.ne_zero⟩
  -- nonzero `x`, `y` are associated to powers of `ξ`, so `x * y` is too, and `ξ` is not nilpotent
  have h_noZeroDivisors : NoZeroDivisors BdRPlus := by
    refine ⟨?_⟩
    by_contra! ⟨x, y, hxy, hx, hy⟩
    obtain ⟨m, hm⟩ := exists_associated_xi_pow hx
    obtain ⟨n, hn⟩ := exists_associated_xi_pow hy
    have h_assoc : Associated ((xi : BdRPlus) ^ m * xi ^ n) (x * y) := hm.mul_mul hn
    -- `A_inf → B_dR⁺` is injective, and `ξ ≠ 0` in the domain `A_inf`
    simp [hxy, ← map_pow, ← map_mul, Ainf.prime_xi.ne_zero] at h_assoc
  exact NoZeroDivisors.to_isDomain _

instance : IsDiscreteValuationRing BdRPlus :=
  .ofHasUnitMulPowIrreducibleFactorization
    ⟨(xi : BdRPlus), prime_xi.irreducible, exists_associated_xi_pow⟩

instance : IsDomain BPlus := .of_faithfulSMul _ BdRPlus

instance : IsDomain Amax := injective_Amax_BPlus.isDomain

instance : CharZero Amax := thetaAmax.charZero

instance : IsDomain Bmax := isDomain _ mu_ne_zero

/-- The natural map from `B⁺ = Amax[1/p]` to Colmez's period ring `B = B⁺[1/μ]` (`Bmax`) is
injective, since `B⁺` is a domain and `μ ≠ 0`. Here `Amax` is the p-adic completion of
`A_inf[X]/(pX − ξ)`, and `μ = [ε] − 1` (`mu`), where `[ε]` is a Teichmüller lift. -/
lemma injective_BPlus_Bmax : Injective ((↑) : BPlus → Bmax) :=
  IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors mu_ne_zero)

/-- Let `Λ` be a ring that is complete for a maximal ideal `I = (p)`, and let the period ring `A`
be a `Λ`-algebra. Then `A` has an `I`-adic topological basis over `Λ` (`New.Lift.AdicBasis`):
vectors whose finite combinations are dense, with coordinate forms. -/
lemma Amax.nonempty_adicBasis (Λ : Type) [CommRing Λ] [Algebra Λ Amax] {I : Ideal Λ}
    (hI_span : I = span {(p : Λ)}) [I.IsMaximal] [IsAdicComplete I Λ] :
    Nonempty (Lift.AdicBasis I Amax) := by
  -- `Lift.exists_adicBasis` for the generators `0, p` of `I` (in this order) and no given vectors;
  -- its hypotheses then only ask that `p` is regular on `Amax`
  have hI : I = span {0, (p : Λ)} := hI_span.trans span_insert_zero.symm
  have h_regular : ∀ a b : Amax, (p : Λ) • a = (0 : Λ) • b → ∃ c : Amax, a = (0 : Λ) • c := by
    simp [NeZero.ne, smul_def]
  exact (Lift.exists_adicBasis hI h_regular ∅ (by simp) (by simp)).nonempty

end New.Period

end BdRPlus

/-! ## The contraction lemma -/

section Contraction

open algebraMap Ideal New.Period.Amax IsScalarTower Algebra

/-- Divisibility by `ξ ^ n` in `B⁺` of an element `a` of `A_inf` descends to `A_inf`, since in both
rings the multiples of `ξ` are the kernel of `θ`. -/
lemma New.Period.xi_pow_dvd_of_algebraMap_BPlus_dvd {p : ℕ} [ThePrime p] {a : Ainf} {n : ℕ}
    (h_dvd : (xi : BPlus) ^ n ∣ a) : xi ^ n ∣ a := by
  have hξ_reg : (xi : BPlus) ∈ nonZeroDivisors BPlus := by simpa using Ainf.prime_xi.ne_zero
  have h_one (b : Ainf) (hb : (xi : BPlus) ∣ b) : xi ∣ b := by
    rw [← thetaBPlus_eq_zero_iff, thetaBPlus_ainf] at hb
    exact theta_eq_zero_iff_xi_dvd.mp (by simpa using hb)
  exact pow_dvd_of_map (map_mul (algebraMap Ainf BPlus) xi) hξ_reg h_one h_dvd

/-- Contraction: let `B⁺ = A[1/p]`, where `A` is the period ring `Amax`, and let `V ⊆ B⁺` lie in
`amaxImage`, the image of `A` in `B⁺`. Let `u` be in `A_inf`, and suppose every `v` in `V` satisfies
`ξ ^ n • v = u • φ w` for some `w` in `V`. Here `ξ = ∑_{i<p} [ε^{1/p}]^i ∈ A_inf`, and `φ`
(`frobEnd`) is the Frobenius of `B⁺` given by the generator of `ℕ` in its `ℕ × G_p` action. Then for
every `v` in `V`, `p ^ (n + 1) * v` is the image in `B⁺` of an element of `A_inf`. -/
lemma New.Period.exists_Ainf_eq_of_contraction {p : ℕ} [ThePrime p] (V : Set BPlus) (n : ℕ)
    (u : Ainf) (hV : ∀ v ∈ V, v ∈ amaxImage)
    (h_phi : ∀ v ∈ V, ∃ w ∈ V, xi ^ n • v = u • frobEnd w) (v : BPlus) (hv : v ∈ V) :
    ∃ a : Ainf, ↑a = p ^ n.succ * v := by
  -- By induction on `k`, `p ^ (n + 1) * v` is congruent modulo `τ ^ (n + 1) * p ^ k * Amax` to some
  -- `a k ∈ A_inf`. The `a k` converge `(p, ξ)`-adically, and the limit is `p ^ (n + 1) * v`.
  -- Here `y v ∈ Amax` is a preimage of `v ∈ V`.
  have h_preimage : ∀ v ∈ V, ∃ y : Amax, (y : BPlus) = v := hV
  choose! y hy using h_preimage
  have h_approx (k : ℕ) :
      ∃ (a : Ainf) (z : Amax), a = p ^ n.succ * y v - tau ^ n.succ * z * p ^ k := by
    induction k generalizing v with
    | zero =>
      simpa [eq_sub_iff_add_eq, eq_comm] using
        (y v).exists_p_pow_mul_eq_add exists_tau_dvd_xi_sub_p_mul n.succ
    | succ k ih =>
      obtain ⟨w, hw, hvw⟩ : ∃ w ∈ V, xi ^ n • v = u • frobEnd w := h_phi v hv
      obtain ⟨c, z, hc⟩ := ih w hw
      -- Apply `φ` to `hc` and map to `B⁺`; here `φ τ = μ = ξ τ`.
      have h_frob : ((frobEnd c : Ainf) : BPlus) =
          p ^ n.succ * frobEnd w - (xi * tau) ^ n.succ * (frobEnd z : Amax) * p ^ k := by
        have h_w : algebraMap Amax BPlus (frobEnd (y w)) = frobEnd w :=
          (frobEnd_algebraMap (y w)).symm.trans (congrArg frobEnd (hy w hw))
        simpa [h_w, ← xi_mul_tau, ← IsScalarTower.algebraMap_apply, -p_mul_X] using
          congrArg (fun x : Amax ↦ algebraMap Amax BPlus (frobEnd x)) hc
      -- Multiply by `u`. On the first term `u φ w = ξ ^ n v`. On the second, one of the `n + 1`
      -- factors `ξ = p X` gains a power of `p`.
      have h_uw : (u : BPlus) * frobEnd w = xi ^ n * v := by simpa [smul_def] using hvw.symm
      have h_pX : (xi : BPlus) = p * (xiDivP : Amax) := by
        simp [IsScalarTower.algebraMap_apply Ainf Amax BPlus]
      let z' : Amax := u * xiDivP * frobEnd z
      have h_mul : ((u * frobEnd c : Ainf) : BPlus) =
          xi ^ n * (p ^ n.succ * y v - tau ^ n.succ * z' * p ^ (k + 1) : Amax) :=
        calc ((u * frobEnd c : Ainf) : BPlus)
            = p ^ n.succ * (u * frobEnd w) -
                xi ^ n * xi * tau ^ n.succ * u * (frobEnd z : Amax) * p ^ k := by
              rw [algebraMap.coe_mul, h_frob, mul_pow, pow_succ (xi : BPlus)]
              ring
          _ = xi ^ n * (p ^ n.succ * v -
                tau ^ n.succ * (u * (xiDivP : Amax) * (frobEnd z : Amax)) * p ^ (k + 1)) := by
              rw [h_uw, h_pX]
              ring
          _ = _ := by simp [z', hy v hv, ← IsScalarTower.algebraMap_apply]
      -- So `u φ c = ξ ^ n d` with `d` in `A_inf`; cancel `ξ ^ n`.
      obtain ⟨d, hd⟩ : xi ^ n ∣ u * frobEnd c := xi_pow_dvd_of_algebraMap_BPlus_dvd ⟨_, h_mul⟩
      have hξ_ne : (xi : BPlus) ^ n ≠ 0 := pow_ne_zero n (by simpa using Ainf.prime_xi.ne_zero)
      rw [hd, algebraMap.coe_mul, algebraMap.coe_pow, mul_right_inj' hξ_ne] at h_mul
      exact ⟨d, z', injective_Amax_BPlus h_mul⟩
  choose a z ha using h_approx
  -- For `k ≤ l`, `p ^ k` divides `a k - a l` in `Amax`, which puts it in `(p, ξ) ^ k`.
  have h_cauchy {k l : ℕ} (hk : k ≤ l) : a k - a l ∈ span {↑p, xi} ^ k := by
    have h_dvd : (p : Amax) ^ k ∣ ((a k - a l : Ainf) : Amax) := by
      simp [ha, dvd_sub, (pow_dvd_pow _ hk).trans]
    exact mem_span_pow_of_p_pow_dvd h_dvd
  -- `A_inf` is `(p, ξ)`-adically complete, so the sequence `a` has a limit `b`.
  have h_smod {k l : ℕ} (hk : k ≤ l) :
      a k ≡ a l [SMOD (span {↑p, xi} ^ k • ⊤ : Submodule Ainf Ainf)] :=
    SModEq.sub_mem.mpr ((mul_top _).ge (h_cauchy hk))
  obtain ⟨b, hb⟩ : ∃ b : Ainf, ∀ k : ℕ, a k - b ∈ span {↑p, xi} ^ k := by
    simpa [SModEq.sub_mem] using IsPrecomplete.prec' a h_smod
  -- `Amax` is `p`-adically separated, and `(p, ξ) ^ k` maps into `p ^ k * Amax`.
  have h_lim : p ^ n.succ * y v = b := by
    refine eq_of_forall_pow_dvd_sub (p : Amax) fun k ↦ ?_
    have h_dvd : (p : Amax) ^ k ∣ ((a k - b : Ainf) : Amax) := p_pow_dvd_of_mem_pow (hb k)
    simpa [ha, sub_right_comm, dvd_sub_left] using h_dvd
  refine ⟨b, ?_⟩
  simpa [hy v hv, ← IsScalarTower.algebraMap_apply] using
    congrArg (algebraMap Amax BPlus) h_lim.symm

end Contraction

