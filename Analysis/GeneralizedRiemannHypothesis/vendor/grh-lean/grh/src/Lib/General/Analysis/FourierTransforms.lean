import Lib.Adelic.QuotientMeasure.Basic

/-!
# Fourier inversion for periodic functions and decay of Fourier transforms

This file develops Fourier analysis on a compact quotient `B ⧸ B₀` of a topological abelian group,
for a family of characters given in advance. `New.IsContPeriodic B₀ F` says that `F` is continuous
and `B₀`-periodic, and `New.quotMean B₀ F` is its mean over `B ⧸ B₀` for the Haar probability
measure.

## Main definitions and results

* `New.IsDualFamily`: a family `χ i` of characters of `B` trivial on `B₀`, multiplicative in the
  index, that separates the points of `B ⧸ B₀`.
* `New.IsDualFamily.tsum_coeff_eq_quotMean`: the mean of a series of characters with summable
  coefficients.
* `New.IsDualFamily.fourier_inversion`: Fourier inversion, from `New.stone_weierstrass_span`.
* `New.IsDualFamily.eq_zero_of_quotMean_mul_eq_zero`: a periodic function vanishes if its Fourier
  coefficients vanish at the characters that respect its quasi-periods (`New.RespectsQuasiPeriods`).
* `New.exists_pow_mul_norm_fourier_le`: for smooth `c` and `q`, with `c` supported in a compact set
  `K`, for `0 < ‖a‖ ≤ 1` and every `M`, the norm of the Fourier transform of `c · exp (q / a)` at
  `b` is at most a constant times the supremum over `K` of `‖exp (q / a)‖` divided by
  `(‖a‖ * (1 + ‖b‖)) ^ M`.

## Relation to the literature

The results of this file include the Stone–Weierstrass theorem for a monoid of functions, Fourier
inversion on a compact quotient of an abelian group, and the decay of Fourier transforms by
integration by parts.
-/

/-! ## Dual families of characters and Fourier inversion -/

section PeriodicFourier

open MeasureTheory ContinuousMap Set Submodule Complex QuotientAddGroup DFunLike

namespace New

variable {B : Type*} [AddCommGroup B] [TopologicalSpace B]

/-- `IsDualFamily B₀ χ` says that `i ↦ χ i` is an injective homomorphism from `I` to the group of
continuous unitary characters of `B` that are trivial on `B₀`, and that the common kernel of the
`χ i` lies in `B₀`. -/
class IsDualFamily {I : outParam Type*} [AddCommGroup I] (B₀ : AddSubgroup B)
    (χ : outParam (I → B → ℂ)) : Prop where
  /-- Each `χ i` is continuous and periodic under `B₀`. -/
  periodic (i : I) : IsContPeriodic B₀ (χ i)
  /-- `χ i x` is multiplicative in the index `i`. -/
  add_left (i j : I) (x : B) : χ (i + j) x = χ i x * χ j x
  /-- `χ i x` is multiplicative in the argument `x`. -/
  add_right (i : I) (x y : B) : χ i (x + y) = χ i x * χ i y
  /-- The values have absolute value one. -/
  norm_eq_one (i : I) (x : B) : ‖χ i x‖ = 1
  /-- A point at which all the characters are `1` lies in `B₀`. -/
  mem_of_forall_eq_one (x : B) : (∀ i : I, χ i x = 1) → x ∈ B₀
  /-- Only the index `0` can give the trivial character. -/
  eq_zero_of_forall_eq_one (i : I) : (∀ x : B, χ i x = 1) → i = 0

/-- A quasi-period of `F` is a pair `(a, c)` such that `c * F (x + a) = F x` for all `x`.
`RespectsQuasiPeriods ψ F` says that `ψ a = c` for every quasi-period `(a, c)` of `F`. -/
def RespectsQuasiPeriods (ψ F : B → ℂ) : Prop :=
  ∀ (a : B) (c : ℂ), (∀ x : B, c * F (x + a) = F x) → ψ a = c

/-- Stone–Weierstrass for monoids: let `M` be a submonoid of `C(K, ℂ)`, `K` compact, that is
closed under conjugation and separates points (two points at which all `f ∈ M` agree are
equal). Then the linear span of `M` is dense in `C(K, ℂ)`. -/
lemma stone_weierstrass_span {K : Type*} [TopologicalSpace K] [CompactSpace K]
    (M : Submonoid C(K, ℂ)) (h_star : ∀ f ∈ M, star f ∈ M)
    (h_sep : ∀ x y : K, (∀ f ∈ M, f x = f y) → x = y) :
    Dense (span ℂ (M : Set C(K, ℂ)) : Set C(K, ℂ)) := by
  -- The span of `M` is the star subalgebra generated by `M`, as `M` is a monoid closed under
  -- `star`.
  have h_closure : Submonoid.closure (M ∪ star (M : Set C(K, ℂ))) ≤ M :=
    M.closure_le.2 (union_subset le_rfl (star_subset.2 h_star))
  have h_points : (StarAlgebra.adjoin ℂ (M : Set C(K, ℂ))).SeparatesPoints := fun x y hxy ↦ by
    obtain ⟨f, hf, hf_ne⟩ : ∃ f ∈ M, f x ≠ f y := by simpa using mt (h_sep x y) hxy
    exact ⟨f, ⟨f, StarAlgebra.subset_adjoin ℂ _ hf, rfl⟩, hf_ne⟩
  have h_top : (StarAlgebra.adjoin ℂ (M : Set C(K, ℂ))).topologicalClosure = ⊤ :=
    starSubalgebra_topologicalClosure_eq_top_of_separatesPoints _ h_points
  intro f
  grw [← h_closure, ← StarAlgebra.adjoin_eq_span]
  simp [← StarSubalgebra.topologicalClosure_coe, h_top]

variable {I : Type*} [AddCommGroup I] {B₀ : AddSubgroup B} {F : B → ℂ} {χ : I → B → ℂ}

namespace IsDualFamily

/-! ### First properties of the characters -/

/-- The characters of a dual family do not vanish, having absolute value one. -/
lemma apply_ne_zero [hχ : IsDualFamily B₀ χ] (i : I) (x : B) : χ i x ≠ 0 := by
  simp [← norm_pos_iff, hχ.norm_eq_one]

lemma zero_apply [hχ : IsDualFamily B₀ χ] (x : B) : χ 0 x = 1 :=
  (left_eq_mul₀ (hχ.apply_ne_zero 0 x)).1 (by simpa using hχ.add_left 0 0 x)

lemma conj_apply [hχ : IsDualFamily B₀ χ] (i : I) (x : B) :
    starRingEnd ℂ (χ i x) = χ (-i) x := by
  rw [← RCLike.inv_eq_conj (hχ.norm_eq_one i x), inv_eq_of_mul_eq_one_left]
  simp [← hχ.add_left, hχ.zero_apply]

/-- The product of a character of a dual family with a continuous `B₀`-periodic function is again
continuous and `B₀`-periodic. -/
lemma isContPeriodic_mul [hχ : IsDualFamily B₀ χ] (hF : IsContPeriodic B₀ F) (i : I) :
    IsContPeriodic B₀ fun x : B ↦ χ i x * F x := by
  obtain ⟨hχ_cont, hχ_period⟩ := hχ.periodic i
  obtain ⟨hF_cont, hF_period⟩ := hF
  exact ⟨hχ_cont.mul hF_cont, fun γ hγ x ↦ by simp only [hχ_period γ hγ, hF_period γ hγ]⟩

/-- The characters of a dual family separate the points of `B ⧸ B₀` (evaluated at the chosen
representatives `p.out`, `q.out`). -/
lemma eq_of_forall_apply_out_eq [hχ : IsDualFamily B₀ χ] {p q : B ⧸ B₀}
    (hpq : ∀ i : I, χ i p.out = χ i q.out) : p = q := by
  refine p.out_equiv_out.1 (leftRel_apply.2 (hχ.mem_of_forall_eq_one _ fun i ↦ ?_))
  apply mul_left_cancel₀ (hχ.apply_ne_zero i p.out)
  rw [← hχ.add_right, add_neg_cancel_left, mul_one, hpq]

/-! ### Orthogonality of the characters -/

variable [IsTopologicalAddGroup B] [CompactSpace (B ⧸ B₀)]

/-- Orthogonality: for a dual family `χ` of characters of `B` modulo `B₀`, the mean of `χ i` over
`B ⧸ B₀` is `1` if `i = 0` and `0` otherwise. -/
lemma quotMean_eq_ite [hχ : IsDualFamily B₀ χ] [DecidableEq I] (i : I) :
    quotMean B₀ (χ i) = if i = 0 then 1 else 0 := by
  split_ifs with hi
  · simp [hi, quotMean, hχ.zero_apply]
  · -- The mean `m` satisfies `m * χ i a = m` for all `a`, and `χ i` is not trivial.
    have h_translate (a : B) : quotMean B₀ (χ i) * χ i a = quotMean B₀ (χ i) := by
      simpa [hχ.add_right, quotMean, integral_mul_const] using
        quotMean_translate (hχ.periodic i) a
    by_contra h_ne
    exact hi (hχ.eq_zero_of_forall_eq_one i fun a ↦ (mul_eq_left₀ h_ne).1 (h_translate a))

/-- Let `χ` be a dual family of characters of `B` modulo `B₀` (characters `χ i` trivial on `B₀`,
with `i ↦ χ i` an injective homomorphism, separating `B ⧸ B₀`). For a countable type `ι`, a map
`ξ : ι → I` that vanishes exactly on `S`, and summable coefficients `c`, the mean over `B ⧸ B₀` of
`x ↦ ∑' i, χ (ξ i) x * c i` is the sum of `c` over `S`. -/
lemma tsum_coeff_eq_quotMean [hχ : IsDualFamily B₀ χ] {ι : Type*} {c : ι → ℂ} [Countable ι]
    (ξ : ι → I) {S : Set ι} (hS : ∀ i : ι, ξ i = 0 ↔ i ∈ S) (hc : Summable c) :
    ∑' i : S, c i = quotMean B₀ fun x : B ↦ ∑' i : ι, χ (ξ i) x * c i := by
  classical
  -- Integrate term by term; by orthogonality only the terms with `ξ i = 0` have a nonzero mean.
  have h_term (i : ι) : quotMean B₀ (χ (ξ i)) * c i = S.indicator c i := by
    simp [quotMean_eq_ite, hS, indicator]
  rw [tsum_subtype, quotMean, ← integral_tsum_of_summable_integral_norm]
  · simp only [← h_term, quotMean, integral_mul_const]
  · exact fun i ↦ (hχ.periodic (ξ i)).integrable_out.mul_const (c i)
  · simpa [hχ.norm_eq_one] using hc.norm

/-! ### Fourier coefficients and Fourier inversion -/

/-- Let `χ` be a dual family of characters of `B` modulo `B₀` and `F` continuous and `B₀`-periodic.
Translating `F` by `a` divides its Fourier coefficient (the mean of `χ i * F` over `B ⧸ B₀`) by
`χ i a`. -/
lemma mul_quotMean_translate [hχ : IsDualFamily B₀ χ] (hF : IsContPeriodic B₀ F) (i : I) (a : B) :
    χ i a * quotMean B₀ (fun x : B ↦ χ i x * F (x + a)) = quotMean B₀ fun x : B ↦ χ i x * F x := by
  rw [← quotMean_translate (isContPeriodic_mul hF i) a, ← quotMean_const_mul]
  simp only [hχ.add_right, mul_assoc, mul_left_comm (χ i a)]

/-- Fourier inversion for a dual family `χ` of characters of `B` modulo `B₀` (characters `χ i`
trivial on `B₀`, with `i ↦ χ i` an injective homomorphism, separating `B ⧸ B₀`): if `F` is
continuous and `B₀`-periodic and its Fourier coefficients `a i` (the means of `χ i * F` over
`B ⧸ B₀`) are summable, then the series `∑' i, χ (-i) x * a i` has sum `F x` for every `x`. -/
lemma fourier_inversion [hχ : IsDualFamily B₀ χ] (hF : IsContPeriodic B₀ F) {a : I → ℂ}
    (ha : Summable a) (h_coef : ∀ i : I, a i = quotMean B₀ fun y : B ↦ χ i y * F y) (x : B) :
    HasSum (fun i : I ↦ χ (-i) x * a i) (F x) := by
  classical
  -- The conjugate characters `c i` on the compact quotient are orthonormal and, by
  -- Stone–Weierstrass, span a dense subspace: a Hilbert basis of `L²`. The `L²` expansion of `F`
  -- converges uniformly, as the coefficients are summable.
  let c : AddChar I C(B ⧸ B₀, ℂ) :=
    { toFun i := star ⟨fun q ↦ χ i q.out, (hχ.periodic i).continuous_out⟩
      map_zero_eq_one' := by simp [ext_iff, hχ.zero_apply]
      map_add_eq_mul' i j := by simp [ext_iff, hχ.add_left] }
  have c_apply (i : I) (q : B ⧸ B₀) : c i q = χ (-i) q.out := hχ.conj_apply i q.out
  let μ : Measure (B ⧸ B₀) := .addHaarMeasure ⊤
  let toL2 : C(B ⧸ B₀, ℂ) →L[ℂ] Lp ℂ 2 μ := toLp 2 μ ℂ
  -- The inner product with `c i` is the Fourier coefficient of index `i`.
  have inner_c (i : I) (f : C(B ⧸ B₀, ℂ)) :
      inner ℂ (toL2 (c i)) (toL2 f) = ∫ q : B ⧸ B₀, χ i q.out * f q ∂μ := by
    simp [toL2, inner_toLp, c_apply, hχ.conj_apply, mul_comm]
  -- The inner product of `c i` and `c j` is the mean of `χ (i - j)`.
  have h_orthonormal : Orthonormal ℂ (toL2 ∘ c) := orthonormal_iff_ite.2 fun i j ↦ by
    simpa [inner_c, c_apply, quotMean, hχ.add_left, μ, add_neg_eq_zero] using
      quotMean_eq_ite (B₀ := B₀) (i + -j)
  have h_dense : Dense (span ℂ (range c) : Set C(B ⧸ B₀, ℂ)) := by
    have star_c (i : I) : c (-i) = star (c i) := by simp [ext_iff, c_apply, hχ.conj_apply]
    have h_separates (p q : B ⧸ B₀) (hpq : ∀ i : I, c i p = c i q) : p = q :=
      hχ.eq_of_forall_apply_out_eq fun i ↦ by simpa [c_apply] using hpq (-i)
    exact stone_weierstrass_span (MonoidHom.mrange c.toMonoidHom)
      (by simpa using fun i ↦ ⟨-i, star_c i⟩) (by simpa using h_separates)
  have h_dense_L2 : ⊤ ≤ (span ℂ (range (toL2 ∘ c))).topologicalClosure := by
    -- The span of the image of `c` is the image of its dense span.
    rw [top_le_iff, ← dense_iff_topologicalClosure_eq_top, range_comp, ← toL2.coe_coe,
      span_image, map_coe]
    exact (toLp_denseRange ℂ μ ℂ (by simp)).dense_image toL2.continuous h_dense
  -- `F` as a function on the quotient; the terms of its Fourier series are `a i • c i`.
  let F' : C(B ⧸ B₀, ℂ) := ⟨fun q ↦ F q.out, hF.continuous_out⟩
  have h_summable : Summable fun i ↦ a i • c i :=
    .of_norm (by simp [c_apply, hχ.norm_eq_one, norm_eq_iSup_norm, ha.norm])
  have h_inner (i : I) : inner ℂ (toL2 (c i)) (toL2 F') = a i := by
    simp [inner_c, h_coef, quotMean, F', μ]
  have h_sum_L2 : HasSum (fun i ↦ toL2 (a i • c i)) (toL2 F') := by
    simpa [HilbertBasis.repr_apply_apply, h_inner] using
      (HilbertBasis.mk h_orthonormal h_dense_L2).hasSum_repr (toL2 F')
  simpa [F', c_apply, (hχ.periodic _).apply_out_mk, hF.apply_out_mk, mul_comm] using
    hasSum_apply (hasSum_of_hasSum_Lp h_summable h_sum_L2) (x : B ⧸ B₀)

/-- Let `χ` be a dual family of characters of `B` modulo `B₀`, and let `F` be continuous and
`B₀`-periodic. Suppose that the Fourier coefficient of `F` at `i` (the mean of `χ i * F` over
`B ⧸ B₀`) is zero whenever `χ i` respects the quasi-periods of `F` (that is, `χ i a = c` whenever
`c * F (x + a) = F x` for all `x`). Then `F = 0`. -/
lemma eq_zero_of_quotMean_mul_eq_zero [hχ : IsDualFamily B₀ χ] (hF : IsContPeriodic B₀ F)
    (h_mean : ∀ i : I, RespectsQuasiPeriods (χ i) F → quotMean B₀ (fun y : B ↦ χ i y * F y) = 0)
    (x : B) : F x = 0 := by
  -- Every Fourier coefficient of `F` vanishes, so `F = 0` by `fourier_inversion`.
  have h_coef (i : I) : 0 = quotMean B₀ fun y ↦ χ i y * F y := by
    -- If the coefficient `m` is nonzero then `χ i` respects each quasi-period `(a, c)` of `F`,
    -- since `χ i a * m = c * m`.
    by_contra h_ne
    suffices h_respects : RespectsQuasiPeriods (χ i) F from h_ne (h_mean i h_respects).symm
    intro a c h_period
    apply mul_right_cancel₀ (Ne.symm h_ne)
    calc χ i a * quotMean B₀ (fun y ↦ χ i y * F y)
      _ = χ i a * quotMean B₀ (fun y ↦ c * (χ i y * F (y + a))) := by
        simp only [mul_left_comm c, h_period]
      _ = c * (χ i a * quotMean B₀ fun y ↦ χ i y * F (y + a)) := by
        rw [quotMean_const_mul, mul_left_comm]
      _ = c * quotMean B₀ fun y ↦ χ i y * F y := by rw [mul_quotMean_translate hF]
  -- So the inversion series of `F` at `x` is the zero series.
  simpa using (fourier_inversion hF summable_zero h_coef x).tsum_eq.symm

end IsDualFamily

end New

end PeriodicFourier

/-!
## Decay of Fourier transforms by integration by parts

The estimate `New.exists_pow_mul_norm_fourier_le` is proved by induction on the order of decay, with
one integration by parts at each step. Two lemmas prepare that step: a lower bound for the factor
by which the integration by parts multiplies the Fourier transform, and the product rule for
`g * exp (h / a)`.
-/

section NonstationaryPhase

open Complex Real SchwartzMap FourierTransform ContDiff MeasureTheory LineDeriv

/-- For a vector `b` of a real inner product space and `v = ‖b‖⁻¹ • b` (which is `0` if `b = 0`),
the number `i + 2 π i ⟪b, v⟫` has norm at least `1 + ‖b‖`: its imaginary part is `1 + 2 π ‖b‖`. -/
lemma New.one_add_norm_le_norm_I_add_inner {V : Type*} [NormedAddCommGroup V]
    [InnerProductSpace ℝ V] (b : V) :
    1 + ‖b‖ ≤ ‖(Complex.I + 2 * π * Complex.I * inner ℝ b (‖b‖⁻¹ • b) : ℂ)‖ := by
  have h_inner : inner ℝ b (‖b‖⁻¹ • b) = ‖b‖ := by simp [inner_smul_right, field, sq]
  calc 1 + ‖b‖
    _ ≤ 1 + 2 * π * ‖b‖ := by nlinarith [norm_nonneg b, two_le_pi]
    _ = (Complex.I + 2 * π * Complex.I * inner ℝ b (‖b‖⁻¹ • b) : ℂ).im := by simp [h_inner]
    _ ≤ _ := im_le_norm _

/-- The product rule for the derivative of `g * exp (h / a)` in the direction `v`. -/
lemma fderiv_mul_exp_div_apply {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {g h : E → ℂ} {x : E} (hg : DifferentiableAt ℝ g x) (hh : DifferentiableAt ℝ h x) (a : ℂ)
    (v : E) :
    fderiv ℝ (fun y : E ↦ g y * Complex.exp (h y / a)) x v =
      fderiv ℝ g x v * Complex.exp (h x / a) +
        g x * (Complex.exp (h x / a) * (fderiv ℝ h x v / a)) := by
  simp only [div_eq_mul_inv]
  rw [(hg.hasFDerivAt.fun_mul (hh.hasFDerivAt.mul_const a⁻¹).cexp).fderiv]
  simp [add_comm, mul_comm]

/-- Let `c` and `q` be smooth functions of a parameter `s : T` and a point `x : ℂ^n`, with
`c (s, x) = 0` for `x` off the compact set `K`. For each `M` there is a `C` such that, for
`‖s‖ ≤ 1`, `‖a‖ ≤ 1`, `a ≠ 0` and every bound `D` of `‖exp (q (s, ·) / a)‖` on `K`, the Fourier
transform of `c (s, ·) * exp (q (s, ·) / a)` at any `b`, times `(‖a‖ * (1 + ‖b‖)) ^ M`, has norm at
most `C * D`. Proof: induction on `M`, for all parameter spaces `T`. One integration by parts in the
direction `v` of `b` gives a function of the same kind, with `v` and `a` as further parameters. -/
lemma New.exists_pow_mul_norm_fourier_le {n T : Type} [Fintype n] [NormedAddCommGroup T]
    [NormedSpace ℝ T] [ProperSpace T] {K : Set (EuclideanSpace ℂ n)} (hK : IsCompact K) (M : ℕ)
    {c q : T × EuclideanSpace ℂ n → ℂ} (hc : ContDiff ℝ ∞ c) (hq : ContDiff ℝ ∞ q)
    (h_zero : ∀ (s : T) (x : EuclideanSpace ℂ n), x ∉ K → c (s, x) = 0) :
    ∃ C : ℝ, ∀ (b : EuclideanSpace ℂ n) (s : T) (a : ℂ) (D : ℝ), ‖s‖ ≤ 1 → ‖a‖ ≤ 1 → a ≠ 0 →
      (∀ x ∈ K, ‖Complex.exp (q (s, x) / a)‖ ≤ D) →
      (‖a‖ * (1 + ‖b‖)) ^ M *
        ‖𝓕 (fun x : EuclideanSpace ℂ n ↦ c (s, x) * Complex.exp (q (s, x) / a)) b‖ ≤ C * D := by
  induction M generalizing T with
  | zero =>
    -- Bound the integral by the supremum of the integrand times the volume of `K`.
    obtain ⟨B, hB⟩ : ∃ B : ℝ, ∀ p ∈ Metric.closedBall (0 : T) 1 ×ˢ K, ‖c p‖ ≤ B :=
      ((isCompact_closedBall 0 1).prod hK).exists_bound_of_continuousOn hc.continuous.continuousOn
    refine ⟨B * volume.real K, fun b s a D hs ha_le ha_ne hD ↦ ?_⟩
    have h_bound (x : EuclideanSpace ℂ n) (hx : x ∈ K) :
        ‖𝐞 (-inner ℝ x b) • (c (s, x) * (q (s, x) / a).exp)‖ ≤ B * D := by
      simpa using norm_mul_le_of_le (hB (s, x) ⟨mem_closedBall_zero_iff.2 hs, hx⟩) (hD x hx)
    rw [fourier_eq, ← setIntegral_eq_integral_of_forall_compl_eq_zero (s := K)
      fun x hx ↦ by simp [h_zero s x hx]]
    simpa [mul_right_comm] using norm_setIntegral_le_of_norm_le_const hK.measure_lt_top h_bound
  | succ M ih =>
    -- With `F = c · exp (q / a)` one has `a • (I • F + ∂_{v} F) = c' · exp (q / a)`; the new
    -- amplitude `c'` is smooth in `x` and in the parameters `(s, v, a)`, and vanishes off `K`.
    let c' : (T × EuclideanSpace ℂ n × ℂ) × EuclideanSpace ℂ n → ℂ := fun ((s, v, a), x) ↦
      a * (I * c (s, x) + fderiv ℝ (fun y ↦ c (s, y)) x v) +
        c (s, x) * fderiv ℝ (fun y ↦ q (s, y)) x v
    have h_supp : ∀ (p : T × EuclideanSpace ℂ n × ℂ) (x : EuclideanSpace ℂ n), x ∉ K →
        c' (p, x) = 0 := fun (s, v, a) x hx ↦ by
      have h_near : (fun y ↦ c (s, y)) =ᶠ[nhds x] fun _ ↦ 0 :=
        Filter.eventuallyEq_of_mem (hK.isClosed.compl_mem_nhds hx) (h_zero s)
      simp [c', h_near.fderiv_eq, h_zero s x hx]
    obtain ⟨C, hC⟩ :=
      ih (c := c') (q := fun ((s, _), x) ↦ q (s, x)) (by fun_prop) (by fun_prop) h_supp
    refine ⟨C, fun b s a D hs ha_le ha_ne hD ↦ ?_⟩
    let v : EuclideanSpace ℂ n := ‖b‖⁻¹ • b
    let F : 𝓢(EuclideanSpace ℂ n, ℂ) := HasCompactSupport.toSchwartzMap
      (f := fun x ↦ c (s, x) * (q (s, x) / a).exp)
      (.intro hK fun x hx ↦ by simp [h_zero s x hx]) (by fun_prop)
    have h_parts (x : EuclideanSpace ℂ n) :
        c' ((s, v, a), x) * (q (s, x) / a).exp = (a • (I • F + ∂_{v} F)) x := by
      have hc_diff : Differentiable ℝ c := hc.differentiable (by simp)
      have hq_diff : Differentiable ℝ q := hq.differentiable (by simp)
      have h_leibniz : ∂_{v} F x = fderiv ℝ (fun y ↦ c (s, y)) x v * (q (s, x) / a).exp +
          c (s, x) * ((q (s, x) / a).exp * (fderiv ℝ (fun y ↦ q (s, y)) x v / a)) :=
        fderiv_mul_exp_div_apply (by fun_prop) (by fun_prop) a v
      change _ = a * (I * (c (s, x) * (q (s, x) / a).exp) + ∂_{v} F x)
      simp only [h_leibniz, c']
      field
    -- On the Fourier side the operator is multiplication by `a * (I + 2 π I ⟪b, v⟫)`.
    have h_fourier :
        𝓕 (a • (I • F + ∂_{v} F)) b = a * (I + 2 * π * I * inner ℝ b v) * 𝓕 F b := by
      simp (disch := fun_prop) [fourier_lineDerivOp_eq, add_mul, mul_add, mul_assoc]
    have h_factor : 1 + ‖b‖ ≤ ‖(I + 2 * π * I * inner ℝ b v : ℂ)‖ :=
      one_add_norm_le_norm_I_add_inner b
    -- So one factor `‖a‖ * (1 + ‖b‖)` is absorbed, and the induction hypothesis applies to `c'`.
    calc (‖a‖ * (1 + ‖b‖)) ^ (M + 1) * ‖𝓕 F b‖
      _ ≤ (‖a‖ * (1 + ‖b‖)) ^ M * ‖𝓕 (a • (I • F + ∂_{v} F)) b‖ := by
        grw [h_fourier, norm_mul, norm_mul, ← h_factor, pow_succ, mul_assoc]
      _ ≤ C * D := by
        have h_param : ‖(s, v, a)‖ ≤ 1 := by
          simp [Prod.norm_def, hs, ha_le, v, norm_smul, inv_mul_le_one]
        rw [fourier_coe, ← funext h_parts]
        exact hC b (s, v, a) a D h_param ha_le ha_ne hD

end NonstationaryPhase
