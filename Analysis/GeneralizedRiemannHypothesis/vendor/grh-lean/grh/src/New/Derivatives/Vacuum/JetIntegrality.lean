import New.Derivatives.FormalGroup.Resolution
import New.Derivatives.Vacuum.IntegralVacuum
import New.UpperBound.Seesaw.AdmissibleCombinations

/-!
# Integrality of jets of theta products and stability of standard data

This file proves two facts. Let `μ_i` be linear forms that are `d` times integral forms, and let `y`
be the parameter described below. Then the derivatives at `0` of a product of series `θ(μ_i z)`,
times an integral series in the `y(μ_i z)`, are integral.
Standard data of level `δ` are stable under the Heisenberg operators of finite points that `δ`
makes integral above `p`, and under the Weil operators of finite points that are integral above
`p`. An element of `ℂ_[p]` is integral if its norm is at most `1`.

* `New.jet`: the pairing `(Q(∂) F)(0)` of a polynomial `Q` with a power series `F`.
* `New.taylorVia ιₚ C.θ`: the Taylor series at `0` of the function `θ` of the CM lattice `C`, with
  coefficients sent to `ℂ_[p]` by `ιₚ`; and `New.linearSeries c`, the linear form `∑ c_x z_x`.
* `New.CMLattice.multiSeriesRing`: the integral power series in the `y(μ_i z)`, where the parameter
  `y` is the Taylor series of `C.translatedY`.
* `New.Parameters.integralAfter δ S`: the finite adelic vectors `x` with `δ x` integral at the
  places in `S`.
* `New.Parameters.standardData V δ`: the module over `New.embValRing` spanned by the translates of
  the integral vacuum by the points that `δ` makes integral above `p`.

## Main definitions and results

* `New.CMLattice.jetRing`: the ring generated by the integral series in the `y(μ_i z)` and by the
  `θ(μ_i z)` and `(-log θ)'(μ_i z)`.
* `New.Parameters.finHeisenbergOp_mem_standardData`: standard data of level `δ` are stable under the
  Heisenberg operators of finite points that `δ` makes integral above `p`.
* `New.Parameters.omega_mem_standardData`: they are stable under the Weil operators of finite
  points integral above `p`.
-/

/-!
## Integrality of the derivatives of products of copies of `θ`

The series of `New.CMLattice.norm_jet_thetaProd_pow_mul_le_one` lies in the ring
`New.CMLattice.jetRing`.
-/

section ProductJetIntegrality

open MvPowerSeries

namespace New

/-- Let `S` be a ring of power series that is preserved by partial derivatives and whose elements
have integral constant terms, and let `φ : R →+* ℂ_[p]` have integral values. Then the jet
`(φ(Q)(∂) F)(0)` is integral for `F` in `S` and every polynomial `Q` over `R`. -/
lemma norm_jet_le_one_of_pderiv_mem {p : ℕ} [Fact p.Prime] {X : Type}
    {S : Subring (MvPowerSeries X ℂ_[p])} (h_const : ∀ F ∈ S, ‖constantCoeff F‖ ≤ 1)
    (h_deriv : ∀ F ∈ S, ∀ x : X, pderiv x F ∈ S)
    {R : Type} [CommRing R] {φ : R →+* ℂ_[p]} (hφ : ∀ a : R, ‖φ a‖ ≤ 1) (Q : MvPolynomial X R)
    {F : MvPowerSeries X ℂ_[p]} (hF : F ∈ S) : ‖jet ℂ_[p] (Q.map φ) F‖ ≤ 1 := by
  induction Q using MvPolynomial.induction_on generalizing F with
  | C a =>
    simpa [← MvPolynomial.monomial_zero', jet_monomial] using
      (mul_le_of_le_one_left (norm_nonneg _) (hφ a)).trans (h_const F hF)
  | add Q Q' hQ hQ' =>
    rw [map_add, map_add, LinearMap.add_apply]
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (hQ hF) (hQ' hF))
  | mul_X Q x hQ =>
    rw [map_mul, MvPolynomial.map_X, jet_mul_X]
    exact hQ (h_deriv F hF x)

namespace CMLattice

variable {p : ℕ} [Fact p.Prime] {I X : Type} [Fintype I] [Fintype X]
  {d : ℕ} (C : CMLattice d) [PadicPlace p]

/-- Let `C` be a CM lattice for a prime `d ≡ 7` modulo `8`, with `2`-torsion point `t`, and fix a
`p`-adic place `ιₚ` of `ℂ`. Let `θ` be the twisted translate of the sigma function of `C` by `t`,
normalised to `θ(0) = 1`, and let `g = -log θ` (`negLogTheta`), a power series over `ℂ_[p]`. Let `y`
be the Taylor series at `0`, read in `ℂ_[p]` through `ιₚ`, of the function `C.translatedY`. Then
`d g''` lies in `integralSeriesRing`, the ring of power series in `y` with coefficients of norm at
most `1`. -/
lemma smul_derivative_derivative_negLogTheta_mem [PrimeSevenModEight d] :
    (d : ℂ_[p]) • PowerSeries.derivative (PowerSeries.derivative C.negLogTheta) ∈
      C.integralSeriesRing := by
  -- Multiplication by `√-d` maps the lattice to itself, so `√-d` is integral.
  have h_sqrt : ‖ιₚ (.I * √d)‖ ≤ 1 :=
    C.norm_le_one_of_mapsTo_lattice (C.mul_mem_of_quadInt (I_mul_sqrt_mem_quadInt d))
  have hd : (d : ℂ_[p]) = -ιₚ (.I * √d) * ιₚ (.I * √d) := by
    rw [neg_mul, ← sq, map_I_mul_sqrt_sq, neg_neg]
  have h_const : ‖(d : ℂ_[p]) * (2 * PowerSeries.coeff 2 C.negLogTheta)‖ ≤ 1 := by
    rw [hd, mul_assoc, norm_mul, norm_neg]
    exact (mul_le_of_le_one_left (norm_nonneg _) h_sqrt).trans
      C.norm_sqrt_mul_coeff_two_negLogTheta_le_one
  have h_eq : (d : ℂ_[p]) •
      PowerSeries.derivative (PowerSeries.derivative C.negLogTheta) =
        ((d : ℂ_[p]) * (2 * PowerSeries.coeff 2 C.negLogTheta)) • (1 : PowerSeries ℂ_[p]) +
          (d : ℂ_[p]) • taylorVia ιₚ C.translatedX := by
    simp [derivative_derivative_negLogTheta, PowerSeries.smul_eq_C_mul]
  rw [h_eq]
  exact add_mem (C.isSeriesGenerator_translatedY.smul_mem h_const (one_mem _))
    (C.isSeriesGenerator_translatedY.smul_mem (IsUltrametricDist.norm_natCast_le_one _ d)
      C.taylorVia_translatedX_mem_integralSeriesRing)

/-- For a family of linear forms `μ_i`, the ring generated by `multiSeriesRing`, the integral power
series in the `y(μ_i z)`, and by the `θ(μ_i z)` and `g'(μ_i z)`, where `g = -log θ`. Here `y` is the
Taylor series of `C.translatedY`, the function `(℘'(z + t) - a₁ (℘(z + t) - ℘(t))) / 2` for the
`2`-torsion point `t` of `C` and the square root `a₁` of `12 ℘(t)`. -/
noncomputable def jetRing (μ : I → X → ℂ_[p]) : Subring (MvPowerSeries X ℂ_[p]) :=
  .closure (C.multiSeriesRing μ ∪
    (Set.range fun i : I ↦ (taylorVia ιₚ C.θ).subst (linearSeries (μ i))) ∪
    Set.range fun i : I ↦ (PowerSeries.derivative C.negLogTheta).subst (linearSeries (μ i)))

section Generators

variable {μ : I → X → ℂ_[p]} {F : MvPowerSeries X ℂ_[p]}

/-- The integral series in the `y(μ_i z)` lie in `jetRing`. -/
lemma mem_jetRing_of_mem_multiSeriesRing (hF : F ∈ C.multiSeriesRing μ) : F ∈ C.jetRing μ :=
  Subring.subset_closure (.inl (.inl hF))

/-- The series `θ(μ_i z)` lies in `jetRing`. -/
lemma theta_mem_jetRing (i : I) :
    (taylorVia ιₚ C.θ).subst (linearSeries (μ i)) ∈ C.jetRing μ :=
  Subring.subset_closure (.inl (.inr ⟨i, rfl⟩))

/-- The series `g'(μ_i z)`, where `g = -log θ`, lies in `jetRing`. -/
lemma derivative_negLogTheta_mem_jetRing (i : I) :
    (PowerSeries.derivative C.negLogTheta).subst (linearSeries (μ i)) ∈ C.jetRing μ :=
  Subring.subset_closure (.inr ⟨i, rfl⟩)

/-- The ring `jetRing` is stable under multiplication by integral constants. -/
lemma smul_mem_jetRing {c : ℂ_[p]} (hc : ‖c‖ ≤ 1) (hF : F ∈ C.jetRing μ) :
    c • F ∈ C.jetRing μ := by
  rw [smul_eq_C_mul]
  exact mul_mem (C.mem_jetRing_of_mem_multiSeriesRing (C.C_mem_multiSeriesRing hc)) hF

/-- The product `∏ θ(μ_i z) ^ m i` lies in `jetRing`. -/
lemma thetaProd_mem_jetRing (m : I → ℕ) : C.thetaProd μ m ∈ C.jetRing μ :=
  prod_mem fun i _ ↦ pow_mem (C.theta_mem_jetRing i) (m i)

end Generators

/-- Let `C` be a CM lattice, and let `θ` and `y` be the Taylor series at `0` of `C.θ` and of
`C.translatedY`, read in `ℂ_[p]` through `ιₚ`. Let `μ_i z = ∑ μ i x * z_x` be linear forms, for
`i : I` and `x : X`. The ring `C.jetRing μ` is generated by the integral power series in the
`y(μ_i z)` and by the `θ(μ_i z)` and `(-log θ)'(μ_i z)`. Its elements have constant term of norm at
most `1`, because `y(0) = 0`, `θ(0) = 1` and `(-log θ)'(0) = 0`. -/
lemma norm_constantCoeff_le_of_mem_jetRing {μ : I → X → ℂ_[p]} {F : MvPowerSeries X ℂ_[p]}
    (hF : F ∈ C.jetRing μ) : ‖constantCoeff F‖ ≤ 1 := by
  suffices h_le : C.jetRing μ ≤ (valRingCp p).comap constantCoeff from h_le hF
  rw [jetRing, Subring.closure_le]
  rintro G ((hG | ⟨i, rfl⟩) | ⟨i, rfl⟩)
  · exact C.norm_constantCoeff_le_of_mem_multiSeriesRing hG
  · simp [constantCoeff_subst_of_constantCoeff_eq_zero, constantCoeff_linearSeries]
  · -- The constant term of `g'` is the coefficient of `z` in `g`, which vanishes.
    simp [constantCoeff_subst_of_constantCoeff_eq_zero, constantCoeff_linearSeries,
      PowerSeries.coeff_derivative,
      ← PowerSeries.coeff_zero_eq_constantCoeff_apply, coeff_one_negLogTheta]

variable [PrimeSevenModEight d]

/-- Let `C` be a CM lattice for a prime `d ≡ 7` modulo `8`, with `2`-torsion point `t`. Let the
linear forms `μ_i = d ν_i` be `d` times forms `ν_i` with coefficients of norm at most `1`. If `F`
lies in `jetRing`, then so does each partial derivative `pderiv x F`. -/
lemma pderiv_mem_jetRing {F : MvPowerSeries X ℂ_[p]} {ν : I → X → ℂ_[p]}
    (hν : ∀ (i : I) (x : X), ‖ν i x‖ ≤ 1) (hF : F ∈ C.jetRing ((d : ℂ_[p]) • ν)) (x : X) :
    pderiv x F ∈ C.jetRing ((d : ℂ_[p]) • ν) := by
  set μ : I → X → ℂ_[p] := (d : ℂ_[p]) • ν
  have hμ (i : I) (x : X) : μ i x = ν i x * d := mul_comm _ _
  have h_int (i : I) (x : X) : ‖μ i x‖ ≤ 1 := by
    simpa [hμ] using (mul_le_of_le_one_left (norm_nonneg _) (hν i x)).trans
      (IsUltrametricDist.norm_natCast_le_one ℂ_[p] d)
  induction hF using Subring.closure_induction with
  | mem G hG =>
    obtain (hG | ⟨i, rfl⟩) | ⟨i, rfl⟩ := hG
    · exact C.mem_jetRing_of_mem_multiSeriesRing (C.pderiv_mem_multiSeriesRing h_int hG x)
    · -- With `g = -log θ` one has `θ' = -θ g'`.
      have h_eq : pderiv x ((taylorVia ιₚ C.θ).subst (linearSeries (μ i))) =
          μ i x • -((taylorVia ιₚ C.θ).subst (linearSeries (μ i)) *
            (PowerSeries.derivative C.negLogTheta).subst (linearSeries (μ i))) := by
        rw [pderiv_subst_linearSeries, derivative_taylorVia_theta,
          ← PowerSeries.coe_substAlgHom (hasSubst_linearSeries _), map_neg, map_mul]
      rw [h_eq]
      exact C.smul_mem_jetRing (h_int i x)
        (neg_mem (mul_mem (C.theta_mem_jetRing i) (C.derivative_negLogTheta_mem_jetRing i)))
    · -- The derivative is `ν_i x` times `(d g'')(μ_i z)`: the factor `d` of the linear form clears
      -- the denominator of `g''`.
      rw [pderiv_subst_linearSeries, hμ i x, mul_smul,
        ← PowerSeries.subst_smul (hasSubst_linearSeries _)]
      exact C.smul_mem_jetRing (hν i x) (C.mem_jetRing_of_mem_multiSeriesRing
        (subst_mem_multiSeriesRing μ C.smul_derivative_derivative_negLogTheta_mem i))
  | zero => simp
  | one => simp
  | add G G' _ _ hG hG' => simpa using add_mem hG hG'
  | neg G _ hG => simpa using neg_mem hG
  | mul G G' hG_mem hG'_mem hG hG' =>
    rw [Derivation.leibniz]
    exact add_mem (mul_mem hG_mem hG') (mul_mem hG'_mem hG)

/-- Let `C` be a CM lattice for a prime `d ≡ 7` modulo `8`, with `2`-torsion point `t`. Let `θ` and
`y` be the Taylor series at `0`, read in `ℂ_[p]` through `ιₚ`, of `C.θ` and of `C.translatedY`. Let
the linear forms `μ_i = d ν_i` be `d` times forms `ν_i` with integral coefficients, and let `H` be
an integral series in the `y(μ_i z)`. If `φ : R →+* ℂ_[p]` has integral values, then the jet
`(φ(Q)(∂) F)(0)` of `F = (∏ θ(μ_i z) ^ m i) ^ N * H` is integral for every polynomial `Q` over
`R`. -/
lemma norm_jet_thetaProd_pow_mul_le_one {ν : I → X → ℂ_[p]}
    (hν : ∀ (i : I) (x : X), ‖ν i x‖ ≤ 1) (m : I → ℕ) (N : ℕ)
    {H : MvPowerSeries X ℂ_[p]} (hH : H ∈ C.multiSeriesRing ((d : ℂ_[p]) • ν))
    {R : Type} [CommRing R] {φ : R →+* ℂ_[p]} (hφ : ∀ a : R, ‖φ a‖ ≤ 1) (Q : MvPolynomial X R) :
    ‖jet ℂ_[p] (Q.map φ) (C.thetaProd ((d : ℂ_[p]) • ν) m ^ N * H)‖ ≤ 1 :=
  norm_jet_le_one_of_pderiv_mem (fun _ ↦ C.norm_constantCoeff_le_of_mem_jetRing)
    (fun _ ↦ C.pderiv_mem_jetRing hν) hφ Q
    (mul_mem (pow_mem (C.thetaProd_mem_jetRing m) N) (C.mem_jetRing_of_mem_multiSeriesRing hH))

end CMLattice

end New

end ProductJetIntegrality

/-! ## Stability of standard data -/

namespace New.Parameters

open Finset Complex Matrix Space Submodule NumberField

variable {P : Parameters} {s : ℕ} {n : Type} {δ : 𝓞 P.K}

/-- The standard lattice `Ôⁿ` is contained in `integralAfter δ S`: its vectors stay integral at the
places of `S` after multiplication by the integer `δ`. -/
lemma integralAfter.stdLattice_le {S : FinPlace (P.E s) → Prop} :
    stdLattice (P.E s) n ≤ integralAfter δ S := by
  intro x hx i w _
  exact mem_Ô.1 (mul_mem (coe_mem_Ô (algebraMap (𝓞 P.K) (𝓞 (P.E s)) δ)) (hx i)) w

variable [Fintype n] [DecidableEq n] {ε : n → ℤˣ} {V : Space (P.E s) n ε} {p : ℕ} [Fact p.Prime]
  [PadicPlace p] {f : 𝒮 V}

/-- Standard data are a submodule of the space `𝒮 V` of the Weil representation of the hermitian
space `V` over `embValRing`, the ring of complex numbers whose image under `ιₚ` has norm at most
`1`. So they are stable under multiplication by such numbers. -/
lemma smul_mem_standardData_of_norm_le_one {c : ℂ} (hc : ‖ιₚ c‖ ≤ 1)
    (hf : f ∈ standardData V δ) : c • f ∈ standardData V δ :=
  smul_mem _ (⟨c, hc⟩ : embValRing) hf

/-- Let `V` be a hermitian space over the cyclotomic extension `P.E s` of the imaginary quadratic
field `P.K`, and let `δ` be an integer of `P.K`. The integral vacuum `intVacuum V` is the vacuum
vector of `𝒮 V` times the power `vacuumScale ^ card n` of a fixed nonzero scalar. Its translate by
the Heisenberg operator of a finite adelic vector `x` with `δ x` integral above `p` is one of the
generators of the standard data of level `δ`. -/
lemma finHeisenbergOp_intVacuum_mem_standardData {x : n → 𝔸f (P.E s)}
    (hx : x ∈ integralAfter δ fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal) :
    V.finHeisenbergOp x (intVacuum V) ∈ standardData V δ :=
  subset_span ⟨x, hx, rfl⟩

/-- The standard data `standardData V δ` are the span of the translates of the integral vacuum by
the points that `δ` makes integral above `p`. The integral vacuum is the vacuum of `𝒮 V` times
`vacuumScale ^ card n`. These data are stable under the Heisenberg operator `V.finHeisenbergOp x` of
a finite adelic vector `x` such that `δ x` is integral at the places above `p`. -/
lemma finHeisenbergOp_mem_standardData {x : n → 𝔸f (P.E s)}
    (hx : x ∈ integralAfter δ fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal)
    (hf : f ∈ standardData V δ) : V.finHeisenbergOp x f ∈ standardData V δ := by
  induction hf using span_induction with
  | mem _ h_gen =>
    -- The operators of `x` and `y` compose to that of `x + y` up to a root of unity.
    obtain ⟨y, hy, rfl⟩ := h_gen
    rw [finHeisenbergOp_finHeisenbergOp]
    exact smul_mem_standardData_of_norm_le_one (norm_map_selfDualAddChar ιₚ _).le
      (finHeisenbergOp_intVacuum_mem_standardData (add_mem hx hy))
  | zero => simp
  | add f f' _ _ hf hf' => simpa using add_mem hf hf'
  | smul c f _ hf => simpa using smul_mem _ c hf

omit [Fact p.Prime] [PadicPlace p] in
/-- Let `g` be a finite unitary point in `integralAbove n p`, that is, integral at the places above
`p`. If `δ x` is integral above `p`, then so is `δ g x`. -/
lemma mulVec_mem_integralAfter {g : Gf (P.E s) n} (hg : g ∈ integralAbove n p)
    {x : n → 𝔸f (P.E s)} (hx : x ∈ integralAfter δ fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal) :
    (g : Matrix n n (𝔸f (P.E s))) *ᵥ x ∈
      integralAfter δ fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal := by
  intro i w hw
  -- At the place `w`, the vector `δ g x` is the integral matrix `g` applied to `δ x`.
  let a : 𝔸f (P.E s) := algebraMap (P.E s) (𝔸f (P.E s)) (algebraMap P.K (P.E s) δ)
  have h_eq : evalAt w (a * ((g : Matrix n n (𝔸f (P.E s))) *ᵥ x) i) =
      ((Gf.atPlace w g).val *ᵥ fun j : n ↦ evalAt w (a * x j)) i := by
    have h_entry (j : n) :
        (Gf.atPlace w g).val i j = evalAt w ((g : Matrix n n (𝔸f (P.E s))) i j) := rfl
    simp [mulVec, dotProduct, mul_sum, mul_left_comm a, h_entry]
  rw [h_eq]
  exact (mulVec_mem_intVectors_iff (hg w hw)).2 (fun j ↦ hx j w hw) i

/-- The Weil operator `ω(1, g)` takes the translate by `x` of the integral vacuum `intVacuum V` to
`(finMultiplier g⁻¹)⁻¹` times the translate by `g x` of the sum of the translates of the integral
vacuum by the `g y`, where `y` runs over integral vectors modulo those that `g` keeps integral. Here
`finMultiplier` is the finite part of the scalar factor `weilMultiplier` in the definition of the
Weil operators. -/
lemma omega_finHeisenbergOp_intVacuum (g : Gf (P.E s) n) (x : n → 𝔸f (P.E s)) :
    let L : AddSubgroup (n → 𝔸f (P.E s)) := stdLattice (P.E s) n
    let M : Matrix n n (𝔸f (P.E s)) := g
    V.ω (1, g) (V.finHeisenbergOp x (intVacuum V)) =
      (finMultiplier g⁻¹)⁻¹ • V.finHeisenbergOp (M *ᵥ x)
        (∑ᶠ y : L ⧸ (L.comap M.mulVecLin).addSubgroupOf L,
          V.finHeisenbergOp (M *ᵥ y.out.val) (intVacuum V)) := by
  have h_coeff : finMultiplier g / (‖finMultiplier g‖ : ℂ) ^ 2 = (finMultiplier g⁻¹)⁻¹ := by
    rw [finMultiplier_inv, ← mul_conj', div_mul_cancel_left₀ (finMultiplier_ne_zero g)]
  simp [← h_coeff, intVacuum, omega_vacElem_sum, ← smul_finsum,
    smul_comm (P.vacuumScale s ^ Fintype.card n)]

/-- Standard data of level `δ` are stable under the Weil operator `ω(1, g)` of a finite unitary
point `g` in `integralAbove n p`. -/
lemma omega_mem_standardData {g : Gf (P.E s) n} (hg : g ∈ integralAbove n p)
    (hf : f ∈ standardData V δ) : V.ω (1, g) f ∈ standardData V δ := by
  induction hf using span_induction with
  | mem _ h_gen =>
    obtain ⟨x, hx, rfl⟩ := h_gen
    -- The image is a multiple of the translate by `g x` of a sum of translates of the vacuum by the
    -- `g y`, with `y` integral. The factor is a unit, as `g⁻¹` is integral above `p` too.
    have h_unit : ‖ιₚ (finMultiplier g⁻¹)⁻¹‖ = 1 := by
      simp [norm_finMultiplier_eq_one (inv_mem hg)]
    rw [omega_finHeisenbergOp_intVacuum]
    refine smul_mem_standardData_of_norm_le_one h_unit.le
      (finHeisenbergOp_mem_standardData (mulVec_mem_integralAfter hg hx) ?_)
    exact finsum_induction (· ∈ standardData V δ) (zero_mem _) (fun _ _ ↦ add_mem) fun y ↦
      finHeisenbergOp_intVacuum_mem_standardData
        (mulVec_mem_integralAfter hg (integralAfter.stdLattice_le y.out.property))
  | zero => simp
  | add f f' _ _ hf hf' => simpa using add_mem hf hf'
  | smul c f _ hf => simpa using smul_mem _ c hf

end New.Parameters
