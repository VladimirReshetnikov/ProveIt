import Lib.Weil.DualPair.HolomorphicData
import New.OneLift.HeckeValues.CharacterLift
import New.UpperBound.Objects.Rows

/-!
# Data of the three exchanges: the carrier, the choices and the functions 𝖥_i

For admissible data `D`, the element `ϖ = New.Data.piM` of 𝓞_E generates the product of the primes
at the places `New.Data.chosenPlace`. The file defines the objects of the three exchanges that turn
a twist into a number on `W_j = New.Data.spaceW`, `1 ≤ j ≤ m`: the carrier φ° with its coefficients
𝖺, the modulus `ϖ^c`, the index sets of the spaces, the characters, the choices `i`, the fixed
polynomial `P` and the functions `𝖥_i`.

The standard definite space `E^n` is also written `I_n`, and `υ = New.WeilData.upsilonU1` is the
character `ν_η` of weight 1 and trivial tame part. The letter `ϑ` denotes a tame character
(`New.Data.TameChar`); it is a twist only where this is said.

| object | Lean name | object | Lean name |
|---|---|---|---|
| `S = E^{2m,m}` | `CarrierIndex` | `χ′` | `twistedChiMPow` |
| `W♭ = E^{6m+1}` | `FlatIndex` | `ν″` | `firstFactorChar` |
| `V″`, `W′` | `FirstFactorIndex` | `ν♭ υ^m` | `carrierChar` |
| `V°` | `SecondFactorIndex` | `φ°`, `𝖺 χ′` | `carrierForm`, `carrierCoeff` |
| columns of `μ⁺`, plus Δ′ indices | `DetIndex` | `P`, `𝖥_i` | `paddedMinorProd`, `choiceFn` |
| choices `i` | `ChoiceIndex` | `u`, `u°` | `conjHolomorphicWeight`, `kernelWeight` |

## Main definitions and results

* `New.Rows.carrierForm`: the carrier φ°, the theta lift of the constant function from the unitary
  group of a negative definite space to that of a space with signs `+1` on `2 m` and `−1` on `m`
  coordinates.
* `New.Rows.carrierCoeff`: the coefficients 𝖺 times a character, a class sum of theta kernels
  between two definite spaces.
* `New.Data.choiceFn`: the function `𝖥_i` on `U(W_j)`, the integral of the carrier against a theta
  kernel.
* `New.Data.isTameFor_of_hasWeight`, `New.Data.isTameFor_twistedChiMPow`: let `ϑ` be a twist,
  `c ≠ 0`, and take a character whose tame part is `ψ * ϑ.tamePart`, with `ψ` non-trivial exactly at
  the chosen places. It ramifies exactly at the places dividing `D.twistModulus ϑ c`, that is, the
  chosen places and the places in `ϑ.Q` (`New.Exchange.IsTameFor`). This applies to
  `New.Data.twistedChiMPow`.
* `New.Rows.exists_int_weylRep_invariant_fockPoly_eq_smul_monomial`: for a monomial of the right
  degrees there is an integral vector whose Fock polynomial is a nonzero multiple of the monomial.
  The vector is fixed by the elements that act trivially on the rows of the monomial.

Notions from other files:
* `New.Modulus`: a nonzero ideal of 𝓞_E that is never divisible by both a place w and its conjugate
  w̄.
* `New.Data.spaceW`: the diagonal hermitian space `W_j` of rank r over E with signs `D.signsW j`.
* `New.Data.liftWeight`: the natural number `κ_j`, a function of the infinite place; the character
  `New.Data.liftChar` of the `j`-th lift has weight `−κ_j`.
* The numbers of `D`: the rank `r` of `W_j`, the number `m` of lifts, `k = r + 1 − m`, `t = 5 r`,
  the gap `Δ = New.Data.gap = 2 r ^ 8` and `Δ′ = New.Data.reducedHalfGap = Δ / 2 − (t + 1) / 2`.
* `New.Data.descentPair`: the data (`New.DescentPair`) of the lift from `W_j` to `I_{r+t}`. They
  include a `numbering` of the basis vectors of `W_j` and, at each infinite place, two partitions
  `μ⁺`, `μ⁻` given by their numbers `colsPlus`, `colsMinus` of columns of each height.
* `New.Data.TameChar`, `New.Data.Twist`: a character of U(1)(𝔸) of weight 0 whose tame part is
  trivial outside a finite set Q of places; it is a twist if the tame part is non-trivial on all of
  Q.

## Use in the argument

* The carrier φ° and the coefficients 𝖺: the class sum of a twisted square kernel against 𝖺 is a
  multiple of φ°. See `New.OneLift.ComparisonOperator.ThreeExchanges`.
* Moduli, index sets, polynomial and functions `𝖥_i`: the third exchange and its left side as a
  theta series. See `New.OneLift.ComparisonOperator.ThreeExchanges` and
  `New.OneLift.ComparisonOperator.FirstFactors`.
* Order, weights and gaps on `W_j`: the functions `𝖥_i` separate good forms. See
  `New.OneLift.ComparisonOperator.ProductsSpan`.
* Integral vectors with a monomial Fock polynomial: the height bound for inverse ratios of twisted
  to untwisted Hecke L-values. See `New.OneLift.HeckeValues.TwistedValueHeights`.
-/

noncomputable section

/-! ## The ideal generated by ϖ -/

/-- Let `D` be admissible data and `ϖ = D.piM` the integer of E whose prime divisors are the
chosen places. The ideal generated by `ϖ` is the product of the primes `D.chosenPlace i`, over all
pairs `i = (k, w)` with `w` a chosen place above the prime `p_k = D.levelPrime k`. -/
lemma New.Rows.span_piM {P : Parameters} (D : Data P) :
    Ideal.span {D.piM} = ∏ i : (k : Fin 2) × D.ChosenPlace k, (D.chosenPlace i).asIdeal := by
  -- Both sides consist of the `x` that lie in every prime `D.chosenPlace i`. For the left side pass
  -- to the integral adeles, where `D.piM` vanishes to order one at each place containing it.
  have h_places (w : FinPlace D.E) : D.piM ∈ w.asIdeal ↔ w ∈ Set.range D.chosenPlace := by
    simp [D.range_chosenPlace, Data.IsChosen]
  ext x
  rw [Ideal.mem_span_singleton, ← dvd_iff_Ô D.piM_ne_zero,
    dvd_iff_reduceAt_eq_zero D.intValuation_piM,
    mem_prod_finPlace_iff D.isConjApart_chosenPlace.injective]
  simp only [h_places, Set.forall_mem_range]
  -- The image of `x` reduces to `0` at a place exactly if the place contains `x`.
  exact forall_congr' fun i ↦ by simp

/-! ## Stacked determinants, the trivial modulus, the carrier φ° and the coefficients 𝖺 -/

namespace New.Rows

open Matrix MvPolynomial WeilData NumberField

variable {Φ l n n' : Type} [Fintype l] [DecidableEq l] [Fintype n'] [DecidableEq n']

/-- The determinant of the square matrix formed by the columns `j` of the constant matrix `η` (rows
`l`) stacked over the matrix of variables `X (τ, a, b)` (rows `n'`), both with columns `n`. -/
def stackedDet (τ : Φ) (η : Matrix l n ℂ) (j : l ⊕ n' → n) : MvPolynomial (Φ × n' × n) ℂ :=
  (((η.map C).fromRows (of fun (a : n') (b : n) ↦ X (τ, a, b))).submatrix id j).det

variable (E : Type) [Field E] [CMType E] [WeilData E] (m : ℕ)

/-- The modulus of E whose ideal is the whole ring of integers. -/
abbrev unitModulus (E : Type) [Field E] [NumberField E] [IsCMField E] : Modulus E where
  ideal := ⊤
  ne_bot := top_ne_bot
  not_le_star w := by simp [w.isPrime.ne_top']

/-- The carrier φ°: the theta lift of the constant function 1 from the unitary group of the negative
definite space I_m⁻ to that of the space S with signs +1 on `Fin (2 * m)` and −1 on `Fin m`. The
theta kernel is taken with trivial modulus, function 1 and the polynomial ∏_τ det(y⁻_τ)^{2m}, where
y⁻_τ is the m × m block of variables in the rows of sign −1. Its characters are υ^m and 1, so it is
υ(det g′)^m times the kernel with standard characters, for g′ in the group of I_m⁻. -/
def carrierForm : G E ((1 : Fin ((2 : ℕ) * m) → ℤˣ) ⊕ᵥ (-1 : Fin m → ℤˣ)) → ℂ :=
  Space.lift
    (pairThetaKer (stdSpace E (Fin m)).neg (signedSpace E (1 ⊕ᵥ -1 : Fin (2 * m) ⊕ Fin m → ℤˣ))
      (upsilonU1 ^ m) 1)
    (modDatum (stdSpace E (Fin m)).neg (signedSpace E (1 ⊕ᵥ -1)) (unitModulus E) 1
      (Fock.polyVector (realSigns E (homSigns (-1) (1 ⊕ᵥ -1)))
        (∏ τ : InfinitePlace E, variableMinor τ Sum.inr id ^ (2 * m)))) fun _ ↦ 1

variable {E}

/-- The function `𝖺(h) c(det h)` on the finite adelic points of `U(I_{n'})`: the class sum over
`U(I_m)` at the level `New.stdLevel` of the theta kernel with characters `c` and `1`, trivial
modulus, constant finite datum and polynomial `1`, taken at archimedean component `1` on both
groups. The coefficient `𝖺(h)` is the value for `c = 1`. -/
def carrierCoeff (c : AutChar E) (h : Gf E n') : ℂ :=
  stdClassSum (stdLevel E (Fin m))
    (modKernelStdSpace (n' := n') (stdSpace E (Fin m)) c 1 (unitModulus E) 1 1 ⟨1, ·⟩ h)

end New.Rows

/-!
## Moduli, index sets, polynomial and functions of the third exchange

The objects of the third exchange for admissible data `D` (`New.Data`), a tame character `ϑ`
(`New.Data.TameChar`) and an index `j`. The spaces `V″` and `V°` are the standard definite spaces
(all signs `+1`) on the index sets `New.Data.FirstFactorIndex` and `New.Data.SecondFactorIndex`.
-/

namespace New.Data

open Ideal Matrix Rows WeilData Fintype Sum LevelPlaces NumberField

variable {P : Parameters} (D : Data P)

/-- The modulus ϖ^c, the c-th power of the product of the chosen places above p₀, p₁. It is the
modulus `D.twistModulus` of the trivial character; the argument `false` leaves out the factor Q, the
product of the places of the character. -/
abbrev untwistedModulus : ℕ → Modulus D.E := fun c : ℕ ↦ D.twistModulus TameChar.one c false

lemma ideal_untwistedModulus_eq_span {c : ℕ} :
    (D.untwistedModulus c).ideal = span {D.piM ^ c} := by
  rw [← span_singleton_pow, span_piM]
  exact mul_one ((∏ i : (k : Fin 2) × D.ChosenPlace k, (D.chosenPlace i).asIdeal) ^ c)

instance : NeZero D.m := .of_gt D.ten_thousand_le_m

/-! ### Index sets and the numbering of the basis -/

/-- The index set with 2m + m elements, in two blocks, of the space S of signature (2m, m). -/
abbrev CarrierIndex : Type := Fin (2 * D.m) ⊕ Fin D.m

/-- The index set, with 6m + 1 elements, of the definite space W♭ = I_{6m+1}. -/
abbrev FlatIndex : Type := Fin (6 * D.m + 1)

/-- The index set of V°: the r indices of W_j and t − 9m − 1 − r further ones. -/
abbrev SecondFactorIndex : Type := D.RowIndex ⊕ Fin (D.t - 9 * D.m - 1 - D.r)

/-- The set of classes of U(V°) at principal level ϖ²: double cosets of U(V°)(𝔸_f) by the
rational points and the congruence subgroup modulo ϖ². -/
abbrev SecondFactorClasses : Type := StdClasses (principalLevel D.SecondFactorIndex (D.piM ^ 2))

/-- The inverse of the numbering `New.Data.basisNumber`: the index in `New.Data.RowIndex` that has
number min(i, r − 1). -/
def rowIndexOfNumber (i : ℕ) : D.RowIndex := D.basisNumber.symm ⟨i ⊓ (D.r - 1), by grind⟩

/-! ### Choices of classes and rows -/

/-- The part of a choice that lives on W♭ = I_{6m+1}: a class of U(W♭) at principal level ϖ² and,
for each infinite place, Δ′ lists of 2m row indices among 6m + 1. Here
Δ′ = `D.reducedHalfGap` = r⁸ − (t + 1)/2 is the size of the second block of `New.Data.DetIndex`:
the number of columns of the partition μ⁺ of the greatest height k + j − 1. -/
abbrev RowChoice : Type :=
  StdClasses (principalLevel D.FlatIndex (D.piM ^ 2)) ×
    (D.Φ → Fin D.reducedHalfGap → Fin (2 * D.m) → D.FlatIndex)

/-- A chosen invertible matrix over E whose rows lie in the lattice at the class `i.1` and whose
entries are small at every complex embedding (`New.Space.exists_short_basis_stdSpace`). -/
def shortRows (i : D.RowChoice) : Matrix D.FlatIndex D.FlatIndex (P.E D.towerExp) :=
  (Space.exists_short_basis_stdSpace P.conductor_mem_differentIdeal i.1.out).choose.valᵀ

variable {D} (ϑ : D.TameChar) (j : D.LiftIndex)

/-! ### Characters, padding, the polynomial and the functions `𝖥_i` -/

/-- The character χ′ = χ^j·ϑ of [U(1)], for the fixed weight-zero character χ of tame part ω and
a tame character ϑ. -/
def twistedChiMPow : AutChar D.E := D.chiM ^ j.val * ϑ.toAutChar

/-- The character `twistedChiMPow ϑ j = D.chiM ^ j * ϑ` has weight `0` at every infinite place. Its
tame part is `D.liftTamePart ϑ j = D.chiMLocal ^ j * ϑ.tamePart`, where `D.chiMLocal` is the tame
part of `D.chiM`. -/
lemma twistedChiMPow_hasWeight : (twistedChiMPow ϑ j).HasWeight 0 (D.liftTamePart ϑ j) := by
  simpa [twistedChiMPow, liftTamePart] using (D.chiM_hasWeight.zpow j).mul ϑ.hasWeight

/-- The index set of the padding I_j⁻ ⊕ I_{3m−j} of W_j: a block of j elements and a block of
2m + (m − j) elements. -/
abbrev PadIndex : Type := Fin j ⊕ Fin (2 * D.m + (D.m - j))

/-- The index set of V″ and of W′: the r indices of W_j, the padding `New.Data.PadIndex` and the
indices of W♭. -/
abbrev FirstFactorIndex : Type := (D.RowIndex ⊕ PadIndex j) ⊕ D.FlatIndex

/-- The signs of the padded space W_j ⊕ I_j⁻ ⊕ I_{3m−j}: those of W_j, then −1 on j indices and +1
on 2m + (m − j) indices. -/
abbrev padSigns : D.RowIndex ⊕ PadIndex j → ℤˣ := D.signsW j ⊕ᵥ (-1 ⊕ᵥ 1)

/-- The m chosen negative rows of the padded W_j: i < m goes to the i-th index of the padding block
of size j if i < j, and to `New.Data.rowIndexOfNumber`(k + i − 1) otherwise. -/
def negIndex (i : Fin D.m) : D.RowIndex ⊕ PadIndex j :=
  if hi : i.1 < j then inr (inl ⟨i, hi⟩) else inl (D.rowIndexOfNumber (D.posRank i))

/-- The 2m constant rows for a column of height h < r₊ = k + j − 1, all basis vectors: i < 2m goes
to the basis vector number h + i of W_j if h + i < r₊, and otherwise to index i of the positive
padding block. -/
def posRowIndex (h : ℕ) (i : Fin (2 * D.m)) : D.RowIndex ⊕ PadIndex j :=
  if h + i.1 < D.posRank j then inl (D.rowIndexOfNumber (h + ↑i)) else inr
    (inr (i.castAdd (D.m - j)))

/-- The j-th descent pair `New.Data.descentPair` at the trivial character: the data of the lift from
W_j to I_{r+t}, with a `numbering` of the basis vectors of W_j and the numbers `colsPlus τ h`,
`colsMinus τ h` of columns of height h of two partitions μ⁺, μ⁻ at each infinite place τ. -/
abbrev untwistedDescentPair : DescentPair D.E D.RowIndex (D.RowIndex ⊕ Fin D.t) :=
  D.descentPair TameChar.one j

/-- The index set of the determinants at the place τ, one for each column of the partition μ⁺.
Let r₊ = `D.posRank j` = k + j − 1, with k = r + 1 − m, be the number of plus signs of W_j. For each
height h < r₊ there are `(untwistedDescentPair j).colsPlus τ h` indices, the number of columns of
height h that the data of the j-th lift assign to μ⁺; for the height r₊ there are
Δ′ = `D.reducedHalfGap` indices. -/
abbrev DetIndex (τ : InfinitePlace D.E) : Type :=
  (Σ h : Fin (D.posRank j), Fin ((untwistedDescentPair j).colsPlus τ h)) ⊕ Fin D.reducedHalfGap

/-- The fixed polynomial P = ∏_τ det(y⁻_τ)^{e′(τ)} ∏_{h<k+j−1} det(y_{τ,h})^{k⁺(τ,h)}, with
e′(τ) = #`New.Data.DetIndex`(τ) + #`New.Data.FirstFactorIndex` + m and k⁺ the column counts
`colsPlus` of `New.Data.untwistedDescentPair`. Here y⁻_τ is the m × m block of variables in the rows
`New.Data.negIndex` and the negative columns, and y_{τ,h} the 2m × 2m block in the rows
`New.Data.posRowIndex` for h and the positive columns. -/
def paddedMinorProd :
    MvPolynomial (InfinitePlace D.E × (D.RowIndex ⊕ PadIndex j) × (Fin (2 * D.m) ⊕ Fin D.m)) ℂ :=
  ∏ τ : InfinitePlace D.E,
    variableMinor τ (negIndex j) inr ^ (card (DetIndex j τ) + card (FirstFactorIndex j) + D.m) *
      ∏ h : Fin (D.posRank j),
        variableMinor τ (posRowIndex j h) inl ^ (untwistedDescentPair j).colsPlus τ h

/-- The natural number j + ⌊(t + k − 1)/2⌋, the exponent of υ in `New.Data.firstFactorChar`. -/
abbrev firstFactorCharExp : ℕ := j + (D.t + D.k - 1) / 2

/-- The character μ♭·υ^{m + j + ⌊(t+k−1)/2⌋ − jΔ} of [U(1)]. Here μ♭ = `D.chiZero` is a fixed
character of weight −κ_0 = `-D.liftWeight 0` and trivial tame part, υ = `upsilonU1` has weight 1,
and Δ = `D.gap` = 2r⁸ is the difference κ_{j+1} − κ_j. It is ν♭·υ^m, where ν♭ = ν″/χ′ is the
quotient of `New.Data.firstFactorChar` by `New.Data.twistedChiMPow`, which is free of the twist. -/
def carrierChar : AutChar D.E := D.chiZero * upsilonU1 ^
  (↑(D.m + firstFactorCharExp j) - j * D.gap : ℤ)

/-- Let `j` with `1 ≤ j ≤ m` be the index of a lift. The character `carrierChar j` of `U(1)(𝔸)` has
weight `m + firstFactorCharExp j - κ_j` and trivial tame part, where `κ_j = D.liftWeight j`. -/
lemma carrierChar_hasWeight :
    (carrierChar j).HasWeight
      (fun σ : InfinitePlace D.E ↦ ↑(D.m + firstFactorCharExp j) - D.liftWeight j σ) 1 := by
  let upsilonExp : ℤ := ↑(D.m + firstFactorCharExp j) - j * D.gap
  have h_mul : (carrierChar j).HasWeight
      ((fun σ : D.Φ ↦ (-D.liftWeight 0 σ : ℤ)) + fun _ ↦ upsilonExp) (1 * 1) :=
    D.chiZero_hasWeight.mul (hasWeight_upsilonU1_zpow upsilonExp)
  -- the weights agree because `κ_j = κ_0 + j Δ`
  have liftWeight_eq (σ : D.Φ) : (D.liftWeight j σ : ℤ) = D.liftWeight 0 σ + j * D.gap := by grind
  simpa only [liftWeight_eq, upsilonExp, Pi.add_def, one_mul, ← sub_sub, neg_add_eq_sub,
    sub_right_comm] using h_mul

/-- The character ν″ = μ_j⁰ϑ·υ^{j + ⌊(t+k−1)/2⌋} of [U(1)], with μ_j⁰ϑ = `New.Data.liftChar` the
character of the j-th lift. -/
abbrev firstFactorChar : AutChar D.E := D.liftChar ϑ j * upsilonU1 ^ firstFactorCharExp j

/-- The choices: pairs of a 3m × rk V″ matrix Λ modulo ϖ² and an element of `New.Data.RowChoice`,
which is a class at level ϖ² of U(W♭) with selections of rows. -/
abbrev ChoiceIndex : Type :=
  Matrix D.CarrierIndex (FirstFactorIndex j) (D.untwistedModulus 2).ResidueRing × D.RowChoice

/-- The function `𝖥_i(g)` on `U(W_j)`, for a choice `i`: a matrix `Λ = i.1` modulo `ϖ²`, and a class
and rows `i.2`. It is the integral, for the measure `New.Space.quotMeasure` on the unitary group
of the space `S` of signature `(2m, m)` modulo its rational points, of the carrier
`New.Rows.carrierForm` times the theta kernel of `S` and `W′ = W_j ⊕ padding ⊕ W♭`, taken at
`(g, 1, h♭)` with `h♭` the representative of the class. The characters are `υ^m` and
`carrierChar j = ν♭ υ^m`, so the kernel is that with standard characters divided by `ν♭` on `U(S)`.
The finite datum is the additive character `traceChar Λ` of the matrices modulo `ϖ²`. The
polynomial is `P = New.Data.paddedMinorProd` on the padded `W_j` times the product of determinants
`P♭ = New.pairedDetProd` on `W♭`, which pairs the chosen rows of `New.Data.shortRows` with the
variables in the positive columns. -/
def choiceFn (i : ChoiceIndex j) (g : New.G D.E (D.signsW j)) : ℂ :=
  ∫ x : New.G D.E (1 ⊕ᵥ -1), carrierForm D.E D.m x *
    modKernel (signedSpace D.E (1 ⊕ᵥ -1))
      -- the second space, with index set `FirstFactorIndex j`
      (((D.spaceW j).sum
          ((stdSpace D.E (Fin j)).neg.sum (stdSpace D.E (Fin (2 * D.m + (D.m - j)))))).sum
        (stdSpace D.E D.FlatIndex))
      (upsilonU1 ^ D.m) (carrierChar j) (D.untwistedModulus 2) (traceChar i.1)
      (renameRowsCols inl id (paddedMinorProd j) * renameRowsCols inr id
        (pairedDetProd (fun τ r c ↦ MvPolynomial.X ⟨τ, r, inl c⟩) fun w k ↦
          ((D.shortRows i.2).map (Φ w)).submatrix (i.2.2 w k) id))
      x (G.sum (G.sum (g, 1), i.2.1.out)) ∂(signedSpace D.E (1 ⊕ᵥ -1)).quotMeasure

end New.Data

/-! ## Determinant count and character exponent at each infinite place -/

/-- Let `D` be admissible data, `1 ≤ j ≤ m` and `τ` an infinite place. The `j`-th lift goes from the
unitary group of `W_j`, of rank `r`, to the definite unitary group of rank `r + t`; its character
has weight `-κ_j` at `τ`, with `κ_j = D.liftWeight j τ`. The set `DetIndex j τ` has one element for
each column of the partition `μ⁺` that belongs to the plus signs of `W_j` at `τ`, so its cardinality
is the largest part `μ₁⁺`. Then `μ₁⁺ + firstFactorCharExp j = κ_j`, where
`firstFactorCharExp j = j + ⌊(t + k - 1) / 2⌋` with `t = D.t = 5 r` and `k = D.k = r + 1 - m`. -/
lemma New.Data.card_detIndex_add_firstFactorCharExp {P : Parameters} {D : Data P} (j : D.LiftIndex)
    (τ : D.Φ) : Fintype.card (DetIndex j τ) + firstFactorCharExp j = D.liftWeight j τ := by
  -- For `h < D.posRank j` the number of columns is `targetParameter τ (h - 1) - targetParameter τ h
  -- - 1` if `h ≠ 0` and `0` if `h = 0`; these are the successive differences of `shiftedParam`, so
  -- their sum telescopes.
  let shiftedParam (l : ℕ) : ℤ := D.targetParameter τ (l - 1) + (l ⊔ 1 : ℕ)
  have h_first : shiftedParam 0 = D.k / 2 := by grind [targetParameter_eq]
  have h_last : shiftedParam (D.posRank j) = D.k + j - 1 + D.halfGap - D.liftWeight j τ := by
    grind [targetParameter_eq]
  have h_diff (h : ℕ) (h_mem : h ∈ Finset.range (D.posRank j)) :
      ((untwistedDescentPair j).colsPlus τ h : ℤ) = shiftedParam h - shiftedParam (h + 1) := by
    grind [targetParameter_eq, descentPair]
  have h_card : Fintype.card (DetIndex j τ) =
      ∑ h ∈ Finset.range (D.posRank j), (untwistedDescentPair j).colsPlus τ h +
        D.reducedHalfGap := by
    simp [Finset.sum_range]
  -- `k` is even and positive
  have h_half : (D.t + D.k - 1) / 2 = (D.t + 1) / 2 + D.k / 2 - 1 := by grind
  zify [h_card]
  rw [Finset.sum_congr rfl h_diff, Finset.sum_range_sub', h_first, h_last]
  grind [reducedHalfGap]

namespace New.Data

/-!
## Order, kernel weight and gaps for the separation argument on W_j

Weights and numerical facts for the separation argument on the space `W_j`, whose signs are
`New.Data.signsW` and whose doubled parameter is `New.Data.paramW`; here `1 ≤ j ≤ m`.
-/

section SeparationWeights

open Fintype Int

variable {P : Parameters} (D : Data P)

/-- The natural number n_* = 2ft³, where f is the number of infinite places of E and t = 5r. -/
abbrev nStar : ℕ := D.f * (2 * D.t ^ 3)

/-- Twice the rank `r` of `W_j` is at most the real number `b = D.b`, the size parameter of the
weights `D.liftWeight j`. -/
lemma two_mul_r_le_b : 2 * D.r ≤ D.b := D.le_of_hasLogBound

/-- The number `300 n_* + t`, with `n_* = nStar D = 2 f t ^ 3`, is at most `D.halfGap = r ^ 8`. -/
lemma mul_nStar_add_t_le_halfGap : 300 * nStar D + D.t ≤ D.halfGap := D.nat_le_of_hasLogBound

lemma nStar_pos : 0 < nStar D := D.nat_le_of_hasLogBound

/-- The staircase weight at a column `c` of sign `s c = 1`. The staircase has `k η i` minors of
size `i` and sign `η`, the number `o c` is the place of `c` among the columns of its sign, and `γ`
is the shift. The weight is `γ` minus the number of minors of sign `+1` and size `i < card n` that
contain `c`, those with `o c < i`. -/
lemma _root_.New.staircaseWeight_of_eq_one {n r : Type} [Fintype n] {s : r → ℤˣ} {o : r → ℕ}
    {k : ℤˣ → ℕ → ℕ} {γ : ℤ} {c : r} (hc : s c = 1) :
    staircaseWeight n s o k γ c = γ - ∑ i ∈ .Ioo (o c) (card n), (k 1 i : ℤ) := by
  simp [hc, staircaseWeight, vacuumWeight]

/-- The staircase weight at a column `c` of sign `s c = -1`. The staircase has `k η i` minors of
size `i` and sign `η`, the number `o c` is the place of `c` among the columns of its sign, and `γ`
is the shift. The weight is `γ + card n` plus the number of minors of sign `-1` and size
`i < card n` that contain `c`, those with `o c < i`. -/
lemma _root_.New.staircaseWeight_of_eq_neg_one {n r : Type} [Fintype n] {s : r → ℤˣ} {o : r → ℕ}
    {k : ℤˣ → ℕ → ℕ} {γ : ℤ} {c : r} (hc : s c = -1) :
    staircaseWeight n s o k γ c = γ + card n + ∑ i ∈ .Ioo (o c) (card n), (k (-1) i : ℤ) := by
  simp [hc, staircaseWeight, vacuumWeight]

variable {D} (j : D.LiftIndex) (τ : D.Φ)

/-- The integer-valued order on the basis of W_j, for an index 1 ≤ j ≤ m of a lift. Let o(c) be
`(untwistedDescentPair j).numbering c`: the number `D.basisNumber c` for a positive vector c and
r − 1 − `D.basisNumber c` for a negative one. The order is −1 − o(c) on positive and o(c) on
negative vectors. Positive vectors come first, in reversed order. -/
def orderW (c : D.RowIndex) : ℤ :=
  if D.signsW j c = 1 then -1 - (untwistedDescentPair j).numbering c
  else (untwistedDescentPair j).numbering c

/-- The weight u of the conjugates of good forms: the highest weight of the lowest K-type
(`New.HCParam.lowestKType`) of the parameter with the signs of W_j and the negated doubled parameter
−`New.Data.paramW` at τ. -/
abbrev conjHolomorphicWeight : HCParam (D.signsW j) :=
  (toHCParam (D.signsW j) (-D.paramW τ)).lowestKType

/-- The weight u° on W_j of the kernel of the pair (W_j, V°), a `New.staircaseWeight`. Its diagram
in the negative letters is μ⁻ = `(untwistedDescentPair j).colsMinus τ`, that of the j-th descent
pair at τ. Its shift is j − ⌊m/2⌋. -/
def kernelWeight : D.RowIndex → ℤ :=
  staircaseWeight D.SecondFactorIndex (D.signsW j) (untwistedDescentPair j).numbering
    (Pi.single (-1) ((untwistedDescentPair j).colsMinus τ)) (-(D.m / 2 - j))

lemma kernelWeight_of_eq_one {c : D.RowIndex} (hc : D.signsW j c = 1) :
    kernelWeight j τ c = j - D.m / 2 := by
  simp [kernelWeight, staircaseWeight_of_eq_one hc]

/-- The kernel weight `kernelWeight j τ c` at a basis vector `c` of `W_j` with `D.signsW j c = -1`
is the sum of three terms. The first is the shift `j - D.m / 2`. The second is the rank
`card D.SecondFactorIndex` of `V°`. The third is the number of columns of μ⁻ of height `x` with
`numbering c < x < card D.SecondFactorIndex`. -/
lemma kernelWeight_of_eq_neg_one {c : D.RowIndex} (hc : D.signsW j c = -1) :
    kernelWeight j τ c = j - D.m / 2 + card D.SecondFactorIndex +
      ∑ x ∈ .Ioo ((untwistedDescentPair j).numbering c) (card D.SecondFactorIndex),
        ((untwistedDescentPair j).colsMinus τ x : ℤ) := by
  rw [kernelWeight, staircaseWeight_of_eq_neg_one hc, Pi.single_eq_same, neg_sub]

variable (D) in
/-- Six times the rank `r` of `W_j` is at most the largest rank `n_m = D.n m`. -/
lemma six_mul_r_le_n : 6 * D.r ≤ D.n D.m := D.nat_le_of_hasLogBound

variable (D) in
/-- The rank `k` of the source exceeds `100 m + 9`. -/
lemma hundred_mul_m_add_nine_lt_k : 100 * D.m + 9 < D.k := D.nat_lt_of_hasLogBound

variable (D) in
/-- The number `t = D.t` is five times the rank `r` of `W_j`. -/
lemma t_eq_five_mul_r : D.t = 5 * D.r := rfl

/-- The index set of `V″` has `r + 9 m + 1` elements: `r` for `W_j`, `3 m` for the padding and
`6 m + 1` for `W♭`. -/
lemma card_firstFactorIndex : card (FirstFactorIndex j) = D.r + 9 * D.m + 1 := by
  grind [card_sum, card_rowIndex, card_fin, j.2.2]

/-- Twice the sum of the number of determinants in the positive columns at `τ` (`DetIndex j τ`), the
rank of `V″` and `m` is at most `5 b`, with `b = D.b` the size parameter of the weights
`D.liftWeight j`. -/
lemma two_mul_card_detIndex_add_le :
    (2 * (card (DetIndex j τ) + card (FirstFactorIndex j) + D.m) : ℕ) ≤ 5 * D.b := by
  have le_liftWeight :
      card (DetIndex j τ) + card (FirstFactorIndex j) + D.m ≤ D.liftWeight j τ := by
    rw [← card_detIndex_add_firstFactorCharExp j τ, card_firstFactorIndex]
    grind
  grw [le_liftWeight]
  grind [liftWeight_le_two_mul_b]

/-- Let `D` be admissible data, `1 ≤ j ≤ m`, `τ` an infinite place and `W_j` the hermitian space
with signs `D.signsW j`. The weight `conjHolomorphicWeight j τ` on the basis of `W_j`, the highest
weight of the lowest `K`-type for the parameter `-D.paramW τ`, is the sum of two staircase weights.
Here `staircaseWeight n s o k γ` takes at a vector `c` the value `γ - N` if `s c = 1` and
`γ + card n + N` if `s c = -1`, with `N` the sum of `k (s c) i` over `o c < i < card n`. In both
weights `o` is the `numbering` of the vectors within each sign by `untwistedDescentPair j`, the data
of the lift from `W_j` to the definite space of rank `r + t`. The first has `n = FirstFactorIndex j`
of cardinality `r + 9 m + 1`, the column counts `colsPlus τ` in sign `+1`, none in sign `-1`, and
`γ = D.liftWeight j τ - firstFactorCharExp j`. The second, `kernelWeight j τ`, has
`n = D.SecondFactorIndex`, the column counts `colsMinus τ` in sign `-1` and `γ = j - ⌊m / 2⌋`. -/
lemma conjHolomorphicWeight_eq_add_kernelWeight {P : Parameters} {D : Data P} (j : D.LiftIndex)
    (τ : D.Φ) :
    conjHolomorphicWeight j τ =
      staircaseWeight (FirstFactorIndex j) (D.signsW j) (untwistedDescentPair j).numbering
          (Pi.single 1 ((untwistedDescentPair j).colsPlus τ))
          (-(firstFactorCharExp j + -D.liftWeight j τ)) +
        kernelWeight j τ := by
  -- By `lowestKType_eq_staircaseWeight` the left side is one staircase weight for
  -- `V_j = I_{r + t}`, whose sum runs up to the rank `r + t = 6 r`. The sums on the right stop at
  -- the ranks of `V″` and `V°`; the missing terms vanish.
  ext c
  set O : DescentPair D.E D.RowIndex (D.RowIndex ⊕ Fin D.t) := untwistedDescentPair j with hO
  have card_eq : card (D.RowIndex ⊕ Fin D.t) = 6 * D.r := by
    grind [card_rowIndex_sum_fin, t_eq_five_mul_r]
  have eq_staircaseWeight : conjHolomorphicWeight j τ c =
      staircaseWeight (D.RowIndex ⊕ Fin D.t) (D.signsW j) O.numbering
        (fun η : ℤˣ ↦ if η = 1 then O.colsPlus τ else O.colsMinus τ)
        (-((card (D.RowIndex ⊕ Fin D.t) / 2 : ℕ) + -D.liftWeight j τ)) c :=
    (D.fitsParams_descentPair .one j).lowestKType_eq_staircaseWeight τ c
  rw [eq_staircaseWeight, Pi.add_apply]
  obtain pos | neg := units_eq_one_or (D.signsW j c)
  · have cols_zero (x : ℕ) (hx : card (FirstFactorIndex j) ≤ x) : O.colsPlus τ x = 0 := by
      grind [descentPair, card_firstFactorIndex j]
    have h_sum : ∑ x ∈ .Ioo (O.numbering c) (card (FirstFactorIndex j)), (O.colsPlus τ x : ℤ) =
        ∑ x ∈ .Ioo (O.numbering c) (6 * D.r), (O.colsPlus τ x : ℤ) :=
      Finset.sum_subset (Finset.Ioo_subset_Ioo_right (by grind [card_firstFactorIndex j]))
        (by grind)
    simp only [staircaseWeight_of_eq_one pos, kernelWeight_of_eq_one j τ pos,
      Pi.single_eq_same, ite_true, h_sum, card_eq]
    grind
  · have card_small : card D.SecondFactorIndex = D.t - 9 * D.m - 1 := by
      grind [card_sum, card_fin, card_rowIndex]
    have cols_zero (x : ℕ) (hx : card D.SecondFactorIndex ≤ x) : O.colsMinus τ x = 0 := by
      grind [descentPair]
    have h_sum : ∑ x ∈ .Ioo (O.numbering c) (card D.SecondFactorIndex), (O.colsMinus τ x : ℤ) =
        ∑ x ∈ .Ioo (O.numbering c) (6 * D.r), (O.colsMinus τ x : ℤ) :=
      Finset.sum_subset (Finset.Ioo_subset_Ioo_right (by grind)) (by grind)
    simp only [staircaseWeight_of_eq_neg_one neg, kernelWeight_of_eq_neg_one j τ neg, ← hO, h_sum,
      Pi.single_eq_of_ne (units_ne_neg_self 1).symm, ite_eq_right (units_ne_neg_self 1).symm,
      card_eq, Pi.zero_apply, Finset.sum_const]
    grind [card_firstFactorIndex j]

/-- At a basis vector `c` of `W_j` of sign `+1`, the weight `conjHolomorphicWeight j τ` is the
integer `κ_j - firstFactorCharExp j + j - ⌊m / 2⌋` minus the number of columns of the partition `μ⁺`
whose height `x` lies strictly between the number of `c` and the cardinality `r + 9 m + 1` of
`FirstFactorIndex j`. Here `(untwistedDescentPair j).colsPlus τ x` counts the columns of `μ⁺` of
height `x`, `κ_j = D.liftWeight j τ`, and all subtractions are in `ℤ`. -/
lemma conjHolomorphicWeight_of_eq_one {c : D.RowIndex} (hc : D.signsW j c = 1) :
    conjHolomorphicWeight j τ c = D.liftWeight j τ - firstFactorCharExp j + (j - D.m / 2) -
      ∑ x ∈ .Ioo ((untwistedDescentPair j).numbering c) (card (FirstFactorIndex j)),
        ((untwistedDescentPair j).colsPlus τ x : ℤ) := by
  rw [conjHolomorphicWeight_eq_add_kernelWeight, Pi.add_apply, staircaseWeight_of_eq_one hc,
    kernelWeight_of_eq_one j τ hc, Pi.single_eq_same]
  ring

/-- At a basis vector `c` of `W_j` of sign `−1`, the weight `conjHolomorphicWeight j τ c` equals
`kernelWeight j τ c` plus `D.liftWeight j τ - firstFactorCharExp j + card (FirstFactorIndex j)`, an
amount that does not depend on `c`. -/
lemma conjHolomorphicWeight_of_eq_neg_one {c : D.RowIndex} (hc : D.signsW j c = -1) :
    conjHolomorphicWeight j τ c =
      D.liftWeight j τ - firstFactorCharExp j + card (FirstFactorIndex j) + kernelWeight j τ c := by
  rw [conjHolomorphicWeight_eq_add_kernelWeight, Pi.add_apply, staircaseWeight_of_eq_neg_one hc]
  simp [sub_eq_add_neg, add_comm]

/-- At a basis vector `c` of `W_j` of sign `−1` in `D.signsW j`, consider the sum of
`(untwistedDescentPair j).colsMinus τ x`, the number of columns of height `x` of `μ⁻`. The sum runs
over `x` strictly between `(untwistedDescentPair j).numbering c` and the cardinality of
`SecondFactorIndex`. It is at least `300 * nStar D`. -/
lemma mul_nStar_le_sum_colsMinus {c : D.RowIndex} (hc : D.signsW j c = -1) :
    300 * nStar D ≤ ∑ x ∈ .Ioo ((untwistedDescentPair j).numbering c) (card D.SecondFactorIndex),
      (untwistedDescentPair j).colsMinus τ x := by
  calc 300 * nStar D ≤ (untwistedDescentPair j).colsMinus τ (D.m - j) := by
        grind [descentPair, D.mul_nStar_add_t_le_halfGap]
    _ ≤ _ := Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _) <| by
        grind [descentPair, signsW, units_ne_neg_self, card_sum, card_fin]

/-- The entries of the weight `conjHolomorphicWeight j τ` are at most `5 b` in modulus, with
`b = D.b`. -/
lemma abs_conjHolomorphicWeight_le (c : D.RowIndex) :
    |(conjHolomorphicWeight j τ c : ℝ)| ≤ 5 * D.b := by
  -- The weight exceeds a bound for the parameter by at most the rank `r`.
  have param_le (a : D.RowIndex) : |(-D.paramW τ) a| ≤ (2 * D.liftWeight (D.m + 1) τ : ℕ) := by
    grind [Pi.neg_apply, paramW, targetParameter_eq]
  have liftWeight_le : D.liftWeight (D.m + 1) τ ≤ 2 * D.b :=
    D.liftWeight_le_two_mul_b (by grind) τ
  grw [← cast_abs, abs_lowestKType_le (D.hasGap_paramW _ τ).neg param_le, card_rowIndex]
  push_cast
  linarith [D.two_mul_r_le_b]

/-- For `1 ≤ j ≤ m` and an infinite place `τ`, the weight `kernelWeight j τ` on the basis of `W_j`
is `K`-dominant for the order `orderW j`. That is, on basis vectors of one sign `D.signsW j`, it
decreases weakly along this order. -/
lemma isKDominant_kernelWeight : IsKDominant (D.signsW j) (orderW j) (kernelWeight j τ) := by
  -- The weight is constant on positive vectors. On negative vectors it is a constant plus a
  -- staircase sum, which decreases as its starting point grows.
  intro a b h_sign h_order
  obtain pos | neg := units_eq_one_or (D.signsW j b)
  · rw [kernelWeight_of_eq_one j τ pos, kernelWeight_of_eq_one j τ (h_sign.trans pos)]
  · have numbering_lt :
        (untwistedDescentPair j).numbering a < (untwistedDescentPair j).numbering b := by
      simpa [orderW, neg, h_sign.trans neg] using h_order
    rw [kernelWeight_of_eq_neg_one j τ neg, kernelWeight_of_eq_neg_one j τ (h_sign.trans neg)]
    gcongr

/-- Let `1 ≤ j ≤ m`, let `τ` be an infinite place and `D.signsW j` the signs of the basis vectors of
the hermitian space `W_j`. The weight `conjHolomorphicWeight j τ` is `K`-dominant for the order
`orderW j`, which lists the basis vectors by decreasing `D.basisNumber` within each sign: it
decreases weakly along this order on vectors of one sign. -/
lemma isKDominant_conjHolomorphicWeight {P : Parameters} {D : Data P} (j : D.LiftIndex) (τ : D.Φ) :
    IsKDominant (D.signsW j) (orderW j) (conjHolomorphicWeight j τ) := by
  -- On positive vectors the weight is a constant minus a staircase sum; on negative vectors it is
  -- a constant plus the kernel weight.
  intro a b h_sign h_order
  show conjHolomorphicWeight j τ b ≤ conjHolomorphicWeight j τ a
  obtain pos | neg := units_eq_one_or (D.signsW j b)
  · have numbering_lt :
        (untwistedDescentPair j).numbering b < (untwistedDescentPair j).numbering a := by
      simpa [orderW, pos, h_sign.trans pos] using h_order
    rw [conjHolomorphicWeight_of_eq_one j τ pos,
      conjHolomorphicWeight_of_eq_one j τ (h_sign.trans pos)]
    gcongr
  · rw [conjHolomorphicWeight_of_eq_neg_one j τ neg,
      conjHolomorphicWeight_of_eq_neg_one j τ (h_sign.trans neg)]
    gcongr
    exact isKDominant_kernelWeight j τ a b h_sign h_order

/-- Every entry of the weight `kernelWeight j τ` at an index of sign `-1` in `D.signsW j` exceeds
every entry at an index of sign `+1` by at least `300 * nStar D`. -/
lemma hasHolGap_kernelWeight : HasHolGap (D.signsW j) (kernelWeight j τ) (300 * nStar D) := by
  intro a b pos neg
  have sum_ge : (300 * nStar D : ℤ) ≤ ∑ x ∈ .Ioo ((untwistedDescentPair j).numbering b)
      (card D.SecondFactorIndex), ((untwistedDescentPair j).colsMinus τ x : ℤ) :=
    mod_cast mul_nStar_le_sum_colsMinus j τ neg
  rw [kernelWeight_of_eq_one j τ pos, kernelWeight_of_eq_neg_one j τ neg]
  omega

/-- Every entry of the weight `conjHolomorphicWeight j τ` at a vector of sign `-1` exceeds every
entry at a vector of sign `+1` by at least `300 n_*`. Here `n_* = nStar D = 2 f t ^ 3`, with
`f = D.f` the number of infinite places of `D.E` and `t = D.t = 5 r` for the rank `r` of `W_j`. -/
lemma hasHolGap_conjHolomorphicWeight {P : Parameters} {D : Data P} (j : D.LiftIndex) (τ : D.Φ) :
    HasHolGap (D.signsW j) (conjHolomorphicWeight j τ) (300 * nStar D) := by
  -- `conjHolomorphicWeight - kernelWeight` is larger at negative than at positive vectors.
  intro a b pos neg
  have kernel_gap : kernelWeight j τ a + (300 * nStar D : ℕ) ≤ kernelWeight j τ b :=
    hasHolGap_kernelWeight j τ a b pos neg
  have sum_nonneg : 0 ≤ ∑ x ∈ .Ioo ((untwistedDescentPair j).numbering a)
      (card (FirstFactorIndex j)), ((untwistedDescentPair j).colsPlus τ x : ℤ) := by positivity
  rw [conjHolomorphicWeight_of_eq_one j τ pos, conjHolomorphicWeight_of_eq_neg_one j τ neg]
  rw [kernelWeight_of_eq_one j τ pos] at kernel_gap
  omega

variable {j}

/-- The order `orderW j` on the basis of `W_j` has distinct values and puts every vector of sign
`+1` before every vector of sign `−1` (`IsPosFirstOrder`). -/
lemma isPosFirstOrder_orderW : IsPosFirstOrder (D.signsW j) (orderW j) := by
  grind [IsPosFirstOrder, Function.Injective, D.basisNumber.injective, orderW, descentPair,
    units_ne_neg_self]

/-- If two basis vectors of W_j have the same sign under `New.Data.signsW` and the first comes
before the second in `New.Data.orderW`, then the doubled row parameter `New.Data.paramW` at τ is
smaller at the first. -/
lemma paramW_lt_of_orderW_lt (a b : D.RowIndex) (h_sign : D.signsW j a = D.signsW j b)
    (h_order : orderW j a < orderW j b) : D.paramW τ a < D.paramW τ b := by
  -- The parameter decreases strictly in `D.basisNumber`, and so does `orderW` on vectors of one
  -- sign.
  have number_lt : D.basisNumber b < D.basisNumber a := by grind [orderW, descentPair]
  rwa [paramW_lt_iff]

end SeparationWeights

/-!
## Places of the modulus of a twist and tameness of twisted characters

For a twist `ϑ` and `c ≠ 0`, the modulus `D.twistModulus ϑ c` is the `c`-th power of the product of
the chosen places (`New.Data.IsChosen`) times the product of the places in `ϑ.Q`.
-/

section TwistTameness

variable {P : Parameters} {D : Data P}

/-- The powers of `ϖ = D.piM` are not zero. -/
instance fact_piM_pow_ne_zero (c : ℕ) : Fact (D.piM ^ c ≠ 0) := ⟨by simp⟩

/-- For c ≠ 0 and a tame character ϑ, the finite places of E dividing the modulus
`D.twistModulus ϑ c` are exactly the chosen places (`New.Data.IsChosen`) together with the places in
the set Q of ϑ. -/
lemma places_twistModulus {c : ℕ} [NeZero c] (ϑ : D.TameChar) :
    (D.twistModulus ϑ c).places = {w : FinPlace D.E | D.IsChosen w} ∪ ϑ.Q := by
  simp [Rows.places_levelModulus, levelPlaces, range_chosenPlace]

/-- Let `ϑ` be a twist: a character of `U(1)(𝔸)` of weight `0` whose tame part, a family of
characters of the residue fields, is non-trivial exactly on the finite set of places `ϑ.Q`. Let
`c ≠ 0` and let `D.twistModulus ϑ c` be the `c`-th power of the product of the chosen places
`D.IsChosen` times the product of the places in `ϑ.Q`. Let `ν` be a character of `U(1)(𝔸)`, trivial
on rational points, of weight `γ` and tame part `ψ * ϑ.tamePart`, where `ψ` is non-trivial exactly
at the chosen places. Then `ν` is tame for this modulus: its tame part is non-trivial exactly at the
places dividing it. -/
lemma isTameFor_of_hasWeight {c : ℕ} [NeZero c] {ν : AutChar D.E}
    {γ : NumberField.InfinitePlace D.E → ℤ} {ψ : (w : FinPlace D.E) → MulChar (ResField w) ℂ}
    (ϑ : D.Twist) (hν : AutChar.HasWeight ν γ (ψ * ϑ.tamePart))
    (hψ : ∀ w : FinPlace D.E, ψ w ≠ 1 ↔ D.IsChosen w) :
    Exchange.IsTameFor (D.twistModulus ϑ c) ν γ
      (Modulus.charOfTamePart (D.twistModulus ϑ c) (ψ * ϑ.tamePart)) := by
  refine ⟨nonempty_modulus_places, ψ * ϑ.tamePart, hν, fun w ↦ ?_, rfl⟩
  -- `ψ` is non-trivial exactly at the chosen places, `ϑ.tamePart` exactly on `ϑ.Q`; these two sets
  -- are disjoint and their union is the support of the modulus.
  have ne_one_iff : ϑ.tamePart w ≠ 1 ↔ w ∈ ϑ.Q := by grind [Twist, TameChar]
  have not_chosen (hw : w ∈ ϑ.Q) : ¬D.IsChosen w := by
    grind [IsChosen, → normQ_mem_and_notMem_of_mem_Q]
  grind [places_twistModulus, Pi.mul_def]

/-- Let `j : D.LiftIndex`, that is `1 ≤ j ≤ m`, let `c ≠ 0` and let `ϑ` be a twist, ramified exactly
on the set of places `ϑ.Q`. The modulus `D.twistModulus ϑ c` is the `c`-th power of the product of
the chosen places times the product of the places in `ϑ.Q`. The character `twistedChiMPow ϑ j` =
χ^j·ϑ, with χ = `D.chiM` of tame part ω = `D.chiMLocal`, has weight 0 and ramifies exactly at the
places dividing this modulus, with the character ∏_w ω_w^j ϑ_w of the residue ring. -/
lemma isTameFor_twistedChiMPow {c : ℕ} [NeZero c] (j : D.LiftIndex) (ϑ : D.Twist) :
    Exchange.IsTameFor (D.twistModulus ϑ c) (twistedChiMPow ϑ j) 0
      (Modulus.charOfTamePart (D.twistModulus ϑ c) (D.liftTamePart ϑ j)) := by
  -- the tame part is `D.chiMLocal ^ j * ϑ.tamePart`, and `D.chiMLocal ^ j` is non-trivial exactly
  -- at the chosen places
  have h_weight := twistedChiMPow_hasWeight ϑ j
  unfold liftTamePart at h_weight ⊢
  exact isTameFor_of_hasWeight ϑ h_weight
    (chiMLocal_zpow_ne_one_iff_isChosen j (by grind) (by grind))

end TwistTameness

end New.Data

/-!
## Integral vectors with a monomial Fock polynomial

Here `X` is lift data from `U(1)` to a definite unitary group. For a monomial, an integral vector is
found whose Fock polynomial (`New.DescentPair.fockPoly` of `X.descentPair`) is a multiple of
that monomial.
-/

section MonomialCoefficientVector

open Nat Matrix Fintype MvPolynomial New Finset Function

/-- For each `τ` in `Φ` take variables in rows `n τ` and columns `ℕ`, and the partition with `κ τ h`
columns of height `h < rankAt n τ = card (n τ)`. The space `nablaFamily ℂ n κ` of polynomials that
are semi-invariant of this weight under the Borel subgroup acting on columns has the basis
`nablaBasis` of products of minors, one minor for each column. The map `toPoly` sends `ξ` to
`∑ i, (G ξ) i • nablaBasis i` with `G` the Gram matrix `weylGram`. If the monomial with exponent `δ`
is semi-invariant, then `toPoly` sends the vector of its coefficients in the basis polynomials to
the monomial times `hookNumber κ (rankAt n) / δ!`. -/
lemma New.toPoly_coeff_nablaBasis {Φ : Type} [Fintype Φ] [DecidableEq Φ] {n : Φ → Type}
    [∀ τ : Φ, Fintype (n τ)] [∀ τ : Φ, DecidableEq (n τ)] {κ : Φ → ℕ → ℕ}
    {δ : (Σ τ : Φ, n τ) × ℕ →₀ ℕ} (hδ : monomial δ (1 : ℂ) ∈ nablaFamily ℂ n κ) :
    toPoly n κ (Int.cast ∘ (·.coeff δ) ∘ nablaBasis ℤ n κ) =
      ((hookNumber κ (rankAt n) : ℂ) / δ.prod fun _ (k : ℕ) ↦ (k ! : ℂ)) • monomial δ (1 : ℂ) := by
  obtain ⟨ξ, hξ⟩ : ∃ ξ : WeylIndexFamily n κ → ℂ, toPoly n κ ξ = monomial δ 1 := range_toPoly.ge hδ
  rw [← hξ, ← map_smul]
  congr 1
  ext i
  -- pair `toPoly ξ` with `nablaBasis i`
  have pairing : fockPairing ℂ (toPoly n κ ξ) (nablaBasis ℂ n κ i) =
      hookNumber κ (rankAt n) * ξ i := fockPairing_toPoly_nablaBasis ξ i
  rw [hξ, fockPairing_monomial, ← map_nablaBasis (algebraMap ℤ ℂ), coeff_map] at pairing
  simpa [field, Finsupp.prod, prod_eq_zero_iff, factorial_ne_zero, mul_comm] using pairing

/-- Let `R` be a field of characteristic zero and `g τ` square matrices over `R`, one for each
`τ`. Suppose the substitution `y ↦ gᵀ y` of the rows of variables (`rowSubst`) fixes the monomial
with exponent `δ`. Then the Schur matrix `schur κ g` for the weight `κ` fixes the vector whose
entry at `i` is the coefficient of that monomial in the basis polynomial `nablaBasis R n κ i`, a
product of minors. -/
lemma New.schur_mulVec_coeff_nablaBasis {Φ : Type} [Fintype Φ] [DecidableEq Φ] {n : Φ → Type}
    [∀ τ : Φ, Fintype (n τ)] [∀ τ : Φ, DecidableEq (n τ)] {κ : Φ → ℕ → ℕ}
    {δ : (Σ τ : Φ, n τ) × ℕ →₀ ℕ} {R : Type} [Field R] [CharZero R]
    {g : (τ : Φ) → Matrix (n τ) (n τ) R}
    (hg : rowSubst (fun τ : Φ ↦ (g τ)ᵀ) (monomial δ 1) = monomial δ (1 : R)) :
    schur κ g *ᵥ ((·.coeff δ) ∘ nablaBasis R n κ) = (·.coeff δ) ∘ nablaBasis R n κ := by
  ext i
  have pairing : fockPairing R (monomial δ 1) (rowSubst g (nablaBasis R n κ i)) =
      fockPairing R (monomial δ 1) (nablaBasis R n κ i) := by
    simpa only [hg, transpose_transpose] using
      (fockPairing_rowSubst (fun τ : Φ ↦ (g τ)ᵀ) (monomial δ 1) _).symm
  -- expand the substitution by the Schur matrix and cancel the factorials
  rw [fockPairing_monomial, fockPairing_monomial, ← sum_schur_smul_nablaBasis (by simp)] at pairing
  simpa [coeff_sum, mulVec, dotProduct, factorial_ne_zero] using pairing

/-- Let `X` be lift data from `U(1)` to a definite unitary group with index set `n`. They give a
natural number `X.rowLength τ` for each infinite place `τ`, and the weight of the lift at `τ` is the
partition with one row of that length. Let `α` be the exponent of a monomial in `r` rows, placed in
`n` by `e`, of degree `X.rowLength τ` at each `τ`. Then there is an integer vector `v` such that
`fockPoly` of its complex conjugate is `∏_τ (X.rowLength τ)! / α!` times that monomial in the rows
`e`. Over every field of characteristic zero, `weylRep` fixes `v` under every family `g` whose
columns `e` are those of the identity. -/
theorem New.Rows.exists_int_weylRep_invariant_fockPoly_eq_smul_monomial {P : Parameters}
    {D : Data P} {n : Type}
    [Fintype n] [DecidableEq n] (X : LValueData D.E n) {r : ℕ} (e : Fin r ↪ n)
    {α : D.Φ × Fin r × Unit →₀ ℕ} (hα : ∀ τ : D.Φ, ∑ i : Fin r, α (τ, i, ()) = X.rowLength τ) :
    ∃ v : WeylIndex n (mixedWeight n X.descentPair.colsPlus X.descentPair.colsMinus) → ℤ,
      -- (a) the polynomial of `v` is a multiple of the monomial, moved to the rows `e`
      X.descentPair.fockPoly (star ((↑) ∘ v)) =
        ((∏ τ : D.Φ, (X.rowLength τ)!) / α.prod fun _ (k : ℕ) ↦ (k ! : ℂ)) •
          renameRowsCols e id (monomial α 1) ∧
      -- (b) `v` is fixed by every `g` whose columns `e` are those of `1`
      ∀ {R : Type} [Field R] [CharZero R] {g : D.Φ → GL n R},
        (∀ (τ : D.Φ) (a : Fin r) (b : n), (g τ).val b (e a) = if b = e a then 1 else 0) →
        weylRep (mixedWeight n X.descentPair.colsPlus X.descentPair.colsMinus)
          X.descentPair.detExp g *ᵥ ((↑) ∘ v) = (↑) ∘ v := by
  -- Let `δ` be the exponent of the monomial moved to the rows `e` and column `0`; the vector
  -- lists the coefficients of `δ` in the basis polynomials `nablaBasis`.
  let ι (c : D.Φ × n × Unit) : (Σ _ : D.Φ, n) × ℕ := (⟨c.1, c.2.1⟩, 0)
  have hι : Injective ι := fun c c' h ↦ by simpa [ι, Prod.ext_iff] using h
  let δ : (Σ _ : D.Φ, n) × ℕ →₀ ℕ := (α.mapDomain (Prod.map id (Prod.map e id))).mapDomain ι
  have prod_δ {M : Type} [CommMonoid M] (f : (Σ _ : D.Φ, n) × ℕ → ℕ → M) :
      δ.prod f = α.prod fun c k ↦ f (⟨c.1, e c.2.1⟩, 0) k :=
    (Finsupp.prod_mapDomain_index_inj hι).trans <|
      Finsupp.prod_mapDomain_index_inj (injective_id.prodMap (e.injective.prodMap injective_id))
  let κ : D.Φ → ℕ → ℕ := mixedWeight n X.descentPair.colsPlus X.descentPair.colsMinus
  refine ⟨(·.coeff δ) ∘ nablaBasis ℤ (fun _ ↦ n) κ, ?_, fun {R _ _ g} hg ↦ ?_⟩
  · -- the variables lie in column `0` and the degree at `τ` is `X.rowLength τ`, so the monomial is
    -- semi-invariant
    have mem : monomial δ (1 : ℂ) ∈ nablaFamily ℂ (fun _ ↦ n) κ := by
      refine mem_nabla.2 fun S _ _ b y ↦ ?_
      have weight_eq : (diagramWeight (rankAt fun _ ↦ n) κ).prod
          (fun p k ↦ b (p.1, p.2, p.2) ^ k) = α.prod fun c k ↦ b (c.1, 0, 0) ^ k := by
        -- `pow_add` applies before the exponents are simplified
        simp [κ, diagramWeight, X.one_lt_card, mixedWeight, ← hα,
          ← Finsupp.prod_finsetSum_index, prod_prod_type, ← prod_pow_eq_pow_sum, Pi.single_apply,
          ↓ pow_add]
      rw [weight_eq, aeval_monomial, aeval_monomial, prod_δ, prod_δ]
      simp [borelMul, mul_pow, mul_comm]
    have star_eq (v : WeylIndex n κ → ℤ) : star (Int.cast ∘ v) = (Int.cast ∘ v : _ → ℂ) := by
      ext; simp
    -- `fockPoly` is determined by `toPoly` through the injective renaming `ι`
    apply rename_injective ι hι
    rw [← X.toPoly_eq_rename_fockPoly, star_eq, toPoly_coeff_nablaBasis mem, prod_δ, map_smul,
      rename_monomial, rename_monomial]
    simp [κ, δ, X.hookNumber_eq_prod_factorial]
  · -- the transpose of `g` fixes the monomial, and `X.descentPair.detExp` vanishes
    have fixed : rowSubst (fun τ ↦ (g τ).val.transpose) (monomial δ 1) = monomial δ (1 : R) := by
      simp [monomial_eq, prod_δ, rowSubst, hg]
    have cast_eq : (Int.cast ∘ (·.coeff δ) ∘ nablaBasis ℤ (fun _ ↦ n) κ : WeylIndex n κ → R) =
        (·.coeff δ) ∘ nablaBasis R (fun _ ↦ n) κ :=
      funext fun i ↦ by simp only [comp_def, ← map_nablaBasis (Int.castRingHom R), coeff_map,
        eq_intCast]
    simpa [cast_eq, weylRep] using schur_mulVec_coeff_nablaBasis (κ := κ) fixed

end MonomialCoefficientVector

