/-!
# Tied traces and the dictionary at one auxiliary place

Forms of the base data `D` are taken at principal level at the auxiliary places `Q.place j`. Each
isotypic space `x` has a Galois representation `N x`. This is the twist of `x.galRep` by a character
`a` that is trivial at the tame generators. This file shows that the coefficients of the
characteristic polynomials of the `N x` lie in the Hecke algebra, and so does the indicator function
of the systems congruent to a given one. It defines traces as members of the Hecke algebra, and the
ideal of the tied relations. At one place it gives the dictionary between Galois elements and
operators on forms: the tame generator acts as a diamond operator, and the Frobenius element acts
through the polynomial `p(Ũ)` in a normalised Hecke operator.

## Main definitions and results

* `New.Patching.BaseLevel.charpoly_coeff_mem_heckeAlgebra`,
  `New.Patching.BaseLevel.exists_indicator_isCongruent`: the coefficients of characteristic
  polynomials, and the indicator function of the systems congruent to a given one, lie in the Hecke
  algebra.
* `New.Patching.BaseLevel.traceElement`, `New.Patching.BaseLevel.tiedIdeal`: traces as members of
  the Hecke algebra, and the ideal generated by the traces of the tied relations.
* `New.Patching.BaseLevel.tameTrace_smul_eq_diamond_sub_one`,
  `New.Patching.BaseLevel.tameTrace_smul_eq_aevalHecke`: operators on forms for the tame generator
  and for Frobenius.

Notions from other files:
* `New.Patching.BaseLevel.formsOfLevel`: the forms of the type fixed by `D` that have principal
  level at the places `L j` and maximal level at other places off `D.places` and its conjugate. The
  empty family `L = ![]` gives the base level.
* `New.Patching.BaseLevel.Eigensystem`, `New.Patching.BaseLevel.IsOffLevel`: the systems of level
  `L`, that is, the isotypic spaces (`New.Patching.Isotypic`, spaces of forms with given Hecke
  eigenvalues at almost all places) that contain a nonzero form of level `L`. For such an `x`,
  `(x : Isotypic V κ).val` is the space of forms. `w` is off level `L` if it lies off `D.places`,
  its conjugate and `ℓ`, and the forms of level `L` in each system are Hecke eigenforms at `w`.
* `New.Patching.BaseLevel.integralEnd`, `New.Patching.BaseLevel.localOperators`: the endomorphisms
  of the forms of level `L` that preserve the integral forms, and those among them that come from
  integral combinations of translations supported at `Q.place j` and its conjugate.
* `New.Patching.BaseLevel.heckeAlgebra`, `New.Patching.BaseLevel.heckeAction`: the `ℓ`-adic
  functions `t` on systems such that scaling each system `x` by `ιℓ.symm (t x)` preserves the
  integral forms, and the operator that such a function defines.
* `New.Patching.weightedSum`: `weightedSum ρ ind g = ∑ γ, g (ind γ) • ρ γ` for `g : ZMod m → ℤ`.

## Relation to the literature

See `New.Congruences.FirstOrder.AuxiliaryPrimeTie` for related work.
-/

open Pi Fintype Polynomial Nat Group Submodule ComplexOrder

attribute [local instance low] Fintype.ofFinite

-- Ring homomorphisms are additive and multiplicative: the direct instances are tried first.
attribute [local instance 1100] RingHomClass.toAddMonoidHomClass MonoidHomClass.toMulHomClass

namespace New.Patching.TaylorWilesPlaces

open Valued

variable {E J : Type} [Field E] [NumberField E] [NumberField.IsCMField E] [Algebra E Ω] {m : ℕ}

/-- A local choice at one auxiliary place `w = Q.place j`: a uniformiser `ϖ`, a unit `tameUnit` and
a logarithm `ind` on the units of the residue field, fitted to the Frobenius element `φ` and the
tame generator `γ` of the Frobenius datum `Q.frobData j`. Here `Q` is a family of places, no two
equal or conjugate, with `m ∣ q - 1` for the order `q` of each residue field. -/
structure LocalChoice (Q : TaylorWilesPlaces E J m) (j : J) where
  /-- A uniformiser that the local Artin map sends to the class of `φ`. -/
  ϖ : (LocField (Q.place j))ˣ
  /-- A unit that the local Artin map sends to the class of `γ`. -/
  tameUnit : (LocField (Q.place j))ˣ
  /-- The logarithm modulo `m` on the units of the residue field, to the base the residue of
  `tameUnit`. -/
  ind : (ResField (Q.place j))ˣ →* Multiplicative (ZMod m)
  /-- `ϖ` is a uniformiser. -/
  v_ϖ : v ϖ.1 = .exp (-1)
  /-- `tameUnit` is a unit of the ring of integers. -/
  v_tameUnit : v tameUnit.1 = 1
  /-- The Artin symbol of `ϖ` is the class of `φ`. -/
  localArtin_ϖ : localArtin Gal(Ω/E) (Q.frobData j).valuationSubring (Q.place j) ϖ =
    ⟦⟨(Q.frobData j).frob, inv_mem_iff.1 (Q.frobData j).isFrob_inv.1⟩⟧
  /-- The Artin symbol of `tameUnit` is the class of `γ`. -/
  localArtin_tameUnit : localArtin Gal(Ω/E) (Q.frobData j).valuationSubring (Q.place j) tameUnit =
    ⟦⟨(Q.frobData j).isPlaceOver.tameGenerator, (Q.frobData j).isPlaceOver.tameGenerator.2.1⟩⟧
  /-- The logarithm of the residue of `tameUnit` is `1`. -/
  ind_tameUnit : ind (residueUnit tameUnit) = .ofAdd 1

/-- Let `Q` be a family of auxiliary places: Frobenius data at finite places of `E`, no two places
equal or conjugate, with `m ∣ q - 1` for the order `q` of each residue field. Each place
`Q.place j` admits a local choice: a uniformiser and a unit whose Artin symbols are the classes of
the Frobenius element and of the tame generator, and a logarithm modulo `m` on the units of the
residue field, to the base the residue of that unit. -/
lemma nonempty_localChoice (Q : TaylorWilesPlaces E J m) (j : J) : Nonempty (Q.LocalChoice j) := by
  obtain ⟨z, z_tame⟩ : ∃ z : (LocField (Q.place j))ˣ, (Q.frobData j).isPlaceOver.IsTameUnit z :=
    (Q.frobData j).isPlaceOver.exists_isTameUnit
  obtain ⟨hz, art_z, gen_z, v_z⟩ := z_tame
  obtain ⟨ϖ, v_ϖ, art_ϖ⟩ := (Q.frobData j).isPlaceOver.exists_localArtin_eq
    (Q.frobData j).isFrob_inv 1
  obtain ⟨ind, h_ind⟩ : ∃ ind : (ResField (Q.place j))ˣ →* Multiplicative (ZMod m),
      ind (residueUnit z.1) = .ofAdd 1 := by
    have residue_eq : (LocInt (Q.place j)).unitGroupToResidueFieldUnits ⟨z, hz⟩ =
        residueUnit z.1 :=
      eq_residueUnit rfl rfl
    rw [← residue_eq]
    exact exists_residue_log (Q.dvd_q_sub_one j) gen_z
  exact ⟨ϖ, z, ind, v_ϖ, v_z, art_ϖ, art_z, h_ind⟩

namespace LocalChoice

variable {Q : TaylorWilesPlaces E J m} {j : J} (P : Q.LocalChoice j) {N : ℕ} [NeZero N]

/-- The logarithm `ind₁ g = ind g₁₁` of the first entry, on the stabiliser in `GL_N(𝔽_w)` of the
line of the first basis vector. -/
noncomputable abbrev indLine :
    residueLineStabilizer (ResField (Q.place j)) N →* Multiplicative (ZMod m) :=
  P.ind.comp firstEntry

/-- The logarithm `indDet = ind ∘ det` on `GL_N(𝔽_w)`. -/
noncomputable abbrev indDet : GL (Fin N) (ResField (Q.place j)) →* Multiplicative (ZMod m) :=
  P.ind.comp Matrix.GeneralLinearGroup.det

/-- The element `⟨γ⟩ = diag (z, 1, …, 1)` of `GL_N(𝔽_w)`, where `z` is the residue of
`P.tameUnit`. -/
noncomputable def diamond : GL (Fin N) (ResField (Q.place j)) :=
  diagGL (Pi.mulSingle 0 (residueUnit P.tameUnit))

/-- The transfer of `ind₁` from the stabiliser of the line to `GL_N(𝔽_w)` is `ind ∘ det`. -/
lemma transfer_indLine : (P.indLine (N := N)).transfer = P.indDet :=
  transfer_comp_firstEntry P.ind

lemma indDet_diamond : P.indDet (P.diamond (N := N)) = .ofAdd 1 := by
  rw [MonoidHom.comp_apply, show Matrix.GeneralLinearGroup.det (P.diamond (N := N)) =
    residueUnit P.tameUnit.1 from Units.ext (by simp [diamond, ← Units.coe_prod]), P.ind_tameUnit]

end LocalChoice

end New.Patching.TaylorWilesPlaces

namespace New.Patching.BaseLevel

set_option synthInstance.maxHeartbeats 200000

section BaseData

variable {ℓ : ℕ} [ThePrime ℓ] [PadicIso ℓ] {E : Type} [Field E] [CMType E]
  [Algebra E Ω] {n : Type} [Fintype n] [DecidableEq n]
  [Nonempty n] {V : Space E n 1} {κ : Weight E} {J : Type} [Fintype J] [DecidableEq J] {ν c : ℕ}
  {D : BaseLevel V κ c} (Q : TaylorWilesPlaces E J (ℓ ^ ν))

variable (D) in
/-- The action of the group `GL_n(𝔽_w)` at the auxiliary place `w = Q.place j` on the forms of
principal level. -/
noncomputable def placeRep (j : J) :
    GL (Fin (card n)) (ResField (Q.place j)) →* D.integralEnd Q.place :=
  (D.residueRep Q).comp (.mulSingle (fun i : J ↦ GL (Fin (card n)) (ResField (Q.place i))) j)

variable (D) in
/-- The action of the stabiliser of a line in `GL_n(𝔽_w)` at the auxiliary place `w = Q.place j`. -/
noncomputable def lineRep (j : J) :
    residueLineStabilizer (ResField (Q.place j)) (card n) →* D.integralEnd Q.place :=
  (D.placeRep Q j).comp (residueLineStabilizer (ResField (Q.place j)) (card n)).subtype

omit [Nonempty n] in
/-- If the auxiliary places `w j = Q.place j` are off the base level, the Hecke algebra commutes
with `D.residueRep Q`, the action of `∏ GL_n(𝔽_{w j})` on the forms of principal level. -/
lemma commute_heckeAction_residueRep (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j)) [V.IsStd]
    [WeilData E] (s : D.heckeAlgebra Q.place)
      (g : ∀ j : J, GL (Fin (card n)) (ResField (Q.place j))) :
    Commute (heckeAction s) (D.residueRep Q g) := by
  -- The elements that commute with `s` form a submonoid that contains each factor.
  suffices g ∈ (Submonoid.centralizer {heckeAction s}).comap (D.residueRep Q) by
    simpa [Submonoid.mem_centralizer_iff, commute_iff_eq] using this
  refine Submonoid.pi_mem_of_mulSingle_mem g fun j ↦ ?_
  simpa [Submonoid.mem_centralizer_iff, commute_iff_eq] using
    localOperators.commute_heckeAction (residueRep_mem_localOperators hQ (g j)) s

section Parahoric

variable {Q}

/-- Let the auxiliary places be off the base level. An element `k` of the parahoric subgroup
of the line in `GL_n(E_w)`, `w = Q.place j` (blocks of sizes `1` and `n - 1`), acts on forms of
principal level through its reduction, which stabilises the line. On the left, `localFormRep` is
the action of `GL_n(E_w)` on all forms; on the right, `lineRep` is that of the stabiliser. -/
lemma localFormRep_apply_eq_lineRep (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j)) [V.IsStd]
    [WeilData E] {j : J} {k : GL (Fin (card n)) (LocField (Q.place j))}
    (hk : k ∈ blockParahoric (min 1)) (y : D.formsOfLevel Q.place) :
    localFormRep V κ (Q.apart.star_ne j j) k y =
      (D.lineRep Q j ⟨reduceGL ⟨k, hk.1⟩, reduceGL_mem_residueLineStabilizer_iff.2 hk⟩).1 y :=
  (residueRep_mulSingle hQ ⟨k, hk.1⟩ y).symm

/-- Let `V` be the standard hermitian space (`IsStd`), let `E` carry Weil representation data
(`WeilData`), and let the auxiliary places be off the base level. If the elements of the stabiliser
of the line in `GL_n(𝔽_w)`, `w = Q.place j`, with first entry and determinant `1` fix a form `y` of
weight `κ`, then the pro-unipotent Iwahori subgroup `proIwahori` of `GL_n(E_w)` fixes it: `y` lies
in the space `levelSpace` of its fixed vectors for the action `localFormRep` of `GL_n(E_w)` on
forms. -/
lemma mem_levelSpace_proIwahori (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j)) [V.IsStd] [WeilData E]
    {j : J} {y : D.formsOfLevel Q.place}
    (hy : ∀ k : residueLineStabilizer (ResField (Q.place j)) (card n),
      firstEntry k = 1 → Matrix.GeneralLinearGroup.det k.1 = 1 →
      (D.lineRep Q j k).1 y = y) :
    y.1 ∈ levelSpace (localFormRep V κ (Q.apart.star_ne j j)).ρ proIwahori := by
  rintro ⟨g, hg_iw⟩
  have hg : g ∈ blockParahoric (min 1) := proIwahori_le_blockParahoric (by omega) hg_iw
  obtain ⟨det_one, entry_one⟩ :=
    det_firstEntry_reduceGL_eq_one_of_mem_proIwahori (g := ⟨g, hg.1⟩) hg_iw
  have fixed : localFormRep V κ (Q.apart.star_ne j j) g y = y :=
    (localFormRep_apply_eq_lineRep hQ hg y).trans
      (congrArg Subtype.val (hy _ (entry_one _) det_one))
  simpa using fixed

/-- Let `V` be the standard hermitian space, let `E` carry Weil representation data, let the
auxiliary places be off the base level, and let `P` be a local choice at `w = Q.place j`: it has a
logarithm `P.ind` modulo `ℓ ^ ν` on `𝔽_wˣ`, and `P.indLine g = P.ind g₁₁`. A form `y` of weight `κ`
on which the stabiliser of the line in `GL_n(𝔽_w)` acts by `ψ ∘ P.indLine` is fixed by `proIwahori`,
and the parahoric subgroup of the line in `GL_n(E_w)` acts on it by `k ↦ ψ (P.ind k₁₁)`. -/
lemma mem_parahoricEigenspace_line (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j)) [V.IsStd]
    [WeilData E]
    {j : J} (P : Q.LocalChoice j) (ψ : AddChar (ZMod (ℓ ^ ν)) ℂ) {y : D.formsOfLevel Q.place}
    (hy : ∀ k : residueLineStabilizer (ResField (Q.place j)) (card n),
      (D.lineRep Q j k).1 y = ψ (P.indLine k).toAdd • y) :
    y.1 ∈ parahoricEigenspace (localFormRep V κ (Q.apart.star_ne j j)) (min 1)
      ((fun s : LocField (Q.place j) ↦ ψ (P.ind (residueUnit s)).toAdd) ∘
        fun k : GL (Fin (card n)) (LocField (Q.place j)) ↦ k 0 0) := by
  refine ⟨mem_levelSpace_proIwahori hQ fun k entry_one _ ↦ by simp [hy, entry_one],
    fun k hk ↦ ?_⟩
  have entry : firstEntry ⟨reduceGL ⟨k, hk.1⟩, reduceGL_mem_residueLineStabilizer_iff.2 hk⟩ =
      residueUnit (k 0 0) :=
    firstEntry_reduceGL (g := ⟨k, hk.1⟩) _
  rw [localFormRep_apply_eq_lineRep hQ hk, hy, MonoidHom.comp_apply, entry]
  simp

/-- Let `V` be the standard hermitian space, let `E` carry Weil representation data, let the
auxiliary places be off the base level, and let `P` be a local choice at `w = Q.place j`: it has a
logarithm `P.ind` modulo `ℓ ^ ν` on `𝔽_wˣ`, and `P.indDet = P.ind ∘ det`. A form `y` of weight `κ`
on which `GL_n(𝔽_w)` acts by `ψ ∘ P.indDet` is fixed by `proIwahori`, and the maximal compact
subgroup of `GL_n(E_w)` (level function `0`) acts on it by `k ↦ ψ (P.ind (det k))`. -/
lemma mem_parahoricEigenspace_det (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j)) [V.IsStd]
    [WeilData E]
    {j : J} (P : Q.LocalChoice j) (ψ : AddChar (ZMod (ℓ ^ ν)) ℂ) {y : D.formsOfLevel Q.place}
    (hy : ∀ k : GL (Fin (card n)) (ResField (Q.place j)),
      (D.placeRep Q j k).1 y = ψ (P.indDet k).toAdd • y) :
    y.1 ∈ parahoricEigenspace (localFormRep V κ (Q.apart.star_ne j j)) 0
      fun k : GL (Fin (card n)) (LocField (Q.place j)) ↦ ψ (P.ind (residueUnit k.1.det)).toAdd := by
  refine ⟨mem_levelSpace_proIwahori hQ fun k _ det_one ↦ by simp [lineRep, hy, det_one],
    fun k hk ↦ ?_⟩
  have h_red : localFormRep V κ (Q.apart.star_ne j j) k y =
      (D.placeRep Q j (reduceGL ⟨k, hk.1⟩)).1 y :=
    (residueRep_mulSingle hQ ⟨k, hk.1⟩ y).symm
  have det_eq : Matrix.GeneralLinearGroup.det (reduceGL ⟨k, hk.1⟩) = residueUnit k.1.det :=
    det_reduceGL ⟨k, hk.1⟩
  rw [h_red, hy, MonoidHom.comp_apply, det_eq]
  simp

end Parahoric

/-! ### The Hecke algebra: characteristic polynomials, traces and the tied relations -/
section Traces

variable {N : Isotypic V κ → GalRep ℓ E n} {L : J → FinPlace E} [V.IsStd] [WeilData E]
  {a : Gal(Ω/E) →* EllAdicIntegers}

omit [Nonempty n] [DecidableEq J] [V.IsStd] in
/-- Let `w.place` be a place of prime norm that is off the level `L` of the base data `D`. The
function that sends a system of level `L` to its `j`-th Hecke eigenvalue at `w.place`, a complex
number moved to `PadicAlgCl ℓ` by the fixed isomorphism `ιℓ`, lies in the Hecke algebra, which is
a ring of such `ℓ`-adic functions on systems. -/
lemma heckeEigenvalues_mem_heckeAlgebra (w : FrobeniusDatum E) (hw : D.IsOffLevel L w.place)
    (j : ℕ) :
    (fun x : D.Eigensystem L ↦ ιℓ (x.val.heckeEigenvalues w.place j)) ∈ D.heckeAlgebra L := by
  obtain ⟨-, -, hℓ, h_sys⟩ := hw
  have h_split : w.place.IsSplit := isSplit_of_q_prime w.prime_q
  let T : Module.End ℂ (V.forms κ) := heckeSplit (V.formTranslation κ) h_split j
  let t (x : D.Eigensystem L) : PadicAlgCl ℓ := ιℓ (x.1.heckeEigenvalues w.place j)
  have h_op : D.formsOfLevel L ≤ T.eqLocus (diagOp t) := by
    refine formsOfLevel_le_of_eigensystem fun x f hf ↦ ?_
    have hf_eigen : f ∈ eigenformsAt V κ w.place (x.1.heckeEigenvalues w.place) := h_sys _ x.2 hf
    simp only [eigenformsAt, mem_iInf, mem_inf] at hf_eigen
    have hT : T f = x.1.heckeEigenvalues w.place j • f := (hf_eigen h_split).2 j
    simp [diagOp_apply t x hf.1, hT, t]
  -- `T` is supported at a place that is not above `ℓ`, so it keeps the integral forms.
  intro y hy
  have h_int : T y ∈ ellIntegralForms :=
    localGroupAlgebra_le_endPreserving hℓ (heckeFun_mem_localGroupAlgebra _ (.id _)) _ hy
  rwa [h_op y.2] at h_int

/-- For every isotypic space `x`, the representation `N x` is the twist of the Galois representation
`x.galRep` by the character `a` with values in the ℓ-adic integers. -/
def IsGalRepTwist (N : Isotypic V κ → GalRep ℓ E n) (a : Gal(Ω/E) →* EllAdicIntegers) : Prop :=
  ∀ (x : Isotypic V κ) (g : Gal(Ω/E)),
    (N x g).val = algebraMap EllAdicIntegers (PadicAlgCl ℓ) (a g) • (x.galRep g).val

omit [Nonempty n] [V.IsStd] [WeilData E] in
lemma IsGalRepTwist.coe_apply (hN : IsGalRepTwist N a) (x : Isotypic V κ) (g : Gal(Ω/E)) :
    (N x g).val = algebraMap EllAdicIntegers (PadicAlgCl ℓ) (a g) • (x.galRep g).val :=
  hN x g

omit [DecidableEq J] in
/-- Let `N x` be the twist of `x.galRep` by a character `a` with values in the ℓ-adic integers. Then
for every `g` and `i` the function sending a system `x` of level `L` to the `i`-th coefficient of
the characteristic polynomial of `N x g` lies in the Hecke algebra. -/
lemma charpoly_coeff_mem_heckeAlgebra (hN : IsGalRepTwist N a) (g : Gal(Ω/E)) (i : ℕ) :
    (fun x : D.Eigensystem L ↦ (N x g).val.charpoly.coeff i) ∈ D.heckeAlgebra L := by
  -- The twist multiplies the coefficient by a power of `a g`.
  simp_rw [hN.coe_apply, charpoly_smul_coeff]
  refine mul_mem (pow_mem (algebraMap_mem _ (a g)) _) ?_
  -- The untwisted coefficients are limits, along Frobenius elements near `g`, of coefficients of
  -- Hecke polynomials, and these are integers times eigenvalues.
  have h_lim (x : D.Eigensystem L) :
      (mostFrobeniiAt E g).Tendsto (fun w : FrobeniusDatum E ↦
        ιℓ ((x.1.heckePolyAt w.place).coeff i))
        (nhds ((x.1.galRep g).1.charpoly.coeff i)) := by
    obtain ⟨f, ⟨hf_mem, -⟩, hf_ne⟩ := x.2
    exact (Isotypic.attached_galRep hf_mem hf_ne).tendsto_charpoly_coeff g i
  suffices h_good : ∀ w : FrobeniusDatum E, D.IsOffLevel L w.place →
      (fun x : D.Eigensystem L ↦ ιℓ ((x.1.heckePolyAt w.place).coeff i)) ∈ D.heckeAlgebra L from
    isClosed_heckeAlgebra.mem_of_tendsto (tendsto_pi_nhds.2 h_lim)
      (Filter.mem_inf_of_left (eventually_mostFrobenii (D.eventually_isOffLevel (L := L)) h_good))
  intro w hw
  let m : ℤ := if i ≤ card n then (-1) ^ (card n - i) * w.place.q ^ (card n - i).choose 2 else 0
  have h_coeff (x : D.Eigensystem L) : ιℓ ((x.1.heckePolyAt w.place).coeff i) =
      m * ιℓ (x.1.heckeEigenvalues w.place (card n - i)) := by
    rw [coeff_heckePoly, map_mul, map_intCast]
  simp only [h_coeff]
  exact mul_mem (intCast_mem _ m) (heckeEigenvalues_mem_heckeAlgebra w hw (card n - i))

variable (N) in
/-- Two systems are congruent if the characteristic polynomials of their representations `N` agree
modulo the maximal ideal at every element of the Galois group. -/
def IsCongruent (x x' : Isotypic V κ) : Prop :=
  ∀ (g : Gal(Ω/E)) (i : ℕ), ‖(N x g).1.charpoly.coeff i - (N x' g).1.charpoly.coeff i‖ < 1

open Finset in
omit [DecidableEq J] in
/-- If `N` is the twist of the Galois representations by `a` (`IsGalRepTwist`) and the
characteristic polynomials of `N x` are integral for all systems `x` of level `L`, then the
indicator function of the systems congruent to `π` lies in the Hecke algebra. A case of the
decomposition of a finite algebra over a henselian local ring as a product of local rings (Stacks,
Tag 04GG), in which the idempotent of one congruence class is written down. -/
lemma exists_indicator_isCongruent (hN : IsGalRepTwist N a)
    (h_int : ∀ (x : D.Eigensystem L) (g : Gal(Ω/E)) (i : ℕ), ‖(N x g).val.charpoly.coeff i‖ ≤ 1)
    (π : Isotypic V κ) :
    ∃ A : D.heckeAlgebra L,
      (∀ x : D.Eigensystem L, IsCongruent N x π → A.val x = 1) ∧
      ∀ x : D.Eigensystem L, ¬IsCongruent N x π → A.val x = 0 := by
  -- For each `x'` not congruent to `π` choose a coefficient with incongruent values at `x'` and
  -- `π`, and subtract it from its value at `x'`. The product `sepProd` of these differences
  -- vanishes at all `x'` and has norm at least `1` at each congruent `x`. The indicator is
  -- `1 - ∏ (1 - sepProd / sepProd x)`.
  have separate (x' : {x : D.Eigensystem L // ¬IsCongruent N x.1 π}) : ∃ u : D.heckeAlgebra L,
      u.1 x'.1 = 0 ∧ ∀ x : D.Eigensystem L, IsCongruent N x.1 π → 1 ≤ ‖u.1 x‖ := by
    obtain ⟨g, i, h_far⟩ : ∃ (g : Gal(Ω/E)) (i : ℕ),
        1 ≤ ‖(N x'.1.1 g).1.charpoly.coeff i - (N π g).1.charpoly.coeff i‖ := by
      simpa [IsCongruent] using x'.2
    let b : EllAdicIntegers := ⟨(N x'.1.1 g).1.charpoly.coeff i, h_int x'.1 g i⟩
    let val : D.heckeAlgebra L :=
      ⟨fun x ↦ (N x.1 g).1.charpoly.coeff i, charpoly_coeff_mem_heckeAlgebra hN g i⟩
    have h_apart (x : D.Eigensystem L) (hx : IsCongruent N x.1 π) :
        1 ≤ ‖(N x'.1.1 g).1.charpoly.coeff i - (N x.1 g).1.charpoly.coeff i‖ := by
      by_contra! h_near
      refine h_far.not_gt ?_
      rw [← sub_add_sub_cancel _ ((N x.1 g).1.charpoly.coeff i)]
      exact (IsUltrametricDist.norm_add_le_max ..).trans_lt (max_lt h_near (hx g i))
    exact ⟨algebraMap EllAdicIntegers (D.heckeAlgebra L) b - val, sub_self _, h_apart⟩
  choose u u_zero u_unit using separate
  let sepProd : D.heckeAlgebra L := ∏ x', u x'
  have h_zero (x : D.Eigensystem L) (hx : ¬IsCongruent N x.1 π) : sepProd.1 x = 0 := by
    simpa [sepProd] using prod_eq_zero (mem_univ ⟨x, hx⟩) (u_zero _)
  have h_unit (x : D.Eigensystem L) (hx : IsCongruent N x.1 π) : 1 ≤ ‖sepProd.1 x‖ := by
    simpa [sepProd] using one_le_prod₀ fun x' _ ↦ u_unit x' x hx
  let Cong : Type := {x : D.Eigensystem L // IsCongruent N x.1 π}
  let inv (x : Cong) : EllAdicIntegers :=
    ⟨(sepProd.1 x.1)⁻¹, (norm_inv _).trans_le (inv_le_one_of_one_le₀ (h_unit x.1 x.2))⟩
  let A : D.heckeAlgebra L := 1 - ∏ y : Cong, (1 - inv y • sepProd)
  have A_apply (x : D.Eigensystem L) :
      A.1 x = 1 - ∏ y : Cong, (1 - (sepProd.1 y.1)⁻¹ * sepProd.1 x) := by
    simp [A, inv]
    rfl
  refine ⟨A, fun x hx ↦ ?_, fun x hx ↦ by simp [A_apply, h_zero x hx]⟩
  rw [A_apply, prod_eq_zero (mem_univ (⟨x, hx⟩ : Cong))
    (by simp [norm_pos_iff.1 (one_pos.trans_le (h_unit x hx))]), sub_zero]

/-- The trace `tr[P(h) g]`, the function `x ↦ tr (P(N x h) N x g)` on systems of level `L`, as a
member of the Hecke algebra. Here `N x` is the twist of `x.galRep` by the character `a`. -/
noncomputable def traceElement (hN : IsGalRepTwist N a) (P : EllAdicIntegers[X]) (h g : Gal(Ω/E)) :
    D.heckeAlgebra L :=
  ⟨fun x : D.Eigensystem L ↦ (aeval (N x.1 h).1 P * (N x.1 g).1).trace, by
    -- The trace is, up to sign, a coefficient of the characteristic polynomial.
    have trace_mem (g : Gal(Ω/E)) : (fun x : D.Eigensystem L ↦ (N x.1 g).1.trace) ∈
        D.heckeAlgebra L := by
      simpa [neg_def, ← Matrix.trace_eq_neg_charpoly_coeff] using
        neg_mem (charpoly_coeff_mem_heckeAlgebra hN g (card n - 1))
    -- Expand `P` in monomials: a linear combination of the traces at `h ^ k * g`.
    simpa [aeval_eq_sum_range, Finset.sum_mul, Finset.sum_fn] using
      sum_mem fun k _ ↦ (heckeAlgebra L).smul_mem (trace_mem (h ^ k * g)) (P.coeff k)⟩

/-- The trace `tr[(γ - 1) g P(φ)]` for the tame generator `γ` and the Frobenius element `φ` at
`Q.place j`, as a member of the Hecke algebra. -/
noncomputable def tameTrace (hN : IsGalRepTwist N a) (j : J) (P : EllAdicIntegers[X])
    (g : Gal(Ω/E)) : D.heckeAlgebra Q.place :=
  traceElement hN P (Q.frobData j).frob ((Q.frobData j).isPlaceOver.tameGenerator * g) -
    traceElement hN P (Q.frobData j).frob g

omit [DecidableEq J] in
/-- `tameTrace Q hN j 1 g` equals `traceElement hN (X - 1) γ g`: both are the trace `tr[(γ - 1) g]`
as a member of the Hecke algebra, where `γ` is the tame generator at `Q.place j`. -/
lemma tameTrace_one (hN : IsGalRepTwist N a) (j : J) (g : Gal(Ω/E)) :
    tameTrace (D := D) Q hN j 1 g =
      traceElement hN (X - 1) (Q.frobData j).isPlaceOver.tameGenerator g := by
  ext
  simp [tameTrace, traceElement, sub_mul]

/-- The ideal `𝔞` of `𝕋[α]` generated by the `ℓ ^ ν tr[g]` and the traces `tr[r j g]` of the tied
relations `r j = γ j - 1 - α j P j (φ j)`, where `𝕋` is the Hecke algebra, `P j = (X - 1) H j` and
`α j` are polynomial variables. Reading only the coefficients of the square-free monomials
`α_S = ∏_{j ∈ S} α j` has the effect of `α j ^ 2 = 0`. -/
noncomputable def tiedIdeal (hN : IsGalRepTwist N a) (H : J → EllAdicIntegers[X]) :
    Ideal (MvPolynomial J (D.heckeAlgebra Q.place)) :=
  Ideal.span {z : MvPolynomial J (D.heckeAlgebra Q.place) |
    ∃ g : Gal(Ω/E), z = ℓ ^ ν • .C (traceElement hN 1 1 g) ∨
    ∃ j : J, z = .C (traceElement hN (X - 1) (Q.frobData j).isPlaceOver.tameGenerator g) -
      .X j * .C (traceElement hN ((X - 1) * H j) (Q.frobData j).frob g)}

/-! ### One place: the dictionary between Galois elements and operators on forms -/

omit [Nonempty n] [DecidableEq J] [V.IsStd] [WeilData E] in
/-- Let a finite group `Γ` act through `ρ` by operators supported at the place `Q.place j`, let
`W = ∑ γ, weight (χ γ) • ρ γ` and `BW = B ∘ W`, and let `r`, `s` lie in the Hecke algebra. Suppose
that the weight is `f (· - shift) - root f`, and that `r x • z = s x • B z` for every form `z` of a
system `x` on which `Γ` acts by `ψ ∘ χ` for a character `ψ` with `ψ shift ≠ root`. Then
`W r = BW s`. -/
lemma weightedSum_mul_heckeAction_eq_of_eigen {j : J} {r s : D.heckeAlgebra Q.place} {Γ : Type*}
    [Group Γ] [Fintype Γ] {ρ : Γ →* D.integralEnd Q.place} {χ : Γ →* Multiplicative (ZMod (ℓ ^ ν))}
    {weight : ZMod (ℓ ^ ν) → ℤ} {BW : D.integralEnd Q.place}
    (shift : ZMod (ℓ ^ ν)) (root : ℂ) (B : D.formsOfLevel Q.place →ₗ[ℂ] V.forms κ)
    (hρ : ∀ γ : Γ, ρ γ ∈ D.localOperators Q j)
    (h_BW : ∀ y : D.formsOfLevel Q.place,
      (BW.val y : V.forms κ) = B ((weightedSum ρ χ weight).val y))
    (f : ZMod (ℓ ^ ν) → ℂ)
    (h_eigen : ∀ (x : D.Eigensystem Q.place) (ψ : AddChar (ZMod (ℓ ^ ν)) ℂ)
      (z : D.formsOfLevel Q.place), (z : V.forms κ) ∈ (x : Isotypic V κ).val →
      (∀ γ : Γ, (ρ γ).val z = ψ (χ γ).toAdd • z) → ψ shift ≠ root →
      ιℓ.symm (r.val x) • (z : V.forms κ) = ιℓ.symm (s.val x) • B z)
    (h_weight : ∀ x : ZMod (ℓ ^ ν), f (x - shift) - root * f x = weight x) :
    weightedSum ρ χ weight * heckeAction r = BW * heckeAction s := by
  -- Test on a form `y` of one system `x`. For F : Z/ℓ^ν → ℂ let T F be the sum of the terms
  -- (F (χ γ - shift) - root F (χ γ)) • ρ γ y; T f is the weighted sum applied to `y`. The claim is
  -- linear in F, so it may be checked on characters ψ, where T ψ is an eigenvector or zero.
  refine Subtype.ext (formEnd_ext fun x y hy ↦ Subtype.ext ?_)
  let T : (ZMod (ℓ ^ ν) → ℂ) →ₗ[ℂ] D.formsOfLevel Q.place :=
    ∑ γ : Γ, LinearMap.smulRight (.proj ((χ γ).toAdd - shift) - root • .proj (χ γ).toAdd :
      (ZMod (ℓ ^ ν) → ℂ) →ₗ[ℂ] ℂ) ((ρ γ).1 y)
  have hT (F : ZMod (ℓ ^ ν) → ℂ) :
      T F = ∑ γ : Γ, (F ((χ γ).toAdd - shift) - root * F (χ γ).toAdd) • (ρ γ).1 y := by simp [T]
  have hT_mem (F : ZMod (ℓ ^ ν) → ℂ) : (T F : V.forms κ) ∈ (x : Isotypic V κ).val := by
    have hρ_mem (γ : Γ) : ((ρ γ).val y : V.forms κ) ∈ (x : Isotypic V κ).val := by
      obtain ⟨⟨A, hA_local⟩, hA⟩ := hρ γ
      simpa [hA] using Isotypic.map_mem hA_local hy
    simp [hT, sum_mem, smul_mem, hρ_mem]
  -- Shifting the summation index by γ: T ψ is an eigenvector with character ψ⁻¹ ∘ χ.
  have hT_eigen (ψ : AddChar (ZMod (ℓ ^ ν)) ℂ) (γ : Γ) :
      (ρ γ).1 (T ψ) = ψ⁻¹ (χ γ).toAdd • T ψ := by
    rw [hT, map_sum, Finset.smul_sum]
    refine sum_equiv (.mulLeft γ) _ _ fun δ ↦ ?_
    simp [← ψ.map_add_eq_mul, smul_smul, mul_left_comm, mul_sub, add_sub]
  -- The weights of T ψ carry the factor ψ (-shift) - root.
  have hT_zero (ψ : AddChar (ZMod (ℓ ^ ν)) ℂ) (hψ : ψ⁻¹ shift = root) : T ψ = 0 := by
    simp [← hψ, hT, sub_eq_neg_add, ψ.map_add_eq_mul]
  -- The characters are a basis of the functions on Z/ℓ^ν.
  have key : ιℓ.symm (r.1 x) • (formsOfLevel Q.place).subtype ∘ₗ T = ιℓ.symm (s.1 x) • B ∘ₗ T := by
    refine (AddChar.complexBasis _).ext fun ψ ↦ ?_
    by_cases h₀ : T ψ = 0
    · simp [h₀]
    · simpa using h_eigen x ψ⁻¹ _ (hT_mem ψ) (hT_eigen ψ) (mt (hT_zero ψ) h₀)
  have hT_f : T f = (weightedSum ρ χ weight).1 y := by
    simp [hT, weightedSum, h_weight, Int.cast_smul_eq_zsmul]
  -- Both Hecke operators act on `y` by scalars.
  have h_scalar (t : D.heckeAlgebra Q.place) : (heckeAction t).val y = ιℓ.symm (t.val x) • y :=
    Subtype.ext (diagOp_apply t.val x hy)
  simpa [h_BW, hT_f, h_scalar] using LinearMap.congr_fun key f

end Traces

variable {Q} in
/-- The tame generator `γ` at `w = Q.place j` acts as a diamond operator. Let the auxiliary places
be off the base level, let `N x` be the twist of `x.galRep` by a character `a` trivial at the tame
generators, and let `P` be a local choice at `w`: a unit `P.tameUnit` of residue `z̄` and a
logarithm `P.ind` modulo `ℓ ^ ν` on `𝔽_wˣ` with `P.ind z̄ = 1`; put `P.indDet = P.ind ∘ det` and
`⟨γ⟩ = P.diamond = diag (z̄, 1, …, 1)`. On a form `y` of the system `x` on which `GL_n(𝔽_w)` acts by
`ψ ∘ P.indDet`, we have `tr[(γ - 1) g p(φ)] = (⟨γ⟩ - 1) tr[g p(φ)]`, where `φ` is the Frobenius
element and the traces are those of `N x`. -/
lemma tameTrace_smul_eq_diamond_sub_one (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j))
    {N : Isotypic V κ → GalRep ℓ E n} [V.IsStd] [WeilData E] {a : Gal(Ω/E) →* EllAdicIntegers}
    (hN : IsGalRepTwist N a) (ha : ∀ j : J, a (Q.frobData j).isPlaceOver.tameGenerator = 1)
    {j : J} (P : Q.LocalChoice j) (p : EllAdicIntegers[X]) (g : Gal(Ω/E))
    {x : D.Eigensystem Q.place} (ψ : AddChar (ZMod (ℓ ^ ν)) ℂ) {y : D.formsOfLevel Q.place}
    (hx : (y : V.forms κ) ∈ (x : Isotypic V κ).val)
    (hy : ∀ k : GL (Fin (card n)) (ResField (Q.place j)),
      (D.placeRep Q j k).val y = ψ (P.indDet k).toAdd • y) :
    ιℓ.symm ((tameTrace Q hN j p g).val x) • (y : V.forms κ) =
      ιℓ.symm ((traceElement hN p (Q.frobData j).frob g : D.heckeAlgebra Q.place).val x) •
        ((D.placeRep Q j P.diamond - 1).val y : V.forms κ) := by
  rcases eq_or_ne y 0 with rfl | y_ne
  · simp
  let θ : FrobeniusDatum E := Q.frobData j
  let γ : Gal(Ω/E) := θ.isPlaceOver.tameGenerator
  obtain ⟨-, -, hℓ, -⟩ := hQ j
  -- The matrix of `γ` is semisimple with the only eigenvalue `ιℓ (ψ 1)`, so it is scalar.
  have eigen : y.1 ∈ parahoricEigenspace (localFormRep V κ (Q.apart.star_ne j j)) 0
      fun k : GL (Fin (card n)) (LocField (Q.place j)) ↦
        ψ (P.ind (residueUnit k.1.det)).toAdd :=
    mem_parahoricEigenspace_det hQ P ψ hy
  have compat : IsParahoricCompatible (localFormRep V κ (Q.apart.star_ne j j)) y.1 P.ϖ
      (fun i : Fin (card n) ↦
        ψ (P.ind (residueUnit (diagGL (mulSingle i P.tameUnit)).1.det)).toAdd)
      (x.1.galRep θ.frob).1 (x.1.galRep γ).1 :=
    isParahoricCompatible_galRep θ.isPlaceOver P.v_ϖ P.localArtin_ϖ θ.isFrob_inv P.v_tameUnit
      P.localArtin_tameUnit (by simp) hℓ hx (coe_eq_zero.not.2 y_ne) 0 eigen (by simp)
  have killed : aeval (x.1.galRep γ).1 (X - C (ιℓ (ψ 1))) = 0 :=
    compat.aeval_inertia_eq_zero _ fun i ↦ by simp [← Units.coe_prod, P.ind_tameUnit]
  have scalar : (N x.1 γ).1 = ιℓ (ψ 1) • 1 := by
    simpa [hN.coe_apply, ha, γ, θ, sub_eq_zero, Algebra.algebraMap_eq_smul_one] using killed
  have trace_eq : (tameTrace Q hN j p g).1 x =
      (ιℓ (ψ 1) - 1) * (traceElement hN p θ.frob g : D.heckeAlgebra Q.place).1 x := by
    simp [tameTrace, traceElement, scalar, sub_mul, θ, γ]
  simp [trace_eq, hy, P.indDet_diamond, smul_sub, sub_smul, smul_smul, mul_sub, mul_comm, θ]

variable (V κ) {Q} in
/-- The polynomial `p(Ũ)` in the normalised operator `Ũ = a(φ) U`, where `U` is the Hecke operator
of `diag (ϖ, 1, …, 1)` for `proIwahori` at `Q.place j`, `ϖ = P.ϖ`, and `φ` is the Frobenius
element. -/
noncomputable abbrev aevalHecke {j : J} (P : Q.LocalChoice j) (a : Gal(Ω/E) →* EllAdicIntegers)
    (p : EllAdicIntegers[X]) : Module.End ℂ (V.forms κ) :=
  aeval
    (heckeCoset (localFormRep V κ (Q.apart.star_ne j j)).ρ proIwahori (diagGL (mulSingle 0 P.ϖ)))
    (p.comp (C (a (Q.frobData j).frob) * X))

end BaseData

variable {ℓ : ℕ} [ThePrime ℓ] [PadicIso ℓ] {E : Type} [Field E] [CMType E]
  [Algebra E Ω] {n : Type} [Fintype n] [DecidableEq n]
  [Nonempty n] {V : Space E n 1} {κ : Weight E} {J : Type} [Fintype J] [DecidableEq J] {ν c : ℕ}
  {D : BaseLevel V κ c} (Q : TaylorWilesPlaces E J (ℓ ^ ν)) {N : Isotypic V κ → GalRep ℓ E n}
  [V.IsStd] [WeilData E] {a : Gal(Ω/E) →* EllAdicIntegers}

section OnePlace

variable {Q} {j : J}

/-- Dictionary for the Frobenius element `φ`. Let the auxiliary places be off the base level (`hQ`),
let `N x` be the twist of `x.galRep` by `a` (`hN`), let `a` be `1` at the tame generators (`ha`),
and let `P` be a local choice at `w = Q.place j`, with uniformiser `ϖ` and logarithm `P.ind` modulo
`ℓ ^ ν` on `𝔽_wˣ`; put `P.indLine g = P.ind g₁₁`. If the stabiliser of a line in `GL_n(𝔽_w)` acts on
a form `y` of the system `x` through `ψ ∘ P.indLine`, where `ψ ((card n)!) ≠ 1`, then
`tr[(γ - 1) g p(φ)] = p(Ũ) tr[(γ - 1) g]` on `y`. Here `γ` is the tame generator at `w`,
`tr[(γ - 1) g p(φ)]` is `tameTrace`, and `p(Ũ)` is `aevalHecke`, for `Ũ = a(φ) U` with `U` the Hecke
operator of `diag (ϖ, 1, …, 1)` for the pro-unipotent Iwahori subgroup. -/
lemma tameTrace_smul_eq_aevalHecke (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j))
    (hN : IsGalRepTwist N a) (ha : ∀ j : J, a (Q.frobData j).isPlaceOver.tameGenerator = 1)
    (P : Q.LocalChoice j) (p : EllAdicIntegers[X]) (g : Gal(Ω/E))
    {x : D.Eigensystem Q.place} {ψ : AddChar (ZMod (ℓ ^ ν)) ℂ} (hψ : ψ (card n)! ≠ 1)
    {y : D.formsOfLevel Q.place} (hx : (y : V.forms κ) ∈ (x : Isotypic V κ).val)
    (hy : ∀ k : residueLineStabilizer (ResField (Q.place j)) (card n),
      (D.lineRep Q j k).val y = ψ (P.indLine k).toAdd • y) :
    ιℓ.symm ((tameTrace Q hN j p g).val x) • (y : V.forms κ) =
      ιℓ.symm ((tameTrace Q hN j 1 g).val x) • aevalHecke V κ P a p (y : V.forms κ) := by
  let θ : FrobeniusDatum E := Q.frobData j
  obtain ⟨-, -, hℓ, -⟩ := hQ j
  have large_order : ψ (P.ind (residueUnit P.tameUnit)).toAdd ^ (card n)! ≠ 1 := by
    simp [P.ind_tameUnit, hψ, ← ψ.map_nsmul_eq_pow]
  let pTwist : EllAdicIntegers[X] := p.comp (C (a θ.frob) * X)
  let T : Matrix n n (PadicAlgCl ℓ) := (x.1.galRep θ.isPlaceOver.tameGenerator).1 - 1
  have iota_comp : ιℓ.toRingHom.comp (algebraMap EllAdicIntegers ℂ) = algebraMap _ _ :=
    RingHom.ext iota_ell_algebraMap
  -- In traces against `T`, polynomials in `U` on `y` act like those in the Frobenius matrix.
  have frob : ιℓ.symm (T * (N x.1 g).1).trace • aevalHecke V κ P a p y.1 =
      ιℓ.symm (aeval (x.1.galRep θ.frob).1 pTwist * T * (N x.1 g).1).trace • y.1 := by
    simpa only [map_map, iota_comp, aeval_map_algebraMap] using
      hecke_eq_frob_on_parahoricEigenspace θ.isPlaceOver P.v_ϖ P.localArtin_ϖ θ.isFrob_inv
        P.v_tameUnit
        P.localArtin_tameUnit (by simp) hℓ hx (fun s ↦ ψ (P.ind (residueUnit s)).toAdd)
        (ψ.val_isUnit _).ne_zero large_order (pTwist.map (algebraMap _ ℂ))
        (mem_parahoricEigenspace_line hQ P ψ hy)
  have hN_tame : (N x.1 θ.isPlaceOver.tameGenerator).1 = T + 1 := by simp [hN.coe_apply, ha, θ, T]
  simpa [θ, pTwist, tameTrace, traceElement, hN_tame, hN.coe_apply x.1 θ.frob, mul_add, add_mul,
    mul_assoc, aeval_comp, ← Algebra.smul_def] using frob.symm

/-- The dictionary for the tame generator `γ` at `w = Q.place j` on weighted norms. Let the
auxiliary places be off the base level (`hQ`), let `N x` be the twist of `x.galRep` by `a` (`hN`),
let `a` be `1` at the tame generators (`ha`), and let `P` be a local choice at `w`, whose
logarithm `P.ind` on `𝔽_wˣ` gives `P.indDet = P.ind ∘ det` with values modulo `ℓ ^ ν`. If `L` is
the norm over `GL_n(𝔽_w)` with weight `f ∘ P.indDet`, then
`L tr[(γ - 1) g p(φ)] = (⟨γ⟩ - 1) L tr[g p(φ)]`, where `φ` is the Frobenius element at `w`,
`⟨γ⟩ = P.diamond`, and the traces are `tameTrace` and `traceElement`. -/
lemma weightedSum_indDet_mul_tameTrace (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j))
    (hN : IsGalRepTwist N a) (ha : ∀ j : J, a (Q.frobData j).isPlaceOver.tameGenerator = 1)
    (P : Q.LocalChoice j) (p : EllAdicIntegers[X]) (g : Gal(Ω/E)) (f : ZMod (ℓ ^ ν) → ℤ) :
    weightedSum (D.placeRep Q j) P.indDet f * heckeAction (tameTrace Q hN j p g) =
      (D.placeRep Q j P.diamond - 1) * weightedSum (D.placeRep Q j) P.indDet f *
        heckeAction (traceElement hN p (Q.frobData j).frob g) := by
  have placeRep_mem (k : GL (Fin (card n)) (ResField (Q.place j))) :
      D.placeRep Q j k ∈ D.localOperators Q j :=
    residueRep_mem_localOperators hQ _
  let B : D.formsOfLevel Q.place →ₗ[ℂ] V.forms κ :=
    (formsOfLevel _).subtype ∘ₗ (D.placeRep Q j P.diamond - 1).1
  -- It suffices to compare the traces on eigenvectors, where `γ` acts as the diamond element.
  have dict (x : D.Eigensystem Q.place) (ψ : AddChar (ZMod (ℓ ^ ν)) ℂ)
      (z : D.formsOfLevel Q.place) (hz : (z : V.forms κ) ∈ (x : Isotypic V κ).val)
      (hz_eigen : ∀ k : GL (Fin (card n)) (ResField (Q.place j)),
        (D.placeRep Q j k).val z = ψ (P.indDet k).toAdd • z) :
      ιℓ.symm ((tameTrace Q hN j p g).val x) • (z : V.forms κ) =
        ιℓ.symm ((traceElement hN p (Q.frobData j).frob g : D.heckeAlgebra Q.place).val x) • B z :=
    tameTrace_smul_eq_diamond_sub_one hQ hN ha P p g ψ hz hz_eigen
  exact weightedSum_mul_heckeAction_eq_of_eigen Q (shift := 0) (root := 0) (B := B) placeRep_mem
    (fun _ ↦ rfl) (f := fun s ↦ (f s : ℂ))
    (fun x ψ z hz hz_eigen _ ↦ dict x ψ z hz hz_eigen) (by simp)

/-- Let the auxiliary places be off the base level (`hQ`), and let `N x` be the twist of `x.galRep`
by `a`, which is `1` at the tame generators (`hN`, `ha`). The norm over `GL_n(𝔽_w)` at
`w = Q.place i` kills `tr[(γ - 1) g]`, where `γ` is the tame generator at `w` and `traceElement` is
the trace of the `N x` as an element of the Hecke algebra. -/
lemma norm_mul_traceElement_tameGenerator_eq_zero (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j))
    (hN : IsGalRepTwist N a) (ha : ∀ j : J, a (Q.frobData j).isPlaceOver.tameGenerator = 1)
    (i : J) (g : Gal(Ω/E)) :
    (∑ k : GL (Fin (card n)) (ResField (Q.place i)), D.residueRep Q (mulSingle i k)) *
      heckeAction (traceElement hN (X - 1) (Q.frobData i).isPlaceOver.tameGenerator g) = 0 := by
  obtain ⟨P⟩ := Q.nonempty_localChoice i
  -- The dictionary for `p = 1` and the weight `1`; the diamond element fixes the norm.
  have dict := weightedSum_indDet_mul_tameTrace hQ hN ha P 1 g 1
  rwa [weightedSum_one, sub_one_mul, mul_sum_monoidHom, sub_self, zero_mul, tameTrace_one] at dict

/-- Let the auxiliary places be off the base level and `w = Q.place j`. The norm over the stabiliser
of a line in `GL_n(𝔽_w)` (acting by `lineRep`) with weight `f ∘ P.indLine` has values fixed by the
pro-unipotent Iwahori subgroup of `GL_n(E_w)`. -/
lemma weightedSum_indLine_mem_levelSpace (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j))
    (P : Q.LocalChoice j) (f : ZMod (ℓ ^ ν) → ℤ) (y : D.formsOfLevel Q.place) :
    ((weightedSum (D.lineRep Q j) P.indLine f).val y : V.forms κ) ∈
      levelSpace (localFormRep V κ (Q.apart.star_ne j j)).ρ proIwahori :=
  mem_levelSpace_proIwahori hQ fun k hk _ ↦ by
    change (D.lineRep Q j k * weightedSum (D.lineRep Q j) P.indLine f).1 y = _
    rw [mul_weightedSum]
    simp [hk]

/-- Let the auxiliary places be off the base level and let `P` be a local choice at
`w = Q.place j`, with uniformiser `P.ϖ` and a logarithm modulo `ℓ ^ ν` on `𝔽_wˣ`, read on the first
entry as `P.indLine`. Let `L f` be the norm over the stabiliser of a line in `GL_n(𝔽_w)` with weight
`f ∘ P.indLine`, and let `a` be a character of the Galois group with values in the ℓ-adic integers.
There is an additive map `B` from weights to integral operators made of translates at `w`
(`localOperators`) with `B f = p(Ũ) L f`. Here `p(Ũ)` is `aevalHecke`, with `Ũ = a(φ) U` for the
Frobenius element `φ` and the Hecke operator `U` of `diag (P.ϖ, 1, …, 1)`. -/
lemma exists_aevalHecke_weightedSum (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j))
    (P : Q.LocalChoice j) (p : EllAdicIntegers[X]) :
    ∃ B : (ZMod (ℓ ^ ν) → ℤ) →+ D.integralEnd Q.place,
      (∀ f : ZMod (ℓ ^ ν) → ℤ, B f ∈ D.localOperators Q j) ∧
      ∀ (f : ZMod (ℓ ^ ν) → ℤ) (y : D.formsOfLevel Q.place), ((B f).val y : V.forms κ) =
        aevalHecke V κ P a p ((weightedSum (D.lineRep Q j) P.indLine f).val y) := by
  have exists_op (f : ZMod (ℓ ^ ν) → ℤ) : ∃ b ∈ D.localOperators Q j, ∀ y : D.formsOfLevel Q.place,
      (b.1 y).1 = aevalHecke V κ P a p ((weightedSum (D.lineRep Q j) P.indLine f).1 y).1 := by
    have norm_mem : weightedSum (D.lineRep Q j) P.indLine f ∈ D.localOperators Q j :=
      sum_mem fun k _ ↦ zsmul_mem (residueRep_mem_localOperators hQ k.1) _
    exact exists_localOperators_aeval_hecke hQ norm_mem (diagGL (mulSingle 0 P.ϖ))
      (p.comp (C (a (Q.frobData j).frob) * X)) (weightedSum_indLine_mem_levelSpace hQ P f)
  choose B B_mem B_apply using exists_op
  have B_add (f f' : ZMod (ℓ ^ ν) → ℤ) : B (f + f') = B f + B f' := by
    ext
    simp [B_apply]
  exact ⟨.mk' B B_add, B_mem, B_apply⟩

variable {P : Q.LocalChoice j} {p : EllAdicIntegers[X]}
  {B : (ZMod (ℓ ^ ν) → ℤ) →+ D.integralEnd Q.place}

/-- Let the auxiliary places be off the base level (`hQ`), and let `N x` be the twist of `x.galRep`
by `a`, which is `1` at the tame generators (`hN`, `ha`). Fix an index `j` and a local choice `P`
at `Q.place j`, with tame generator `γ` and Frobenius element `φ`. Let `B f` be `p(Ũ)`
(`aevalHecke V κ P a p`: forms on `V` of weight `κ`, `Ũ = a(φ) U`, `U` the Hecke operator of
`diag (P.ϖ, 1, …, 1)`) after the norm over the stabiliser of the line with weight `f ∘ P.indLine`
(`hB`). Then `p(Ũ) L tr[(γ - 1) g]` and `L tr[(γ - 1) g p(φ)]` have the same image under a ring map
`σ` on `𝒜 = D.integralEnd Q.place` that kills each `T` with `2 (card n)! T ∈ ℓ ^ ν 𝒜` (`hσ`).
The traces are `tameTrace`, and `L` is the norm whose weight is the logarithm `P.indLine` lifted to
`ℤ` by `valMinAbs`. -/
lemma map_aevalHecke_valMinAbs_mul_tameTrace (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j))
    (hN : IsGalRepTwist N a) (ha : ∀ j : J, a (Q.frobData j).isPlaceOver.tameGenerator = 1)
    (hB : ∀ (f : ZMod (ℓ ^ ν) → ℤ) (y : D.formsOfLevel Q.place), ((B f).val y : V.forms κ) =
      aevalHecke V κ P a p ((weightedSum (D.lineRep Q j) P.indLine f).val y))
    {R : Type*} [Ring R] {σ : D.integralEnd Q.place →+* R}
    (hσ : IsReductionMod σ (ℓ ^ ν) (2 * (card n)!)) (g : Gal(Ω/E)) :
    σ (B ZMod.valMinAbs * heckeAction (tameTrace Q hN j 1 g)) =
      σ (weightedSum (D.lineRep Q j) P.indLine ZMod.valMinAbs *
        heckeAction (tameTrace Q hN j p g)) := by
  -- `ℰ f` is the difference of the two operators, taken at the weight `f`. The operator
  -- `p(Ũ) tr[(γ - 1) g] - tr[(γ - 1) g p(φ)]` vanishes on the eigenforms of the stabiliser for the
  -- characters `ψ ∘ P.indLine` with `ψ (n!) ≠ 1`. Their sum contains the values of the weighted
  -- norms for the weights `f (· - n!) - f`, so `ℰ` vanishes at these weights.
  let ℰ : (ZMod (ℓ ^ ν) → ℤ) →+ D.integralEnd Q.place :=
    (AddMonoidHom.mulRight (heckeAction (tameTrace Q hN j 1 g))).comp B -
      (AddMonoidHom.mulRight (heckeAction (tameTrace Q hN j p g))).comp
        (weightedSum (D.lineRep Q j) P.indLine)
  rw [← sub_eq_zero, ← σ.map_sub]
  refine map_valMinAbs_eq_zero_of_shift hσ ℰ fun f ↦ sub_eq_zero.2 (Eq.symm ?_)
  -- The eigenvectors to be tested are those with `ψ (n!) ≠ 1`, where the dictionary applies.
  have lineRep_mem (k : residueLineStabilizer (ResField (Q.place j)) (card n)) :
      D.lineRep Q j k ∈ D.localOperators Q j :=
    residueRep_mem_localOperators hQ _
  let U : D.formsOfLevel Q.place →ₗ[ℂ] V.forms κ :=
    LinearMap.domRestrict (aevalHecke V κ P a p) _
  have dict (x : D.Eigensystem Q.place) (ψ : AddChar (ZMod (ℓ ^ ν)) ℂ)
      (z : D.formsOfLevel Q.place) (hz : (z : V.forms κ) ∈ (x : Isotypic V κ).val)
      (hz_eigen : ∀ k : residueLineStabilizer (ResField (Q.place j)) (card n),
        (D.lineRep Q j k).val z = ψ (P.indLine k).toAdd • z)
      (hψ : ψ ((card n)! : ZMod (ℓ ^ ν)) ≠ 1) :
      ιℓ.symm ((tameTrace Q hN j p g).val x) • (z : V.forms κ) =
        ιℓ.symm ((tameTrace Q hN j 1 g).val x) • U z :=
    tameTrace_smul_eq_aevalHecke hQ hN ha P p g hψ hz hz_eigen
  exact weightedSum_mul_heckeAction_eq_of_eigen Q (shift := ((card n)! : ZMod (ℓ ^ ν))) (root := 1)
    (B := U) lineRep_mem (hB _) (f := fun s ↦ (f s : ℂ)) dict (by simp)

/-- Let the auxiliary places be off the base level (`hQ`), let `P` be a local choice at
`w = Q.place j` for an index `j`, `p` a polynomial and `a` a character. Let `B f` be
`p(Ũ) = aevalHecke V κ P a p` after the norm over the stabiliser of the line in `GL_n(𝔽_w)` with
weight `f ∘ P.indLine` (`hB`). Then the stabiliser fixes the values of `B 1`. -/
lemma lineRep_mul_eq_self (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j))
    (hB : ∀ (f : ZMod (ℓ ^ ν) → ℤ) (y : D.formsOfLevel Q.place), ((B f).val y : V.forms κ) =
      aevalHecke V κ P a p ((weightedSum (D.lineRep Q j) P.indLine f).val y))
    (k : residueLineStabilizer (ResField (Q.place j)) (card n)) : D.lineRep Q j k * B 1 = B 1 := by
  obtain ⟨k₀, hk⟩ := k
  obtain ⟨g₀, rfl⟩ := reduceGL_surjective k₀
  have hg₀ : g₀.1 ∈ blockParahoric (min 1) := reduceGL_mem_residueLineStabilizer_iff.1 hk
  ext y : 3
  have norm_fixed : ((weightedSum (D.lineRep Q j) P.indLine 1).1 y).1 ∈
      parahoricEigenspace (localFormRep V κ (Q.apart.star_ne j j)) (min 1) 1 := by
    refine ⟨weightedSum_indLine_mem_levelSpace hQ P 1 y, fun g hg ↦ ?_⟩
    rw [localFormRep_apply_eq_lineRep hQ hg, ← Module.End.mul_apply, ← Subalgebra.coe_mul,
      mul_weightedSum]
    simp [Pi.one_def]
  -- `U` preserves the forms fixed by the parahoric subgroup, hence so does `p(Ũ)`.
  obtain ⟨-, B_fixed⟩ : ((B 1).1 y).1 ∈
      parahoricEigenspace (localFormRep V κ (Q.apart.star_ne j j)) (min 1) 1 := by
    rw [hB, aevalHecke, ← aeval_map_algebraMap ℂ]
    exact aeval_apply_smul_mem_of_le_comap norm_fixed _ _
      (parahoricEigenspace_mem_invtSubmodule (localFormRep V κ (Q.apart.star_ne j j)) P.v_ϖ
        (χ := 1))
  -- On forms, an element of the stabiliser acts through any of its lifts to the parahoric subgroup.
  simpa [← localFormRep_apply_eq_lineRep hQ hg₀] using B_fixed g₀ hg₀

/-- Let the auxiliary places `w i = Q.place i` be off the base level (`hQ`), and let `P` be a local
choice at `w j` for an index `j`, with uniformiser `ϖ` and Frobenius element `φ`, and let `q` be the
order of the residue field at `w j`. Let `U' = B 1` be `p(Ũ)` after the norm over the stabiliser of
the line (`hB`), where `p = (X - q ^ t) H`, `Ũ = a(φ) U` and `U` is the Hecke operator of
`diag (ϖ, 1, …, 1)`, and let `U'` be made of translates at `w j` (`hB_mem`). Let `δ` be in the Hecke
algebra, and suppose that the Hecke polynomial at `w j` of every base system where `δ` does not
vanish is, after scaling by `1 / a(φ)`, a chain of `t + 1` roots `1, q, …, q ^ t` times a divisor of
`H` (`HasRootChain`). Then `δ Nm U' = 0`, where `Nm` is the sum over `∏ GL_n(𝔽_{w i})`. -/
lemma heckeAction_mul_norm_mul_eq_zero (hQ : ∀ j : J, D.IsOffLevel ![] (Q.place j))
    (hB : ∀ (f : ZMod (ℓ ^ ν) → ℤ) (y : D.formsOfLevel Q.place), ((B f).val y : V.forms κ) =
      aevalHecke V κ P a p ((weightedSum (D.lineRep Q j) P.indLine f).val y))
    (hB_mem : B 1 ∈ D.localOperators Q j) {H : EllAdicIntegers[X]} {t : ℕ}
    (hp : p = (X - C ((Q.place j).q ^ t : EllAdicIntegers)) * H) (δ : D.heckeAlgebra Q.place)
    (h_chain : ∀ x : D.Eigensystem Q.place, x.val ∈ D.Eigensystem ![] → δ.val x ≠ 0 →
      HasRootChain (x.val.heckePolyAt (Q.place j)) (H.map (algebraMap EllAdicIntegers ℂ))
        (Q.place j).q (algebraMap EllAdicIntegers ℂ (a (Q.frobData j).frob))⁻¹ (t + 1)) :
    heckeAction δ * (∑ g : (j : J) → GL (Fin (card n)) (ResField (Q.place j)), D.residueRep Q g) *
      B 1 = 0 := by
  obtain ⟨-, -, -, h_sys⟩ := hQ j
  obtain ⟨F, F_pos, F_inv⟩ := V.exists_isUnitary_formTranslation κ
  have unitary : IsUnitary (localFormRep V κ (Q.apart.star_ne j j)).ρ F :=
    ⟨F_pos, fun _ _ _ ↦ F_inv ..⟩
  -- The values of `S = Nm U'` have base level. We show that `δ S y` is orthogonal to all `δ w` with
  -- `w` of base level, hence to itself.
  let S : D.integralEnd Q.place := (∑ g, D.residueRep Q g) * B 1
  have S_base (y : D.formsOfLevel Q.place) : (S.1 y).1 ∈ D.formsOfLevel ![] := by
    refine mem_formsOfLevel_empty_iff_residueRep_fixed.2 fun g ↦ ?_
    rw [← Module.End.mul_apply, ← Subalgebra.coe_mul, ← mul_assoc, mul_sum_monoidHom]
  -- A form `w` of base level in a system where `δ` does not vanish is orthogonal to the values of
  -- `U'` by the chain lemma, and the finite groups fix it.
  have orth (x : D.Eigensystem Q.place) (hx : x.1 ∈ D.Eigensystem ![]) (hδ : δ.1 x ≠ 0)
      (w : V.forms κ) (hw : w ∈ x.1.1 ⊓ D.formsOfLevel ![]) (y : D.formsOfLevel Q.place) :
      F w (S.1 y).1 = 0 := by
    rcases eq_or_ne w 0 with rfl | w_ne
    · simp
    obtain ⟨w_sph, ev, poly_eq, w_eigen⟩ := hasHeckePolyAt_iff_localFormRep.1
      (hasHeckePolyAt_of_mem_eigenformsAt (h_sys _ hx hw) (Q.apart.star_ne j j))
    have orth_B : F w ((B 1).1 y).1 = 0 := by
      rw [hB, aevalHecke, ← aeval_map_algebraMap ℂ]
      simpa [hp, H.map_comp] using pairing_aeval_heckeCoset_eq_zero unitary w_sph w_ne poly_eq
        w_eigen P.v_ϖ (((isUnit _).map a).map _).ne_zero (h_chain x hx hδ)
        (weightedSum_indLine_mem_levelSpace hQ P 1 y)
    have term (g : ∀ j, GL (Fin (card n)) (ResField (Q.place j))) :
        F w ((D.residueRep Q g).1 ((B 1).1 y)).1 = 0 := by
      have w_fixed : ((D.residueRep Q g).1 ⟨w, formsOfLevel_base_le _ hw.2⟩).1 = w :=
        congrArg Subtype.val (mem_formsOfLevel_empty_iff_residueRep_fixed.1 hw.2 g)
      rw [← w_fixed]
      exact (F_inv ..).trans orth_B
    simp [S, term]
  have comm : Commute (heckeAction δ) S :=
    .mul_right (.sum_right _ _ _ fun g _ ↦ commute_heckeAction_residueRep Q hQ δ g)
      (localOperators.commute_heckeAction hB_mem δ)
  rw [mul_assoc]
  ext y : 3
  have orth_base :
      D.formsOfLevel ![] ≤ (F.flip ((heckeAction δ * S).1 y).1 ∘ₛₗ diagOp δ.1).ker := by
    refine formsOfLevel_le_of_eigensystem ?_
    rintro ⟨x, f, ⟨hf, hf_base⟩, hf_ne⟩ w hw
    -- The system `x` of base level, read at the auxiliary level.
    let ξ : D.Eigensystem Q.place := ⟨x, f, ⟨hf, formsOfLevel_base_le _ hf_base⟩, hf_ne⟩
    by_cases hδ : δ.1 ξ = 0
    · simp [diagOp_apply _ ξ hw.1, hδ]
    · simp [diagOp_apply _ ξ hw.1, comm.eq, orth ξ ⟨f, ⟨hf, hf_base⟩, hf_ne⟩ hδ w hw]
  by_contra δS_ne
  exact (F_pos _ δS_ne).ne' (orth_base (S_base y))

end OnePlace

