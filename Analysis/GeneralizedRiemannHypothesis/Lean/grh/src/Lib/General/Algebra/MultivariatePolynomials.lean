import Lib.Cohomology.Etale.Basic

/-!
# Multivariate polynomials: cost of vanishing, homogenization, Nullstellensatz, Hensel

This file collects lemmas on polynomials in several variables and on algebras of finite type. They
cover commuting partial derivatives, generation by products of polynomials in two sets of variables,
the cost of monomials of polynomials that vanish to high order, and homogenization along a linear
form.

## Main definitions and results

* `New.exists_le_weight_of_mem_vanishingIdeal_pow`: a nonzero polynomial that vanishes to order `d`
  at enough suitable points has a monomial of cost at least `d`.
* `New.exists_isHomogeneous_sub_one_dvd_sub` replaces a polynomial `P` of total degree at most `N`
  by a form `G`, homogeneous of degree `N`, congruent to `P` modulo `F - 1` for a given linear form
  `F`. So `G` and `P` have the same value at every point where `F` equals `1`
  (`New.exists_homogenization`); points are `R`-algebra maps `φ` out of the polynomial ring, with
  values in algebras in `Type`.
* `New.nullstellensatz_exists_le_ker`: the weak Nullstellensatz for an algebra of finite type, with
  points written as `k`-algebra homomorphisms `A → k`.
* `New.exists_mem_colon_of_tangent`: a criterion for an ideal to cut out a section of an affine
  scheme of finite type near a point. Tangent vectors at a `k`-valued point `o` along the fibre are
  the `V`-algebra maps to the dual numbers `k[ε]` that reduce to `o`.
* `New.Variety.IsAbsIntegrallyClosedLocal.multivariate_hensel` is a several-variable Hensel lemma
  for systems `x i = p i (x)` whose coefficients lie in the maximal ideal. Over a local domain in
  which every monic polynomial of positive degree has a root
  (`New.Variety.IsAbsIntegrallyClosedLocal`), it follows from the local structure of étale algebras:
  a standard étale algebra is given by a monic polynomial, whose residual root lifts.

## Relation to the literature

All results are known. `New.exists_le_weight_of_mem_vanishingIdeal_pow` is a form of the
Combinatorial Nullstellensatz with multiplicity, over any field. Each variable u has a positive
integer κ(u) and the weight 1/κ(u). In place of a grid it uses a set of at least ∏κ(u) points at
which each u^κ(u) agrees with a polynomial of lower weighted degree. A nonzero polynomial vanishing
to order d at all these points then has a monomial of weighted degree at least d. Source: Alon,
Combinatorial Nullstellensatz (1999); Ball–Serra, Punctured combinatorial Nullstellensätze (2009).
-/

/-! ## Partial derivatives of multivariate polynomials commute -/

/-- The formal partial derivatives of a polynomial in several variables commute. -/
lemma New.pderiv_comm {σ A : Type*} [CommRing A] (a b : σ) (p : MvPolynomial σ A) :
    (p.pderiv b).pderiv a = (p.pderiv a).pderiv b := by
  classical
  ext m
  -- Both coefficients are the same multiple of the coefficient of `p` at `m + eₐ + e_b`.
  obtain rfl | h_ne := eq_or_ne a b
  · rfl
  · simp [MvPolynomial.coeff_pderiv, add_right_comm m (Finsupp.single a 1), h_ne, h_ne.symm,
      mul_right_comm]

/-! ## Polynomials in two covering sets of variables -/

section PolynomialSpan

open MvPolynomial Set

/-- If the ranges of `p` and `q` cover the set of variables `ι`, every complex polynomial is a sum
of products of a polynomial in the variables `p k` and one in the variables `q k`. -/
lemma New.mem_rename_range_mul {ι κ κ' : Type*} (p : κ → ι) (q : κ' → ι)
    (h_cover : ∀ i : ι, i ∈ range p ∪ range q) (P : MvPolynomial ι ℂ) :
    P ∈ (rename p).range.toSubmodule * (rename (R := ℂ) q).range.toSubmodule := by
  -- The product of the two subalgebras is the subalgebra generated by all the `X (p k)` and
  -- `X (q k)`; by `h_cover` these are all the variables.
  have h_vars : range (X ∘ p) ∪ range (X ∘ q) = range (X : ι → MvPolynomial ι ℂ) := by
    rw [range_comp, range_comp, ← image_union, eq_univ_of_forall h_cover, image_univ]
  simp only [rename_eq_aeval, aeval_range, ← Algebra.adjoin_union_coe_submodule, h_vars,
    adjoin_range_X, Subalgebra.mem_toSubmodule, Algebra.mem_top]

end PolynomialSpan

/-!
## Vanishing to order d and the cost of monomials

Each variable `u` has the cost `1/κ_u`, and a monomial costs the sum of the costs of its variables.
-/

section ZerosCostDegree

open MvPolynomial Finset Finsupp Submodule Ideal

/-- If `p` vanishes to order `d` at the point `w`, then after translating `w` to the origin the
coefficients of `p` of degree below `d` are zero. -/
lemma New.coeff_translate_eq_zero_of_mem_vanishingIdeal_pow {K ι : Type} [Field K] [Fintype ι]
    {w : ι → K} {d : ℕ} {p : MvPolynomial ι K} (hp : p ∈ vanishingIdeal K {w} ^ d) {γ : ι →₀ ℕ}
    (hγ : γ.degree < d) : (bind₁ (X + C ∘ w) p).coeff γ = 0 := by
  let T : MvPolynomial ι K →ₐ[K] MvPolynomial ι K := bind₁ (X + C ∘ w)
  have h_origin : vanishingIdeal K {w} ≤ (idealOfVars ι K).comap T := fun q hq ↦ by
    have h_const : constantCoeff (T q) = 0 := by simpa [T, hom_bind₁] using hq
    rw [Ideal.mem_comap, ← pow_one (idealOfVars ι K), mem_pow_idealOfVars_iff']
    simpa [degree_eq_zero_iff, ← constantCoeff_eq] using h_const
  have h_mem : T p ∈ idealOfVars ι K ^ d := le_comap_pow T d (pow_right_mono h_origin d hp)
  exact (mem_pow_idealOfVars_iff' d _).1 h_mem γ hγ

/-- If the polynomials `φ u` vanish at the point `w`, the product `∏ φ u ^ γ u` vanishes at `w` to
every order `d ≤ |γ|`. -/
lemma New.bind₁_monomial_mem_vanishingIdeal_pow {K ι : Type} [Field K] [Fintype ι] {w : ι → K}
    {φ : ι → MvPolynomial ι K} (hφ : ∀ u : ι, eval w (φ u) = 0) {d : ℕ} {γ : ι →₀ ℕ}
    (hγ : d ≤ γ.degree) : bind₁ φ (monomial γ 1) ∈ vanishingIdeal K {w} ^ d := by
  classical
  have h_vars : idealOfVars ι K ≤ (vanishingIdeal K {w}).comap (bind₁ φ) := by
    simp [Ideal.span_le, hφ, Set.range_subset_iff]
  have h_mem : monomial γ 1 ∈ idealOfVars ι K ^ d := (mem_pow_idealOfVars_iff d _).2 (by simpa)
  exact le_comap_pow _ d (pow_right_mono h_vars d h_mem)

/-- Chinese remainder theorem for jets: at finitely many distinct points `z t`, the coefficients
of degree below `d` after translation to the origin can be prescribed arbitrarily. -/
lemma New.exists_forall_coeff_translate_eq {K ι S : Type} [Field K] [Fintype ι] [Fintype S]
    {z : S → ι → K} (hz_inj : z.Injective) {d : ℕ} {Γ : Finset (ι →₀ ℕ)}
    (hΓ : ∀ γ ∈ Γ, γ.degree < d) (y : S × Γ → K) :
    ∃ p : MvPolynomial ι K, ∀ (t : S) (γ : Γ), (bind₁ (X + C ∘ z t) p).coeff γ = y (t, γ) := by
  classical
  have h_ideal_inj : Function.Injective fun w : ι → K ↦ vanishingIdeal K {w} := fun w w' h_eq ↦ by
    funext u
    simpa [sub_eq_zero] using h_eq.ge (show X u - C (w' u) ∈ vanishingIdeal K {w'} by simp)
  have h_coprime : Pairwise (Function.onFun IsCoprime fun t : S ↦ vanishingIdeal K {z t} ^ d) :=
    fun t t' h_ne ↦ .pow (isCoprime_of_isMaximal ((h_ideal_inj.comp hz_inj).ne h_ne))
  -- The polynomial `q t` has the prescribed jet at `z t`.
  let q (t : S) : MvPolynomial ι K := bind₁ (X + C ∘ (-z t)) (∑ γ : Γ, monomial γ (y (t, γ)))
  obtain ⟨p, hp⟩ := exists_forall_sub_mem_ideal h_coprime q
  refine ⟨p, fun t γ ↦ ?_⟩
  have h_jet : (bind₁ (X + C ∘ z t) (p - q t)).coeff γ = 0 :=
    New.coeff_translate_eq_zero_of_mem_vanishingIdeal_pow (hp t) (hΓ γ γ.property)
  simpa [q, bind₁_bind₁, coeff_sum, sub_eq_zero] using h_jet

/-- A submodule that contains the monomials occurring in `p` contains `p`. -/
lemma New.mem_of_forall_monomial_mem {K ι : Type} [Field K] {N : Submodule K (MvPolynomial ι K)}
    {p : MvPolynomial ι K} (h_monomial : ∀ α ∈ p.support, monomial α 1 ∈ N) : p ∈ N := by
  rw [p.as_sum]
  exact N.sum_mem fun α hα ↦ by simpa [smul_monomial] using N.smul_mem _ (h_monomial α hα)

/-- Comparing exponents by a monotone real function is well founded (Dickson's lemma). -/
lemma New.wellFounded_lt_of_monotone_finsupp {ι : Type} [Fintype ι] {c : (ι →₀ ℕ) → ℝ}
    (hc : Monotone c) : WellFounded fun α β : ι →₀ ℕ ↦ c α < c β := by
  let e : (fun α β : ι →₀ ℕ ↦ α ≤ β) →r fun α β : ι →₀ ℕ ↦ c α ≤ c β := ⟨id, fun h_le ↦ hc h_le⟩
  have h_wqo : WellQuasiOrdered fun α β : ι →₀ ℕ ↦ c α ≤ c β :=
    wellQuasiOrdered_le.of_surjective e Function.surjective_id
  simpa only [lt_iff_le_not_ge] using h_wqo.wellFounded

/-- Division by the polynomials `ψ u = X u ^ κ u - g u`, where the variable `u` costs `1 / κ u` and
the monomials of `g u` cost less than `1`. If a submodule `N` contains the products
`X ^ α * ψ ^ γ` with `α < κ` and `|γ| + cost α ≤ r`, then it contains all the products with
`|γ| + cost α ≤ r`. -/
lemma New.monomial_mul_bind₁_mem_of_weight_le {K ι : Type} [Field K] [Fintype ι] {κ : ι → ℕ}
    (hκ : ∀ u : ι, 0 < κ u) {g : ι → MvPolynomial ι K}
    (hg : ∀ u : ι, ∀ α ∈ (g u).support, weight (fun u : ι ↦ (κ u : ℝ))⁻¹ α < 1)
    {N : Submodule K (MvPolynomial ι K)} {r : ℝ}
    (hN : ∀ α γ : ι →₀ ℕ, (∀ u : ι, α u < κ u) →
      γ.degree + weight (fun u : ι ↦ (κ u : ℝ))⁻¹ α ≤ r →
      monomial α 1 * bind₁ (fun u : ι ↦ X u ^ κ u - g u) (monomial γ 1) ∈ N)
    (α γ : ι →₀ ℕ) (h_le : γ.degree + weight (fun u : ι ↦ (κ u : ℝ))⁻¹ α ≤ r) :
    monomial α 1 * bind₁ (fun u : ι ↦ X u ^ κ u - g u) (monomial γ 1) ∈ N := by
  set cost : (ι →₀ ℕ) →+ ℝ := weight (fun u : ι ↦ (κ u : ℝ))⁻¹ with h_cost
  have h_mono : Monotone cost := fun α β h_exp ↦ by
    simp only [h_cost, weight_eq_sum, nsmul_eq_mul, Pi.inv_apply]
    gcongr with u
    exact h_exp u
  let b (α γ : ι →₀ ℕ) : MvPolynomial ι K :=
    monomial α 1 * bind₁ (fun u : ι ↦ X u ^ κ u - g u) (monomial γ 1)
  change b α γ ∈ N
  induction α using (New.wellFounded_lt_of_monotone_finsupp h_mono).induction generalizing γ with
  | _ α ih => ?_
  by_cases! hα : ∀ u : ι, α u < κ u
  · exact hN α γ hα h_le
  -- Otherwise `X ^ α = X ^ β * X u ^ κ u`, and `X u ^ κ u = ψ u + g u` lowers the cost.
  obtain ⟨u, hu : κ u ≤ α u⟩ := hα
  obtain ⟨β, rfl⟩ : ∃ β : ι →₀ ℕ, α = single u (κ u) + β := exists_add_of_le (single_le_iff.2 hu)
  have cost_eq : cost (single u (κ u) + β) = 1 + cost β := by simp [h_cost, weight, hκ, ne_of_gt]
  have h_split : b (single u (κ u) + β) γ = b β (single u 1 + γ) + g u * b β γ := by
    simp only [b, monomial_single_add, map_mul, pow_one, bind₁_X_right]
    ring
  rw [cost_eq] at ih h_le
  rw [h_split]
  refine add_mem (ih β (by simp) _ (by simpa [add_assoc, add_comm, add_left_comm] using h_le)) ?_
  suffices g u ∈ N.comap (LinearMap.mulRight K (b β γ)) by simpa
  refine New.mem_of_forall_monomial_mem fun δ hδ ↦ ?_
  have h_lt : cost (δ + β) < 1 + cost β := by simpa using hg u δ hδ
  simpa [b, ← mul_assoc] using ih (δ + β) h_lt γ (by linarith)

/-- Combinatorial Nullstellensatz with multiplicity. Give the variable `u` the cost `1 / κ u`; the
cost of a monomial is its `weight`. Take at least `∏ κ u` distinct points `z t` at which each
`X u ^ κ u` agrees with a polynomial `g u` whose monomials cost less than `1`. Then every `f ≠ 0`
that vanishes to order `d` at these points has a monomial of cost at least `d`. -/
theorem New.exists_le_weight_of_mem_vanishingIdeal_pow {K ι S : Type} [Field K] [Fintype ι]
    [Fintype S] (κ : ι → ℕ) (hκ : ∀ u : ι, 0 < κ u) (z : S → ι → K) (hz_inj : z.Injective)
    (h_card : ∏ u : ι, κ u ≤ Fintype.card S) (g : ι → MvPolynomial ι K)
    (hg_cost : ∀ u : ι, ∀ α ∈ (g u).support, weight (fun u : ι ↦ (κ u : ℝ))⁻¹ α < 1)
    (hg_eval : ∀ (u : ι) (t : S), eval (z t) (g u) = z t u ^ κ u)
    (d : ℕ) (f : MvPolynomial ι K) (hf_ne : f ≠ 0) (hf : ∀ t : S, f ∈ vanishingIdeal K {z t} ^ d) :
    ∃ α ∈ f.support, (d : ℝ) ≤ weight (fun u : ι ↦ (κ u : ℝ))⁻¹ α := by
  classical
  -- Put `ψ u = X u ^ κ u - g u`, which vanishes at the points. The products `X ^ α * ψ ^ γ` with
  -- `α < κ`, `|γ| < d` span modulo the kernel of the jet map `J` and are at most as many as the
  -- jets, so they are independent modulo that kernel. A polynomial of cost below `d` lies in their
  -- span; if its jets vanish, it is zero.
  obtain ⟨Γ, hΓ⟩ : ∃ Γ : Finset (ι →₀ ℕ), ∀ γ : ι →₀ ℕ, γ ∈ Γ ↔ γ.degree < d :=
    ⟨(finite_of_degree_lt d).toFinset, fun γ ↦ Set.Finite.mem_toFinset _⟩
  -- The jets of order below `d` at the points: the low coefficients after translation.
  let J : MvPolynomial ι K →ₗ[K] (S × Γ → K) :=
    LinearMap.pi fun (t, γ) ↦ lcoeff K γ ∘ₗ (bind₁ (X + C ∘ z t)).toLinearMap
  have mem_ker {p : MvPolynomial ι K} (hp : ∀ t : S, p ∈ vanishingIdeal K {z t} ^ d) : p ∈ J.ker :=
    LinearMap.mem_ker.2 <| funext fun (t, γ) ↦
      New.coeff_translate_eq_zero_of_mem_vanishingIdeal_pow (hp t) ((hΓ γ).1 γ.property)
  have J_surj : Function.Surjective J := fun y ↦
    (New.exists_forall_coeff_translate_eq hz_inj (fun γ ↦ (hΓ γ).1) y).imp
      fun p hp ↦ funext fun (t, γ) ↦ hp t γ
  -- The products `b α γ = X ^ α * ψ ^ γ`; they vanish to order `|γ|` at the points.
  let b (α γ : ι →₀ ℕ) : MvPolynomial ι K :=
    monomial α 1 * bind₁ (fun u : ι ↦ X u ^ κ u - g u) (monomial γ 1)
  let v : univ.finsupp (range ∘ κ) × Γ → MvPolynomial ι K := fun (α, γ) ↦ b α γ
  have b_span (α γ : ι →₀ ℕ) (hα : ∀ u : ι, α u < κ u) (hγ : γ.degree < d) :
      b α γ ∈ span K (Set.range v) :=
    subset_span ⟨(⟨α, by simpa [mem_finsupp_iff]⟩, ⟨γ, (hΓ γ).2 hγ⟩), rfl⟩
  have b_ker (α γ : ι →₀ ℕ) (hγ : d ≤ γ.degree) : b α γ ∈ J.ker :=
    mem_ker fun t ↦ mul_mem_left _ _
      (New.bind₁_monomial_mem_vanishingIdeal_pow (fun u ↦ by simp [hg_eval]) hγ)
  -- By division, every polynomial lies in the span of the `v x` modulo the kernel of `J`.
  have mem_sup (p : MvPolynomial ι K) : p ∈ span K (Set.range v) ⊔ J.ker := by
    refine New.mem_of_forall_monomial_mem fun α _ ↦ ?_
    suffices b α 0 ∈ span K (Set.range v) ⊔ J.ker by simpa [b]
    refine New.monomial_mul_bind₁_mem_of_weight_le hκ hg_cost (fun β γ hβ _ ↦ ?_) α 0 le_rfl
    obtain hγ | hγ := lt_or_ge γ.degree d
    · exact mem_sup_left (b_span β γ hβ hγ)
    · exact mem_sup_right (b_ker β γ hγ)
  have h_span : ⊤ ≤ span K (Set.range (J ∘ v)) := fun y _ ↦ by
    obtain ⟨p, rfl⟩ := J_surj y
    simpa only [Set.range_comp, span_image, ← Submodule.mem_comap, Submodule.comap_map_eq]
      using mem_sup p
  have h_indep : LinearIndependent K (J ∘ v) :=
    linearIndependent_of_top_le_span_of_card_le_finrank h_span
      (by simpa using Nat.mul_le_mul_right Γ.card h_card)
  -- If all monomials of `f` cost less than `d`, division stays in the span of the `v x`.
  by_contra! h_low
  have hf_span : f ∈ span K (Set.range v) := New.mem_of_forall_monomial_mem fun α hα ↦ by
    suffices b α 0 ∈ span K (Set.range v) by simpa [b]
    refine New.monomial_mul_bind₁_mem_of_weight_le hκ hg_cost (fun β γ hβ h_le ↦ ?_) α 0 le_rfl
    have h_nonneg : 0 ≤ weight (fun u : ι ↦ (κ u : ℝ))⁻¹ β := by
      simp only [weight_eq_sum, Pi.inv_apply]
      positivity
    simp only [map_zero, Nat.cast_zero, zero_add] at h_le
    have h_degree : (γ.degree : ℝ) < d := by linarith [h_low α hα]
    exact b_span β γ hβ (Nat.cast_lt.1 h_degree)
  exact hf_ne ((range_ker_disjoint h_indep).le_bot ⟨hf_span, mem_ker hf⟩)

end ZerosCostDegree

/-! ## Homogenization with respect to a linear form -/

section Homogenization

open MvPolynomial

/-- Homogenization by a linear form `F`: a polynomial `P` of total degree at most `N` is congruent
modulo `F - 1` to a homogeneous polynomial `G` of degree `N`. -/
lemma New.exists_isHomogeneous_sub_one_dvd_sub {ι R : Type*} {N : ℕ} [CommRing R]
    {F : MvPolynomial ι R} (hF : F.IsHomogeneous 1) (P : MvPolynomial ι R)
    (hP : P.totalDegree ≤ N) :
    ∃ G : MvPolynomial ι R, G.IsHomogeneous N ∧ F - 1 ∣ G - P := by
  -- Multiply the homogeneous component of degree `n` of `P` by `F ^ (N - n)` and add up.
  let G : MvPolynomial ι R :=
    ∑ n ∈ .range (P.totalDegree + 1), F ^ (N - n) * homogeneousComponent n P
  refine ⟨G, IsHomogeneous.sum _ _ N fun n hn ↦ ?_, ?_⟩
  · have h_le : n ≤ N := (Finset.mem_range_succ_iff.1 hn).trans hP
    simpa [h_le] using (hF.pow (N - n)).mul (P.homogeneousComponent_isHomogeneous n)
  · have h_sub : G - P =
        ∑ n ∈ .range (P.totalDegree + 1), (F ^ (N - n) - 1) * homogeneousComponent n P := by
      simp only [G, sub_mul, one_mul, Finset.sum_sub_distrib, sum_homogeneousComponent]
    rw [h_sub]
    exact Finset.dvd_sum fun n _ ↦ (sub_one_dvd_pow_sub_one F (N - n)).mul_right _

/-- Homogenization by a linear form `F`: for a polynomial `P` over `R` of total degree at most `N`
there is a homogeneous `G` of degree `N` with `φ G = φ P` for every `R`-algebra map `φ` to an
algebra in `Type` (universe zero) with `φ F = 1`. -/
lemma New.exists_homogenization {ι R : Type*} {N : ℕ} [CommRing R] {F : MvPolynomial ι R}
    (hF : F.IsHomogeneous 1) (P : MvPolynomial ι R) (hP : P.totalDegree ≤ N) :
    ∃ G : MvPolynomial ι R, G.IsHomogeneous N ∧
      ∀ {A : Type} [CommRing A] [Algebra R A] (φ : MvPolynomial ι R →ₐ[R] A),
        φ F = 1 → φ G = φ P := by
  obtain ⟨G, hG, h_dvd⟩ := New.exists_isHomogeneous_sub_one_dvd_sub hF P hP
  exact ⟨G, hG, fun φ hφ ↦ by simpa [hφ, sub_eq_zero] using map_dvd φ h_dvd⟩

end Homogenization

/-! ## The weak Nullstellensatz for finite type algebras -/

section Nullstellensatz

open Algebra Ideal Quotient

/-- Nullstellensatz: in an algebra `A` of finite type over an algebraically closed field `k`,
every proper ideal lies in the kernel of some `k`-algebra homomorphism `A → k`. -/
lemma New.nullstellensatz_exists_le_ker {k A : Type*} [Field k] [IsAlgClosed k] [CommRing A]
    [Algebra k A] [FiniteType k A] {J : Ideal A} (hJ : J ≠ ⊤) :
    ∃ φ : A →ₐ[k] k, J ≤ RingHom.ker φ := by
  -- The quotient by a maximal ideal `m ⊇ J` is a field, finite over `k` (Zariski's lemma), so it
  -- embeds into the algebraically closed field `k`.
  obtain ⟨m, hm : m.IsMaximal, hJm : J ≤ m⟩ := J.exists_le_maximal hJ
  let : Field (A ⧸ m) := Quotient.field m
  have : Module.Finite k (A ⧸ m) := finite_of_finite_type_of_isJacobsonRing k (A ⧸ m)
  exact ⟨IsAlgClosed.lift.comp (mkₐ k m), fun a ha ↦ by simp [eq_zero_iff_mem.2 (hJm ha)]⟩

end Nullstellensatz

/-! ## Nakayama's lemma in tangent form -/

section TangentNakayama

open DualNumber Module RingHom Algebra FinitePresentation Ideal Quotient TrivSqZeroExt

/-- Nakayama's lemma in tangent form. Let `x : S → V` be a section of a finite type `V`-algebra,
`o : S → k` the field-valued point on it given by `V → k`, and `I ⊆ ker x` an ideal. If every
lift `w` of `o` to the dual numbers `k[ε]` that kills `I` has zero `ε`-part (no nonzero tangent
vector along the fibre kills `I`), then `I` generates `ker x` near `o`: some `b` with `o b ≠ 0`
has `b * ker x ⊆ I`. -/
lemma New.exists_mem_colon_of_tangent {V S k : Type*} [CommRing V] [CommRing S] [Algebra V S]
    [FiniteType V S] [Field k] [Algebra V k] {x : S →ₐ[V] V} {o : S →ₐ[V] k}
    (ho : (ofId V k).comp x = o) {I : Ideal S} (hI : I ≤ ker x)
    (h_tan : ∀ w : S →ₐ[V] k[ε], (∀ s : S, (w s).fst = o s) → I ≤ ker w → ∀ s : S, (w s).snd = 0) :
    ∃ b ∈ I.colon (ker x), o b ≠ 0 := by
  -- Otherwise the point `P` under `o` is in the support of the finite module `M = ker x / I`, so
  -- `M` has a non-zero functional `l` with values in the residue field of `P`. Composed with the
  -- projection `a ↦ a - x a` onto `ker x`, it is a tangent vector at `o` that kills `I`; by
  -- `h_tan` it vanishes, so `l = 0`.
  algebraize [x.toRingHom]
  let P : PrimeSpectrum S := PrimeSpectrum.comap o.toRingHom ⊥
  let M : Submodule S (S ⧸ I) := Submodule.map I.mkQ (ker x)
  -- `V` is finitely presented over `S` via `x`, so `ker x` is finitely generated
  have : Algebra.FinitePresentation S V := of_restrict_scalars_finitePresentation V S V
  have : Module.Finite S (ker x) :=
    .of_fg (ker_fG_of_surjective (ofId S V) fun v ↦ ⟨algebraMap V S v, x.commutes v⟩)
  by_contra! h_colon
  have h_le : I.colon (ker x) ≤ P.asIdeal := h_colon
  have hP : P ∈ support S M :=
    mem_support_iff_of_finite.2 (I.annihilator_map_mkQ_eq_colon.trans_le h_le)
  obtain ⟨l, hl⟩ : ∃ l : M →ₗ[S] P.asIdeal.ResidueField, l ≠ 0 := by
    -- the fibre `κ(P) ⊗ M` is a non-zero vector space, so its dual is non-zero
    have h_fibre := (mem_support_iff_nontrivial_residueField_tensorProduct P).1 hP
    have : Nontrivial (M →ₗ[S] P.asIdeal.ResidueField) :=
      (LinearMap.liftBaseChangeEquiv _).nontrivial_congr.2 ((nontrivial_dual_iff _).2 h_fibre)
    exact exists_ne 0
  -- `ϖ a` is the class in `M` of the projection `a - x a` of `a` onto `ker x`
  let ϖ (a : S) : M := ⟨I.mkQ (a - ofId V S (x a)), Submodule.mem_map_of_mem (by simp)⟩
  have ϖ_add (s t : S) : ϖ (s + t) = ϖ s + ϖ t := by simp [ϖ, sub_add_sub_comm]
  have ϖ_const (r : V) : ϖ (algebraMap V S r) = 0 := by simp [ϖ, ← ZeroMemClass.zero_def]
  have ϖ_mul (s t : S) : ϖ (s * t) = s • ϖ t + algebraMap V S (x t) • ϖ s := by
    have h_leibniz : s * t - algebraMap V S (x (s * t)) =
        s * (t - algebraMap V S (x t)) + algebraMap V S (x t) * (s - algebraMap V S (x s)) := by
      simp only [map_mul]
      ring
    ext
    simp only [ϖ, h_leibniz, Submodule.coe_add, Submodule.coe_smul, ← map_smul, ← map_add,
      smul_eq_mul, ofId_apply]
  let κ : P.asIdeal.ResidueField →+* k :=
    ResidueField.lift P.asIdeal o.toRingHom le_rfl fun s ↦ .mk0 (o s)
  let D (s : S) : k := κ (l (ϖ s))
  have D_mul (s t : S) : D (s * t) = o s * D t + o t * D s := by
    have κ_smul (a : S) (c : P.asIdeal.ResidueField) : κ (a • c) = o a * κ c := by
      simp [smul_def, κ]
    have o_proj : o (algebraMap V S (x t)) = o t := by simp [← ho]
    simp only [D, ϖ_mul, map_add, map_smul, κ_smul, o_proj]
  -- the tangent vector `s ↦ o s + D s ε`; it is multiplicative by the Leibniz rule `D_mul`
  let w : S →ₐ[V] k[ε] :=
    { toFun s := inl (o s) + inr (D s)
      map_one' := by simp [D, ϖ, ← ZeroMemClass.zero_def]
      map_mul' s t := by simp [D_mul, TrivSqZeroExt.ext_iff, mul_comm (o t)]
      map_zero' := by simp [D, ϖ, ← ZeroMemClass.zero_def]
      map_add' s t := by simp [D, ϖ_add, TrivSqZeroExt.ext_iff]
      commutes' r := by simp [D, ϖ_const, algebraMap_eq_inl'] }
  have w_ker : I ≤ ker w := fun s hs ↦ by
    simp [w, D, ϖ, ← ho, mem_ker.1 (hI hs), eq_zero_iff_mem.2 hs, ← ZeroMemClass.zero_def]
  have D_zero (s : S) : D s = 0 := by simpa [w] using h_tan w (by simp [w]) w_ker s
  -- on `ker x` the map `ϖ` is the projection onto `M`, and `κ` is injective
  refine hl (LinearMap.ext ?_)
  rintro ⟨_, q, hq, rfl⟩
  simpa [D, ϖ, mem_ker.1 hq] using D_zero q

end TangentNakayama

/-! ## Hensel's lemma in several variables -/

section MultivariateHensel

open IsLocalization.Away IsLocalRing MvPolynomial Algebra Localization PreSubmersivePresentation

/-- Hensel's lemma in several variables. Let `A` be an absolutely integrally closed local domain
(`IsAbsIntegrallyClosedLocal`: a local domain in which every monic polynomial of positive degree has
a root) and `p i` finitely many polynomials in the variables `X i` with all coefficients in the
maximal ideal. Then the system `x i = p i (x)` has a solution `x` in `A`. -/
lemma New.Variety.IsAbsIntegrallyClosedLocal.multivariate_hensel {A : Type*} [CommRing A]
    [IsAbsIntegrallyClosedLocal A] {ι : Type} [Fintype ι] {p : ι → MvPolynomial ι A}
    (hp : ∀ (i : ι) (m : ι →₀ ℕ), (p i).coeff m ∈ maximalIdeal A) :
    ∃ x : ι → A, ∀ i : ι, x i = aeval x (p i) := by
  classical
  -- The algebra `A[X] / (X - p)` with the Jacobian inverted is étale over `A`.
  let Q := MvPolynomial ι A ⧸ Ideal.span (Set.range (X - p))
  let Z : PreSubmersivePresentation A Q ι ι :=
    PreSubmersivePresentation.naive (v := X - p) _ Function.injective_id
  let L : PreSubmersivePresentation Q (Away Z.jacobian) Unit Unit := localizationAway _ Z.jacobian
  have hL : IsUnit (L.comp Z).jacobian := by
    simp [L, smul_def, algebraMap_isUnit (S := Away Z.jacobian) Z.jacobian]
  have : Algebra.IsStandardSmoothOfRelativeDimension 0 A (Away Z.jacobian) :=
    SubmersivePresentation.isStandardSmoothOfRelativeDimension ⟨L.comp Z, hL⟩ (tsub_self _)
  -- The origin of the closed fibre is a point of it: there `p` vanishes and the Jacobian is `1`.
  let origin : MvPolynomial ι A →ₐ[A] ResidueField A := aeval 0
  have origin_eq_zero {q : MvPolynomial ι A} (hq : q.coeff 0 ∈ maximalIdeal A) : origin q = 0 := by
    simpa [origin, constantCoeff_eq] using hq
  have hker : Ideal.span (Set.range (X - p)) ≤ RingHom.ker origin :=
    Ideal.span_le.2 (Set.range_subset_iff.2 fun i ↦ origin_eq_zero (by simpa using hp i 0))
  have hjac : origin.mapMatrix Z.jacobiMatrix = 1 := by
    ext i j
    have h_deriv : origin (pderiv i (p j)) = 0 :=
      origin_eq_zero (by simpa [coeff_pderiv] using hp j _)
    have h_entry : Z.jacobiMatrix i j = pderiv i (X j - p j) := jacobiMatrix_apply Z i j
    simp [h_entry, h_deriv, Matrix.one_apply, Pi.single_apply, eq_comm]
  have hunit : IsUnit (Ideal.Quotient.liftₐ _ origin hker Z.jacobian) := by
    rw [Z.jacobian_eq_jacobiMatrix_det]
    change IsUnit (origin Z.jacobiMatrix.det)
    simp [origin.map_det, hjac]
  let π : Away Z.jacobian →ₐ[A] ResidueField A := liftAlgHom Z.jacobian hunit
  -- Near that point the algebra is standard étale, given by a monic `P.f` and a `P.g` to invert.
  obtain ⟨f, hf : π f ≠ 0, ⟨⟨P : StandardEtalePresentation A (Away f)⟩⟩⟩ :=
    IsEtaleAt.exists_isStandardEtale (R := A) (.comap π ⊥)
  -- As `π f ≠ 0`, `π` extends to `Away f`; the image of `P.x` is a root of `P.f` with `P.g` a unit.
  let π' : Away f →ₐ[A] ResidueField A := liftAlgHom f (.mk0 (π f) hf)
  obtain ⟨hroot, hg⟩ : P.HasMap (π' P.x) := P.hasMap.map π'
  -- Lift the residual root to a root `a` of `P.f` in `A`; `P.g` is a unit at `a`.
  obtain ⟨a, ha, hres⟩ : ∃ a : A, P.f.IsRoot a ∧ algebraMap A (ResidueField A) a = π' P.x :=
    IsAbsIntegrallyClosed.exists_root_map_eq P.monic_f hroot
  rw [← hres, Polynomial.aeval_algebraMap_apply] at hg
  have hga : IsUnit (Polynomial.aeval a P.g) := isUnit_of_map_unit (residue A) _ hg
  -- Sending `P.x` to `a` gives an `A`-point of `A[X] / (X - p)`: a solution of `X = p(X)`.
  let σ : Q →ₐ[A] A := ((P.lift a ⟨ha, hga⟩).comp P.equivRing.toAlgHom).comp (algHom A Q (Away f))
  refine ⟨fun i ↦ σ (Z.val i), fun i ↦ ?_⟩
  have h_rel : aeval Z.val (X i - p i) = 0 := Z.aeval_val_relation i
  have h_val : Z.val i = aeval Z.val (p i) := by rwa [map_sub, aeval_X, sub_eq_zero] at h_rel
  rw [← comp_aeval_apply, ← h_val]

end MultivariateHensel
