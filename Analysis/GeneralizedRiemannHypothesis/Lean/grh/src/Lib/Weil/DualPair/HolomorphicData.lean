import Lib.ClassField.HeckeCharacter.TameModulus

/-!
# Holomorphic data, functions of a level, and theta kernels modulo 𝔪 as level multipliers

This file sets up vocabulary for holomorphic automorphic functions on a unitary group over the CM
field E. It covers holomorphic data in the Fock space, adelic holomorphy, rapidly decreasing
functions of a given level, and additive characters of matrices modulo 𝔪. It also proves that
multiplication by a theta kernel `New.modKernel` preserves level N. Here the kernel's finite datum
is a function on matrices modulo 𝔪, and 𝔪 is generated by N. This needs the character `b` to have a
tame part that is trivial off the places of 𝔪.

## Main definitions and results

* `New.Rows.holomorphicData`: Fock vectors all of whose matrix coefficients on the first group are
  holomorphic of weight u. `New.Rows.prod_mem_holomorphicData` and
  `New.Rows.mem_holomorphicData_of_highestVector` give such vectors.
* `New.Rows.IsAdelicHol`: adelic functions holomorphic in the archimedean variable.
  `New.Rows.isAdelicHol_pairTheta` passes from a holomorphic vector to its theta kernel.
* `New.Rows.rapidOfLevel`: rapidly decreasing automorphic functions (members of `V.rapidFunctions`)
  of a given level. The set is closed under conjugation, and `New.Rows.mul_sum_mem_rapidOfLevel`
  treats products with linear combinations.
* `New.Rows.mul_modKernel_mem_rapidFunctions`, `New.Rows.mul_modKernel_mem_rapidOfLevel`:
  multiplying by the kernel in the first variable keeps rapid decay, and keeps the level `N` if `N`
  generates the modulus.

Notions from other files:
* `New.PairFock`: The Fock space for the signs s′_i s_j of the pair, at all infinite places.
* `New.Space`: A hermitian space over E; its automorphic functions live on the adelic group `New.G`,
  and `New.Space.IsRapid` is decay faster than every power of the height.
* `New.pairTheta`: The theta kernel θ(ω_{a,b}(g,h)f) of two hermitian spaces; `New.modKernel` is
  this kernel for the datum made of a function on matrices modulo 𝔪 and the Fock vector of a
  polynomial.
* `New.AutChar.HasWeight b e ψ`: The character b has weight e at the infinite places and tame part
  ψ, given by a character of each residue field.

## Relation to the literature

Known result: Harmonic highest vectors for (U(p,q), U(n)) give holomorphic vectors. Proves a special
case: highest vectors, such as products of leading minors, that are killed by each mixed
second derivative ∂²/∂x_{ca}∂x_{cb} with a, b of opposite signs have matrix coefficients that extend
holomorphically with an explicit weight. This hypothesis is stronger than pluriharmonic in the sense
of Kashiwara–Vergne, where only the sums over c must vanish. Source: M. Kashiwara, M. Vergne, On the
Segal–Shale–Weil representations and harmonic polynomials, Invent. Math. 44 (1978) 1–48, III 6.3,
7.2; M. G. Davidson, The harmonic representation of U(p,q) and its connection with the generalized
unit disk, Pacific J. Math. 129 (1987) 33–55.

See also `Lib.Weil.DualPair.ThetaLiftConvergence`.
-/

noncomputable section

/-!
## Holomorphic data, adelic holomorphy, functions of a level, characters

Conventions: `New.IsHolOfWeight s o u` is holomorphy of weight u for the Borel subgroup of the order
o. `New.IsPosFirstOrder s o` says that o is injective and puts the indices of sign +1 first.
`New.realPairWeil γ e` is the real Weil representation of the pair for characters of weights γ and
e.
-/

namespace New.Rows

open NumberField Matrix Norms.L2Operator MeasureTheory Fock Finset Space Submodule Int FockDualPair

variable {E n n' : Type} [Field E] [CMType E] [Fintype n]
  [DecidableEq n] (s : n → ℤˣ) [Fintype n'] [DecidableEq n']
  (s' : n' → ℤˣ) (o : n → ℤ) (u : InfinitePlace E → n → ℤ) (V : Space E n s)
  (γ e : InfinitePlace E → ℤ) (a : 𝓞 E) (F : G E s → ℂ)

/-- The additive character y ↦ ψ(tr(yu)) of matrices modulo 𝔪 attached to the matrix u, with ψ
the chosen primitive additive character of O_E/𝔪. -/
def traceChar [WeilData E] {𝔪 : Modulus E} (u : Matrix n n' 𝔪.ResidueRing)
    (y : Matrix n' n 𝔪.ResidueRing) : ℂ :=
  𝔪.primAddChar (y * u).trace

section

variable {E : Type} [Field E] [NumberField E] (s : n → ℤˣ) (s' : n' → ℤˣ) (o : n → ℤ)
  (u : InfinitePlace E → n → ℤ) (γ e : InfinitePlace E → ℤ)

/-- The coefficient `c_P(h, h') = ⟨v_P, ω(h, h') v_P⟩` of the Fock vector of a polynomial `P`, for
real points of the two groups and characters of weights `γ`, `e`. -/
def polyMatrixCoeff (γ e : InfinitePlace E → ℤ) (P : MvPolynomial (InfinitePlace E × n' × n) ℂ)
    (h : GInf E s) (h' : GInf E s') : ℂ :=
  fockInner (polyVector (realSigns E (homSigns s s')) P) (realPairWeil γ e (h, h') (polyVector _ P))

/-- The set of Fock vectors v such that x ↦ ℓ(Ω(x,1)v) is holomorphic of weight u for the
order o, for every bounded linear functional ℓ. Here Ω is `New.realPairWeil γ e`. -/
def holomorphicData : Set (PairFock E s s') :=
  {v : PairFock E s s' |
    ∀ ℓ : PairFock E s s' →L[ℂ] ℂ,
      IsHolOfWeight s o u fun x : InfinitePlace E → USign s ↦ ℓ (realPairWeil γ e (x, 1) v)}

end

variable {s}

/-- For every adelic g, the function h ↦ F(g·(h,1)) on the archimedean group is holomorphic of
weight u for the order o (`New.IsHolOfWeight`). -/
def IsAdelicHol {E : Type} [Field E] [NumberField E] [IsCMField E] (o : n → ℤ)
    (u : InfinitePlace E → n → ℤ) (F : G E s → ℂ) : Prop :=
  ∀ g : (InfinitePlace E → USign s) × Gf E n,
    IsHolOfWeight s o u fun x : InfinitePlace E → USign s ↦ F (g * (x, 1))

/-- The functions F that are continuous, left invariant under the rational points of V and right
invariant under the principal level K(a), and that decay rapidly (members of `V.rapidFunctions`). -/
def rapidOfLevel : Submodule ℂ (G E s → ℂ) :=
  V.rapidFunctions.toSubmodule ⊓
    Representation.invariants ((finRightRep E s).comp (principalLevel n a).subtype)

variable {s' o u V γ e a F}

/-- Let the second group be definite, let o put positive indices first, and let each parameter l w
order indices of equal sign as o does. Suppose that at each infinite place w the polynomial P w is a
joint highest vector (`IsJointHighest`) for the standard dual pair data `std 1 s (γ w) (-e w)`,
whose actions involve the integers γ w and −e w. That is, it is nonzero, K-highest of weight ν w on
the rows for the parameter l' w and of weight u w on the columns for −l w, and killed by each
∂²/∂x_{ca}∂x_{cb} for columns a, b of opposite signs. Then the product Q of the P w, in disjoint
sets of variables, is nonzero and its Fock vector v_Q lies in `holomorphicData s 1 o u γ e`. That
is, for every bounded linear functional ℓ, x ↦ ℓ(Ω(x,1)v_Q) is holomorphic of weight u for o, where
Ω = `realPairWeil γ e`. -/
lemma prod_mem_holomorphicData (ho : IsPosFirstOrder s o)
    {P : InfinitePlace E → MvPolynomial (n' × n) ℂ} {l' : InfinitePlace E → HCParam 1}
    {ν : InfinitePlace E → n' → ℤ} {l : InfinitePlace E → HCParam s}
    (hl_order : ∀ (w : InfinitePlace E) (a b : n), s a = s b → o a < o b → l w a < l w b)
    (hP : ∀ w : InfinitePlace E,
      (std (R := n') 1 s (γ w) (-e w)).IsJointHighest (l' w) (-l w) (P w) (ν w) (u w))
    {Q : MvPolynomial (InfinitePlace E × n' × n) ℂ}
    (hQ : Q = ∏ w : InfinitePlace E, (P w).rename fun x : n' × n ↦ (w, x)) :
    Q ≠ 0 ∧ polyVector (realSigns E (homSigns s 1)) Q ∈ holomorphicData s 1 o u γ e := by
  refine ⟨?_, fun (ℓ : PairFock E s 1 →L[ℂ] ℂ) ↦ ?_⟩
  · simp [hQ, prod_eq_zero_iff, Prod.mk_right_injective, fun w ↦ (hP w).ne_zero]
  let pair (w : InfinitePlace E) : FockDualPair s (1 : n' → ℤˣ) (n' × n) :=
    (std 1 s (γ w) (-e w)).swap
  -- `P w` is killed by all `E a b` with `o a < o b`, also when the signs of `a` and `b` differ.
  have highest (w : InfinitePlace E) :
      (toHCParam 1 (-o)).IsKHighest (pair w).oscRows (u w) (P w) := by
    obtain ⟨weight, killed⟩ := (hP w).isKHighest_cols
    refine ⟨weight, fun a b _ (h_neg_lt : -o b < -o a) ↦ ?_⟩
    have hab : o a < o b := neg_lt_neg_iff.mp h_neg_lt
    by_cases hs : s a = s b
    · exact killed a b hs (neg_lt_neg (hl_order w a b hs hab))
    -- As positive indices come first, `s a = 1` and `s b = -1`; then `E a b` is a sum of second
    -- derivatives, which vanish by `IsTermwiseHarmonic`.
    obtain ⟨ha, hb⟩ : s a = 1 ∧ s b = -1 := by
      have h_first : s b = 1 → s a = -1 → o b < o a := ho.2 b a
      grind [units_eq_one_or (s a), units_eq_one_or (s b)]
    have h_second (c : n') : MvPolynomial.pderiv (c, a) (MvPolynomial.pderiv (c, b) (P w)) = 0 :=
      (hP w).isTermwiseHarmonic_swap a b c hs
    simp [pair, swap_oscRows_E, pairSign, raiseOp, lowerOp, ne_of_apply_ne s hs, ha, hb, h_second]
  -- At each place the first group acts on Fock space by a continuous representation `ρ w` whose
  -- derivative on polynomial vectors is this action of matrices.
  let ρ (w : InfinitePlace E) :
      USign s →* fockSpace (pairSign 1 1 s) →L[ℂ] fockSpace (pairSign 1 (1 : n' → ℤˣ) s) :=
    detTwist ((pairHom (1 : n' → ℤˣ) s).comp (MonoidHom.inl (USign s) (USign 1))) (-e w)
  have rep (w : InfinitePlace E) : OscillatorRep (pair w) (ρ w) :=
    oscillatorPair_detTwist.column_rep
  -- The Fock vector of `Q` is the pure tensor of those of the `P w`, and the group acts factorwise.
  have h_factor (x : GInf E s) :
      realPairWeil γ e (x, 1) (polyVector (realSigns E (homSigns s 1)) Q) =
        piTensor fun w : InfinitePlace E ↦ ρ w (x w) (polyVector (pairSign 1 1 s) (P w)) := by
    simp [ρ, hQ, realPairWeil, pairHomInf, realWeil_piTensor, ← piTensor.map_smul_univ,
      ← piTensor_polyVector, -prod_inv_distrib]
  -- So its coefficient is a continuous multilinear form in the orbits of the highest vectors `P w`.
  simp only [h_factor]
  exact HCParam.IsKHighest.isHolOfWeight_coeffMap ho.1 highest
    (fun w ↦ (rep w).derives.isCoeffMap 1)
    (ℓ.compContinuousMultilinearMap piTensor) fun w _ ↦ (rep w).unitary_rep.1 _

/-- Let the linear map f to the Fock space intertwine the conjugate of the representation
`conjWeylRep κ e'` (on `WeylIndex n' κ → ℂ`, of highest weight given by κ, twisted by powers e′ of
the determinant; `highestVector κ l` is its highest vector for l) of the definite second group with
its Weil action, and let each l w be injective. If f of the highest vector for l is holomorphic of
weight u (in `holomorphicData`), so is every f(ξ). -/
lemma mem_holomorphicData_of_highestVector {κ : InfinitePlace E → ℕ → ℕ} {e' : InfinitePlace E → ℤ}
    {l : InfinitePlace E → n' → ℤ} {ξ : WeylIndex n' κ → ℂ}
    (f : (WeylIndex n' κ → ℂ) →ₗ[ℂ] PairFock E s 1)
    (h_inj : ∀ w : InfinitePlace E, (l w).Injective)
    (h_intertwine : ∀ (y : GInf E 1) (η : WeylIndex n' κ → ℂ),
      realPairWeil γ e (1, y) (f (star η)) = f (star (conjWeylRep (n := n') κ e' y η)))
    (h_top : f (highestVector κ l) ∈ holomorphicData s 1 o u γ e) :
    f ξ ∈ holomorphicData s 1 o u γ e := by
  -- The translates of the highest vector span the representation.
  obtain ⟨c, hc⟩ : ∃ c : GInf E 1 →₀ ℂ,
      (c.sum fun y z ↦ z • conjWeylRep κ e' y (highestVector κ l)) = star ξ :=
    Finsupp.mem_span_range_iff_exists_finsupp.1
      (eq_top_iff'.1 (span_translate_highestVector_eq_top h_inj e') (star ξ))
  intro ℓ
  -- So `f ξ` is a combination of the vectors `realPairWeil γ e (1, y) (f (highestVector κ l))`, and
  -- the two groups commute.
  have h_combination (x : GInf E s) : ℓ (realPairWeil γ e (x, 1) (f ξ)) =
      ∑ y ∈ c.support, star (c y) *
        ℓ (realPairWeil γ e (1, y) (realPairWeil γ e (x, 1) (f (highestVector κ l)))) := by
    simp [eq_star_of_eq_star hc, Finsupp.sum, ← h_intertwine, rep_apply_apply, star_highestVector]
  simp only [h_combination]
  exact IsHolOfWeight.sum (fun y ↦ star (c y)) fun y ↦ h_top (ℓ ∘L realPairWeil γ e (1, y))

/-- For automorphic characters `a`, `b` of weights γ, e (tame parts φ, ψ), a Fock vector `v` in
`holomorphicData s s' o u γ e` (so x ↦ ℓ(Ω(x,1)v) is holomorphic of weight `u` for the order
`o : n → ℤ`, for every bounded linear functional ℓ), f ∈ 𝒮(Hom(S,T)) (type `𝒮 (S.hom T)`), whose
joint datum v ⊗ f is `integrated (S.hom T) v f`, and a fixed k in the second group: the function
g ↦ `pairTheta S T a b (v ⊗ f) (g, k)` satisfies `IsAdelicHol o u`. That is, for every adelic g, the
function h ↦ θ(g·(h,1), k) on the archimedean group is holomorphic of weight `u` for the order
`o`. -/
lemma isAdelicHol_pairTheta [WeilData E] {S : Space E n s} {T : Space E n' s'} {a b : AutChar E}
    {φ ψ : (w : FinPlace E) → MulChar (ResField w) ℂ} {v : PairFock E s s'} {f : 𝒮 (S.hom T)}
    {k : G E s'} [AutChar.HasWeight a γ φ] (hv : v ∈ holomorphicData s s' o u γ e)
    [AutChar.HasWeight b e ψ] :
    IsAdelicHol o u fun g : G E s ↦ pairTheta S T a b (integrated (S.hom T) v f) (g, k) := by
  intro g
  -- A real point acts on the real datum `v` alone (`pairWeil_integrated`), so the kernel at
  -- `g * (x, 1)` is a fixed functional applied to `realPairWeil γ e (x, 1) v`.
  have h_eq (x : GInf E s) :
      pairTheta S T a b (integrated (S.hom T) v f) (g * (x, 1), k) =
        θ _ (pairWeil S T a b (g, k) (integrated (S.hom T) (realPairWeil γ e (x, 1) v) f)) := by
    simp [← pairWeil_integrated S T a b, rep_apply_apply, Prod.mk_one_one, pairTheta]
  simp only [h_eq]
  exact hv (θ _ ∘L pairWeil S T a b (g, k) ∘L (integrated _).flip f)

/-- For an element u of the archimedean group, the maximum over infinite places of the operator
norm of the matrix of u at that place. -/
abbrev maxOpNorm {E : Type} [Field E] [NumberField E] (u : GInf E s) : ℝ :=
  ‖fun w : InfinitePlace E ↦ ((u w).val : Matrix n n ℂ)‖

/-- A function has level a exactly when it is a rapidly decreasing automorphic function of V that
does not change under right translation by the principal level subgroup K(a). -/
lemma mem_rapidOfLevel_iff : F ∈ rapidOfLevel V a ↔
    F ∈ V.rapidFunctions ∧ ∀ k ∈ principalLevel n a, ∀ g : G E s, F (g * (1, k)) = F g :=
  and_congr_right' ⟨fun h k hk g ↦ congrFun (h ⟨k, hk⟩) g, fun h k ↦ funext (h k k.prop)⟩

/-- A function of level a (a member of `rapidOfLevel V a`) does not change under right translation
by an element of the principal level subgroup K(a). -/
lemma apply_mul_of_mem_rapidOfLevel (hF : F ∈ rapidOfLevel V a) :
    ∀ k ∈ principalLevel n a, ∀ g : G E s, F (g * (1, k)) = F g :=
  (mem_rapidOfLevel_iff.mp hF).2

/-- The complex conjugate of a rapidly decreasing automorphic function of level a is again one. -/
lemma star_mem_rapidOfLevel (hF : F ∈ rapidOfLevel V a) : star F ∈ rapidOfLevel V a := by
  obtain ⟨⟨aut, rapid⟩, invariant⟩ := mem_rapidOfLevel_iff.mp hF
  exact mem_rapidOfLevel_iff.mpr
    ⟨⟨aut.conj, by simpa [IsRapid] using rapid⟩, fun k hk g ↦ by simp [invariant k hk]⟩

/-- If each F · fᵢ is a rapidly decreasing automorphic function of level a, then so is the product
of F with the linear combination ∑ cᵢ fᵢ. -/
lemma mul_sum_mem_rapidOfLevel {ι : Type*} [Fintype ι] {f : ι → G E s → ℂ} {c : ι → ℂ}
    (h_mul : ∀ i : ι, F * f i ∈ rapidOfLevel V a) :
    (F * fun x : G E s ↦ ∑ i : ι, c i * f i x) ∈ rapidOfLevel V a := by
  have h_eq : (F * fun x : G E s ↦ ∑ i : ι, c i * f i x) = ∑ i : ι, c i • (F * f i) :=
    funext fun x ↦ by simp [mul_sum, mul_left_comm]
  simpa only [h_eq] using sum_smul_mem _ c fun i _ ↦ h_mul i

/-- If each F · fᵢ is a rapidly decreasing automorphic function of level a, then the integral of
F · ∑ cᵢ fᵢ over the automorphic quotient is ∑ cᵢ ∫ F · fᵢ. -/
lemma integral_mul_sum_const_mul {ι : Type*} [Fintype ι] {f : ι → G E s → ℂ} {c : ι → ℂ}
    (h_mul : ∀ i : ι, F * f i ∈ rapidOfLevel V a) :
    ∫ x : G E s, F x * ∑ i : ι, c i * f i x ∂V.quotMeasure =
      ∑ i : ι, c i * ∫ x : G E s, F x * f i x ∂V.quotMeasure := by
  have integrable (i : ι) : Integrable (fun x ↦ c i * (F * f i) x) V.quotMeasure :=
    let ⟨⟨aut, rapid⟩, _⟩ := mem_rapidOfLevel_iff.mp (h_mul i)
    (rapid.integrable aut.continuous).const_mul _
  simpa [mul_sum, mul_left_comm, ← integral_const_mul] using
    integral_finsetSum univ fun i _ ↦ integrable i

end New.Rows

/-!
## Theta kernels modulo 𝔪 as level multipliers

`modKernel S T a b 𝔪 Ψ Q` is the theta kernel of the spaces `S`, `T` and the characters `a`, `b` for
the function `Ψ` on matrices modulo `𝔪` and the Fock vector of the polynomial `Q`.
-/

namespace New.Rows

open NumberField

variable {E n n' : Type} [Field E] [CMType E] [Fintype n] [DecidableEq n] [Fintype n']
  [DecidableEq n'] [WeilData E] {s : n → ℤˣ} {s' : n' → ℤˣ} {S : Space E n s} {T : Space E n' s'}
  {a b : AutChar E} {𝔪 : Modulus E}

/-- Let the character `b` have weight `e` and tame part `ψ`, trivial at the places outside `𝔪`. Then
the theta kernel `modKernel` does not change under right translation of the first variable by an
integral finite point `k` that reduces to `1` modulo `𝔪`. -/
lemma modKernel_mul_of_reductionGL_eq_one {e : InfinitePlace E → ℤ}
    {ψ : (w : FinPlace E) → MulChar (ResField w) ℂ} (hb : AutChar.HasWeight b e ψ)
    (hψ : ∀ w : FinPlace E, w ∉ 𝔪.places → ψ w = 1) {k : stdLevel E n} (hk : 𝔪.reductionGL k = 1)
    (Ψ : Matrix n' n 𝔪.ResidueRing → ℂ) (Q : MvPolynomial (InfinitePlace E × n' × n) ℂ)
    (g : G E s) (h : G E s') :
    modKernel S T a b 𝔪 Ψ Q (g * (1, k.val)) h = modKernel S T a b 𝔪 Ψ Q g h := by
  -- Such a `k` changes neither `Ψ` nor the factor given by `b`.
  have h_char : (b.val (detFin s k.val) : ℂ) = 1 := by
    simp [hb.apply_det_eq_charOfTamePart hψ k, hk]
  simp [modKernel_mul_stdLevel_left S T a b 𝔪 k, h_char, hk]

/-- Let the character `b` have weight `e` and tame part `ψ`, trivial at the places outside `𝔪`. If
`F` is a rapidly decreasing automorphic function, then so is the product of `F` with the theta
kernel `g ↦ modKernel S T a b 𝔪 Ψ Q g h`. -/
lemma mul_modKernel_mem_rapidFunctions {F : G E s → ℂ} {e : InfinitePlace E → ℤ}
    {ψ : (w : FinPlace E) → MulChar (ResField w) ℂ} (hb : AutChar.HasWeight b e ψ)
    (hψ : ∀ w : FinPlace E, w ∉ 𝔪.places → ψ w = 1) (hF : F ∈ S.rapidFunctions)
    (Ψ : Matrix n' n 𝔪.ResidueRing → ℂ) (Q : MvPolynomial (InfinitePlace E × n' × n) ℂ)
    (h : G E s') :
    (F * fun g : G E s ↦ modKernel S T a b 𝔪 Ψ Q g h) ∈ S.rapidFunctions := by
  obtain ⟨hF_aut, hF_rapid⟩ := hF
  have h_aut : S.IsAutomorphic fun g : G E s ↦ modKernel S T a b 𝔪 Ψ Q g h := by
    -- The kernel is invariant under the open group of points that are `1` modulo `𝔪`.
    refine ⟨by fun_prop [modKernel], (pairThetaKer S T a b).theta_rat_mul,
      ⟨𝔪.levelOfSubgroup ⊥, IsLevel.isOpen⟩, ?_⟩
    rintro _ ⟨k, hk : 𝔪.reductionGL k = 1, rfl⟩ g
    exact modKernel_mul_of_reductionGL_eq_one hb hψ hk Ψ Q g h
  -- `F` decays rapidly and the kernel is of moderate growth.
  refine ⟨hF_aut.map₂ h_aut fun x y ↦ x * y, ?_⟩
  rw [mul_comm]
  exact hF_rapid.mul ((pairThetaKer S T a b).isModerate _ h)

/-- Let `𝔪` be the modulus generated by `N`, and let the character `b` have weight `e` and tame part
`ψ`, trivial at the places outside `𝔪`. If `F` is a rapidly decreasing automorphic function of
level `N`, then so is the product of `F` with the theta kernel `g ↦ modKernel S T a b 𝔪 Ψ Q g h`. -/
lemma mul_modKernel_mem_rapidOfLevel {N : 𝓞 E} {F : G E s → ℂ} (h𝔪 : 𝔪.ideal = Ideal.span {N})
    {e : InfinitePlace E → ℤ} {ψ : (w : FinPlace E) → MulChar (ResField w) ℂ}
    [hb : AutChar.HasWeight b e ψ] (hψ : ∀ w : FinPlace E, w ∉ 𝔪.places → ψ w = 1)
    (hF : F ∈ rapidOfLevel S N) (Ψ : Matrix n' n 𝔪.ResidueRing → ℂ)
    (Q : MvPolynomial (InfinitePlace E × n' × n) ℂ) (h : G E s') :
    (F * fun g : G E s ↦ modKernel S T a b 𝔪 Ψ Q g h) ∈ rapidOfLevel S N := by
  obtain ⟨hF_rapid, hF_level⟩ := mem_rapidOfLevel_iff.mp hF
  refine mem_rapidOfLevel_iff.mpr
    ⟨mul_modKernel_mem_rapidFunctions hb hψ hF_rapid Ψ Q h, fun k hk g ↦ ?_⟩
  -- An element of level `N` is integral and reduces to `1` modulo `𝔪`.
  have h_red : 𝔪.reductionGL ⟨k, hk.1⟩ = 1 := (𝔪.mem_principalLevel_iff h𝔪 _).mp hk
  simp [hF_level k hk, modKernel_mul_of_reductionGL_eq_one hb hψ h_red]

end New.Rows
end
