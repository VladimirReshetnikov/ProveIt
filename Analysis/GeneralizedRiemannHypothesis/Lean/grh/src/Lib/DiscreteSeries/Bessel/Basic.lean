import Lib.DiscreteSeries.Bruhat.FloorMeasures
import Lib.DiscreteSeries.Haar.CayleyChart

/-!
# The real unitary group G₁, unipotent coordinates and Bessel functions

The form `(𝔰.middleGram N).splitGram` on the space Y₀ of column vectors indexed by `𝔰.BesselIndex`
is the sum of ϱ hyperbolic planes, the identity form on X₀ = A^κ and a line of norm −N. Its
archimedean version is the complex form `New.Shape.J₁`, whose space has basis `e_a`, `x_i`, `z`,
`e*_a` with `h(z, z) = -1` for the hermitian form `h`, and frame `e_0, …, e_{ϱ-1}, z`. The file
embeds the unitary group of X₀ in U(Y₀) and in `G₁`. It gives explicit elements of the unipotent
groups 𝖴⁰ = `New.Shape.Form.besselU0` and 𝖴 = `New.Shape.Form.besselU`, and measures on them. It
then defines Bessel functions on `G₁`.

## Main definitions and results

* `New.exists_besselU_mul_toBesselH`: for N a unit, a coefficient ring with an element of trace one
  and an invertible hermitian form, every element of `besselS` is a product `u h` with `u` in
  `besselU` and `h` in the image of `New.toBesselH`.
* `New.Shape.G₁`, `New.Shape.J₁`: the group and its form.
* `New.RealPlace.unipotentOf`, `New.RealPlace.mem_besselU0_iff_unipotentOf`: a parametrization of
  the unipotent group `New.Shape.Form.besselU0` that fixes the frame.
* `New.RealPlace.embedH`: the unitary group of the `x_i` inside `G₁`.
* `New.Shape.besselHaar₀`, `New.Shape.besselHaar`: measures on 𝖴⁰ and 𝖴, pushed forward from
  Lebesgue measure on the parameters and, for 𝖴, from its product with the measure on 𝖴⁰.
* `New.IsBesselFunction`: bounded measurable functions that transform by a character under the
  unipotent group `New.Shape.Form.besselU` and by `rep` under `U(κ)`.

Notions from other files:
* `New.Shape.Form.splitGram T`: the Gram matrix of ϱ hyperbolic planes and a middle space with Gram
  matrix T. Identity blocks pair the first and last ϱ indices, T is the middle block, and all other
  entries are zero.
* `New.inclMatrix`: for a map u : m → n of index sets, the n×m matrix whose j-th column is the
  standard basis vector e_{u(j)}.
* `New.frameMatrix`: the square submatrix on the rows and columns of the frame.
* `New.Shape.Form.besselS`: the Bessel subgroup, generated by the unipotent group 𝖴 =
  `New.Shape.Form.besselU` and the fixer H = `New.Shape.Form.besselH` of the basis vectors that
  are not indexed by κ.

## Relation to the literature

Known; see `Lib.DiscreteSeries.Bruhat.FloorGroups`, `Lib.DiscreteSeries.Bessel.UnipotentHaarMeasure`
and `Lib.DiscreteSeries.Bruhat.ComplexPlace` for sources.
-/

noncomputable section

/-!
## The embedding of U(X₀) in U(Y₀) and its image H

The form `(𝔰.middleGram N).splitGram` on Y₀ is ϱ hyperbolic planes plus the identity form on
X₀ = A^κ plus a line of norm −N. H is the group `New.Shape.Form.besselH` of isometries that fix the
basis vectors not indexed by κ.

* `New.toBesselH`: the extension of a unitary κ × κ matrix by the identity.
-/

namespace New

variable {A : Type _} [CommRing A] [StarRing A] {𝔰 : Shape} {N : A}

open Matrix Floors FloorGroups

/-- The embedding of the unitary group of the identity form on X₀ = A^κ into the unitary group
`(𝔰.middleGram N).G`, acting on X₀ and fixing the other basis vectors. -/
@[local simp, simps! -isSimp apply_coe_val]
noncomputable def toBesselH (𝔰 : Shape) (N : A) : U (1 : Matrix 𝔰.κ 𝔰.κ A) →* (𝔰.middleGram N).G :=
  ((Units.map
        { toFun m := fromBlocks 1 0 0 ((m.fromBlocks 0 0 1).fromBlocks 0 0 1)
          map_one' := by simp
          map_mul' := by simp [fromBlocks_multiply] }).comp
      (U 1).subtype).codRestrict (𝔰.middleGram N).G
    -- `↓` unfolds membership in the unitary group before the group itself is simplified.
    (by simp [↓mem_U, middleGram, fromBlocks_conjTranspose, splitGram, fromBlocks_multiply,
      fromBlocks_mul_fromRows, fromCols_mul_fromBlocks])

@[simp]
lemma toBesselH_mem (u : U (1 : Matrix 𝔰.κ 𝔰.κ A)) : toBesselH 𝔰 N u ∈ besselH := by
  -- In the columns not indexed by κ the block matrix agrees with the identity.
  refine mem_floorGroup.2 ?_
  rintro i (b | (k | ⟨⟩) | b) h_floor
  case inr.inl.inl => simp at h_floor
  all_goals rcases i with a | (l | ⟨⟩) | a <;> simp [Matrix.one_apply]

/-- Let `(𝔰.middleGram N).G` be the unitary group of the form made of ϱ hyperbolic planes, the
identity form on X₀ = A^κ and a line of norm −N. If N is a unit, every element of
H = `New.Shape.Form.besselH`, the fixer of the basis vectors outside X₀, is the extension
`New.toBesselH` of a unitary κ × κ matrix by the identity. -/
lemma exists_eq_toBesselH {h : (𝔰.middleGram N).G} (hh : h ∈ besselH) (hN : IsUnit N) :
    ∃ u : U (1 : Matrix 𝔰.κ 𝔰.κ A), h = toBesselH 𝔰 N u := by
  -- `h` differs from the identity only in the columns `𝔰.indexX₀ a`, at the rows `𝔰.indexX₀ b` and
  -- the row of the extra basis vector `z`. It preserves the form, so these columns are orthogonal
  -- to `z` (of norm `-N`, a unit) and orthonormal.
  let m : Matrix 𝔰.κ 𝔰.κ A := h.val.val.submatrix 𝔰.indexX₀ 𝔰.indexX₀
  have h_form : h.val.valᴴ * (𝔰.middleGram N).splitGram * h.val.val =
      (𝔰.middleGram N).splitGram := mem_U.1 h.property
  have h_row (a : 𝔰.κ) : h.val.val 𝔰.z (𝔰.indexX₀ a) = 0 := hN.mul_right_eq_zero.1 <| by
    simpa [apply_eq_one_apply_of_mem_floorGroup hh, middleGram, splitGram, Matrix.mul_apply,
      Matrix.one_apply]
      using congr_fun₂ h_form 𝔰.z (𝔰.indexX₀ a)
  have h_unitary : mᴴ * 1 * m = 1 := by
    ext a b
    simpa [m, apply_eq_one_apply_of_mem_floorGroup hh, h_row, middleGram, splitGram,
      Matrix.mul_apply, Matrix.one_apply]
      using congr_fun₂ h_form (𝔰.indexX₀ a) (𝔰.indexX₀ b)
  use U.of (by simp) m h_unitary
  ext : 2
  simp [m, apply_eq_one_apply_of_mem_floorGroup hh, h_row, ← ext_iff, Matrix.one_apply]

/-- Assume that A has a chosen element of trace one, that the form `(𝔰.middleGram N).splitGram` (ϱ
hyperbolic planes, the identity form on X₀ = A^κ and a line of norm −N) is hermitian and invertible,
and that N is a unit. In its unitary group, the Bessel subgroup `besselS` is generated by the
unipotent group `besselU` and by the fixer of the basis vectors outside X₀. Every element of it is
a product `u * New.toBesselH 𝔰 N g`, with `u` in `besselU` and `g` a unitary κ × κ matrix, which
`New.toBesselH` extends by the identity. -/
lemma exists_besselU_mul_toBesselH [TraceOne A] [IsHermitianUnit (𝔰.middleGram N).splitGram]
    {s : (𝔰.middleGram N).G} (hs : s ∈ besselS) (hN : IsUnit N) :
    ∃ u ∈ besselU, ∃ g : U (1 : Matrix 𝔰.κ 𝔰.κ A), s = u * toBesselH 𝔰 N g := by
  obtain ⟨u, hu, h, hh, rfl⟩ := mem_besselS.1 hs
  obtain ⟨g, rfl⟩ := exists_eq_toBesselH hh hN
  exact ⟨u, hu, g, rfl⟩

/-- Assume that A has a chosen element of trace one, and that N is a unit. Let `𝔰.middleGram N` be
the diagonal matrix with entries 1 on κ and −N at the extra point, and assume its split form
`(𝔰.middleGram N).splitGram` is hermitian and invertible; this split form is the Gram matrix of ϱ
hyperbolic planes plus that middle block. For `a < ϱ` and a row `r` that vanishes at the columns
`c ≤ a`, some `u` in the Bessel unipotent group `besselU` has `frameMatrix u` equal to the identity
matrix plus `r` in row `a`; here `besselU` consists of the isometries of the split form that are
block upper unitriangular for the Bessel levels, and `frameMatrix u` is the submatrix of `u` on the
frame (e_0, …, e_{ϱ-1}, z). -/
lemma exists_mem_besselU_frameMatrix_eq_one_add_row {A : Type} [CommRing A] [StarRing A]
    [TraceOne A] {N : A} [IsHermitianUnit (𝔰.middleGram N).splitGram] (hN : IsUnit N) (a : Fin 𝔰.ϱ)
    (r : Fin (𝔰.ϱ + 1) → A) (hr_zero : ∀ c : Fin (𝔰.ϱ + 1), c ≤ a.castSucc → r c = 0) :
    ∃ u ∈ (𝔰.middleGram N).besselU,
      frameMatrix u = 1 + vecMulVec (Pi.single a.castSucc 1) r := by
  -- The Heisenberg element of floor `a` with vector `v` acts on the frame `f` by `1` minus the row
  -- `h(v, f_c)` in row `a`. Take `v` equal to `-r̄_c` at `e*_c` and to `r̄_ϱ / N̄` at `z`, since
  -- `h(e*_c, e_c) = 1` and `h(z, z) = -N`.
  let v : 𝔰.BesselIndex → A
    | Sum.inr (Sum.inr c) => -star (r c.castSucc)
    | Sum.inr (Sum.inl (Sum.inr _)) => star (r (Fin.last 𝔰.ϱ) * ↑hN.unit⁻¹)
    | _ => 0
  -- `v` vanishes on the floors at most `a`, so it is a vector of the floors at least `a + 1`.
  have hv_floor (i : 𝔰.BesselIndex) (hi : ¬ (a : ℕ) + 1 ≤ floorOf i) : v i = 0 := by
    rcases i with c | (k | ⟨⟩) | c <;> simp [floorOf, v] at hi ⊢
    have hc : c ≤ a := Fin.le_def.2 (by omega)
    simp [hr_zero _ (Fin.castSucc_le_castSucc_iff.2 hc)]
  have h_incl : inclMatrix A (Subtype.val : {i : 𝔰.BesselIndex // (a : ℕ) + 1 ≤ floorOf i} →
      𝔰.BesselIndex) *ᵥ (fun i ↦ v i.val) = v := by
    grind [inclMatrix_val_mulVec]
  -- The column of the form at `z` is `-N` at `z`.
  have h_col : (𝔰.middleGram N).splitGram.col 𝔰.z = Pi.single 𝔰.z (-N) := by
    ext i
    rcases i with b | (k | ⟨⟩) | b <;> simp [splitGram, middleGram, Floors.hyperbolicGram]
  have h_row (c : Fin (𝔰.ϱ + 1)) :
      star v ⬝ᵥ (𝔰.middleGram N).splitGram *ᵥ Pi.single (𝔰.besselFrame c) 1 = -r c := by
    induction c using Fin.lastCases with
    | last => simp [besselFrame_top, h_col, v, mul_assoc]
    | cast c => simp [besselFrame_castSucc, splitGram_col (Sum.inl c), v]
  refine ⟨TraceOne.heisenbergElem a (fun i ↦ v i.val, 0),
    unipotentBelow_le_besselU (heisenbergElem_mem_floorUnipotent a (fun i ↦ v i.val, 0)).2, ?_⟩
  rw [frameMatrix_heisenbergElem, ← sub_neg_eq_add, ← vecMulVec_neg]
  congr! with c
  simpa [h_incl] using h_row c

/-- Make three assumptions. First, `A` is a commutative ring with involution and a chosen `τ` with
`τ + τ̄ = 1`. Second, the form `(𝔰.middleGram N).splitGram` is hermitian and invertible; this form
consists of ϱ hyperbolic planes, the identity form on X₀ = A^κ and a line of norm −N. Third, `N` is
a unit. Then every upper unitriangular matrix `M` of size ϱ + 1 equals `frameMatrix u` for some `u`
in `besselU`. Here `besselU` is the group of isometries of this form that are block upper
unitriangular for the levels `New.BesselIndex.level`, so their middle diagonal block is the
identity. `frameMatrix u` is the square submatrix of `u` on the rows and columns of the frame
(e_0, …, e_{ϱ-1}, z). -/
lemma exists_mem_besselU_frameMatrix_eq {A : Type} [CommRing A] [StarRing A] [TraceOne A]
    {N : A} [IsHermitianUnit (𝔰.middleGram N).splitGram] (hN : IsUnit N)
    {M : Matrix (Fin (𝔰.ϱ + 1)) (Fin (𝔰.ϱ + 1)) A}
    (hM_unitri : ∀ a b : Fin (𝔰.ϱ + 1), b ≤ a →
      M a b = (1 : Matrix (Fin (𝔰.ϱ + 1)) (Fin (𝔰.ϱ + 1)) A) a b) :
    ∃ u ∈ (𝔰.middleGram N).besselU, frameMatrix u = M := by
  -- Let `truncated k` be `M` with its rows of index below `k` replaced by those of `1`. Going from
  -- `k + 1` down to `k` multiplies on the right by a matrix that differs from `1` in row `k` only.
  let truncated (k : ℕ) : Matrix (Fin (𝔰.ϱ + 1)) (Fin (𝔰.ϱ + 1)) A :=
    of fun i c ↦ if k ≤ (i : ℕ) then M i c else (1 : Matrix _ _ A) i c
  have h_split (a : Fin 𝔰.ϱ) : truncated a = truncated (a + 1) *
      (1 + vecMulVec (Pi.single a.castSucc 1) (M a.castSucc - Pi.single a.castSucc 1)) := by
    have h_col : (truncated (a + 1)).col a.castSucc = Pi.single a.castSucc 1 := by
      funext i
      grind [col_apply, of_apply, Matrix.one_apply, Fin.le_def, Fin.val_castSucc]
    rw [Matrix.mul_add, Matrix.mul_one, mul_vecMulVec, mulVec_single_one, h_col]
    ext i c
    grind [Matrix.add_apply, of_apply, vecMulVec_apply, Matrix.one_apply, Pi.sub_apply]
  have h_all (k : ℕ) (hk : k ≤ 𝔰.ϱ) :
      ∃ u ∈ (𝔰.middleGram N).besselU, frameMatrix u = truncated k := by
    induction hk using Nat.decreasingInduction with
    | self =>
      -- The last row of `M` is that of `1`, so `truncated ϱ = 1`.
      have h_top : truncated 𝔰.ϱ = 1 := by
        ext i c
        grind [of_apply, Fin.le_def]
      exact ⟨1, one_mem _, by
        simp [h_top, frameMatrix, ← ext_iff, one_apply, besselFrame_injective.eq_iff]⟩
    | of_succ k hk ih =>
      obtain ⟨u, hu, hu_frame⟩ := ih
      let a : Fin 𝔰.ϱ := ⟨k, hk⟩
      obtain ⟨x, hx, hx_frame⟩ := exists_mem_besselU_frameMatrix_eq_one_add_row hN a
        (M a.castSucc - Pi.single a.castSucc 1) fun c hc ↦ by
          simp [hM_unitri _ c hc, one_apply, Pi.single_apply, eq_comm]
      exact ⟨u * x, mul_mem hu hx, by rw [frameMatrix_mul hx, hu_frame, hx_frame, ← h_split a]⟩
  simpa [truncated, ← Matrix.ext_iff] using h_all 0 (Nat.zero_le _)

end New

/-!
## The real group G₁, frame and column matrices, free-entry coordinates

Definitions for the archimedean group `New.Shape.G₁`, the unitary group of the complex form
`New.Shape.J₁`. Its basis is `e_a`, `x_i`, `z`, `e*_a`, indexed by `New.Shape.BesselIndex`, also
written `SplitIndex 𝔰.ϱ 𝔰.MiddleIndex` or `Fin 𝔰.ϱ ⊕ 𝔰.MiddleIndex ⊕ Fin 𝔰.ϱ`, as `inl a`,
`inr (inl (inl i))`, `inr (inl (inr ()))`, `inr (inr a)`. The frame `New.Shape.besselFrame` is
`(f_0, …, f_ϱ) = (e_0, …, e_{ϱ-1}, z)`.
-/

section RealFrame

open Matrix

namespace New.Shape

variable (𝔰 : Shape)

/-! ### The group -/

/-- The unitary group of the complex hermitian form made of ϱ hyperbolic planes, the standard
positive form on κ, and one vector z with h(z, z) = −1. -/
abbrev G₁ : Subgroup (GL 𝔰.BesselIndex ℂ) := (𝔰.middleGram (1 : ℂ)).G

/-- The space of (ϱ+1)×(ϱ+1) complex matrices. -/
abbrev FrameMatrix : Type := Matrix (Fin (𝔰.ϱ + 1)) (Fin (𝔰.ϱ + 1)) ℂ

/-! ### The form, the column matrices of the basis vectors, parameters of unipotents -/

/-- The Gram matrix of the hermitian form defining G₁: ϱ hyperbolic pairs e_a, e*_a, the
identity on X₀, and h(z, z) = −1. -/
abbrev J₁ : Matrix 𝔰.BesselIndex 𝔰.BesselIndex ℂ := (𝔰.middleGram (1 : ℂ)).splitGram

/-- The matrix whose ϱ+1 columns are the basis vectors of the frame (e_0, …, e_{ϱ-1}, z). -/
abbrev frameCols : Matrix 𝔰.BesselIndex (Fin (𝔰.ϱ + 1)) ℂ := inclMatrix ℂ 𝔰.besselFrame

/-- The matrix with ϱ+1 columns, the basis vectors e*_0, …, e*_{ϱ-1} and x_{k₀}, where k₀ = `𝔰.k₀`
is the distinguished index in κ. -/
abbrev dualFrameCols : Matrix (SplitIndex 𝔰.ϱ 𝔰.MiddleIndex) (Fin (𝔰.ϱ + 1)) ℂ :=
  inclMatrix ℂ (Fin.snoc eStar (𝔰.indexX₀ 𝔰.k₀))

/-- The matrix with ϱ columns, the basis vectors e_0, …, e_{ϱ-1}. -/
abbrev isotropicCols : Matrix (Fin 𝔰.ϱ ⊕ 𝔰.MiddleIndex ⊕ Fin 𝔰.ϱ) (Fin 𝔰.ϱ) ℂ :=
  inclMatrix ℂ (Sum.inl : Fin 𝔰.ϱ → 𝔰.BesselIndex)

/-- The matrix whose columns, indexed by κ, are the basis vectors x_i of X₀. -/
abbrev definiteCols : Matrix 𝔰.BesselIndex 𝔰.κ ℂ := inclMatrix ℂ 𝔰.indexX₀

/-- The matrix with ϱ columns, the basis vectors e*_0, …, e*_{ϱ-1}. -/
abbrev dualCols : Matrix (SplitIndex 𝔰.ϱ 𝔰.MiddleIndex) (Fin 𝔰.ϱ) ℂ :=
  inclMatrix ℂ (eStar : Fin 𝔰.ϱ → 𝔰.BesselIndex)

/-- The one-column matrix whose column is the basis vector z. -/
abbrev zCol : Matrix 𝔰.BesselIndex Unit ℂ := inclMatrix ℂ fun _ : Unit ↦ 𝔰.z

/-- The space of pairs consisting of a complex ϱ×κ matrix and a real ϱ×ϱ matrix. -/
abbrev UnipotentParams : Type := Matrix (Fin 𝔰.ϱ) 𝔰.κ ℂ × Matrix (Fin 𝔰.ϱ) (Fin 𝔰.ϱ) ℝ

end Shape

variable {j : ℕ} {𝔰 : Shape}

/-- For y in G₁, the a-th vector y⁻¹f_a of the frame moved by y⁻¹, as a vector of the standard
Euclidean space. -/
def frameVector (y : 𝔰.G₁) (a : Fin (𝔰.ϱ + 1)) : EuclideanSpace ℂ 𝔰.BesselIndex :=
  WithLp.toLp 2 fun i : 𝔰.BesselIndex ↦ y⁻¹.1 i (𝔰.besselFrame a)

/-- For y∈G₁, the (ϱ+1)×(ϱ+1) complex matrix Z(y) of products h(f_j, y f_l) of the frame with
its translate. -/
abbrev realFrameGram (y : 𝔰.G₁) : Matrix (Fin (𝔰.ϱ + 1)) (Fin (𝔰.ϱ + 1)) ℂ :=
  (𝔰.middleGram 1).frameGram y.val.val

namespace RealPlace

/-- Coordinates on matrices, as a continuous `ℝ`-linear map. For a set `p` of positions `(a, i)`,
a matrix `M` goes to its complex entries in row `e_a` and column `i` for `(a, i)` in `p`,
together with the imaginary parts of its entries in row `e_a` and column `e*_a`. -/
@[simps apply_fst apply_snd]
def freeEntries (p : Fin 𝔰.ϱ × 𝔰.BesselIndex → Prop) :
    Matrix 𝔰.BesselIndex 𝔰.BesselIndex ℂ →L[ℝ] (Subtype p → ℂ) × (Fin 𝔰.ϱ → ℝ) where
  toFun M := (fun x : Subtype p ↦ M (Sum.inl x.val.1) x.val.2,
    fun a : Fin 𝔰.ϱ ↦ (M (Sum.inl a) (eStar a)).im)
  map_add' := by simp [funext_iff]
  map_smul' := by simp [funext_iff]

/-- The positions (a, i), meaning row `e_a` and column i, of the complex coordinates of the
frame-fixing unipotent group. The predicate is false for the columns `e_b` and `z` of the frame. It
is true for the columns indexed by `κ`. For the column `e*_b` it says `a < b`. It differs from
`New.RealPlace.IsFreeEntry` by leaving out the columns of the frame. -/
@[simp]
def IsFreeEntry₀ (x : Fin 𝔰.ϱ × 𝔰.BesselIndex) : Prop :=
  (∃ i : 𝔰.κ, x.2 = 𝔰.indexX₀ i) ∨ ∃ b > x.1, x.2 = eStar b

/-- The positions (a, i) with row e_a and column e_b or e*_b for b > a, or any column of the middle
block. -/
def IsFreeEntry : Fin 𝔰.ϱ × 𝔰.BesselIndex → Prop
  | (a, Sum.inl b) | (a, eStar b) => a < b
  | (_, Sum.inr (Sum.inl _)) => True

attribute [simp] IsFreeEntry.eq_1 IsFreeEntry.eq_2 IsFreeEntry.eq_3

/-- The matrix 1 − CCᴴ + ChCᴴ; for orthonormal columns C it acts by h on their span and fixes
the orthogonal complement. -/
def actOnCols {m : Type*} [Fintype m] (C : Matrix 𝔰.BesselIndex m ℂ) (h : Matrix m m ℂ) :
    Matrix 𝔰.BesselIndex 𝔰.BesselIndex ℂ :=
  1 - C * Cᴴ + C * h * Cᴴ

/-! ### Upper unitriangular matrices, and properties of `J₁` -/

/-- The space of complex families indexed by the pairs a < b among j indices: the entries of a
j×j matrix strictly above the diagonal. -/
abbrev UpperEntries (j : ℕ) : Type := {p : Fin j × Fin j // p.1 < p.2} → ℂ

/-- The upper unitriangular j×j complex matrix whose entries above the diagonal are the given
family x. -/
def unitriangularMatrix (x : UpperEntries j) : Matrix (Fin j) (Fin j) ℂ :=
  of fun a b : Fin j ↦ if h : a < b then x ⟨(a, b), h⟩ else if a = b then 1 else 0

@[fun_prop]
lemma continuous_unitriangularMatrix :
    Continuous (unitriangularMatrix : UpperEntries j → Matrix (Fin j) (Fin j) ℂ) := by
  unfold unitriangularMatrix
  continuity

/-- The Gram matrix `New.Shape.J₁` is a hermitian involution. -/
instance isHermitianInvolution_J₁ : IsHermitianInvolution 𝔰.J₁ where
  isHermitian := ext <| by simp [eq_comm, splitGram, middleGram, Matrix.one_apply]
  mul_self := ext <| by simp [eq_comm, splitGram, middleGram, mul_apply, Matrix.one_apply]

/-- The Gram matrix `New.Shape.J₁` is hermitian and invertible. -/
instance : Floors.IsHermitianUnit 𝔰.J₁ where
  conjTranspose_eq := IsHermitianInvolution.isHermitian
  isUnit := IsHermitianInvolution.isUnit

end RealPlace

end New

end RealFrame

/-!
## Explicit elements of 𝖴⁰, H and 𝖴 in G₁

Explicit matrices for subgroups of the unitary group `New.Shape.G₁` of the form `New.Shape.J₁`, with
basis `e_a`, `x_i`, `z`, `e*_a`.

* `New.RealPlace.liftUnitriangular`: an element of `New.Shape.Form.besselU` with a given
  unitriangular block on the frame.
-/

section UnipotentCoords

namespace New.RealPlace

open Matrix CStarRing Norms.L2Operator Floors MeasureTheory Fin FloorGroups

variable {𝔰 : Shape} {l m n o : Type} [Fintype n] [DecidableEq n]
  {e : m → n} {e' : l → n} {M : Matrix m o ℂ}

/-! ### Matrices of basis columns -/

/-- Two families of basis columns with no common index are orthogonal. -/
theorem inclMatrix_gram_eq_zero (h_ne : ∀ (i : l) (j : m), e' i ≠ e j) :
    (inclMatrix ℂ e')ᴴ * inclMatrix ℂ e = 0 := by
  aesop (add simp [inclMatrix, Matrix.mul_apply, Matrix.one_apply])

/-- The basis columns selected by an injective map are orthonormal. -/
lemma inclMatrix_gram_eq_one [DecidableEq m] (h_inj : ∀ i j : m, e i = e j → i = j) :
    (inclMatrix ℂ e)ᴴ * inclMatrix ℂ e = 1 := by
  aesop (add simp [inclMatrix, Matrix.mul_apply, Matrix.one_apply])

variable [Fintype m]

omit [DecidableEq n] in
/-- A known product `A * B = C` can be rewritten inside the right-associated product
`A * (B * M)`. -/
theorem mul_mul_eq_of_mul_eq {A : Matrix l n ℂ} {B : Matrix n m ℂ} {C : Matrix l m ℂ}
    (h_mul : A * B = C) : A * (B * M) = C * M := by
  rw [← Matrix.mul_assoc, h_mul]

/-- A product with basis columns `e` is orthogonal to basis columns `e'` with no common index. -/
lemma inclMatrix_gram_mul_eq_zero (h_ne : ∀ (i : l) (j : m), e' i ≠ e j) :
    (inclMatrix ℂ e')ᴴ * (inclMatrix ℂ e * M) = 0 := by
  rw [mul_mul_eq_of_mul_eq (inclMatrix_gram_eq_zero h_ne), Matrix.zero_mul]

/-- If the index map `e` is injective, the conjugate transpose of `inclMatrix ℂ e`, the matrix whose
`j`-th column is the standard basis vector at `e j`, cancels it on the left. -/
theorem inclMatrix_gram_mul_eq_self (h_inj : ∀ i j : m, e i = e j → i = j) :
    (inclMatrix ℂ e)ᴴ * (inclMatrix ℂ e * M) = M := by
  classical rw [← Matrix.mul_assoc, inclMatrix_gram_eq_one h_inj, Matrix.one_mul]

/-- The inclusion matrix of an injective map of indices has operator norm at most one. -/
theorem norm_inclMatrix_le_one {m n : Type} [Fintype m] [DecidableEq m] [Fintype n]
    [DecidableEq n] {e : n → m} (h_inj : e.Injective) : ‖inclMatrix ℂ e‖ ≤ 1 := by
  -- `‖inclMatrix ℂ e‖ ^ 2` is the norm of `(inclMatrix ℂ e)ᴴ * inclMatrix ℂ e = 1`.
  refine le_of_sq_le_sq ?_ zero_le_one
  simp [sq, ← l2_opNorm_conjTranspose_mul_self, inclMatrix_gram_eq_one h_inj,
    IsStarProjection.norm_le]

/-- The Gram matrix in terms of basis columns: `e_a` pairs with `e*_a`, the `x_i` are orthonormal
and `z` has square `-1`. -/
theorem J₁_eq :
    𝔰.J₁ = 𝔰.isotropicCols * 𝔰.dualColsᴴ + 𝔰.dualCols * 𝔰.isotropicColsᴴ +
        𝔰.definiteCols * 𝔰.definiteColsᴴ - 𝔰.zCol * 𝔰.zColᴴ := by
  aesop (add simp [inclMatrix, Matrix.mul_apply, Matrix.one_apply])

/-! ### The explicit elements -/

/-- For q = (a, b) with a complex ϱ×κ and b real ϱ×ϱ, the isometry 1 + XaWᴴ − WaᴴDᴴ + X(sk
b − ½aaᴴ)Dᴴ. Here X, W, D have columns e_i, x_i, e*_i, and sk is `New.skewOfReal`, which makes a
skew-hermitian matrix from a real one. -/
def unipotentOf (q : 𝔰.UnipotentParams) : 𝔰.G₁ :=
  U.of IsHermitianUnit.isUnit
      (1 + 𝔰.isotropicCols * q.1 * 𝔰.definiteColsᴴ - 𝔰.definiteCols * q.1ᴴ * 𝔰.dualColsᴴ +
        𝔰.isotropicCols * (skewOfReal q.2 - (2⁻¹ : ℂ) • (q.1 * q.1ᴴ)) * 𝔰.dualColsᴴ) <| by
    -- Expand with `J₁_eq` and the orthogonality relations of the columns.
    simp [Matrix.mul_assoc, Matrix.mul_sub, Matrix.sub_mul, J₁_eq, Matrix.mul_add,
      Matrix.add_mul, inclMatrix_gram_mul_eq_self, inclMatrix_gram_mul_eq_zero]
    module

/-- For h in the unitary group U(κ), the element of G₁ acting as h on X₀ and as the identity on
the other basis vectors. -/
abbrev embedH (h : U (1 : Matrix 𝔰.κ 𝔰.κ ℂ)) : (𝔰.middleGram (1 : ℂ)).G := (toBesselH 𝔰 1 h : 𝔰.G₁)

/-- Left multiplication by `embedH h`, the unitary matrix that acts by h on the span of the `x_i`
and fixes the other basis vectors, preserves the L² operator norm. -/
lemma norm_embedH_mul {u : 𝔰.G₁} (h : U (1 : Matrix 𝔰.κ 𝔰.κ ℂ)) :
    ‖(embedH h * u).val.val‖ = ‖u.val.val‖ := by
  refine norm_mem_unitary_mul (U := (embedH h).val.val) _ ?_
  simp [unitary, star, ← U.inv_val_eq_conjTranspose, val_toBesselH_apply_coe,
    fromBlocks_conjTranspose, fromBlocks_multiply]

/-- The lift to G₁ of the upper unitriangular matrix `New.RealPlace.unitriangularMatrix` x of size
ϱ+1: an explicit isometry acting by this matrix on the frame e_0, …, e_{ϱ-1}, z and fixing X₀. -/
def liftUnitriangular (x : UpperEntries 𝔰.n) : 𝔰.G₁ :=
  -- the last column `v` and the upper left block `a` of the unitriangular matrix
  let v : Matrix (Fin 𝔰.ϱ) Unit ℂ := (unitriangularMatrix x).submatrix castSucc fun _ : Unit ↦ 𝔰.top
  let a : Matrix (Fin 𝔰.ϱ) (Fin 𝔰.ϱ) ℂ := (unitriangularMatrix x).submatrix castSucc castSucc
  U.of IsHermitianUnit.isUnit
      (𝔰.definiteCols * 𝔰.definiteColsᴴ + 𝔰.zCol * 𝔰.zColᴴ +
        𝔰.isotropicCols * (a * 𝔰.isotropicColsᴴ + v * 𝔰.zColᴴ) +
        (𝔰.dualCols + 𝔰.zCol * vᴴ + (2⁻¹ : ℂ) • (𝔰.isotropicCols * v * vᴴ)) * a.adjugateᴴ *
          𝔰.dualColsᴴ) <| by
    -- `a` has determinant `1`, so its adjugate is its inverse.
    have a_det : a.det = 1 := det_eq_one_of_unitriangular (lev := id) <| by
      simp [a, unitriangularMatrix, Matrix.one_apply]
      lia
    -- Expand with `J₁_eq` and the orthogonality relations of the columns.
    simp [a_det, adjugate_conjTranspose, mul_mul_eq_of_mul_eq (mul_adjugate _),
      mul_mul_eq_of_mul_eq (adjugate_mul _), Matrix.mul_add, Matrix.mul_assoc, Matrix.add_mul,
      J₁_eq, Matrix.mul_sub, inclMatrix_gram_mul_eq_zero, inclMatrix_gram_mul_eq_self,
      Matrix.sub_mul]
    module

attribute [simps (attr := local simp) (rhsMd := .default) -isSimp coe_val, irreducible] unipotentOf
  liftUnitriangular

/-! ### Membership in the subgroups -/

/-- `embedH h` acts as `h` on the span of the `x_i` and as the identity on its orthogonal
complement. -/
theorem coe_embedH (h : U (1 : Matrix 𝔰.κ 𝔰.κ ℂ)) :
    (embedH h).val.val = actOnCols 𝔰.definiteCols h.val.val := by
  simp [actOnCols, val_toBesselH_apply_coe, inclMatrix, ← ext_iff, Matrix.one_apply, mul_apply]

/-- Each explicit isometry `unipotentOf q` lies in 𝖴⁰ = `besselU0`: it is block upper unitriangular
for the levels `New.BesselIndex.level` and fixes the frame e_0, …, e_{ϱ-1}, z. -/
lemma unipotentOf_mem_besselU0 (q : 𝔰.UnipotentParams) : unipotentOf q ∈ besselU0 := by
  refine mem_besselU0_iff.2 ⟨mem_besselU.2 ?_, by simp [frameMatrix, inclMatrix, ← ext_iff,
    Matrix.mul_apply, Matrix.one_apply, forall_fin_succ', Fin.ne_of_gt]⟩
  -- Off the diagonal the entries are nonzero only at (e_a, x_i), (x_i, e*_b) and (e_a, e*_b),
  -- and the inequalities a, b < ϱ put all three above the block diagonal.
  rintro (a | k | a) (b | l | b) h_level
  case inl.inr.inl | inl.inr.inr | inr.inl.inr.inr =>
    simp [BesselIndex.level] at h_level
    lia
  all_goals simp [inclMatrix, Matrix.mul_apply, Matrix.one_apply]

/-- For `u` in 𝖴⁰ and `h` in U(κ), the product `u * embedH h` lies in the fixer of the frame. -/
lemma mul_embedH_mem_besselFixer {u : 𝔰.G₁} (hu : u ∈ besselU0)
    (h : U (1 : Matrix 𝔰.κ 𝔰.κ ℂ)) : u * embedH h ∈ besselFixer :=
  mul_mem (mem_besselFixer_of_mem_besselU0 hu) (mem_besselFixer_of_mem_besselH (toBesselH_mem h))

/-- The block of `liftUnitriangular x` on the rows and columns of the frame (e_0, …, e_{ϱ-1}, z) is
`unitriangularMatrix x`, the upper unitriangular matrix with entries x above the diagonal. -/
@[simp]
theorem frameMatrix_liftUnitriangular (x : UpperEntries 𝔰.n) :
    frameMatrix (liftUnitriangular x) = unitriangularMatrix x := by
  -- No index comes after the last one, so the last row has no entry right of the diagonal.
  have h_last (i : Fin 𝔰.ϱ) : ¬ last 𝔰.ϱ < i.castSucc := (le_last _).not_gt
  simp [h_last, frameMatrix, inclMatrix, unitriangularMatrix, ← ext_iff, Matrix.mul_apply,
    Matrix.one_apply, forall_fin_succ', Fin.ne_of_gt]

/-- For a family x of entries above the diagonal of a matrix of size `𝔰.n` = ϱ+1, the isometry
`liftUnitriangular x`, which acts on the frame by the unitriangular matrix with entries x, lies in
𝖴 = `besselU`: it is block upper unitriangular for the levels `New.BesselIndex.level`. -/
theorem liftUnitriangular_mem_besselU (x : UpperEntries 𝔰.n) : liftUnitriangular x ∈ besselU := by
  -- The entries are explicit, except in the rows at the e*_a, where the adjugate matters;
  -- `partialUnitriangularGroup_apply_eStar` gives these rows for an element of
  -- `partialUnitriangularGroup ϱ`, the group with the conditions of `besselU` in the columns e_b
  -- alone.
  have h_mem : liftUnitriangular x ∈ partialUnitriangularGroup 𝔰.ϱ := by
    -- each remaining condition is about a position with contradictory levels
    simp [mem_partialUnitriangularGroup, BesselIndex.level, inclMatrix, unitriangularMatrix,
      Matrix.mul_assoc,
      Matrix.add_mul, Matrix.mul_apply, Matrix.one_apply]
    lia
  refine mem_besselU.2 fun i j h_level ↦ ?_
  rcases i with a | k | a
  case inr.inr =>
    refine partialUnitriangularGroup_apply_eStar h_mem (isLt a) j fun b hb ↦ ?_
    rintro rfl
    simp [BesselIndex.level] at h_level
    lia
  all_goals rcases j with b | l | b
  -- `h_mem` covers the columns e_b; the middle block is explicit; the other positions lie above
  -- the block diagonal.
  case inl.inl | inr.inl.inl =>
    exact mem_partialUnitriangularGroup.1 h_mem _ _ h_level (.inl ⟨b.isLt, b.isLt⟩)
  case inr.inl.inr.inl =>
    rcases k with k | ⟨⟩ <;> rcases l with l | ⟨⟩ <;>
      simp [inclMatrix, Matrix.add_mul, Matrix.mul_assoc, Matrix.mul_apply, Matrix.one_apply]
  all_goals
    simp [BesselIndex.level] at h_level -- the position is above the block diagonal
    lia

/-- Let s be in `G₁`, let h be the form `J₁`, and let the ϱ columns B_b of B span an isotropic space
and be dual to the frame (`frameCols`) moved by s: h(s e_a, B_b) = δ_ab and h(s z, B_b) = 0, which
are the entries of `inclMatrix ℂ castSucc`. Then B = s u (e*_0, …, e*_{ϱ-1}) for some
u = `New.RealPlace.unipotentOf` q in the frame-fixing unipotent group 𝖴⁰. -/
theorem exists_mul_unipotentOf_dualCols_eq {s : 𝔰.G₁} {B : Matrix 𝔰.BesselIndex (Fin 𝔰.ϱ) ℂ}
    (h_dual : (s.val.val * 𝔰.frameCols)ᴴ * 𝔰.J₁ * B = inclMatrix ℂ castSucc)
    (h_isotropic : Bᴴ * 𝔰.J₁ * B = 0) :
    ∃ q : 𝔰.UnipotentParams, (s * unipotentOf q).val.val * 𝔰.dualCols = B := by
  -- Translate by `s⁻¹`; the coordinates `q` are read off the rows of `C` at the `x_i` and the
  -- skew-hermitian part of the rows at the `e_a`.
  obtain ⟨C, rfl⟩ : ∃ C, B = s.val.val * C := ⟨s⁻¹.val.val * B, by simp⟩
  rw [U.gram_invariant] at h_dual h_isotropic
  let q : 𝔰.UnipotentParams := (-Cᴴ * 𝔰.definiteCols, skewCoords (skewAdjointPart ℝ C.toRows₁))
  suffices h_cols : (unipotentOf q).val.val * 𝔰.dualCols = C from
    ⟨q, by simp [-val_unipotentOf_coe, Matrix.mul_assoc, h_cols]⟩
  -- As duality fixes the rows at `e*_a` and `z`, isotropy says that the hermitian part of the rows
  -- at the `e_a` is `-q.1 * q.1ᴴ / 2`.
  have h_block (a b : Fin 𝔰.ϱ) : star (C (Sum.inl b) a) + C (Sum.inl a) b +
      ∑ k : 𝔰.κ, star (C (𝔰.indexX₀ k) a) * C (𝔰.indexX₀ k) b = 0 := by
    simp_all [inclMatrix, J₁_eq, Matrix.mul_sub, Matrix.mul_add, Matrix.sub_mul, Matrix.add_mul,
      Matrix.mul_assoc, ← ext_iff, Matrix.mul_apply, Matrix.one_apply, forall_fin_succ', ne_of_gt]
  have h_top (a b : Fin 𝔰.ϱ) : 2⁻¹ * (C (Sum.inl a) b - star (C (Sum.inl b) a)) -
      2⁻¹ * ∑ k : 𝔰.κ, star (C (𝔰.indexX₀ k) a) * C (𝔰.indexX₀ k) b = C (Sum.inl a) b := by
    linear_combination (-2⁻¹ : ℂ) * h_block a b
  -- Duality fixes the rows at `e*_a` and `z`; `h_top` is the remaining block, at the `e_a`.
  simp_all [q, -map_sub, inclMatrix, J₁_eq, Matrix.mul_sub, Matrix.mul_add, Matrix.sub_mul,
    Matrix.add_mul, Matrix.mul_assoc, ← ext_iff, Matrix.mul_apply, Matrix.one_apply,
    forall_fin_succ', Fin.ne_of_gt, sub_eq_zero]

/-- If `s` in `G₁` fixes the frame e_0, …, e_{ϱ-1}, z (the columns of `frameCols`), then
`s * unipotentOf q = embedH h` for some `q` and some `h` in U(κ): after a correction by an element
of the frame-fixing unipotent group 𝖴⁰, `s` only acts on the span of the `x_i`. -/
theorem exists_embedH_eq_of_fix_frameCols {s : 𝔰.G₁}
    (h_fix : s.val.val * 𝔰.frameCols = 𝔰.frameCols) :
    ∃ (q : 𝔰.UnipotentParams) (h : U (1 : Matrix 𝔰.κ 𝔰.κ ℂ)), s * unipotentOf q = embedH h := by
  -- Correct `s` by some `unipotentOf q` to fix the dual columns as well; then it lies in
  -- `besselH`.
  obtain ⟨q, hq⟩ : ∃ q, (s * unipotentOf q).val.val * 𝔰.dualCols = 𝔰.dualCols := by
    -- The dual columns are dual to the frame, which `s` fixes, and span an isotropic space.
    refine exists_mul_unipotentOf_dualCols_eq ?_ ?_
    · rw [h_fix]
      simp [inclMatrix, ← ext_iff, Matrix.mul_apply, Matrix.one_apply, forall_fin_succ', ne_of_gt]
    · simp [inclMatrix, ← ext_iff, Matrix.mul_apply]
  suffices h_mem : s * unipotentOf q ∈ besselH from ⟨q, exists_eq_toBesselH h_mem isUnit_one⟩
  -- `s` and `unipotentOf q` both fix the frame.
  have h_frame := mem_besselFixer_of_mem_besselU0 (unipotentOf_mem_besselU0 q)
  simp_all [besselFixer, mem_floorGroup, -val_unipotentOf_coe, inclMatrix, ← ext_iff,
    Matrix.mul_apply, Matrix.one_apply, forall_fin_succ', Matrix.mul_assoc, Subgroup.mem_subgroupOf]

/-- If `embedH h`, which acts by the unitary matrix h on the span of the `x_i`, lies in the
frame-fixing unipotent group 𝖴⁰ = `besselU0`, then it is trivial. -/
lemma embedH_eq_one_of_mem_besselU0 {h : U (1 : Matrix 𝔰.κ 𝔰.κ ℂ)}
    (h_mem : embedH h ∈ besselU0) : embedH h = 1 := by
  -- The levels of the `x_i` are equal, so the block of an element of `besselU` there is the
  -- identity; this block of `embedH h` is h.
  have h_block (a b : 𝔰.κ) : h.val.val a b = (1 : Matrix _ _ ℂ) a b := by
    simpa [val_toBesselH_apply_coe, Matrix.one_apply] using
      mem_besselU.1 (mem_besselU0_iff.1 h_mem).1 (𝔰.indexX₀ a) (𝔰.indexX₀ b) le_rfl
  simp [embedH, show h = 1 from Subtype.ext (Units.ext (Matrix.ext h_block))]

/-- The group 𝖴⁰ = `besselU0` of block unitriangular elements of `G₁` that fix the frame consists
exactly of the explicit isometries `unipotentOf q`. -/
theorem mem_besselU0_iff_unipotentOf {u : 𝔰.G₁} :
    u ∈ besselU0 ↔ ∃ q : 𝔰.UnipotentParams, u = unipotentOf q := by
  refine ⟨fun hu ↦ ?_, ?_⟩
  · -- `u⁻¹` fixes the frame, so `u⁻¹ * unipotentOf q = embedH h` for some `q` and `h`.
    have h_fix : u⁻¹.val.val * 𝔰.frameCols = 𝔰.frameCols := by
      simpa [besselFixer, -inv_mem_iff, Subgroup.mem_subgroupOf, Matrix.one_apply, inclMatrix,
        ← ext_iff, Matrix.mul_apply] using mem_besselFixer_of_mem_besselU0 (inv_mem hu)
    obtain ⟨q, h, hq⟩ := exists_embedH_eq_of_fix_frameCols h_fix
    -- This element also lies in 𝖴⁰, which forces it to be `1`.
    have h_mem : embedH h ∈ besselU0 := by
      simpa [hq] using mul_mem (inv_mem hu) (unipotentOf_mem_besselU0 q)
    exact ⟨q, inv_mul_eq_one.1 (hq.trans (embedH_eq_one_of_mem_besselU0 h_mem))⟩
  · rintro ⟨q, rfl⟩
    exact unipotentOf_mem_besselU0 q

/-- The measure on the frame-fixing unipotent group 𝖴⁰ of G₁. It is the pushforward of Lebesgue
measure on the parameters q under q ↦ `unipotentOf q`. -/
def _root_.New.Shape.besselHaar₀ : Measure (besselU0 (T := 𝔰.middleGram (1 : ℂ))) :=
  volume.map (β := besselU0) fun q : 𝔰.UnipotentParams ↦ ⟨unipotentOf q, unipotentOf_mem_besselU0 q⟩

/-- The measure on the unipotent group 𝖴 of G₁. It is the pushforward of the product of Lebesgue
measure on `UpperEntries 𝔰.n` (the entries above the diagonal of a matrix of size 𝔰.n = ϱ+1) with
`New.Shape.besselHaar₀`, under (x, u) ↦ u · `liftUnitriangular x`. -/
def _root_.New.Shape.besselHaar : Measure (besselU (T := 𝔰.middleGram (1 : ℂ))) :=
  (volume.prod 𝔰.besselHaar₀).map (β := besselU) fun q ↦
    ⟨q.2.1 * liftUnitriangular q.1, mul_mem q.2.2.1 (liftUnitriangular_mem_besselU q.1)⟩

/-- The measure on G₁ that computes integrals over 𝖴\G₁: Haar measure weighted by a cutoff for the
measure `New.Shape.besselHaar` on 𝖴. -/
abbrev _root_.New.besselQuotMeasure : Measure 𝔰.G₁ := orbitMeasure 𝔰.besselHaar volume

end New.RealPlace

end UnipotentCoords

/-!
## Bessel functions on G₁ and right convolution

* `New.convolve`: the convolution of a vector-valued function with a complex function on a group.
-/

namespace New

open Matrix MeasureTheory

/-- The convolution `y ↦ ∫ x (a⁻¹) F (y a) da` of a vector-valued function `F` with a complex
function `x` on `G`. -/
noncomputable def convolve {G E : Type*} [Group G] [MeasureSpace G] [NormedAddCommGroup E]
    [NormedSpace ℂ E] (F : G → E) (x : G → ℂ) (y : G) : E :=
  ∫ a : G, x a⁻¹ • F (y * a)

variable {𝔰 : Shape} {I : Type*} [Fintype I] [DecidableEq I]
  (rep : U (1 : Matrix 𝔰.κ 𝔰.κ ℂ) →* unitaryGroup I ℂ)

/-- A Bessel function on `G₁` with values in `ℂ^I` is a bounded, strongly measurable `F` with two
transformation laws. For `n` in the unipotent group `New.Shape.Form.besselU`, `F (n y) = ψ(n) F y`.
For `h` in `U(κ)` = `U (1 : Matrix 𝔰.κ 𝔰.κ ℂ)` (written `U 1` below), embedded by
`New.RealPlace.embedH`, `F (h y) = rep h (F y)`.

Here `ψ(n)` is `New.wave` of the sum of the entries just above the diagonal of `n` on the frame
`New.Shape.besselFrame`. -/
structure IsBesselFunction (F : 𝔰.G₁ → EuclideanSpace ℂ I) extends IsBoundedMeasurable F where
  /-- `F` transforms by the fixed character `n ↦ wave (simpleRootSum n)` under the unipotent
  group. -/
  map_unipotent_mul : ∀ n ∈ besselU, ∀ y : 𝔰.G₁, F (n * y) = wave (simpleRootSum n) • F y
  /-- `F` transforms by `rep` under `U(κ)`. -/
  map_unitary_mul (h : U 1) (y : 𝔰.G₁) : F (RealPlace.embedH h * y) = toEuclideanCLM (𝕜 := ℂ)
    (rep h) (F y)

/-- The unitary matrix representation `rep` of `U(κ)`, acting by continuous linear operators on
Euclidean space. -/
noncomputable def DiscreteSeries.besselValueRep :
    U (1 : Matrix 𝔰.κ 𝔰.κ ℂ) →* unitary (EuclideanSpace ℂ I →L[ℂ] EuclideanSpace ℂ I) :=
  (Unitary.map (StarMulEquiv.ofClass (toEuclideanCLM (𝕜 := ℂ))).toStarMonoidHom).toMonoidHom.comp
    rep

end New

end
