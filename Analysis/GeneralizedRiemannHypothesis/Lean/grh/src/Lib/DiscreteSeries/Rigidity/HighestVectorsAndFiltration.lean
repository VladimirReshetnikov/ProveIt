import Lib.DiscreteSeries.Holomorphic.HighestVectorExtension
import Lib.General.LinearAlgebra.Eigenvalues

/-!
# K-highest vectors, norm bounds, Casimir growth on the filtration, and analytic vectors

The setting is a `gl_n`-module with an invariant inner product and a lower bound, depending on `l`,
for the Casimir operator (`New.IsUnitaryCasimirGe l ρ`). It is studied through the increasing
filtration `M_s = New.GlModule.filtration ρ ε x` generated by a `K`-highest vector `x`. Signs
`ε_a = ±1` define `𝔨`, spanned by the `E_ab` with `ε_a = ε_b`. `Ω_K = ρ.casimirK ε` is the Casimir
operator of `K`, and `c_K = New.HCParam.casimirKValue l` is its value on a highest vector. Take a
parameter with a large gap (`New.HCParam.HasLargeGap`) and `x` of weight `Λ`
(`New.HCParam.lowestKType`). Then the file shows that `Ω_K` grows along the filtration. With norm
bounds on the `M_s` it also shows that a bounded coefficient map is determined on `x` by its values
at `1` on the `M_s`.

## Main definitions and results

* `New.HCParam.exists_highest_vector`: a nonzero finite-dimensional 𝔨-stable subspace contains a
  highest weight vector.
* `New.HCParam.IsKHighest.finite_filtration`: for an invariant inner product, M_s has finite
  dimension.
* `New.HCParam.IsKHighest.norm_apply_le_of_mem_filtration`: a matrix `X` maps `M_s` into `M_{s+1}`
  (`New.GlModule.apply_mem_filtration_succ`), with an explicit bound for the norm of this action
  (`New.HCParam.IsKHighest.norm_apply_le_mul_norm`).
* `New.mem_orthogonal_filtration_of_casimirK`: an eigenvector of `Ω_K` of eigenvalue at most
  `c_K(Λ) + s` that is orthogonal to `M_s` is orthogonal to every `M_t`.
* `New.HCParam.IsKHighest.coeffMap_eq_zero`: let `l` be a parameter with a gap, and let `ρ` satisfy
  `New.IsUnitaryCasimirGe l ρ`. Then a bounded coefficient map that vanishes at `1` on the module
  generated by a `K`-highest vector `x` vanishes on `x` at every `g`.

Notions from other files:
* `New.HCParam.IsKHighest`: x has weight ν and is killed by the compact raising operators.
* `New.GlModule.filtration`: M_0 = U(𝔨)x and M_{s+1} = M_s + Σ E_ab M_s.
* `New.HCParam.casimirKValue`: the integer |ν + ρ_c|² − |ρ_c|², the value of the Casimir operator of
  𝔨.
* `New.IsUnitaryCasimirGe`: the inner product of the gl_n-module H satisfies ⟨E_ab v, w⟩ = ε_aε_b⟨v,
  E_ba w⟩, and Re⟨y, Ωy⟩ ≥ κ_λ‖y‖² for the full Casimir operator Ω, with
  κ_λ = `New.HCParam.casimirValue l`.
* `New.HCParam.HasGap`: the entries of l = 2λ are distinct, have the parity of n - 1, and those with
  different signs ε are at least twice the gap apart; `New.HCParam.HasLargeGap A` asks for a gap of
  at least `gapThreshold n A`, which puts such entries at least `1000 (card n)³` apart.

## Relation to the literature

Known result: Lowest K-type and Casimir value determine a discrete series coefficient, via analytic
vectors. Here the setting is U(p,q), and no irreducibility is assumed. Proved here are two parts: a
growth estimate for the compact Casimir operator along the filtration, for parameters with large
gaps, and a vanishing criterion for coefficient maps on a highest vector by explicit norm bounds in
place of analyticity.

Source: R. Parthasarathy, Classification of discrete series by minimal K-type, Represent. Theory 19
(2015) 167-185, Thm 1.1; earlier Hotta-Parthasarathy, Invent. Math. 26 (1974) 133-178; Schmid, Ann.
of Math. 102 (1975) 535-564; Vogan-Zuckerman, Compositio 53 (1984) Prop 6.1; Nelson, Analytic
vectors, Ann. of Math. 70 (1959) 572-615.
-/

namespace New

/-!
## Highest vectors, weights of words and finiteness of M_s

An integer vector `l` orders the indices, so that `E_ab` is raising if `l_b < l_a` and lowering if
`l_a < l_b`.
-/

section HighestVectors

open Finset Pi Submodule Module GlModule LinearMap End

variable {n : Type} [Fintype n] [DecidableEq n]
  {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  {ε : n → ℤˣ} {l : HCParam ε} {ρ : GlModule n H} {ν : n → ℤ} {x : H} {s g : ℕ}

/-- For a list of index pairs (a, b), the vector ν + Σ (e_a − e_b): the weight of the product of
the E_ab applied to a vector of weight ν. -/
noncomputable def wordWeight (ν : n → ℤ) (w : List (n × n)) : n → ℤ :=
  w.foldr (fun (a, b) μ ↦ μ + (Pi.single a 1 - Pi.single b 1)) ν

/-- If E_cc acts on v by the scalar m, then it acts on E_ab v by m + (e_a − e_b)_c. -/
theorem GlModule.E_self_E_apply_eq_smul {c : n} {m : ℂ} {v : H} (hv : ρ.E c c v = m • v) (a b : n) :
    ρ.E c c (ρ.E a b v) = (m + (Pi.single a 1 - Pi.single b 1 : n → ℂ) c) • ρ.E a b v := by
  -- Commute `E c c` past `E a b`; both terms of the commutator are multiples of `E a b`.
  have h_left : (if c = a then ρ.E c b else 0) v = (Pi.single a 1 : n → ℂ) c • ρ.E a b v := by
    by_cases hca : c = a <;> simp [hca]
  have h_right : (if b = c then ρ.E a c else 0) v = (Pi.single b 1 : n → ℂ) c • ρ.E a b v := by
    by_cases hcb : c = b <;> simp [hcb, eq_comm (a := b)]
  rw [E_apply_E_apply, hv, map_smul, h_left, h_right, add_smul, Pi.sub_apply, sub_smul]

/-- A nonzero finite-dimensional subspace stable under 𝔨 contains a nonzero weight vector that is
killed by the compact raising operators. -/
theorem HCParam.exists_highest_vector (W : Submodule ℂ H) [Module.Finite ℂ W] (hW_ne : W ≠ ⊥)
    (hW_stable : ∀ a b : n, ε a = ε b → W ∈ (ρ.E a b).invtSubmodule) :
    ∃ μ : n → ℂ, ∃ v ∈ W, v ≠ 0 ∧
      -- `v` has weight `μ`, and the compact raising operators kill it
      (∀ a : n, ρ.E a a v = μ a • v) ∧ ρ.IsCompactPrimitive l v := by
  -- The weights of `W` form a finite nonempty set `S`. Take `μ` in `S` with the largest pairing
  -- with `l`: a raising operator would send a weight vector to a weight with a larger pairing.
  let S : Set (n → ℂ) := {μ | ∃ v ∈ W, v ≠ 0 ∧ ∀ a, ρ.E a a v = μ a • v}
  have h_fin : S.Finite := by
    refine (Set.Finite.pi' fun a ↦ finite_hasEigenvalue (restrict _ (hW_stable a a rfl))).subset ?_
    rintro μ ⟨v, hv, hv0, hμ⟩ a
    exact hasEigenvalue_of_hasEigenvector (x := ⟨v, hv⟩)
      ⟨mem_eigenspace_iff.2 (Subtype.ext (hμ a)), by simpa⟩
  have h_ne : S.Nonempty := by
    -- The diagonal operators commute, so they have a common eigenvector in `W`.
    have h_comm (a b : n) (v : H) (_ : v ∈ W) : ρ.E a a (ρ.E b b v) = ρ.E b b (ρ.E a a v) := by
      rw [E_apply_E_apply]
      by_cases hab : a = b <;> simp [hab, eq_comm (a := b)]
    have : Nontrivial W := Submodule.nontrivial_iff_ne_bot.2 hW_ne
    exact (exists_eigenvector_of_commute _ (fun a ↦ hW_stable a a rfl) h_comm bot_ne_top).imp
      fun _ ⟨_, hv⟩ ↦ hv
  obtain ⟨μ, ⟨v, hv, hv0, hμ⟩, h_max⟩ :=
    S.exists_max_image (fun μ : n → ℂ ↦ ((↑) ∘ l ⬝ᵥ μ).re) h_fin h_ne
  refine ⟨μ, v, hv, hv0, hμ, fun a b hab hlt ↦ by_contra fun h_raise ↦ ?_⟩
  -- A nonzero `ρ.E a b v` has weight `μ + e_a - e_b`, whose pairing is larger by `l a - l b > 0`.
  have h_mem : μ + (single a 1 - single b 1) ∈ S :=
    ⟨ρ.E a b v, hW_stable a b hab hv, h_raise, fun c ↦ E_self_E_apply_eq_smul (hμ c) a b⟩
  exact (h_max _ h_mem).not_gt (by simpa)

omit [Fintype n] in
/-- The coordinates of `wordWeight ν w` differ from those of ν by at most the length of w. -/
theorem abs_wordWeight_sub_le (ν : n → ℤ) (w : List (n × n)) (a : n) :
    |wordWeight ν w a - ν a| ≤ w.length := by
  induction w with
  | nil => simp [wordWeight]
  | cons p w ih =>
    obtain ⟨c, d⟩ := p
    have h_diff : wordWeight ν ((c, d) :: w) a - wordWeight ν w a =
        (if a = c then 1 else 0) - (if a = d then 1 else 0) := by
      simp [wordWeight, Pi.single_apply]
    calc |wordWeight ν ((c, d) :: w) a - ν a|
        ≤ |wordWeight ν ((c, d) :: w) a - wordWeight ν w a| + |wordWeight ν w a - ν a| :=
          abs_sub_le ..
      _ ≤ 1 + w.length := add_le_add (by grind) ih
      _ = ((c, d) :: w).length := by simp [add_comm]

/-- Let x be a K-highest vector of weight ν. The word w, a product of operators E_ab, sends x to a
vector of weight `wordWeight ν w`. -/
theorem HCParam.IsKHighest.E_self_word_eq_smul (hx : l.IsKHighest ρ ν x) (w : List (n × n))
    (a : n) :
    ρ.E a a (ρ.word w x) = (wordWeight ν w a : ℂ) • ρ.word w x := by
  induction w with
  | nil => simpa [word, wordWeight] using hx.1 a
  | cons p w ih =>
    obtain ⟨c, d⟩ := p
    have h_wt : (wordWeight ν ((c, d) :: w) a : ℂ) =
        wordWeight ν w a + (Pi.single c 1 - Pi.single d 1 : n → ℂ) a := by
      simp [wordWeight, Pi.single_apply]
    rw [show ρ.word ((c, d) :: w) x = ρ.E c d (ρ.word w x) by simp [word], h_wt]
    exact E_self_E_apply_eq_smul ih c d

/-- Let l be a parameter of some gap (`New.HCParam.HasGap`) and x K-highest of weight ν. Let the
subspace T be stable under the compact lowering operators (E_ab with ε_a = ε_b and l_a < l_b) and
contain wx for all words w of length ≤ s in the E_ab. Then T contains the step M_s of
`New.GlModule.filtration`. -/
theorem HCParam.IsKHighest.filtration_le_of_word_mem (hx : l.IsKHighest ρ ν x) [hg : l.HasGap g]
    (T : Submodule ℂ H) (hT : ∀ a b : n, ε a = ε b → l a < l b → T ∈ (ρ.E a b).invtSubmodule)
    (h_words : ∀ w : List (n × n), w.length ≤ s → ρ.word w x ∈ T) :
    ρ.filtration ε x s ≤ T := by
  let IsStable (U : Submodule ℂ H) : Prop :=
    ∀ a b : n, ε a = ε b → l a < l b → U ∈ (ρ.E a b).invtSubmodule
  -- Stability passes from `U` to the space `preimage r U` of the `y` with `ρ.E c d y ∈ U` for all
  -- `(c, d)` whose signs lie in `r`: commute the lowering operator past `ρ.E c d`; the matrix units
  -- in the commutator have the same pair of signs as `(c, d)`.
  let preimage (r : Set (ℤˣ × ℤˣ)) (U : Submodule ℂ H) : Submodule ℂ H :=
    (pi (Prod.map ε ε ⁻¹' r) fun _ ↦ U).comap (.pi ρ.E.uncurry)
  have mem_preimage (r : Set (ℤˣ × ℤˣ)) (U : Submodule ℂ H) (y : H) :
      y ∈ preimage r U ↔ ∀ c d : n, (ε c, ε d) ∈ r → ρ.E c d y ∈ U := by simp [preimage]
  have isStable_preimage (r : Set (ℤˣ × ℤˣ)) {U : Submodule ℂ H} (hU : IsStable U) :
      IsStable (preimage r U) := fun a b hab hlt y hy ↦ by
    have hy_mem : ∀ c d : n, (ε c, ε d) ∈ r → ρ.E c d y ∈ U := (mem_preimage r U y).1 hy
    refine (mem_preimage r U _).2 fun c d hcd ↦ ?_
    rw [E_apply_E_apply]
    refine add_mem (hU a b hab hlt (hy_mem c d hcd)) (sub_mem ?_ ?_)
    · split_ifs with hda
      exacts [hy_mem c b (by rwa [← hab, ← hda]), U.zero_mem]
    · split_ifs with hbc
      exacts [hy_mem a d (by rwa [hab, hbc]), U.zero_mem]
  induction s generalizing T with
  | zero =>
    -- The least stable subspace `T₀` that contains `x` lies in `T` and is stable under `𝔨`.
    let T₀ : Submodule ℂ H := sInf {U | IsStable U ∧ x ∈ U}
    have h_le : T₀ ≤ T := sInf_le ⟨hT, by simpa [word] using h_words []⟩
    refine sInf_le_of_le ⟨by simp [T₀], fun a b hab y hy ↦ ?_⟩ h_le
    refine mem_sInf.2 fun U ⟨hU, hxU⟩ ↦ ?_
    -- `𝔨` maps `x` into `U`: lowering operators by stability, diagonal ones to a multiple of `x`,
    -- raising ones to zero.
    obtain ⟨hx_wt, hx_raise⟩ := hx
    have hx_preimage : x ∈ preimage (.diagonal _) U := by
      refine (mem_preimage _ U x).2 fun c d (hcd : ε c = ε d) ↦ ?_
      rcases lt_trichotomy (l c) (l d) with h_lower | h_eq | h_upper
      · exact hU c d hcd h_lower hxU
      · obtain rfl : c = d := hg.injective h_eq
        simpa [hx_wt c] using U.smul_mem _ hxU
      · simp [hx_raise c d hcd h_upper]
    exact (mem_preimage _ U y).1 (mem_sInf.1 hy _ ⟨isStable_preimage _ hU, hx_preimage⟩) a b hab
  | succ s ih =>
    refine sup_le (ih T hT fun w hw ↦ h_words w (by omega)) (iSup₂_le fun a b ↦ ?_)
    -- Prefixing one letter to a word of length at most `s` gives a word of length at most `s + 1`.
    have h_le : ρ.filtration ε x s ≤ preimage ⊤ T := ih _ (isStable_preimage ⊤ hT) fun w hw ↦
      (mem_preimage ⊤ T _).2 fun c d _ ↦ h_words ((c, d) :: w) (by simpa)
    exact map_le_iff_le_comap.2 fun y hy ↦ (mem_preimage ⊤ T y).1 (h_le hy) a b trivial

/-- Assume `New.IsUnitaryCasimirGe l ρ` (invariant inner product, Casimir lower bound). Let `l` be a
parameter of some gap `g` (`|λ i - λ j| ≥ g` when `ε i ≠ ε j`, `l = 2λ`) and `x` a `K`-highest
vector of any weight `ν`. Then each `M_s = ρ.filtration ε x s` is finite-dimensional. Here `M_0` is
the least subspace containing `x` stable under the `E a b` with `ε a = ε b`, and
`M_{s+1} = M_s + Σ E a b M_s`. -/
theorem HCParam.IsKHighest.finite_filtration (hx : l.IsKHighest ρ ν x) [hg : l.HasGap g]
    (hρ : IsUnitaryCasimirGe l ρ) (s : ℕ) : Module.Finite ℂ (ρ.filtration ε x s) := by
  induction s with
  -- step `s + 1` is a finite sum of images of the finite-dimensional step `s`
  | succ s ih => exact finite_sup ..
  | zero =>
    -- `ρ.filtration ε x 0` is spanned by its vectors `wx` with `w.length ≤ l ⬝ ν - l ⬝ μ`, `μ` the
    -- weight of `wx`: each compact lowering operator lowers the pairing with `l` by at least `1`.
    let G : Set H :=
      ↑(ρ.filtration ε x 0) ∩ (ρ.word · x) '' {w | l ⬝ᵥ wordWeight ν w + w.length ≤ l ⬝ᵥ ν}
    have h_span : ρ.filtration ε x 0 ≤ span ℂ G := by
      refine hx.filtration_le_of_word_mem _ (fun a b hε hab ↦ mapsTo_span ?_) fun w hw ↦ ?_
      · rintro _ ⟨y_mem, w, (hw : l ⬝ᵥ wordWeight ν w + w.length ≤ l ⬝ᵥ ν), rfl⟩
        refine ⟨E_mem_filtration y_mem hε, (a, b) :: w, ?_, by simp [word]⟩
        have h_wt : l ⬝ᵥ wordWeight ν ((a, b) :: w) = l ⬝ᵥ wordWeight ν w + (l a - l b) := by
          simp [wordWeight]
        grind
      · obtain rfl : w = [] := by simpa using hw
        exact subset_span ⟨self_mem_filtration, [], by simp [wordWeight]⟩
    -- The words with a nonzero value have bounded length, so `G` is finite.
    let N : ℕ := (l ⬝ᵥ (ν + ν + l) + l.casimirKValue ν).toNat
    have h_fin : G.Finite := by
      refine (((List.finite_length_le _ N).image (ρ.word · x)).insert 0).subset ?_
      rintro _ ⟨y_mem, w, (hw_pair : l ⬝ᵥ wordWeight ν w + w.length ≤ l ⬝ᵥ ν), rfl⟩
      refine or_iff_not_imp_left.2 fun (y_ne : ρ.word w x ≠ 0) ↦ ⟨w, ?_, rfl⟩
      -- `ρ.casimirK ε` is the scalar `l.casimirKValue ν` on `y = ρ.word w x`, and
      -- `⟪y, ρ.casimirK ε y⟫` is the sum of the `‖E b a y‖ ^ 2` over compact pairs, among them the
      -- `‖E a a y‖ ^ 2`. So the weight `μ` of `y` has `|μ|² ≤ l.casimirKValue ν`.
      have h_diag : ∑ a, (ε a * ε a).1 * ‖ρ.E a a (ρ.word w x)‖ ^ 2 ≤
          (inner ℂ (ρ.word w x) ((l.casimirKValue ν : ℂ) • ρ.word w x)).re := by
        rw [← casimirK_eq_smul_of_mem_filtration y_mem hx.casimirK_eq_smul, hρ.inner_casimir,
          Complex.ofReal_re]
        exact sum_le_sum fun a _ ↦ single_le_sum
          (f := fun b ↦ (ε a * ε b).1 * ‖ρ.E b a (ρ.word w x)‖ ^ 2) (by simp_all) (by simp)
      have h_wt : wordWeight ν w ⬝ᵥ wordWeight ν w ≤ l.casimirKValue ν := by
        rify [dotProduct, ← sq]
        simpa [hx.E_self_word_eq_smul, norm_smul, mul_pow, ← sum_mul, ← Complex.ofReal_pow,
          y_ne] using h_diag
      -- `0 ≤ |l + μ|² = |l|² + 2 l ⬝ μ + |μ|² ≤ |l|² + 2 (l ⬝ ν - w.length) + l.casimirKValue ν`,
      -- so `2 * w.length ≤ N`.
      have h_sq : 0 ≤ l ⬝ᵥ l + 2 * (l ⬝ᵥ wordWeight ν w) + wordWeight ν w ⬝ᵥ wordWeight ν w := by
        simpa [dotProduct_comm (wordWeight ν w) l, two_mul, add_assoc, star_trivial] using
          dotProduct_self_star_nonneg (l + wordWeight ν w)
      grind [dotProduct_add]
    exact .of_fg ((fg_span h_fin).of_le h_span)

end HighestVectors

/-!
## Norm bounds for the action of gl_n on M_s

* `New.IsKInvariantForm`: the form `∑ ⟪J_i u, J_i v⟫` is given by an operator that commutes with
  `𝔨`.
-/

section FiltrationNormBound

open Finset InnerProductSpace Complex Module ComplexOrder Fintype Submodule Int GlModule
  Matrix.Norms.L2Operator End

variable {n : Type} [Fintype n] [DecidableEq n]
  {H I : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [Fintype I]
  {ε : n → ℤˣ} {ν : n → ℤ} {l : HCParam ε} {ρ : GlModule n H} {x y : H} {s A L : ℕ}
  {J : I → End ℂ H}

variable (ε ρ J) in
/-- A finite family of endomorphisms J_i of H has this property if Σ_i⟨J_i u, J_i v⟩ = ⟨u, Dv⟩ for
all u, v, for some operator D that commutes with every E_cd with ε_c = ε_d. -/
def IsKInvariantForm : Prop :=
  ∃ D : End ℂ H, (∀ c d : n, ε c = ε d → Commute (ρ.E c d) D) ∧
    ∀ u v : H, ∑ i : I, ⟪J i u, J i v⟫_ℂ = ⟪u, D v⟫_ℂ

/-- Under `New.IsUnitaryCasimirGe l ρ` (of which only the invariance of the inner product is used),
`New.IsKInvariantForm`, that is, `∑ ⟪J_i u, J_i v⟫ = ⟪u, D v⟫` with `D` commuting with `𝔨`, passes
from the family `J_i` to the family of all products `J_i E_qp`. -/
theorem IsKInvariantForm.mul_E (hρ : IsUnitaryCasimirGe l ρ) (hJ : IsKInvariantForm ε ρ J) :
    IsKInvariantForm ε ρ fun ((p, q, i) : n × n × I) ↦ J i * ρ.E q p := by
  -- The new operator is `∑ c d, ε c ε d • E c d * D * E d c`: move `E` across the inner product.
  obtain ⟨D, hD_comm, hD_form⟩ := hJ
  refine ⟨∑ c, ∑ d, ((ε c : ℂ) * ε d) • (ρ.E c d * D * ρ.E d c),
    fun a b hab ↦ ρ.commute_E_sum_E_mul_mul_E (· * ·) hab (hD_comm a b hab), fun u v ↦ ?_⟩
  suffices ∑ p : n, ∑ q : n, ⟪ρ.E q p u, D (ρ.E q p v)⟫_ℂ =
      ⟪u, (∑ c, ∑ d, ((ε c : ℂ) * ε d) • (ρ.E c d * D * ρ.E d c)) v⟫_ℂ by
    simpa [sum_prod_type, ← hD_form]
  simp [hρ.inner_E_left, mul_comm]

/-- Assume `New.IsUnitaryCasimirGe l ρ`, which gives `E_ab` the adjoint `ε_a ε_b E_ba`, and let `J`
satisfy `New.IsKInvariantForm`: its form is given by an operator commuting with `𝔨`. Then the
compact Casimir operator `Ω_K = ∑ E_cd E_dc` splits between the two arguments of the form
`∑ ⟪J_i u, J_i v⟫`. -/
theorem IsKInvariantForm.sum_inner_casimirK (hρ : IsUnitaryCasimirGe l ρ)
    (hJ : IsKInvariantForm ε ρ J) (u v : H) :
    ∑ i : I, ⟪J i u, J i (ρ.casimirK ε v)⟫_ℂ =
      ∑ i : I, ∑ c : n, ∑ d : n with ε c = ε d, ⟪J i (ρ.E d c u), J i (ρ.E d c v)⟫_ℂ := by
  obtain ⟨D, hD_comm, hD_form⟩ := hJ
  -- For a compact pair (c, d), `E c d` commutes with `D` and has adjoint `E d c`.
  have h_move (c d : n) (hcd : ε c = ε d) (z : H) :
      ⟪u, D (ρ.E c d z)⟫_ℂ = ⟪ρ.E d c u, D z⟫_ℂ := by
    simp [← End.mul_apply D, ← (hD_comm c d hcd).eq, hρ.inner_E_left, hcd]
  suffices h_sum : ∑ c : n, ∑ d : n with ε c = ε d, ⟪u, D (ρ.E c d (ρ.E d c v))⟫_ℂ =
      ∑ c : n, ∑ d : n with ε c = ε d, ⟪ρ.E d c u, D (ρ.E d c v)⟫_ℂ by
    simpa [sum_comm (γ := I), GlModule.casimir, hD_form] using h_sum
  exact sum_congr rfl fun c _ ↦ sum_congr rfl fun d hd ↦ h_move c d (by simpa using hd) _

/-- A bound for `Ω_K` on the highest vectors holds on all vectors. Let the inner product be
invariant under 𝔲(diag ε), with Casimir Ω ≥ κ_λ (`New.IsUnitaryCasimirGe l ρ`; only the invariance
is used). Let `l` be a parameter of some gap and `x` be `K`-highest of weight `ν`. Let `U ≤ M_s` be
finite-dimensional and stable under `𝔨`, where `M_0 = U(𝔨)x` and `M_{s+1} = M_s + ∑ E_ab M_s`. Let
`J` be a family with `∑ ⟪J_i u, J_i v⟫ = ⟪u, D v⟫` for some `D` commuting with `𝔨`
(`New.IsKInvariantForm`). Write `c_K(μ) = New.HCParam.casimirKValue l μ`. Suppose that
`β ≤ α c_K(μ)` for every word `w` of length at most `s` such that some `K`-highest `z ∈ U` of weight
`μ` is not orthogonal to `w x`, where `μ` is the weight of `w x`. Then
`β ∑ ‖J_i y‖² ≤ α Re ∑ ⟪J_i y, J_i Ω_K y⟫` for `y ∈ U`. -/
theorem HCParam.IsKHighest.casimirK_bound_of_highest (hx : l.IsKHighest ρ ν x)
    (hρ : IsUnitaryCasimirGe l ρ) [hg : l.HasGap A] (α β : ℝ) {U : Submodule ℂ H}
    (hU_le : U ≤ ρ.filtration ε x s) [Module.Finite ℂ U]
    (hU_stable : ∀ a b : n, ε a = ε b → U ∈ (ρ.E a b).invtSubmodule) (hJ : IsKInvariantForm ε ρ J)
    (hy : y ∈ U) (h_bound : ∀ w : List (n × n),
      (∃ z ∈ U, l.IsKHighest ρ (wordWeight ν w) z ∧ ⟪ρ.word w x, z⟫_ℂ ≠ 0) →
      w.length ≤ s → β ≤ α * l.casimirKValue (wordWeight ν w)) :
    β * ∑ i : I, ‖J i y‖ ^ 2 ≤ α * re (∑ i : I, ⟪J i y, J i (ρ.casimirK ε y)⟫_ℂ) := by
  -- Write `∑ ⟪J_i u, J_i v⟫ = ⟪u, D v⟫`. It is enough that the compression `B` to `U` of
  -- `T = α D Ω_K - β D` is positive. Each eigenspace of `B` is `𝔨`-stable, so it contains a highest
  -- vector, and on that vector `h_bound` shows that the eigenvalue is nonnegative.
  have ⟨D, hD_comm, hD_form⟩ := hJ
  let T : End ℂ H := α • D * ρ.casimirK ε - β • D
  let B : End ℂ U := U.orthogonalProjectionOnto.1 ∘ₗ T.domRestrict U
  have hB_symm : B.IsSymmetric :=
    fun _ ↦ by simp [B, T, ← inner_conj_symm (D _), ← hD_form, hJ.sum_inner_casimirK hρ]
  suffices h_nonneg : ∀ e : ℝ, HasEigenvalue B e → 0 ≤ e by
    -- In an eigenvector basis `B` is a diagonal matrix with nonnegative entries.
    have hB_pos : B.IsPositive := by
      simpa [← B.posSemidef_toMatrix_iff (hB_symm.eigenvectorBasis rfl),
        hB_symm.toMatrix_eigenvectorBasis] using
        fun t ↦ h_nonneg _ (hB_symm.hasEigenvalue_eigenvalues rfl t)
    simpa [B, T, ← hD_form, sq] using hB_pos.re_inner_nonneg_right ⟨y, hy⟩
  intro e h_eigenvalue
  -- The eigenspace `W` of `B` for `e`: the `z ∈ U` with `T z - e z` orthogonal to `U`.
  let W : Submodule ℂ H := U ⊓ Uᗮ.comap (T - (e : ℂ) • 1)
  have hW_ne : W ≠ ⊥ := fun hW ↦ h_eigenvalue <| eq_bot_iff.2 fun u ↦ by
    simpa [W, B, ← orthogonalProjectionOnto_eq_zero_iff, sub_eq_zero] using hW.le (x := u)
  -- `W` is `𝔨`-stable: `ρ.E a b` commutes with `T`, and its adjoint `ρ.E b a` preserves `U`.
  have hW_stable (a b : n) (hab : ε a = ε b) : W ∈ (ρ.E a b).invtSubmodule := by
    refine fun z ⟨hzU, hz_orth⟩ ↦ ⟨hU_stable a b hab hzU, fun u hu ↦ ?_⟩
    simpa [T, hρ.inner_E_left, ← End.mul_apply, (hD_comm ..).eq, hab,
      ((hD_comm ..).mul_right (commute_E_casimirK ..)).eq] using
      hz_orth (ρ.E b a u) (hU_stable b a hab.symm hu)
  have : FiniteDimensional ℂ W := finiteDimensional_of_le inf_le_left
  obtain ⟨μ, z, ⟨hzU, hz_orth⟩, hz_ne, hz_wt, hz_high⟩ := l.exists_highest_vector W hW_ne hW_stable
  -- `z` is not orthogonal to all words of length `≤ s`: the orthogonal complement of `z` is stable
  -- under the compact lowering operators, whose adjoints kill `z`, so it would contain
  -- `ρ.filtration ε x s`, hence `z`.
  obtain ⟨w, hw_len, hw_ne⟩ : ∃ w, w.length ≤ s ∧ ⟪ρ.word w x, z⟫_ℂ ≠ 0 := by
    by_contra! h_orth
    have h_stable (a b : n) (hab : ε a = ε b) (hlt : l a < l b) :
        (innerSLFlip ℂ z).ker ∈ (ρ.E a b).invtSubmodule := fun v _ ↦ by
      simp [hρ.inner_E_left, hz_high b a hab.symm hlt]
    exact inner_self_ne_zero.2 hz_ne
      (hx.filtration_le_of_word_mem (innerSLFlip ℂ z).ker h_stable h_orth (hU_le hzU))
  -- As `ρ.E a a` is self-adjoint, `z` has the weight of that word.
  have hz : l.IsKHighest ρ (wordWeight ν w) z := by
    have h_weight (a : n) : (wordWeight ν w a : ℂ) = μ a := by
      have h_selfAdj : ⟪ρ.E a a (ρ.word w x), z⟫_ℂ = ⟪ρ.word w x, ρ.E a a z⟫_ℂ := by
        simp [hρ.inner_E_left a a]
      rw [hx.E_self_word_eq_smul, hz_wt a, inner_smul_left, inner_smul_right] at h_selfAdj
      simpa [hw_ne] using h_selfAdj
    exact ⟨fun a ↦ by rw [h_weight, hz_wt a], hz_high⟩
  -- Pair `T z - e z` with `z`, on which `Ω_K` acts by the scalar `c_K` of its weight.
  have h_pair : ⟪z, T z - (e : ℂ) • z⟫_ℂ = 0 := hz_orth z hzU
  have h_scalar :
      e * (‖z‖ * ‖z‖) = (α * l.casimirKValue (wordWeight ν w) - β) * ∑ i, ‖J i z‖ * ‖J i z‖ := by
    simpa [T, hz.casimirK_eq_smul, sq, ← hD_form, sub_eq_zero, sub_mul, mul_assoc,
      mul_left_comm α, eq_comm (a := e * _)] using congrArg re h_pair
  refine nonneg_of_mul_nonneg_left ?_ (by positivity : 0 < ‖z‖ * ‖z‖)
  rw [h_scalar]
  exact mul_nonneg (sub_nonneg.2 (h_bound w ⟨z, hzU, hz, hw_ne⟩ hw_len)) (by positivity)

/-- Every matrix `X` maps step `M_s` of the filtration generated by `x` into step `M_{s+1}`. -/
theorem GlModule.apply_mem_filtration_succ (hy : y ∈ ρ.filtration ε x s) (X : Matrix n n ℂ) :
    ρ X y ∈ ρ.filtration ε x (s + 1) := by
  simpa [ρ.apply_eq_sum X] using
    sum_mem fun a _ ↦ sum_mem fun b _ ↦ smul_mem _ (X a b) (E_mem_filtration_succ hy)

/-- Let the inner product of `H` be invariant under 𝔲(diag ε) and satisfy Re⟨y, Ωy⟩ ≥ κ_λ‖y‖² for
all y, with Ω = `ρ.casimirK 1` and κ_λ = `l.casimirValue` (`New.IsUnitaryCasimirGe`). Let `l` be a
parameter of some gap `A`, and let `x` be a `K`-highest vector of weight `ν` with `|ν_a| ≤ L`. Let
`M_s` be the filtration generated by `x`, where `M_0` is the least subspace containing `x` stable
under the `E a b` with `ε a = ε b`, and `M_{s+1} = M_s + Σ_{a,b} E_ab M_s`; then for `y ∈ M_s` and
every matrix `X`, `‖ρ X y‖ ≤ (card n + 1)⁴ (L + 1 + s) ‖X‖ ‖y‖`, with `‖X‖` the `L²` operator
norm. -/
theorem HCParam.IsKHighest.norm_apply_le_mul_norm (hx : l.IsKHighest ρ ν x)
    (hρ : IsUnitaryCasimirGe l ρ) [hg : l.HasGap A] (hL : ∀ a : n, |ν a| ≤ L)
    (hy : y ∈ ρ.filtration ε x s) (X : Matrix n n ℂ) :
    ‖ρ X y‖ ≤ (Fintype.card n + 1) ^ 4 * (L + 1 + s) * ‖X‖ * ‖y‖ := by
  -- ∑ ‖E_ab y‖² = ⟨y, (2Ω_K − Ω) y⟩, where Ω_K ≤ n N (N + n) on M_s, N = L + s, and
  -- −Ω ≤ −κ_λ ≤ n³/4. Cauchy–Schwarz in X = ∑ X_ab E_ab then gives the bound.
  let N : ℝ := L + s
  have : Module.Finite ℂ (ρ.filtration ε x s) := hx.finite_filtration hρ s
  -- The weights of words of length ≤ s have entries of size ≤ L + s, which bounds their `c_K`.
  have cK_le (w : List (n × n)) (hw : w.length ≤ s) :
      l.casimirKValue (wordWeight ν w) ≤ ∑ _a : n, ((L + s) * (L + s + card n) : ℤ) := by
    refine sum_le_sum fun a _ ↦ ?_
    have h_wt : |wordWeight ν w a| ≤ L + s := by grind [abs_wordWeight_sub_le ν w a, hL a]
    grw [le_abs_self (wordWeight ν w a * _), abs_mul, abs_add_le, abs_twoRho_le]
    gcongr
  -- An upper bound from `casimirK_bound_of_highest`: take `α = -1` and the inner product itself
  -- (`J = ![1]`, `D = 1`).
  have ΩK_le : re ⟪y, ρ.casimirK ε y⟫_ℂ ≤ card n * (N * (N + card n)) * ‖y‖ ^ 2 := by
    have h_form : IsKInvariantForm ε ρ ![1] := ⟨1, by simp⟩
    have h_neg (w : List (n × n)) (hw : w.length ≤ s) :
        -(card n * (N * (N + card n))) ≤ (-1 : ℝ) * l.casimirKValue (wordWeight ν w) := by
      simpa [N] using (cast_le (R := ℝ)).2 (cK_le w hw)
    simpa using hx.casimirK_bound_of_highest hρ (-1) _ le_rfl
      (fun a b hab v hv ↦ E_mem_filtration hv hab) h_form hy fun w _ hw ↦ h_neg w hw
  -- ⟨y, Ω y⟩ = ∑ ε_a ε_b ‖E_ba y‖² (`inner_casimir`), and a noncompact pair has ε_a ε_b = −1.
  have sum_eq : ∑ p : n × n, ‖ρ.E p.1 p.2 y‖ ^ 2 =
      2 * re ⟪y, ρ.casimirK ε y⟫_ℂ - re ⟪y, ρ.casimirK 1 y⟫_ℂ := by
    simp only [hρ.inner_casimir, sum_prod_type_right, sum_filter, Complex.ofReal_re, mul_sum,
      ← sum_sub_distrib]
    refine sum_congr rfl fun a _ ↦ sum_congr rfl fun b _ ↦ ?_
    by_cases hab : ε a = ε b
    · simp [hab, two_mul]
    · simp [units_ne_iff_eq_neg.1 hab]
  -- κ_λ = ∑ (l_a² − (2ρ)_a²) / 4, and |(2ρ)_a| ≤ n.
  have cas_ge : -l.casimirValue ≤ card n ^ 3 / 4 := by
    have term (a : n) : -(card n ^ 2 / 4 : ℝ) ≤ (l a ^ 2 - twoRho l ⊤ a ^ 2) / 4 := by
      have h_abs : |(twoRho l ⊤ a : ℝ)| ≤ card n := mod_cast abs_twoRho_le _ a l
      nlinarith [abs_le.1 h_abs, sq_nonneg (l a : ℝ)]
    grw [HCParam.casimirValue, ← term]
    simp [pow_succ', mul_div_assoc]
  let C : ℝ := 2 * (card n * (N * (N + card n))) + card n ^ 3 / 4
  have sum_le : ∑ p : n × n, ‖ρ.E p.1 p.2 y‖ ^ 2 ≤ C * ‖y‖ ^ 2 := by
    unfold C
    nlinarith [sq_nonneg ‖y‖, hρ.casimirValue_mul_le y]
  -- Bound each `‖X a b‖` by `‖X‖`, square, and apply Cauchy–Schwarz over the pairs `(a, b)`.
  have h_norm : ‖ρ X y‖ ≤ ‖X‖ * ∑ p : n × n, ‖ρ.E p.1 p.2 y‖ := by
    simp only [ρ.apply_eq_sum X, LinearMap.sum_apply, LinearMap.smul_apply]
    grw [← sum_prod_type', norm_sum_le, norm_smul_le, norm_apply_le_l2_opNorm, ← mul_sum]
  refine (sq_le_sq₀ (norm_nonneg _) (by positivity)).1 ?_
  calc ‖ρ X y‖ ^ 2 ≤ ‖X‖ ^ 2 * (∑ p : n × n, ‖ρ.E p.1 p.2 y‖) ^ 2 := by grw [h_norm, mul_pow]
    _ ≤ ‖X‖ ^ 2 * (#(univ : Finset (n × n)) * (C * ‖y‖ ^ 2)) := by
        grw [sq_sum_le_card_mul_sum_sq, sum_le]
    _ ≤ ((card n + 1) ^ 4 * (L + 1 + s) * ‖X‖ * ‖y‖) ^ 2 := by
        -- The difference of the two sides is a polynomial with nonnegative coefficients.
        rw [← sub_nonneg, card_univ, card_prod, Nat.cast_mul]
        unfold C N
        ring_nf
        positivity

/-- Let the inner product be invariant and satisfy the Casimir lower bound
(`New.IsUnitaryCasimirGe`), `l` be a parameter of some gap, and `x` a `K`-highest vector of weight
`ν` with `|ν_a| ≤ L`. A matrix `X` sends a vector `y` of step `M_s` of the filtration to a vector of
`M_{s+1}` of norm at most `(card n + 1)⁴ (L + 1 + s) ‖X‖ ‖y‖`, with `‖X‖` the `L²` operator norm. -/
theorem HCParam.IsKHighest.norm_apply_le_of_mem_filtration (hx : l.IsKHighest ρ ν x)
    (h : IsUnitaryCasimirGe l ρ) [hg : l.HasGap A] (hL : ∀ a : n, |ν a| ≤ L)
    (hy : y ∈ ρ.filtration ε x s) (X : Matrix n n ℂ) :
    ρ X y ∈ ρ.filtration ε x (s + 1) ∧
    ‖ρ X y‖ ≤ (Fintype.card n + 1) ^ 4 * (L + 1 + s) * ‖X‖ * ‖y‖ :=
  ⟨apply_mem_filtration_succ hy X, hx.norm_apply_le_mul_norm h hL hy X⟩

end FiltrationNormBound

end New

/-!
## Growth of Ω_K along the filtration

A large gap of the parameter (`New.HCParam.HasLargeGap`: the gap is at least `gapThreshold n A`) is
assumed where the growth is proved.

* `New.IsDetectingFamily`: a finite family of operators that kills `M_kᗮ`, detects step `k` of the
  filtration, and bounds `Ω_K` from below by `c_K(Λ) + 2 k`.
-/

section CasimirGrowth

open Finset InnerProductSpace Submodule Fintype Complex New.GlModule Ring

/-- Let `ρ` be a gl_n-module structure on the inner product space `H`, let `l` have gap
`500 n³ + A`, and let `Λ = l.lowestKType`. Let the inner product be `𝔲(diag ε)`-invariant with
Casimir operator `ρ.casimirK 1 ≥ l.casimirValue`, and let `w` be a word of length at most one.
Suppose a `K`-highest vector `z` of weight `wordWeight Λ w` (`Λ` plus `Σ (e_a − e_b)` over `w`) is
orthogonal to step 0, `U(𝔨) x`, of the filtration generated by `x ∈ H`, but not to `ρ.word w x`.
Then the value `casimirKValue` of the compact Casimir operator at the weight of `z` exceeds its
value at `Λ` by at least `4 card n + 2`. -/
theorem New.casimirKValue_lowestKType_add_le {n : Type} [Fintype n] [DecidableEq n] {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] {ε : n → ℤˣ} {A : ℕ} {l : HCParam ε}
    {ρ : GlModule n H} {x z : H} [hl : l.HasLargeGap A] (hρ : IsUnitaryCasimirGe l ρ)
    (hz_perp : z ∈ (ρ.filtration ε x 0)ᗮ) {w : List (n × n)} (hw : w.length ≤ 1)
    (hz_high : l.IsKHighest ρ (wordWeight l.lowestKType w) z) (h_inner : ⟪ρ.word w x, z⟫_ℂ ≠ 0) :
    l.casimirKValue l.lowestKType + 4 * Fintype.card n + 2 ≤
      l.casimirKValue (wordWeight l.lowestKType w) := by
  match w, hw with
  | [], _ => cases h_inner (hz_perp _ self_mem_filtration)
  | [(a, b)], _ =>
    -- The root `(a, b)` is noncompact, since `ρ.E a b x` is not in `ρ.filtration ε x 0`.
    have hab : ε a ≠ ε b := fun e ↦ h_inner (hz_perp _ (E_mem_filtration self_mem_filtration e))
    have hab_ne : a ≠ b := ne_of_apply_ne ε hab
    have h_separated : 1000 * (Fintype.card n : ℤ) ^ 3 ≤ |l a - l b| := by
      have h_threshold := hl.gap a b hab
      rify [gapThreshold] at h_threshold ⊢
      linarith [A.cast_nonneg (α := ℝ)]
    -- The weight of `z` is `Λ + μ` with `μ = e_a - e_b`, and the Casimir bound applies to it.
    let μ : n → ℤ := Pi.single a 1 - Pi.single b 1
    have h_lower : -(Fintype.card n : ℤ) ^ 3 - 2 ≤ l a - l b := by
      have h_bound : 0 ≤ ∑ i : n, ((Fintype.card n : ℤ) ^ 2 + μ i * (μ i + l i)) :=
        hz_high.sum_card_sq_add_mul_nonneg hρ fun hz_zero ↦ h_inner (by simp [hz_zero])
      simp [μ, sum_add_distrib, mul_add, sub_mul, mul_sub, Pi.single_apply, hab_ne,
        hab_ne.symm] at h_bound
      linarith
    have h_casimir_diff : l.casimirKValue (wordWeight l.lowestKType [(a, b)]) =
        l.casimirKValue l.lowestKType + 2 * (l.lowestKType a - l.lowestKType b) + 2 +
          (twoRho l (fun i j ↦ ε i = ε j) a - twoRho l (fun i j ↦ ε i = ε j) b) := by
      simp [HCParam.casimirKValue, sub_mul, wordWeight, mul_add, Pi.single_apply, mul_sub,
        sum_add_distrib, add_mul, hab_ne, hab_ne.symm]
      ring
    -- By `h_separated` and `h_lower`, `l a - l b ≥ 1000 n³`. By `two_mul_lowestKType` the
    -- difference of the values differs from `l a - l b + 2` by counts `twoRho` of size at most `n`.
    grind [two_mul_lowestKType, twoRho, card_pos_iff.mpr ⟨a⟩, le_self_pow₀]

/-- Under `New.IsUnitaryCasimirGe l ρ` (only the invariance of the inner product is used), every
operator `ρ X` maps the orthogonal complement of step `k + 1` of the filtration into that of step
`k`. -/
theorem New.map_mem_orthogonal_filtration {n : Type} [Fintype n] [DecidableEq n] {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] {ε : n → ℤˣ} {l : HCParam ε} {ρ : GlModule n H}
    {x : H} (h : IsUnitaryCasimirGe l ρ) {k : ℕ} {a : H} {X : Matrix n n ℂ}
    (ha : a ∈ (ρ.filtration ε x (k + 1))ᗮ) : ρ X a ∈ (ρ.filtration ε x k)ᗮ := by
  -- The adjoint of `ρ.E c d` is `± ρ.E d c`, which raises the filtration by one step.
  have h_unit (c d : n) : ρ.E c d a ∈ (ρ.filtration ε x k)ᗮ := (mem_orthogonal' _ _).2 fun u hu ↦ by
    rw [h.inner_E_left, inner_left_of_mem_orthogonal (E_mem_filtration_succ hu) ha, mul_zero]
  rw [ρ.apply_eq_sum X]
  simp only [LinearMap.sum_apply, LinearMap.smul_apply]
  exact sum_mem fun c _ ↦ sum_mem fun d _ ↦ smul_mem _ (X c d) (h_unit c d)

/-- Let `l` have a large gap, the inner product be invariant with the lower bound for the Casimir
operator (`New.IsUnitaryCasimirGe l ρ`), and `x` be `K`-highest of weight
`Λ = l.lowestKType`. Let `P` commute with the compact `ρ.E c d`, have kernel `M_0ᗮ`, where
`M_0 = ρ.filtration ε x 0`, and satisfy `IsKInvariantForm` (that is, `⟪P u, P v⟫ = ⟪u, D v⟫` for an
operator `D` that commutes with the compact `ρ.E c d`). Suppose that the form of `Ω_K` at every
`P a` is `casimirKValue Λ * ‖P a‖²`. Then for `a ∈ M_0ᗮ` the sum of the `‖P (ρ.E q p a)‖²` over all
`(p, q)` is at most the sum of the real parts of the cross terms of `ρ.E d c (P (ρ.E q p a))` with
`P (⁅ρ.E q p, ρ.E d c⁆ a)`, over the compact pairs `(c, d)` and all `(p, q)`; both have a factor
2 in the statement. -/
theorem New.sum_norm_sq_le_sum_re_inner_lie {n : Type} [Fintype n] [DecidableEq n] {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] {ε : n → ℤˣ} {A : ℕ} {l : HCParam ε}
    {ρ : GlModule n H} {x : H} [hl : l.HasLargeGap A] (h : IsUnitaryCasimirGe l ρ)
    (hx : l.IsKHighest ρ l.lowestKType x) {P : Module.End ℂ H}
    (P_comm : ∀ c d : n, ε c = ε d → ∀ v : H, P (ρ.E c d v) = ρ.E c d (P v))
    (P_eq_zero : ∀ {a : H}, P a = 0 ↔ a ∈ (ρ.filtration ε x 0)ᗮ) (P_adj : IsKInvariantForm ε ρ ![P])
    (casimir_zero : ∀ a : H,
      (∑ c : n, ∑ d : n, if ε c = ε d then ‖ρ.E d c (P a)‖ ^ 2 else 0) =
        l.casimirKValue l.lowestKType * ‖P a‖ ^ 2)
    (a : H) (ha : a ∈ (ρ.filtration ε x 0)ᗮ) :
    ∑ p : n, ∑ q : n, 2 * ‖P (ρ.E q p a)‖ ^ 2 ≤
      ∑ p : n, ∑ q : n, ∑ c : n, ∑ d : n with ε c = ε d,
        2 * re ⟪ρ.E d c (P (ρ.E q p a)), P (⁅ρ.E q p, ρ.E d c⁆ a)⟫_ℂ := by
  have : ∀ s : ℕ, Module.Finite ℂ ↥(ρ.filtration ε x s) := hx.finite_filtration h
  let M : ℕ → Submodule ℂ H := ρ.filtration ε x
  -- Only the component `y` of `a` in `M 1` contributes.
  obtain ⟨y, hy, z, hz, rfl⟩ := (M 1).exists_add_mem_mem_orthogonal a
  rw [add_mem_cancel_right (orthogonal_le le_sup_left hz)] at ha
  have h_component (X : Matrix n n ℂ) : P (ρ X (y + z)) = P (ρ X y) := by
    rw [map_add, map_add, P_eq_zero.mpr (map_mem_orthogonal_filtration h hz), add_zero]
  -- `N` is the left side at `y` up to the factor 2, `C` the cross term and `R` the square of the
  -- commutator term.
  let N : ℝ := ∑ p : n, ∑ q : n, ‖P (ρ.E q p y)‖ ^ 2
  let C : ℝ := ∑ p : n, ∑ q : n, ∑ c : n, ∑ d : n with ε c = ε d,
    re ⟪ρ.E d c (P (ρ.E q p y)), P (⁅ρ.E q p, ρ.E d c⁆ y)⟫_ℂ
  let R : ℝ := ∑ p : n, ∑ q : n, ∑ c : n, ∑ d : n with ε c = ε d,
    ‖P (⁅ρ.E d c, ρ.E q p⁆ y)‖ ^ 2
  suffices h_NC : N ≤ C by
    simpa [N, C, -map_sub, -map_add, ← map_bracket, h_component, ← mul_sum, lie_def] using h_NC
  -- On `M 1 ⊖ M 0`, `Ω_K` gains at least `4 n + 2`: `casimirKValue_lowestKType_add_le` gives this
  -- on highest vectors, and `casimirK_bound_of_highest` extends it to all vectors.
  have hU_stable : ∀ c d : n, ε c = ε d → M 1 ⊓ (M 0)ᗮ ∈ (ρ.E c d).invtSubmodule := by
    simp_all [← P_eq_zero, M, Module.End.mem_invtSubmodule_iff_forall_mem_of_mem, E_mem_filtration]
  have lower : (l.casimirKValue l.lowestKType + 4 * Fintype.card n + 2) * N ≤
      ∑ p : n, ∑ q : n, ∑ c : n, ∑ d : n with ε c = ε d, ‖P (ρ.E q p (ρ.E d c y))‖ ^ 2 := by
    have h_form : ∑ p : n, ∑ q : n, re ⟪P (ρ.E q p y), P (ρ.E q p (ρ.casimirK ε y))⟫_ℂ =
        ∑ p : n, ∑ q : n, ∑ c : n, ∑ d : n with ε c = ε d, ‖P (ρ.E q p (ρ.E d c y))‖ ^ 2 := by
      simpa [sum_prod_type, ← ofReal_pow] using
        congrArg re ((P_adj.mul_E h).sum_inner_casimirK h y y)
    simpa [N, sum_prod_type, h_form] using hx.casimirK_bound_of_highest h 1
      (l.casimirKValue l.lowestKType + 4 * card n + 2) inf_le_left hU_stable (P_adj.mul_E h)
      ⟨hy, ha⟩ fun w ⟨u, hu, hu_high, h_inner⟩ hw ↦ by
        simpa using Int.cast_mono (R := ℝ)
          (casimirKValue_lowestKType_add_le h hu.2 hw hu_high h_inner)
  -- By `map_single_mul_single` a commutator is a difference of two terms, each zero for all but
  -- `n` pairs `(c, d)`.
  have upper : R ≤ 4 * Fintype.card n * N := by
    calc R ≤ ∑ p : n, ∑ q : n, ∑ c : n, ∑ d : n,
          2 * (‖P ((if c = q then ρ.E d p else 0) y)‖ ^ 2 +
            ‖P ((if p = d then ρ.E q c else 0) y)‖ ^ 2) := by
          simp only [R, lie_def, ← map_bracket, map_sub, map_single_mul_single,
            LinearMap.sub_apply]
          grw [filter_subset, norm_sub_le, add_sq_le]
      _ = 4 * Fintype.card n * N := by
          simp [N, DFunLike.ite_apply, apply_ite (‖P ·‖), sum_add_distrib, ← mul_sum, mul_add]
          rw [sum_comm]
          ring
  -- Expand the square of `P (E_qp E_dc y) = E_dc (P (E_qp y)) + P (⁅E_qp, E_dc⁆ y)`.
  have h_square (p q c d : n) (hcd : ε d = ε c) : ‖P (ρ.E q p (ρ.E d c y))‖ ^ 2 =
      ‖ρ.E d c (P (ρ.E q p y))‖ ^ 2 +
        2 * re ⟪ρ.E d c (P (ρ.E q p y)), P (⁅ρ.E q p, ρ.E d c⁆ y)⟫_ℂ +
        ‖P (⁅ρ.E d c, ρ.E q p⁆ y)‖ ^ 2 := by
    simp [lie_def, P_comm d c hcd, norm_sub_sq (𝕜 := ℂ), ← ofReal_pow]
    ring
  have expand : (∑ p : n, ∑ q : n, ∑ c : n, ∑ d : n with ε c = ε d,
      ‖P (ρ.E q p (ρ.E d c y))‖ ^ 2) = l.casimirKValue l.lowestKType * N + 2 * C + R := by
    simp +contextual [N, C, R, h_square, casimir_zero, sum_filter, ite_add_zero, sum_add_distrib,
      mul_sum]
  linarith

/-- A finite family `J` of operators detects step `k` of the filtration
`M_s = ρ.filtration ε x s`. Write `c_K(Λ)` for `l.casimirKValue l.lowestKType`. -/
structure New.IsDetectingFamily {n : Type} [Fintype n] [DecidableEq n] {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] {ε : n → ℤˣ} (l : HCParam ε)
    (ρ : GlModule n H) (x : H) (k : ℕ) {I : Type} [Fintype I] (J : I → Module.End ℂ H) :
    Prop where
  /-- The form `∑ ⟪J_i u, J_i v⟫` is given by an operator that commutes with `𝔨`. -/
  isKInvariantForm : IsKInvariantForm ε ρ J
  /-- Every `J_i` kills the orthogonal complement of `M_k`. -/
  apply_eq_zero : ∀ a ∈ (ρ.filtration ε x k)ᗮ, ∀ i : I, J i a = 0
  /-- On the orthogonal complement of `M_k`, the cross term between `J_i` and one further factor
  `E_qp` is at least `∑ ‖J_i E_qp a‖²`. -/
  cross_term_bound : ∀ a ∈ (ρ.filtration ε x k)ᗮ, ∀ i : I,
    ∑ p : n, ∑ q : n, 2 * ‖J i (ρ.E q p a)‖ ^ 2 ≤
      ∑ p : n, ∑ q : n, ∑ c : n, ∑ d : n with ε c = ε d,
        2 * re ⟪ρ.E d c (J i (ρ.E q p a)), J i (⁅ρ.E q p, ρ.E d c⁆ a)⟫_ℂ
  /-- A vector orthogonal to the earlier steps and killed by every `J_i` is orthogonal to `M_k`. -/
  mem_orthogonal : ∀ a : H, (∀ m < k, a ∈ (ρ.filtration ε x m)ᗮ) → (∀ i : I, J i a = 0) →
    a ∈ (ρ.filtration ε x k)ᗮ
  /-- On vectors orthogonal to the earlier steps, `c_K(Λ) + 2 k` bounds the form of `J` at `Ω_K`
  from below, even after the squares of the commutator terms are subtracted. -/
  casimirK_bound : ∀ a : H, (∀ m < k, a ∈ (ρ.filtration ε x m)ᗮ) →
    (l.casimirKValue l.lowestKType + 2 * k) * ∑ i : I, ‖J i a‖ ^ 2 ≤
      ∑ i : I, ∑ c : n, ∑ d : n with ε c = ε d,
        (‖J i (ρ.E d c a)‖ ^ 2 - ‖⁅ρ.E d c, J i⁆ a‖ ^ 2)

/-- Assume the inner product on `H` is invariant under 𝔲(diag ε) and the Casimir operator
`ρ.casimirK 1` is bounded below by `l.casimirValue` (`New.IsUnitaryCasimirGe l ρ`). If a finite
family `J i` detects step `k` of the filtration `ρ.filtration ε x` generated by `x`, in the sense of
`New.IsDetectingFamily`, then the family of all products `J i * ρ.E q p`, indexed by `(p, q, i)`,
detects step `k + 1`. -/
theorem New.IsDetectingFamily.mul_E {n : Type} [Fintype n] [DecidableEq n] {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] {ε : n → ℤˣ} {l : HCParam ε}
    {ρ : GlModule n H} {x : H} {k : ℕ} {I : Type} [Fintype I] {J : I → Module.End ℂ H}
    (h : IsUnitaryCasimirGe l ρ) (hJ : IsDetectingFamily l ρ x k J) :
    IsDetectingFamily l ρ x (k + 1) fun ((p, q, i) : n × n × I) ↦ J i * ρ.E q p := by
  -- Each `ρ.E q p` lowers orthogonality to the steps of the filtration by one step.
  have h_lower {a : H} (ha : ∀ m < k + 1, a ∈ (ρ.filtration ε x m)ᗮ) (p q : n) :
      ∀ m < k, ρ.E q p a ∈ (ρ.filtration ε x m)ᗮ :=
    fun m hm ↦ map_mem_orthogonal_filtration h (ha (m + 1) (by omega))
  refine { isKInvariantForm := hJ.isKInvariantForm.mul_E h,
           apply_eq_zero := fun a ha ⟨p, q, i⟩ ↦
             hJ.apply_eq_zero (ρ.E q p a) (map_mem_orthogonal_filtration h ha) i,
           cross_term_bound := ?_, mem_orthogonal := fun a ha h_zero ↦ ?_,
           casimirK_bound := fun a ha ↦ ?_ }
  · -- The commutators map `a` into the kernel of `J i`, so `ρ.E q p` moves next to `a`.
    rintro a ha ⟨p, q, i⟩
    have h_kill (X : Matrix n n ℂ) : J i (ρ X a) = 0 :=
      hJ.apply_eq_zero (ρ X a) (map_mem_orthogonal_filtration h ha) i
    have h_swap (Y : Matrix n n ℂ) : J i (ρ Y (ρ.E q p a)) = J i (ρ.E q p (ρ Y a)) := by
      rw [ρ.apply_apply_eq_swap_add_bracket, map_add, h_kill, add_zero]
    simpa [h_swap, ← map_bracket, -map_sub, lie_def] using
      hJ.cross_term_bound (ρ.E q p a) (map_mem_orthogonal_filtration h ha) i
  · -- All `ρ.E q p a` are orthogonal to step `k`, so `a` is orthogonal to step `k + 1`.
    have h_image (p q : n) : a ∈ ((ρ.filtration ε x k).map (ρ.E p q))ᗮ := by
      rintro _ ⟨u, hu, rfl⟩
      simp [h.inner_E_left,
        hJ.mem_orthogonal (ρ.E q p a) (h_lower ha p q) (fun i ↦ h_zero (p, q, i)) u hu]
    simp [filtration, ← inf_orthogonal, ← iInf_orthogonal, ha k k.lt_succ_self, h_image]
  · -- The bound at level `k` for each `ρ.E q p a`, plus the cross-term bound for `a`.
    have h_level :
        ∑ p : n, ∑ q : n,
            (l.casimirKValue l.lowestKType + 2 * k) * ∑ i : I, ‖J i (ρ.E q p a)‖ ^ 2 ≤
          ∑ p : n, ∑ q : n, ∑ i : I, ∑ c : n, ∑ d : n with ε c = ε d,
            (‖J i (ρ.E d c (ρ.E q p a))‖ ^ 2 - ‖⁅ρ.E d c, J i⁆ (ρ.E q p a)‖ ^ 2) :=
      sum_mono fun p ↦ sum_mono fun q ↦ hJ.casimirK_bound (ρ.E q p a) (h_lower ha p q)
    have h_cross :
        ∑ i : I, ∑ p : n, ∑ q : n, 2 * ‖J i (ρ.E q p a)‖ ^ 2 ≤
          ∑ i : I, ∑ p : n, ∑ q : n, ∑ c : n, ∑ d : n with ε c = ε d,
            2 * re ⟪ρ.E d c (J i (ρ.E q p a)), J i (⁅ρ.E q p, ρ.E d c⁆ a)⟫_ℂ :=
      sum_mono fun i ↦ hJ.cross_term_bound a (ha k k.lt_succ_self) i
    -- Expand the square of `⁅E_dc, J_i E_qp⁆ a = ⁅E_dc, J_i⁆ (E_qp a) + J_i ⁅E_dc, E_qp⁆ a`.
    have h_expand (i : I) (p q c d : n) :
        ‖J i (ρ.E q p (ρ.E d c a))‖ ^ 2 - ‖⁅ρ.E d c, J i * ρ.E q p⁆ a‖ ^ 2 =
          ‖J i (ρ.E d c (ρ.E q p a))‖ ^ 2 - ‖⁅ρ.E d c, J i⁆ (ρ.E q p a)‖ ^ 2 +
            2 * re ⟪ρ.E d c (J i (ρ.E q p a)), J i (⁅ρ.E q p, ρ.E d c⁆ a)⟫_ℂ := by
      simp [lie_def, norm_sub_sq (𝕜 := ℂ)]
      ring
    simp only [sum_prod_type, Module.End.mul_apply, h_expand, sum_add_distrib]
    simpa [↓sum_comm (α := I), mul_add, add_mul, ← mul_sum, sum_add_distrib, add_assoc]
      using add_le_add h_level h_cross

/-- Let `l` be a parameter for the signs `ε` with gap `500 n³ + A` (`l.HasLargeGap A`). Assume the
inner product is invariant under 𝔲(diag ε) and the Casimir operator is bounded below by
`l.casimirValue` (`New.IsUnitaryCasimirGe l ρ`), and let `x` be `K`-highest of weight
`Λ = l.lowestKType`. Then for each `k` some finite family of operators on `H` detects step `k` of
the filtration `ρ.filtration ε x` generated by `x`, in the sense of `New.IsDetectingFamily`. -/
theorem New.exists_detecting_family {n : Type} [Fintype n] [DecidableEq n] {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] {ε : n → ℤˣ} {A : ℕ} {l : HCParam ε}
    {ρ : GlModule n H} {x : H} [hl : l.HasLargeGap A] (h : IsUnitaryCasimirGe l ρ)
    (hx : l.IsKHighest ρ l.lowestKType x) (k : ℕ) :
    ∃ (I : Type) (_ : Fintype I) (J : I → Module.End ℂ H), IsDetectingFamily l ρ x k J := by
  -- Take the operators `P * E₁ * ⋯ * E_k`, with `P` the projection onto `ρ.filtration ε x 0`.
  induction k with
  | succ k ih =>
    obtain ⟨I, _, J, hJ⟩ := ih
    exact ⟨n × n × I, inferInstance, _, hJ.mul_E h⟩
  | zero =>
    have : Module.Finite ℂ (ρ.filtration ε x 0) := hx.finite_filtration h 0
    let P : H →ₗ[ℂ] H := (ρ.filtration ε x 0).starProjection.toLinearMap
    have P_comm (c d : n) (e : ε c = ε d) (v : H) : P (ρ.E c d v) = ρ.E c d (P v) :=
      eq_starProjection_of_mem_of_inner_eq_zero (E_mem_filtration (coe_mem _) e) fun w hw ↦ by
        simp [P, ← map_sub, h.inner_E_left,
          starProjection_inner_eq_zero v _ (E_mem_filtration hw e.symm)]
    have P_eq_zero {a : H} : P a = 0 ↔ a ∈ (ρ.filtration ε x 0)ᗮ :=
      starProjection_apply_eq_zero_iff _
    have P_adj : IsKInvariantForm ε ρ ![P] :=
      ⟨P * P, fun c d e ↦ LinearMap.ext fun v ↦ by simp [P_comm c d e],
        fun u v ↦ by simp [P, inner_starProjection_left_eq_right]⟩
    -- `Ω_K` is the scalar `l.casimirKValue l.lowestKType` on `ρ.filtration ε x 0`.
    have casimir_zero (a : H) : (∑ c : n, ∑ d : n, if ε c = ε d then ‖ρ.E d c (P a)‖ ^ 2 else 0) =
        l.casimirKValue l.lowestKType * ‖P a‖ ^ 2 := by
      have eigen : ρ.casimirK ε (P a) = (l.casimirKValue l.lowestKType : ℂ) • P a :=
        casimirK_eq_smul_of_mem_filtration (coe_mem _) hx.casimirK_eq_smul
      simpa +contextual [h.inner_casimir, sum_filter, -Units.val_mul, ← ofReal_pow]
        using congrArg (fun v ↦ re ⟪P a, v⟫_ℂ) eigen
    refine ⟨Fin 1, inferInstance, ![P], P_adj, fun a ha 0 ↦ P_eq_zero.mpr ha,
      fun a ha 0 ↦ sum_norm_sq_le_sum_re_inner_lie h hx P_comm P_eq_zero P_adj casimir_zero a ha,
      fun a _ h_zero ↦ P_eq_zero.mp (h_zero 0), fun a _ ↦ ?_⟩
    -- `P` commutes with the compact `ρ.E d c`, so the bound is the equality `casimir_zero`.
    simp +contextual [sum_filter, P_comm, casimir_zero, lie_def]

/-- `Ω_K` grows along the filtration `M_s = New.GlModule.filtration`. Let `l` have a large gap
(`New.HCParam.HasLargeGap`), the inner product be invariant with the lower bound for the Casimir
operator, and `x` be `K`-highest of weight `Λ`. An eigenvector `a` of `Ω_K` with real eigenvalue
`θ ≤ c_K(Λ) + s` that is orthogonal to `M_s` is orthogonal to every `M_t`. -/
theorem New.mem_orthogonal_filtration_of_casimirK {n : Type} [Fintype n] [DecidableEq n] {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] {ε : n → ℤˣ} {A : ℕ} {l : HCParam ε}
    {ρ : GlModule n H} {x : H} {θ : ℝ} (s : ℕ) [hl : l.HasLargeGap A] (h : IsUnitaryCasimirGe l ρ)
    (hx : l.IsKHighest ρ l.lowestKType x) (a : H) (ha : ρ.casimirK ε a = (θ : ℂ) • a)
    (hθ : θ ≤ l.casimirKValue l.lowestKType + s) (ha_perp : a ∈ (ρ.filtration ε x s)ᗮ) (t : ℕ) :
    a ∈ (ρ.filtration ε x t)ᗮ := by
  -- By induction `a` is orthogonal to the steps before `t`; test it with the family of level `t`.
  induction t using Nat.strong_induction_on with
  | _ t ih
  obtain ⟨I, _, J, hJ⟩ := exists_detecting_family h hx t
  by_cases h_zero : ∀ i : I, J i a = 0
  · exact hJ.mem_orthogonal a ih h_zero
  -- If `J` does not kill `a`, then `c_K(Λ) + 2 t ≤ θ ≤ c_K(Λ) + s`, so `t ≤ s`.
  obtain ⟨i, hi⟩ := not_forall.1 h_zero
  have h_pos : 0 < ∑ i : I, ‖J i a‖ ^ 2 :=
    sum_pos' (fun j _ ↦ sq_nonneg ‖J j a‖) ⟨i, mem_univ i, by positivity⟩
  have h_eigen : θ * ∑ i : I, ‖J i a‖ ^ 2 =
      ∑ i : I, ∑ c : n, ∑ d : n with ε c = ε d, ‖J i (ρ.E d c a)‖ ^ 2 := by
    simpa [ha, ← ofReal_pow, ← mul_sum] using
      congrArg re (hJ.isKInvariantForm.sum_inner_casimirK h a a)
  have h_le : (l.casimirKValue l.lowestKType + 2 * t) * ∑ i : I, ‖J i a‖ ^ 2 ≤
      θ * ∑ i : I, ‖J i a‖ ^ 2 :=
    ((hJ.casimirK_bound a ih).trans (by gcongr; exact sub_le_self _ (sq_nonneg _))).trans_eq
      h_eigen.symm
  refine orthogonal_le (filtration_mono ((Nat.cast_le (α := ℝ)).1 ?_)) ha_perp
  linarith [le_of_mul_le_mul_right h_le h_pos, t.cast_nonneg (α := ℝ)]

end CasimirGrowth

/-!
## Analytic vectors and adjoints for invariant forms

The vanishing of coefficient maps on highest vectors, and links between a representation `ϖ` of
`New.USign ε`, the unitary group of `diag ε`, and the `gl n`-module `ρ` that is its derivative
along `ι` (`New.IsDerivedAction`).

* `New.IsDerivedAction.isCoeffMap`: `g ↦ φ ∘ ϖ g ∘ ι` is a coefficient map for each continuous
  linear `φ`.
-/

section AnalyticVectors

open Matrix InnerProductSpace Fintype Norms.L2Operator Real Int

namespace New

variable {n : Type} [Fintype n] [DecidableEq n]
  {M X H : Type*} [AddCommGroup M] [Module ℂ M]
  {ε : n → ℤˣ} {l : HCParam (n := n) ε}
  {ρ : GlModule n M} [NormedAddCommGroup X] [NormedSpace ℂ X] [NormedAddCommGroup H]
  {ϖ : USign ε →* X →L[ℂ] X} {ι : M →ₗ[ℂ] X} {B : X →L⋆[ℂ] X →L[ℂ] ℂ} {A : ℕ}

/-- A coefficient map that vanishes at `1` on the filtration of a `K`-highest vector vanishes on
that vector everywhere. Let `x` be `K`-highest of weight `ν` in a `gl n`-module whose inner product
is invariant under `𝔲(ε)` and satisfies the Casimir lower bound for the parameter `l` of gap `gap`
(`New.IsUnitaryCasimirGe l ρ`). Let `c` be a scalar coefficient map (the derivative of
`t ↦ c (g exp tY) v` is `c (g exp tY) (ρ Y v)`) with `‖c g v‖ ≤ D ‖v‖`. If `c 1` vanishes on every
step of the filtration generated by `x`, then `c g x = 0` for all `g`. -/
theorem HCParam.IsKHighest.coeffMap_eq_zero [InnerProductSpace ℂ H] {ρ : GlModule n H} {ν : n → ℤ}
    {x : H} {D : ℝ} {gap : ℕ} [l.HasGap gap] (hx : l.IsKHighest ρ ν x)
    (h_inv : IsUnitaryCasimirGe l ρ)
    {c : USign ε → H →ₗ[ℂ] ℂ} (h_coef : ρ.IsCoeffMap c)
    (h_bdd : ∀ (g : USign ε) (v : H), ‖c g v‖ ≤ D * ‖v‖)
    (h_one : ∀ s : ℕ, ∀ v ∈ ρ.filtration ε x s, c 1 v = 0) (g : USign ε) :
    c g x = 0 := by
  -- Every `g` is a product of two exponentials, so it suffices to show: if `c g` kills all steps
  -- of the filtration, then so does `c (g * expU Y)`.
  obtain ⟨R, hR⟩ : ∃ R : ℕ, ∀ i, |ν i|.toNat ≤ R := Finite.exists_le _
  obtain ⟨Y₁, Y₂, rfl⟩ := exists_eq_expU_mul_expU g
  suffices h_step : ∀ Y g, (∀ s, ∀ v ∈ ρ.filtration ε x s, c g v = 0) →
      ∀ s, ∀ v ∈ ρ.filtration ε x s, c (g * expU Y) v = 0 by
    simpa using h_step Y₂ _ (h_step Y₁ 1 h_one) 0 x ρ.self_mem_filtration
  intro Y g hg
  let growth : ℝ := (card n + 1) ^ 4 * ‖Y.1‖
  let decay (t : ℝ) : ℝ := exp (-exp 1 * (growth + 1) * t)
  -- `f_v t = c (g * expU (t • Y)) v` has `f_v 0 = 0` and `f_v' = f_{Y v}`. For every `m` it stays
  -- below this barrier, by downward induction on `s`.
  have h_bound (m s : ℕ) : ∀ v ∈ ρ.filtration ε x s, ∀ t ∈ Set.Icc (0 : ℝ) 1,
      ‖c (g * expU (t • Y)) v‖ ≤ exp (m * -decay t) * (exp (R + 1 + s) * (|D| * ‖v‖ + 1)) := by
    induction hk : m - s using Nat.strong_induction_on generalizing s with | _ k ih => ?_
    intro v hv
    have hYv_le : ‖ρ Y v‖ ≤ (card n + 1) ^ 4 * (R + 1 + s) * ‖Y.1‖ * ‖v‖ :=
      hx.norm_apply_le_mul_norm h_inv (fun i ↦ toNat_le.1 (hR i)) hv Y
    refine image_norm_le_of_norm_deriv_right_lt_deriv_boundary
      (HasDerivAt.continuousOn fun t _ ↦ h_coef g Y v t)
      (fun t _ ↦ (h_coef g Y v t).hasDerivWithinAt)
      (by simp [hg s v hv]; positivity) (fun _ ↦ hasDerivAt_deriv_iff.2 (by fun_prop))
      fun t ⟨ht_nonneg, ht_lt⟩ h_touch ↦ ?_
    -- where `f_v` touches the barrier, `‖f_v t‖ ≤ D * ‖v‖` forces `R + 1 + s < m * decay t ≤ m`
    have h_lt : R + 1 + s < m * decay t := by
      have h_le := h_touch.ge
      grw [h_bdd, le_abs_self D, lt_add_one (_ * _)] at h_le
      simpa [← exp_add, field] using h_le
    have hs : s < m := by
      rify
      nlinarith [show decay t ≤ 1 by simp [decay]; positivity]
    -- `‖Y v‖ ≤ growth * (R + 1 + s) * ‖v‖`, and `R + 1 + s` is below `m * decay t`
    have h_deriv_lt : |D| * ‖ρ Y v‖ + 1 < (growth + 1) * (m * decay t) * (|D| * ‖v‖ + 1) := by
      grw [hYv_le, ← h_lt, ← sub_nonneg]
      simp only [growth]
      ring_nf
      positivity
    -- as `s < m` the induction hypothesis bounds `f_v' = f_{Y v}` below the barrier's derivative
    calc _ ≤ exp (m * -decay t) * (exp (R + 1 + (s + 1 : ℕ)) * (|D| * ‖ρ Y v‖ + 1)) :=
          ih _ (by omega) (s + 1) rfl _ (GlModule.apply_mem_filtration_succ hv Y) t
            ⟨ht_nonneg, ht_lt.le⟩
      _ < exp (m * -decay t) * (exp (R + 1 + (s + 1 : ℕ)) *
          ((growth + 1) * (m * decay t) * (|D| * ‖v‖ + 1))) := by gcongr
      _ = deriv (fun t ↦ exp (m * -decay t) * (exp (R + 1 + s) * (|D| * ‖v‖ + 1))) t := by
          simp (disch := fun_prop) [decay, exp_add]
          ring
  -- at `t = 1` the barriers are summable in `m`, so the constant that they bound is `0`
  intro s v hv
  simpa using (summable_const_iff _).1 <|
    (Summable.mul_right _ (summable_exp_nat_mul_iff.2 (neg_lt_zero.2 (exp_pos _)))).of_norm_bounded
      fun m ↦ h_bound m s v hv 1 (by simp)

/-- If `ρ` is the derivative of `ϖ` along `ι` (at `1`), then `v ↦ φ (ϖ g (ι v))` is a coefficient
map for `ρ` (at every point of the group), for each continuous linear map `φ`. -/
theorem IsDerivedAction.isCoeffMap (hd : IsDerivedAction ϖ ι ρ) [NormedSpace ℂ H] (φ : X →L[ℂ] H) :
    ρ.IsCoeffMap fun g : U (signMatrix ε) ↦ (φ ∘L ϖ g).toLinearMap ∘ₗ ι := by
  intro g Y v t
  -- one-parameter group law, to move the base point of the derivative from `0` to `t`
  have h_exp (s : ℝ) : expU (s • Y) = expU (t • Y) * expU ((s - t) • Y) := by
    ext; simp [← exp_add_of_commute, ← add_smul, commute_iff_eq, smul_comm t]
  have h_shift : HasDerivAt (fun s : ℝ ↦ ϖ (expU ((s - t) • Y)) (ι v)) (ι (ρ Y v)) t :=
    .comp_sub_const t t (by simpa using hd Y v)
  have h_fun (s : ℝ) : φ (ϖ (g * expU (s • Y)) (ι v)) =
      (φ ∘L ϖ (g * expU (t • Y))) (ϖ (expU ((s - t) • Y)) (ι v)) := by
    simp [rep_apply_apply, -map_mul, mul_assoc, ← h_exp]
  simpa [h_fun, -map_mul] using h_shift.map_clm (φ ∘L ϖ (g * expU (t • Y)))
 
/-- The invariant form `B` of a unitary representation `ϖ` (`New.IsUnitaryRep A ϖ B`: `B` is
conjugate symmetric, positive definite and `ϖ`-invariant; `A` is not used here) is the inner product
of an inner product space `H`, in the universe of `X` and linearly isomorphic to `X`, and the group
acts by isometries of its norm. `H` need not be complete, and `j` need not be a homeomorphism. Here
`type_of% X` is the type universe in which `X` lives. -/
theorem IsUnitaryRep.exists_innerProductSpace (hp : IsUnitaryRep A ϖ B) :
    ∃ (H : type_of% X) (_ : NormedAddCommGroup H) (_ : InnerProductSpace ℂ H) (j : X ≃ₗ[ℂ] H),
      (∀ x y : X, ⟪j x, j y⟫_ℂ = B x y) ∧ ∀ (g : USign ε) (x : X), ‖j (ϖ g x)‖ = ‖j x‖ := by
  -- Take `X` itself, with the norm and the inner product defined by `B`, and `j = 1`.
  let core : InnerProductSpace.Core ℂ X :=
    { inner x y := B x y
      conj_inner_symm x y := hp.conj_symm y x
      re_inner_nonneg x := by by_cases hx : x = 0 <;> simp [hx, hp.pos, le_of_lt]
      add_left := by simp
      smul_left := by simp
      definite x hx := by_contra fun h_ne ↦ by simpa [hx] using hp.pos x h_ne }
  refine ⟨X, Core.toNormedAddCommGroup (cd := core), .ofCore _, 1, fun x y ↦ rfl, fun g x ↦ ?_⟩
  -- the new norm is `√(B x x).re`, and `B` is invariant
  exact congrArg Real.sqrt (congrArg Complex.re (hp.invariant g x x))

/-- For a form `B` invariant under `ϖ` (`New.IsUnitaryRep A ϖ B`; only the invariance is used), the
adjoint of `ϖ g` is `ϖ g⁻¹`. -/
theorem IsUnitaryRep.form_apply_eq_form_inv_apply (hp : IsUnitaryRep A ϖ B) (g : USign ε)
    (x y : X) : B x (ϖ g y) = B (ϖ g⁻¹ x) y := by
  simp [← hp.invariant g⁻¹ x, rep_apply_apply]

/-- For the invariant form `B` (`New.IsUnitaryRep A ϖ B`: conjugate symmetric, positive definite,
`ϖ`-invariant) of a representation `ϖ` with derivative `ρ` along `ι`, the adjoint of `E a b` is
`ε a ε b E b a`. -/
theorem IsDerivedAction.form_E_eq_sign_mul (hp : IsUnitaryRep A ϖ B)
    (hd : IsDerivedAction ϖ ι ρ) (a b : n) (v w : M) :
    B (ι (ρ.E a b v)) (ι w) = (ε a * ε b).val * B (ι v) (ι (ρ.E b a w)) := by
  -- Differentiating `B (ϖ (exp tY) v) w = B v (ϖ (exp (-tY)) w)` at `t = 0`: the Lie algebra of
  -- `U(ε)` acts by skew operators.
  have h_skew (Y : unitaryLie (signMatrix ε)) : B (ι (ρ Y.1 v)) (ι w) = -B (ι v) (ι (ρ Y.1 w)) := by
    have h_inv (Z : unitaryLie (signMatrix ε)) : expU (-Z) = (expU Z)⁻¹ := by
      simp [Subtype.ext_iff, Units.ext_iff, ← Matrix.exp_neg]
    refine HasDerivAt.unique (f := fun t : ℝ ↦ B (ϖ (expU (t • Y)) (ι v)) (ι w)) (x := 0) ?_ ?_
    · simpa [hp.conj_symm] using ((hd Y v).map_clm (B (ι w))).star
    · simpa [h_inv, hp.form_apply_eq_form_inv_apply] using (hd (-Y) w).map_clm (B (ι v))
  have h_mem (z : ℂ) :
      (z * ε b) • single a b 1 - (star z * ε a) • single b a 1 ∈ unitaryLie (signMatrix ε) := by
    ext i j
    simp [signMatrix]
    grind
  have key (z : ℂ) : star z * ε b * B (ι (ρ.E a b v)) (ι w) - z * ε a * B (ι (ρ.E b a v)) (ι w) =
      star z * ε a * B (ι v) (ι (ρ.E b a w)) - z * ε b * B (ι v) (ι (ρ.E a b w)) := by
    simpa [-smul_single] using h_skew ⟨_, h_mem z⟩
  have h_I : star Complex.I = -.I := Complex.conj_I
  -- in `key 1 + I * key I` the terms with `ρ.E b a v` and `ρ.E a b w` cancel
  push_cast
  grind [key 1, key .I, star_one ℂ, Complex.I_mul_I,
    show (ε b : ℂ) * ε b = 1 from mod_cast Int.units_coe_mul_self (ε b)]

end New

