import Lib.Cohomology.ProperBaseChange.LineCharts

/-!
# Splitting absolutely integrally closed subrings with a Mayer–Vietoris sequence

This file gives a splitting step in an induction over the absolutely integrally closed subrings of
an algebraically closed field `K` that contain the image of `γ : D →+* K`. A subring `B` of this
kind that is not a valuation ring is replaced by the integral closures of `B[t]` and `B[1 / t]`,
as in the cover of a projective line by two charts. These two larger rings fit into a short exact
Mayer–Vietoris sequence of locally constant `ZMod ℓ`-valued functions on the spectra modulo `J`.

## Main definitions and results

* `New.Variety.absIntegrallyClosedSubrings`: the absolutely integrally closed subrings of `K`
  containing the image of `γ`.
* `New.Variety.absIntegrallyClosedSubrings.quotientFunctor`: the functor `B ↦ B / J B` on these
  subrings.
* `New.Variety.absIntegrallyClosedSubrings.exists_isSplitting_isMayerVietorisExact`: the two larger
  rings and a short exact Mayer–Vietoris sequence of locally constant `ZMod ℓ`-valued functions on
  the spectra modulo `J`.

Notions from other files:
* `New.Variety.IsAbsIntegrallyClosed`: A is absolutely integrally closed: every monic polynomial
  over A of positive degree has a root in A.
* `New.ThePrime`: `ThePrime ℓ` fixes the prime `ℓ` (it extends `Fact ℓ.Prime`).
* `New.Variety.locConstSpec`: For an abelian group Λ, the functor on commutative rings sending A to
  the group of locally constant functions Spec A → Λ; it sends a ring map to pull-back along the map
  of spectra.
* `New.Variety.IsLineChartCase` (in `Lib.Cohomology.ProperBaseChange.LineCharts`): the condition on
  the chart `R[1 / a]` of a line modulo an ideal `I` of `R`.

## Relation to the literature

Known; see `Lib.Cohomology.ProperBaseChange.Theorem` for sources.
-/

section SubringSplitting

namespace New.Variety

open CategoryTheory CommRingCat Subring Ideal.Quotient IsLocalization Away PrimeSpectrum Fact
  LocallyConstant IsLocalRing Ideal LocalSubring

variable {ℓ : ℕ} {K : Type} [ThePrime ℓ] [Field K] {S T U : Subring K}
  [h : Fact (S ≤ T)] {D : CommRingCat} (J : Ideal D) (γ : D →+* K)

/-- The absolutely integrally closed subrings of `K` that contain the image of `γ`. -/
def absIntegrallyClosedSubrings : Set (Subring K) :=
  {B : Subring K | γ.range ≤ B ∧ IsAbsIntegrallyClosed B}

lemma absIntegrallyClosedSubrings.range_le {γ : D →+* K} (B : absIntegrallyClosedSubrings γ) :
  γ.range ≤ B.val := B.prop.1

lemma absIntegrallyClosedSubrings.isAbsIntegrallyClosed {γ : D →+* K}
    (B : absIntegrallyClosedSubrings γ) : IsAbsIntegrallyClosed B.val := B.prop.2

/-- For `B` in `absIntegrallyClosedSubrings γ`, the map `γ : D → K` with its values in `B`. -/
def absIntegrallyClosedSubrings.toRingHom {γ : D →+* K} (B : absIntegrallyClosedSubrings γ) :
    D →+* B.val :=
  γ.codRestrict B.val fun d ↦ B.prop.1 ⟨d, rfl⟩

/-- The ideal `J B` of `B` generated by the image of the ideal `J` of `D` under `γ`, which lands in
`B`. -/
abbrev absIntegrallyClosedSubrings.extendedIdeal (B : absIntegrallyClosedSubrings γ) :
    Ideal B.val :=
  J.map (γ.codRestrict B.val fun d ↦ B.prop.1 ⟨d, rfl⟩)

/-- `J B` is the extension of `J` along `absIntegrallyClosedSubrings.toRingHom B : D → B`. -/
lemma absIntegrallyClosedSubrings.extendedIdeal_eq_map_toRingHom
    (B : absIntegrallyClosedSubrings γ) : extendedIdeal J γ B = J.map (toRingHom B) :=
  rfl

/-- The functor `B ↦ B / J B` on `absIntegrallyClosedSubrings γ`, ordered by inclusion. -/
def absIntegrallyClosedSubrings.quotientFunctor : absIntegrallyClosedSubrings γ ⥤ CommRingCat where
  obj B := of (B.val ⧸ extendedIdeal J γ B)
  map {B B'} l :=
    ofHom (quotientMap (extendedIdeal J γ B') (inclusion l.le) (map_le_of_le_comap le_comap_map))

/-- On classes, the map of `quotientFunctor J γ` along `B ≤ B'` sends the class of `x ∈ B` to the
class of `x` in `B'`. -/
lemma absIntegrallyClosedSubrings.quotientFunctor_map_mk {B B' : absIntegrallyClosedSubrings γ}
    (l : B ⟶ B') (x : B.val) :
    ((quotientFunctor J γ).map l).hom (Ideal.Quotient.mk (extendedIdeal J γ B) x) =
      Ideal.Quotient.mk (extendedIdeal J γ B') (inclusion l.le x) :=
  rfl

/-- For `B ≤ B'` in `absIntegrallyClosedSubrings γ`, the ideal `J B` extends along the inclusion
`B → B'` to `J B'`. -/
lemma absIntegrallyClosedSubrings.map_extendedIdeal {B B' : absIntegrallyClosedSubrings γ}
    (h_le : B ≤ B') : (extendedIdeal J γ B).map (inclusion h_le) = extendedIdeal J γ B' :=
  J.map_map _ (inclusion h_le)

/-- Let divisibility in `D` be total (`PreValuationRing D`), and let `ψ : B → E` be a ring map. If
`x` lies in the extension of `J B` along `ψ`, then `ψ i` divides `x` for one `i ∈ J B`. -/
lemma absIntegrallyClosedSubrings.exists_mem_extendedIdeal_dvd [PreValuationRing D]
    (B : absIntegrallyClosedSubrings γ) {E : Type} [CommRing E] (ψ : B.val →+* E) (x : E)
    (hx : x ∈ (extendedIdeal J γ B).map ψ) : ∃ i ∈ extendedIdeal J γ B, ψ i ∣ x := by
  -- The extension of `J B` along `ψ` is the extension of `J` along `ψ ∘ ι`, for `ι : D → B`.
  let ι : D →+* B.val := toRingHom B
  obtain ⟨d, hd, hdx⟩ : ∃ d ∈ J, (ψ.comp ι) d ∣ x :=
    exists_map_dvd_of_mem_map ((J.map_map ι ψ).le hx)
  exact ⟨ι d, mem_map_of_mem ι hd, hdx⟩

/-- If `ℓ` is invertible in `D`, then it is invertible in every member of
`absIntegrallyClosedSubrings γ`. -/
lemma absIntegrallyClosedSubrings.isUnit_natCast_of_isUnit {γ : D →+* K} {ℓ : ℕ}
    (hℓ : IsUnit (ℓ : D)) (B : absIntegrallyClosedSubrings γ) : IsUnit (ℓ : B.val) := by
  simpa using hℓ.map (toRingHom B)

/-- For subrings `S ≤ T` of `K` (the instance `Fact (S ≤ T)`), `T` is an `S`-algebra through the
inclusion. -/
instance : Algebra S T := (inclusion h.out).toAlgebra

/-- The inclusions of subrings `S ≤ T ≤ U` of `K` form a scalar tower. -/
instance [Fact (T ≤ U)] [Fact (S ≤ U)] : IsScalarTower S T U := .of_algebraMap_eq' rfl

variable [IsAlgClosed K] in
/-- An absolutely integrally closed subring of `K` is integrally closed in `K`. -/
local instance [a : IsAbsIntegrallyClosed S] : IsIntegrallyClosedIn S K :=
  isIntegrallyClosedIn_iff.mpr ⟨S.subtype_injective, a.mem_range_of_isIntegralElem⟩

/-- Let `S ≤ T` be subrings of `K` with `S` absolutely integrally closed, and let `y ∈ T` be the
inverse of `x ∈ S`. If `T` lies in every absolutely integrally closed subring that contains `S` and
`y`, then `T` is the localisation of `S` away from `x`. Here `T` is an `S`-algebra through the
inclusion. -/
lemma IsAbsIntegrallyClosed.isLocalization_away {S T : Subring K} [h : Fact (S ≤ T)]
    (hS : IsAbsIntegrallyClosed S) (x : S) {y : K} (hy : y ∈ T) (h_inv : (x : K) * y = 1)
    (h_min : ∀ {U : Subring K}, IsAbsIntegrallyClosed U → S ≤ U → y ∈ U → T ≤ U) :
    IsLocalization.Away x T := by
  have hx_unit : IsUnit (S.subtype x) := .of_mul_eq_one y h_inv
  let φ : Localization.Away x →+* K := Localization.awayLift S.subtype x hx_unit
  have φ_algebraMap (r : S) : φ (algebraMap S (Localization.Away x) r) = r := lift_eq x hx_unit r
  have φ_invSelf : φ (invSelf x) = y := by
    rw [eq_inv_of_mul_eq_one_right h_inv, ← φ_algebraMap]
    exact eq_inv_of_mul_eq_one_right (by rw [← map_mul, mul_invSelf, map_one])
  -- The image of `S[1/x]` in `K` is absolutely integrally closed and contains `S` and `y`.
  have h_closed : IsAbsIntegrallyClosed φ.range :=
    (hS.of_isLocalization (.powers x)).of_surjective φ.rangeRestrict_surjective
  have h_le : T ≤ φ.range :=
    h_min h_closed (fun r hr ↦ ⟨_, φ_algebraMap ⟨r, hr⟩⟩) ⟨invSelf x, φ_invSelf⟩
  -- So every `z ∈ T` is `r / x ^ n` with `r ∈ S`; and `x` is a unit of `T`, with inverse `y`.
  refine .mk x (.of_mul_eq_one ⟨y, hy⟩ (Subtype.ext h_inv)) (fun z ↦ ?_) fun a b hab ↦ ?_
  · obtain ⟨u, hu⟩ : ∃ u : Localization.Away x, φ u = z := h_le z.prop
    obtain ⟨n, r, hr⟩ := surj x u
    have h_clear : (z : K) * (x : K) ^ n = r := by
      rw [← hu, ← φ_algebraMap x, ← map_pow, ← map_mul, hr, φ_algebraMap]
    exact ⟨n, r, Subtype.ext h_clear⟩
  · exact ⟨0, by rw [inclusion_injective h.out hab]⟩

/-- An element `a` of a subring `S` of a field `F` with `a ≠ 0` and `a⁻¹ ∈ S` is a unit of `S`. -/
lemma _root_.Subring.isUnit_of_inv_mem {F : Type*} [Field F] {S : Subring F} (a : S)
    (ha : (a : F) ≠ 0) (h_mem : (a : F)⁻¹ ∈ S) : IsUnit a :=
  .of_mul_eq_one ⟨(a : F)⁻¹, h_mem⟩ (Subtype.ext (mul_inv_cancel₀ ha))

/-- Let `b` be an element of a subring `S` of a field `F` such that neither `b` nor `1 - b` is a
unit of `S`. Then `t = 1 - b⁻¹` satisfies `t ∉ S`, `t⁻¹ ∉ S` and `b * (1 - t) = 1`. -/
lemma _root_.Subring.exists_notMem_and_inv_notMem_of_not_isUnit {F : Type*} [Field F]
    {S : Subring F} (b : S) (hb : ¬IsUnit b) (h_one_sub : ¬IsUnit (1 - b)) :
    ∃ t : F, t ∉ S ∧ t⁻¹ ∉ S ∧ b * (1 - t) = 1 := by
  -- With `t = 1 - b⁻¹`, `1 - t = b⁻¹` and `t⁻¹ = 1 - (1 - b)⁻¹`.
  have hb_ne_zero : (b : F) ≠ 0 := fun h ↦ h_one_sub (by simp [ZeroMemClass.coe_eq_zero.mp h])
  have h_sub_ne_zero : 1 - (b : F) ≠ 0 := fun h ↦
    hb (by simp [show b = 1 from Subtype.ext (sub_eq_zero.mp h).symm])
  refine ⟨1 - (b : F)⁻¹, fun h_mem ↦ hb ?_, fun h_mem ↦ h_one_sub ?_, by simp [hb_ne_zero]⟩
  · exact Subring.isUnit_of_inv_mem b hb_ne_zero (by simpa using S.sub_mem S.one_mem h_mem)
  · have h_inv : (1 - (b : F))⁻¹ = 1 - (1 - (b : F)⁻¹)⁻¹ := by grind
    have h_inv_mem : (1 - (b : F))⁻¹ ∈ S := by
      simpa only [h_inv] using S.sub_mem S.one_mem h_mem
    exact Subring.isUnit_of_inv_mem (1 - b) h_sub_ne_zero h_inv_mem

/-- Let `K` be an algebraically closed field, `S` an absolutely integrally closed subring of `K`
that is not a valuation ring of `K`, and `I` an ideal of `S`. Then there is `t ∈ K` with `t ∉ S` and
`t⁻¹ ∉ S` such that either `1 - t` is the inverse of some `b ∈ S`, and `b * (b - 1) ∈ I` or the
equation `ε + r * ε ^ 2 = 1` has a solution `ε ∈ S` for every `r ∈ I` (`IsLineChartCase I b`); or
`S` is local (`IsAbsIntegrallyClosedLocal S`).

These are the two cases that `exists_eq_locConstSpec_map_sub_map` allows. -/
lemma IsAbsIntegrallyClosed.exists_notMem_and_inv_notMem [IsAlgClosed K]
    (hS : IsAbsIntegrallyClosed S) (I : Ideal S) (h_not_val : ¬∀ x : K, x ∈ S ∨ x⁻¹ ∈ S) :
    ∃ t : K, t ∉ S ∧ t⁻¹ ∉ S ∧
      ((∃ b : S, b * (1 - t) = 1 ∧ IsLineChartCase I b) ∨ IsAbsIntegrallyClosedLocal S) := by
  -- Suppose that no `t` works. Then `S` is local, and any `t` with `t, t⁻¹ ∉ S`, which exists as
  -- `S` is not a valuation ring, lies in the second case.
  by_contra h_none
  -- If neither `b` nor `1 - b` were a unit, then `t = 1 - b⁻¹` would lie in the first case.
  have isUnit_or_isUnit_one_sub (b : S) (hb : IsLineChartCase I b) : IsUnit b ∨ IsUnit (1 - b) := by
    by_contra! ⟨hb_nonunit, h_one_sub_nonunit⟩
    obtain ⟨t, ht, ht_inv, h_mul⟩ :=
      Subring.exists_notMem_and_inv_notMem_of_not_isUnit b hb_nonunit h_one_sub_nonunit
    exact h_none ⟨t, ht, ht_inv, .inl ⟨b, h_mul, hb⟩⟩
  -- For a root `ρ` of `X ^ 2 - X - r`, one of `ρ`, `1 - ρ` is a unit, and its inverse is an `ε`.
  have h_solve (r : S) (hr : r ∈ I) : ∃ ε : S, ε + r * ε ^ 2 = 1 := by
    obtain ⟨ρ, hρ⟩ : ∃ ρ : S, ρ ^ 2 - 1 * ρ = r := hS.exists_pow_sub_mul_eq 2 1 r
    have h_prod : ρ * (ρ - 1) = r := by linear_combination hρ
    obtain h_unit | h_unit := isUnit_or_isUnit_one_sub ρ (Or.inl (by rwa [h_prod]))
    · obtain ⟨ε, hε⟩ : ∃ ε : S, ρ * ε = 1 := h_unit.exists_right_inv
      exact ⟨ε, by linear_combination (ρ * ε - ε + 1) * hε - ε ^ 2 * h_prod⟩
    · obtain ⟨ε, hε⟩ : ∃ ε : S, (1 - ρ) * ε = 1 := h_unit.exists_right_inv
      exact ⟨ε, by linear_combination (1 - ρ * ε) * hε - ε ^ 2 * h_prod⟩
  -- So `S` is local: if `a + b = 1`, then `a` or `b = 1 - a` is a unit.
  have h_local : IsAbsIntegrallyClosedLocal S :=
    { hS with
      isUnit_or_isUnit_of_add_one {a b : S} (hab : a + b = 1) := by
        rw [eq_sub_of_add_eq' hab]
        exact isUnit_or_isUnit_one_sub a (Or.inr h_solve) }
  obtain ⟨t, ht, ht_inv⟩ : ∃ t : K, t ∉ S ∧ t⁻¹ ∉ S := by simpa using h_not_val
  exact h_none ⟨t, ht, ht_inv, .inr h_local⟩

/-- The integral closure in `K` of the subring `S[s]` generated by `S` and `s`. -/
def integralClosureAdjoin (S : Subring K) (s : K) : Subring K :=
  (integralClosure ↥(S ⊔ closure {s}) K).toSubring

/-- For a subring `U` of `K` that is integrally closed in `K`, the integral closure of `S[s]` lies
in `U` if and only if `S ≤ U` and `s ∈ U`. -/
lemma integralClosureAdjoin_le_iff {s : K} [IsIntegrallyClosedIn U K] :
    integralClosureAdjoin S s ≤ U ↔ S ≤ U ∧ s ∈ U := by
  refine integralClosure_subring_le_iff.trans (sup_le_iff.trans ?_)
  rw [Subring.closure_le, Set.singleton_subset_iff, SetLike.mem_coe]

/-- The integral closure of `S[s]` in the algebraically closed field `K` is absolutely integrally
closed. -/
lemma isAbsIntegrallyClosed_integralClosureAdjoin [IsAlgClosed K] (S : Subring K) (s : K) :
    IsAbsIntegrallyClosed (integralClosureAdjoin S s) := by
  unfold integralClosureAdjoin
  exact .of_isIntegrallyClosedIn K

/-- The integral closure of `S[s]` in `K` contains `S`. -/
lemma le_integralClosureAdjoin [IsAlgClosed K]
    (S : Subring K) (s : K) : S ≤ integralClosureAdjoin S s := by
  -- gives the instance `IsIntegrallyClosedIn` that `integralClosureAdjoin_le_iff` needs
  have := isAbsIntegrallyClosed_integralClosureAdjoin S s
  exact (integralClosureAdjoin_le_iff.mp le_rfl).left

/-- The integral closure of `S[s]` in `K` contains `s`. -/
lemma mem_integralClosureAdjoin [IsAlgClosed K]
    (S : Subring K) (s : K) : s ∈ integralClosureAdjoin S s := by
  -- gives the instance `IsIntegrallyClosedIn` that `integralClosureAdjoin_le_iff` needs
  have := isAbsIntegrallyClosed_integralClosureAdjoin S s
  exact (integralClosureAdjoin_le_iff.mp le_rfl).right

/-- Let `S` be an absolutely integrally closed subring of `K`, and `t ∈ K` with `b * (1 - t) = 1`
for some `b ∈ S`. Then the integral closure of `S[t]` is the localisation of `S` away from `b`; it
is an `S`-algebra through the inclusion. -/
lemma IsAbsIntegrallyClosed.isLocalization_away_integralClosureAdjoin [IsAlgClosed K]
    {S : Subring K}
    (hS : IsAbsIntegrallyClosed S) {t : K} [h : Fact (S ≤ integralClosureAdjoin S t)] (b : S)
    (hb : b * (1 - t) = 1) : IsLocalization.Away b (integralClosureAdjoin S t) := by
  refine hS.isLocalization_away b (sub_mem (one_mem _) (mem_integralClosureAdjoin S t)) hb
    fun {U} _ hU h_mem ↦ integralClosureAdjoin_le_iff.mpr ⟨hU, ?_⟩
  -- `t = 1 - (1 - t)` lies in `U`.
  simpa using sub_mem (one_mem U) h_mem

/-- Let `S ≤ T` be subrings of `K`, so that `T` is an `S`-algebra, and let `s, t ∈ T`. If `T` lies
in the subring generated by the integral closures of `S[s]` and `S[t]`, then every `x ∈ T` is
integral over the `S`-subalgebra `S[s, t]` of `T`. -/
lemma isIntegral_adjoin_pair_of_le_sup {S T : Subring K} [h : Fact (S ≤ T)] (s t : T)
    (hT : T ≤ integralClosureAdjoin S s ⊔ integralClosureAdjoin S t) (x : T) :
    IsIntegral (Algebra.adjoin S {s, t}) x := by
  let L : Subalgebra S T := Algebra.adjoin S {s, t}
  let N : Subalgebra L K := integralClosure L K
  -- For `u ∈ L`, the integral closure of `S[u]` lies in the integral closure `N` of `L` in `K`.
  have hS_le_N : S ≤ N.toSubring := fun b hb ↦ N.algebraMap_mem (algebraMap S L ⟨b, hb⟩)
  have h_le_N (u : T) (hu : u ∈ L) : integralClosureAdjoin S u ≤ N.toSubring :=
    integralClosureAdjoin_le_iff.mpr ⟨hS_le_N, N.algebraMap_mem ⟨u, hu⟩⟩
  have h_sup_le : integralClosureAdjoin S s ⊔ integralClosureAdjoin S t ≤ N.toSubring :=
    sup_le (h_le_N s (Algebra.subset_adjoin (by simp))) (h_le_N t (Algebra.subset_adjoin (by simp)))
  have hx : IsIntegral L (algebraMap T K x) := h_sup_le (hT x.prop)
  exact hx.tower_bot (subtype_injective T)

/-- Let `S ≤ S₁, S₂ ≤ T` be subrings of `K`, each an algebra over the smaller ones through the
inclusion, with `S₁ ⊓ S₂ = S`. If `x ∈ S₁` and `y ∈ S₂` have the same image in `T`, then `(x, y)` is
the image of one element of `S`. -/
lemma mem_range_algebraMap_prod_of_inf_eq {S S₁ S₂ T : Subring K} [Fact (S ≤ S₁)] [Fact (S ≤ S₂)]
    [Fact (S₁ ≤ T)] [Fact (S₂ ≤ T)] (h_inf : S₁ ⊓ S₂ = S) (x : S₁) (y : S₂)
    (hxy : algebraMap S₁ T x = algebraMap S₂ T y) :
    (x, y) ∈ Set.range (algebraMap S (S₁ × S₂)) := by
  have h_val : (x : K) = y := congrArg Subtype.val hxy
  have hx : (x : K) ∈ S := h_inf.le ⟨x.prop, by simp [h_val]⟩
  exact ⟨⟨x, hx⟩, Prod.ext rfl (Subtype.ext h_val)⟩

/-- Let the images of `f₁ : X₁ → X` and `f₂ : X₂ → X` cover `X`. Locally constant functions `x` on
`X₁` and `y` on `X₂` are pull-backs of one locally constant function on `X` if, for each value
`c`, their fibres over `c` are the preimages of one open subset of `X`. -/
lemma exists_locallyConstant_of_fibers {X X₁ X₂ Z : Type*} [TopologicalSpace X]
    [TopologicalSpace X₁] [TopologicalSpace X₂] {f₁ : X₁ → X} {f₂ : X₂ → X}
    (h_cover : ∀ p : X, p ∈ Set.range f₁ ∨ p ∈ Set.range f₂)
    (x : LocallyConstant X₁ Z) (y : LocallyConstant X₂ Z)
    (h_fiber : ∀ c : Z, ∃ W : Set X, IsOpen W ∧ x ⁻¹' {c} = f₁ ⁻¹' W ∧ y ⁻¹' {c} = f₂ ⁻¹' W) :
    ∃ f : LocallyConstant X Z, (∀ p : X₁, f (f₁ p) = x p) ∧ ∀ p : X₂, f (f₂ p) = y p := by
  choose W hW_open hWx hWy using h_fiber
  -- Each point of `X` lies in exactly one of the sets `W c`.
  have exists_value (p : X) : ∃ c : Z, ∀ k : Z, c = k ↔ p ∈ W k := by
    obtain ⟨p₁, rfl⟩ | ⟨p₂, rfl⟩ := h_cover p
    exacts [⟨x p₁, fun k ↦ Set.ext_iff.mp (hWx k) p₁⟩, ⟨y p₂, fun k ↦ Set.ext_iff.mp (hWy k) p₂⟩]
  choose f hf using exists_value
  have h_fiber_eq (c : Z) : f ⁻¹' {c} = W c := Set.ext fun p ↦ hf p c
  have h_lc : IsLocallyConstant f :=
    IsLocallyConstant.iff_isOpen_fiber.mpr fun c ↦ by simpa only [h_fiber_eq] using hW_open c
  exact ⟨⟨f, h_lc⟩, fun p ↦ (hf (f₁ p) (x p)).mpr ((hWx (x p)).subset rfl),
    fun p ↦ (hf (f₂ p) (y p)).mpr ((hWy (y p)).subset rfl)⟩

/-- Let `F` be a functor from a preorder to abelian groups, and `a ≤ b₁ ≤ c`, `a ≤ b₂ ≤ c`. The
property that the sequence `0 → F a → F b₁ × F b₂ → F c → 0` is exact, where the first map is the
pair of the maps induced by `F` and the second is their difference. -/
structure IsMayerVietorisExact {P : Type*} [Preorder P] (F : P ⥤ Ab) {a b₁ b₂ c : P}
    (l₁ : a ≤ b₁) (l₂ : a ≤ b₂) (h₁ : b₁ ≤ c) (h₂ : b₂ ≤ c) : Prop where
  /-- Exactness on the left: an element that vanishes in `F b₁` and in `F b₂` is zero. -/
  eq_zero (f : F.obj a) (hf₁ : F.map l₁.hom f = 0) (hf₂ : F.map l₂.hom f = 0) : f = 0
  /-- Exactness in the middle: two elements with the same image in `F c` come from `F a`. -/
  exists_glue (x : F.obj b₁) (y : F.obj b₂) (hxy : F.map h₁.hom x = F.map h₂.hom y) :
    ∃ f : F.obj a, F.map l₁.hom f = x ∧ F.map l₂.hom f = y
  /-- Exactness on the right: every element of `F c` is a difference. -/
  exists_eq_sub (z : F.obj c) :
    ∃ (x : F.obj b₁) (y : F.obj b₂), z = F.map h₁.hom x - F.map h₂.hom y

/-- For every prime `p` of `B / J B` there is a valuation ring `V` of `K` containing `B` such that,
for every `B' ∈ absIntegrallyClosedSubrings γ` with `B ≤ B' ≤ V`, `p` is the contraction of a prime
of `B' / J B'`. -/
lemma absIntegrallyClosedSubrings.exists_valuationSubring_mem_range_comap
    (B : absIntegrallyClosedSubrings γ) (p : PrimeSpectrum ((quotientFunctor J γ).obj B)) :
    ∃ V : ValuationSubring K, B.val ≤ V.toSubring ∧
      ∀ (B' : absIntegrallyClosedSubrings γ) (l : B ≤ B'), B'.val ≤ V.toSubring →
        p ∈ Set.range (PrimeSpectrum.comap ((quotientFunctor J γ).map l.hom).hom) := by
  let q : PrimeSpectrum B.val := p.comap (mk (extendedIdeal J γ B))
  obtain ⟨V, hV_le⟩ : ∃ V : ValuationSubring K, ofPrime B.val q.asIdeal ≤ V.toLocalSubring :=
    (ofPrime B.val q.asIdeal).exists_le_valuationSubring
  -- `V` dominates the localisation of `B` at `q`, so `q` is the centre of `V` on `B`.
  obtain ⟨hV, hV_local⟩ : ∃ h_le : (ofPrime B.val q.asIdeal).toSubring ≤ V.toSubring,
      IsLocalHom (Subring.inclusion h_le) := LocalSubring.le_def.mp hV_le
  have hBV : B.val ≤ V.toSubring := (le_ofPrime B.val q.asIdeal).trans hV
  have h_centre (a : B.val) : (⟨a, hBV a.prop⟩ : V) ∈ maximalIdeal V ↔ a ∈ q.asIdeal :=
    (map_mem_nonunits_iff (inclusion hV) _).trans (AtPrime.to_map_mem_maximal_iff _ q.asIdeal a)
  refine ⟨V, hBV, fun B' l hB'V ↦ ?_⟩
  -- Take the contraction of the maximal ideal of `V`, which contains `J`.
  have hJ : extendedIdeal J γ B' ≤ (maximalIdeal V).comap (inclusion hB'V) := by
    refine map_le_of_le_comap fun d hd ↦ ?_
    have h_mem_q : absIntegrallyClosedSubrings.toRingHom B d ∈ q.asIdeal :=
      ker_le_comap _ (mk_ker.ge (mem_map_of_mem _ hd))
    exact (h_centre _).mpr h_mem_q
  refine ⟨.comap (quotientMap (maximalIdeal V) (inclusion hB'V) hJ) ⊥, ?_⟩
  -- A class `a` is in either prime iff `a` lies in the centre of `V` on `B`.
  ext ⟨a⟩
  exact eq_zero_iff_mem.trans (h_centre a)

section Splitting

variable {γ} {B B₁ B₂ B₃ : absIntegrallyClosedSubrings γ}

/-- `B` splits into the strictly larger rings `B₁` and `B₂`, which generate `B₃`: every valuation
ring of `K` over `B` contains one of the two. -/
structure absIntegrallyClosedSubrings.IsSplitting (B B₁ B₂ B₃ : absIntegrallyClosedSubrings γ) :
    Prop where
  /-- `B₁` is strictly larger than `B`. -/
  lt_left : B < B₁
  /-- `B₂` is strictly larger than `B`. -/
  lt_right : B < B₂
  /-- `B₃` is the subring of `K` generated by `B₁` and `B₂`. -/
  eq_sup : B₃.val = B₁.val ⊔ B₂.val
  /-- A valuation ring of `K` that contains `B` contains `B₁` or `B₂`. -/
  le_or_le (V : ValuationSubring K) (hV : B.val ≤ V.toSubring) :
    B₁.val ≤ V.toSubring ∨ B₂.val ≤ V.toSubring

lemma absIntegrallyClosedSubrings.IsSplitting.left_le (h_split : IsSplitting B B₁ B₂ B₃) :
    B₁ ≤ B₃ :=
  Subtype.coe_le_coe.mp (le_sup_left.trans h_split.eq_sup.ge)

lemma absIntegrallyClosedSubrings.IsSplitting.right_le (h_split : IsSplitting B B₁ B₂ B₃) :
    B₂ ≤ B₃ :=
  Subtype.coe_le_coe.mp (le_sup_right.trans h_split.eq_sup.ge)

/-- If `B` splits into `B₁` and `B₂` (`IsSplitting`), then `B₁ ⊓ B₂ = B`. -/
lemma absIntegrallyClosedSubrings.IsSplitting.inf_eq [IsAlgClosed K]
    (h_split : IsSplitting B B₁ B₂ B₃) :
    B₁.val ⊓ B₂.val = B.val := by
  -- `B` is integrally closed, so it is the intersection of the valuation rings that contain it.
  have hB_aic : IsAbsIntegrallyClosed B.val := absIntegrallyClosedSubrings.isAbsIntegrallyClosed B
  refine le_antisymm ?_ (le_inf h_split.lt_left.le h_split.lt_right.le)
  refine (le_iInf fun ⟨V, hBV⟩ ↦ ?_).trans eq_iInf_of_isIntegrallyClosedIn.ge
  exact (h_split.le_or_le V hBV).elim inf_le_of_left_le inf_le_of_right_le

/-- The spectra of `B₁ / J B₁` and `B₂ / J B₂` cover that of `B / J B`. -/
lemma absIntegrallyClosedSubrings.IsSplitting.mem_range_comap_or (h_split : IsSplitting B B₁ B₂ B₃)
    (p : PrimeSpectrum ((quotientFunctor J γ).obj B)) :
    p ∈ Set.range (PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.lt_left.le.hom).hom) ∨
      p ∈ Set.range
        (PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.lt_right.le.hom).hom) := by
  obtain ⟨V, hBV, h_range⟩ := exists_valuationSubring_mem_range_comap J γ B p
  exact (h_split.le_or_le V hBV).imp (h_range B₁ _) (h_range B₂ _)

/-- Let `t ∈ K` with `t ∉ B` and `t⁻¹ ∉ B`. Let `B₁`, `B₂` be the integral closures of `B[t]` and
`B[t⁻¹]`, and `B₃` the subring that they generate. Then `B` splits into `B₁` and `B₂`, generating
`B₃`. -/
lemma absIntegrallyClosedSubrings.isSplitting_of_integralClosureAdjoin [IsAlgClosed K]
    {t : K} (ht : t ∉ B.val) (ht_inv : t⁻¹ ∉ B.val) (hB₁ : B₁.val = integralClosureAdjoin B.val t)
    (hB₂ : B₂.val = integralClosureAdjoin B.val t⁻¹) (hB₃ : B₃.val = B₁.val ⊔ B₂.val) :
    IsSplitting B B₁ B₂ B₃ := by
  have lt_of_notMem {s : K} {B' : absIntegrallyClosedSubrings γ} (hs : s ∉ B.val)
      (hB' : B'.val = integralClosureAdjoin B.val s) : B < B' := by
    rw [← Subtype.coe_lt_coe, hB', IsConcreteLE.lt_iff_le_and_exists]
    exact ⟨le_integralClosureAdjoin B.val s, s, mem_integralClosureAdjoin B.val s, hs⟩
  refine ⟨lt_of_notMem ht hB₁, lt_of_notMem ht_inv hB₂, hB₃, fun V hV ↦ ?_⟩
  -- A valuation ring of `K` contains `t` or `t⁻¹`, and it is integrally closed in `K`.
  have hV_aic : IsAbsIntegrallyClosed V.toSubring :=
    (inferInstance : IsAbsIntegrallyClosedLocal V).toIsAbsIntegrallyClosed
  rw [hB₁, hB₂, integralClosureAdjoin_le_iff, integralClosureAdjoin_le_iff]
  exact (V.mem_or_inv_mem t).imp (And.intro hV) (And.intro hV)

/-- Let `B` split into `B₁` and `B₂`, generating `B₃` (`IsSplitting`). A locally constant
`ZMod ℓ`-valued function on `Spec (B / J B)` that vanishes after pull-back to `Spec (B₁ / J B₁)` and
to `Spec (B₂ / J B₂)` is zero, because these two spectra cover `Spec (B / J B)`. -/
lemma absIntegrallyClosedSubrings.IsSplitting.eq_zero_of_map_eq_zero
    (h_split : IsSplitting B B₁ B₂ B₃) (f : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).obj B)
    (hf₁ : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.lt_left.le.hom f = 0)
    (hf₂ : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.lt_right.le.hom f = 0) :
    f = 0 := by
  refine LocallyConstant.ext fun p ↦ ?_
  obtain ⟨p₁, rfl⟩ | ⟨p₂, rfl⟩ := h_split.mem_range_comap_or J p
  exacts [LocallyConstant.congr_fun hf₁ p₁, LocallyConstant.congr_fun hf₂ p₂]

/-- Let `B` split into `B₁` and `B₂`, generating `B₃` (`IsSplitting`). If compatible clopens of
`Spec (B₁ / J B₁)` and `Spec (B₂ / J B₂)` come from one open of `Spec (B / J B)` (`h_clopen`), then
locally constant `ZMod ℓ`-valued `x` on `Spec (B₁ / J B₁)` and `y` on `Spec (B₂ / J B₂)` with
the same pull-back to `Spec (B₃ / J B₃)` are the pull-backs of one such function on
`Spec (B / J B)`. -/
lemma absIntegrallyClosedSubrings.IsSplitting.exists_map_eq_and_map_eq
    (h_split : IsSplitting B B₁ B₂ B₃)
    (h_clopen : ∀ (X₁ : Set (PrimeSpectrum ((quotientFunctor J γ).obj B₁)))
      (X₂ : Set (PrimeSpectrum ((quotientFunctor J γ).obj B₂))), IsClopen X₁ → IsClopen X₂ →
      PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.left_le.hom).hom ⁻¹' X₁ =
        PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.right_le.hom).hom ⁻¹' X₂ →
      ∃ W : Set (PrimeSpectrum ((quotientFunctor J γ).obj B)), IsOpen W ∧
        X₁ = PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.lt_left.le.hom).hom ⁻¹' W ∧
        X₂ = PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.lt_right.le.hom).hom ⁻¹' W)
    (x : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).obj B₁)
    (y : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).obj B₂)
    (hxy : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.left_le.hom x =
      (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.right_le.hom y) :
    ∃ f : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).obj B,
      (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.lt_left.le.hom f = x ∧
      (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.lt_right.le.hom f = y := by
  -- The fibres of `x` and `y` over `c` are clopens with the same preimage in `Spec (B₃ / J B₃)`.
  obtain ⟨f, hf₁, hf₂⟩ := exists_locallyConstant_of_fibers (h_split.mem_range_comap_or J) x y
    fun c ↦ h_clopen _ _ (x.isLocallyConstant.isClopen_fiber c)
      (y.isLocallyConstant.isClopen_fiber c)
      (Set.ext fun p ↦ (LocallyConstant.congr_fun hxy p).congr_left)
  exact ⟨f, LocallyConstant.ext hf₁, LocallyConstant.ext hf₂⟩

end Splitting

/-- Let `K` be algebraically closed, `γ : D →+* K` a ring map, `J` an ideal of `D`, `ℓ` a prime
invertible in `D`, and divisibility in `D` total (`PreValuationRing D`). Let `B` be an absolutely
integrally closed subring of `K` containing the image of `γ` (`absIntegrallyClosedSubrings γ`) that
is not a valuation ring of `K`. Then there are such rings `B₁`, `B₂`, strictly larger than `B` and
generating `B₃`, with every valuation ring of `K` over `B` containing one of them (`IsSplitting`),
such that `0 → C B → C B₁ × C B₂ → C B₃ → 0` is exact. Here `C S` is the group of locally constant
functions `Spec (S / J S) → ZMod ℓ`, the first map is the pair of pull-backs and the second is their
difference. -/
lemma absIntegrallyClosedSubrings.exists_isSplitting_isMayerVietorisExact [IsAlgClosed K]
    [PreValuationRing D] (hℓ : IsUnit (ℓ : D)) (B : absIntegrallyClosedSubrings γ)
    (hB : ¬∀ x : K, x ∈ B.val ∨ x⁻¹ ∈ B.val) :
    ∃ (B₁ B₂ B₃ : absIntegrallyClosedSubrings γ) (h_split : IsSplitting B B₁ B₂ B₃),
      IsMayerVietorisExact (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩)
        h_split.lt_left.le h_split.lt_right.le h_split.left_le h_split.right_le := by
  -- Choose `t` with `t, t⁻¹ ∉ B`, in one of the cases that `exists_eq_locConstSpec_map_sub_map`
  -- allows. Let `B₁`, `B₂` be the integral closures of `B[t]` and `B[t⁻¹]`, and `B₃` the ring they
  -- generate. The spectra of `B₁`, `B₂` modulo `J` cover that of `B`, which gives exactness on the
  -- left; `exists_eq_basicOpen_of_isClopen_of_preimage_eq` gives it in the middle and
  -- `exists_eq_locConstSpec_map_sub_map` on the right.
  have hB_aic : IsAbsIntegrallyClosed B.val := absIntegrallyClosedSubrings.isAbsIntegrallyClosed B
  obtain ⟨t, ht, ht_inv, h_case⟩ : ∃ t : K, t ∉ B.val ∧ t⁻¹ ∉ B.val ∧
      ((∃ b : B.val, b * (1 - t) = 1 ∧ IsLineChartCase (extendedIdeal J γ B) b) ∨
        IsAbsIntegrallyClosedLocal B.val) :=
    hB_aic.exists_notMem_and_inv_notMem (extendedIdeal J γ B) hB
  have ht_ne : t ≠ 0 := (ne_of_mem_of_not_mem (zero_mem B.val) ht).symm
  let S₁ : Subring K := integralClosureAdjoin B.val t
  let S₂ : Subring K := integralClosureAdjoin B.val t⁻¹
  let S₃ : Subring K := S₁ ⊔ S₂
  let t₁ : S₁ := ⟨t, mem_integralClosureAdjoin B.val t⟩
  let t₂ : S₂ := ⟨t⁻¹, mem_integralClosureAdjoin B.val t⁻¹⟩
  have hS₁_aic : IsAbsIntegrallyClosed S₁ := isAbsIntegrallyClosed_integralClosureAdjoin B.val t
  have hS₂_aic : IsAbsIntegrallyClosed S₂ := isAbsIntegrallyClosed_integralClosureAdjoin B.val t⁻¹
  -- The inclusions as algebras; `S₃` is a localisation of each of `S₁`, `S₂`.
  have hB_le₁ : Fact (B.val ≤ S₁) := ⟨le_integralClosureAdjoin B.val t⟩
  have hB_le₂ : Fact (B.val ≤ S₂) := ⟨le_integralClosureAdjoin B.val t⁻¹⟩
  have h_le₁₃ : Fact (S₁ ≤ S₃) := ⟨le_sup_left⟩
  have h_le₂₃ : Fact (S₂ ≤ S₃) := ⟨le_sup_right⟩
  have hB_le₃ : Fact (B.val ≤ S₃) := ⟨hB_le₁.out.trans h_le₁₃.out⟩
  have h_away₁ : Away t₁ S₃ :=
    hS₁_aic.isLocalization_away t₁ (h_le₂₃.out t₂.prop) (mul_inv_cancel₀ ht_ne)
      fun _ hU h_mem ↦ sup_le hU (integralClosureAdjoin_le_iff.mpr ⟨hB_le₁.out.trans hU, h_mem⟩)
  have h_away₂ : Away t₂ S₃ :=
    hS₂_aic.isLocalization_away t₂ (h_le₁₃.out t₁.prop) (inv_mul_cancel₀ ht_ne)
      fun _ hU h_mem ↦ sup_le (integralClosureAdjoin_le_iff.mpr ⟨hB_le₂.out.trans hU, h_mem⟩) hU
  let B₁ : absIntegrallyClosedSubrings γ := ⟨S₁, (range_le B).trans hB_le₁.out, hS₁_aic⟩
  let B₂ : absIntegrallyClosedSubrings γ := ⟨S₂, (range_le B).trans hB_le₂.out, hS₂_aic⟩
  let B₃ : absIntegrallyClosedSubrings γ := ⟨S₃, (range_le B).trans hB_le₃.out,
    hS₁_aic.of_isLocalization (.powers t₁)⟩
  have h_split : IsSplitting B B₁ B₂ B₃ :=
    isSplitting_of_integralClosureAdjoin ht ht_inv rfl rfl rfl
  -- The hypotheses of `exists_eq_basicOpen_of_isClopen_of_preimage_eq` and
  -- `exists_eq_locConstSpec_map_sub_map`.
  have h_mul : algebraMap S₁ S₃ t₁ * algebraMap S₂ S₃ t₂ = 1 := Subtype.ext (mul_inv_cancel₀ ht_ne)
  have h_cases : (∃ b : B.val, algebraMap B.val S₁ b * (1 - t₁) = 1 ∧
        (algebraMap B.val S₂ b - 1) * (t₂ - 1) = 1 ∧ Away b S₁ ∧
        IsLineChartCase (extendedIdeal J γ B) b) ∨
      IsAbsIntegrallyClosedLocal B.val := by
    refine h_case.imp_left fun ⟨b, (hb : b * (1 - t) = 1), hb_case⟩ ↦ ?_
    have hb_sub : (b.val - 1) * (t⁻¹ - 1) = 1 := by
      field_simp
      linear_combination hb
    -- `S₁ = B[1 / b]`, since `b⁻¹ = 1 - t`.
    have h_away : Away b S₁ := hB_aic.isLocalization_away_integralClosureAdjoin (h := hB_le₁) b hb
    exact ⟨b, Subtype.ext hb, Subtype.ext hb_sub, h_away, hb_case⟩
  -- the extensions of `J B` to `S₁`, `S₂`, `S₃` are `J B₁`, `J B₂`, `J B₃`
  have h_ideal₁ : (extendedIdeal J γ B).map (algebraMap B.val S₁) = extendedIdeal J γ B₁ :=
    map_extendedIdeal J γ h_split.lt_left.le
  have h_ideal₂ : (extendedIdeal J γ B).map (algebraMap B.val S₂) = extendedIdeal J γ B₂ :=
    map_extendedIdeal J γ h_split.lt_right.le
  have h_ideal₃ : (extendedIdeal J γ B).map (algebraMap B.val S₃) = extendedIdeal J γ B₃ :=
    map_extendedIdeal J γ (h_split.lt_left.le.trans h_split.left_le)
  -- `J B₁` and `J B₂` map into `J B₃`
  have h_le₁ : extendedIdeal J γ B₁ ≤ (extendedIdeal J γ B₃).comap (algebraMap S₁ S₃) :=
    map_le_of_le_comap le_comap_map
  have h_le₂ : extendedIdeal J γ B₂ ≤ (extendedIdeal J γ B₃).comap (algebraMap S₂ S₃) :=
    map_le_of_le_comap le_comap_map
  -- `S₃` is integral over `B[t, t⁻¹]`
  have h_integral (x : S₃) :
      IsIntegral (Algebra.adjoin B.val {algebraMap S₁ S₃ t₁, algebraMap S₂ S₃ t₂}) x :=
    isIntegral_adjoin_pair_of_le_sup (algebraMap S₁ S₃ t₁) (algebraMap S₂ S₃ t₂) le_rfl x
  -- an element of `K` that lies in `S₁` and in `S₂` lies in `B`
  have h_onto (x : S₁) (y : S₂) (hxy : algebraMap S₁ S₃ x = algebraMap S₂ S₃ y) :
      (x, y) ∈ Set.range (algebraMap B.val (S₁ × S₂)) :=
    mem_range_algebraMap_prod_of_inf_eq h_split.inf_eq x y hxy
  refine ⟨B₁, B₂, B₃, h_split,
    { eq_zero := h_split.eq_zero_of_map_eq_zero J
      exists_glue := h_split.exists_map_eq_and_map_eq J fun X₁ X₂ hX₁ hX₂ h_eq ↦ ?_
      exists_eq_sub := exists_eq_locConstSpec_map_sub_map (extendedIdeal J γ B) t₁ t₂ h_mul
        h_integral (isUnit_natCast_of_isUnit hℓ B) h_cases (exists_mem_extendedIdeal_dvd J γ B)
        h_ideal₁ h_ideal₂ h_ideal₃ h_le₁ h_le₂ }⟩
  -- Compatible clopens of the two charts are the basic opens of one `k ∈ B`.
  obtain ⟨k, hkX₁, hkX₂⟩ : ∃ k : B.val,
      X₁ = (basicOpen (algebraMap B.val (S₁ ⧸ extendedIdeal J γ B₁) k)).carrier ∧
      X₂ = (basicOpen (algebraMap B.val (S₂ ⧸ extendedIdeal J γ B₂) k)).carrier :=
    exists_eq_basicOpen_of_isClopen_of_preimage_eq (extendedIdeal J γ B) t₁ t₂ h_mul h_integral
      h_onto
      (exists_mem_extendedIdeal_dvd J γ B) h_ideal₁ h_ideal₂ h_ideal₃ h_le₁ h_le₂ hX₁ hX₂ h_eq
  exact ⟨(basicOpen (mk (extendedIdeal J γ B) k)).carrier, isOpen_basicOpen, hkX₁, hkX₂⟩

end New.Variety

end SubringSplitting
