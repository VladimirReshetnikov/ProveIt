import New.Congruences.Selmer.Count

/-!
# Reciprocity at conjugate primes

Given a tied class `z` of full order whose Frobenius values at all new auxiliary primes are tame
values, one attaches to each member `y` of the dual group a `G`-map `η : T / a → (T / a)^{*c}` with
`η(z(h)) = y(h^c)` on `H`, which determines `y`. Here `G = Gal(Ω/E)`, `T / a` is the lattice modulo
`a`, `g^c = New.conjGal g` is the conjugate of `g` by complex conjugation, and `(T / a)^{*c}` is
the Cartier dual of `T / a` with `g` acting through `g^c`. The proof shows that the form
`Ψ(h, h') = ⟨z(h), y(h')⟩ - ⟨z(h'^c), y(h^c)⟩` vanishes on `H × H`.

* `New.Selmer.SelmerDatum.exists_isNewAuxiliaryPrime`: there are new auxiliary primes whose
  Frobenius element is near any element of `γ₀ H`, where `γ₀` is the tame generator at the first
  prime.
* `New.Selmer.SelmerDatum.mirrorForm_self_eq_zero`: first step, `Ψ(h, h) = 0` by reciprocity.
* `New.Selmer.SelmerDatum.mirrorForm_eq_zero`: second step, `Ψ = 0` by conjugation with `γ_*`.
* `New.Selmer.SelmerDatum.exists_linearMap_apply_eq_dualSelmer_conj`: third step, the map `η`.
* `New.Selmer.SelmerDatum.length_dualSelmer_le`: the dual group has length at most `globalTerm(T)`.

Notions from other files:
* `New.Selmer.SelmerDatum`: a lattice `T = O ^ n` with Galois action `T.ρ`, local conditions and an
  inertial element `γ_* = T.γ` that acts by a scalar; `T.tiedSelmer` is its tied Selmer group.
* `New.Selmer.SelmerDatum.reductionKer`, `New.Selmer.SelmerDatum.sahGroup`: the kernel `U` of the
  action on `T / ℓ ^ M` and `μ_{ℓ ^ N}`, and the group `H` generated by all `[g, γ_*]` and
  `[g, γ_*^c]`.
* `New.Selmer.SelmerDatum.dualSelmer`: the dual of the tied Selmer group, formed for a finite set
  `R` of primes. Its members are equivariant homomorphisms from `U` to the characters
  `T / a → ℚ/ℤ`, extended by zero to `Gal(Ω/E)`, that are unramified outside `R \ {P₀, P̄₀}` and
  satisfy reciprocity at split primes outside that set.
* `New.Selmer.IsTiedPrimes`: says that `J` is a set of auxiliary primes with data `x` (place,
  Frobenius element, tame generator, character, slopes). It has a first prime `P₀`, whose Frobenius
  element lies in `W` and whose slopes are `0`, so that tied classes are unramified there.
-/

noncomputable section

namespace New.Selmer

open Module Matrix.Module Finset Subgroup commutatorElement

/-- Let the place `B` of `Ω` lie over the prime `P` of `E`, and let `δ` be a normalised tame
generator at `B`: it is inertial at `B` and multiplies an `m`-th root of a uniformiser by the fixed
primitive `m`-th root of unity. Then `δ^{-c} = (conjGal δ)⁻¹` is a normalised tame generator at the
conjugate place. -/
lemma isTameGeneratorFor_conjGal_inv {E : Type} [Field E]
    [EmbeddedNumberField E] [NumberField.IsCMField E] {m : ℕ} [NeZero m]
    {B : ClosurePlace} {P : FinPlace E} (hB : IsPlaceOver B P) {δ : Gal(Ω/E)}
    (hδ : IsTameGeneratorFor (K := E) m B δ) :
    IsTameGeneratorFor (K := E) m (conjPlace B) (conjGal δ)⁻¹ := by
  obtain ⟨hδ_inertia, ϖ, r, hϖ, hr, hδr⟩ : δ ∈ inertiaGroup Gal(Ω/E) B ∧
      ∃ (ϖ : Eˣ) (r : DiscreteUnits Ω), IsUniformiser B (ϖ : E) ∧
        m • r = DiscreteUnits.ofBase Gal(Ω/E) Ω (Additive.ofMul ϖ) ∧
        unitsRep δ r - r = (rootPowHom Ω m).1 1 := hδ
  -- Conjugate the uniformiser `ϖ` and the root `δ r`, which `δ⁻¹` moves back to `r`; conjugation
  -- inverts the root of unity.
  refine ⟨by simpa using hδ_inertia, star ϖ, unitsRep cmConj (unitsRep δ r), ?_, ?_, ?_⟩
  · simpa [hB.conjPlace_star.isUniformiser_iff, hB.isUniformiser_iff] using hϖ
  · simp [← map_nsmul, hr, DiscreteUnits.ext_iff]
  · have h_back : unitsRep (conjGal δ)⁻¹ (unitsRep cmConj (unitsRep δ r)) = unitsRep cmConj r := by
      rw [← map_inv conjGal]
      simp [DiscreteUnits.ext_iff, conjGal]
    have h_inv : unitsRep cmConj ((rootPowHom Ω m).1 1) = -(rootPowHom Ω m).1 1 := by
      simp [← map_cyclotomicCharMod_mul, isComplexConj_cmConj.cyclotomicCharMod_eq_neg_one]
    rw [h_back, ← neg_sub, ← map_sub, hδr, h_inv, neg_neg]

lemma characterModule_add_apply {X : Type*} [AddCommGroup X] (f f' : CharacterModule X) (u : X) :
    (f + f') u = f u + f' u := rfl

lemma characterModule_zero_apply {X : Type*} [AddCommGroup X] (u : X) :
    (0 : CharacterModule X) u = 0 := rfl

/-- A character `f : X → ℚ/ℤ` of an `O`-module `X` that kills all scalar multiples of the members of
a spanning set is zero. -/
lemma characterModule_eq_zero_of_span {O X : Type*} [CommRing O] [AddCommGroup X] [Module O X]
    {s : Set X} (hs : Submodule.span O s = ⊤) {f : CharacterModule X}
    (hf : ∀ t : O, ∀ u ∈ s, f (t • u) = 0) : f = 0 := by
  have h_all (u : X) : ∀ t : O, f (t • u) = 0 := by
    induction Submodule.eq_top_iff'.1 hs u using Submodule.span_induction with
    | mem u hu => exact fun t ↦ hf t u hu
    | zero => simp
    | add u u' _ _ hu hu' => simp [hu, hu']
    | smul r u _ hu => simp [smul_smul, hu]
  exact DFunLike.ext f 0 fun u ↦ by simpa [characterModule_zero_apply] using h_all u 1

namespace SelmerDatum

variable {ℓ : ℕ} [ThePrime ℓ] {E : Type} [Field E] [EmbeddedNumberField E] [NumberField.IsCMField E]
  {S₀ : Finset (FinPlace E)} {g₀ : Gal(Ω/E)} {O n ι : Type} [CommRing O] [PadicIntegerRing O ℓ]
  [Fintype n] [DecidableEq n] (T : SelmerDatum ℓ S₀ g₀ O n) {M N : ℕ} {a : O}

/-! ### New auxiliary primes -/

/-- The group `U ∩ U^c` of the elements `g` such that `g` and `g^c = conjGal g` lie in the kernel
`U = T.reductionKer M N` of the action on `T / ℓ ^ M` and on the `ℓ ^ N`-th roots of unity. It
contains `H = T.sahGroup` and the inertia groups at auxiliary primes. -/
def reductionKerInfConj (M N : ℕ) : Subgroup Gal(Ω/E) :=
  (T.reductionKer M N).toSubgroup ⊓ (T.reductionKer M N).toSubgroup.comap conjGal

lemma mem_reductionKerInfConj {g : Gal(Ω/E)} :
    g ∈ T.reductionKerInfConj M N ↔ g ∈ T.reductionKer M N ∧ conjGal g ∈ T.reductionKer M N :=
  Iff.rfl

/-- The group `T.reductionKerInfConj M N = U ∩ U^c` is open. It consists of the `g` such that `g`
and `g^c = conjGal g` lie in `U = T.reductionKer M N`. It is open because `U` is open and
conjugation is continuous. -/
lemma isOpen_reductionKerInfConj : IsOpen (T.reductionKerInfConj M N : Set Gal(Ω/E)) :=
  (T.reductionKer M N).isOpen.inter ((T.reductionKer M N).isOpen.preimage continuous_conjGal)

lemma sahGroup_le_reductionKerInfConj : T.sahGroup ≤ T.reductionKerInfConj M N := fun _ hh ↦
  T.mem_reductionKerInfConj.2
  ⟨T.mem_reductionKer_of_mem_sahGroup hh,
    T.mem_reductionKer_of_mem_sahGroup (conjGal_mem_sahGroup hh)⟩

/-- Let the prime `P` and its conjugate lie outside `S₀`, and let the place `B` of `Ω` lie over `P`.
Then the inertia group of `B` lies in `U ∩ U^c`, where `U = T.reductionKer M N`. -/
lemma mem_reductionKerInfConj_of_mem_inertiaGroup {P : FinPlace E} (hP : P ∉ S₀) (hP' : star P ∉ S₀)
    {B : ClosurePlace} (hB : IsPlaceOver B P) {τ : Gal(Ω/E)} (hτ : τ ∈ inertiaGroup Gal(Ω/E) B) :
    τ ∈ T.reductionKerInfConj M N :=
  T.mem_reductionKerInfConj.2 ⟨T.mem_reductionKer_of_mem_inertiaAbove
    ⟨P, fun h ↦ hP (T.subset h), B, hB, hτ⟩,
    T.mem_reductionKer_of_mem_inertiaAbove
      ⟨star P, fun h ↦ hP' (T.subset h), _, hB.conjPlace_star, hτ.conjPlace_conjGal⟩⟩

variable {V : ι → Gal(Ω/E) → Prop} {W : Set Gal(Ω/E)} {P₀ : FinPlace E} {J : Finset (FinPlace E)}
  {x : FinPlace E → AuxPrimeData E (ℓ ^ N) × (ι → O)} {i : ι}

/-- Let `γ₀ = (x P₀).1.tameGenerator` be the tame generator at the first prime of `J`. Then `γ₀` and
its conjugate lie in `U = T.reductionKer M N`, the kernel of the action on `T / ℓ ^ M` and on the
`ℓ ^ N`-th roots of unity. -/
lemma γ₀_mem_reductionKerInfConj (hp : IsTiedPrimes ℓ S₀ V W N P₀ J x) :
    (x P₀).1.tameGenerator ∈ T.reductionKerInfConj M N := by
  obtain ⟨hP₀, -, -, hP₀_star⟩ := hp.auxiliary P₀ hp.first_mem
  have hP₀_data := hp.isAuxPrimeDataAt P₀ hp.first_mem
  exact T.mem_reductionKerInfConj_of_mem_inertiaGroup hP₀ hP₀_star hP₀_data.isPlaceOver
    hP₀_data.tame_gen.1

open scoped Classical in
/-- Let `T` be a Selmer datum: a lattice `O ^ n` over an `ℓ`-adic ring with Galois action `T.ρ`,
unramified outside `T.places ⊆ S₀`, with an inertial element `γ_* = T.γ` that acts by a scalar. Let
`H = T.sahGroup` be generated by all commutators with `γ_*` and with its complex conjugate, let `R`
contain `P₀`, `S₀` and `S̄₀`, and let `γ₀ = (x P₀).1.tameGenerator`. For `h ∈ H` the element `γ₀ h`
lies in the normal closure of the inertia groups at the places of `R` that are prime to `ℓ` and are
not among the primes of `J` other than `P₀` or their conjugates.

Here `J` is a set of auxiliary primes tied to one another (`IsTiedPrimes`): it lies outside `S₀`,
has a first prime `P₀`, whose Frobenius element lies in `W`, and each `v ∈ J` has data `(x v).1` and
a slope `(x v).2 i` for each datum `i`; `V i` is a condition on the Frobenius elements at primes of
nonzero slope. -/
lemma γ₀_mul_mem_normalClosure_inertiaAbove (hp : IsTiedPrimes ℓ S₀ V W N P₀ J x) {h : Gal(Ω/E)}
    (hh : h ∈ T.sahGroup) {R : Set (FinPlace E)} (hP₀R : P₀ ∈ R)
    (hS₀R : ∀ v ∈ S₀, v ∈ R ∧ star v ∈ R) :
    (x P₀).1.tameGenerator * h ∈
      normalClosure (inertiaAbove (R \ (Set.conjClosure (J.erase P₀) ∪ placesDividing E ℓ))) := by
  set Z : Set (FinPlace E) := R \ (Set.conjClosure (J.erase P₀) ∪ placesDividing E ℓ)
  have h_aux (w : FinPlace E) (hw : w ∈ J) : w ∉ S₀ ∧ star w ∉ J ∧ star w ∉ S₀ := by
    grind [hp.auxiliary w hw]
  have hP₀_data := hp.isAuxPrimeDataAt P₀ hp.first_mem
  have hP₀Z : P₀ ∈ Z := by simp [Z, hP₀R, h_aux P₀ hp.first_mem, hP₀_data.notMem]
  have hSZ (v : FinPlace E) (hv : v ∈ T.places) (hvℓ : v ∉ placesDividing E ℓ) :
      v ∈ Z ∧ star v ∈ Z := by
    have hvJ : v ∉ J ∧ star v ∉ J := by grind [T.subset hv, star_star]
    simp [Z, hS₀R v (T.subset hv), hvℓ, hvJ]
  exact mul_mem
    (subset_normalClosure ⟨P₀, hP₀Z, _, hP₀_data.isPlaceOver, hP₀_data.tame_gen.1⟩)
    (sahGroup_le_normalClosure hSZ hh)

/-- Let `T` be a Selmer datum, let `V i g` say that `g` acts trivially on `T / ℓ ^ M`, and let
`γ₀ = (x P₀).1.tameGenerator`. For `h` in the group `H = T.sahGroup` generated by all commutators
with `T.γ` and with its complex conjugate, a finite set `R` and a neighbourhood `X` of `γ₀ h`, some
prime `P` with data `l` is a new auxiliary prime for datum `i`, lies outside `R ∪ R̄`, and has
`l.frob ∈ X`.

So `P` may be added to `J` with a nonzero slope for datum `i`. -/
lemma exists_isNewAuxiliaryPrime (hp : IsTiedPrimes ℓ S₀ V W N P₀ J x)
    (hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1) {h : Gal(Ω/E)}
    (hh : h ∈ T.sahGroup) (R : Finset (FinPlace E)) {X : Set Gal(Ω/E)}
    (hX : X ∈ nhds ((x P₀).1.tameGenerator * h)) :
    ∃ (P : FinPlace E) (l : AuxPrimeData E (ℓ ^ N)),
      IsNewAuxiliaryPrime ℓ V S₀ J P₀ x i P l ∧ P ∉ R ∧ star P ∉ R ∧ l.frob ∈ X := by
  classical
  have : NeZero P₀.q := ⟨P₀.one_lt_q.ne_bot⟩
  -- The primes dividing the norm of `P₀` are also avoided.
  let R₀ : Finset (FinPlace E) := (finite_natCast_mem (K := E) P₀.q).toFinset
  let R' : Finset (FinPlace E) := J ∪ (S₀ ∪ (R ∪ (S₀.image star ∪ R₀)))
  -- The target is a product of elements that are inertial at places of the avoided set prime to
  -- `ℓ` and outside the later primes of `J` and their conjugates.
  have h_target : (x P₀).1.tameGenerator * h ∈ normalClosure
      (inertiaAbove (R' \ (Set.conjClosure (J.erase P₀) ∪ placesDividing E ℓ))) :=
    T.γ₀_mul_mem_normalClosure_inertiaAbove hp hh (by simp [R', hp.first_mem])
      fun v hv ↦ by simp [R', hv]
  -- Near the target one stays in `X` and in `U ∩ U^c`, and the characters of the primes of `J`
  -- are constant.
  have h_near_char : ∀ᶠ g' in nhds ((x P₀).1.tameGenerator * h),
      ∀ v ∈ J, (x v).1.character g' = (x v).1.character ((x P₀).1.tameGenerator * h) :=
    J.eventually_all.2 fun v hv ↦ (hp.isAuxPrimeDataAt v hv).isLocallyConstant.eventually_eq _
  obtain ⟨P, hP, h_prime, l, ⟨hφX, hφU, hφ_char⟩, h_self, hl⟩ :=
    exists_isAuxPrimeDataAt N (J.erase P₀) R'.finite_toSet h_target <| Filter.Eventually.and hX <|
      (T.isOpen_reductionKerInfConj.eventually_mem <|
        mul_mem (T.γ₀_mem_reductionKerInfConj hp) (T.sahGroup_le_reductionKerInfConj hh)).and
          h_near_char
  obtain ⟨hPJ, hPS, hPR, hPJ', hPS', hPR'⟩ :
      P ∉ J ∧ P ∉ S₀ ∧ P ∉ R ∧ star P ∉ J ∧ star P ∉ S₀ ∧ star P ∉ R := by grind
  have hP₀ : P ∉ placesDividing E P₀.q := fun h_mem ↦
    hP (Or.inl (by simp [R', show P ∈ R₀ from (finite_natCast_mem P₀.q).mem_toFinset.2 h_mem]))
  -- Characters are trivial on `H`, so their values at the target are those at `γ₀`.
  have h_char (v : FinPlace E) (hv : v ∈ J) :
      (x v).1.character l.frob = if v = P₀ then Multiplicative.ofAdd 1 else 1 := by
    rw [hφ_char v hv, map_mul, map_eq_one_of_mem_sahGroup _ hh, mul_one,
      hp.character_tameGenerator_eq_ite hp.first_mem v hv]
  have h_triv (b : Bool) : V i (idOrConjInv b l.frob) := by
    obtain ⟨hφ, hφ_conj⟩ := T.mem_reductionKerInfConj.1 hφU
    refine (hV _).2 (T.mem_reductionKer (N := N).1 ?_).1
    cases b
    exacts [inv_mem hφ_conj, hφ]
  exact ⟨P, l,
    { prime_norm := h_prime, notMem := hPJ, star_notMem := hPJ', notMem_bad := hPS,
      star_notMem_bad := hPS', notMem_placesDividing := hP₀, anticyclotomic := hl,
      char_frob_eq_one := h_self, char_frob_eq_ite := h_char, apply_idOrConjInv_frob := h_triv },
    hPR, hPR', hφX⟩

/-! ### The form `Ψ` and the dual group -/

/-- Let `T` be a Selmer datum: a lattice `O ^ n` over an `ℓ`-adic ring, with action `T.ρ` of
`Gal(Ω/E)` that is unramified outside a subset of the finite set `S₀` of primes, which contains
those above `ℓ`. Let `a ∣ ℓ ^ M` and `M < N`, let the place `B` lie over a prime `P` with
`P, P̄ ∉ S₀`, let `τ` be inertial at `B`, and let `δ` be a normalised tame generator at `B` for
`ℓ ^ N`. The values of a locally constant cocycle `z` with coefficients in `T / a` at `τ, τ^{-c}`
are the same multiple of its values at `δ, δ^{-c}`. -/
lemma exists_apply_pair_eq_nsmul (hN : M < N) (ha : a ∣ ℓ ^ M) {P : FinPlace E} (hP : P ∉ S₀)
    (hP' : star P ∉ S₀) {B : ClosurePlace} (hB : IsPlaceOver B P) {τ δ : Gal(Ω/E)}
    (hτ : τ ∈ inertiaGroup Gal(Ω/E) B) (hδ : IsTameGeneratorFor (K := E) (ℓ ^ N) B δ)
    {z : Gal(Ω/E) → n → QuotSpan a}
    (hz : ∀ g h : Gal(Ω/E), z (g * h) = z g + T.ρ g • z h) (hz_lc : IsLocallyConstant z) :
    ∃ k : ℕ, z τ = k • z δ ∧ z (conjGal τ)⁻¹ = k • z (conjGal δ)⁻¹ := by
  have h_tors (b : n → QuotSpan a) : ℓ ^ N • b = 0 :=
    funext fun j ↦ nsmul_quot_eq_zero (ha.trans (pow_dvd_pow _ hN.le)) (b j)
  let : Module (ZMod (ℓ ^ N)) (n → QuotSpan a) := AddCommGroup.zmodModule h_tors
  have hℓ : ↑(ℓ ^ N) ∉ P.asIdeal := fun h_mem ↦ hP <| T.subset <| T.placesDividing_subset
    (P.isPrime.mem_of_pow_mem N (by simpa using h_mem))
  -- Inertia acts trivially, so `f` is a homomorphism on it.
  let f (g : Gal(Ω/E)) : (n → QuotSpan a) × (n → QuotSpan a) := (z g, z (conjGal g)⁻¹)
  have hf_lc : IsLocallyConstant f := hz_lc.prodMk (hz_lc.comp_continuous continuous_conjGal.inv)
  have hf_add : ∀ g ∈ inertiaGroup Gal(Ω/E) B, ∀ g' ∈ inertiaGroup Gal(Ω/E) B,
      f (g * g') = f g + f g' := fun g hg g' hg' ↦ by
    obtain ⟨hg_fix, -⟩ : g ∈ T.reductionKerInfConj M N :=
      T.mem_reductionKerInfConj_of_mem_inertiaGroup hP hP' hB hg
    obtain ⟨-, hg'_conj⟩ : g' ∈ T.reductionKerInfConj M N :=
      T.mem_reductionKerInfConj_of_mem_inertiaGroup hP hP' hB hg'
    have hg'_fix : (conjGal g')⁻¹ ∈ T.reductionKer M N := inv_mem hg'_conj
    simp only [f, map_mul, mul_inv_rev, hz, T.smul_eq_self_of_mem_reductionKer ha hg_fix,
      T.smul_eq_self_of_mem_reductionKer ha hg'_fix, add_comm (z (conjGal g')⁻¹), Prod.mk_add_mk]
  obtain ⟨k, hk⟩ : ∃ k : ℕ, f τ = k • f δ := hδ.exists_apply_eq_nsmul hB hℓ hτ f hf_lc hf_add
  exact ⟨k, Prod.ext_iff.1 hk⟩

/-- The form `Ψ(h, h') = ⟨z(h), y(h')⟩ - ⟨z(h'^c), y(h^c)⟩` attached to functions `z` and `y` on the
Galois group with values in `(O / a) ^ n` and in its character module. The pairing `⟨u, f⟩` is the
character `t ↦ f (t • u)` of `O`; this is the value of `Ψ(h, h')` at `t`. -/
def mirrorForm (z : Gal(Ω/E) → n → QuotSpan a) (y : Gal(Ω/E) → CharacterModule (n → QuotSpan a))
    (t : O) (h h' : Gal(Ω/E)) : AddCircle (1 : ℚ) :=
  y h' (t • z h) - y (conjGal h) (t • z (conjGal h'))

open scoped Classical in
/-- The functions `z` with `ev_φ z ∈ ev_γ (Sel^𝔮(J))` modulo `a`. Here `𝔮 = P` is a new prime with
Frobenius element `φ = l.frob` and tame generator `γ = l.tameGenerator`, `ev_g` (`evalConjPair g`)
takes the values at `g` and `g^{-c}`, and `Sel^𝔮(J)` is the tied Selmer group with ramification also
allowed at `𝔮, 𝔮̄`. -/
abbrev frobInTameImage (J : Finset (FinPlace E))
    (x : FinPlace E → AuxPrimeData E (ℓ ^ N) × (ι → O)) (i : ι) (a : O) (P : FinPlace E)
    (l : AuxPrimeData E (ℓ ^ N)) : Submodule O (Gal(Ω/E) → n → QuotSpan a) :=
  ((T.tiedSelmer (insert P J) J x i a).map (evalConjPair l.tameGenerator)).comap
    (evalConjPair l.frob)

section Steps

variable {T}

/-- A member `y` of the dual Selmer group is equivariant on `U`: `y (g u g⁻¹) = cyc(g) · y(u) ∘ g⁻¹`
for `u ∈ U`, where `g⁻¹` acts on `T / a` by `T.ρ` and `cyc` is the `ℓ`-adic cyclotomic character
with values in `O`, the coefficient ring of the lattice `T = O ^ n`. -/
lemma apply_conj_of_mem_dualSelmer {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} (hy : y ∈ T.dualSelmer hp hV hN ha A R)
    (g : Gal(Ω/E)) {u : Gal(Ω/E)} (hu : u ∈ T.reductionKer M N) (m : n → QuotSpan a) :
    y (g * u * g⁻¹) m = y u ((cyclotomicCharIn O Ω ℓ g : O) • T.ρ g⁻¹ • m) := by
  -- On a module killed by `ℓ ^ N` the cyclotomic character acts through its reduction.
  have h_cyc (b : n → QuotSpan a) :
      (cyclotomicCharIn O Ω ℓ g : O) • b = (cyclotomicCharMod Ω (ℓ ^ N) g : ZMod (ℓ ^ N)).val •
        b := by
    simpa using map_cyclotomicChar_smul (σ := g) (Ω := Ω) (AddMonoidHom.id _) N
      (T.tiedSetting hp hV hN ha A).nsmul_eq_zero b
  rw [h_cyc, map_nsmul]
  exact hy.map_conj g u hu m

/-- A member `y` of the dual Selmer group is unramified at the first prime `P₀` of `J` and at its
conjugate, so it vanishes at the tame generator `γ₀ = (x P₀).1.tameGenerator` and at
`γ₀^c = conjGal γ₀`. -/
lemma apply_first_tameGenerator_eq_zero_of_mem_dualSelmer {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} (hy : y ∈ T.dualSelmer hp hV hN ha A R) :
    y (x P₀).1.tameGenerator = 0 ∧ y (conjGal (x P₀).1.tameGenerator) = 0 := by
  have hP₀_data := hp.isAuxPrimeDataAt P₀ hp.first_mem
  exact ⟨hy.unramified _ ⟨P₀, by simp, _, hP₀_data.isPlaceOver, hP₀_data.tame_gen.1⟩,
    hy.unramified _ ⟨star P₀, by simp, _, hP₀_data.isPlaceOver.conjPlace_star,
      hP₀_data.tame_gen.1.conjPlace_conjGal⟩⟩

/-- Sah's argument for the dual module: a member `y` of the dual Selmer group that vanishes on `H`
is zero everywhere. -/
lemma eq_zero_of_mem_dualSelmer_of_forall_sahGroup {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} (hy : y ∈ T.dualSelmer hp hV hN ha A R)
    (hH : ∀ h ∈ T.sahGroup, y h = 0) : y = 0 := by
  funext g
  by_cases hg : g ∈ T.reductionKer M N
  · -- As `[g, γ_*] · γ_* g γ_*⁻¹ = g`, we get `y(g) = y(γ_* g γ_*⁻¹) = y(g) ∘ γ_*⁻¹`.
    have h_comm : ⁅g, T.γ⁆ ∈ T.sahGroup := T.commutator_γ_mem g
    have h_conj : T.γ * g * T.γ⁻¹ ∈ T.reductionKer M N :=
      (T.reductionKer M N).isNormal'.conj_mem g hg T.γ
    have h_mul : ⁅g, T.γ⁆ * (T.γ * g * T.γ⁻¹) = g := by simp [commutatorElement_def, mul_assoc]
    have h_same : y g = y (T.γ * g * T.γ⁻¹) :=
      calc y g = y ⁅g, T.γ⁆ + y (T.γ * g * T.γ⁻¹) := by
            rw [← hy.map_mul _ (T.mem_reductionKer_of_mem_sahGroup h_comm) _ h_conj, h_mul]
        _ = y (T.γ * g * T.γ⁻¹) := by rw [hH _ h_comm, zero_add]
    have h_val (m : n → QuotSpan a) : y g (T.ρ T.γ • m) = y g m :=
      calc y g (T.ρ T.γ • m) = y (T.γ * g * T.γ⁻¹) (T.ρ T.γ • m) := by rw [← h_same]
        _ = y g ((cyclotomicCharIn O Ω ℓ T.γ : O) • T.ρ T.γ⁻¹ • T.ρ T.γ • m) :=
          apply_conj_of_mem_dualSelmer hy T.γ hg _
        _ = y g m := by
          rw [← mul_smul (T.ρ T.γ⁻¹), ← map_mul, inv_mul_cancel]
          simp [T.cyclotomicChar_γ]
    -- So `y(g)` kills the image of `γ_* - 1`, which is all of `(O / a) ^ n`.
    refine DFunLike.ext _ _ fun b ↦ ?_
    obtain ⟨m, rfl⟩ : ∃ m : n → QuotSpan a, T.ρ T.γ • m - m = b :=
      T.bijective_γ_smul_sub.surjective b
    rw [map_sub, h_val, sub_self, Pi.zero_apply, characterModule_zero_apply]
  · exact hy.eq_zero_of_notMem g hg

/-! ### First step: `Ψ(h, h) = 0` -/

open scoped Classical in
/-- Let `y` lie in the dual Selmer group. Let `P` be a new auxiliary prime for datum `i`, with
`P, P̄ ∉ R`: it has prime norm, lies with `P̄` outside `J ∪ S₀`, and its data `l` (tame generator
`γ`, Frobenius element `φ`, character) meet the conditions `IsNewAuxiliaryPrime` for being added to
`J` with a nonzero slope, among them `V i` at `φ` and `φ^{-c}`. Suppose `φ, φ^c ∈ U`, where
`g^c = conjGal g` is the conjugate of `g` by complex conjugation and `g^{-c} = (g^c)⁻¹`. Every `z`
in the tied Selmer group in which ramification is also allowed at `P, P̄` (with no tie there) has
`y(φ)(t z(γ)) + y(φ^c)(t z(γ^{-c})) = 0` for all `t ∈ O`. -/
lemma dualSelmer_frob_add_conj_frob_eq_zero {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} (hy : y ∈ T.dualSelmer hp hV hN ha A R)
    {P : FinPlace E} {l : AuxPrimeData E (ℓ ^ N)} (hl : IsNewAuxiliaryPrime ℓ V S₀ J P₀ x i P l)
    (hPR : P ∉ R) (hPR' : star P ∉ R) (hφ : l.frob ∈ T.reductionKer M N)
    (hφ_conj : conjGal l.frob ∈ T.reductionKer M N) {z : Gal(Ω/E) → n → QuotSpan a}
    (hz : z ∈ T.tiedSelmer (insert P J) J x i a) (t : O) :
    y l.frob (t • z l.tameGenerator) + y (conjGal l.frob) (t • z (conjGal l.tameGenerator)⁻¹) =
      0 := by
  have hP_data : IsAuxPrimeDataAt (↑(J.erase P₀) ∪ placesDividing E ℓ) P l :=
    hl.anticyclotomic _ subset_rfl
  obtain ⟨hz_coc, -, -, hz_lc⟩ := mem_selmerModule_iff.1 hz
  -- Reciprocity needs normalised generators `δ` and `δ^{-c}`; pass to a multiple of `z`.
  obtain ⟨δ, hδ⟩ := exists_isTameGeneratorFor Gal(Ω/E) (ℓ ^ N) hP_data.isPlaceOver
  obtain ⟨k, hk, hk'⟩ :
      ∃ k : ℕ, z l.tameGenerator = k • z δ ∧ z (conjGal l.tameGenerator)⁻¹ = k • z (conjGal δ)⁻¹ :=
    T.exists_apply_pair_eq_nsmul hN ha hl.notMem_bad hl.star_notMem_bad hP_data.isPlaceOver
      hP_data.tame_gen.1 hδ hz_coc hz_lc
  let p : SplitPrime (ℓ ^ N) (T.reductionKer M N) :=
    { prime := P, place := l.place, isPlaceOver := hP_data.isPlaceOver, frob := l.frob
      isFrob := hP_data.isFrob, frob_mem := hφ, tameGenerator := δ, isTameGeneratorFor := hδ }
  let p' : SplitPrime (ℓ ^ N) (T.reductionKer M N) :=
    { prime := star P, place := conjPlace l.place, isPlaceOver := hP_data.isPlaceOver.conjPlace_star
      frob := conjGal l.frob, isFrob := by simpa using hP_data.isFrob.conjPlace_conjGal
      frob_mem := hφ_conj, tameGenerator := (conjGal δ)⁻¹
      isTameGeneratorFor := isTameGeneratorFor_conjGal_inv hP_data.isPlaceOver hδ }
  have h_ram : (unionWithConj T.places ((insert P J).erase P₀) : Set (FinPlace E)) ⊆
      unionWithConj T.places (J.erase P₀) ∪ Set.range fun j : Fin 2 ↦ (![p, p'] j).prime := by
    intro v hv
    have hv_cases : v ∈ unionWithConj T.places (J.erase P₀) ∨ v = P ∨ v = star P := by grind
    simpa [p, p', Matrix.range_cons, or_comm, eq_comm] using hv_cases
  have h_mem : t • k • z ∈ (T.tiedSetting hp hV hN ha A).cocycles
      (Set.range fun j : Fin 2 ↦ (![p, p'] j).prime) :=
    T.mem_cocycles_tiedSetting hp hV hN ha A
      (T.mem_selmerModule_erase hp ha (Submodule.smul_mem _ t (nsmul_mem hz k)))
      (Set.union_subset_union_left _ Set.subset_union_left) h_ram
  have h_zero : ∑ j : Fin 2, y (![p, p'] j).frob ((t • k • z) (![p, p'] j).tameGenerator) = 0 :=
    hy.sum_eq_zero ![p, p']
      (by simp [Function.Injective, Fin.forall_fin_two, p, p', hP_data.star_ne,
        hP_data.star_ne.symm])
      (by simp [p, p', hPR, hPR']) _ h_mem
  simpa [p, p', hk, hk'] using h_zero

/-- Let `y` lie in the dual Selmer group and `z` in the tied Selmer group. Suppose that at every new
auxiliary prime `P` for datum `i` the values of `z` at `φ, φ^{-c}` are the values at `γ, γ^{-c}` of
a member of the tied Selmer group with ramification also allowed at `P, P̄` (`frobInTameImage`);
here `φ` is the Frobenius element and `γ` the tame generator at `P`. Then the form
`Ψ = mirrorForm z y t`, given by `Ψ(h, h') = y(h')(t z(h)) - y(h^c)(t z(h'^c))`, has `Ψ(h, h) = 0`
for `h ∈ H`. -/
lemma mirrorForm_self_eq_zero {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} {z : Gal(Ω/E) → n → QuotSpan a}
    (hy : y ∈ T.dualSelmer hp hV hN ha A R) (hz : z ∈ T.tiedSelmer J J x i a)
    (hz_frobInTameImage : ∀ (P : FinPlace E) (l : AuxPrimeData E (ℓ ^ N)),
      IsNewAuxiliaryPrime ℓ V S₀ J P₀ x i P l →
      z ∈ T.frobInTameImage J x i a P l)
    (t : O) {h : Gal(Ω/E)} (hh : h ∈ T.sahGroup) :
    mirrorForm z y t h h = 0 := by
  classical
  obtain ⟨hz_coc, hz_lc⟩ :
      (∀ g g' : Gal(Ω/E), z (g * g') = z g + T.ρ g • z g') ∧ IsLocallyConstant z :=
    (mem_selmerModule_iff.1 hz).imp_right fun ⟨_, _, h_lc⟩ ↦ h_lc
  -- As `z` and `y` vanish at `γ₀` and `γ₀^c`, the form has the same value at `h` and at `g = γ₀ h`.
  let g : Gal(Ω/E) := (x P₀).1.tameGenerator * h
  obtain ⟨hγ₀, hγ₀_conj⟩ : (x P₀).1.tameGenerator ∈ T.reductionKerInfConj M N :=
    T.γ₀_mem_reductionKerInfConj hp
  obtain ⟨hU, hU_conj⟩ : h ∈ T.reductionKerInfConj M N := T.sahGroup_le_reductionKerInfConj hh
  have hz₀ : z (x P₀).1.tameGenerator = 0 :=
    T.apply_first_tameGenerator_eq_zero_of_mem_tiedSelmer hp hz true
  have hz₀_conj : z (conjGal (x P₀).1.tameGenerator) = 0 :=
    (cocycleKer _ hz_coc).inv_mem_iff.1 (T.apply_first_tameGenerator_eq_zero_of_mem_tiedSelmer hp hz
      false)
  obtain ⟨hy₀, hy₀_conj⟩ : y (x P₀).1.tameGenerator = 0 ∧ y (conjGal (x P₀).1.tameGenerator) = 0 :=
    apply_first_tameGenerator_eq_zero_of_mem_dualSelmer hy
  have h_shift : mirrorForm z y t h h = mirrorForm z y t g g := by
    simp only [mirrorForm, g, map_mul, hz_coc, hz₀, hz₀_conj, hy.map_mul _ hγ₀ _ hU,
      hy.map_mul _ hγ₀_conj _ hU_conj, hy₀, hy₀_conj, zero_add,
      T.smul_eq_self_of_mem_reductionKer ha hγ₀, T.smul_eq_self_of_mem_reductionKer ha hγ₀_conj]
  -- Take a new auxiliary prime with Frobenius element `φ` so near `g` that `Ψ(φ, φ) = Ψ(g, g)`.
  have h_lc : IsLocallyConstant fun u : Gal(Ω/E) ↦ mirrorForm z y t u u :=
    have h_pair := hy.isLocallyConstant.comp₂ hz_lc fun f b ↦ f (t • b)
    h_pair.sub (h_pair.comp_continuous continuous_conjGal)
  have h_near : ∀ᶠ u in nhds g,
      mirrorForm z y t u u = mirrorForm z y t g g ∧ u ∈ T.reductionKerInfConj M N :=
    (h_lc.eventually_eq g).and <| T.isOpen_reductionKerInfConj.eventually_mem <|
      mul_mem (T.γ₀_mem_reductionKerInfConj hp) (T.sahGroup_le_reductionKerInfConj hh)
  obtain ⟨P, l, hl, hPR, hPR', h_same, hφ, hφ_conj⟩ :
      ∃ (P : FinPlace E) (l : AuxPrimeData E (ℓ ^ N)),
        IsNewAuxiliaryPrime ℓ V S₀ J P₀ x i P l ∧ P ∉ R ∧ star P ∉ R ∧
          mirrorForm z y t l.frob l.frob = mirrorForm z y t g g ∧
            l.frob ∈ T.reductionKerInfConj M N :=
    T.exists_isNewAuxiliaryPrime hp hV hh R h_near
  -- By hypothesis some `z'` has `z'(γ) = z(φ)` and `z'(γ^{-c}) = z(φ^{-c}) = -z(φ^c)`.
  obtain ⟨z', hz', h_ev⟩ : ∃ z' ∈ T.tiedSelmer (insert P J) J x i a,
      evalConjPair (O := O) l.tameGenerator z' = evalConjPair (O := O) l.frob z :=
    hz_frobInTameImage P l hl
  have h_val (b : Bool) : z' (idOrConjInv b l.tameGenerator) = z (idOrConjInv b l.frob) :=
    funext fun j ↦ by simpa only [evalConjPair_apply] using congrFun h_ev (b, j)
  have h_γ : z' l.tameGenerator = z l.frob := h_val true
  have h_γ_conj : z' (conjGal l.tameGenerator)⁻¹ = -z (conjGal l.frob) :=
    calc z' (conjGal l.tameGenerator)⁻¹ = z (conjGal l.frob)⁻¹ := h_val false
      _ = -(T.ρ (conjGal l.frob)⁻¹ • z (conjGal l.frob)) := cocycle_apply_inv hz_coc _
      _ = -z (conjGal l.frob) := by rw [T.smul_eq_self_of_mem_reductionKer ha (inv_mem hφ_conj)]
  calc mirrorForm z y t h h = mirrorForm z y t l.frob l.frob := h_shift.trans h_same.symm
    _ = y l.frob (t • z' l.tameGenerator) + y (conjGal l.frob)
      (t • z' (conjGal l.tameGenerator)⁻¹) := by
      rw [h_γ, h_γ_conj, smul_neg, map_neg, mirrorForm, sub_eq_add_neg]
    _ = 0 := dualSelmer_frob_add_conj_frob_eq_zero hy hl hPR hPR' hφ hφ_conj hz' t

/-! ### Second step: `Ψ = 0` -/

/-- Let `y` lie in the dual Selmer group and `z` in the tied Selmer group. Suppose that at every new
auxiliary prime `P` for datum `i` the values of `z` at `φ, φ^{-c}` are the values at `γ, γ^{-c}` of
a member of the tied Selmer group with ramification also allowed at `P, P̄` (`frobInTameImage`);
here `φ` is the Frobenius element and `γ` the tame generator at `P`. Then the form
`Ψ(h, h') = y(h')(t z(h)) - y(h^c)(t z(h'^c))` has `Ψ(h, h') + Ψ(h', h) = 0` on `H`. -/
lemma mirrorForm_add_swap_eq_zero {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} {z : Gal(Ω/E) → n → QuotSpan a}
    (hy : y ∈ T.dualSelmer hp hV hN ha A R) (hz : z ∈ T.tiedSelmer J J x i a)
    (hz_frobInTameImage : ∀ (P : FinPlace E) (l : AuxPrimeData E (ℓ ^ N)),
      IsNewAuxiliaryPrime ℓ V S₀ J P₀ x i P l →
      z ∈ T.frobInTameImage J x i a P l)
    (t : O) {h h' : Gal(Ω/E)} (hh : h ∈ T.sahGroup) (hh' : h' ∈ T.sahGroup) :
    mirrorForm z y t h h' + mirrorForm z y t h' h = 0 := by
  have hz_mul {g : Gal(Ω/E)} (hg : g ∈ T.reductionKer M N) (g' : Gal(Ω/E)) :
      z (g * g') = z g + z g' := by
    rw [(mem_selmerModule_iff.1 hz).1, T.smul_eq_self_of_mem_reductionKer ha hg]
  obtain ⟨hU, hU_conj⟩ := T.sahGroup_le_reductionKerInfConj (M := M) (N := N) hh
  obtain ⟨hU', hU'_conj⟩ := T.sahGroup_le_reductionKerInfConj (M := M) (N := N) hh'
  -- `Ψ` is biadditive on `H` and vanishes on the diagonal.
  have h_expand : mirrorForm z y t (h * h') (h * h') =
      mirrorForm z y t h h + mirrorForm z y t h' h' +
        (mirrorForm z y t h h' + mirrorForm z y t h' h) := by
    simp only [mirrorForm, map_mul, hz_mul hU, hz_mul hU_conj, hy.map_mul _ hU _ hU',
      hy.map_mul _ hU_conj _ hU'_conj, smul_add, map_add, characterModule_add_apply]
    abel
  simpa [mirrorForm_self_eq_zero hy hz hz_frobInTameImage t, hh, hh', mul_mem] using h_expand.symm

/-- Let `y` lie in the dual Selmer group, let `z` be a cocycle with values in `T / a`, and let
`h, h^c` lie in `U`. In the form `Ψ_t(h, h') = y(h')(t z(h)) - y(h^c)(t z(h'^c))`, conjugating the
first argument `h` by `γ_* = T.γ` multiplies the parameter `t` by `ζ_* = T.ζ`. The element `T.γ` is
the inertial element of the datum: both `T.γ` and `(conjGal T.γ)⁻¹` act on `T` by the scalar
`T.ζ`. -/
lemma mirrorForm_conj_γ_left {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} {z : Gal(Ω/E) → n → QuotSpan a}
    (hy : y ∈ T.dualSelmer hp hV hN ha A R)
    (hz : ∀ g g' : Gal(Ω/E), z (g * g') = z g + T.ρ g • z g') (t : O) {h : Gal(Ω/E)}
    (hh : h ∈ T.reductionKer M N) (hh_conj : conjGal h ∈ T.reductionKer M N) (h' : Gal(Ω/E)) :
    mirrorForm z y t (T.γ * h * T.γ⁻¹) h' = mirrorForm z y (T.ζ * t) h h' := by
  have hz_conj : z (T.γ * h * T.γ⁻¹) = T.ζ • z h := by
    rw [cocycle_conj_of_fixed hz _ (T.smul_eq_self_of_mem_reductionKer ha hh), T.ρ_γ, smul_one_smul]
  have hy_conj (b : n → QuotSpan a) :
      y (conjGal (T.γ * h * T.γ⁻¹)) b = y (conjGal h) (T.ζ • b) := by
    simp [apply_conj_of_mem_dualSelmer hy _ hh_conj, T.ρ_conjGal_γ_inv, T.cyclotomicChar_γ]
  simp only [mirrorForm, hz_conj, hy_conj, smul_smul, mul_comm t]

/-- Let `y` lie in the dual Selmer group, let `z` be a cocycle with values in `T / a`, and let
`h, h^c` lie in `U = T.reductionKer M N`. In the form
`Ψ_t(h', h) = y(h)(t z(h')) - y(h'^c)(t z(h^c))`, conjugating the
second argument `h` by `γ_* = T.γ` removes a factor `ζ_* = T.ζ` from the parameter. -/
lemma mirrorForm_conj_γ_right {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} {z : Gal(Ω/E) → n → QuotSpan a}
    (hy : y ∈ T.dualSelmer hp hV hN ha A R)
    (hz : ∀ g g' : Gal(Ω/E), z (g * g') = z g + T.ρ g • z g') (t : O) {h : Gal(Ω/E)}
    (hh : h ∈ T.reductionKer M N) (hh_conj : conjGal h ∈ T.reductionKer M N) (h' : Gal(Ω/E)) :
    mirrorForm z y (T.ζ * t) h' (T.γ * h * T.γ⁻¹) = mirrorForm z y t h' h := by
  have h_inv {g : Gal(Ω/E)} (hg : T.ρ g = T.ζ • 1) (b : n → QuotSpan a) :
      T.ρ g⁻¹ • T.ζ • b = b := by
    rw [← smul_one_smul (Matrix n n O) T.ζ b, ← hg, ← mul_smul, ← map_mul, inv_mul_cancel,
      map_one, one_smul]
  have hy_conj (b : n → QuotSpan a) : y (T.γ * h * T.γ⁻¹) (T.ζ • b) = y h b := by
    calc y (T.γ * h * T.γ⁻¹) (T.ζ • b)
        = y h ((cyclotomicCharIn O Ω ℓ T.γ : O) • T.ρ T.γ⁻¹ • T.ζ • b) :=
          apply_conj_of_mem_dualSelmer hy _ hh _
      _ = y h b := by simp [h_inv T.ρ_γ, T.cyclotomicChar_γ]
  have hz_conj : T.ζ • z (conjGal (T.γ * h * T.γ⁻¹)) = z (conjGal h) :=
    calc T.ζ • z (conjGal (T.γ * h * T.γ⁻¹)) = T.ζ • T.ρ (conjGal T.γ) • z (conjGal h) := by
          rw [map_mul, map_mul, map_inv,
            cocycle_conj_of_fixed hz _ (T.smul_eq_self_of_mem_reductionKer ha hh_conj)]
      _ = T.ρ (conjGal T.γ)⁻¹⁻¹ • T.ζ • z (conjGal h) := by rw [inv_inv, smul_comm]
      _ = z (conjGal h) := h_inv T.ρ_conjGal_γ_inv _
  calc mirrorForm z y (T.ζ * t) h' (T.γ * h * T.γ⁻¹)
      = y (T.γ * h * T.γ⁻¹) (T.ζ • t • z h') -
          y (conjGal h') (t • T.ζ • z (conjGal (T.γ * h * T.γ⁻¹))) := by
        rw [mirrorForm, mul_smul, mul_comm T.ζ, mul_smul]
    _ = mirrorForm z y t h' h := by rw [hy_conj, hz_conj, mirrorForm]

/-- Let `y` lie in the dual Selmer group and `z` in the tied Selmer group. Suppose that at every new
auxiliary prime `P` for datum `i` the values of `z` at `φ, φ^{-c}` are the values at `γ, γ^{-c}` of
a member of the tied Selmer group with ramification also allowed at `P, P̄` (`frobInTameImage`);
here `φ` is the Frobenius element and `γ` the tame generator at `P`. Then the form
`Ψ(h, h') = y(h')(t z(h)) - y(h^c)(t z(h'^c))` vanishes on `H × H`. -/
lemma mirrorForm_eq_zero {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} {z : Gal(Ω/E) → n → QuotSpan a}
    (hy : y ∈ T.dualSelmer hp hV hN ha A R) (hz : z ∈ T.tiedSelmer J J x i a)
    (hz_frobInTameImage : ∀ (P : FinPlace E) (l : AuxPrimeData E (ℓ ^ N)),
      IsNewAuxiliaryPrime ℓ V S₀ J P₀ x i P l →
      z ∈ T.frobInTameImage J x i a P l)
    (t : O) {h h' : Gal(Ω/E)} (hh : h ∈ T.sahGroup) (hh' : h' ∈ T.sahGroup) :
    mirrorForm z y t h h' = 0 := by
  have hz_coc := (mem_selmerModule_iff.1 hz).1
  obtain ⟨hU, hU_conj⟩ := T.sahGroup_le_reductionKerInfConj (M := M) (N := N) hh
  -- Subtract antisymmetry at `h, h'` from antisymmetry at `γ_* h γ_*⁻¹, h'`, where `γ_* = T.γ`
  -- acts by the scalar `ζ_* = T.ζ`; this suffices as `ζ_* ^ 2 - 1` is a unit.
  obtain ⟨s, rfl⟩ : T.ζ ^ 2 - 1 ∣ t := T.isUnit_sq_sub_one.dvd
  have h_swap : mirrorForm z y s h h' + mirrorForm z y s h' h = 0 :=
    mirrorForm_add_swap_eq_zero hy hz hz_frobInTameImage s hh hh'
  have h_swap_conj : mirrorForm z y (T.ζ * (T.ζ * s)) h h' + mirrorForm z y s h' h = 0 := by
    simpa [mirrorForm_conj_γ_left hy hz_coc _ hU hU_conj,
      mirrorForm_conj_γ_right hy hz_coc s hU hU_conj] using
      mirrorForm_add_swap_eq_zero hy hz hz_frobInTameImage (T.ζ * s)
        (Normal.conj_mem inferInstance h hh T.γ) hh'
  calc mirrorForm z y ((T.ζ ^ 2 - 1) * s) h h'
      = mirrorForm z y (T.ζ * (T.ζ * s)) h h' - mirrorForm z y s h h' := by
        simp only [mirrorForm, sub_mul, one_mul, sub_smul, map_sub, sq, mul_assoc]
        abel
    _ = 0 := by linear_combination (norm := abel) h_swap_conj - h_swap

/-! ### Third step: the map `η` -/

/-- Let `y` lie in the dual Selmer group and `z` in the tied Selmer group. Suppose that at every new
auxiliary prime `P` for datum `i` the values of `z` at `φ, φ^{-c}` are the values at `γ, γ^{-c}` of
a member of the tied Selmer group with ramification also allowed at `P, P̄` (`frobInTameImage`);
here `φ` is the Frobenius element and `γ` the tame generator at `P`. Suppose also that `z(H)` spans
`(O / a) ^ n`. Then there is a linear map `η` from `(O / a) ^ n` to its character module with
`η(z(h)) = y(h^c)` for `h ∈ H`. -/
lemma exists_linearMap_apply_eq_dualSelmer_conj {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} {z : Gal(Ω/E) → n → QuotSpan a}
    (hy : y ∈ T.dualSelmer hp hV hN ha A R) (hz : z ∈ T.tiedSelmer J J x i a)
    (hz_frobInTameImage : ∀ (P : FinPlace E) (l : AuxPrimeData E (ℓ ^ N)),
      IsNewAuxiliaryPrime ℓ V S₀ J P₀ x i P l →
      z ∈ T.frobInTameImage J x i a P l)
    (hz_span : Submodule.span O (z '' T.sahGroup) = ⊤) :
    ∃ η : (n → QuotSpan a) →ₗ[O] CharacterModule (n → QuotSpan a),
      ∀ h ∈ T.sahGroup, η (z h) = y (conjGal h) := by
  let π : (T.sahGroup →₀ O) →ₗ[O] n → QuotSpan a :=
    Finsupp.linearCombination O fun h : T.sahGroup ↦ z h
  let θ : (T.sahGroup →₀ O) →ₗ[O] CharacterModule (n → QuotSpan a) :=
    Finsupp.linearCombination O fun h : T.sahGroup ↦ y (conjGal h)
  have hπ : Function.Surjective π := by
    simpa [← LinearMap.range_eq_top, π, Finsupp.range_linearCombination, Set.image_eq_range] using
      hz_span
  -- The vanishing of `mirrorForm` on `H × H`, extended linearly in the first argument.
  have h_pair (α : T.sahGroup →₀ O) (t : O) {h' : Gal(Ω/E)} (hh' : h' ∈ T.sahGroup) :
      θ α (t • z (conjGal h')) = y h' (t • π α) := by
    induction α using Finsupp.induction_linear with
    | zero => simp [characterModule_zero_apply]
    | add α β hα hβ => simp [characterModule_add_apply, hα, hβ]
    | single h s =>
      have h_form := mirrorForm_eq_zero hy hz hz_frobInTameImage (t * s) h.property hh'
      rw [mirrorForm, sub_eq_zero] at h_form
      simpa [π, θ, smul_smul, mul_comm s] using h_form.symm
  -- If `π α = 0`, then `θ α` kills all multiples of the `z(h'^c)`, and these span.
  have h_ker : LinearMap.ker π ≤ LinearMap.ker θ := by
    intro α hα
    refine characterModule_eq_zero_of_span hz_span ?_
    rintro t _ ⟨h', hh', rfl⟩
    simpa [LinearMap.mem_ker.1 hα] using h_pair α t (conjGal_mem_sahGroup hh')
  -- So `θ` factors through the surjection `π`.
  let η : (n → QuotSpan a) →ₗ[O] CharacterModule (n → QuotSpan a) :=
    (LinearMap.ker π).liftQ θ h_ker ∘ₗ (π.quotKerEquivOfSurjective hπ).symm.toLinearMap
  have hη (α : T.sahGroup →₀ O) : η (π α) = θ α := by simp [η]
  exact ⟨η, fun h hh ↦ by simpa [π, θ] using hη (Finsupp.single ⟨h, hh⟩ 1)⟩

/-- Let `y` lie in the dual Selmer group, let `z` be a cocycle such that `z(H)` spans `(O / a) ^ n`,
and let `η` be linear with `η(z(h)) = y(h^c)` on `H`. Then `η` lies in `conjDualHom ℓ T.ρ a`: it
satisfies `η(g u)(m) = η(u)(cyc(g^c) • (g^c)⁻¹ m)` for all `g, u, m`, where `g` acts by `T.ρ` and
`cyc` is the `ℓ`-adic cyclotomic character. -/
lemma mem_conjDualHom_of_apply_eq {hp : IsTiedPrimes ℓ S₀ V W N P₀ J x}
    {hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1} {hN : M < N} {ha : a ∣ ℓ ^ M}
    {A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}} {R : Finset (FinPlace E)}
    {y : Gal(Ω/E) → CharacterModule (n → QuotSpan a)} {z : Gal(Ω/E) → n → QuotSpan a}
    (hy : y ∈ T.dualSelmer hp hV hN ha A R)
    (hz : ∀ g g' : Gal(Ω/E), z (g * g') = z g + T.ρ g • z g')
    (hz_span : Submodule.span O (z '' T.sahGroup) = ⊤)
    {η : (n → QuotSpan a) →ₗ[O] CharacterModule (n → QuotSpan a)}
    (hη : ∀ h ∈ T.sahGroup, η (z h) = y (conjGal h)) : η ∈ conjDualHom ℓ T.ρ a := by
  intro g u
  induction Submodule.eq_top_iff'.1 hz_span u using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨h, hh, rfl⟩ := hu
    intro m
    have h_fix (b : n → QuotSpan a) : T.ρ h • b = b := by simp [ρ_eq_one_of_mem_sahGroup hh]
    calc η (T.ρ g • z h) m = η (z (g * h * g⁻¹)) m := by rw [cocycle_conj_of_fixed hz g h_fix]
      _ = y (conjGal g * conjGal h * (conjGal g)⁻¹) m := by
        rw [hη _ (Normal.conj_mem inferInstance h hh g), map_mul, map_mul, map_inv]
      _ = η (z h) ((cyclotomicCharIn O Ω ℓ (conjGal g) : O) • T.ρ (conjGal g)⁻¹ • m) := by
        rw [apply_conj_of_mem_dualSelmer hy _
          (T.mem_reductionKer_of_mem_sahGroup (conjGal_mem_sahGroup hh)),
          hη h hh]
  | zero => simp [characterModule_zero_apply]
  | add u u' _ _ hu hu' => simp [characterModule_add_apply, hu, hu']
  | smul t u _ hu => simp [smul_comm _ t, hu]

end Steps

/-- The dual Selmer group has length at most the global term of the Selmer datum `T`, the supremum
over `b ≠ 0` of the lengths of the modules of Galois equivariant maps from `(O / b) ^ n` to its dual
twisted by complex conjugation (`globalTerm`). The hypotheses concern a member `z` of the tied
Selmer group, some value of which has a unit coordinate, and ask that at every new auxiliary prime
`P` for datum `i` the values of `z` at `φ, φ^{-c}` are the values at `γ, γ^{-c}` of a member of the
tied Selmer group with ramification also allowed at `P, P̄` (`frobInTameImage`); here `φ` is the
Frobenius element and `γ` the tame generator at `P`, and `g^{-c} = (conjGal g)⁻¹` is the inverse of
the conjugate of `g` by complex conjugation. -/
theorem length_dualSelmer_le (hp : IsTiedPrimes ℓ S₀ V W N P₀ J x)
    (hV : ∀ g : Gal(Ω/E), V i g ↔ reduceModPow ℓ M T.ρ g = 1) (hN : M < N) (ha : a ∣ ℓ ^ M)
    (A : ∀ v : FinPlace E, {A : ClosurePlace // IsPlaceOver A v}) (R : Finset (FinPlace E))
    {z : Gal(Ω/E) → n → QuotSpan a} (hz : z ∈ T.tiedSelmer J J x i a)
    (hz_unit : ∃ (g : Gal(Ω/E)) (j : n), IsUnit (z g j))
    (hz_frobInTameImage : ∀ (P : FinPlace E) (l : AuxPrimeData E (ℓ ^ N)),
      IsNewAuxiliaryPrime ℓ V S₀ J P₀ x i P l →
      z ∈ T.frobInTameImage J x i a P l) :
    length O (T.dualSelmer hp hV hN ha A R) ≤ T.globalTerm := by
  have hz_coc : ∀ g g' : Gal(Ω/E), z (g * g') = z g + T.ρ g • z g' :=
    (mem_selmerModule_iff.1 hz).1
  have h_span : Submodule.span O (z '' T.sahGroup) = ⊤ :=
    span_image_sahGroup_eq_top hz_coc (T.apply_γ_eq_zero hz) hz_unit
  have h_map (y : T.dualSelmer hp hV hN ha A R) :
      ∃ η : (n → QuotSpan a) →ₗ[O] CharacterModule (n → QuotSpan a),
        ∀ h ∈ T.sahGroup, η (z h) = y.val (conjGal h) :=
    exists_linearMap_apply_eq_dualSelmer_conj y.property hz hz_frobInTameImage h_span
  choose η hη using h_map
  let Φ : T.dualSelmer hp hV hN ha A R →ₗ[O] conjDualHom ℓ T.ρ a :=
    { toFun y := ⟨η y, mem_conjDualHom_of_apply_eq y.property hz_coc h_span (hη y)⟩
      map_add' y y' := Subtype.ext <| LinearMap.ext_on h_span <|
        Set.forall_mem_image.2 fun h hh ↦ by simp [hη _ h hh]
      map_smul' t y := Subtype.ext <| LinearMap.ext_on h_span <|
        Set.forall_mem_image.2 fun h hh ↦ by simp [hη _ h hh] }
  -- If `η y = 0`, then `y` vanishes on `T.sahGroup`, so `y = 0`.
  have hΦ : Function.Injective Φ := by
    refine (injective_iff_map_eq_zero Φ).2 fun y hy ↦
      Subtype.ext (eq_zero_of_mem_dualSelmer_of_forall_sahGroup y.property fun h hh ↦ ?_)
    rw [← conjGal_conjGal h, ← hη y _ (conjGal_mem_sahGroup hh),
      show η y = 0 from congrArg Subtype.val hy, LinearMap.zero_apply]
  calc length O (T.dualSelmer hp hV hN ha A R) ≤ length O (conjDualHom ℓ T.ρ a) :=
        length_le_of_injective Φ hΦ
    _ ≤ ⨆ (b : O) (_ : b ≠ 0), length O (conjDualHom ℓ T.ρ b) :=
        le_iSup₂_of_le a (ne_zero_of_dvd_ne_zero (NeZero.ne _) ha) le_rfl
    _ = T.globalTerm := rfl

end SelmerDatum

end New.Selmer

