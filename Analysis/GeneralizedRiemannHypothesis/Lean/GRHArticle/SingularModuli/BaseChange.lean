import GRHArticle.SingularModuli.Support
import Mathlib.FieldTheory.LinearDisjoint

/-!
# Sparse annihilators under extension of the coefficient field

Linear disjointness preserves independence of each finite family of powers.
Therefore it preserves the least support of a polynomial annihilator, as in
`smd:prop:cmfield`.
-/

namespace GRHArticle.SingularModuli

open IntermediateField

variable {K L : Type*} [Field K] [Field L] [Algebra K L]
  {E F : IntermediateField K L}

/-- The intrinsic degree in the support upper bound is the degree of the simple extension. -/
theorem minimumSupport_le_finrank_adjoin_add_one {x : L} (hx : IsIntegral K x) :
    minimumSupport hx ≤ Module.finrank K K⟮x⟯ + 1 := by
  rw [adjoin.finrank hx]
  exact minimumSupport_le_natDegree_add_one hx

theorem linearIndepOn_powers_iff_of_linearDisjoint
    (hdisj : E.LinearDisjoint F) (x : F) (s : Set ℕ) :
    LinearIndepOn E (fun n : ℕ ↦ (x : L) ^ n) s ↔
      LinearIndepOn K (fun n : ℕ ↦ (x : L) ^ n) s := by
  constructor
  · intro h
    exact LinearIndependent.restrict_scalars' K h
  · intro h
    have hind : LinearIndependent K (fun n : s ↦ x ^ (n : ℕ)) := by
      apply LinearIndependent.of_comp F.val.toLinearMap
      change LinearIndependent K (fun n : s ↦ ((x ^ (n : ℕ) : F) : L))
      simpa only [LinearIndepOn, IntermediateField.coe_pow] using h
    have hE := hdisj.linearIndependent_right hind
    change LinearIndependent E (fun n : s ↦ ((x ^ (n : ℕ) : F) : L)) at hE
    simpa only [LinearIndepOn, IntermediateField.coe_pow] using hE

theorem hasSparseAnnihilator_iff_of_linearDisjoint
    (hdisj : E.LinearDisjoint F) (x : F) (t : ℕ) :
    HasSparseAnnihilator E (x : L) t ↔ HasSparseAnnihilator K (x : L) t := by
  apply not_iff_not.mp
  simp only [not_hasSparseAnnihilator_iff, linearIndepOn_powers_iff_of_linearDisjoint hdisj]

/-- The support equality in the linear-disjointness part of `smd:prop:cmfield`. -/
theorem minimumSupport_eq_of_linearDisjoint
    (hdisj : E.LinearDisjoint F) (x : F) (hx : IsIntegral K (x : L)) :
    minimumSupport (hx.tower_top : IsIntegral E (x : L)) = minimumSupport hx := by
  apply le_antisymm
  · rw [minimumSupport_le_iff, hasSparseAnnihilator_iff_of_linearDisjoint hdisj]
    exact hasSparseAnnihilator_minimumSupport hx
  · rw [minimumSupport_le_iff, ← hasSparseAnnihilator_iff_of_linearDisjoint hdisj]
    exact hasSparseAnnihilator_minimumSupport (hx.tower_top : IsIntegral E (x : L))

/-- A coefficient field linearly disjoint from the field generated by `x`
preserves the minimum support of `x`. -/
theorem minimumSupport_eq_of_linearDisjoint_adjoin {x : L} (hx : IsIntegral K x)
    (hdisj : E.LinearDisjoint K⟮x⟯) :
    minimumSupport (hx.tower_top : IsIntegral E x) = minimumSupport hx :=
  minimumSupport_eq_of_linearDisjoint hdisj ⟨x, mem_adjoin_simple_self K x⟩ hx

end GRHArticle.SingularModuli
