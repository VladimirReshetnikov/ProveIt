private def quartic55CoarseBoxes : Fin 4 → RationalComplexBox :=
  ![⟨⟨-13136686221, -13136686220⟩, ⟨-1, 1⟩⟩,
    ⟨⟨743, 744⟩, ⟨-114614, -114613⟩⟩,
    ⟨⟨743, 744⟩, ⟨114613, 114614⟩⟩,
    ⟨⟨107, 108⟩, ⟨-1, 1⟩⟩]

private def quartic55SquaredCoefficientList : List ℤ :=
  multiplyPackedIntegerPolynomial 9 quartic55CoefficientList quartic55CoefficientList

private theorem quartic55CoefficientList_eq :
    coefficientListPolynomial quartic55CoefficientList = quartic55Int := by
  ext n
  by_cases hn : n ≤ 4
  · let i : Fin 5 := ⟨n, Nat.lt_succ_of_le hn⟩
    have h (j : Fin 5) : quartic55CoefficientList.getD j 0 = quartic55PrintedCoefficient j := by
      fin_cases j <;> decide +kernel
    rw [coeff_coefficientListPolynomial, h i, ← quartic55_printed_coeff]
  · rw [coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt
      (natDegree_coefficientListPolynomial_le (n := 4) (by decide)) (lt_of_not_ge hn)),
      coeff_eq_zero_of_natDegree_lt (quartic55Int_natDegree.trans_lt (lt_of_not_ge hn))]


set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem diagonal59_factor :
    coefficientListPolynomial diagonal59Coefficients =
      quartic55Int^2 * coefficientListPolynomial diagonal59CofactorCoefficients := by
  have hcompute : diagonal59Coefficients =
      multiplyPackedIntegerPolynomial 119 quartic55SquaredCoefficientList
        diagonal59CofactorCoefficients := by
    decide +kernel
  have hH : (coefficientListPolynomial quartic55CoefficientList).natDegree ≤ 4 :=
    natDegree_coefficientListPolynomial_le (by decide)
  have hSq : (coefficientListPolynomial quartic55CoefficientList *
      coefficientListPolynomial quartic55CoefficientList).natDegree < 9 :=
    Polynomial.natDegree_mul_le.trans_lt (by omega)
  have hSqP : coefficientListPolynomial quartic55SquaredCoefficientList = quartic55Int^2 := by
    rw [quartic55SquaredCoefficientList, coefficientListPolynomial_multiplyPackedIntegerPolynomial _ _ _ hSq,
      quartic55CoefficientList_eq, pow_two]
  have hH2 : (coefficientListPolynomial quartic55SquaredCoefficientList).natDegree ≤ 8 :=
    natDegree_coefficientListPolynomial_le (by decide +kernel)
  have hR : (coefficientListPolynomial diagonal59CofactorCoefficients).natDegree ≤ 110 :=
    natDegree_coefficientListPolynomial_le (by decide)
  have hd : (coefficientListPolynomial quartic55SquaredCoefficientList *
      coefficientListPolynomial diagonal59CofactorCoefficients).natDegree < 119 :=
    Polynomial.natDegree_mul_le.trans_lt (by omega)
  rw [hcompute, coefficientListPolynomial_multiplyPackedIntegerPolynomial _ _ _ hd, hSqP]

private noncomputable def root55 (i : Fin 4) : ℂ :=
  modularInvariant (quadraticPoint 55 (quartic55Form i).a (quartic55Form i).b)

private theorem coarse_root55_contains (i : Fin 4)
    (hbound :
      let A := modularInvariantBox (quartic55QBox i)
      let B := quartic55CoarseBoxes i
      B.re.lo ≤ A.re.lo ∧ A.re.hi ≤ B.re.hi ∧ B.im.lo ≤ A.im.lo ∧ A.im.hi ≤ B.im.hi) :
    (quartic55CoarseBoxes i).Contains (root55 i) := by
  have h := quartic55_modularInvariant_box_contains i
  refine ⟨⟨(Rat.cast_le.mpr hbound.1).trans h.1.1,
       h.1.2.trans (Rat.cast_le.mpr hbound.2.1)⟩,
    ⟨(Rat.cast_le.mpr hbound.2.2.1).trans h.2.1,
       h.2.2.trans (Rat.cast_le.mpr hbound.2.2.2)⟩⟩

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem quartic55Cofactor_excludesZero (i : Fin 4) :
    ((quartic55CoarseBoxes i).evaluateIntegerCoefficients
      diagonal59CofactorCoefficients).ExcludesZero := by
  fin_cases i <;> decide +kernel

private theorem quartic55Coarse_pairwiseSeparated
    (i j : Fin 4) (hij : i < j) :
    (quartic55CoarseBoxes i).Separated (quartic55CoarseBoxes j) := by
  fin_cases i <;> fin_cases j <;> first
  | decide +kernel
  | exact ((by decide : ¬(_ : Fin 4) < _) hij).elim

set_option maxRecDepth 4000 in
private theorem quartic55_root_from_diagonal
    (hdiag : ∀ z : UpperHalfPlane, aeval (modularInvariant z)
      (coefficientListPolynomial diagonal59Coefficients) = -analyticPrimeHeckeDiagonal 59 z)
    (hbox : ∀ i : Fin 4, (quartic55CoarseBoxes i).Contains (root55 i)) (i : Fin 4) :
    aeval (root55 i) quartic55Int = 0 := by
  letI : Fact (Nat.Prime ((59 : ℕ+) : ℕ)) := ⟨by decide⟩
  let f := quartic55Form i
  let z := quadraticPoint 55 f.a f.b
  let P := coefficientListPolynomial diagonal59Coefficients
  let R := coefficientListPolynomial diagonal59CofactorCoefficients
  have hP : aeval (modularInvariant z) P = -analyticPrimeHeckeDiagonal 59 z :=
    hdiag z
  have hz : analyticPrimeHeckeDiagonal 59 z = 0 := quartic55_analyticPrimeHeckePolynomial_diagonal i
  have hn : aeval (modularInvariant z) R ≠ 0 :=
    RationalComplexBox.ne_zero_of_contains_of_excludesZero
      (RationalComplexBox.contains_evaluateIntegerCoefficients (hbox i) _) (quartic55Cofactor_excludesZero i)
  change aeval (modularInvariant z) quartic55Int = 0
  exact aeval_factor_eq_zero_of_primeHeckeDiagonal_zero 59 P quartic55Int R 2 hP diagonal59_factor hz hn

private theorem quartic55_root55_injective
    (hbox : ∀ i : Fin 4, (quartic55CoarseBoxes i).Contains (root55 i)) :
    Function.Injective root55 := by
  intro i j he
  rcases lt_trichotomy i j with lt | eq | gt
  · exact (RationalComplexBox.ne_of_contains_of_separated (hbox i) (hbox j)
      (quartic55Coarse_pairwiseSeparated i j lt) he).elim
  · exact eq
  · exact (RationalComplexBox.ne_of_contains_of_separated (hbox j) (hbox i)
      (quartic55Coarse_pairwiseSeparated j i gt) he.symm).elim

set_option maxHeartbeats 1000000 in
private theorem quartic55_identification_from_certificates
    (hdiag : ∀ z : UpperHalfPlane, aeval (modularInvariant z)
      (coefficientListPolynomial diagonal59Coefficients) = -analyticPrimeHeckeDiagonal 59 z)
    (hbox : ∀ i : Fin 4, (quartic55CoarseBoxes i).Contains (root55 i)) :
    analyticClassPolynomial 55 = quartic55Int.map (Int.castRingHom ℂ) := by
  classical
  let H := quartic55Int.map (Int.castRingHom ℂ)
  let Z := (Finset.univ : Finset (Fin 4)).val.map root55
  have hZ : Z.Nodup :=
    Finset.univ.nodup.map (quartic55_root55_injective hbox)
  have hH : H.Monic := quartic55Int_monic.map _
  have hZle : Z ≤ H.roots := by
    apply (Multiset.le_iff_subset hZ).mpr
    intro x hx
    obtain ⟨i, hi, rfl⟩ := Multiset.mem_map.mp hx
    refine (Polynomial.mem_roots hH.ne_zero).mpr ?_
    rw [Polynomial.IsRoot, ← Polynomial.eval₂_eq_eval_map]
    exact quartic55_root_from_diagonal hdiag hbox i
  have hdiv : (Z.map fun x ↦ X - C x).prod ∣ H :=
    (Multiset.prod_X_sub_C_dvd_iff_le_roots hH.ne_zero Z).mpr hZle
  have hclass : analyticClassPolynomial 55 = (Z.map fun x ↦ X - C x).prod := by
    have hrhs : (Z.map fun x ↦ X - C x).prod = ∏ i : Fin 4, (X - C (root55 i)) := by
      simp only [Z, Finset.prod_eq_multiset_prod, Multiset.map_map, Function.comp_def]
    rw [hrhs, Fin.prod_univ_four, analyticClassPolynomial, reducedForms_fiftyFive]
    rw [Finset.prod_insert (by decide), Finset.prod_insert (by decide), Finset.prod_insert (by decide),
      Finset.prod_singleton]
    simp only [root55, quartic55Form, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons, mul_assoc]
  rw [← hclass] at hdiv
  symm
  refine eq_of_monic_of_dvd_of_natDegree_le (analyticClassPolynomial_monic 55) hH hdiv ?_
  rw [analyticClassPolynomial_fiftyFive_natDegree, show H.natDegree = 4 by
    rw [Polynomial.natDegree_map_eq_of_injective Int.cast_injective, quartic55Int_natDegree]]

private theorem quartic55Coarse_bounds (i : Fin 4) :
    let A := modularInvariantBox (quartic55QBox i)
    let B := quartic55CoarseBoxes i
    B.re.lo ≤ A.re.lo ∧ A.re.hi ≤ B.re.hi ∧ B.im.lo ≤ A.im.lo ∧ A.im.hi ≤ B.im.hi := by
  dsimp only
  rw [quartic55_rootBoxes_eq]
  fin_cases i <;> decide +kernel

/-- A certified level-59 diagonal identifies the analytic class polynomial. -/
theorem analyticClassPolynomial_fiftyFive_eq_printed_of_diagonal
    (hdiag : ∀ z : UpperHalfPlane, aeval (modularInvariant z)
      (coefficientListPolynomial diagonal59Coefficients) = -analyticPrimeHeckeDiagonal 59 z) :
    analyticClassPolynomial 55 = quartic55Int.map (Int.castRingHom ℂ) :=
  quartic55_identification_from_certificates hdiag
    (fun i ↦ coarse_root55_contains i (quartic55Coarse_bounds i))

