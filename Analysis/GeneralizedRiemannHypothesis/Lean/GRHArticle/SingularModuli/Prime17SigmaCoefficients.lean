private theorem factorRows_check : DivisorPowerPrefixCertificate.check factorRows = true := by
  decide +kernel

private theorem factorRows_length : factorRows.length = 580 := by decide

/-- The table of sums of divisors to the power `3`, through index 579. -/
def sigma3Prefix : List ℕ := DivisorPowerPrefixCertificate.coefficients 3 factorRows

@[simp] theorem length_sigma3Prefix : sigma3Prefix.length = 580 := by
  rw [sigma3Prefix, DivisorPowerPrefixCertificate.length_coefficients, factorRows_length]

theorem getD_sigma3Prefix (n : ℕ) (hn : n < 580) :
    sigma3Prefix.getD n 0 = ArithmeticFunction.sigma 3 n := by
  exact DivisorPowerPrefixCertificate.getD_coefficients 3 factorRows_check n
    (by simpa only [factorRows_length] using hn)

/-- The table of sums of divisors to the power `5`, through index 579. -/
def sigma5Prefix : List ℕ := DivisorPowerPrefixCertificate.coefficients 5 factorRows

@[simp] theorem length_sigma5Prefix : sigma5Prefix.length = 580 := by
  rw [sigma5Prefix, DivisorPowerPrefixCertificate.length_coefficients, factorRows_length]

theorem getD_sigma5Prefix (n : ℕ) (hn : n < 580) :
    sigma5Prefix.getD n 0 = ArithmeticFunction.sigma 5 n := by
  exact DivisorPowerPrefixCertificate.getD_coefficients 5 factorRows_check n
    (by simpa only [factorRows_length] using hn)

