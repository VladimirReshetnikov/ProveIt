def invariantShort : List ℤ := invariant.take 35

def sigmaCoefficients (N k : ℕ) : List ℤ :=
  ((if k = 3 then sigma3Prefix else sigma5Prefix).take N).map Int.ofNat

def linearDiscriminantCoefficients : List ℤ :=
  List.zipWith (fun a b ↦ (((5*a + 7*b) / 12 : ℕ) : ℤ)) sigma3Prefix sigma5Prefix

def xExpr : IntegerPolynomialExpression := .coefficients [0,1]

def discriminantExpr : IntegerPolynomialExpression :=
  let a := .coefficients (sigmaCoefficients 580 3)
  let b := .coefficients (sigmaCoefficients 580 5)
  .sub (.add (.add (.coefficients (linearDiscriminantCoefficients))
    (.mul (.coefficients [100]) (.pow a 2))) (.mul (.coefficients [8000]) (.pow a 3)))
    (.mul (.coefficients [147]) (.pow b 2))

def eisensteinCubedExpr : IntegerPolynomialExpression :=
  .pow (.add (.coefficients [1]) (.mul (.coefficients [240])
    (.coefficients (sigmaCoefficients 579 3)))) 3

def elementaryRecurrenceExpr (n : ℕ) : IntegerPolynomialExpression :=
  sum <| List.ofFn fun i : Fin (n+1) ↦
    .mul (.coefficients [(-1 : ℤ) ^ (n+2+(i : ℕ)) * ↑(n.factorial / (i : ℕ).factorial)])
      (.mul (.coefficients elementaryTable[(i : ℕ)]!)
        (.coefficients traceTable[n+1-i]!))

def shortInvariantExpr : IntegerPolynomialExpression := .coefficients invariantShort

def expandedInvariantCoefficients : List ℤ :=
  List.ofFn fun i : Fin 35 ↦ if 17 ∣ (i : ℕ) then invariantShort.getD (i/17) 0 else 0

def scaledDiagonalExpr : IntegerPolynomialExpression :=
  .mul (.sub (.coefficients expandedInvariantCoefficients)
      (.mul (.pow xExpr 16) shortInvariantExpr))
    (sum <| List.ofFn fun k : Fin 18 ↦
      .mul (.coefficients [(-1 : ℤ) ^ (k : ℕ) * ↑((17 : ℕ).factorial / (k : ℕ).factorial)])
        (.mul (.coefficients elementaryTable[(k : ℕ)]!) (.pow shortInvariantExpr (17-k))))

def clearedDiagonalExpr : ℕ → IntegerPolynomialExpression
  | 0 => .coefficients [diagonal.getD 0 0]
  | n+1 => .add (.mul xExpr (clearedDiagonalExpr n))
      (.mul (.coefficients [diagonal.getD (n+1) 0]) (.pow shortInvariantExpr (n+1)))

local notation "cs" => IntegerPolynomialExpression.coefficients

/-- The residue test for the shifted discriminant. -/
abbrev DiscriminantCheck := (sub (mul xExpr (cs discriminant)) discriminantExpr).checkZeroPrefix 580

/-- The residue test for the normalized invariant times the discriminant. -/
abbrev InvariantCheck := (sub (mul (cs discriminant) (cs invariant)) eisensteinCubedExpr).checkZeroPrefix 579

/-- One trace row obtained from a packed power of the normalized invariant. -/
def packedTraceRow (k : ℕ) : List ℤ :=
  let p := packedNaturalPolynomialPower 579 (invariant.map Int.toNat) k
  List.ofFn fun i : Fin 35 ↦
    if 16*k ≤ 17*(i : ℕ) then
      (17 : ℤ) * (packedNaturalPolynomialPowerCoeff p (17*(i : ℕ)-16*k) : ℤ) else 0

abbrev TraceCheck (k : ℕ) := packedTraceRow k = traceTable[k]!

abbrev ElementaryZeroCheck :=
  (sub (cs elementaryTable[0]!) (cs [1])).checkZeroPrefix 35

abbrev ElementaryCheck (n : ℕ) :=
  (sub (cs elementaryTable[n+1]!) (elementaryRecurrenceExpr n)).checkZeroPrefix 35

abbrev DiagonalCheck :=
  (sub scaledDiagonalExpr (mul (cs [(17 : ℕ).factorial]) (clearedDiagonalExpr 34))).checkZeroPrefix 35

