private theorem joinExchangeBranches (e : IntegerPrefixTriple) (removed : List ℕ)
    (budget first middle last : ℕ)
    (he : integerBoundaryDirectFresh integerExchangeEdgeValid removed e = true)
    (hf : budget - integerExchangeCapacity e.first = first)
    (hm : budget - integerExchangeCapacity e.middle = middle)
    (hl : budget - integerExchangeCapacity e.last = last)
    (hfirst : ∀ C, IntegerBoundaryDirectCover integerExchangeEdgeValid (e.first::removed) C →
      first ≤ ∑ n ∈ C, integerExchangeCapacity n)
    (hmiddle : ∀ C, IntegerBoundaryDirectCover integerExchangeEdgeValid (e.middle::removed) C →
      middle ≤ ∑ n ∈ C, integerExchangeCapacity n)
    (hlast : ∀ C, IntegerBoundaryDirectCover integerExchangeEdgeValid (e.last::removed) C →
      last ≤ ∑ n ∈ C, integerExchangeCapacity n)
    (C : Finset ℕ) (hc : IntegerBoundaryDirectCover integerExchangeEdgeValid removed C) :
    budget ≤ ∑ n ∈ C, integerExchangeCapacity n := by
  refine integerBoundaryDirect_branch_bound he ?_ ?_ ?_ C hc
  · simpa only [hf] using hfirst
  · simpa only [hm] using hmiddle
  · simpa only [hl] using hlast

