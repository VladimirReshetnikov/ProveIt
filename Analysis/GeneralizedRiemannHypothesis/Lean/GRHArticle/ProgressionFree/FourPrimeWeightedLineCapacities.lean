import GRHArticle.ProgressionFree.FiniteGPBranchCertificate
import GRHArticle.ProgressionFree.Rankin
import Mathlib.Data.Nat.Bitwise

/-!
# Checked weighted capacities for nine-point exponent lines

Once three coordinates are fixed, the variable coordinate runs through
the digits zero through eight. The capacity of any available mask is
the largest possible inflated score among its progression-free subsets.
-/

namespace GRHArticle.ProgressionFree

open Finset
open scoped BigOperators

/-- Integer score in a length-nine line before multiplying by its fixed
three-coordinate factor. -/
def fourPrimeLineScore (p : ℕ) (otherGood : Bool) (a : ℕ) : ℕ :=
  (if otherGood && decide (a%3 ≤ 1 ∧ a/3 ≤ 1) then 20 else 21) * p^(8-a)

private def lineCapacity20 : ℕ :=
  

private def lineCapacity21 : ℕ :=
  

private def lineCapacity30 : ℕ :=
  

private def lineCapacity31 : ℕ :=
  

/-- The precomputed capacity, encoded in eighteen bits per mask. -/
def fourPrimeLineCapacity (p : ℕ) (otherGood : Bool) (mask : ℕ) : ℕ :=
  let table := if p = 2 then
    if otherGood then lineCapacity21 else lineCapacity20
  else
    if otherGood then lineCapacity31 else lineCapacity30
  (table >>> (18*(mask%512))) % 2^18

private def lineCheck (p : ℕ) (otherGood : Bool) (mask : ℕ) : Bool :=
  finiteGPBranchCheck (fourPrimeLineScore p otherGood)
    (fun a b c ↦ decide (a < b ∧ a+c = b+b))
    (fourPrimeLineCapacity p otherGood mask) 10 0 []
    ((List.range 9).filter mask.testBit)

set_option maxRecDepth 40000 in
set_option maxHeartbeats 0 in
private theorem lineCheck_two (otherGood : Bool) (mask : Fin 512) :
    lineCheck 2 otherGood mask.val = true := by
  cases otherGood
  · exact (show ∀ mask : Fin 512, lineCheck 2 false mask.val = true by decide +kernel) mask
  · exact (show ∀ mask : Fin 512, lineCheck 2 true mask.val = true by decide +kernel) mask

set_option maxRecDepth 40000 in
set_option maxHeartbeats 0 in
private theorem lineCheck_three (otherGood : Bool) (mask : Fin 512) :
    lineCheck 3 otherGood mask.val = true := by
  cases otherGood
  · exact (show ∀ mask : Fin 512, lineCheck 3 false mask.val = true by decide +kernel) mask
  · exact (show ∀ mask : Fin 512, lineCheck 3 true mask.val = true by decide +kernel) mask

/-- The cached capacity bounds any admitted points of a ternary low line. -/
theorem sum_fourPrimeLineScore_le_capacity (p : ℕ) (hp : p = 2 ∨ p = 3)
    (otherGood : Bool) (mask : ℕ) {A : Finset ℕ} (hA : A ⊆ range 9)
    (hFree : ThreeAPFree (A : Set ℕ)) (hMask : ∀ a ∈ A, mask.testBit a = true) :
    (∑ a ∈ A, fourPrimeLineScore p otherGood a) ≤ fourPrimeLineCapacity p otherGood mask := by
  let m : Fin 512 := ⟨mask%512,Nat.mod_lt _ (by decide)⟩
  have hm (a : ℕ) (ha : a ∈ A) : m.val.testBit a = true := by
    change (mask % 2^9).testBit a = true
    rw [Nat.testBit_mod_two_pow]
    simp [mem_range.mp (hA ha),hMask a ha]
  have hc : lineCheck p otherGood m.val = true := by
    rcases hp with rfl | rfl
    · exact lineCheck_two otherGood m
    · exact lineCheck_three otherGood m
  let test (a : ℕ) := decide (a ∈ A)
  let w := fourPrimeLineScore p otherGood
  have h := finiteGPBranchCheck_sound w (fun a b c ↦ decide (a < b ∧ a+c = b+b))
    (fourPrimeLineCapacity p otherGood m.val) test
    (by
      intro a b c ha hb hc
      apply Bool.eq_false_of_not_eq_true
      intro he
      obtain ⟨hlt,hMid⟩ := of_decide_eq_true he
      exact hlt.ne (hFree (of_decide_eq_true ha) (of_decide_eq_true hb) (of_decide_eq_true hc) hMid))
    10 ((List.range 9).filter m.val.testBit) hc
  let L := (List.range 9).filter test
  have hL : ((List.range 9).filter m.val.testBit).filter test = L := by
    rw [List.filter_filter]
    apply List.filter_congr
    intro a _
    by_cases ha : a ∈ A <;> simp [test,ha,hm]
  rw [hL] at h
  have hn : L.Nodup := List.nodup_range.filter _
  have hs : L.toFinset = A := by
    ext a
    simp only [L,List.mem_toFinset,List.mem_filter,List.mem_range,test,decide_eq_true_eq,and_iff_right_iff_imp]
    exact fun ha ↦ mem_range.mp (hA ha)
  have hM : (L : Multiset ℕ) = A.val := congrArg Finset.val ((List.toFinset_eq hn).trans hs)
  have hw : (L.map w).sum = ∑ a ∈ A, w a := by
    change (Multiset.map w (L : Multiset ℕ)).sum = _
    rw [hM]
    rfl
  rw [hw] at h
  simpa only [fourPrimeLineCapacity,m,Nat.mod_mod] using h

end GRHArticle.ProgressionFree
