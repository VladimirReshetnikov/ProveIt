             (⟨12,30,75⟩,1), (⟨13,26,52⟩,7), (⟨14,28,56⟩,7), (⟨15,30,60⟩,5),
             (⟨16,24,36⟩,3), (⟨17,34,68⟩,7), (⟨19,38,76⟩,7), (⟨20,30,45⟩,1),
             (⟨25,35,49⟩,3), (⟨27,45,75⟩,4), (⟨32,40,50⟩,2), (⟨36,42,49⟩,4),
             (⟨48,60,75⟩,2)]))))]

private def cardinalityCertificates (integral : Bool) : List (ℕ × CardinalityCertificate) :=
  if integral then integralCardinalityCertificates else rationalCardinalityCertificates

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem cardinalityCertificates_checked (integral : Bool) :
    verifyStages integral 0 (cardinalityCertificates integral) = true := by
  cases integral <;> decide +kernel

/-- The count certified by the 80-term cardinality certificates at cutoff `k`. -/
def integerPrefixCertifiedCountEighty (integral : Bool) (k : ℕ) : ℕ :=
  k - requiredCoverSize k 0 (cardinalityCertificates integral)

private theorem integerPrefixCardMax_eighty_le (integral : Bool) {k : ℕ} (hk : k ≤ 80) :
    integerPrefixCardMax integral k ≤ integerPrefixCertifiedCountEighty integral k := by
  classical
  unfold integerPrefixCardMax integerPrefixWeightMax
  apply Finset.sup_le
  intro A hA
  obtain ⟨hAs, hAd⟩ := mem_filter.mp hA
  have hAs := mem_powerset.mp hAs
  let C := integerPrefix k \ A
  have hcSub : C ⊆ integerPrefix 80 := by
    intro x hx
    obtain ⟨hpos, hle⟩ := mem_Icc.mp (mem_sdiff.mp hx).1
    exact mem_Icc.mpr ⟨hpos, hle.trans hk⟩
  have hc : integerPrefixCovers C (integerPrefixEdges integral k) := by
    intro e he
    by_contra! hno
    have hevals := mem_integerPrefixEdges.mp he
    have hmem (x : ℕ) (hx : x ∈ e.vertices) : x ∈ A := by
      by_contra hxa
      exact hno x hx (mem_sdiff.mpr ⟨integerPrefixEdge_vertices_mem he x hx, hxa⟩)
    have hfa := hmem e.first (by simp [IntegerPrefixTriple.vertices])
    have hfb := hmem e.middle (by simp [IntegerPrefixTriple.vertices])
    have hfc := hmem e.last (by simp [IntegerPrefixTriple.vertices])
    exact hAd hfa hfb hfc hevals.2.1 hevals.2.2.1 hevals.2.2.2.2.1 hevals.2.2.2.2.2
  have hbound := requiredCoverSize_le hcSub hc (cardinalityCertificates_checked integral)
  have cardC : C.card = k-A.card := by
    dsimp [C]
    rw [Finset.card_sdiff_of_subset hAs, integerPrefix, Nat.card_Icc]
    omega
  rw [cardC] at hbound
  have hcardA := card_le_card hAs
  rw [integerPrefix, Nat.card_Icc] at hcardA
  simp only [sum_const, smul_eq_mul, mul_one, integerPrefixCertifiedCountEighty]
  omega

private theorem sum_certifiedCount_value (integral : Bool) :
    (∑ k ∈ integerPrefix 80, (integerPrefixCertifiedCountEighty integral k : ℚ) / (k*(k+1))) -
      integerPrefixReciprocalMax integral 80 =
      if integral then (16567:ℚ)/132300 else (1553:ℚ)/45360 := by
  rw [integerPrefixReciprocalMax_eighty, sum_integerPrefix, ← List.toFinset_range,
    List.sum_toFinset _ List.nodup_range]
  cases integral <;> decide +kernel

private theorem cardinality_terms_le (integral : Bool) {k : ℕ} (hk : k ∈ integerPrefix 80) :
    (integerPrefixCardMax integral k : ℚ) / (k*(k+1)) ≤
      (integerPrefixCertifiedCountEighty integral k : ℚ) / (k*(k+1)) := by
  apply div_le_div_of_nonneg_right (by
    exact_mod_cast integerPrefixCardMax_eighty_le integral (mem_Icc.mp hk).2) (by positivity)

/-- The exact finite loss in both of the article's ratio conventions. -/
theorem integerPrefixLoss_eighty (integral : Bool) :
    integerPrefixLoss integral 80 =
      if integral then (16567:ℚ)/132300 else (1553:ℚ)/45360 := by
  apply le_antisymm _ (integerPrefixLoss_eighty_lower integral)
  rw [← sum_certifiedCount_value integral]
  exact sub_le_sub_right (Finset.sum_le_sum (fun _ hk ↦ cardinality_terms_le integral hk)) _

/-- Every separately optimized prefix cardinality up to 80 agrees with
the certified table of counts. -/
theorem integerPrefixCardMax_eighty (integral : Bool) {k : ℕ}
    (hk : k ∈ integerPrefix 80) :
    integerPrefixCardMax integral k = integerPrefixCertifiedCountEighty integral k := by
  have hs :
      (∑ j ∈ integerPrefix 80, (integerPrefixCardMax integral j : ℚ) / (j*(j+1))) =
        ∑ j ∈ integerPrefix 80, (integerPrefixCertifiedCountEighty integral j : ℚ) / (j*(j+1)) := by
    have he := (integerPrefixLoss_eighty integral).trans (sum_certifiedCount_value integral).symm
    unfold integerPrefixLoss at he
    linarith
  have hterm := (Finset.sum_eq_sum_iff_of_le (fun _ hj ↦ cardinality_terms_le integral hj)).mp hs k hk
  have hk₀ : (k : ℚ) ≠ 0 := by exact_mod_cast (show k ≠ 0 by have := (mem_Icc.mp hk).1; omega)
  have hk₁ : (k : ℚ)+1 ≠ 0 := by positivity
  exact_mod_cast (div_left_inj' (mul_ne_zero hk₀ hk₁)).mp hterm

end GRHArticle.ProgressionFree
