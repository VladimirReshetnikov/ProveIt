import GRHArticle.ProgressionFree.IntegerPrefixEighty

/-!
# Exact cardinality maxima for the 80-term prefixes

A leaf carries an integer-scaled fractional packing of forbidden triples. A
cover has to meet every triple in the packing, and each vertex can cover at
most the packing scale. Branches distinguish the three possible vertices
of a selected forbidden triple. All certificates are checked in Lean.
-/

namespace GRHArticle.ProgressionFree

open Finset
open scoped BigOperators

private def checkEdge (integral : Bool) (N : ℕ) (removed : List ℕ)
    (e : IntegerPrefixTriple) : Bool :=
  decide (1 ≤ e.first ∧ e.first < e.middle ∧ e.middle < e.last ∧ e.last ≤ N ∧
    e.first * e.last = e.middle * e.middle ∧ (integral = true → e.first ∣ e.middle)) &&
    !e.vertices.any removed.contains

private theorem checkEdge_sound {integral : Bool} {N : ℕ} {removed : List ℕ}
    {e : IntegerPrefixTriple} (h : checkEdge integral N removed e = true) :
    e ∈ integerPrefixEdges integral N ∧ ∀ x ∈ e.vertices, x ∉ removed := by
  simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
  refine ⟨mem_integerPrefixEdges.mpr h.1, ?_⟩
  intro x hx hxR
  have htrue := List.any_eq_true.mpr ⟨x, hx, List.contains_iff_mem.mpr hxR⟩
  simpa [htrue] using h.2

private abbrev EdgePacking := List (IntegerPrefixTriple × ℕ)

private def incidentCost (pack : EdgePacking) (x : ℕ) : ℕ :=
  ((pack.filter fun item ↦ item.1.vertices.contains x).map Prod.snd).sum

private theorem incidentCost_cons (edgeWeight : IntegerPrefixTriple × ℕ)
    (pack : EdgePacking) (x : ℕ) :
    incidentCost (edgeWeight::pack) x =
      (if x ∈ edgeWeight.1.vertices then edgeWeight.2 else 0) + incidentCost pack x := by
  by_cases hx : x ∈ edgeWeight.1.vertices <;> simp [incidentCost, hx]

private theorem packedWeight_le_sum_incident (C : Finset ℕ) (pack : EdgePacking)
    (h : ∀ item ∈ pack, ∃ x ∈ item.1.vertices, x ∈ C) :
    (pack.map Prod.snd).sum ≤ ∑ x ∈ C, incidentCost pack x := by
  induction pack with
  | nil => exact Nat.zero_le _
  | cons item pack ih =>
    obtain ⟨x, hx, hxC⟩ := h item List.mem_cons_self
    have hfirst : item.2 ≤ ∑ y ∈ C, if y ∈ item.1.vertices then item.2 else 0 := by
      have hl := single_le_sum
        (f := fun y ↦ if y ∈ item.1.vertices then item.2 else 0)
        (fun _ _ ↦ Nat.zero_le _) hxC
      simpa only [if_pos hx] using hl
    have hrest := ih (fun e he ↦ h e (List.mem_cons_of_mem _ he))
    simpa only [List.map_cons, List.sum_cons, incidentCost_cons, sum_add_distrib] using
      Nat.add_le_add hfirst hrest

private def RemainingCovered (C : Finset ℕ) (integral : Bool) (N : ℕ)
    (removed : List ℕ) : Prop :=
  ∀ e ∈ integerPrefixEdges integral N, (∀ x ∈ e.vertices, x ∉ removed) →
    ∃ x ∈ e.vertices, x ∈ C

private theorem remainingCovered_erase {C : Finset ℕ} {integral : Bool} {N x : ℕ}
    {removed : List ℕ} (h : RemainingCovered C integral N removed) :
    RemainingCovered (C.erase x) integral N (x::removed) := by
  intro e he hdis
  obtain ⟨y, hy, hyC⟩ := h e he (fun z hz hzR ↦ hdis z hz (List.mem_cons_of_mem _ hzR))
  refine ⟨y, hy, mem_erase.mpr ⟨?_, hyC⟩⟩
  exact fun heq ↦ hdis y hy (heq ▸ List.mem_cons_self)

private inductive CardinalityCertificate where
  | packing (scale : ℕ) (weights : EdgePacking)
  | branch (e : IntegerPrefixTriple) (first middle last : CardinalityCertificate)

private def checkCardinality (integral : Bool) (N : ℕ) :
    List ℕ → ℕ → CardinalityCertificate → Bool
  | removed, b, .packing scale pack =>
      pack.all (fun item ↦ checkEdge integral N removed item.1) &&
      (List.range 81).all (fun x ↦ decide (incidentCost pack x ≤ scale)) &&
      decide (b*scale < (pack.map Prod.snd).sum)
  | removed, b, .branch e first middle last =>
      checkEdge integral N removed e &&
      checkCardinality integral N (e.first::removed) (b-1) first &&
      checkCardinality integral N (e.middle::removed) (b-1) middle &&
      checkCardinality integral N (e.last::removed) (b-1) last

private theorem checkCardinality_sound {integral : Bool} {N b : ℕ} {removed : List ℕ}
    {cert : CardinalityCertificate} {C : Finset ℕ} (hC : C ⊆ integerPrefix 80)
    (h : checkCardinality integral N removed b cert = true)
    (hcov : RemainingCovered C integral N removed) :
    b < C.card := by
  induction cert generalizing b removed C with
  | packing scale pack =>
    simp only [checkCardinality, Bool.and_eq_true, decide_eq_true_eq, and_assoc] at h
    obtain ⟨hedges, hcaps, hwt⟩ := h
    have hpack := packedWeight_le_sum_incident C pack (fun item hitem ↦ by
      have he := checkEdge_sound (List.all_eq_true.mp hedges item hitem)
      exact hcov _ he.1 he.2)
    have hsum : (∑ x ∈ C, incidentCost pack x) ≤ C.card * scale := by
      calc
        _ ≤ ∑ _ ∈ C, scale := by
          apply sum_le_sum
          intro x hx
          have hr : x ∈ List.range 81 := List.mem_range.mpr (by
            have hx₀ := (mem_Icc.mp (hC hx)).2
            omega)
          exact of_decide_eq_true (List.all_eq_true.mp hcaps x hr)
        _ = _ := by simp
    by_contra! hbad
    exact (hwt.trans_le (hpack.trans hsum)).not_ge (Nat.mul_le_mul_right _ hbad)
  | branch e first middle last ihFirst ihMiddle ihLast =>
    simp only [checkCardinality, Bool.and_eq_true, and_assoc] at h
    obtain ⟨hedge, ha, hb, hc⟩ := h
    have he := checkEdge_sound hedge
    obtain ⟨x, hx, hxC⟩ := hcov e he.1 he.2
    have hsub : C.erase x ⊆ integerPrefix 80 := (erase_subset _ _).trans hC
    have hnew := remainingCovered_erase (x := x) hcov
    have hcard := Finset.card_erase_add_one hxC
    have hx₀ : 0 < C.card := card_pos.mpr ⟨x,hxC⟩
    simp only [IntegerPrefixTriple.vertices, List.mem_cons, List.not_mem_nil, or_false] at hx
    have hsmall : b-1 < (C.erase x).card := by
      rcases hx with he | he | he
      · exact ihFirst hsub (he ▸ ha) hnew
      · exact ihMiddle hsub (he ▸ hb) hnew
      · exact ihLast hsub (he ▸ hc) hnew
    omega

private def verifyStages (integral : Bool) :
    ℕ → List (ℕ × CardinalityCertificate) → Bool
  | _, [] => true
  | b, (n, c)::stages => checkCardinality integral n [] b c &&
      verifyStages integral (b+1) stages

private def requiredCoverSize (k : ℕ) :
    ℕ → List (ℕ × CardinalityCertificate) → ℕ
  | _, [] => 0
  | b, (n, _)::stages => max (if n ≤ k then b+1 else 0) (requiredCoverSize k (b+1) stages)

private theorem requiredCoverSize_le {integral : Bool} {k b : ℕ}
    {stages : List (ℕ × CardinalityCertificate)} {C : Finset ℕ}
    (hC : C ⊆ integerPrefix 80) (hc : integerPrefixCovers C (integerPrefixEdges integral k))
    (h : verifyStages integral b stages = true) :
    requiredCoverSize k b stages ≤ C.card := by
  induction stages generalizing b with
  | nil => exact Nat.zero_le _
  | cons stage stages ih =>
    rcases stage with ⟨n, cert⟩
    simp only [verifyStages, Bool.and_eq_true] at h
    apply max_le _ (ih h.2)
    split
    · next hnk =>
      refine checkCardinality_sound hC h.1 ?_
      intro e he _
      obtain ⟨h₁,h₂,h₃,h₄,h₅,h₆⟩ := mem_integerPrefixEdges.mp he
      exact hc e (mem_integerPrefixEdges.mpr ⟨h₁,h₂,h₃,h₄.trans hnk,h₅,h₆⟩)
    · exact Nat.zero_le _

