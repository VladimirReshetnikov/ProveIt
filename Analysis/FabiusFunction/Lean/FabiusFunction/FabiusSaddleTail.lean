import FabiusFunction.NegativeLaplaceVertical
import Mathlib.Analysis.Complex.ExponentialBounds
import Mathlib.Analysis.SpecialFunctions.ImproperIntegrals

/-!
# Complementary tails for the scaled Fabius saddle kernel

Extracting `N = 2m` dyadic factors from the negative Laplace product gives
the pointwise normalized-kernel bound

`‖K(x,r,b,v)‖ ≤ C(r,2m) / (1 + v²/b)^m`.

This module integrates that polynomial kernel by splitting its tail into an
intermediate Gaussian-type region and a far geometric region.  For a general
central radius `A > 0` the resulting explicit bound is

`C(r,2m) * (2 exp (-(mA/(2b))A)/(mA/(2b)) + 2⁻⁽ᵐ⁻¹⁾ √b π)`.

At the standardized radius `A(b) = √(32 log b)`, the hypotheses `2m ≥ b/2`
and `C(r,2m) = O(1)` imply that the complementary tail is `O(1/b)`.
Before imposing boundedness of the minor-arc constant, the factorized form is
`O(C(r,2m)/b)` under only the eventual pointwise saddle hypotheses.
-/

set_option autoImplicit false

open Filter Set MeasureTheory Asymptotics
open scoped Topology

namespace Fabius

/-- The scaled polynomial kernel generated by extracting `2m` dyadic
Laplace factors. -/
noncomputable def scaledPolynomialKernel (b : ℝ) (m : ℕ) (v : ℝ) : ℝ :=
  ((1 + v ^ 2 / b) ^ m)⁻¹

/-- For `b > 0`, the scaled polynomial kernel is nonnegative at every order
`m` and every real argument `v`. -/
lemma scaledPolynomialKernel_nonneg (b : ℝ) (m : ℕ) (v : ℝ) (hb : 0 < b) :
    0 ≤ scaledPolynomialKernel b m v := by
  exact inv_nonneg.mpr (pow_nonneg (by positivity) m)

/-- The scaled polynomial kernel is even in its real argument:
`scaledPolynomialKernel b m (-v) = scaledPolynomialKernel b m v`. -/
lemma scaledPolynomialKernel_neg (b : ℝ) (m : ℕ) (v : ℝ) :
    scaledPolynomialKernel b m (-v) = scaledPolynomialKernel b m v := by
  simp [scaledPolynomialKernel]

/-- For `b > 0` and `1 ≤ m`, the function
`v ↦ (1 + v²/b)⁻ᵐ` is integrable on the real line. -/
lemma integrable_scaledPolynomialKernel
    (b : ℝ) (m : ℕ) (hb : 0 < b) (hm : 1 ≤ m) :
    Integrable (scaledPolynomialKernel b m) := by
  have hsqrt : Real.sqrt b ≠ 0 := (Real.sqrt_pos.2 hb).ne'
  have hscale : (1 / Real.sqrt b) ≠ 0 := one_div_ne_zero hsqrt
  have hbaseScaled : Integrable
      (fun v : ℝ => (1 + ((1 / Real.sqrt b) * v) ^ 2)⁻¹) := by
    exact (integrable_comp_mul_left_iff
      (fun u : ℝ => (1 + u ^ 2)⁻¹) hscale).2 integrable_inv_one_add_sq
  have hbase : Integrable (fun v : ℝ => (1 + v ^ 2 / b)⁻¹) := by
    convert hbaseScaled using 1
    funext v
    congr 2
    rw [mul_pow, one_div, inv_pow, Real.sq_sqrt hb.le]
    field_simp [hsqrt]
  apply hbase.mono'
  · unfold scaledPolynomialKernel
    fun_prop
  · filter_upwards with v
    unfold scaledPolynomialKernel
    have hvb : 0 ≤ v ^ 2 / b := div_nonneg (sq_nonneg v) hb.le
    have hy : 1 ≤ 1 + v ^ 2 / b := by linarith
    have hpow : 1 + v ^ 2 / b ≤ (1 + v ^ 2 / b) ^ m := by
      simpa only [pow_one] using pow_le_pow_right₀ hy hm
    rw [Real.norm_eq_abs,
      abs_of_nonneg (inv_nonneg.mpr (pow_nonneg (zero_le_one.trans hy) m))]
    exact (inv_le_inv₀ (pow_pos (by positivity) m) (by positivity)).2 hpow

/-- If `A ≥ 0` and `f` is an integrable even real function, then its integral
outside `[-A, A]` is twice its integral over `(A, ∞)`. -/
lemma integral_compl_Icc_eq_two_mul_integral_Ioi_of_even
    (f : ℝ → ℝ) (A : ℝ) (hA : 0 ≤ A) (hf : Integrable f)
    (heven : ∀ v : ℝ, f (-v) = f v) :
    (∫ v in (Icc (-A) A)ᶜ, f v) = 2 * ∫ v in Ioi A, f v := by
  have hsets : (Icc (-A) A)ᶜ = Iio (-A) ∪ Ioi A := by
    ext v
    simp only [mem_compl_iff, mem_Icc, not_and_or, not_le, mem_union,
      mem_Iio, mem_Ioi]
  rw [hsets]
  have hdisj : Disjoint (Iio (-A)) (Ioi A) := by
    rw [Set.disjoint_left]
    intro v hvleft hvright
    have hvleft' : v < -A := hvleft
    have hvright' : A < v := hvright
    linarith
  rw [setIntegral_union hdisj measurableSet_Ioi hf.integrableOn hf.integrableOn]
  have hleft : (∫ v in Iio (-A), f v) = ∫ v in Ioi A, f v := by
    calc
      (∫ v in Iio (-A), f v) = ∫ v in Iic (-A), f v :=
        setIntegral_congr_set Iio_ae_eq_Iic
      _ = ∫ v in Ioi A, f (-v) := (integral_comp_neg_Ioi A f).symm
      _ = ∫ v in Ioi A, f v := by
        exact setIntegral_congr_fun measurableSet_Ioi fun v _hv => heven v
  rw [hleft]
  ring

/-- For `lam > 0`, the two-sided exponential
`v ↦ exp (-lam * |v|)` is integrable on the real line. -/
lemma integrable_exp_neg_mul_abs (lam : ℝ) (hlam : 0 < lam) :
    Integrable (fun v : ℝ => Real.exp (-lam * |v|)) := by
  have hneg : IntegrableOn (fun v : ℝ => Real.exp (-lam * |v|)) (Iic 0) := by
    refine (integrableOn_exp_mul_Iic hlam 0).congr_fun ?_ measurableSet_Iic
    intro v hv
    change Real.exp (lam * v) = Real.exp (-lam * |v|)
    have hv0 : v ≤ 0 := hv
    rw [abs_of_nonpos hv0]
    congr 1
    ring
  have hpos : IntegrableOn (fun v : ℝ => Real.exp (-lam * |v|)) (Ioi 0) := by
    refine (integrableOn_exp_mul_Ioi (by linarith : -lam < 0) 0).congr_fun
      ?_ measurableSet_Ioi
    intro v hv
    change Real.exp (-lam * v) = Real.exp (-lam * |v|)
    have hvpos : 0 < v := hv
    rw [abs_of_pos hvpos]
  have hunion := hneg.union hpos
  simpa only [Iic_union_Ioi, integrableOn_univ] using hunion

/-- For `lam > 0` and `A ≥ 0`, the complementary two-sided exponential tail
has the exact value
`∫ v in (Icc (-A) A)ᶜ, exp (-lam * |v|) = 2 * exp (-lam * A) / lam`. -/
lemma integral_exp_neg_mul_abs_compl_Icc
    (lam A : ℝ) (hlam : 0 < lam) (hA : 0 ≤ A) :
    (∫ v in (Icc (-A) A)ᶜ, Real.exp (-lam * |v|)) =
      2 * Real.exp (-lam * A) / lam := by
  rw [integral_compl_Icc_eq_two_mul_integral_Ioi_of_even
    (fun v : ℝ => Real.exp (-lam * |v|)) A hA
    (integrable_exp_neg_mul_abs lam hlam)]
  · have hpos : (∫ v in Ioi A, Real.exp (-lam * |v|)) =
        ∫ v in Ioi A, Real.exp (-lam * v) := by
      apply setIntegral_congr_fun measurableSet_Ioi
      intro v hv
      change Real.exp (-lam * |v|) = Real.exp (-lam * v)
      have hvpos : 0 < v := hA.trans_lt hv
      rw [abs_of_pos hvpos]
    rw [hpos, integral_exp_mul_Ioi (by linarith : -lam < 0) A]
    field_simp [hlam.ne']
  · intro v
    rw [abs_neg]

/-- For `b > 0`, the scaled Cauchy kernel has exact total mass
`∫ v : ℝ, (1 + v²/b)⁻¹ = √b * π`. -/
lemma integral_scaled_inv_one_add_sq (b : ℝ) (hb : 0 < b) :
    (∫ v : ℝ, (1 + v ^ 2 / b)⁻¹) = Real.sqrt b * Real.pi := by
  have hsqrt : Real.sqrt b ≠ 0 := (Real.sqrt_pos.2 hb).ne'
  have hscale := Measure.integral_comp_mul_left
    (fun u : ℝ => (1 + u ^ 2)⁻¹) (1 / Real.sqrt b)
  have hfun : (fun v : ℝ => (1 + ((1 / Real.sqrt b) * v) ^ 2)⁻¹) =
      fun v : ℝ => (1 + v ^ 2 / b)⁻¹ := by
    funext v
    congr 2
    rw [mul_pow, one_div, inv_pow, Real.sq_sqrt hb.le]
    field_simp [hsqrt]
  rw [hfun, integral_univ_inv_one_add_sq] at hscale
  simpa [abs_of_pos (Real.sqrt_pos.2 hb), hsqrt] using hscale

/-- On `0 ≤ y ≤ 1`, the logarithm admits the elementary lower bound
`y / 2 ≤ log (1 + y)`. -/
lemma half_mul_le_log_one_add {y : ℝ} (hy0 : 0 ≤ y) (hy1 : y ≤ 1) :
    y / 2 ≤ Real.log (1 + y) := by
  calc
    y / 2 ≤ 2 * y / (y + 2) := by
      rw [le_div_iff₀ (by linarith : 0 < y + 2)]
      nlinarith [sq_nonneg y]
    _ ≤ Real.log (1 + y) := Real.le_log_one_add_of_nonneg hy0

/-- In the intermediate region `A ≤ |v| ≤ √b`, for `b > 0` and `1 ≤ m`,
the polynomial kernel is bounded by
`exp (-((m : ℝ) * A / (2 * b)) * |v|)`. -/
lemma scaledPolynomialKernel_le_exp_on_intermediate
    (b A : ℝ) (m : ℕ) (v : ℝ)
    (hb : 0 < b) (hm : 1 ≤ m)
    (hvA : A ≤ |v|) (hvupper : |v| ≤ Real.sqrt b) :
    scaledPolynomialKernel b m v ≤
      Real.exp (-((m : ℝ) * A / (2 * b)) * |v|) := by
  let y : ℝ := v ^ 2 / b
  have hy0 : 0 ≤ y := by
    dsimp [y]
    exact div_nonneg (sq_nonneg v) hb.le
  have hy1 : y ≤ 1 := by
    have hv_sq : v ^ 2 ≤ b := by
      rw [← sq_abs v, ← Real.sq_sqrt hb.le]
      exact sq_le_sq₀ (abs_nonneg v) (Real.sqrt_nonneg b) |>.2 hvupper
    dsimp [y]
    exact (div_le_one hb).2 hv_sq
  have hlog : y / 2 ≤ Real.log (1 + y) := half_mul_le_log_one_add hy0 hy1
  have hbase : 0 < 1 + y := by linarith
  have hrepr : scaledPolynomialKernel b m v =
      Real.exp (-((m : ℝ) * Real.log (1 + y))) := by
    unfold scaledPolynomialKernel
    dsimp [y]
    rw [show -((m : ℝ) * Real.log (1 + v ^ 2 / b)) =
        -((m : ℝ) * Real.log (1 + v ^ 2 / b)) by rfl,
      Real.exp_neg, Real.exp_nat_mul, Real.exp_log hbase]
  rw [hrepr]
  apply Real.exp_le_exp.mpr
  have hm0 : (0 : ℝ) ≤ m := by positivity
  have hfirst : -((m : ℝ) * Real.log (1 + y)) ≤ -((m : ℝ) * (y / 2)) := by
    exact neg_le_neg (mul_le_mul_of_nonneg_left hlog hm0)
  have habs_sq : A * |v| ≤ v ^ 2 := by
    rw [← sq_abs v]
    simpa only [pow_two] using
      mul_le_mul_of_nonneg_right hvA (abs_nonneg v)
  have hsecond : -((m : ℝ) * (y / 2)) ≤
      -((m : ℝ) * A / (2 * b)) * |v| := by
    dsimp [y]
    have hb0 : 0 ≤ (b : ℝ) := hb.le
    have hmR0 : 0 ≤ (m : ℝ) := by positivity
    rw [show -((m : ℝ) * A / (2 * b)) * |v| =
      -(((m : ℝ) * A / (2 * b)) * |v|) by ring]
    apply neg_le_neg
    calc
      (m : ℝ) * (v ^ 2 / b / 2) =
          ((m : ℝ) / (2 * b)) * v ^ 2 := by ring
      _ ≥ ((m : ℝ) / (2 * b)) * (A * |v|) := by
        exact mul_le_mul_of_nonneg_left habs_sq (by positivity)
      _ = (m : ℝ) * A / (2 * b) * |v| := by ring
  exact hfirst.trans hsecond

/-- In the far region `√b ≤ |v|`, for `b > 0` and `1 ≤ m`, extracting
`m - 1` powers of two bounds the kernel by
`((2 : ℝ) ^ (m - 1))⁻¹ * (1 + v²/b)⁻¹`. -/
lemma scaledPolynomialKernel_le_geometric_mul_base
    (b : ℝ) (m : ℕ) (v : ℝ)
    (hb : 0 < b) (hm : 1 ≤ m) (hv : Real.sqrt b ≤ |v|) :
    scaledPolynomialKernel b m v ≤
      ((2 : ℝ) ^ (m - 1))⁻¹ * (1 + v ^ 2 / b)⁻¹ := by
  let base : ℝ := 1 + v ^ 2 / b
  have hv_sq : b ≤ v ^ 2 := by
    rw [← Real.sq_sqrt hb.le, ← sq_abs v]
    exact sq_le_sq₀ (Real.sqrt_nonneg b) (abs_nonneg v) |>.2 hv
  have hratio : 1 ≤ v ^ 2 / b := (le_div_iff₀ hb).2 (by simpa using hv_sq)
  have hbase : 2 ≤ base := by
    dsimp [base]
    linarith
  have hbasepos : 0 < base := zero_lt_two.trans_le hbase
  have hgeom : (2 : ℝ) ^ (m - 1) ≤ base ^ (m - 1) := by
    exact pow_le_pow_left₀ (by norm_num) hbase (m - 1)
  have hmdecomp : m - 1 + 1 = m := Nat.sub_add_cancel hm
  have hden : (2 : ℝ) ^ (m - 1) * base ≤ base ^ m := by
    calc
      (2 : ℝ) ^ (m - 1) * base ≤ base ^ (m - 1) * base :=
        mul_le_mul_of_nonneg_right hgeom hbasepos.le
      _ = base ^ m := by rw [← pow_succ, hmdecomp]
  unfold scaledPolynomialKernel
  change (base ^ m)⁻¹ ≤ ((2 : ℝ) ^ (m - 1))⁻¹ * base⁻¹
  calc
    (base ^ m)⁻¹ ≤ ((2 : ℝ) ^ (m - 1) * base)⁻¹ :=
      (inv_le_inv₀ (pow_pos hbasepos m)
        (mul_pos (pow_pos (by norm_num) _) hbasepos)).2 hden
    _ = ((2 : ℝ) ^ (m - 1))⁻¹ * base⁻¹ := by rw [mul_inv]

/-- A reusable two-region tail estimate for the scaled polynomial kernel.
The first term is the intermediate Gaussian-type tail and the second is the
far-tail geometric loss from the extracted factors. -/
theorem integral_scaledPolynomialKernel_compl_Icc_le
    (b A : ℝ) (m : ℕ) (hb : 0 < b) (hA : 0 < A) (hm : 1 ≤ m) :
    (∫ v in (Icc (-A) A)ᶜ, scaledPolynomialKernel b m v) ≤
      2 * Real.exp (-((m : ℝ) * A / (2 * b)) * A) /
          ((m : ℝ) * A / (2 * b)) +
        ((2 : ℝ) ^ (m - 1))⁻¹ * (Real.sqrt b * Real.pi) := by
  let lam : ℝ := (m : ℝ) * A / (2 * b)
  let geometric : ℝ := ((2 : ℝ) ^ (m - 1))⁻¹
  let baseKernel : ℝ → ℝ := fun v => (1 + v ^ 2 / b)⁻¹
  have hlam : 0 < lam := by
    dsimp [lam]
    positivity
  have hpoly := integrable_scaledPolynomialKernel b m hb hm
  have hexp := integrable_exp_neg_mul_abs lam hlam
  have hbase : Integrable baseKernel := by
    have hscaled : Integrable (fun v : ℝ => (1 + v ^ 2 / b)⁻¹) := by
      have hsqrt : Real.sqrt b ≠ 0 := (Real.sqrt_pos.2 hb).ne'
      have hscale : (1 / Real.sqrt b) ≠ 0 := one_div_ne_zero hsqrt
      have hi := (integrable_comp_mul_left_iff
        (fun u : ℝ => (1 + u ^ 2)⁻¹) hscale).2 integrable_inv_one_add_sq
      convert hi using 1
      funext v
      congr 2
      rw [mul_pow, one_div, inv_pow, Real.sq_sqrt hb.le]
      field_simp [hsqrt]
    simpa only [baseKernel] using hscaled
  have hgeom0 : 0 ≤ geometric := by
    dsimp [geometric]
    positivity
  have hmajor : Integrable
      (fun v => Real.exp (-lam * |v|) + geometric * baseKernel v) :=
    hexp.add (hbase.const_mul geometric)
  have hpoint : ∀ v ∈ (Icc (-A) A)ᶜ,
      scaledPolynomialKernel b m v ≤
        Real.exp (-lam * |v|) + geometric * baseKernel v := by
    intro v hv
    have hvA : A ≤ |v| := by
      have hnot : ¬ |v| ≤ A := by
        intro habs
        apply hv
        exact (abs_le.mp habs)
      exact (lt_of_not_ge hnot).le
    by_cases hvupper : |v| ≤ Real.sqrt b
    · have hmiddle := scaledPolynomialKernel_le_exp_on_intermediate
        b A m v hb hm hvA hvupper
      exact hmiddle.trans (le_add_of_nonneg_right
        (mul_nonneg hgeom0 (by dsimp [baseKernel]; positivity)))
    · have hfar := scaledPolynomialKernel_le_geometric_mul_base
        b m v hb hm (le_of_not_ge hvupper)
      dsimp [geometric, baseKernel] at hfar ⊢
      exact hfar.trans (le_add_of_nonneg_left (Real.exp_nonneg _))
  have hmono :
      (∫ v in (Icc (-A) A)ᶜ, scaledPolynomialKernel b m v) ≤
        ∫ v in (Icc (-A) A)ᶜ,
          (Real.exp (-lam * |v|) + geometric * baseKernel v) := by
    exact setIntegral_mono_on hpoly.integrableOn hmajor.integrableOn
      measurableSet_Icc.compl hpoint
  calc
    (∫ v in (Icc (-A) A)ᶜ, scaledPolynomialKernel b m v) ≤
        ∫ v in (Icc (-A) A)ᶜ,
          (Real.exp (-lam * |v|) + geometric * baseKernel v) := hmono
    _ = (∫ v in (Icc (-A) A)ᶜ, Real.exp (-lam * |v|)) +
          ∫ v in (Icc (-A) A)ᶜ, geometric * baseKernel v := by
      rw [integral_add hexp.integrableOn (hbase.const_mul geometric).integrableOn]
    _ ≤ (∫ v in (Icc (-A) A)ᶜ, Real.exp (-lam * |v|)) +
          ∫ v : ℝ, geometric * baseKernel v := by
      have hbase0 : ∀ v : ℝ, 0 ≤ baseKernel v := by
        intro v
        dsimp [baseKernel]
        positivity
      apply add_le_add_right
      have hset := setIntegral_mono_set
        (s := (Icc (-A) A)ᶜ) (t := (Set.univ : Set ℝ))
        (hbase.const_mul geometric).integrableOn
        (Filter.Eventually.of_forall fun v => mul_nonneg hgeom0 (hbase0 v))
        (Filter.Eventually.of_forall fun v _hv => mem_univ v)
      simpa only [setIntegral_univ] using hset
    _ = 2 * Real.exp (-lam * A) / lam +
          geometric * (Real.sqrt b * Real.pi) := by
      rw [integral_exp_neg_mul_abs_compl_Icc lam A hlam hA.le,
        integral_const_mul, show (∫ v : ℝ, baseKernel v) =
          Real.sqrt b * Real.pi by
            simpa only [baseKernel] using integral_scaled_inv_one_add_sq b hb]
    _ = 2 * Real.exp (-((m : ℝ) * A / (2 * b)) * A) /
          ((m : ℝ) * A / (2 * b)) +
        ((2 : ℝ) ^ (m - 1))⁻¹ * (Real.sqrt b * Real.pi) := by
      rfl

/-- Extracting `N = 2m` factors from the vertical negative-Laplace product
bounds the normalized scaled kernel by `C(r,2m) / (1 + v²/b)^m`. -/
lemma norm_fabius_scaledSaddleKernel_le
    (F : BoundedFabius) (hF : IsFabius F)
    (x r b v : ℝ) (hr : 0 < r) (hb : 0 < b) (m : ℕ) :
    ‖QuantitativeSaddle.scaledSaddleKernel
        (fun z => complexGeneratingFunction F (-z)) x r b v‖ ≤
      negativeLaplaceMinorArcConstant r (2 * m) /
        (1 + v ^ 2 / b) ^ m := by
  let θ : ℝ := v / Real.sqrt b
  let w : ℂ := 1 + (θ : ℂ) * Complex.I
  have hw : 0 < ‖w‖ := by
    dsimp [w]
    exact norm_one_add_mul_I_pos θ
  have hreal := generatingFunction_neg_pos F hF r hr
  have hP : ‖complexGeneratingFunction F (-(r : ℂ))‖ =
      generatingFunction F (-r) := by
    rw [show -(r : ℂ) = ((-r : ℝ) : ℂ) by push_cast; ring,
      complexGeneratingFunction_ofReal, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hreal]
  have hvertical := norm_complexGeneratingFunction_neg_vertical_div_le
    F hF r θ hr (2 * m)
  have hpoint :
      ‖QuantitativeSaddle.scaledSaddleKernel
          (fun z => complexGeneratingFunction F (-z)) x r b v‖ =
        (‖complexGeneratingFunction F (-((r : ℂ) * w))‖ /
            generatingFunction F (-r)) / ‖w‖ := by
    unfold QuantitativeSaddle.scaledSaddleKernel
    dsimp only
    rw [norm_div, norm_mul, Complex.norm_exp]
    norm_num
    rw [hP]
    have harg :
        -((r : ℂ) * (v : ℂ) / (Real.sqrt b : ℂ) * Complex.I) + -(r : ℂ) =
          -((r : ℂ) * w) := by
      dsimp [w, θ]
      push_cast
      ring
    rw [harg]
    have hden :
        ‖1 + (v : ℂ) / (Real.sqrt b : ℂ) * Complex.I‖ = ‖w‖ := by
      dsimp [w, θ]
      push_cast
      rfl
    rw [hden]
  rw [hpoint]
  have hdiv := div_le_div_of_nonneg_right hvertical hw.le
  calc
    (‖complexGeneratingFunction F (-((r : ℂ) * w))‖ /
          generatingFunction F (-r)) / ‖w‖ ≤
        (negativeLaplaceMinorArcConstant r (2 * m) * ‖w‖ /
          ‖w‖ ^ (2 * m)) / ‖w‖ := hdiv
    _ = negativeLaplaceMinorArcConstant r (2 * m) / ‖w‖ ^ (2 * m) := by
      field_simp [hw.ne']
    _ = negativeLaplaceMinorArcConstant r (2 * m) /
        (1 + v ^ 2 / b) ^ m := by
      have hsqrt : Real.sqrt b ≠ 0 := (Real.sqrt_pos.2 hb).ne'
      have hnormsq : ‖w‖ ^ 2 = 1 + v ^ 2 / b := by
        rw [show ‖w‖ ^ 2 = 1 + θ ^ 2 by
          dsimp [w]; exact sq_norm_one_add_mul_I θ]
        dsimp [θ]
        rw [div_pow, Real.sq_sqrt hb.le]
      rw [show ‖w‖ ^ (2 * m) = (‖w‖ ^ 2) ^ m by ring]
      rw [hnormsq]

/-- The scaled Fabius saddle kernel is integrable at every positive `r` and
positive scale `b`. -/
lemma integrable_fabius_scaledSaddleKernel
    (F : BoundedFabius) (hF : IsFabius F)
    (x r b : ℝ) (hr : 0 < r) (hb : 0 < b) :
    Integrable (QuantitativeSaddle.scaledSaddleKernel
      (fun z => complexGeneratingFunction F (-z)) x r b) := by
  let scale : ℝ := 1 / Real.sqrt b
  let phase : ℝ → ℂ := fun v =>
    Complex.exp (((r * x * v / Real.sqrt b : ℝ) : ℂ) * Complex.I)
  have hsqrt : Real.sqrt b ≠ 0 := (Real.sqrt_pos.2 hb).ne'
  have hscale : scale ≠ 0 := by
    dsimp [scale]
    exact one_div_ne_zero hsqrt
  have hvertical := integrable_negativeLaplaceVerticalKernel F hF r hr
  have hverticalScaled : Integrable
      (fun v : ℝ => negativeLaplaceVerticalKernel F r (scale * v)) :=
    (integrable_comp_mul_left_iff (negativeLaplaceVerticalKernel F r)
      hscale).2 hvertical
  have hphase : AEStronglyMeasurable phase := by
    apply Continuous.aestronglyMeasurable
    dsimp [phase]
    fun_prop
  have hphaseBound : ∀ᵐ v : ℝ, ‖phase v‖ ≤ 1 := by
    filter_upwards with v
    dsimp [phase]
    rw [Complex.norm_exp]
    norm_num
  have hprod : Integrable (fun v => phase v *
      negativeLaplaceVerticalKernel F r (scale * v)) := by
    simpa only [mul_comm] using
      hverticalScaled.mul_bdd hphase hphaseBound
  have hconst := hprod.const_mul
    (complexGeneratingFunction F (-(r : ℂ)))⁻¹
  apply hconst.congr
  filter_upwards with v
  unfold QuantitativeSaddle.scaledSaddleKernel negativeLaplaceVerticalKernel
  dsimp [phase, scale]
  have htheta :
      (((1 / Real.sqrt b) * v : ℝ) : ℂ) =
        ((v / Real.sqrt b : ℝ) : ℂ) := by
    push_cast
    ring
  rw [htheta]
  have harg :
      -((r : ℂ) * (1 + ((v / Real.sqrt b : ℝ) : ℂ) * Complex.I)) =
        -((r : ℂ) + ((r * v / Real.sqrt b : ℝ) : ℂ) * Complex.I) := by
    push_cast
    ring
  rw [harg]
  ring

/-- The vertical-product bound consumed by the reusable polynomial-kernel
tail estimate.  This is the complementary-tail inequality before any
asymptotic hypotheses on `b`, `m`, or the minor-arc constant are imposed. -/
theorem integral_norm_fabius_scaledSaddleKernel_compl_Icc_le
    (F : BoundedFabius) (hF : IsFabius F)
    (x r b A : ℝ) (m : ℕ)
    (hr : 0 < r) (hb : 0 < b) (hA : 0 < A) (hm : 1 ≤ m) :
    (∫ v in (Icc (-A) A)ᶜ,
      ‖QuantitativeSaddle.scaledSaddleKernel
        (fun z => complexGeneratingFunction F (-z)) x r b v‖) ≤
      negativeLaplaceMinorArcConstant r (2 * m) *
        (2 * Real.exp (-((m : ℝ) * A / (2 * b)) * A) /
            ((m : ℝ) * A / (2 * b)) +
          ((2 : ℝ) ^ (m - 1))⁻¹ * (Real.sqrt b * Real.pi)) := by
  let K : ℝ → ℂ := QuantitativeSaddle.scaledSaddleKernel
    (fun z => complexGeneratingFunction F (-z)) x r b
  let C : ℝ := negativeLaplaceMinorArcConstant r (2 * m)
  have hC : 0 ≤ C := (negativeLaplaceMinorArcConstant_pos r hr (2 * m)).le
  have hK : Integrable K := integrable_fabius_scaledSaddleKernel F hF x r b hr hb
  have hpoly := integrable_scaledPolynomialKernel b m hb hm
  have hmajor : Integrable (fun v => C * scaledPolynomialKernel b m v) :=
    hpoly.const_mul C
  have hpoint : ∀ v : ℝ, ‖K v‖ ≤ C * scaledPolynomialKernel b m v := by
    intro v
    have h := norm_fabius_scaledSaddleKernel_le F hF x r b v hr hb m
    simpa only [K, C, scaledPolynomialKernel, div_eq_mul_inv] using h
  have hmono :
      (∫ v in (Icc (-A) A)ᶜ, ‖K v‖) ≤
        ∫ v in (Icc (-A) A)ᶜ, C * scaledPolynomialKernel b m v := by
    exact setIntegral_mono_on hK.norm.integrableOn hmajor.integrableOn
      measurableSet_Icc.compl fun v _hv => hpoint v
  have htail := integral_scaledPolynomialKernel_compl_Icc_le b A m hb hA hm
  calc
    (∫ v in (Icc (-A) A)ᶜ,
        ‖QuantitativeSaddle.scaledSaddleKernel
          (fun z => complexGeneratingFunction F (-z)) x r b v‖) =
        ∫ v in (Icc (-A) A)ᶜ, ‖K v‖ := by rfl
    _ ≤ ∫ v in (Icc (-A) A)ᶜ,
        C * scaledPolynomialKernel b m v := hmono
    _ = C * ∫ v in (Icc (-A) A)ᶜ,
        scaledPolynomialKernel b m v := by rw [integral_const_mul]
    _ ≤ C * (2 * Real.exp (-((m : ℝ) * A / (2 * b)) * A) /
          ((m : ℝ) * A / (2 * b)) +
        ((2 : ℝ) ^ (m - 1))⁻¹ * (Real.sqrt b * Real.pi)) :=
      mul_le_mul_of_nonneg_left htail hC
    _ = negativeLaplaceMinorArcConstant r (2 * m) *
        (2 * Real.exp (-((m : ℝ) * A / (2 * b)) * A) /
            ((m : ℝ) * A / (2 * b)) +
          ((2 : ℝ) ^ (m - 1))⁻¹ * (Real.sqrt b * Real.pi)) := by rfl

/-- If `1 ≤ b`, `1 ≤ A`, `b / 4 ≤ m`, and `A² = 32 * log b`, then the
intermediate contribution satisfies
`2 * exp (-((m : ℝ) * A / (2 * b)) * A) / ((m : ℝ) * A / (2 * b)) ≤
  16 * b⁻¹`. -/
lemma standardized_intermediate_tail_le_inv
    (b A : ℝ) (m : ℕ) (hb : 1 ≤ b) (hA : 1 ≤ A)
    (hm : b / 4 ≤ (m : ℝ)) (hA_sq : A ^ 2 = 32 * Real.log b) :
    2 * Real.exp (-((m : ℝ) * A / (2 * b)) * A) /
        ((m : ℝ) * A / (2 * b)) ≤
      16 * b⁻¹ := by
  have hbpos : 0 < b := zero_lt_one.trans_le hb
  have hlog : 0 ≤ Real.log b := Real.log_nonneg hb
  have hmdiv : (1 / 4 : ℝ) ≤ (m : ℝ) / b := by
    rw [le_div_iff₀ hbpos]
    simpa [div_eq_mul_inv, mul_comm] using hm
  let lam : ℝ := (m : ℝ) * A / (2 * b)
  have hlam_lower : (1 / 8 : ℝ) ≤ lam := by
    dsimp [lam]
    calc
      (1 / 8 : ℝ) = (1 / 4 : ℝ) * 1 / 2 := by ring
      _ ≤ ((m : ℝ) / b) * A / 2 := by gcongr
      _ = (m : ℝ) * A / (2 * b) := by ring
  have hlam : 0 < lam := (by norm_num : (0 : ℝ) < 1 / 8).trans_le hlam_lower
  have hlamA : 4 * Real.log b ≤ lam * A := by
    dsimp [lam]
    calc
      4 * Real.log b = 16 * (1 / 4 : ℝ) * Real.log b := by ring
      _ ≤ 16 * ((m : ℝ) / b) * Real.log b := by gcongr
      _ = ((m : ℝ) * A / (2 * b)) * A := by
        have hlogeq : Real.log b = A ^ 2 / 32 := by nlinarith [hA_sq]
        rw [hlogeq]
        field_simp [hbpos.ne']
        ring
  have hexp : Real.exp (-(lam * A)) ≤ (b ^ 4)⁻¹ := by
    calc
      Real.exp (-(lam * A)) ≤ Real.exp (-(4 * Real.log b)) :=
        Real.exp_le_exp.mpr (neg_le_neg hlamA)
      _ = (b ^ 4)⁻¹ := by
        rw [Real.exp_neg]
        congr 1
        rw [show (4 : ℝ) * Real.log b = (4 : ℕ) * Real.log b by norm_num,
          Real.exp_nat_mul, Real.exp_log hbpos]
  have hcoeff : 2 / lam ≤ 16 := by
    rw [div_le_iff₀ hlam]
    nlinarith
  have hpow : b ≤ b ^ 4 := by
    simpa only [pow_one] using pow_le_pow_right₀ hb (by omega : 1 ≤ 4)
  have hinvpow : (b ^ 4)⁻¹ ≤ b⁻¹ :=
    (inv_le_inv₀ (pow_pos hbpos 4) hbpos).2 hpow
  calc
    2 * Real.exp (-((m : ℝ) * A / (2 * b)) * A) /
        ((m : ℝ) * A / (2 * b)) =
        (2 / lam) * Real.exp (-(lam * A)) := by
          dsimp [lam]
          ring_nf
    _ ≤ 16 * (b ^ 4)⁻¹ :=
      mul_le_mul hcoeff hexp (Real.exp_nonneg _) (by norm_num)
    _ ≤ 16 * b⁻¹ := mul_le_mul_of_nonneg_left hinvpow (by norm_num)

/-- If `4 ≤ b`, `b / 4 ≤ m`, and `(m : ℝ)² ≤ 2ᵐ`, then the far geometric
contribution satisfies
`((2 : ℝ) ^ (m - 1))⁻¹ * (√b * π) ≤ 32 * π * b⁻¹`. -/
lemma standardized_geometric_tail_le_inv
    (b : ℝ) (m : ℕ) (hb : 4 ≤ b) (hm : b / 4 ≤ (m : ℝ))
    (hpow : (m : ℝ) ^ 2 ≤ (2 : ℝ) ^ m) :
    ((2 : ℝ) ^ (m - 1))⁻¹ * (Real.sqrt b * Real.pi) ≤
      32 * Real.pi * b⁻¹ := by
  have hbpos : 0 < b := by linarith
  have hmR : 1 ≤ (m : ℝ) := by linarith
  have hmnat : 1 ≤ m := by exact_mod_cast hmR
  have hsqrt : Real.sqrt b ≤ b := by
    rw [Real.sqrt_le_iff]
    constructor
    · exact hbpos.le
    · nlinarith
  have hb_le : b ≤ 4 * (m : ℝ) := by linarith
  have hbsq : b ^ 2 ≤ 16 * (m : ℝ) ^ 2 := by nlinarith
  have hcore : b * Real.sqrt b ≤
      32 * (2 : ℝ) ^ (m - 1) := by
    calc
      b * Real.sqrt b ≤ b ^ 2 := by
        simpa only [pow_two] using mul_le_mul_of_nonneg_left hsqrt hbpos.le
      _ ≤ 16 * (m : ℝ) ^ 2 := hbsq
      _ ≤ 16 * (2 : ℝ) ^ m := mul_le_mul_of_nonneg_left hpow (by norm_num)
      _ = 32 * (2 : ℝ) ^ (m - 1) := by
        conv_lhs => rw [← Nat.sub_add_cancel hmnat, pow_add, pow_one]
        ring
  have hden : 0 < (2 : ℝ) ^ (m - 1) := pow_pos (by norm_num) _
  rw [show 32 * Real.pi * b⁻¹ = 32 * Real.pi / b by
    simp only [div_eq_mul_inv]]
  rw [le_div_iff₀ hbpos]
  calc
    ((2 : ℝ) ^ (m - 1))⁻¹ * (Real.sqrt b * Real.pi) * b =
        (b * Real.sqrt b / (2 : ℝ) ^ (m - 1)) * Real.pi := by ring
    _ ≤ 32 * Real.pi := by
      apply mul_le_mul_of_nonneg_right _ Real.pi_pos.le
      exact (div_le_iff₀ hden).2 (by simpa [mul_comm] using hcore)

/-- The standard central radius used by the Fabius saddle argument. -/
noncomputable def fabiusSaddleCentralRadius (b : ℝ) : ℝ :=
  Real.sqrt (32 * Real.log b)

/-- At the endpoint `b = 1`, the standard logarithmic central radius
collapses to zero. -/
lemma fabiusSaddleCentralRadius_one : fabiusSaddleCentralRadius 1 = 0 := by
  simp [fabiusSaddleCentralRadius]

/-- The standard central radius `√(32 * log b)` is strictly positive whenever
`1 < b`. -/
lemma fabiusSaddleCentralRadius_pos {b : ℝ} (hb : 1 < b) :
    0 < fabiusSaddleCentralRadius b := by
  unfold fabiusSaddleCentralRadius
  exact Real.sqrt_pos.2 (mul_pos (by norm_num) (Real.log_pos hb))

/-- For `1 ≤ b`, squaring the standard central radius recovers its defining
radicand: `fabiusSaddleCentralRadius b ^ 2 = 32 * log b`. -/
lemma sq_fabiusSaddleCentralRadius {b : ℝ} (hb : 1 ≤ b) :
    fabiusSaddleCentralRadius b ^ 2 = 32 * Real.log b := by
  unfold fabiusSaddleCentralRadius
  rw [Real.sq_sqrt]
  exact mul_nonneg (by norm_num) (Real.log_nonneg hb)

/-- If `exp 1 ≤ b`, then the standard central radius is at least one. -/
lemma one_le_fabiusSaddleCentralRadius
    {b : ℝ} (hb : Real.exp 1 ≤ b) :
    1 ≤ fabiusSaddleCentralRadius b := by
  have hbpos : 0 < b := (Real.exp_pos 1).trans_le hb
  have hlog : 1 ≤ Real.log b :=
    (Real.le_log_iff_exp_le hbpos).2 hb
  unfold fabiusSaddleCentralRadius
  apply (Real.le_sqrt (by norm_num) (by positivity)).2
  nlinarith

/-- `Real.exp 1 < 2.72 < 4`, so a lower bound `4 ≤ b` already supplies the
hypothesis `Real.exp 1 ≤ b` demanded by `one_le_fabiusSaddleCentralRadius`.
This is the bridge that lets the standardized-radius tail estimates below be
stated with a single explicit numeric lower bound on `b`. -/
lemma exp_one_le_of_four_le {b : ℝ} (hb4 : 4 ≤ b) : Real.exp 1 ≤ b := by
  have := Real.exp_one_lt_d9
  linarith

/-- If `exp 1 ≤ b`, `4 ≤ b`, `b / 4 ≤ m`, and `(m : ℝ)² ≤ 2ᵐ`, then the
scaled polynomial-kernel mass outside the standard radius is at most
`(16 + 32 * π) * b⁻¹`. -/
lemma integral_scaledPolynomialKernel_standardRadius_le
    (b : ℝ) (m : ℕ)
    (hbexp : Real.exp 1 ≤ b) (hb4 : 4 ≤ b)
    (hm : b / 4 ≤ (m : ℝ))
    (hpow : (m : ℝ) ^ 2 ≤ (2 : ℝ) ^ m) :
    (∫ v in (Icc (-fabiusSaddleCentralRadius b)
        (fabiusSaddleCentralRadius b))ᶜ,
      scaledPolynomialKernel b m v) ≤
      (16 + 32 * Real.pi) * b⁻¹ := by
  have hbpos : 0 < b := (Real.exp_pos 1).trans_le hbexp
  have hb1 : 1 ≤ b := (by linarith : (1 : ℝ) ≤ 4).trans hb4
  have hmR : 1 ≤ (m : ℝ) := by linarith
  have hmnat : 1 ≤ m := by exact_mod_cast hmR
  have hApos : 0 < fabiusSaddleCentralRadius b :=
    fabiusSaddleCentralRadius_pos
      (lt_of_lt_of_le (Real.one_lt_exp_iff.2 zero_lt_one) hbexp)
  have htail := integral_scaledPolynomialKernel_compl_Icc_le
    b (fabiusSaddleCentralRadius b) m hbpos hApos hmnat
  have hmiddle := standardized_intermediate_tail_le_inv
    b (fabiusSaddleCentralRadius b) m hb1
      (one_le_fabiusSaddleCentralRadius hbexp) hm
      (sq_fabiusSaddleCentralRadius hb1)
  have hfar := standardized_geometric_tail_le_inv b m hb4 hm hpow
  calc
    (∫ v in (Icc (-fabiusSaddleCentralRadius b)
        (fabiusSaddleCentralRadius b))ᶜ,
      scaledPolynomialKernel b m v) ≤
        2 * Real.exp (-((m : ℝ) * fabiusSaddleCentralRadius b /
            (2 * b)) * fabiusSaddleCentralRadius b) /
          ((m : ℝ) * fabiusSaddleCentralRadius b / (2 * b)) +
        ((2 : ℝ) ^ (m - 1))⁻¹ * (Real.sqrt b * Real.pi) := htail
    _ ≤ 16 * b⁻¹ + 32 * Real.pi * b⁻¹ := add_le_add hmiddle hfar
    _ = (16 + 32 * Real.pi) * b⁻¹ := by ring

/-- `integral_scaledPolynomialKernel_standardRadius_le` without the redundant
hypothesis `Real.exp 1 ≤ b`: it is implied by `4 ≤ b`, which the statement
already assumes.  Prefer this form; the hypothesis-heavy original is kept
unchanged so that no existing consumer moves. -/
lemma integral_scaledPolynomialKernel_standardRadius_le_of_four_le
    (b : ℝ) (m : ℕ)
    (hb4 : 4 ≤ b)
    (hm : b / 4 ≤ (m : ℝ))
    (hpow : (m : ℝ) ^ 2 ≤ (2 : ℝ) ^ m) :
    (∫ v in (Icc (-fabiusSaddleCentralRadius b)
        (fabiusSaddleCentralRadius b))ᶜ,
      scaledPolynomialKernel b m v) ≤
      (16 + 32 * Real.pi) * b⁻¹ :=
  integral_scaledPolynomialKernel_standardRadius_le b m
    (exp_one_le_of_four_le hb4) hb4 hm hpow

/-- For every natural number `n ≥ 4`, its real square is bounded by the
corresponding power of two: `(n : ℝ)² ≤ 2ⁿ`. -/
lemma natCast_sq_le_two_pow {n : ℕ} (hn : 4 ≤ n) :
    (n : ℝ) ^ 2 ≤ (2 : ℝ) ^ n := by
  induction n, hn using Nat.le_induction with
  | base => norm_num
  | succ n hn ih =>
      push_cast
      have hnR : (4 : ℝ) ≤ n := by exact_mod_cast hn
      calc
        ((n : ℝ) + 1) ^ 2 ≤ 2 * (n : ℝ) ^ 2 := by nlinarith
        _ ≤ 2 * (2 : ℝ) ^ n := mul_le_mul_of_nonneg_left ih (by norm_num)
        _ = (2 : ℝ) ^ (n + 1) := by rw [pow_succ]; ring

/-- Explicit complementary-tail estimate at the standardized radius
`√(32 log b)`.  The hypothesis `b/4 ≤ m` is `2m ≥ b/2`. -/
theorem integral_norm_fabius_scaledSaddleKernel_standardRadius_le
    (F : BoundedFabius) (hF : IsFabius F)
    (x r b : ℝ) (m : ℕ)
    (hr : 0 < r) (hbexp : Real.exp 1 ≤ b) (hb16 : 16 ≤ b)
    (hm : b / 4 ≤ (m : ℝ)) :
    (∫ v in (Icc (-fabiusSaddleCentralRadius b)
        (fabiusSaddleCentralRadius b))ᶜ,
      ‖QuantitativeSaddle.scaledSaddleKernel
        (fun z => complexGeneratingFunction F (-z)) x r b v‖) ≤
      negativeLaplaceMinorArcConstant r (2 * m) *
        ((16 + 32 * Real.pi) * b⁻¹) := by
  have hbpos : 0 < b := by linarith
  have hb4 : (4 : ℝ) ≤ b := by linarith
  have hm4R : (4 : ℝ) ≤ m := by linarith
  have hm4 : 4 ≤ m := by exact_mod_cast hm4R
  have hm1 : 1 ≤ m := by omega
  have hApos : 0 < fabiusSaddleCentralRadius b :=
    fabiusSaddleCentralRadius_pos (by
      exact (Real.one_lt_exp_iff.2 zero_lt_one).trans_le hbexp)
  have hraw := integral_norm_fabius_scaledSaddleKernel_compl_Icc_le
    F hF x r b (fabiusSaddleCentralRadius b) m hr hbpos hApos hm1
  have hmiddle := standardized_intermediate_tail_le_inv b
    (fabiusSaddleCentralRadius b) m (by linarith)
    (one_le_fabiusSaddleCentralRadius hbexp) hm
    (sq_fabiusSaddleCentralRadius (by linarith))
  have hfar := standardized_geometric_tail_le_inv b m hb4 hm
    (natCast_sq_le_two_pow hm4)
  have hbracket :
      2 * Real.exp (-((m : ℝ) * fabiusSaddleCentralRadius b /
          (2 * b)) * fabiusSaddleCentralRadius b) /
        ((m : ℝ) * fabiusSaddleCentralRadius b / (2 * b)) +
      ((2 : ℝ) ^ (m - 1))⁻¹ * (Real.sqrt b * Real.pi) ≤
        (16 + 32 * Real.pi) * b⁻¹ := by
    calc
      _ ≤ 16 * b⁻¹ + 32 * Real.pi * b⁻¹ := add_le_add hmiddle hfar
      _ = (16 + 32 * Real.pi) * b⁻¹ := by ring
  exact hraw.trans (mul_le_mul_of_nonneg_left hbracket
    (negativeLaplaceMinorArcConstant_pos r hr (2 * m)).le)

/-- `integral_norm_fabius_scaledSaddleKernel_standardRadius_le` without the
redundant hypothesis `Real.exp 1 ≤ b`: it already follows from `16 ≤ b`.
Prefer this form; the original pointwise theorem is retained for compatibility,
while the downstream
`integral_norm_fabius_scaledSaddleKernel_standardRadius_isBigO` public
statement remains unchanged. -/
theorem integral_norm_fabius_scaledSaddleKernel_standardRadius_le_of_sixteen_le
    (F : BoundedFabius) (hF : IsFabius F)
    (x r b : ℝ) (m : ℕ)
    (hr : 0 < r) (hb16 : 16 ≤ b)
    (hm : b / 4 ≤ (m : ℝ)) :
    (∫ v in (Icc (-fabiusSaddleCentralRadius b)
        (fabiusSaddleCentralRadius b))ᶜ,
      ‖QuantitativeSaddle.scaledSaddleKernel
        (fun z => complexGeneratingFunction F (-z)) x r b v‖) ≤
      negativeLaplaceMinorArcConstant r (2 * m) *
        ((16 + 32 * Real.pi) * b⁻¹) :=
  integral_norm_fabius_scaledSaddleKernel_standardRadius_le F hF x r b m hr
    (exp_one_le_of_four_le (by linarith)) hb16 hm

/-- Under the eventual pointwise hypotheses `0 < r`, `16 ≤ b`, and
`b / 4 ≤ m`, the standardized complementary tail is
`O(negativeLaplaceMinorArcConstant r (2 * m) * b⁻¹)`.  In particular, this
factorized estimate needs neither `b → ∞` nor boundedness of the minor-arc
constant. -/
theorem integral_norm_fabius_scaledSaddleKernel_standardRadius_isBigO_minorArcConstant_mul_inv
    {α : Type*} (l : Filter α)
    (F : BoundedFabius) (hF : IsFabius F)
    (x r b : α → ℝ) (m : α → ℕ)
    (hr : ∀ᶠ i in l, 0 < r i)
    (hb16 : ∀ᶠ i in l, (16 : ℝ) ≤ b i)
    (hm : ∀ᶠ i in l, b i / 4 ≤ (m i : ℝ)) :
    (fun i => ∫ v in
      (Icc (-fabiusSaddleCentralRadius (b i))
        (fabiusSaddleCentralRadius (b i)))ᶜ,
      ‖QuantitativeSaddle.scaledSaddleKernel
        (fun z => complexGeneratingFunction F (-z))
          (x i) (r i) (b i) v‖) =O[l]
      (fun i => negativeLaplaceMinorArcConstant (r i) (2 * m i) *
        (b i)⁻¹) := by
  let C : α → ℝ := fun i =>
    negativeLaplaceMinorArcConstant (r i) (2 * m i)
  let invB : α → ℝ := fun i => (b i)⁻¹
  let D : ℝ := 16 + 32 * Real.pi
  let tail : α → ℝ := fun i => ∫ v in
    (Icc (-fabiusSaddleCentralRadius (b i))
      (fabiusSaddleCentralRadius (b i)))ᶜ,
    ‖QuantitativeSaddle.scaledSaddleKernel
      (fun z => complexGeneratingFunction F (-z))
        (x i) (r i) (b i) v‖
  change tail =O[l] (fun i => C i * invB i)
  apply IsBigO.of_bound D
  filter_upwards [hr, hb16, hm] with i hri hbi16 hmi
  have hbound :=
    integral_norm_fabius_scaledSaddleKernel_standardRadius_le_of_sixteen_le
      F hF (x i) (r i) (b i) (m i) hri hbi16 hmi
  have htail0 : 0 ≤ tail i := by
    dsimp [tail]
    apply integral_nonneg_of_ae
    filter_upwards with v
    exact norm_nonneg _
  have hCi : 0 ≤ C i := by
    dsimp [C]
    exact (negativeLaplaceMinorArcConstant_pos (r i) hri (2 * m i)).le
  have hinv : 0 ≤ invB i := by
    dsimp [invB]
    exact inv_nonneg.mpr (by linarith)
  have hright0 : 0 ≤ C i * invB i := mul_nonneg hCi hinv
  rw [Real.norm_eq_abs, abs_of_nonneg htail0,
    Real.norm_eq_abs, abs_of_nonneg hright0]
  calc
    tail i ≤ C i * (D * invB i) := by
      simpa only [tail, C, D, invB] using hbound
    _ = D * (C i * invB i) := by ring

/-- Complementary-tail `O(1/b)` for the normalized scaled Fabius kernel.
The extracted factor count is `N = 2m`; the hypothesis `b/4 ≤ m` is exactly
`N ≥ b/2`.  The only Fabius-specific asymptotic input left explicit is
boundedness of the minor-arc product constant. -/
theorem integral_norm_fabius_scaledSaddleKernel_standardRadius_isBigO
    {α : Type*} (l : Filter α)
    (F : BoundedFabius) (hF : IsFabius F)
    (x r b : α → ℝ) (m : α → ℕ)
    (hr : ∀ᶠ i in l, 0 < r i)
    (hb : Tendsto b l atTop)
    (hm : ∀ᶠ i in l, b i / 4 ≤ (m i : ℝ))
    (hminor :
      (fun i => negativeLaplaceMinorArcConstant (r i) (2 * m i)) =O[l]
        (fun _i => (1 : ℝ))) :
    (fun i => ∫ v in
      (Icc (-fabiusSaddleCentralRadius (b i))
        (fabiusSaddleCentralRadius (b i)))ᶜ,
      ‖QuantitativeSaddle.scaledSaddleKernel
        (fun z => complexGeneratingFunction F (-z))
          (x i) (r i) (b i) v‖) =O[l]
      (fun i => (b i)⁻¹) := by
  have htail :=
    integral_norm_fabius_scaledSaddleKernel_standardRadius_isBigO_minorArcConstant_mul_inv
      l F hF x r b m hr (hb.eventually_ge_atTop (16 : ℝ)) hm
  have hright :
      (fun i => negativeLaplaceMinorArcConstant (r i) (2 * m i) *
        (b i)⁻¹) =O[l] (fun i => (b i)⁻¹) := by
    have hmul := hminor.mul (isBigO_refl (fun i => (b i)⁻¹) l)
    simpa only [one_mul] using hmul
  exact htail.trans hright

end Fabius
