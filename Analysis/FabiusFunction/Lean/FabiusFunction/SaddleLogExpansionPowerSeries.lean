import FabiusFunction.SaddleLogExpansionAlgebra

/-!
# Identification of the recursive saddle logarithm

The coefficient recurrence in `SaddleLogExpansionAlgebra` is identified
with Mathlib's formal power-series logarithm.  This supplies a bridge from
the finite recurrence used by the all-order saddle algebra to the standard
substitution calculus for `PowerSeries.logOf`.  The algebra module already
shows directly that the logarithmic and exponential coefficient recurrences
are inverse after the appropriate constant-term normalization; the theorem
here identifies that algebraically characterized logarithm with Mathlib's
universal construction. The unconditional normalization theorems also record
what both coefficient transforms do when the input constant term is arbitrary.
-/

set_option autoImplicit false

open PowerSeries

namespace Fabius.SaddleExpansion

noncomputable section

variable {R : Type*} [CommRing R] [Algebra ℚ R]

omit [Algebra ℚ R] in
private theorem alternatingGeom_mul_one_add_X :
    (PowerSeries.mk (fun n : ℕ => (-1 : R) ^ n)) *
        (1 + PowerSeries.X) = 1 := by
  ext n
  cases n with
  | zero => simp [mul_add]
  | succ n =>
      rw [mul_add, mul_one, map_add, PowerSeries.coeff_mk,
        PowerSeries.coeff_succ_mul_X, PowerSeries.coeff_mk,
        PowerSeries.coeff_one, if_neg (by omega), pow_succ]
      ring

/-- Without any hypothesis on the input constant coefficient, exponentiating
the recursive logarithm replaces that coefficient by its forced unit
normalization and leaves every positive coefficient unchanged. -/
theorem expSeries_logCoeff_eq_massSeries_normalize_zero (a : ℕ → R) :
    expSeries (logCoeff a) =
      massSeries (fun n => if n = 0 then 1 else a n) := by
  ext n
  rw [coeff_expSeries, coeff_massSeries]
  exact expCoeff_logCoeff_eq_ite a n

/-- Without any hypothesis on the exponent's constant coefficient, applying
the recursive logarithm after exponentiation replaces that coefficient by
its forced zero normalization and leaves every positive coefficient
unchanged. -/
theorem logSeries_expCoeff_eq_exponentSeries_normalize_zero (E : ℕ → R) :
    logSeries (expCoeff E) =
      exponentSeries (fun n => if n = 0 then 0 else E n) := by
  ext n
  rw [coeff_logSeries, coeff_exponentSeries]
  exact logCoeff_expCoeff_eq_ite E n

/-- The logarithm generated by `logCoeff` is Mathlib's formal logarithm of
the corresponding unit-constant mass series. -/
theorem logSeries_eq_logOf (a : ℕ → R) (ha0 : a 0 = 1) :
    logSeries a = PowerSeries.logOf (massSeries a) := by
  symm
  apply logSeries_unique a ha0
  · let g : PowerSeries R := massSeries a - 1
    have hg0 : PowerSeries.constantCoeff g = 0 := by
      have hm0 : PowerSeries.constantCoeff (massSeries a) = 1 := by
        rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply,
          coeff_massSeries, ha0]
      dsimp [g]
      rw [map_sub, map_one, hm0, sub_self]
    have hg : PowerSeries.HasSubst g :=
      PowerSeries.HasSubst.of_constantCoeff_zero' hg0
    have hgeom :
        (PowerSeries.mk (fun n : ℕ => (-1 : R) ^ n)).subst g *
            massSeries a = 1 := by
      have h := congrArg (PowerSeries.subst g)
        (alternatingGeom_mul_one_add_X (R := R))
      rw [PowerSeries.subst_mul hg] at h
      have hmass :
          (1 + PowerSeries.X : PowerSeries R).subst g = massSeries a := by
        rw [PowerSeries.subst_add hg, PowerSeries.subst_X hg]
        have hone : (1 : PowerSeries R).subst g = 1 := by
          change (PowerSeries.C 1).subst g = 1
          rw [PowerSeries.subst_C]
          rfl
        rw [hone]
        dsimp [g]
        ring
      have hone : (1 : PowerSeries R).subst g = 1 := by
        change (PowerSeries.C 1).subst g = 1
        rw [PowerSeries.subst_C]
        rfl
      rw [hmass, hone] at h
      exact h
    rw [PowerSeries.logOf_eq, PowerSeries.derivative_subst R hg,
      PowerSeries.deriv_log]
    have hderiv :
        (d⁄dX R) g = (d⁄dX R) (massSeries a) := by
      dsimp [g]
      simp
    rw [hderiv]
    have hmk :
        PowerSeries.mk (fun n : ℕ => algebraMap ℚ R ((-1) ^ n)) =
          PowerSeries.mk (fun n : ℕ => (-1 : R) ^ n) := by
      ext n
      simp
    rw [hmk]
    calc
      massSeries a *
          ((PowerSeries.mk (fun n : ℕ => (-1 : R) ^ n)).subst g *
            (d⁄dX R) (massSeries a)) =
          ((PowerSeries.mk (fun n : ℕ => (-1 : R) ^ n)).subst g *
            massSeries a) * (d⁄dX R) (massSeries a) := by ring
      _ = (d⁄dX R) (massSeries a) := by rw [hgeom, one_mul]
  · exact PowerSeries.constantCoeff_logOf (by
      rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply,
        coeff_massSeries, ha0])

end

end Fabius.SaddleExpansion
