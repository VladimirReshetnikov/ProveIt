import FabiusFunction.TransseriesDifferentialBlock

/-!
# The smallest differentially closed class

The algebraic content of the transseries volume's
`plt:thm:mot-smallest-differential-algebra`, the minimality theorem that
singles out the pair `(t, L) = (X⁻¹, log X)`.  The volume states it
inside the ring of germs at `+∞`; formalized here for **any** commutative
ring with a derivation, of which the germ ring is one instance.

The engine is a general fact Mathlib does not carry:

`isDerivationStable_adjoin` — *a generated subalgebra is stable under a
derivation as soon as the generators' derivatives lie in it.*

Everything else is a two-line consequence.  Because `d L = t` forces any
`d`-stable class containing a logarithm to contain `t`, and `d t = -t²`
then closes up, the class `R[t, L]` is not merely *a* closed class
containing `L` — it is the smallest one.  This is the precise sense in
which the second generator is not a convenience.

* `IsDerivationStable`, `isDerivationStable_top`,
  `isDerivationStable_iInf` — the notion and its closure properties.
* `isDerivationStable_adjoin` — **the generation criterion.**
* `derivationOrbit`, `isLeast_adjoin_derivationOrbit` — **the
  differential closure** of an arbitrary set: the subalgebra generated by
  the orbit `⋃ₙ dⁿ(S)` is the least `d`-stable subalgebra containing `S`.
* `isLeast_adjoin_singleton_of_derivation_eq_one` — **part (i)**:
  `d X = 1` gives `R[X]`.
* `isLeast_adjoin_pair_of_derivation_log` — **part (ii)**: `d L = t`,
  `d t = -t²` give `R[t, L]`.
* `isLeast_adjoin_triple_of_derivation_log` — **part (iii)**: adding `X`
  as a unit inverse to `t` gives `R[X, t, L] = R[t, t⁻¹][L]`.

Not formalized here, because they are analytic rather than algebraic
statements about the germ ring: the growth clause of part (i) (no element
of `ℚ[X]` is asymptotic to a multiple of `log X`) and part (iv) (`t` and
`L` are algebraically independent over `ℝ`).  Neither is used by the
minimality argument; both concern one particular model of it.
-/

set_option autoImplicit false

open Algebra

namespace Fabius

section Stable

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- A subalgebra is stable under a derivation when the derivation maps it
into itself. -/
def IsDerivationStable (d : Derivation R A A) (T : Subalgebra R A) : Prop :=
  ∀ a ∈ T, d a ∈ T

/-- The whole algebra is stable under every derivation. -/
theorem isDerivationStable_top (d : Derivation R A A) :
    IsDerivationStable d (⊤ : Subalgebra R A) := fun _ _ => trivial

/-- Stability is preserved by arbitrary infima, so the `d`-stable
subalgebras form a complete lattice and "the smallest `d`-stable
subalgebra containing `S`" is well defined. -/
theorem isDerivationStable_iInf {ι : Sort*} (d : Derivation R A A)
    {T : ι → Subalgebra R A} (h : ∀ i, IsDerivationStable d (T i)) :
    IsDerivationStable d (⨅ i, T i) := by
  intro a ha
  rw [Algebra.mem_iInf] at ha ⊢
  exact fun i => h i a (ha i)

/-- **The generation criterion.**  A generated subalgebra is stable as soon
as the generators' derivatives lie in it. -/
theorem isDerivationStable_adjoin (d : Derivation R A A) {S : Set A}
    (h : ∀ s ∈ S, d s ∈ adjoin R S) :
    IsDerivationStable d (adjoin R S) := by
  intro a ha
  induction ha using Algebra.adjoin_induction with
  | mem x hx => exact h x hx
  | algebraMap r => rw [d.map_algebraMap]; exact zero_mem _
  | add x y hx hy ihx ihy => rw [map_add]; exact add_mem ihx ihy
  | mul x y hx hy ihx ihy =>
      rw [d.leibniz]
      simp only [smul_eq_mul]
      exact add_mem (mul_mem hx ihy) (mul_mem hy ihx)

/-- The `d`-orbit of a set: everything reachable from `S` by repeated
differentiation. -/
def derivationOrbit (d : Derivation R A A) (S : Set A) : Set A :=
  ⋃ n : ℕ, (⇑d)^[n] '' S

/-- A set sits inside its own orbit, at differentiation depth zero. -/
theorem subset_derivationOrbit (d : Derivation R A A) (S : Set A) :
    S ⊆ derivationOrbit d S := by
  intro a ha
  exact Set.mem_iUnion.2 ⟨0, ⟨a, ha, rfl⟩⟩

/-- The orbit is stable under one more differentiation: depth `n` maps to
depth `n + 1`. -/
theorem derivation_mem_derivationOrbit (d : Derivation R A A) {S : Set A}
    {a : A} (ha : a ∈ derivationOrbit d S) : d a ∈ derivationOrbit d S := by
  obtain ⟨_, ⟨n, rfl⟩, b, hb, rfl⟩ := ha
  refine Set.mem_iUnion.2 ⟨n + 1, ⟨b, hb, ?_⟩⟩
  rw [Function.iterate_succ_apply']

/-- **The differential closure.**  The subalgebra generated by the `d`-orbit
of `S` is the smallest `d`-stable subalgebra containing `S`. -/
theorem isLeast_adjoin_derivationOrbit (d : Derivation R A A) (S : Set A) :
    IsLeast {T : Subalgebra R A | IsDerivationStable d T ∧ S ⊆ T}
      (adjoin R (derivationOrbit d S)) := by
  constructor
  · refine ⟨isDerivationStable_adjoin d fun s hs => ?_, ?_⟩
    · exact subset_adjoin (derivation_mem_derivationOrbit d hs)
    · exact (subset_derivationOrbit d S).trans subset_adjoin
  · rintro T ⟨hstab, hsub⟩
    refine adjoin_le ?_
    rintro _ ⟨_, ⟨n, rfl⟩, b, hb, rfl⟩
    induction n with
    | zero => simpa using hsub hb
    | succ m ih =>
        rw [Function.iterate_succ_apply']
        exact hstab _ ih

end Stable

section Motivating

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
  (d : Derivation R A A) {X t L : A}

/-- **Part (i).**  If `d X = 1` then `R[X]` is the smallest `d`-stable
subalgebra containing `X`. -/
theorem isLeast_adjoin_singleton_of_derivation_eq_one (hdX : d X = 1) :
    IsLeast {T : Subalgebra R A | IsDerivationStable d T ∧ X ∈ T}
      (adjoin R {X}) := by
  constructor
  · refine ⟨isDerivationStable_adjoin d ?_, subset_adjoin rfl⟩
    rintro s rfl
    rw [hdX]
    exact one_mem _
  · rintro T ⟨-, hX⟩
    exact adjoin_le (Set.singleton_subset_iff.2 hX)

/-- **Part (ii).**  If `d t = -t²` and `d L = t` then `R[t, L]` is the
smallest `d`-stable subalgebra containing `L`: a differentially closed
class containing a logarithm must contain `t`. -/
theorem isLeast_adjoin_pair_of_derivation_log (hdt : d t = -t ^ 2)
    (hdL : d L = t) :
    IsLeast {T : Subalgebra R A | IsDerivationStable d T ∧ L ∈ T}
      (adjoin R {t, L}) := by
  have hmem : t ∈ adjoin R ({t, L} : Set A) := subset_adjoin (by simp)
  have hmemL : L ∈ adjoin R ({t, L} : Set A) := subset_adjoin (by simp)
  constructor
  · refine ⟨isDerivationStable_adjoin d ?_, hmemL⟩
    intro s hs
    rcases hs with rfl | rfl
    · rw [hdt]
      exact neg_mem (pow_mem hmem 2)
    · rw [hdL]
      exact hmem
  · rintro T ⟨hstab, hL⟩
    refine adjoin_le ?_
    rintro s (rfl | rfl)
    · rw [← hdL]
      exact hstab _ hL
    · exact hL

end Motivating

section Unit

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
  (d : Derivation R A A) {L : A} {u : Aˣ}

/-- **Part (iii).**  With `t` a unit, `X = t⁻¹`, `d t = -t²` and `d L = t`,
the smallest `d`-stable subalgebra containing `X` and `L` is
`R[X, t, L] = R[t, t⁻¹][L]`. -/
theorem isLeast_adjoin_triple_of_derivation_log (hdt : d (u : A) = -(u : A) ^ 2)
    (hdL : d L = (u : A)) :
    IsLeast {T : Subalgebra R A |
        IsDerivationStable d T ∧ ((u⁻¹ : Aˣ) : A) ∈ T ∧ L ∈ T}
      (adjoin R {((u⁻¹ : Aˣ) : A), (u : A), L}) := by
  set S : Set A := {((u⁻¹ : Aˣ) : A), (u : A), L} with hS
  have hX : ((u⁻¹ : Aˣ) : A) ∈ adjoin R S := subset_adjoin (by simp [hS])
  have ht : (u : A) ∈ adjoin R S := subset_adjoin (by simp [hS])
  have hL : L ∈ adjoin R S := subset_adjoin (by simp [hS])
  constructor
  · refine ⟨isDerivationStable_adjoin d ?_, hX, hL⟩
    intro s hs
    rcases hs with rfl | rfl | rfl
    · rw [derivation_val_inv d hdt]
      exact one_mem _
    · rw [hdt]
      exact neg_mem (pow_mem ht 2)
    · rw [hdL]
      exact ht
  · rintro T ⟨hstab, hXT, hLT⟩
    refine adjoin_le ?_
    rintro s (rfl | rfl | rfl)
    · exact hXT
    · rw [← hdL]
      exact hstab _ hLT
    · exact hLT

end Unit

end Fabius
