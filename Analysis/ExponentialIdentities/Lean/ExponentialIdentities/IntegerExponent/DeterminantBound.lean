import Mathlib.Analysis.Calculus.Taylor
import Mathlib.Analysis.Complex.ExponentialBounds
import Mathlib.Analysis.SpecialFunctions.ExpDeriv
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.Matrix.AbsoluteValue
import Mathlib.Tactic

/-!
# Determinant bounds for the integer-exponent problem

This file packages the analytic part of the determinant method used for the following problem:
if `2 ^ x`, `3 ^ x`, and `5 ^ x` are integers, then `x` is an integer.

The main ingredients are:

* a row-sensitive Leibniz bound for determinants;
* a low-rank/high-Taylor-tail expansion of the exponential kernel;
* the arithmetic lower bound for a nonzero determinant with integer entries; and
* a coarse numerical estimate which makes the analytic upper bound strictly smaller than one.
-/

open scoped BigOperators Nat Interval
open Finset Set

namespace LeanProofs.IntegerExponent

noncomputable section

/-- A row-sensitive version of the usual Leibniz bound for a determinant. -/
theorem Matrix.det_le_prod_row
    {R S n : Type*} [CommRing R] [Nontrivial R]
    [CommRing S] [LinearOrder S] [IsStrictOrderedRing S]
    [Fintype n] [DecidableEq n]
    {A : Matrix n n R} {abv : AbsoluteValue R S} {c : n → S}
    (hc : ∀ i j, abv (A i j) ≤ c i) :
    abv A.det ≤ (Fintype.card n)! • ∏ i, c i := by
  calc
    abv A.det = abv (∑ σ : Equiv.Perm n,
        Equiv.Perm.sign σ • ∏ i, A (σ i) i) := congr_arg abv (Matrix.det_apply _)
    _ ≤ ∑ σ : Equiv.Perm n,
        abv (Equiv.Perm.sign σ • ∏ i, A (σ i) i) := abv.sum_le _ _
    _ = ∑ σ : Equiv.Perm n, ∏ i, abv (A (σ i) i) :=
      Finset.sum_congr rfl fun σ _ ↦ by rw [abv.map_units_int_smul, abv.map_prod]
    _ ≤ ∑ _σ : Equiv.Perm n, ∏ i, c i := by
      apply Finset.sum_le_sum
      intro σ _
      calc
        (∏ i, abv (A (σ i) i)) ≤ ∏ i, c (σ i) := by
          gcongr with i
          exact hc (σ i) i
        _ = ∏ i, c i := Equiv.prod_comp σ c
    _ = (Fintype.card n)! • ∏ i, c i := by simp [Fintype.card_perm]

/-- A determinant vanishes if more than `r` selected rows belong to a subspace generated by
`r` fixed vectors. -/
private theorem det_piecewise_eq_zero_of_card_gt_of_mem_span
    {m r : ℕ} (L H : Matrix (Fin m) (Fin m) ℝ) (v : Fin r → Fin m → ℝ)
    (hL : ∀ i, L i ∈ Submodule.span ℝ (Set.range v))
    (s : Finset (Fin m)) (hrs : r < s.card) :
    Matrix.det (s.piecewise L H) = 0 := by
  apply Matrix.det_eq_zero_of_not_linearIndependent_rows
  intro hLI
  have hLI_s : LinearIndependent ℝ (fun i : s ↦ L i) := by
    have h := hLI.comp (fun i : s ↦ (i : Fin m)) Subtype.val_injective
    have heq :
        ((fun i ↦ (s.piecewise L H) i) ∘ fun i : s ↦ (i : Fin m)) =
          (fun i : s ↦ L i) := by
      funext i
      simp [Function.comp_apply, i.property]
    rw [heq] at h
    exact h
  let P : Submodule ℝ (Fin m → ℝ) := Submodule.span ℝ (Set.range v)
  let w : s → P := fun i ↦ ⟨L i, hL i⟩
  have hLI_w : LinearIndependent ℝ w := by
    apply LinearIndependent.of_comp P.subtype
    change LinearIndependent ℝ (fun i : s ↦ L i)
    exact hLI_s
  have hcard : s.card ≤ Module.finrank ℝ P := by
    simpa only [Fintype.card_coe] using hLI_w.fintype_card_le_finrank
  have hfin : Module.finrank ℝ P ≤ r := by
    dsimp only [P]
    change (Set.range v).finrank ℝ ≤ r
    simpa only [Fintype.card_fin] using
      (finrank_range_le_card (R := ℝ) (M := Fin m → ℝ) v)
  omega

private theorem pow_split_mono {m r c : ℕ} (hrm : r ≤ m) (hcr : c ≤ r)
    {hi lo : ℝ} (hhi : 0 ≤ hi) (hhilo : hi ≤ lo) :
    lo ^ c * hi ^ (m - c) ≤ lo ^ r * hi ^ (m - r) := by
  calc
    lo ^ c * hi ^ (m - c) =
        (lo ^ c * hi ^ (r - c)) * hi ^ (m - r) := by
      rw [show m - c = (r - c) + (m - r) by omega, pow_add]
      ring
    _ ≤ (lo ^ c * lo ^ (r - c)) * hi ^ (m - r) := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hhi hhilo _)
          (pow_nonneg (hhi.trans hhilo) _))
        (pow_nonneg hhi _)
    _ = lo ^ r * hi ^ (m - r) := by
      rw [← pow_add, Nat.add_sub_of_le hcr]

/-- Expand a determinant row-by-row as `L + H`, discard the terms with too many low rows,
and bound every remaining term by its row bounds. -/
private theorem abs_det_add_le_of_low_high
    {m r : ℕ} (hrm : r ≤ m) (L H : Matrix (Fin m) (Fin m) ℝ)
    (lo hi : ℝ) (hhi : 0 ≤ hi) (hhilo : hi ≤ lo)
    (hL : ∀ i j, |L i j| ≤ lo) (hH : ∀ i j, |H i j| ≤ hi)
    (hvanish : ∀ s : Finset (Fin m), r < s.card → Matrix.det (s.piecewise L H) = 0) :
    |Matrix.det (L + H)| ≤
      (2 : ℝ) ^ m * (m.factorial : ℝ) * lo ^ r * hi ^ (m - r) := by
  let D : (Fin m → ℝ) [⋀^Fin m]→ₗ[ℝ] ℝ := Matrix.detRowAlternating
  have hexpand : Matrix.det (L + H) =
      ∑ s : Finset (Fin m), Matrix.det (s.piecewise L H) := by
    change D (L + H) = ∑ s : Finset (Fin m), D (s.piecewise L H)
    exact D.map_add_univ L H
  rw [hexpand]
  calc
    |∑ s : Finset (Fin m), Matrix.det (s.piecewise L H)| ≤
        ∑ s : Finset (Fin m), |Matrix.det (s.piecewise L H)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _s : Finset (Fin m),
        (m.factorial : ℝ) * lo ^ r * hi ^ (m - r) := by
      apply Finset.sum_le_sum
      intro s _
      by_cases hs : s.card ≤ r
      · calc
          |Matrix.det (s.piecewise L H)| ≤
              (m.factorial : ℝ) * (lo ^ s.card * hi ^ (m - s.card)) := by
            have hsfilter :
                Finset.univ.filter (fun i : Fin m ↦ i ∈ s) = s := by
              ext i
              simp
            have hnfilter :
                Finset.univ.filter (fun i : Fin m ↦ i ∉ s) = sᶜ := by
              ext i
              simp
            have hcompl : (sᶜ).card = m - s.card := by
              simpa [Fintype.card_fin] using Finset.card_compl s
            have hprod :
                (∏ i : Fin m, if i ∈ s then lo else hi) =
                  lo ^ s.card * hi ^ (m - s.card) := by
              rw [Finset.prod_ite, hsfilter, hnfilter,
                Finset.prod_const, Finset.prod_const, hcompl]
            have hb := Matrix.det_le_prod_row
              (A := s.piecewise L H) (abv := (AbsoluteValue.abs : AbsoluteValue ℝ ℝ))
              (c := fun i ↦ if i ∈ s then lo else hi) (fun i j ↦ ?_)
            · calc
                |Matrix.det (s.piecewise L H)| ≤
                    (Fintype.card (Fin m))! •
                      (∏ i : Fin m, if i ∈ s then lo else hi) := by
                        simpa only [AbsoluteValue.abs_apply] using hb
                _ = (m.factorial : ℝ) *
                    (lo ^ s.card * hi ^ (m - s.card)) := by
                      rw [hprod]
                      simp [Fintype.card_fin, nsmul_eq_mul]
            · by_cases his : i ∈ s
              · simpa [Finset.piecewise, his] using hL i j
              · simpa [Finset.piecewise, his] using hH i j
          _ ≤ (m.factorial : ℝ) * (lo ^ r * hi ^ (m - r)) := by
            exact mul_le_mul_of_nonneg_left (pow_split_mono hrm hs hhi hhilo)
              (Nat.cast_nonneg _)
          _ = (m.factorial : ℝ) * lo ^ r * hi ^ (m - r) := by ring
      · rw [hvanish s (by omega), abs_zero]
        exact mul_nonneg
          (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (hhi.trans hhilo) _))
          (pow_nonneg hhi _)
    _ = (2 : ℝ) ^ m * (m.factorial : ℝ) * lo ^ r * hi ^ (m - r) := by
      simp [Fintype.card_fin, Fintype.card_finset]
      ring

private theorem abs_det_add_le_of_low_mem_span
    {m r : ℕ} (hrm : r ≤ m) (L H : Matrix (Fin m) (Fin m) ℝ)
    (v : Fin r → Fin m → ℝ) (hv : ∀ i, L i ∈ Submodule.span ℝ (Set.range v))
    (lo hi : ℝ) (hhi : 0 ≤ hi) (hhilo : hi ≤ lo)
    (hL : ∀ i j, |L i j| ≤ lo) (hH : ∀ i j, |H i j| ≤ hi) :
    |Matrix.det (L + H)| ≤
      (2 : ℝ) ^ m * (m.factorial : ℝ) * lo ^ r * hi ^ (m - r) :=
  abs_det_add_le_of_low_high hrm L H lo hi hhi hhilo hL hH
    (det_piecewise_eq_zero_of_card_gt_of_mem_span L H v hv)

/-- The exact Lagrange-form Taylor bound needed for the high part of the exponential kernel. -/
theorem abs_exp_sub_partial_sum_le (z : ℝ) (r : ℕ) :
    |Real.exp z - ∑ k ∈ Finset.range r, z ^ k / (k.factorial : ℝ)| ≤
      Real.exp |z| * |z| ^ r / (r.factorial : ℝ) := by
  cases r with
  | zero =>
      simp only [Finset.range_zero, Finset.sum_empty, sub_zero, pow_zero,
        Nat.factorial_zero, Nat.cast_one, div_one, mul_one,
        abs_of_pos (Real.exp_pos z)]
      exact Real.exp_le_exp.mpr (le_abs_self z)
  | succ n =>
      by_cases hz : z = 0
      · subst z
        simp [Finset.sum_range_succ']
      · obtain ⟨ξ, hξ, hrem⟩ :=
          taylor_mean_remainder_lagrange_iteratedDeriv
            (f := Real.exp) (x := z) (x₀ := 0) (n := n) (Ne.symm hz)
            Real.contDiff_exp.contDiffOn
        have htaylor :
            taylorWithinEval Real.exp n (uIcc 0 z) 0 z =
              ∑ k ∈ Finset.range (n + 1), z ^ k / (k.factorial : ℝ) := by
          rw [taylor_within_apply]
          apply Finset.sum_congr rfl
          intro k hk
          rw [iteratedDerivWithin_eq_iteratedDeriv (uniqueDiffOn_uIcc (Ne.symm hz))
            Real.contDiff_exp.contDiffAt left_mem_uIcc]
          have hkexp : iteratedDeriv k Real.exp 0 = 1 := by
            simpa using congrFun (iteratedDeriv_exp_const_mul k 1) 0
          rw [hkexp]
          simp [div_eq_mul_inv, mul_comm]
        have hderiv : iteratedDeriv (n + 1) Real.exp ξ = Real.exp ξ := by
          simpa using congrFun (iteratedDeriv_exp_const_mul (n + 1) 1) ξ
        have hξabs : ξ ≤ |z| := by
          calc
            ξ ≤ |ξ| := le_abs_self ξ
            _ = |ξ - 0| := by simp
            _ ≤ |z - 0| := abs_sub_left_of_mem_uIcc (uIoo_subset_uIcc_self hξ)
            _ = |z| := by simp
        rw [htaylor, hderiv, sub_zero] at hrem
        rw [hrem]
        have hfacnonneg : (0 : ℝ) ≤ ((n + 1).factorial : ℝ) := Nat.cast_nonneg _
        rw [abs_div, abs_mul, abs_pow, abs_of_pos (Real.exp_pos ξ),
          abs_of_nonneg hfacnonneg]
        exact div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr hξabs)
            (pow_nonneg (abs_nonneg z) _))
          hfacnonneg

private def truncExpMatrix {m : ℕ} (a b : Fin m → ℝ) (r : ℕ) :
    Matrix (Fin m) (Fin m) ℝ :=
  fun i j ↦ ∑ k ∈ Finset.range r, (a i * b j) ^ k / (k.factorial : ℝ)

private theorem abs_partial_exp_sum_le (z : ℝ) (r : ℕ) :
    |∑ k ∈ Finset.range r, z ^ k / (k.factorial : ℝ)| ≤ Real.exp |z| := by
  calc
    |∑ k ∈ Finset.range r, z ^ k / (k.factorial : ℝ)| ≤
        ∑ k ∈ Finset.range r, |z ^ k / (k.factorial : ℝ)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ = ∑ k ∈ Finset.range r, |z| ^ k / (k.factorial : ℝ) := by
      apply Finset.sum_congr rfl
      intro k hk
      have hkfacnonneg : (0 : ℝ) ≤ (k.factorial : ℝ) := Nat.cast_nonneg _
      rw [abs_div, abs_pow, abs_of_nonneg hkfacnonneg]
    _ ≤ Real.exp |z| := Real.sum_le_exp_of_nonneg (abs_nonneg z) r

private theorem truncExpMatrix_row_mem_span {m r : ℕ} (a b : Fin m → ℝ) (i : Fin m) :
    truncExpMatrix a b r i ∈
      Submodule.span ℝ (Set.range (fun k : Fin r ↦ fun j : Fin m ↦ b j ^ (k : ℕ))) := by
  have heq : truncExpMatrix a b r i =
      ∑ k ∈ Finset.range r,
        ((a i) ^ k / (k.factorial : ℝ)) • (fun j : Fin m ↦ b j ^ k) := by
    funext j
    simp only [truncExpMatrix, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro k hk
    rw [mul_pow]
    ring_nf
  rw [heq]
  apply Submodule.sum_mem
  intro k hk
  apply Submodule.smul_mem
  apply Submodule.subset_span
  refine ⟨⟨k, Finset.mem_range.mp hk⟩, ?_⟩
  rfl

/-- Low/high Taylor bound for the determinant of an exponential kernel. -/
theorem abs_det_exp_mul_le
    {m r : ℕ} (hrm : r ≤ m) (a b : Fin m → ℝ) (C : ℝ)
    (hC0 : 0 ≤ C) (hprod : ∀ i j, |a i * b j| ≤ C)
    (hsmall : C ^ r / (r.factorial : ℝ) ≤ 1) :
    |Matrix.det (fun i j ↦ Real.exp (a i * b j))| ≤
      (2 : ℝ) ^ m * (m.factorial : ℝ) * (Real.exp C) ^ r *
        (Real.exp C * C ^ r / (r.factorial : ℝ)) ^ (m - r) := by
  let E : Matrix (Fin m) (Fin m) ℝ := fun i j ↦ Real.exp (a i * b j)
  let L := truncExpMatrix a b r
  let H := E - L
  have hsplit : L + H = E := by
    ext i j
    simp [H]
  change |Matrix.det E| ≤ _
  rw [← hsplit]
  refine abs_det_add_le_of_low_mem_span hrm L H
    (fun k : Fin r ↦ fun j : Fin m ↦ b j ^ (k : ℕ)) ?_
    (Real.exp C) (Real.exp C * C ^ r / (r.factorial : ℝ)) ?_ ?_ ?_ ?_
  · intro i
    exact truncExpMatrix_row_mem_span a b i
  · positivity
  · calc
      Real.exp C * C ^ r / (r.factorial : ℝ) ≤ Real.exp C * 1 := by
        rw [mul_div_assoc]
        exact mul_le_mul_of_nonneg_left hsmall (Real.exp_pos C).le
      _ = Real.exp C := mul_one _
  · intro i j
    change |truncExpMatrix a b r i j| ≤ Real.exp C
    exact (abs_partial_exp_sum_le (a i * b j) r).trans
      (Real.exp_le_exp.mpr (hprod i j))
  · intro i j
    change |Real.exp (a i * b j) - truncExpMatrix a b r i j| ≤
      Real.exp C * C ^ r / (r.factorial : ℝ)
    calc
      |Real.exp (a i * b j) - truncExpMatrix a b r i j| ≤
          Real.exp |a i * b j| * |a i * b j| ^ r / (r.factorial : ℝ) :=
        abs_exp_sub_partial_sum_le (a i * b j) r
      _ ≤ Real.exp C * C ^ r / (r.factorial : ℝ) := by
        exact div_le_div_of_nonneg_right
          (mul_le_mul (Real.exp_le_exp.mpr (hprod i j))
            (pow_le_pow_left₀ (abs_nonneg _) (hprod i j) r)
            (pow_nonneg (abs_nonneg _) r) (Real.exp_pos C).le)
          (Nat.cast_nonneg _)

/-- A nonzero real determinant whose entries are integers has absolute value at least one. -/
theorem one_le_abs_det_of_integer_entries
    {n : Type*} [Fintype n] [DecidableEq n] (A : Matrix n n ℝ)
    (hA : ∀ i j, ∃ z : ℤ, (z : ℝ) = A i j) (hne : A.det ≠ 0) :
    1 ≤ |A.det| := by
  choose Z hZ using hA
  let B : Matrix n n ℤ := fun i j ↦ Z i j
  have hmap : B.map (fun z : ℤ ↦ (z : ℝ)) = A := by
    ext i j
    exact hZ i j
  have hdet : (B.det : ℝ) = A.det := by
    rw [Int.cast_det, hmap]
  have hBne : B.det ≠ 0 := by
    intro h
    apply hne
    rw [← hdet, h, Int.cast_zero]
  rw [← hdet, ← Int.cast_abs, ← Int.cast_one, Int.cast_le]
  exact Int.one_le_abs hBne

/-- If `r` is at least `192 C`, the exponential-series coefficient is at most `64⁻ʳ`. -/
theorem pow_div_factorial_le_inv64_pow (C r : ℕ) (hr : 0 < r) (hCr : 192 * C ≤ r) :
    (C : ℝ) ^ r / (r.factorial : ℝ) ≤ ((1 : ℝ) / 64) ^ r := by
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  have hrewrite :
      (C : ℝ) ^ r / (r.factorial : ℝ) =
        ((C : ℝ) / r) ^ r * ((r : ℝ) ^ r / (r.factorial : ℝ)) := by
    rw [div_pow]
    have hfacR0 : (r.factorial : ℝ) ≠ 0 := by positivity
    field_simp [hrR.ne', hfacR0]
  have hexp : Real.exp (r : ℝ) ≤ (3 : ℝ) ^ r := by
    calc
      Real.exp (r : ℝ) = Real.exp ((r : ℝ) * 1) := by simp
      _ = Real.exp 1 ^ r := Real.exp_nat_mul 1 r
      _ ≤ (3 : ℝ) ^ r := pow_le_pow_left₀ (Real.exp_pos 1).le
        Real.exp_one_lt_three.le r
  have hratio : (3 : ℝ) * C / r ≤ (1 : ℝ) / 64 := by
    apply (div_le_div_iff₀ hrR (by norm_num : (0 : ℝ) < 64)).2
    have hCrR : (192 : ℝ) * C ≤ r := by exact_mod_cast hCr
    calc
      (3 : ℝ) * C * 64 = 192 * C := by ring
      _ ≤ r := hCrR
      _ = 1 * r := by ring
  rw [hrewrite]
  calc
    ((C : ℝ) / r) ^ r * ((r : ℝ) ^ r / (r.factorial : ℝ)) ≤
        ((C : ℝ) / r) ^ r * Real.exp (r : ℝ) := by
      exact mul_le_mul_of_nonneg_left
        (Real.pow_div_factorial_le_exp (x := (r : ℝ)) (by positivity) r)
        (pow_nonneg (by positivity) _)
    _ ≤ ((C : ℝ) / r) ^ r * (3 : ℝ) ^ r := by
      exact mul_le_mul_of_nonneg_left hexp (pow_nonneg (by positivity) _)
    _ = ((3 : ℝ) * C / r) ^ r := by
      rw [← mul_pow]
      congr 1
      field_simp [hrR.ne']
    _ ≤ ((1 : ℝ) / 64) ^ r :=
      pow_le_pow_left₀ (by positivity) hratio r

/-- The complete numerical contradiction after the low/high determinant estimate.

The first conjunct is the `hi ≤ lo` side condition. The second says that the analytic upper
bound for the determinant is strictly below one. -/
theorem exponential_det_numeric_bound
    (C m r : ℕ) (hm : m = 2 * r) (hr : 2 < r) (hCr : 192 * C ≤ r) :
    (C : ℝ) ^ r / (r.factorial : ℝ) ≤ 1 ∧
      (2 : ℝ) ^ m * (m.factorial : ℝ) * Real.exp (C : ℝ) ^ r *
          (Real.exp (C : ℝ) * ((C : ℝ) ^ r / (r.factorial : ℝ))) ^ (m - r) < 1 := by
  subst m
  have hr0 : 0 < r := by omega
  let q : ℝ := (C : ℝ) ^ r / (r.factorial : ℝ)
  have hq0 : 0 ≤ q := by
    dsimp only [q]
    positivity
  have htail : q ≤ ((1 : ℝ) / 64) ^ r := by
    exact pow_div_factorial_le_inv64_pow C r hr0 hCr
  have hsmall : q ≤ 1 := htail.trans (pow_le_one₀ (by norm_num) (by norm_num))
  have hfacNat : (2 * r).factorial ≤ 2 ^ (4 * r * r) := by
    calc
      (2 * r).factorial ≤ (2 * r) ^ (2 * r) := Nat.factorial_le_pow _
      _ ≤ (2 ^ (2 * r)) ^ (2 * r) :=
        pow_le_pow_left₀ (Nat.zero_le _) (Nat.le_of_lt (2 * r).lt_two_pow_self) _
      _ = 2 ^ (4 * r * r) := by
        rw [← pow_mul]
        congr 1
        ring
  have hfac : ((2 * r).factorial : ℝ) ≤ (2 : ℝ) ^ (4 * r * r) := by
    exact_mod_cast hfacNat
  have hexpBase : Real.exp (C : ℝ) ≤ (4 : ℝ) ^ C := by
    calc
      Real.exp (C : ℝ) = Real.exp 1 ^ C := by
        rw [← Real.exp_nat_mul]
        simp
      _ ≤ (3 : ℝ) ^ C :=
        pow_le_pow_left₀ (Real.exp_pos 1).le Real.exp_one_lt_three.le C
      _ ≤ (4 : ℝ) ^ C := pow_le_pow_left₀ (by norm_num) (by norm_num) C
  have hfourC : 4 * C ≤ r := by omega
  have hExpExponent : 4 * C * r ≤ r * r := Nat.mul_le_mul_right r hfourC
  have hexpPow : Real.exp (C : ℝ) ^ (2 * r) ≤ (2 : ℝ) ^ (r * r) := by
    calc
      Real.exp (C : ℝ) ^ (2 * r) ≤ ((4 : ℝ) ^ C) ^ (2 * r) :=
        pow_le_pow_left₀ (Real.exp_pos _).le hexpBase _
      _ = (2 : ℝ) ^ (4 * C * r) := by
        rw [show (4 : ℝ) = (2 : ℝ) ^ 2 by norm_num, ← pow_mul, ← pow_mul]
        congr 1
        ring
      _ ≤ (2 : ℝ) ^ (r * r) := pow_le_pow_right₀ (by norm_num) hExpExponent
  have htailPow : q ^ r ≤ (((1 : ℝ) / 64) ^ r) ^ r :=
    pow_le_pow_left₀ hq0 htail r
  have htwoRsub : 2 * r - r = r := by omega
  have hrearrange :
      (2 : ℝ) ^ (2 * r) * ((2 * r).factorial : ℝ) * Real.exp (C : ℝ) ^ r *
          (Real.exp (C : ℝ) * q) ^ r =
        (2 : ℝ) ^ (2 * r) * ((2 * r).factorial : ℝ) *
          Real.exp (C : ℝ) ^ (2 * r) * q ^ r := by
    rw [mul_pow]
    have hexpCombine : Real.exp (C : ℝ) ^ r * Real.exp (C : ℝ) ^ r =
        Real.exp (C : ℝ) ^ (2 * r) := by
      rw [← pow_add]
      congr 1
      omega
    calc
      (2 : ℝ) ^ (2 * r) * ((2 * r).factorial : ℝ) * Real.exp (C : ℝ) ^ r *
          (Real.exp (C : ℝ) ^ r * q ^ r) =
        ((2 : ℝ) ^ (2 * r) * ((2 * r).factorial : ℝ)) *
          (Real.exp (C : ℝ) ^ r * Real.exp (C : ℝ) ^ r) * q ^ r := by ring
      _ = (2 : ℝ) ^ (2 * r) * ((2 * r).factorial : ℝ) *
          Real.exp (C : ℝ) ^ (2 * r) * q ^ r := by rw [hexpCombine]
  have hcoarse :
      (2 : ℝ) ^ (2 * r) * ((2 * r).factorial : ℝ) *
          Real.exp (C : ℝ) ^ (2 * r) * q ^ r ≤
        (2 : ℝ) ^ (2 * r) * (2 : ℝ) ^ (4 * r * r) *
          (2 : ℝ) ^ (r * r) * (((1 : ℝ) / 64) ^ r) ^ r := by
    have h₁ :
        (2 : ℝ) ^ (2 * r) * ((2 * r).factorial : ℝ) ≤
          (2 : ℝ) ^ (2 * r) * (2 : ℝ) ^ (4 * r * r) :=
      mul_le_mul_of_nonneg_left hfac (pow_nonneg (by norm_num) _)
    have h₂ :
        (2 : ℝ) ^ (2 * r) * ((2 * r).factorial : ℝ) *
            Real.exp (C : ℝ) ^ (2 * r) ≤
          (2 : ℝ) ^ (2 * r) * (2 : ℝ) ^ (4 * r * r) *
            (2 : ℝ) ^ (r * r) :=
      mul_le_mul h₁ hexpPow (pow_nonneg (Real.exp_pos _).le _)
        (mul_nonneg (pow_nonneg (by norm_num) _) (pow_nonneg (by norm_num) _))
    exact mul_le_mul h₂ htailPow (pow_nonneg hq0 _)
      (mul_nonneg
        (mul_nonneg (pow_nonneg (by norm_num) _) (pow_nonneg (by norm_num) _))
        (pow_nonneg (by norm_num) _))
  have hinvPow : (((1 : ℝ) / 64) ^ r) ^ r =
      1 / (2 : ℝ) ^ (6 * r * r) := by
    rw [← pow_mul, div_pow]
    simp only [one_pow]
    rw [show (64 : ℝ) = (2 : ℝ) ^ 6 by norm_num, ← pow_mul]
    have h₆ : 6 * (r * r) = 6 * r * r := by ring
    rw [h₆]
  have hnum :
      (2 : ℝ) ^ (2 * r) * (2 : ℝ) ^ (4 * r * r) * (2 : ℝ) ^ (r * r) =
        (2 : ℝ) ^ (2 * r + 5 * r * r) := by
    rw [← pow_add, ← pow_add]
    congr 1
    ring
  have hupperEq :
      (2 : ℝ) ^ (2 * r) * (2 : ℝ) ^ (4 * r * r) *
          (2 : ℝ) ^ (r * r) * (((1 : ℝ) / 64) ^ r) ^ r =
        (2 : ℝ) ^ (2 * r + 5 * r * r) / (2 : ℝ) ^ (6 * r * r) := by
    rw [hinvPow]
    calc
      (2 : ℝ) ^ (2 * r) * (2 : ℝ) ^ (4 * r * r) *
            (2 : ℝ) ^ (r * r) * (1 / (2 : ℝ) ^ (6 * r * r)) =
          ((2 : ℝ) ^ (2 * r) * (2 : ℝ) ^ (4 * r * r) *
            (2 : ℝ) ^ (r * r)) / (2 : ℝ) ^ (6 * r * r) := by
              simp only [div_eq_mul_inv, one_mul, mul_assoc]
      _ = (2 : ℝ) ^ (2 * r + 5 * r * r) / (2 : ℝ) ^ (6 * r * r) := by
        rw [hnum]
  have h2r_lt : 2 * r < r * r := by
    exact (Nat.mul_lt_mul_right hr0).2 hr
  have hExponentLt : 2 * r + 5 * r * r < 6 * r * r := by
    calc
      2 * r + 5 * r * r < r * r + 5 * r * r := Nat.add_lt_add_right h2r_lt _
      _ = 6 * r * r := by ring
  have hpowLt :
      (2 : ℝ) ^ (2 * r + 5 * r * r) < (2 : ℝ) ^ (6 * r * r) :=
    pow_lt_pow_right₀ (by norm_num) hExponentLt
  have hupperLt :
      (2 : ℝ) ^ (2 * r) * (2 : ℝ) ^ (4 * r * r) *
          (2 : ℝ) ^ (r * r) * (((1 : ℝ) / 64) ^ r) ^ r < 1 := by
    rw [hupperEq]
    exact (div_lt_one (pow_pos (by norm_num) _)).2 hpowLt
  refine ⟨hsmall, ?_⟩
  change (2 : ℝ) ^ (2 * r) * ((2 * r).factorial : ℝ) * Real.exp (C : ℝ) ^ r *
      (Real.exp (C : ℝ) * q) ^ (2 * r - r) < 1
  rw [htwoRsub, hrearrange]
  exact hcoarse.trans_lt hupperLt

end

end LeanProofs.IntegerExponent
