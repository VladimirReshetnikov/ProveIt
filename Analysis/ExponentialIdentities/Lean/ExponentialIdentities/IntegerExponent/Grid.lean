import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Data.Nat.Factorization.Basic
import Mathlib.Logic.Equiv.Fin.Basic
import Mathlib.NumberTheory.Real.Irrational
import Mathlib.Tactic

/-!
# The interpolation grid for the integer-exponent theorem

This file constructs the six-dimensional box used in the elementary proof of the relevant
special case of the six exponentials theorem.  The same `n ^ 6` indices are read in two ways:
as three pairs, which encode powers of `2`, `3`, and `5`, and as two triples, which encode an
affine expression `v₀ + v₁ x`.
-/

namespace LeanProofs.IntegerExponent

noncomputable section

/-- Unique factorization, specialized to the three bases used below. -/
theorem prime235Powers_injective :
    Function.Injective
      (fun u : ℕ × ℕ × ℕ ↦ 2 ^ u.1 * 3 ^ u.2.1 * 5 ^ u.2.2) := by
  rintro ⟨a, b, c⟩ ⟨a', b', c'⟩ h
  have h2 := congrArg (fun N : ℕ ↦ N.factorization 2) h
  have h3 := congrArg (fun N : ℕ ↦ N.factorization 3) h
  have h5 := congrArg (fun N : ℕ ↦ N.factorization 5) h
  have ha : a = a' := by
    simpa [Nat.factorization_mul, Nat.Prime.factorization_pow,
      Nat.prime_two, Nat.prime_three, Nat.prime_five] using h2
  have hb : b = b' := by
    simpa [Nat.factorization_mul, Nat.Prime.factorization_pow,
      Nat.prime_two, Nat.prime_three, Nat.prime_five] using h3
  have hc : c = c' := by
    simpa [Nat.factorization_mul, Nat.Prime.factorization_pow,
      Nat.prime_two, Nat.prime_three, Nat.prime_five] using h5
  simp only [ha, hb, hc]

/-- The additive progression generated by `1` and an irrational `x` has no collisions. -/
theorem Irrational.injective_nat_add_mul {x : ℝ} (hx : Irrational x) :
    Function.Injective (fun p : ℕ × ℕ ↦ (p.1 : ℝ) + (p.2 : ℝ) * x) := by
  rintro ⟨a, b⟩ ⟨c, d⟩ h
  by_cases hbd : b = d
  · subst d
    have hac : (a : ℝ) = c := by linarith
    exact Prod.ext (Nat.cast_injective hac) rfl
  · exfalso
    have hden : (b : ℤ) - (d : ℤ) ≠ 0 := by
      exact sub_ne_zero.mpr (by exact_mod_cast hbd)
    apply hx.ne_rational ((c : ℤ) - (a : ℤ)) ((b : ℤ) - (d : ℤ))
    field_simp [hden]
    push_cast
    linarith

/-- A box with `n ^ 6` elements, represented by six base-`n` digits. -/
abbrev SixBox (n : ℕ) := Fin 6 → Fin n

private def pairFin {n : ℕ} (u v : Fin n) : Fin (n * n) := finProdFinEquiv (u, v)

private def tripleFin {n : ℕ} (u v w : Fin n) : Fin ((n * n) * n) :=
  finProdFinEquiv (pairFin u v, w)

private def rowCode {n : ℕ} (i : SixBox n) : ℕ × ℕ × ℕ :=
  ((pairFin (i 0) (i 1)).val,
    (pairFin (i 2) (i 3)).val,
    (pairFin (i 4) (i 5)).val)

private def colCode {n : ℕ} (i : SixBox n) : ℕ × ℕ :=
  ((tripleFin (i 0) (i 1) (i 2)).val,
    (tripleFin (i 3) (i 4) (i 5)).val)

private theorem rowCode_injective (n : ℕ) : Function.Injective (@rowCode n) := by
  intro i j h
  have h₀₁fin : pairFin (i 0) (i 1) = pairFin (j 0) (j 1) :=
    Fin.ext (congrArg (fun t : ℕ × ℕ × ℕ ↦ t.1) h)
  have h₂₃fin : pairFin (i 2) (i 3) = pairFin (j 2) (j 3) :=
    Fin.ext (congrArg (fun t : ℕ × ℕ × ℕ ↦ t.2.1) h)
  have h₄₅fin : pairFin (i 4) (i 5) = pairFin (j 4) (j 5) :=
    Fin.ext (congrArg (fun t : ℕ × ℕ × ℕ ↦ t.2.2) h)
  have h₀₁ : (i 0, i 1) = (j 0, j 1) := by
    apply finProdFinEquiv.injective
    exact h₀₁fin
  have h₂₃ : (i 2, i 3) = (j 2, j 3) := by
    apply finProdFinEquiv.injective
    exact h₂₃fin
  have h₄₅ : (i 4, i 5) = (j 4, j 5) := by
    apply finProdFinEquiv.injective
    exact h₄₅fin
  funext k
  fin_cases k <;> simp_all

private theorem colCode_injective (n : ℕ) : Function.Injective (@colCode n) := by
  intro i j h
  have h₀₁₂fin : tripleFin (i 0) (i 1) (i 2) = tripleFin (j 0) (j 1) (j 2) :=
    Fin.ext (congrArg Prod.fst h)
  have h₃₄₅fin : tripleFin (i 3) (i 4) (i 5) = tripleFin (j 3) (j 4) (j 5) :=
    Fin.ext (congrArg Prod.snd h)
  have h₀₁₂ : (pairFin (i 0) (i 1), i 2) = (pairFin (j 0) (j 1), j 2) := by
    apply finProdFinEquiv.injective
    exact h₀₁₂fin
  have h₃₄₅ : (pairFin (i 3) (i 4), i 5) = (pairFin (j 3) (j 4), j 5) := by
    apply finProdFinEquiv.injective
    exact h₃₄₅fin
  have h₀₁ : (i 0, i 1) = (j 0, j 1) := by
    apply finProdFinEquiv.injective
    exact congrArg Prod.fst h₀₁₂
  have h₃₄ : (i 3, i 4) = (j 3, j 4) := by
    apply finProdFinEquiv.injective
    exact congrArg Prod.fst h₃₄₅
  funext k
  fin_cases k <;> simp_all

private def rowNat {n : ℕ} (i : SixBox n) : ℕ :=
  2 ^ (rowCode i).1 * 3 ^ (rowCode i).2.1 * 5 ^ (rowCode i).2.2

def rowArg {n : ℕ} (i : SixBox n) : ℝ := Real.log (rowNat i : ℝ)

def colArg {n : ℕ} (x : ℝ) (i : SixBox n) : ℝ :=
  ((colCode i).1 : ℝ) + ((colCode i).2 : ℝ) * x

private theorem rowNat_injective (n : ℕ) : Function.Injective (@rowNat n) :=
  prime235Powers_injective.comp (rowCode_injective n)

private theorem rowNat_pos {n : ℕ} (i : SixBox n) : 0 < rowNat i := by
  unfold rowNat
  positivity

theorem rowArg_injective (n : ℕ) : Function.Injective (@rowArg n) := by
  intro i j h
  apply rowNat_injective n
  have hc : (rowNat i : ℝ) = (rowNat j : ℝ) :=
    Real.log_injOn_pos
      (show 0 < (rowNat i : ℝ) by exact_mod_cast rowNat_pos i)
      (show 0 < (rowNat j : ℝ) by exact_mod_cast rowNat_pos j) h
  exact Nat.cast_injective hc

theorem colArg_injective {x : ℝ} (hx : Irrational x) (n : ℕ) :
    Function.Injective (@colArg n x) := by
  intro i j h
  apply colCode_injective n
  exact Irrational.injective_nat_add_mul hx h

theorem card_sixBox (n : ℕ) : Fintype.card (SixBox n) = n ^ 6 := by
  simp [SixBox]

/-- Integrality of `2^x`, `3^x`, and `5^x` propagates to every monomial in the bases. -/
private theorem prime235Product_rpow_integer {x : ℝ} {u₂ u₃ u₅ : ℕ}
    (h₂ : ∃ z : ℤ, (z : ℝ) = (2 : ℝ) ^ x)
    (h₃ : ∃ z : ℤ, (z : ℝ) = (3 : ℝ) ^ x)
    (h₅ : ∃ z : ℤ, (z : ℝ) = (5 : ℝ) ^ x) :
    ∃ z : ℤ, (z : ℝ) = ((2 ^ u₂ * 3 ^ u₃ * 5 ^ u₅ : ℕ) : ℝ) ^ x := by
  obtain ⟨z₂, hz₂⟩ := h₂
  obtain ⟨z₃, hz₃⟩ := h₃
  obtain ⟨z₅, hz₅⟩ := h₅
  refine ⟨z₂ ^ u₂ * z₃ ^ u₃ * z₅ ^ u₅, ?_⟩
  push_cast
  rw [Real.mul_rpow (by positivity) (by positivity),
    Real.mul_rpow (by positivity) (by positivity)]
  rw [← Real.rpow_pow_comm (by norm_num : (0 : ℝ) ≤ 2) x u₂,
    ← Real.rpow_pow_comm (by norm_num : (0 : ℝ) ≤ 3) x u₃,
    ← Real.rpow_pow_comm (by norm_num : (0 : ℝ) ≤ 5) x u₅]
  rw [← hz₂, ← hz₃, ← hz₅]

private theorem exp_log_mul_nat_add_integer {R : ℕ} (hR : 0 < R) {x : ℝ} (v₀ v₁ : ℕ)
    (hRx : ∃ z : ℤ, (z : ℝ) = (R : ℝ) ^ x) :
    ∃ z : ℤ,
      (z : ℝ) = Real.exp (Real.log (R : ℝ) * ((v₀ : ℝ) + (v₁ : ℝ) * x)) := by
  obtain ⟨z, hz⟩ := hRx
  refine ⟨(R : ℤ) ^ v₀ * z ^ v₁, ?_⟩
  push_cast
  rw [← Real.rpow_def_of_pos (by exact_mod_cast hR)]
  rw [Real.rpow_add (by exact_mod_cast hR)]
  rw [Real.rpow_natCast]
  rw [show (v₁ : ℝ) * x = x * (v₁ : ℝ) by ring]
  rw [Real.rpow_mul_natCast (by exact_mod_cast hR.le)]
  rw [← hz]

theorem nonneg_of_two_rpow_integer {x : ℝ}
    (h₂ : ∃ z : ℤ, (z : ℝ) = (2 : ℝ) ^ x) : 0 ≤ x := by
  obtain ⟨z, hz⟩ := h₂
  by_contra hx
  have hp : 0 < (2 : ℝ) ^ x := Real.rpow_pos_of_pos (by norm_num) _
  have hlt : (2 : ℝ) ^ x < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (lt_of_not_ge hx)
  have hzpos : 0 < z := by exact_mod_cast (hz.symm ▸ hp)
  have hzone : z < 1 := by exact_mod_cast (hz.symm ▸ hlt)
  omega

private theorem rowArg_nonneg {n : ℕ} (i : SixBox n) : 0 ≤ rowArg i := by
  apply Real.log_nonneg
  exact_mod_cast rowNat_pos i

private theorem rowArg_le {n : ℕ} (i : SixBox n) :
    rowArg i ≤ (n * n : ℕ) * (Real.log 2 + Real.log 3 + Real.log 5) := by
  have hu₂ : ((rowCode i).1 : ℝ) ≤ (n * n : ℕ) := by
    exact_mod_cast (pairFin (i 0) (i 1)).isLt.le
  have hu₃ : ((rowCode i).2.1 : ℝ) ≤ (n * n : ℕ) := by
    exact_mod_cast (pairFin (i 2) (i 3)).isLt.le
  have hu₅ : ((rowCode i).2.2 : ℝ) ≤ (n * n : ℕ) := by
    exact_mod_cast (pairFin (i 4) (i 5)).isLt.le
  have hlog₂ : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hlog₃ : 0 ≤ Real.log 3 := Real.log_nonneg (by norm_num)
  have hlog₅ : 0 ≤ Real.log 5 := Real.log_nonneg (by norm_num)
  have hterm₂ : ((rowCode i).1 : ℝ) * Real.log 2 ≤
      ((n * n : ℕ) : ℝ) * Real.log 2 := mul_le_mul_of_nonneg_right hu₂ hlog₂
  have hterm₃ : ((rowCode i).2.1 : ℝ) * Real.log 3 ≤
      ((n * n : ℕ) : ℝ) * Real.log 3 := mul_le_mul_of_nonneg_right hu₃ hlog₃
  have hterm₅ : ((rowCode i).2.2 : ℝ) * Real.log 5 ≤
      ((n * n : ℕ) : ℝ) * Real.log 5 := mul_le_mul_of_nonneg_right hu₅ hlog₅
  have hexpand : rowArg i =
      ((rowCode i).1 : ℝ) * Real.log 2 +
      ((rowCode i).2.1 : ℝ) * Real.log 3 +
      ((rowCode i).2.2 : ℝ) * Real.log 5 := by
    simp only [rowArg, rowNat, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat]
    rw [Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by positivity) (by positivity),
      Real.log_pow, Real.log_pow, Real.log_pow]
  rw [hexpand]
  linarith

private theorem colArg_nonneg {n : ℕ} {x : ℝ} (hx : 0 ≤ x) (i : SixBox n) :
    0 ≤ colArg x i := by
  dsimp only [colArg]
  positivity

private theorem colArg_le {n : ℕ} {x : ℝ} (hx : 0 ≤ x) (i : SixBox n) :
    colArg x i ≤ ((n * n) * n : ℕ) * (1 + x) := by
  have hv₀ : ((colCode i).1 : ℝ) ≤ ((n * n) * n : ℕ) := by
    exact_mod_cast (tripleFin (i 0) (i 1) (i 2)).isLt.le
  have hv₁ : ((colCode i).2 : ℝ) ≤ ((n * n) * n : ℕ) := by
    exact_mod_cast (tripleFin (i 3) (i 4) (i 5)).isLt.le
  have hv₁x : ((colCode i).2 : ℝ) * x ≤
      (((n * n) * n : ℕ) : ℝ) * x := mul_le_mul_of_nonneg_right hv₁ hx
  dsimp only [colArg]
  linarith

/-- Uniformly bound every argument of the exponential kernel by the natural `D * n ^ 5`. -/
theorem abs_rowArg_mul_colArg_le {n D : ℕ} {x : ℝ} (hx : 0 ≤ x)
    (hD : (Real.log 2 + Real.log 3 + Real.log 5) * (1 + x) ≤ D)
    (i j : SixBox n) :
    |rowArg i * colArg x j| ≤ (D * n ^ 5 : ℕ) := by
  have ha0 := rowArg_nonneg i
  have hb0 := colArg_nonneg hx j
  have ha := rowArg_le i
  have hb := colArg_le hx j
  rw [abs_of_nonneg (mul_nonneg ha0 hb0)]
  calc
    rowArg i * colArg x j ≤
        ((n * n : ℕ) : ℝ) * (Real.log 2 + Real.log 3 + Real.log 5) *
          (((n * n) * n : ℕ) * (1 + x)) :=
      mul_le_mul ha hb (colArg_nonneg hx j)
        (mul_nonneg (Nat.cast_nonneg _) (by positivity))
    _ = ((n ^ 5 : ℕ) : ℝ) *
        ((Real.log 2 + Real.log 3 + Real.log 5) * (1 + x)) := by
      push_cast
      ring
    _ ≤ ((n ^ 5 : ℕ) : ℝ) * D :=
      mul_le_mul_of_nonneg_left hD (Nat.cast_nonneg _)
    _ = (D * n ^ 5 : ℕ) := by
      push_cast
      ring

/-- Every entry of the interpolation determinant is an integer. -/
theorem exp_rowArg_mul_colArg_integer {n : ℕ} {x : ℝ}
    (h₂ : ∃ z : ℤ, (z : ℝ) = (2 : ℝ) ^ x)
    (h₃ : ∃ z : ℤ, (z : ℝ) = (3 : ℝ) ^ x)
    (h₅ : ∃ z : ℤ, (z : ℝ) = (5 : ℝ) ^ x)
    (i j : SixBox n) :
    ∃ z : ℤ, (z : ℝ) = Real.exp (rowArg i * colArg x j) := by
  have hR : ∃ z : ℤ, (z : ℝ) = (rowNat i : ℝ) ^ x := by
    simpa only [rowNat] using
      (prime235Product_rpow_integer (x := x)
        (u₂ := (rowCode i).1) (u₃ := (rowCode i).2.1) (u₅ := (rowCode i).2.2)
        h₂ h₃ h₅)
  simpa only [rowArg, colArg] using
    (exp_log_mul_nat_add_integer (R := rowNat i) (rowNat_pos i)
      (colCode j).1 (colCode j).2 hR)

end

end LeanProofs.IntegerExponent
