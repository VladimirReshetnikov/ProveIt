import ExponentialIdentities.TwoBaseIntegerExponent.PrimitiveGenerator
import Mathlib.Order.Interval.Set.Nat

namespace LeanProofs.TwoBaseIntegerExponent

open Set

noncomputable section

/-- The canonical member of the affine monoid `ℕ + ℕ β` in the unit block
`[N, N + 1)` with second coordinate `k`. -/
def primitiveUnitBlockParameter (β : ℝ) (N k : ℕ) : ℝ :=
  (⌈(N : ℝ) - (k : ℝ) * β⌉₊ : ℝ) + (k : ℝ) * β

/-- Nonintegral two-base solutions in the half-open unit block `[N, N + 1)`. -/
def twoBaseNonintegerSolutionsInUnitBlock (N : ℕ) : Set ℝ :=
  {x | TwoBaseNonintegerSolution x ∧
    (N : ℝ) ≤ x ∧ x < (N + 1 : ℕ)}

/-- Exact parametrization of the nonintegral solutions in a unit block, assuming the
solution set is the free affine monoid generated by `1` and an irrational positive `β`. -/
theorem twoBaseNonintegerSolutionsInUnitBlock_eq_image
    {β : ℝ} (hβpos : 0 < β) (hβirr : Irrational β)
    (hchar : ∀ x : ℝ, TwoBaseIntegralSolution x ↔
      ∃ n k : ℕ, x = (n : ℝ) + (k : ℝ) * β)
    (N : ℕ) :
    twoBaseNonintegerSolutionsInUnitBlock N =
      primitiveUnitBlockParameter β N ''
        Set.Icc 1 ⌊((N : ℝ) + 1) / β⌋₊ := by
  classical
  apply Set.ext
  intro x
  constructor
  · rintro ⟨⟨hxsol, hxnon⟩, hxlo, hxhi⟩
    obtain ⟨n, k, hx⟩ := (hchar x).mp hxsol
    have hk : 0 < k := by
      rcases k.eq_zero_or_pos with rfl | hk
      · have hmem : x ∈ Set.range ((↑) : ℤ → ℝ) := by
          refine ⟨(n : ℤ), ?_⟩
          push_cast
          simpa using hx.symm
        exact (hxnon hmem).elim
      · exact hk
    have hkβlt : (k : ℝ) * β < (N : ℝ) + 1 := by
      have hn0 : (0 : ℝ) ≤ n := by positivity
      rw [hx] at hxhi
      norm_num at hxhi ⊢
      linarith
    have hq0 : 0 ≤ ((N : ℝ) + 1) / β := by positivity
    have hkfloor : k ≤ ⌊((N : ℝ) + 1) / β⌋₊ := by
      apply Nat.le_floor
      apply (le_div_iff₀ hβpos).2
      exact hkβlt.le
    have hceil : ⌈(N : ℝ) - (k : ℝ) * β⌉₊ = n := by
      rcases n.eq_zero_or_pos with rfl | hn
      · apply Nat.eq_zero_of_le_zero
        rw [Nat.ceil_le]
        rw [hx] at hxlo
        norm_num at hxlo ⊢
        linarith
      · apply (Nat.ceil_eq_iff hn.ne').2
        constructor
        · have hnsub : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
            rw [Nat.cast_sub (by omega)]
            norm_num
          rw [hnsub]
          rw [hx] at hxhi
          norm_num at hxhi ⊢
          linarith
        · rw [hx] at hxlo
          norm_num at hxlo ⊢
          linarith
    refine ⟨k, ⟨by omega, hkfloor⟩, ?_⟩
    rw [primitiveUnitBlockParameter, hceil, hx]
  · rintro ⟨k, ⟨hk1, hkfloor⟩, rfl⟩
    have hk : 0 < k := by omega
    have hq0 : 0 ≤ ((N : ℝ) + 1) / β := by positivity
    have hkq : (k : ℝ) ≤ ((N : ℝ) + 1) / β :=
      (Nat.le_floor_iff hq0).mp hkfloor
    have hkβle : (k : ℝ) * β ≤ (N : ℝ) + 1 :=
      (le_div_iff₀ hβpos).mp hkq
    have hkβne : (k : ℝ) * β ≠ (N : ℝ) + 1 := by
      have hirr : Irrational ((k : ℝ) * β) := hβirr.natCast_mul hk.ne'
      simpa only [Nat.cast_add, Nat.cast_one] using hirr.ne_nat (N + 1)
    have hkβlt : (k : ℝ) * β < (N : ℝ) + 1 :=
      lt_of_le_of_ne hkβle hkβne
    have harg : -1 < (N : ℝ) - (k : ℝ) * β := by linarith
    have hsol : TwoBaseIntegralSolution (primitiveUnitBlockParameter β N k) := by
      apply (hchar _).mpr
      exact ⟨⌈(N : ℝ) - (k : ℝ) * β⌉₊, k, rfl⟩
    have hirr : Irrational (primitiveUnitBlockParameter β N k) := by
      exact (hβirr.natCast_mul hk.ne').natCast_add
        ⌈(N : ℝ) - (k : ℝ) * β⌉₊
    have hnon : primitiveUnitBlockParameter β N k ∉
        Set.range ((↑) : ℤ → ℝ) := by
      rintro ⟨z, hz⟩
      exact hirr.ne_int z hz.symm
    refine ⟨⟨hsol, hnon⟩, ?_, ?_⟩
    · have hle := Nat.le_ceil ((N : ℝ) - (k : ℝ) * β)
      rw [primitiveUnitBlockParameter]
      norm_num at hle ⊢
      linarith
    · have hlt := Nat.ceil_lt_add_one_of_gt_neg_one harg
      rw [primitiveUnitBlockParameter]
      norm_num at hlt ⊢
      linarith

/-- The exact number of nonintegral solutions in `[N, N + 1)`. -/
theorem twoBaseNonintegerSolutionsInUnitBlock_ncard
    {β : ℝ} (hβpos : 0 < β) (hβirr : Irrational β)
    (hchar : ∀ x : ℝ, TwoBaseIntegralSolution x ↔
      ∃ n k : ℕ, x = (n : ℝ) + (k : ℝ) * β)
    (N : ℕ) :
    (twoBaseNonintegerSolutionsInUnitBlock N).ncard =
      ⌊((N : ℝ) + 1) / β⌋₊ := by
  rw [twoBaseNonintegerSolutionsInUnitBlock_eq_image hβpos hβirr hchar]
  rw [Set.ncard_image_of_injective _]
  · simp
  · intro k l hkl
    have hpairs :
        (⌈(N : ℝ) - (k : ℝ) * β⌉₊, k) =
          (⌈(N : ℝ) - (l : ℝ) * β⌉₊, l) := by
      apply IntegerExponent.Irrational.injective_nat_add_mul hβirr
      simpa only [primitiveUnitBlockParameter] using hkl
    exact congrArg Prod.snd hpairs

/-- All two-base solutions in the half-open unit block `[N, N + 1)`. -/
def twoBaseIntegralSolutionsInUnitBlock (N : ℕ) : Set ℝ :=
  {x | TwoBaseIntegralSolution x ∧
    (N : ℝ) ≤ x ∧ x < (N + 1 : ℕ)}

/-- A unit block consists of its one integral solution `N` and its nonintegral solutions. -/
theorem twoBaseIntegralSolutionsInUnitBlock_eq_insert
    {β : ℝ}
    (hchar : ∀ x : ℝ, TwoBaseIntegralSolution x ↔
      ∃ n k : ℕ, x = (n : ℝ) + (k : ℝ) * β)
    (N : ℕ) :
    twoBaseIntegralSolutionsInUnitBlock N =
      insert (N : ℝ) (twoBaseNonintegerSolutionsInUnitBlock N) := by
  apply Set.ext
  intro x
  constructor
  · rintro ⟨hxsol, hxlo, hxhi⟩
    by_cases hxint : x ∈ Set.range ((↑) : ℤ → ℝ)
    · left
      obtain ⟨z, hz⟩ := hxint
      have hzlo : (N : ℤ) ≤ z := by
        exact_mod_cast hxlo.trans_eq hz.symm
      have hzhi : z < ((N + 1 : ℕ) : ℤ) := by
        have hzhiR : (z : ℝ) < ((N + 1 : ℕ) : ℝ) := hz.trans_lt hxhi
        exact_mod_cast hzhiR
      have hzN : z = (N : ℤ) := by omega
      exact hz.symm.trans (by exact_mod_cast hzN)
    · right
      exact ⟨⟨hxsol, hxint⟩, hxlo, hxhi⟩
  · rintro (rfl | hx)
    · refine ⟨(hchar _).mpr ⟨N, 0, by simp⟩, le_rfl, ?_⟩
      norm_num
    · exact ⟨hx.1.1, hx.2.1, hx.2.2⟩

/-- The exact total number of solutions in `[N, N + 1)`, including the integer `N`. -/
theorem twoBaseIntegralSolutionsInUnitBlock_ncard
    {β : ℝ} (hβpos : 0 < β) (hβirr : Irrational β)
    (hchar : ∀ x : ℝ, TwoBaseIntegralSolution x ↔
      ∃ n k : ℕ, x = (n : ℝ) + (k : ℝ) * β)
    (N : ℕ) :
    (twoBaseIntegralSolutionsInUnitBlock N).ncard =
      1 + ⌊((N : ℝ) + 1) / β⌋₊ := by
  rw [twoBaseIntegralSolutionsInUnitBlock_eq_insert hchar]
  have hnot : (N : ℝ) ∉ twoBaseNonintegerSolutionsInUnitBlock N := by
    rintro ⟨⟨_, hnon⟩, _⟩
    apply hnon
    exact ⟨(N : ℤ), by norm_num⟩
  have hfinite : (twoBaseNonintegerSolutionsInUnitBlock N).Finite := by
    rw [twoBaseNonintegerSolutionsInUnitBlock_eq_image hβpos hβirr hchar]
    exact (Set.finite_Icc 1 _).image _
  rw [Set.ncard_insert_of_notMem hnot hfinite,
    twoBaseNonintegerSolutionsInUnitBlock_ncard hβpos hβirr hchar]
  omega

/-- Passing between a positive candidate `m` and its exponent `logb 2 m` identifies the
dyadic candidate block with the corresponding unit block of real solutions. -/
theorem twoBaseNaturalCandidatesInDyadicBlock_card_eq_solution_ncard (N : ℕ) :
    (twoBaseNaturalCandidatesInDyadicBlock N).card =
      (twoBaseIntegralSolutionsInUnitBlock N).ncard := by
  classical
  let f : ℕ → ℝ := twoBaseCandidateExponent
  have hmono : StrictMono (fun x : ℝ ↦ (2 : ℝ) ^ x) :=
    Real.strictMono_rpow_of_base_gt_one (by norm_num)
  have hcount := Set.ncard_congr
    (s := (↑(twoBaseNaturalCandidatesInDyadicBlock N) : Set ℕ))
    (t := twoBaseIntegralSolutionsInUnitBlock N) (fun m _hm ↦ f m)
    (fun m hm ↦ by
      have hm' : (2 ^ N ≤ m ∧ m < 2 ^ (N + 1)) ∧
          TwoBaseNaturalCandidate m := by
        simpa only [twoBaseNaturalCandidatesInDyadicBlock, Finset.mem_coe,
          Finset.mem_filter, Finset.mem_Ico] using hm
      refine ⟨hm'.2.integer_powers, ?_, ?_⟩
      · apply hmono.le_iff_le.mp
        rw [Real.rpow_natCast, two_rpow_twoBaseCandidateExponent hm'.2.1]
        exact_mod_cast hm'.1.1
      · apply hmono.lt_iff_lt.mp
        rw [Real.rpow_natCast, two_rpow_twoBaseCandidateExponent hm'.2.1]
        exact_mod_cast hm'.1.2)
    (fun m n hm hn hmn ↦ by
      have hm' : (2 ^ N ≤ m ∧ m < 2 ^ (N + 1)) ∧
          TwoBaseNaturalCandidate m := by
        simpa only [twoBaseNaturalCandidatesInDyadicBlock, Finset.mem_coe,
          Finset.mem_filter, Finset.mem_Ico] using hm
      have hn' : (2 ^ N ≤ n ∧ n < 2 ^ (N + 1)) ∧
          TwoBaseNaturalCandidate n := by
        simpa only [twoBaseNaturalCandidatesInDyadicBlock, Finset.mem_coe,
          Finset.mem_filter, Finset.mem_Ico] using hn
      have hmpos : 0 < m := by
        exact hm'.2.1
      have hnpos : 0 < n := by
        exact hn'.2.1
      have hmn' : twoBaseCandidateExponent m = twoBaseCandidateExponent n := by
        simpa only [f] using hmn
      have hcast : (m : ℝ) = n := by
        rw [← two_rpow_twoBaseCandidateExponent hmpos,
          ← two_rpow_twoBaseCandidateExponent hnpos, hmn']
      exact_mod_cast hcast)
    (fun x hx ↦ by
      obtain ⟨m, hmpos, hm, hxm⟩ :=
        exists_twoBaseNaturalCandidate_of_two_three_rpow_integer hx.1.1 hx.1.2
      have hmloR : ((2 ^ N : ℕ) : ℝ) ≤ m := by
        push_cast
        rw [← Real.rpow_natCast, ← two_rpow_twoBaseCandidateExponent hmpos]
        exact hmono.le_iff_le.mpr (hx.2.1.trans_eq hxm)
      have hmhiR : (m : ℝ) < ((2 ^ (N + 1) : ℕ) : ℝ) := by
        push_cast
        rw [← Real.rpow_natCast, ← two_rpow_twoBaseCandidateExponent hmpos]
        exact hmono.lt_iff_lt.mpr (hxm.symm.trans_lt hx.2.2)
      refine ⟨m, ?_, hxm.symm⟩
      simpa only [twoBaseNaturalCandidatesInDyadicBlock, Finset.mem_coe,
        Finset.mem_filter, Finset.mem_Ico] using
          And.intro (And.intro (by exact_mod_cast hmloR) (by exact_mod_cast hmhiR)) hm)
  simpa only [Set.ncard_coe_finset] using hcount

/-- The dyadic-block form of the exact unit-block count. -/
theorem twoBaseNaturalCandidatesInDyadicBlock_card
    {β : ℝ} (hβpos : 0 < β) (hβirr : Irrational β)
    (hchar : ∀ x : ℝ, TwoBaseIntegralSolution x ↔
      ∃ n k : ℕ, x = (n : ℝ) + (k : ℝ) * β)
    (N : ℕ) :
    (twoBaseNaturalCandidatesInDyadicBlock N).card =
      1 + ⌊((N : ℝ) + 1) / β⌋₊ := by
  rw [twoBaseNaturalCandidatesInDyadicBlock_card_eq_solution_ncard,
    twoBaseIntegralSolutionsInUnitBlock_ncard hβpos hβirr hchar]

/-- Candidate count accumulated over the first `T` dyadic blocks. -/
def cumulativeTwoBaseCandidateCount (T : ℕ) : ℕ :=
  ∑ N ∈ Finset.range T, (twoBaseNaturalCandidatesInDyadicBlock N).card

/-- Exact cumulative version of the block formula.  The summand indexed by `N` is the
report's `floor ((N + 1) / β)`. -/
theorem cumulativeTwoBaseCandidateCount_eq
    {β : ℝ} (hβpos : 0 < β) (hβirr : Irrational β)
    (hchar : ∀ x : ℝ, TwoBaseIntegralSolution x ↔
      ∃ n k : ℕ, x = (n : ℝ) + (k : ℝ) * β)
    (T : ℕ) :
    cumulativeTwoBaseCandidateCount T =
      T + ∑ N ∈ Finset.range T, ⌊((N : ℝ) + 1) / β⌋₊ := by
  simp only [cumulativeTwoBaseCandidateCount,
    twoBaseNaturalCandidatesInDyadicBlock_card hβpos hβirr hchar,
    Finset.sum_add_distrib]
  simp

/-- Conditional on failure of the conjecture, the canonical primitive generator realizes
the explicit parametrization, both exact block counts, and their exact cumulative sum. -/
theorem exists_primitiveGenerator_with_exact_counting
    (hfail : ¬ AlaogluErdosConjecture) :
    ∃ β : ℝ,
      Irrational β ∧ IsLeastTwoBaseNonintegerSolution β ∧
      (∀ x : ℝ, TwoBaseIntegralSolution x ↔
        ∃! nk : ℕ × ℕ, x = (nk.1 : ℝ) + (nk.2 : ℝ) * β) ∧
      (∀ N : ℕ, twoBaseNonintegerSolutionsInUnitBlock N =
        primitiveUnitBlockParameter β N ''
          Set.Icc 1 ⌊((N : ℝ) + 1) / β⌋₊) ∧
      (∀ N : ℕ, (twoBaseNonintegerSolutionsInUnitBlock N).ncard =
        ⌊((N : ℝ) + 1) / β⌋₊) ∧
      (∀ N : ℕ, (twoBaseNaturalCandidatesInDyadicBlock N).card =
        1 + ⌊((N : ℝ) + 1) / β⌋₊) ∧
      ∀ T : ℕ, cumulativeTwoBaseCandidateCount T =
        T + ∑ N ∈ Finset.range T, ⌊((N : ℝ) + 1) / β⌋₊ := by
  classical
  obtain ⟨w, d, a, c, β, _, _, _, _, _, _, _, _, _, _, _, _,
      hβirr, hβleast, hunique, _⟩ :=
    exists_canonical_primitiveGenerator_of_not_alaogluErdosConjecture hfail
  have hβpos : 0 < β := hβleast.pos
  have hinj : Function.Injective
      (fun nk : ℕ × ℕ ↦ (nk.1 : ℝ) + (nk.2 : ℝ) * β) :=
    IntegerExponent.Irrational.injective_nat_add_mul hβirr
  have hchar : ∀ x : ℝ, TwoBaseIntegralSolution x ↔
      ∃ n k : ℕ, x = (n : ℝ) + (k : ℝ) * β := by
    intro x
    constructor
    · intro hx
      obtain ⟨nk, hnk, _⟩ := (hunique x).mp hx
      exact ⟨nk.1, nk.2, hnk⟩
    · rintro ⟨n, k, hnk⟩
      apply (hunique x).mpr
      refine ⟨(n, k), hnk, ?_⟩
      intro nk hnk'
      apply hinj
      exact hnk'.symm.trans hnk
  exact ⟨β, hβirr, hβleast, hunique,
    fun N ↦ twoBaseNonintegerSolutionsInUnitBlock_eq_image hβpos hβirr hchar N,
    fun N ↦ twoBaseNonintegerSolutionsInUnitBlock_ncard hβpos hβirr hchar N,
    fun N ↦ twoBaseNaturalCandidatesInDyadicBlock_card hβpos hβirr hchar N,
    fun T ↦ cumulativeTwoBaseCandidateCount_eq hβpos hβirr hchar T⟩

end

end LeanProofs.TwoBaseIntegerExponent
