/-- The tiered pair of integer power comparisons for the certificate `(m, a)`. -/
private def tieredCheck8192 (t m a : ℕ) : Bool :=
  match t with
  | 0 => decide (a ^ 665 < m ^ 1054) && decide (m ^ 24727 < (a + 1) ^ 15601)
  | 1 => decide (a ^ 16266 < m ^ 25781) && decide (m ^ 24727 < (a + 1) ^ 15601)
  | 2 => decide (a ^ 31867 < m ^ 50508) && decide (m ^ 24727 < (a + 1) ^ 15601)
  | 3 => decide (a ^ 111202 < m ^ 176251) && decide (m ^ 24727 < (a + 1) ^ 15601)
  | 4 => decide (a ^ 665 < m ^ 1054) && decide (m ^ 125743 < (a + 1) ^ 79335)
  | 5 => decide (a ^ 301739 < m ^ 478245) && decide (m ^ 24727 < (a + 1) ^ 15601)
  | 6 => decide (a ^ 665 < m ^ 1054) && decide (m ^ 301994 < (a + 1) ^ 190537)
  | 7 => decide (a ^ 16266 < m ^ 25781) && decide (m ^ 125743 < (a + 1) ^ 79335)
  | 8 => decide (a ^ 16266 < m ^ 25781) && decide (m ^ 301994 < (a + 1) ^ 190537)
  | _ + 9 => false

/-- Row check: index `i` corresponds to `m = 4096 + i`; the power of two `4096` is exempt. -/
private def certOne8192 (i a t : ℕ) : Bool :=
  (i == 0) || (decide (0 < a) && tieredCheck8192 t (4096 + i) a)

/-- Sequential check of all rows starting at index `i`. -/
private def checkFrom8192 : ℕ → List (ℕ × ℕ) → Bool
  | _, [] => true
  | i, (a, t) :: rest => certOne8192 i a t && checkFrom8192 (i + 1) rest

set_option maxRecDepth 200000 in
set_option maxHeartbeats 80000000 in
set_option exponentiation.threshold 490000 in
private theorem certTable8192_all : checkFrom8192 0 certTable8192 = true := by decide

set_option maxRecDepth 200000 in
private theorem certTable8192_length : certTable8192.length = 4096 := by decide

private theorem checkFrom8192_spec {rows : List (ℕ × ℕ)} {i0 : ℕ}
    (h : checkFrom8192 i0 rows = true) :
    ∀ j, j < rows.length →
      certOne8192 (i0 + j) (rows.getD j (0, 0)).1 (rows.getD j (0, 0)).2 = true := by
  induction rows generalizing i0 with
  | nil =>
    intro j hj
    simp at hj
  | cons head tail ih =>
    intro j hj
    obtain ⟨a, t⟩ := head
    simp only [checkFrom8192, Bool.and_eq_true] at h
    cases j with
    | zero => simpa using h.1
    | succ j' =>
      have htail := ih h.2 j' (Nat.lt_of_succ_lt_succ (by simpa using hj))
      have harith : i0 + (j' + 1) = i0 + 1 + j' := by omega
      simpa [List.getD_cons_succ, harith] using htail

private theorem certOne8192_spec {i a t : ℕ} (h : certOne8192 i a t = true) :
    i = 0 ∨ (0 < a ∧ tieredCheck8192 t (4096 + i) a = true) := by
  simp only [certOne8192, Bool.or_eq_true, beq_iff_eq, Bool.and_eq_true,
    decide_eq_true_eq] at h
  tauto

private theorem tieredCheck8192_spec {t m a : ℕ} (h : tieredCheck8192 t m a = true) :
    (a ^ 665 < m ^ 1054 ∧ m ^ 24727 < (a + 1) ^ 15601) ∨
    (a ^ 16266 < m ^ 25781 ∧ m ^ 24727 < (a + 1) ^ 15601) ∨
    (a ^ 31867 < m ^ 50508 ∧ m ^ 24727 < (a + 1) ^ 15601) ∨
    (a ^ 111202 < m ^ 176251 ∧ m ^ 24727 < (a + 1) ^ 15601) ∨
    (a ^ 665 < m ^ 1054 ∧ m ^ 125743 < (a + 1) ^ 79335) ∨
    (a ^ 301739 < m ^ 478245 ∧ m ^ 24727 < (a + 1) ^ 15601) ∨
    (a ^ 665 < m ^ 1054 ∧ m ^ 301994 < (a + 1) ^ 190537) ∨
    (a ^ 16266 < m ^ 25781 ∧ m ^ 125743 < (a + 1) ^ 79335) ∨
    (a ^ 16266 < m ^ 25781 ∧ m ^ 301994 < (a + 1) ^ 190537) := by
  match t with
  | 0 =>
    simp only [tieredCheck8192, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inl h
  | 1 =>
    simp only [tieredCheck8192, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inl h)
  | 2 =>
    simp only [tieredCheck8192, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inl h))
  | 3 =>
    simp only [tieredCheck8192, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  | 4 =>
    simp only [tieredCheck8192, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))
  | 5 =>
    simp only [tieredCheck8192, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  | 6 =>
    simp only [tieredCheck8192, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))
  | 7 =>
    simp only [tieredCheck8192, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
  | 8 =>
    simp only [tieredCheck8192, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (h))))))))
  | _ + 9 =>
    simp [tieredCheck8192] at h

