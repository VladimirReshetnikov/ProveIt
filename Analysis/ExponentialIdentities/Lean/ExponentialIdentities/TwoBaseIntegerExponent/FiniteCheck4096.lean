/-- The tiered pair of integer power comparisons for the certificate `(m, a)`. -/
private def tieredCheck4096 (t m a : ℕ) : Bool :=
  match t with
  | 0 => decide (a ^ 359 < m ^ 569) && decide (m ^ 485 < (a + 1) ^ 306)
  | 1 => decide (a ^ 665 < m ^ 1054) && decide (m ^ 1539 < (a + 1) ^ 971)
  | 2 => decide (a ^ 16266 < m ^ 25781) && decide (m ^ 24727 < (a + 1) ^ 15601)
  | 3 => decide (a ^ 31867 < m ^ 50508) && decide (m ^ 125743 < (a + 1) ^ 79335)
  | 4 => decide (a ^ 111202 < m ^ 176251) && decide (m ^ 301994 < (a + 1) ^ 190537)
  | _ + 5 => false

/-- Row check: index `i` corresponds to `m = 256 + i`; the four powers of two in the range
are exempt, and every other row must carry a positive floor and a valid tiered
certificate. -/
private def certOne4096 (i a t : ℕ) : Bool :=
  (i == 0) || (i == 256) || (i == 768) || (i == 1792) ||
    (decide (0 < a) && tieredCheck4096 t (256 + i) a)

/-- Sequential check of all rows starting at index `i`. -/
private def checkFrom4096 : ℕ → List (ℕ × ℕ) → Bool
  | _, [] => true
  | i, (a, t) :: rest => certOne4096 i a t && checkFrom4096 (i + 1) rest

set_option maxRecDepth 200000 in
