/-! ### From certificates to the analytic contradiction -/

private theorem mul_log_lt_mul_log_of_pow_lt4096
    {a b p q : ℕ} (ha : 0 < a) (hb : 0 < b) (hpow : a ^ p < b ^ q) :
    (p : ℝ) * Real.log (a : ℝ) < (q : ℝ) * Real.log (b : ℝ) := by
  have hpowR : (a : ℝ) ^ p < (b : ℝ) ^ q := by exact_mod_cast hpow
  have hlog := Real.strictMonoOn_log
    (by simpa only [Set.mem_Ioi] using (show 0 < (a : ℝ) ^ p by positivity))
    (by simpa only [Set.mem_Ioi] using (show 0 < (b : ℝ) ^ q by positivity)) hpowR
  simpa only [Real.log_pow] using hlog

private theorem no_integer_between_consecutive_naturals4096
    {y : ℝ} {a : ℕ}
    (hy : y ∈ Set.range ((↑) : ℤ → ℝ))
    (hlow : (a : ℝ) < y) (hupp : y < (a + 1 : ℕ)) : False := by
  obtain ⟨z, rfl⟩ := hy
  have hzlow : (a : ℤ) < z := by exact_mod_cast hlow
  have hzupp : z < (a : ℤ) + 1 := by exact_mod_cast hupp
  omega

/-- A generic rational enclosure of `log 3 / log 2`, together with a matching local
enclosure of `m`'s power, traps `3 ^ x` between consecutive integers. -/
private theorem cert_contradiction4096
    {x : ℝ} {m a lowerNum lowerDen upperNum upperDen : ℕ}
    (h₂ : (2 : ℝ) ^ x = (m : ℝ))
    (h₃ : (3 : ℝ) ^ x ∈ Set.range ((↑) : ℤ → ℝ))
    (ha : 0 < a) (hmpos : 0 < m) (hxnonneg : 0 ≤ x)
    (hlowerDenPos : 0 < lowerDen) (hupperDenPos : 0 < upperDen)
    (hlowerBase : 2 ^ lowerNum < 3 ^ lowerDen)
    (hupperBase : 3 ^ upperDen < 2 ^ upperNum)
    (hmLower : a ^ lowerDen < m ^ lowerNum)
    (hmUpper : m ^ upperNum < (a + 1) ^ upperDen) : False := by
  have hlogm := congrArg Real.log h₂
  rw [Real.log_rpow (by norm_num : (0 : ℝ) < 2)] at hlogm
  have hcommonLower :
      (lowerNum : ℝ) * Real.log 2 < lowerDen * Real.log 3 :=
    mul_log_lt_mul_log_of_pow_lt4096 (by norm_num) (by norm_num) hlowerBase
  have hcommonUpper :
      (upperDen : ℝ) * Real.log 3 < upperNum * Real.log 2 :=
    mul_log_lt_mul_log_of_pow_lt4096 (by norm_num) (by norm_num) hupperBase
  have hmLowerLog :
      (lowerDen : ℝ) * Real.log a < lowerNum * Real.log m :=
    mul_log_lt_mul_log_of_pow_lt4096 ha hmpos hmLower
  have hmUpperLog :
      (upperNum : ℝ) * Real.log m < upperDen * Real.log ((a + 1 : ℕ) : ℝ) :=
    mul_log_lt_mul_log_of_pow_lt4096 hmpos (by omega) hmUpper
  have hlowerDenPosR : (0 : ℝ) < lowerDen := by exact_mod_cast hlowerDenPos
  have hupperDenPosR : (0 : ℝ) < upperDen := by exact_mod_cast hupperDenPos
  have hLowerLog : Real.log a < x * Real.log 3 := by
    apply lt_of_mul_lt_mul_left _ hlowerDenPosR.le
    calc
      (lowerDen : ℝ) * Real.log a < lowerNum * Real.log m := hmLowerLog
      _ = x * (lowerNum * Real.log 2) := by rw [← hlogm]; ring
      _ ≤ x * (lowerDen * Real.log 3) := mul_le_mul_of_nonneg_left hcommonLower.le hxnonneg
      _ = lowerDen * (x * Real.log 3) := by ring
  have hUpperLog : x * Real.log 3 < Real.log ((a + 1 : ℕ) : ℝ) := by
    apply lt_of_mul_lt_mul_left _ hupperDenPosR.le
    calc
      (upperDen : ℝ) * (x * Real.log 3) = x * (upperDen * Real.log 3) := by ring
      _ ≤ x * (upperNum * Real.log 2) := mul_le_mul_of_nonneg_left hcommonUpper.le hxnonneg
      _ = upperNum * Real.log m := by rw [← hlogm]; ring
      _ < upperDen * Real.log ((a + 1 : ℕ) : ℝ) := hmUpperLog
  have hLower : (a : ℝ) < (3 : ℝ) ^ x := by
    rw [Real.lt_rpow_iff_log_lt (by positivity) (by norm_num : (0 : ℝ) < 3)]
    exact hLowerLog
  have hUpper : (3 : ℝ) ^ x < (a + 1 : ℕ) := by
    rw [Real.rpow_lt_iff_lt_log (by norm_num : (0 : ℝ) < 3) (by positivity)]
    exact hUpperLog
  exact no_integer_between_consecutive_naturals4096 h₃ hLower hUpper

/-- If `2 ^ x` equals a natural power of two, then `x` is that natural number. -/
private theorem integer_of_two_rpow_eq_pow_two {x : ℝ} {m k : ℕ}
    (hm : m = 2 ^ k) (hpowm : (2 : ℝ) ^ x = (m : ℝ)) :
    x ∈ Set.range ((↑) : ℤ → ℝ) := by
  refine ⟨k, ?_⟩
  have hx : x = (k : ℝ) := by
    apply (Real.strictMono_rpow_of_base_gt_one (by norm_num : (1 : ℝ) < 2)).injective
    show (2 : ℝ) ^ x = (2 : ℝ) ^ (k : ℝ)
    rw [hpowm, hm, Real.rpow_natCast]
    push_cast
    ring
  rw [hx]
  push_cast
  ring

/-- If both powers are integral and `2 ^ x < 4096`, then `x` is an integer. -/
theorem integer_of_two_three_rpow_integer_of_two_rpow_lt_4096 {x : ℝ}
    (h₂ : (2 : ℝ) ^ x ∈ Set.range ((↑) : ℤ → ℝ))
    (h₃ : (3 : ℝ) ^ x ∈ Set.range ((↑) : ℤ → ℝ))
    (hlt : (2 : ℝ) ^ x < 4096) :
    x ∈ Set.range ((↑) : ℤ → ℝ) := by
  by_cases hsmall : (2 : ℝ) ^ x < 256
  · exact integer_of_two_three_rpow_integer_of_two_rpow_lt_256 h₂ h₃ hsmall
  obtain ⟨z, hz⟩ := h₂
  have hp : 0 < (2 : ℝ) ^ x := Real.rpow_pos_of_pos (by norm_num) _
  have hzpos : 0 < z := by exact_mod_cast (hz.symm ▸ hp)
  have hzloR : (256 : ℝ) ≤ (z : ℝ) := by
    calc
      (256 : ℝ) ≤ 2 ^ x := not_lt.mp hsmall
      _ = (z : ℝ) := hz.symm
  have hzlo : 256 ≤ z := by exact_mod_cast hzloR
  have hzhi : z < 4096 := by exact_mod_cast (hz.symm ▸ hlt)
  have hxnonneg : 0 ≤ x := IntegerExponent.nonneg_of_two_rpow_integer ⟨z, hz⟩
  lift z to ℕ using hzpos.le with m hmcast
  have hmlo : 256 ≤ m := by exact_mod_cast hzlo
  have hmhi : m < 4096 := by exact_mod_cast hzhi
  have hpowm : (2 : ℝ) ^ x = (m : ℝ) := hz.symm
  have hidx : m - 256 < certTable4096.length := by
    rw [certTable4096_length]
    omega
  have hcert := checkFrom4096_spec certTable4096_all (m - 256) hidx
  rw [Nat.zero_add] at hcert
  rcases certOne4096_spec hcert with h0 | h0 | h0 | h0 | ⟨hapos, htier⟩
  · exact integer_of_two_rpow_eq_pow_two (show m = 2 ^ 8 by norm_num; omega) hpowm
  · exact integer_of_two_rpow_eq_pow_two (show m = 2 ^ 9 by norm_num; omega) hpowm
  · exact integer_of_two_rpow_eq_pow_two (show m = 2 ^ 10 by norm_num; omega) hpowm
  · exact integer_of_two_rpow_eq_pow_two (show m = 2 ^ 11 by norm_num; omega) hpowm
  · exfalso
    rw [show 256 + (m - 256) = m from by omega] at htier
    have hmpos : 0 < m := by omega
    rcases tieredCheck4096_spec htier with hc | hc | hc | hc | hc
    · exact cert_contradiction4096 hpowm h₃ hapos hmpos hxnonneg
        (by norm_num) (by norm_num) lower_base_t0 upper_base_t0 hc.1 hc.2
    · exact cert_contradiction4096 hpowm h₃ hapos hmpos hxnonneg
        (by norm_num) (by norm_num) lower_base_t1 upper_base_t1 hc.1 hc.2
    · exact cert_contradiction4096 hpowm h₃ hapos hmpos hxnonneg
        (by norm_num) (by norm_num) lower_base_t2 upper_base_t2 hc.1 hc.2
    · exact cert_contradiction4096 hpowm h₃ hapos hmpos hxnonneg
        (by norm_num) (by norm_num) lower_base_t3 upper_base_t3 hc.1 hc.2
    · exact cert_contradiction4096 hpowm h₃ hapos hmpos hxnonneg
        (by norm_num) (by norm_num) lower_base_t4 upper_base_t4 hc.1 hc.2

/-- In exponent coordinates, every nonintegral two-base solution is at least `12`. -/
theorem twelve_le_of_not_integer_of_two_three_rpow_integer {x : ℝ}
    (h₂ : (2 : ℝ) ^ x ∈ Set.range ((↑) : ℤ → ℝ))
    (h₃ : (3 : ℝ) ^ x ∈ Set.range ((↑) : ℤ → ℝ))
    (hx : x ∉ Set.range ((↑) : ℤ → ℝ)) :
    (12 : ℝ) ≤ x := by
  have h4096 : (4096 : ℝ) ≤ (2 : ℝ) ^ x :=
    not_lt.mp fun hlt ↦ hx
      (integer_of_two_three_rpow_integer_of_two_rpow_lt_4096 h₂ h₃ hlt)
  apply (Real.strictMono_rpow_of_base_gt_one (by norm_num : (1 : ℝ) < 2)).le_iff_le.mp
  norm_num [Real.rpow_natCast]
  exact h4096

/-- Every nonintegral natural two-base candidate value is at least `4096`. -/
theorem le_of_twoBaseNonintegerCandidate_4096 {m : ℕ}
    (hm : TwoBaseNaturalCandidate m) (hnp : ¬ ∃ n : ℕ, m = 2 ^ n) :
    4096 ≤ m := by
  by_contra hlt
  have hlt' : m < 4096 := by omega
  obtain ⟨h₂, h₃⟩ := hm.integer_powers
  have hmR : (2 : ℝ) ^ twoBaseCandidateExponent m = (m : ℝ) :=
    two_rpow_twoBaseCandidateExponent hm.1
  have hltR : (2 : ℝ) ^ twoBaseCandidateExponent m < 4096 := by
    rw [hmR]
    exact_mod_cast hlt'
  obtain ⟨z, hz⟩ :=
    integer_of_two_three_rpow_integer_of_two_rpow_lt_4096 h₂ h₃ hltR
  have hznonneg : 0 ≤ z := by
    have h0 : (0 : ℝ) ≤ twoBaseCandidateExponent m :=
      IntegerExponent.nonneg_of_two_rpow_integer h₂
    exact_mod_cast hz.symm ▸ h0
  obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hznonneg
  refine absurd ⟨n, ?_⟩ hnp
  have hpow : (m : ℝ) = ((2 ^ n : ℕ) : ℝ) := by
    calc
      (m : ℝ) = (2 : ℝ) ^ twoBaseCandidateExponent m := hmR.symm
      _ = (2 : ℝ) ^ ((n : ℕ) : ℝ) := by rw [← hz]; norm_num
      _ = ((2 ^ n : ℕ) : ℝ) := by rw [Real.rpow_natCast]; norm_cast
  exact_mod_cast hpow

end LeanProofs.TwoBaseIntegerExponent
