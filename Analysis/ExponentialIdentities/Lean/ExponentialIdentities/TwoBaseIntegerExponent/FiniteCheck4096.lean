private theorem checkFrom4096_spec {rows : List (ℕ × ℕ)} {i0 : ℕ}
    (h : checkFrom4096 i0 rows = true) :
    ∀ j, j < rows.length →
      certOne4096 (i0 + j) (rows.getD j (0, 0)).1 (rows.getD j (0, 0)).2 = true := by
  induction rows generalizing i0 with
  | nil =>
    intro j hj
    simp at hj
  | cons head tail ih =>
    intro j hj
    obtain ⟨a, t⟩ := head
    simp only [checkFrom4096, Bool.and_eq_true] at h
    cases j with
    | zero => simpa using h.1
    | succ j' =>
      have htail := ih h.2 j' (Nat.lt_of_succ_lt_succ (by simpa using hj))
      have harith : i0 + (j' + 1) = i0 + 1 + j' := by omega
      simpa [List.getD_cons_succ, harith] using htail

private theorem certOne4096_spec {i a t : ℕ} (h : certOne4096 i a t = true) :
    i = 0 ∨ i = 256 ∨ i = 768 ∨ i = 1792 ∨
      (0 < a ∧ tieredCheck4096 t (256 + i) a = true) := by
  simp only [certOne4096, Bool.or_eq_true, beq_iff_eq, Bool.and_eq_true,
    decide_eq_true_eq] at h
  tauto

private theorem tieredCheck4096_spec {t m a : ℕ} (h : tieredCheck4096 t m a = true) :
    (a ^ 359 < m ^ 569 ∧ m ^ 485 < (a + 1) ^ 306) ∨
    (a ^ 665 < m ^ 1054 ∧ m ^ 1539 < (a + 1) ^ 971) ∨
    (a ^ 16266 < m ^ 25781 ∧ m ^ 24727 < (a + 1) ^ 15601) ∨
    (a ^ 31867 < m ^ 50508 ∧ m ^ 125743 < (a + 1) ^ 79335) ∨
    (a ^ 111202 < m ^ 176251 ∧ m ^ 301994 < (a + 1) ^ 190537) := by
  match t with
  | 0 =>
    simp only [tieredCheck4096, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inl h
  | 1 =>
    simp only [tieredCheck4096, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inl h)
  | 2 =>
    simp only [tieredCheck4096, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inl h))
  | 3 =>
    simp only [tieredCheck4096, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  | 4 =>
    simp only [tieredCheck4096, Bool.and_eq_true, decide_eq_true_eq] at h
    exact Or.inr (Or.inr (Or.inr (Or.inr h)))
  | _ + 5 =>
    simp [tieredCheck4096] at h

