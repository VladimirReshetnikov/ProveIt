/-- Row check: index `i` corresponds to `m = 8192 + i`; the power of two `8192` is exempt. -/
private def certOne16384 (i a t : ℕ) : Bool :=
  (i == 0) || (decide (0 < a) && tieredCheck16384 t (8192 + i) a)

/-- Sequential check of all rows starting at index `i`. -/
private def checkFrom16384 : ℕ → List (ℕ × ℕ) → Bool
  | _, [] => true
  | i, (a, t) :: rest => certOne16384 i a t && checkFrom16384 (i + 1) rest

set_option maxRecDepth 200000 in
set_option maxHeartbeats 80000000 in
set_option exponentiation.threshold 5930000 in
private theorem certTable16384_all : checkFrom16384 0 certTable16384 = true := by decide

set_option maxRecDepth 200000 in
private theorem certTable16384_length : certTable16384.length = 8192 := by decide

private theorem checkFrom16384_spec {rows : List (ℕ × ℕ)} {i0 : ℕ}
    (h : checkFrom16384 i0 rows = true) :
    ∀ j, j < rows.length →
      certOne16384 (i0 + j) (rows.getD j (0, 0)).1 (rows.getD j (0, 0)).2 = true := by
  induction rows generalizing i0 with
  | nil =>
    intro j hj
    simp at hj
  | cons head tail ih =>
    intro j hj
    obtain ⟨a, t⟩ := head
    simp only [checkFrom16384, Bool.and_eq_true] at h
    cases j with
    | zero => simpa using h.1
    | succ j' =>
      have htail := ih h.2 j' (Nat.lt_of_succ_lt_succ (by simpa using hj))
      have harith : i0 + (j' + 1) = i0 + 1 + j' := by omega
      simpa [List.getD_cons_succ, harith] using htail

private theorem certOne16384_spec {i a t : ℕ} (h : certOne16384 i a t = true) :
    i = 0 ∨ (0 < a ∧ tieredCheck16384 t (8192 + i) a = true) := by
  simp only [certOne16384, Bool.or_eq_true, beq_iff_eq, Bool.and_eq_true,
    decide_eq_true_eq] at h
  tauto

