import ExponentialIdentities.TwoBaseIntegerExponent.LeastSolution
import ExponentialIdentities.TwoBaseIntegerExponent.MultiplicativeRank

/-!
# The second-iterate kernel: multiplicative form of the dichotomy

This file formalizes the *multiplicative form of the kernel dichotomy* for the Alaoglu--Erdős
two-base problem.  Let `x` be a real exponent whose two outputs `M = 2 ^ x` and `A = 3 ^ x` are
natural numbers, and write `θ = log 3 / log 2` (`logThreeDivLogTwo`).  The theorem below states
that the following are equivalent:

* the four integers `M`, `A`, `2`, `3` are *multiplicatively dependent*, that is
  `M ^ a * A ^ b * 2 ^ c * 3 ^ d = 1` for some integers `(a, b, c, d)` not all zero;
* the four reals `1`, `θ`, `x`, `x θ` are linearly dependent over `ℤ` --- equivalently over `ℚ`
  after clearing denominators --- in the shape `x (a + b θ) + (c + d θ) = 0` with
  `(a, b) ≠ (0, 0)`.

Both directions are elementary.  Taking logarithms of the multiplicative relation and using
`log M = x log 2` and `log A = x log 3` gives `(a x + c) log 2 + (b x + d) log 3 = 0`, and
dividing by `log 2` gives the linear relation; exponentiating reverses the step.  The only
nonformal input is the *irrationality* of `θ`, which supplies two things: it upgrades the
nontriviality of `(a, b, c, d)` to the sharper `(a, b) ≠ (0, 0)` (if `a = b = 0` then
`c + d θ = 0` forces `c = d = 0`), and it guarantees `a + b θ ≠ 0`, so that the linear relation
can be solved for `x`.

Solving for `x` yields the *Möbius form* `x = -(c + d θ) / (a + b θ)`, and for a genuinely
nonintegral `x` the determinant `a d - b c` cannot vanish: otherwise numerator and denominator
are proportional and `x` is rational, hence integral.

The statement is the theorem labelled `kn:thm-multiplicative` in the unified report, restricted
to the equivalence of its clauses (ii), (iii) and (iv).  Clause (i), nontriviality of the
rational kernel `K x`, is not formalized here: it needs the divisible hull of the group
generated by `2` and `3` together with prime valuations, which live in the radical modules.
Coefficients are taken in `ℤ` rather than in `ℚ`; the two formulations agree after clearing a
common denominator.
-/

namespace LeanProofs.TwoBaseIntegerExponent

open Set

/-- **Multiplicative dependence of the four outputs.**  The four numbers `M`, `A`, `2`, `3`
satisfy a nontrivial multiplicative relation with integer exponents.  It is used with `M` and
`A` the two integral outputs `2 ^ x` and `3 ^ x`, which are positive. -/
def MultiplicativelyDependentOutputs (M A : ℕ) : Prop :=
  ∃ a b c d : ℤ, ¬(a = 0 ∧ b = 0 ∧ c = 0 ∧ d = 0) ∧
    (M : ℝ) ^ a * (A : ℝ) ^ b * (2 : ℝ) ^ c * (3 : ℝ) ^ d = 1

/-- **The second-iterate kernel relation.**  A nontrivial integral linear relation among the
four reals `1`, `θ`, `x`, `x θ`, written so that the coefficients of `x` and `x θ` are `a` and
`b`.  Nontriviality is imposed on `(a, b)` alone, which is the sharp form: see
`multiplicativelyDependentOutputs_iff_secondIterateKernelRelation`. -/
def SecondIterateKernelRelation (x : ℝ) : Prop :=
  ∃ a b c d : ℤ, ¬(a = 0 ∧ b = 0) ∧
    x * ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) +
      ((c : ℝ) + (d : ℝ) * logThreeDivLogTwo) = 0

/-! ### Consequences of the irrationality of `θ` -/

/-- Irrationality of `θ = log 3 / log 2` in integral linear form: a relation `c + d θ = 0` with
integer coefficients is trivial. -/
theorem eq_zero_of_intCast_add_mul_logThreeDivLogTwo_eq_zero {c d : ℤ}
    (h : (c : ℝ) + (d : ℝ) * logThreeDivLogTwo = 0) : c = 0 ∧ d = 0 := by
  have hd : d = 0 := by
    by_contra hd0
    have hdR : (d : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hd0
    refine irrational_logThreeDivLogTwo.ne_rational (-c) d ?_
    rw [eq_div_iff hdR]
    push_cast
    linarith
  subst hd
  exact ⟨by simpa using h, rfl⟩

/-- The denominator of the Möbius form never vanishes: `a + b θ = 0` forces `a = b = 0`. -/
theorem intCast_add_mul_logThreeDivLogTwo_ne_zero {a b : ℤ} (hab : ¬(a = 0 ∧ b = 0)) :
    (a : ℝ) + (b : ℝ) * logThreeDivLogTwo ≠ 0 := fun h =>
  hab (eq_zero_of_intCast_add_mul_logThreeDivLogTwo_eq_zero h)

/-- The exponent `θ = log 3 / log 2` is nonzero. -/
theorem logThreeDivLogTwo_ne_zero : logThreeDivLogTwo ≠ 0 :=
  ne_of_gt (lt_trans zero_lt_one one_lt_logThreeDivLogTwo)

/-! ### Passing between the multiplicative and the additive relation -/

private theorem log_three_eq_log_two_mul :
    Real.log 3 = Real.log 2 * logThreeDivLogTwo := by
  have h2 : Real.log 2 ≠ 0 := ne_of_gt (Real.log_pos (by norm_num : (1 : ℝ) < 2))
  rw [logThreeDivLogTwo, mul_comm (Real.log 2) (Real.log 3 / Real.log 2),
    div_mul_cancel₀ _ h2]

private theorem log_zpow_four_factors {m n : ℝ} (hm : 0 < m) (hn : 0 < n) (a b c d : ℤ) :
    Real.log (m ^ a * n ^ b * (2 : ℝ) ^ c * (3 : ℝ) ^ d) =
      (a : ℝ) * Real.log m + (b : ℝ) * Real.log n +
        (c : ℝ) * Real.log 2 + (d : ℝ) * Real.log 3 := by
  have h1 : (0 : ℝ) < m ^ a := zpow_pos hm a
  have h2 : (0 : ℝ) < n ^ b := zpow_pos hn b
  have h3 : (0 : ℝ) < (2 : ℝ) ^ c := zpow_pos (by norm_num) c
  have h4 : (0 : ℝ) < (3 : ℝ) ^ d := zpow_pos (by norm_num) d
  have e1 := Real.log_mul (mul_pos (mul_pos h1 h2) h3).ne' h4.ne'
  have e2 := Real.log_mul (mul_pos h1 h2).ne' h3.ne'
  have e3 := Real.log_mul h1.ne' h2.ne'
  have z1 := Real.log_zpow m a
  have z2 := Real.log_zpow n b
  have z3 := Real.log_zpow (2 : ℝ) c
  have z4 := Real.log_zpow (3 : ℝ) d
  linarith [e1, e2, e3, z1, z2, z3, z4]

/-- **The logarithmic bridge.**  For an exponent `x` with outputs `M = 2 ^ x` and `A = 3 ^ x`, a
multiplicative relation with integer exponents is the same thing as the corresponding linear
relation among `1`, `θ`, `x`, `x θ`.  No nontriviality is assumed here. -/
theorem outputs_zpow_eq_one_iff {x : ℝ} {M A : ℕ}
    (hM : (M : ℝ) = (2 : ℝ) ^ x) (hA : (A : ℝ) = (3 : ℝ) ^ x) (a b c d : ℤ) :
    (M : ℝ) ^ a * (A : ℝ) ^ b * (2 : ℝ) ^ c * (3 : ℝ) ^ d = 1 ↔
      x * ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) +
        ((c : ℝ) + (d : ℝ) * logThreeDivLogTwo) = 0 := by
  have hlog2 : Real.log 2 ≠ 0 := ne_of_gt (Real.log_pos (by norm_num : (1 : ℝ) < 2))
  have hMpos : (0 : ℝ) < (M : ℝ) := by
    rw [hM]
    exact Real.rpow_pos_of_pos (by norm_num) x
  have hApos : (0 : ℝ) < (A : ℝ) := by
    rw [hA]
    exact Real.rpow_pos_of_pos (by norm_num) x
  have hProd : (0 : ℝ) < (M : ℝ) ^ a * (A : ℝ) ^ b * (2 : ℝ) ^ c * (3 : ℝ) ^ d :=
    mul_pos (mul_pos (mul_pos (zpow_pos hMpos a) (zpow_pos hApos b))
      (zpow_pos (by norm_num) c)) (zpow_pos (by norm_num) d)
  have hlogM : Real.log (M : ℝ) = x * Real.log 2 := by
    rw [hM, Real.log_rpow (by norm_num : (0 : ℝ) < 2)]
  have hlogA : Real.log (A : ℝ) = x * Real.log 3 := by
    rw [hA, Real.log_rpow (by norm_num : (0 : ℝ) < 3)]
  have hkey : Real.log ((M : ℝ) ^ a * (A : ℝ) ^ b * (2 : ℝ) ^ c * (3 : ℝ) ^ d) =
      Real.log 2 * (x * ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) +
        ((c : ℝ) + (d : ℝ) * logThreeDivLogTwo)) := by
    rw [log_zpow_four_factors hMpos hApos a b c d, hlogM, hlogA, log_three_eq_log_two_mul]
    ring
  constructor
  · intro h
    have h0 : Real.log 2 * (x * ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) +
        ((c : ℝ) + (d : ℝ) * logThreeDivLogTwo)) = 0 := by
      rw [← hkey, h, Real.log_one]
    exact (mul_eq_zero.mp h0).resolve_left hlog2
  · intro h
    have h0 : Real.log ((M : ℝ) ^ a * (A : ℝ) ^ b * (2 : ℝ) ^ c * (3 : ℝ) ^ d) = 0 := by
      rw [hkey, h, mul_zero]
    calc (M : ℝ) ^ a * (A : ℝ) ^ b * (2 : ℝ) ^ c * (3 : ℝ) ^ d
        = Real.exp (Real.log ((M : ℝ) ^ a * (A : ℝ) ^ b * (2 : ℝ) ^ c * (3 : ℝ) ^ d)) :=
          (Real.exp_log hProd).symm
      _ = 1 := by rw [h0, Real.exp_zero]

/-! ### The dichotomy -/

/-- Forward direction: a multiplicative relation among `M`, `A`, `2`, `3` yields a kernel
relation, and the exponent pair `(a, b)` on the two outputs is automatically nontrivial. -/
theorem secondIterateKernelRelation_of_multiplicativelyDependentOutputs {x : ℝ} {M A : ℕ}
    (hM : (M : ℝ) = (2 : ℝ) ^ x) (hA : (A : ℝ) = (3 : ℝ) ^ x)
    (h : MultiplicativelyDependentOutputs M A) : SecondIterateKernelRelation x := by
  obtain ⟨a, b, c, d, htriv, heq⟩ := h
  have hlin := (outputs_zpow_eq_one_iff hM hA a b c d).mp heq
  refine ⟨a, b, c, d, ?_, hlin⟩
  rintro ⟨ha, hb⟩
  have hcd : (c : ℝ) + (d : ℝ) * logThreeDivLogTwo = 0 := by
    rw [ha, hb] at hlin
    push_cast at hlin
    linarith
  obtain ⟨hc, hd⟩ := eq_zero_of_intCast_add_mul_logThreeDivLogTwo_eq_zero hcd
  exact htriv ⟨ha, hb, hc, hd⟩

/-- Reverse direction: a kernel relation exponentiates back to a multiplicative relation. -/
theorem multiplicativelyDependentOutputs_of_secondIterateKernelRelation {x : ℝ} {M A : ℕ}
    (hM : (M : ℝ) = (2 : ℝ) ^ x) (hA : (A : ℝ) = (3 : ℝ) ^ x)
    (h : SecondIterateKernelRelation x) : MultiplicativelyDependentOutputs M A := by
  obtain ⟨a, b, c, d, hab, heq⟩ := h
  exact ⟨a, b, c, d, fun hzero => hab ⟨hzero.1, hzero.2.1⟩,
    (outputs_zpow_eq_one_iff hM hA a b c d).mpr heq⟩

/-- **Multiplicative form of the kernel dichotomy.**  Let `x` be a real exponent whose outputs
`M = 2 ^ x` and `A = 3 ^ x` are natural numbers.  Then the four integers `M`, `A`, `2`, `3` are
multiplicatively dependent if and only if `1`, `θ`, `x`, `x θ` satisfy a nontrivial integral
linear relation, where `θ = log 3 / log 2`.

This is the equivalence of clauses (ii) and (iii) of the multiplicative kernel theorem of the
unified report.  It is unconditional: no hypothesis on `x` beyond the two integrality
assumptions is used, and the only input beyond logarithms is the irrationality of `θ`. -/
theorem multiplicativelyDependentOutputs_iff_secondIterateKernelRelation {x : ℝ} {M A : ℕ}
    (hM : (M : ℝ) = (2 : ℝ) ^ x) (hA : (A : ℝ) = (3 : ℝ) ^ x) :
    MultiplicativelyDependentOutputs M A ↔ SecondIterateKernelRelation x :=
  ⟨secondIterateKernelRelation_of_multiplicativelyDependentOutputs hM hA,
    multiplicativelyDependentOutputs_of_secondIterateKernelRelation hM hA⟩

/-! ### The Möbius form -/

/-- **Solving the kernel relation for `x`.**  A kernel relation exhibits `x` as a Möbius image
of `θ` with integer coefficients and nonvanishing denominator. -/
theorem exists_moebius_of_secondIterateKernelRelation {x : ℝ}
    (h : SecondIterateKernelRelation x) :
    ∃ a b c d : ℤ, ¬(a = 0 ∧ b = 0) ∧
      (a : ℝ) + (b : ℝ) * logThreeDivLogTwo ≠ 0 ∧
      x = -((c : ℝ) + (d : ℝ) * logThreeDivLogTwo) /
            ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) := by
  obtain ⟨a, b, c, d, hab, heq⟩ := h
  have hden := intCast_add_mul_logThreeDivLogTwo_ne_zero hab
  refine ⟨a, b, c, d, hab, hden, ?_⟩
  rw [eq_div_iff hden]
  linarith

/-- Converse of the Möbius form: any such expression cross-multiplies back to a kernel
relation. -/
theorem secondIterateKernelRelation_of_moebius {x : ℝ} {a b c d : ℤ}
    (hab : ¬(a = 0 ∧ b = 0))
    (hx : x = -((c : ℝ) + (d : ℝ) * logThreeDivLogTwo) /
            ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo)) :
    SecondIterateKernelRelation x := by
  have hden := intCast_add_mul_logThreeDivLogTwo_ne_zero hab
  refine ⟨a, b, c, d, hab, ?_⟩
  rw [hx, div_mul_cancel₀ _ hden]
  ring

/-- **Nonvanishing of the Möbius determinant.**  If `x` is irrational then the coefficient
matrix of any kernel relation it satisfies is invertible: a vanishing determinant would make
numerator and denominator proportional and `x` rational. -/
theorem moebius_det_ne_zero_of_irrational {x : ℝ} {a b c d : ℤ}
    (hxirr : Irrational x) (hab : ¬(a = 0 ∧ b = 0))
    (heq : x * ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) +
        ((c : ℝ) + (d : ℝ) * logThreeDivLogTwo) = 0) :
    a * d - b * c ≠ 0 := by
  intro hdet
  have hden := intCast_add_mul_logThreeDivLogTwo_ne_zero hab
  by_cases ha : a = 0
  · -- `a = 0` forces `b ≠ 0` and then `c = 0`, so `x = -d / b` is rational.
    have hb : b ≠ 0 := fun hb0 => hab ⟨ha, hb0⟩
    have hbc : b * c = 0 := by
      rw [ha] at hdet
      linarith
    have hc : c = 0 := (mul_eq_zero.mp hbc).resolve_left hb
    have hfac : (x * (b : ℝ) + (d : ℝ)) * logThreeDivLogTwo = 0 := by
      rw [ha, hc] at heq
      push_cast at heq
      linarith
    have hxb : x * (b : ℝ) + (d : ℝ) = 0 :=
      (mul_eq_zero.mp hfac).resolve_right logThreeDivLogTwo_ne_zero
    have hbR : (b : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hb
    refine hxirr.ne_rational (-d) b ?_
    rw [eq_div_iff hbR]
    push_cast
    linarith
  · -- `a ≠ 0`: the relation `a d = b c` makes `x a + c` annihilate the nonzero `a + b θ`.
    have haR : (a : ℝ) ≠ 0 := Int.cast_ne_zero.mpr ha
    have hdetR : (a : ℝ) * (d : ℝ) - (b : ℝ) * (c : ℝ) = 0 := by exact_mod_cast hdet
    have h1 : (a : ℝ) * (x * ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) +
        ((c : ℝ) + (d : ℝ) * logThreeDivLogTwo)) = 0 := by
      rw [heq]
      ring
    have h2 : ((a : ℝ) * (d : ℝ) - (b : ℝ) * (c : ℝ)) * logThreeDivLogTwo = 0 := by
      rw [hdetR]
      ring
    have hprod : (x * (a : ℝ) + (c : ℝ)) *
        ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) = 0 := by linarith [h1, h2]
    have hxa : x * (a : ℝ) + (c : ℝ) = 0 := (mul_eq_zero.mp hprod).resolve_right hden
    refine hxirr.ne_rational (-c) a ?_
    rw [eq_div_iff haR]
    push_cast
    linarith

/-- **Möbius form of the kernel dichotomy for a nonintegral solution.**  If `x` is not an
integer and its outputs `M = 2 ^ x`, `A = 3 ^ x` are multiplicatively dependent with `2` and
`3`, then `x` lies in the projective linear orbit of `θ` over `ℚ`: it is an integral Möbius
image of `θ` whose determinant is nonzero.

This is clause (iv) of the multiplicative kernel theorem of the unified report. -/
theorem exists_moebius_of_multiplicativelyDependentOutputs {x : ℝ} {M A : ℕ}
    (hM : (M : ℝ) = (2 : ℝ) ^ x) (hA : (A : ℝ) = (3 : ℝ) ^ x)
    (hx : x ∉ Set.range ((↑) : ℤ → ℝ))
    (h : MultiplicativelyDependentOutputs M A) :
    ∃ a b c d : ℤ, ¬(a = 0 ∧ b = 0) ∧
      (a : ℝ) + (b : ℝ) * logThreeDivLogTwo ≠ 0 ∧ a * d - b * c ≠ 0 ∧
      x = -((c : ℝ) + (d : ℝ) * logThreeDivLogTwo) /
            ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) := by
  have hxirr : Irrational x :=
    irrational_of_not_integer_of_two_rpow_integer hx ⟨(M : ℤ), by push_cast; exact hM⟩
  obtain ⟨a, b, c, d, hab, heq⟩ :=
    (multiplicativelyDependentOutputs_iff_secondIterateKernelRelation hM hA).mp h
  have hden := intCast_add_mul_logThreeDivLogTwo_ne_zero hab
  refine ⟨a, b, c, d, hab, hden, moebius_det_ne_zero_of_irrational hxirr hab heq, ?_⟩
  rw [eq_div_iff hden]
  linarith

/-- Converse at the multiplicative level: an integral Möbius expression of `x` in terms of `θ`
forces the four integers `M`, `A`, `2`, `3` to be multiplicatively dependent. -/
theorem multiplicativelyDependentOutputs_of_moebius {x : ℝ} {M A : ℕ}
    (hM : (M : ℝ) = (2 : ℝ) ^ x) (hA : (A : ℝ) = (3 : ℝ) ^ x) {a b c d : ℤ}
    (hab : ¬(a = 0 ∧ b = 0))
    (hx : x = -((c : ℝ) + (d : ℝ) * logThreeDivLogTwo) /
            ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo)) :
    MultiplicativelyDependentOutputs M A :=
  multiplicativelyDependentOutputs_of_secondIterateKernelRelation hM hA
    (secondIterateKernelRelation_of_moebius hab hx)

/-- **The dichotomy, packaged.**  Every nonintegral solution falls into exactly one of two
branches: either its four integers `M`, `A`, `2`, `3` are multiplicatively independent, or `x`
is an integral Möbius image of `θ` with nonvanishing determinant.  The case distinction is a
question about four ordinary integers, with no transcendence vocabulary. -/
theorem multiplicativelyIndependent_or_moebius {x : ℝ} {M A : ℕ}
    (hM : (M : ℝ) = (2 : ℝ) ^ x) (hA : (A : ℝ) = (3 : ℝ) ^ x)
    (hx : x ∉ Set.range ((↑) : ℤ → ℝ)) :
    ¬ MultiplicativelyDependentOutputs M A ∨
      ∃ a b c d : ℤ, ¬(a = 0 ∧ b = 0) ∧
        (a : ℝ) + (b : ℝ) * logThreeDivLogTwo ≠ 0 ∧ a * d - b * c ≠ 0 ∧
        x = -((c : ℝ) + (d : ℝ) * logThreeDivLogTwo) /
              ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) := by
  by_cases h : MultiplicativelyDependentOutputs M A
  · exact Or.inr (exists_moebius_of_multiplicativelyDependentOutputs hM hA hx h)
  · exact Or.inl h

/-! ### Natural-number outputs of a solution -/

/-- The two integral outputs of a two-base solution may be taken to be natural numbers, since
real powers of positive bases are positive. -/
theorem exists_nat_outputs_of_twoBaseIntegralSolution {x : ℝ}
    (h : TwoBaseIntegralSolution x) :
    ∃ M A : ℕ, (M : ℝ) = (2 : ℝ) ^ x ∧ (A : ℝ) = (3 : ℝ) ^ x := by
  obtain ⟨⟨z, hz⟩, ⟨w, hw⟩⟩ := h
  have hznn : 0 ≤ z := by
    have hzR : (0 : ℝ) < (z : ℝ) := by
      rw [hz]
      exact Real.rpow_pos_of_pos (by norm_num) x
    exact_mod_cast hzR.le
  have hwnn : 0 ≤ w := by
    have hwR : (0 : ℝ) < (w : ℝ) := by
      rw [hw]
      exact Real.rpow_pos_of_pos (by norm_num) x
    exact_mod_cast hwR.le
  obtain ⟨M, hMz⟩ : ∃ M : ℕ, (M : ℤ) = z := ⟨z.toNat, Int.toNat_of_nonneg hznn⟩
  obtain ⟨A, hAw⟩ : ∃ A : ℕ, (A : ℤ) = w := ⟨w.toNat, Int.toNat_of_nonneg hwnn⟩
  refine ⟨M, A, ?_, ?_⟩
  · rw [← hz, ← hMz]
    norm_cast
  · rw [← hw, ← hAw]
    norm_cast

/-- **The dichotomy for a nonintegral solution, stated without naming the outputs.**  Any
hypothetical counterexample `x` to the Alaoglu--Erdős conjecture either has multiplicatively
independent outputs, or is an integral Möbius image of `θ = log 3 / log 2`. -/
theorem twoBaseNonintegerSolution_kernel_dichotomy {x : ℝ}
    (hx : TwoBaseNonintegerSolution x) :
    (∃ M A : ℕ, (M : ℝ) = (2 : ℝ) ^ x ∧ (A : ℝ) = (3 : ℝ) ^ x ∧
        ¬ MultiplicativelyDependentOutputs M A) ∨
      ∃ a b c d : ℤ, ¬(a = 0 ∧ b = 0) ∧
        (a : ℝ) + (b : ℝ) * logThreeDivLogTwo ≠ 0 ∧ a * d - b * c ≠ 0 ∧
        x = -((c : ℝ) + (d : ℝ) * logThreeDivLogTwo) /
              ((a : ℝ) + (b : ℝ) * logThreeDivLogTwo) := by
  obtain ⟨M, A, hM, hA⟩ := exists_nat_outputs_of_twoBaseIntegralSolution hx.1
  rcases multiplicativelyIndependent_or_moebius hM hA hx.2 with hind | hmoe
  · exact Or.inl ⟨M, A, hM, hA, hind⟩
  · exact Or.inr hmoe

end LeanProofs.TwoBaseIntegerExponent
