/-- All checks for one row.  Index `i` corresponds to `m = 16384 + i`; the power of two
`16384` at index `0` is exempt. -/
private def certOne32768 (i a e : ℕ) : Bool :=
  (i == 0) ||
    (let q := encl32768.getD e (0, 0, 0, 0)
     decide (0 < a) && decide (0 < q.2.1) && decide (0 < q.2.2.2) &&
      decide (2 ^ q.1 < 3 ^ q.2.1) && decide (3 ^ q.2.2.2 < 2 ^ q.2.2.1) &&
      decide (a ^ q.2.1 < (16384 + i) ^ q.1) &&
      decide ((16384 + i) ^ q.2.2.1 < (a + 1) ^ q.2.2.2))

/-- Sequential check of all rows starting at index `i`. -/
private def checkFrom32768 : ℕ → List (ℕ × ℕ) → Bool
  | _, [] => true
  | i, (a, e) :: rest =>
    certOne32768 i a e && checkFrom32768 (i + 1) rest

