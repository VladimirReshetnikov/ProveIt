import ExponentialIdentities.TwoBaseIntegerExponent.MixedExponentSemigroup
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic

/-!
# Semigroup generalized Vandermonde determinants: the integrality half

Write `θ = log 3 / log 2`.  A natural candidate `m` satisfies `m ^ θ ∈ ℤ`, and therefore
carries much more integral data than that single value: for every pair `(a, b)` of natural
numbers,
`m ^ (a + b * θ) = m ^ a * (m ^ θ) ^ b ∈ ℕ`.
The exponents available to a candidate thus form the additive semigroup
`Λ_θ = {a + b * θ : a, b ∈ ℕ}`, whose elements are produced here by `mixedExponent`.

This module formalizes the *integrality half* of the report's Theorem B
(`thm:semigroup-integer-det` in `alaoglu-erdos-further-report.tex`).  Given `r + 1` natural
candidates `m 0, …, m r` and `r + 1` exponent pairs `ab 0, …, ab r`, the *semigroup
generalized Vandermonde matrix*

`semigroupMatrix r m ab i j = (m i) ^ mixedExponent (ab j)`

has natural-number entries.  Consequently its determinant is a rational integer, so it is
either zero or of absolute value at least one.

The complementary *positivity* half — the statement that the determinant is strictly
positive whenever the nodes `m i` and the exponents `mixedExponent (ab j)` are both strictly
increasing, which rests on the fact that `x ↦ x ^ λ` is an extended complete Chebyshev
system on `(0, ∞)` (`lem:generalized-vandermonde` in the report) — is deliberately *not*
proved here.  It enters `one_le_det_semigroupMatrix` as a hypothesis, so that the reusable
integrality content compiles independently of the harder analytic argument.  For the same
reason nothing in this file assumes that the nodes are distinct, that they are ordered, or
that the exponent pairs are distinct: none of that is needed for integrality.

Combined, `one_le_det_semigroupMatrix` is exactly the lower bound `D_λ(m) ≥ 1` that drives
the report's quantitative semigroup gap theorem.

The argument is the same one used for the interpolation determinant in
`LeanProofs.IntegerExponent.one_le_abs_det_of_integer_entries`, restated here for the
semigroup matrix so that this module stands on its own.
-/

namespace LeanProofs.TwoBaseIntegerExponent

open Set

noncomputable section

/-- The **semigroup generalized Vandermonde matrix** of the report.  Row `i` is indexed by a
natural number `m i`, column `j` by a pair `ab j = (a, b)`, and the entry is the real power
`(m i) ^ (a + b * (log 3 / log 2))`.  The exponent `mixedExponent (ab j)` ranges over the
additive semigroup generated by `1` and `log 3 / log 2`. -/
def semigroupMatrix (r : ℕ) (m : Fin (r + 1) → ℕ) (ab : Fin (r + 1) → ℕ × ℕ) :
    Matrix (Fin (r + 1)) (Fin (r + 1)) ℝ :=
  Matrix.of fun i j ↦ (m i : ℝ) ^ mixedExponent (ab j)

@[simp] theorem semigroupMatrix_apply (r : ℕ) (m : Fin (r + 1) → ℕ)
    (ab : Fin (r + 1) → ℕ × ℕ) (i j : Fin (r + 1)) :
    semigroupMatrix r m ab i j = (m i : ℝ) ^ mixedExponent (ab j) :=
  rfl

/-- Mixed integrality with the exponent pair packaged as a single index: if `m` is a natural
candidate then `m ^ mixedExponent ab` is a natural number for every `ab : ℕ × ℕ`. -/
theorem exists_nat_rpow_mixedExponent_pair {m : ℕ} (hm : TwoBaseNaturalCandidate m)
    (ab : ℕ × ℕ) : ∃ n : ℕ, (n : ℝ) = (m : ℝ) ^ mixedExponent ab := by
  obtain ⟨a, b⟩ := ab
  exact exists_nat_rpow_mixedExponent hm a b

/-- Every entry of the semigroup matrix in a candidate row is a natural number. -/
theorem exists_nat_semigroupMatrix_entry (r : ℕ) (m : Fin (r + 1) → ℕ)
    (ab : Fin (r + 1) → ℕ × ℕ) (i j : Fin (r + 1))
    (hm : TwoBaseNaturalCandidate (m i)) :
    ∃ n : ℕ, (n : ℝ) = semigroupMatrix r m ab i j :=
  exists_nat_rpow_mixedExponent_pair hm (ab j)

/-- Every entry of the semigroup matrix in a candidate row is a rational integer. -/
theorem exists_int_semigroupMatrix_entry (r : ℕ) (m : Fin (r + 1) → ℕ)
    (ab : Fin (r + 1) → ℕ × ℕ) (i j : Fin (r + 1))
    (hm : TwoBaseNaturalCandidate (m i)) :
    ∃ z : ℤ, (z : ℝ) = semigroupMatrix r m ab i j := by
  obtain ⟨n, hn⟩ := exists_nat_semigroupMatrix_entry r m ab i j hm
  exact ⟨(n : ℤ), by exact_mod_cast hn⟩

/-- **The semigroup matrix of natural candidates is a natural matrix.**  If every row index
`m i` is a two-base natural candidate, then `semigroupMatrix r m ab` is the entrywise real
image of a matrix over `ℕ`. -/
theorem exists_nat_semigroupMatrix (r : ℕ) (m : Fin (r + 1) → ℕ)
    (hm : ∀ i, TwoBaseNaturalCandidate (m i)) (ab : Fin (r + 1) → ℕ × ℕ) :
    ∃ Z : Matrix (Fin (r + 1)) (Fin (r + 1)) ℕ,
      Z.map (fun n : ℕ ↦ (n : ℝ)) = semigroupMatrix r m ab := by
  have hentry : ∀ i j : Fin (r + 1), ∃ n : ℕ, (n : ℝ) = semigroupMatrix r m ab i j :=
    fun i j ↦ exists_nat_semigroupMatrix_entry r m ab i j (hm i)
  choose Z hZ using hentry
  refine ⟨Matrix.of Z, ?_⟩
  ext i j
  simpa using hZ i j

/-- **The semigroup matrix of natural candidates is an integer matrix.**  This is the form
consumed by the determinant argument; `exists_nat_semigroupMatrix` is the sharper statement
that the entries are in fact natural numbers. -/
theorem exists_int_semigroupMatrix (r : ℕ) (m : Fin (r + 1) → ℕ)
    (hm : ∀ i, TwoBaseNaturalCandidate (m i)) (ab : Fin (r + 1) → ℕ × ℕ) :
    ∃ Z : Matrix (Fin (r + 1)) (Fin (r + 1)) ℤ,
      Z.map (fun z : ℤ ↦ (z : ℝ)) = semigroupMatrix r m ab := by
  obtain ⟨Z, hZ⟩ := exists_nat_semigroupMatrix r m hm ab
  refine ⟨Matrix.of fun i j ↦ (Z i j : ℤ), ?_⟩
  rw [← hZ]
  ext i j
  simp only [Matrix.map_apply, Matrix.of_apply, Int.cast_natCast]

/-- **Theorem B, integrality half.**  The semigroup generalized Vandermonde determinant of
natural candidates is a rational integer. -/
theorem det_semigroupMatrix_isInt (r : ℕ) (m : Fin (r + 1) → ℕ)
    (hm : ∀ i, TwoBaseNaturalCandidate (m i)) (ab : Fin (r + 1) → ℕ × ℕ) :
    ∃ z : ℤ, (z : ℝ) = (semigroupMatrix r m ab).det := by
  obtain ⟨Z, hZ⟩ := exists_int_semigroupMatrix r m hm ab
  exact ⟨Z.det, by rw [Int.cast_det, hZ]⟩

/-- A nonvanishing semigroup determinant of natural candidates has absolute value at least
one: it is a nonzero rational integer. -/
theorem one_le_abs_det_semigroupMatrix (r : ℕ) (m : Fin (r + 1) → ℕ)
    (hm : ∀ i, TwoBaseNaturalCandidate (m i)) (ab : Fin (r + 1) → ℕ × ℕ)
    (hne : (semigroupMatrix r m ab).det ≠ 0) :
    1 ≤ |(semigroupMatrix r m ab).det| := by
  obtain ⟨z, hz⟩ := det_semigroupMatrix_isInt r m hm ab
  have hz0 : z ≠ 0 := by
    intro h
    exact hne (by rw [← hz, h, Int.cast_zero])
  rw [← hz, ← Int.cast_abs, ← Int.cast_one, Int.cast_le]
  exact Int.one_le_abs hz0

/-- **The reusable lower bound.**  Granted the positivity supplied by generalized
Vandermonde theory (`lem:generalized-vandermonde`), the semigroup determinant of natural
candidates is at least `1`.  This is the inequality `D_λ(m) ≥ 1` that the quantitative
semigroup gap theorem consumes. -/
theorem one_le_det_semigroupMatrix (r : ℕ) (m : Fin (r + 1) → ℕ)
    (hm : ∀ i, TwoBaseNaturalCandidate (m i)) (ab : Fin (r + 1) → ℕ × ℕ)
    (hpos : 0 < (semigroupMatrix r m ab).det) :
    1 ≤ (semigroupMatrix r m ab).det := by
  have h := one_le_abs_det_semigroupMatrix r m hm ab hpos.ne'
  rwa [abs_of_pos hpos] at h

/-- **Theorem B, packaged.**  Under the positivity hypothesis the semigroup generalized
Vandermonde determinant of natural candidates is a positive rational integer. -/
theorem exists_pos_int_det_semigroupMatrix (r : ℕ) (m : Fin (r + 1) → ℕ)
    (hm : ∀ i, TwoBaseNaturalCandidate (m i)) (ab : Fin (r + 1) → ℕ × ℕ)
    (hpos : 0 < (semigroupMatrix r m ab).det) :
    ∃ z : ℤ, 0 < z ∧ (z : ℝ) = (semigroupMatrix r m ab).det := by
  obtain ⟨z, hz⟩ := det_semigroupMatrix_isInt r m hm ab
  refine ⟨z, ?_, hz⟩
  have hzR : (0 : ℝ) < (z : ℝ) := by rw [hz]; exact hpos
  exact_mod_cast hzR

end

end LeanProofs.TwoBaseIntegerExponent
