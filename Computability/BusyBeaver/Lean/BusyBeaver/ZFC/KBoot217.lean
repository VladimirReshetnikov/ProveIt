import BusyBeaver.ZFC.KBoot217Chunk023
import BusyBeaver.ZFC.KRuntimeCore

/-!
The 217's exact blank-tape bootstrap (port of K230's `Boot230.v`). After 312,617 steps the
machine is in state 84 with `[true]` to its left, a gap of 144 blank cells, and 139 register
blocks: the boot registers (`nextproof = 3`, `param1 = 3`) in physical order, then 130 spare
blocks holding 1. Checked in kernel blocks against the literal table.
Generated by `Research/ZFC/k225-formal/generate_boot217_lean.py`.
-/

namespace SetTheory.BusyBeaver.ZFC.KBoot217

open KZip KBoot KTableCore

set_option maxRecDepth 100000

def bootVs : List Nat := [0, 0, 0, 3, 0, 0, 3, 0, 0] ++ List.replicate 130 1

def bootRight : List Bool := List.replicate 144 false ++ true :: KRuntimeCore.sepsR bootVs

theorem cp_left : cp24.2.1 = [true] ++ List.replicate 9 false := by decide +kernel

theorem cp_right : cp24.2.2 = bootRight ++ List.replicate 0 false := by decide +kernel

theorem cp_state : cp24.1 = 84 := rfl

theorem boot_run : Reach tm217 (zc 0 [] []) (lconc cp24) :=
  (lblock_reach fast217 block1) |>.trans (lblock_reach fast217 block2) |>.trans (lblock_reach fast217 block3) |>.trans (lblock_reach fast217 block4) |>.trans (lblock_reach fast217 block5) |>.trans (lblock_reach fast217 block6) |>.trans (lblock_reach fast217 block7) |>.trans (lblock_reach fast217 block8) |>.trans (lblock_reach fast217 block9) |>.trans (lblock_reach fast217 block10) |>.trans (lblock_reach fast217 block11) |>.trans (lblock_reach fast217 block12) |>.trans (lblock_reach fast217 block13) |>.trans (lblock_reach fast217 block14) |>.trans (lblock_reach fast217 block15) |>.trans (lblock_reach fast217 block16) |>.trans (lblock_reach fast217 block17) |>.trans (lblock_reach fast217 block18) |>.trans (lblock_reach fast217 block19) |>.trans (lblock_reach fast217 block20) |>.trans (lblock_reach fast217 block21) |>.trans (lblock_reach fast217 block22) |>.trans (lblock_reach fast217 block23) |>.trans (lblock_reach fast217 block24)

theorem boot : Reach tm217 (zc 0 [] []) (zc 84 [true] bootRight) := by
  have h := boot_run
  simp only [lconc, cp_state, cp_left, cp_right, zc_padl, zc_padr] at h
  exact h

end SetTheory.BusyBeaver.ZFC.KBoot217
