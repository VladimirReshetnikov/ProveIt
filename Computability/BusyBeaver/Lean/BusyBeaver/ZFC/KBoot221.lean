import BusyBeaver.ZFC.KBoot221Chunk030
import BusyBeaver.ZFC.KRuntimeCore

/-!
The 221's exact blank-tape bootstrap (port of K230's `Boot230.v`). After 409,835 steps the
machine is in state 84 with `[true]` to its left, a gap of 181 blank cells, and 176 register
blocks: the boot registers (`nextproof = 3`, `param1 = 3`) in physical order, then 167 spare
blocks holding 1. Checked in kernel blocks against the literal table.
Generated by `Research/ZFC/k225-formal/generate_boot221_lean.py`.
-/

namespace SetTheory.BusyBeaver.ZFC.KBoot221

open KZip KBoot KTableCore

set_option maxRecDepth 100000

def bootVs : List Nat := [0, 0, 0, 3, 0, 0, 3, 0, 0] ++ List.replicate 167 1

def bootRight : List Bool := List.replicate 181 false ++ true :: KRuntimeCore.sepsR bootVs

theorem cp_left : cp31.2.1 = [true] ++ List.replicate 9 false := by decide +kernel

theorem cp_right : cp31.2.2 = bootRight ++ List.replicate 0 false := by decide +kernel

theorem cp_state : cp31.1 = 84 := rfl

theorem boot_run : Reach tm221 (zc 0 [] []) (lconc cp31) :=
  (lblock_reach fast221 block1) |>.trans (lblock_reach fast221 block2) |>.trans (lblock_reach fast221 block3) |>.trans (lblock_reach fast221 block4) |>.trans (lblock_reach fast221 block5) |>.trans (lblock_reach fast221 block6) |>.trans (lblock_reach fast221 block7) |>.trans (lblock_reach fast221 block8) |>.trans (lblock_reach fast221 block9) |>.trans (lblock_reach fast221 block10) |>.trans (lblock_reach fast221 block11) |>.trans (lblock_reach fast221 block12) |>.trans (lblock_reach fast221 block13) |>.trans (lblock_reach fast221 block14) |>.trans (lblock_reach fast221 block15) |>.trans (lblock_reach fast221 block16) |>.trans (lblock_reach fast221 block17) |>.trans (lblock_reach fast221 block18) |>.trans (lblock_reach fast221 block19) |>.trans (lblock_reach fast221 block20) |>.trans (lblock_reach fast221 block21) |>.trans (lblock_reach fast221 block22) |>.trans (lblock_reach fast221 block23) |>.trans (lblock_reach fast221 block24) |>.trans (lblock_reach fast221 block25) |>.trans (lblock_reach fast221 block26) |>.trans (lblock_reach fast221 block27) |>.trans (lblock_reach fast221 block28) |>.trans (lblock_reach fast221 block29) |>.trans (lblock_reach fast221 block30) |>.trans (lblock_reach fast221 block31)

theorem boot : Reach tm221 (zc 0 [] []) (zc 84 [true] bootRight) := by
  have h := boot_run
  simp only [lconc, cp_state, cp_left, cp_right, zc_padl, zc_padr] at h
  exact h

end SetTheory.BusyBeaver.ZFC.KBoot221
