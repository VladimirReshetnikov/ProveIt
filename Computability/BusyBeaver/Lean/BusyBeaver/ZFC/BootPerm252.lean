    ZipRep (machinePerm252.run (elapsed + 2 ^ depth)) z' := by
  rw [Machine.run_add_eq_runFrom]
  have h := zipBlock_sound fastMachinePerm252 depth before
  rw [calculated, fastMachine_eq] at h
  exact h

