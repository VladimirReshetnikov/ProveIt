    T (imp (imp (imp (imp v0 v1) v1) v2) (imp v0 v2)) :=
  h.mp (d35 h (imp (imp v0 v1) v1) (imp v0 v2) v0 v2) (d45 h v0 v1 v2)

private theorem d48 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp v0 (imp (imp v1 v2) (imp v1 v3))) v2) v2) :=
  h.mp (d40 h (imp (imp v1 v2) (imp v1 v3)) v2 v2 v0) (d46 h v1 v2 v3)

private theorem d49 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp v0 (imp v1 v2)) (imp (imp v1 v0) (imp v1 v2))) :=
  h.mp (d31 h v0 (imp v1 v2) (imp v1 v0) v0) (d48 h (imp v0 (imp v1 v2)) v1 v0 v2)

private theorem d50 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp v0 v1) (imp v0 (imp (imp v1 v2) (imp v3 v2)))) :=
  h.mp (d49 h v1 v0 (imp (imp v1 v2) (imp v3 v2))) (d36 h v1 v0 v2 v3)

