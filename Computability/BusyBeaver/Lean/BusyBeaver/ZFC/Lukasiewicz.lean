import BusyBeaver.ZFC.TarskiComplete

/-!
Finite implicational certificates and the unconditional Tarski logic bridge.

K, S and Peirce follow from modus ponens and Lukasiewicz's single axiom rho8
((c → u) → a) → ((a → c) → (b → c)) alone. The 56 lemmas below are one
condensed-detachment derivation, generated by
`Research/ZFC/k225-formal/rho8cd/generate_domrho8_cd.py --luk` from
`rho8cd/derivation_luk.txt` and found by the untrusted search in `rho8cd/search/`,
seeded with the statements of the 107-step DAG of Jeff's `ZF/m254/coq/logic/CD254.v`
(busy-beaver commit `297ab8df7e5de329605c3875b4934643b371a5e3`, Mira-Cult's
machine) that this module previously ported. No implication injectivity or
assumption about falsity is used.

Ex falso additionally uses the original rho6, whose existential is defined
relative to `NF.bot`. Thus `Tarski.classical` supplies both explicit hypotheses
of the previously conditional `Tarski.completeness`, for any theory predicate `Ax`.

This concerns the named syntax with primitive falsity. It does not identify
that syntax with numerical machine codes, justify the runtime falsity
alias, verify a theory bundle, or prove a binary machine consistency endpoint.
-/

namespace SetTheory.BusyBeaver.ZFC.Lukasiewicz

universe u
variable {α : Type u}

/-- Only the actual implicational row and its inference rule. -/
structure Implicational (imp : α → α → α) (T : α → Prop) : Prop where
  mp : ∀ {a b}, T (imp a b) → T a → T b
  rho8 : ∀ c u a b, T (imp (imp (imp c u) a) (imp (imp a c) (imp b c)))

variable {imp : α → α → α} {T : α → Prop}

private theorem d1 (h : Implicational imp T) (v0 v1 v2 v3 v4 : α) :
    T (imp (imp (imp (imp v0 v1) (imp v2 v1)) (imp v1 v3)) (imp v4 (imp v1 v3))) :=
  h.mp (h.rho8 (imp v1 v3) v0 (imp (imp v0 v1) (imp v2 v1)) v4) (h.rho8 v1 v3 v0 v2)

private theorem d2 (h : Implicational imp T) (v0 v1 v2 v3 v4 v5 : α) :
    T (imp (imp (imp v0 (imp v1 v2)) (imp (imp v3 v1) (imp v4 v1))) (imp v5 (imp (imp v3 v1) (imp v4 v1)))) :=
  h.mp (h.rho8 (imp (imp v3 v1) (imp v4 v1)) (imp v1 v2) (imp v0 (imp v1 v2)) v5) (d1 h v3 v1 v4 v2 v0)

private theorem d3 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp v0 (imp (imp (imp v1 v2) v1) (imp v3 v1))) :=
  h.mp (d2 h (imp v1 v0) v1 v2 (imp v1 v2) v3 v0) (h.rho8 v1 v0 (imp v1 v2) v3)

private theorem d4 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp (imp v0 v1) v0) (imp v2 v0)) :=
  h.mp (d3 h (imp (imp (imp v0 v0) v0) (imp (imp v0 v0) (imp v0 v0))) v0 v1 v2) (h.rho8 v0 v0 v0 v0)

private theorem d5 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp v0 v1) (imp v1 v2)) (imp v3 (imp v1 v2))) :=
  h.mp (h.rho8 (imp v1 v2) v1 (imp v0 v1) v3) (d4 h v1 v2 v0)

private theorem d6 (h : Implicational imp T) (v0 v1 v2 v3 v4 : α) :
    T (imp (imp (imp v0 (imp v1 v2)) (imp v3 v1)) (imp v4 (imp v3 v1))) :=
  h.mp (h.rho8 (imp v3 v1) (imp v1 v2) (imp v0 (imp v1 v2)) v4) (d5 h v3 v1 v2 v0)

private theorem d7 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp v0 (imp (imp (imp (imp v1 v2) v3) v2) (imp v1 v2))) :=
  h.mp (d6 h (imp v2 v0) (imp v1 v2) v3 (imp (imp (imp v1 v2) v3) v2) v0) (h.rho8 v2 v0 (imp (imp v1 v2) v3) v1)

private theorem d8 (h : Implicational imp T) (v0 v1 v2 v3 v4 v5 : α) :
    T (imp (imp (imp v0 (imp v1 v2)) (imp v3 (imp v2 v4))) (imp v5 (imp v3 (imp v2 v4)))) :=
  h.mp (h.rho8 (imp v3 (imp v2 v4)) (imp v1 v2) (imp v0 (imp v1 v2)) v5) (d6 h v3 v2 v4 v1 v0)

private theorem d9 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp (imp (imp v0 v1) v2) v1) (imp v0 v1)) :=
  h.mp (d7 h (imp (imp (imp v0 v0) v0) (imp (imp v0 v0) (imp v0 v0))) v0 v1 v2) (h.rho8 v0 v0 v0 v0)

private theorem d10 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp v0 (imp (imp (imp v1 v2) v3) (imp v2 v3))) :=
  h.mp (d8 h (imp v3 v0) v1 v2 (imp (imp v1 v2) v3) v3 v0) (h.rho8 v3 v0 (imp v1 v2) v2)

private theorem d11 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp v0 v1) (imp (imp v0 v1) v2)) (imp v3 (imp (imp v0 v1) v2))) :=
  h.mp (h.rho8 (imp (imp v0 v1) v2) v1 (imp v0 v1) v3) (d9 h v0 v1 v2)

private theorem d12 (h : Implicational imp T) (v0 v1 : α) :
    T (imp v0 (imp v1 v0)) :=
  h.mp (d9 h v0 (imp v1 v0) v0) (d4 h v0 (imp v1 v0) v1)

private theorem d13 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp (imp v0 v1) v2) (imp v1 v2)) :=
  h.mp (d10 h (imp (imp (imp v0 v0) v0) (imp (imp v0 v0) (imp v0 v0))) v0 v1 v2) (h.rho8 v0 v0 v0 v0)

private theorem d14 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp v0 (imp (imp (imp v1 v2) v1) v1)) :=
  h.mp (d11 h (imp v1 v2) v1 v1 v0) (d4 h v1 v2 (imp (imp v1 v2) v1))

private theorem d15 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp v0 (imp (imp v0 v1) (imp v2 v1))) :=
  h.mp (d13 h (imp v1 v0) v0 (imp (imp v0 v1) (imp v2 v1))) (h.rho8 v1 v0 v0 v2)

private theorem d16 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp v0 (imp v1 (imp v2 v0))) :=
  h.mp (d13 h v2 v0 (imp v1 (imp v2 v0))) (d12 h (imp v2 v0) v1)

private theorem d17 (h : Implicational imp T) (v0 v1 : α) :
    T (imp (imp (imp v0 v1) v0) v0) :=
  h.mp (d14 h (imp (imp (imp v0 v0) v0) (imp (imp v0 v0) (imp v0 v0))) v0 v1) (h.rho8 v0 v0 v0 v0)

private theorem d18 (h : Implicational imp T) (v0 v1 v2 v3 v4 : α) :
    T (imp (imp (imp (imp (imp v0 v1) v2) (imp v3 v2)) v0) (imp v4 v0)) :=
  h.mp (h.rho8 v0 v1 (imp (imp (imp v0 v1) v2) (imp v3 v2)) v4) (d15 h (imp v0 v1) v2 v3)

private theorem d19 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp v0 (imp v0 v1)) (imp v2 (imp v0 v1))) :=
  h.mp (h.rho8 (imp v0 v1) v0 v0 v2) (d17 h v0 v1)

private theorem d20 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp v0 (imp (imp v1 (imp v1 v2)) (imp v1 v2))) :=
  h.mp (d11 h v1 (imp v1 v2) (imp v1 v2) v0) (d19 h v1 v2 (imp v1 (imp v1 v2)))

private theorem d21 (h : Implicational imp T) (v0 v1 : α) :
    T (imp (imp v0 (imp v0 v1)) (imp v0 v1)) :=
  h.mp (d20 h (imp (imp (imp v0 v0) v0) (imp (imp v0 v0) (imp v0 v0))) v0 v1) (h.rho8 v0 v0 v0 v0)

private theorem d22 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp (imp (imp v0 v1) v2) (imp v3 v2)) v0) v0) :=
  h.mp (d21 h (imp (imp (imp (imp v0 v1) v2) (imp v3 v2)) v0) v0) (d18 h v0 v1 v2 v3 (imp (imp (imp (imp v0 v1) v2) (imp v3 v2)) v0))

private theorem d23 (h : Implicational imp T) (v0 v1 v2 v3 v4 : α) :
    T (imp (imp v0 (imp (imp (imp v0 v1) v2) (imp v3 v2))) (imp v4 (imp (imp (imp v0 v1) v2) (imp v3 v2)))) :=
  h.mp (h.rho8 (imp (imp (imp v0 v1) v2) (imp v3 v2)) v0 v0 v4) (d22 h v0 v1 v2 v3)

private theorem d24 (h : Implicational imp T) (v0 v1 v2 v3 v4 v5 : α) :
    T (imp (imp (imp v0 (imp (imp (imp v1 v2) v3) (imp v4 v3))) v1) (imp v5 v1)) :=
  h.mp (h.rho8 v1 (imp (imp (imp v1 v2) v3) (imp v4 v3)) (imp v0 (imp (imp (imp v1 v2) v3) (imp v4 v3))) v5) (d23 h v1 v2 v3 v4 v0)

private theorem d25 (h : Implicational imp T) (v0 v1 v2 v3 v4 : α) :
    T (imp (imp (imp v0 (imp (imp (imp v1 v2) v3) (imp v4 v3))) v1) v1) :=
  h.mp (d21 h (imp (imp v0 (imp (imp (imp v1 v2) v3) (imp v4 v3))) v1) v1) (d24 h v0 v1 v2 v3 v4 (imp (imp v0 (imp (imp (imp v1 v2) v3) (imp v4 v3))) v1))

private theorem d26 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp v0 (imp v1 v2)) v1) (imp v3 v1)) :=
  h.mp (h.rho8 v1 v2 (imp v0 (imp v1 v2)) v3) (d12 h (imp v1 v2) v0)

private theorem d27 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp (imp v0 (imp v1 v2)) v1) v1) :=
  h.mp (d21 h (imp (imp v0 (imp v1 v2)) v1) v1) (d26 h v0 v1 v2 (imp (imp v0 (imp v1 v2)) v1))

private theorem d28 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp v0 (imp v1 (imp v0 v2))) (imp v3 (imp v1 (imp v0 v2)))) :=
  h.mp (h.rho8 (imp v1 (imp v0 v2)) v0 v0 v3) (d27 h v1 v0 v2)

private theorem d29 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp v0 (imp (imp v1 v2) (imp (imp (imp v2 v3) v1) v2))) :=
  h.mp (d28 h (imp (imp v2 v3) v1) (imp v1 v2) v2 v0) (h.rho8 v2 v3 v1 (imp (imp v2 v3) v1))

private theorem d30 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp v0 v1) (imp (imp (imp v1 v2) v0) v1)) :=
  h.mp (d29 h (imp (imp (imp v0 v0) v0) (imp (imp v0 v0) (imp v0 v0))) v0 v1 v2) (h.rho8 v0 v0 v0 v0)

private theorem d31 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp (imp (imp v0 v1) (imp v2 v1)) v3) v0) (imp (imp v0 v1) (imp v2 v1))) :=
  h.mp (d30 h v0 (imp (imp v0 v1) (imp v2 v1)) v3) (d15 h v0 v1 v2)

private theorem d32 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp (imp v0 (imp v1 v2)) v3) v2) (imp v0 (imp v1 v2))) :=
  h.mp (d30 h v2 (imp v0 (imp v1 v2)) v3) (d16 h v2 v0 v1)

private theorem d33 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp (imp v0 (imp v1 v2)) v3) (imp v1 (imp v1 v2))) (imp v0 (imp v1 v2))) :=
  h.mp (d30 h (imp v1 (imp v1 v2)) (imp v0 (imp v1 v2)) v3) (d19 h v1 v2 v0)

private theorem d34 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp v0 (imp v1 v2)) (imp (imp (imp v0 v3) v2) (imp v1 v2))) :=
  h.mp (d31 h v0 (imp v1 v2) (imp (imp v0 v3) v2) v0) (d25 h (imp v0 (imp v1 v2)) v0 v3 v2 v1)

private theorem d35 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp v0 v1) (imp v2 v3)) (imp (imp v0 v3) (imp v2 v3))) :=
  h.mp (d34 h v0 (imp v0 v3) (imp v2 v3) v1) (d15 h v0 v3 v2)

private theorem d36 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp v0 (imp v1 (imp (imp v0 v2) (imp v3 v2)))) :=
  h.mp (d32 h v0 v1 (imp (imp v0 v2) (imp v3 v2)) (imp v3 v2)) (d35 h v0 (imp v1 (imp (imp v0 v2) (imp v3 v2))) v3 v2)

private theorem d37 (h : Implicational imp T) (v0 v1 : α) :
    T (imp v0 (imp (imp v0 v1) v1)) :=
  h.mp (d33 h v0 (imp v0 v1) v1 (imp (imp v0 v1) v1)) (d35 h v0 (imp (imp v0 v1) v1) (imp v0 v1) v1)

private theorem d38 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp v0 (imp (imp (imp v1 v0) v2) v2)) :=
  h.mp (d13 h v1 v0 (imp (imp (imp v1 v0) v2) v2)) (d37 h (imp v1 v0) v2)

private theorem d39 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp (imp v0 v1) v2) (imp (imp v0 v2) v2)) :=
  h.mp (d34 h v0 (imp v0 v2) v2 v1) (d37 h v0 v2)

private theorem d40 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp v0 v1) v2) (imp (imp (imp v3 v0) v2) v2)) :=
  h.mp (d34 h v0 (imp (imp v3 v0) v2) v2 v1) (d38 h v0 v3 v2)

private theorem d41 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp v0 v1) (imp (imp (imp v2 (imp v0 v3)) v1) v1)) :=
  h.mp (d35 h v0 v3 (imp (imp v2 (imp v0 v3)) v1) v1) (d38 h (imp v0 v3) v2 v1)

private theorem d42 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp (imp (imp v0 v1) v1) (imp v0 v2)) (imp v3 (imp v0 v2))) :=
  h.mp (h.rho8 (imp v0 v2) v1 (imp (imp v0 v1) v1) v3) (d39 h v0 v2 v1)

private theorem d43 (h : Implicational imp T) (v0 v1 v2 v3 : α) :
    T (imp (imp v0 (imp v1 (imp v2 (imp v0 v3)))) (imp v1 (imp v2 (imp v0 v3)))) :=
  h.mp (d39 h v0 v3 (imp v1 (imp v2 (imp v0 v3)))) (d16 h (imp v0 v3) v1 v2)

private theorem d44 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp v0 (imp (imp (imp v0 v1) v2) v2)) (imp (imp (imp v0 v1) v2) v2)) :=
  h.mp (d39 h v0 v1 (imp (imp (imp v0 v1) v2) v2)) (d37 h (imp v0 v1) v2)

private theorem d45 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp (imp (imp v0 v1) v1) (imp v0 v2)) (imp v0 v2)) :=
  h.mp (d21 h (imp (imp (imp v0 v1) v1) (imp v0 v2)) (imp v0 v2)) (d42 h v0 v1 v2 (imp (imp (imp v0 v1) v1) (imp v0 v2)))

private theorem d46 (h : Implicational imp T) (v0 v1 v2 : α) :
    T (imp (imp (imp (imp v0 v1) (imp v0 v2)) v1) v1) :=
  h.mp (d44 h (imp v0 v1) (imp v0 v2) v1) (d41 h v0 v1 (imp v0 v1) v2)

