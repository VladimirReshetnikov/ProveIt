import BusyBeaver.ZFC.RegisterPath

/-!
The literal public `Prog254.v` register program, including every source row.

Source: Jeff's verification of Mira-Cult's machine, busy-beaver commit
297ab8df7e5de329605c3875b4934643b371a5e3,
`ZF/m254/coq/tm/Prog254.v`, SHA-256
1fbc30fcf82a1442ed88d1a1dde412630a431d32a7265d22bdf8517bffe01746.
The same source is unchanged in mira-emmy's PR20 head
0d544f2a2e3c18f12278441a74b7879f31cbe856, which uses this program for the
253-state reduction. The original TMBuilder framework is Wade's. This is
an attributed data/semantics port, not a relicensing of that snapshot.

All 6459 pairs below occur in the original DFS order; each comment is the
original zero-based node number. Only the storage is grouped into balanced
blocks. `lookup_eq_flatten` proves this grouping gives the same nth-row
lookup, including the original (halt,halt) default outside the table.
There is no substitution of the different, 219-node structured Wade DAG.

The finite facts concern the literal register program, not its relation to
any binary machine or to an enumerated proof calculus.
-/

namespace SetTheory.BusyBeaver.ZFC.Prog254

open RegisterPath

set_option maxRecDepth 65536
set_option maxHeartbeats 4000000

abbrev Row := Edge × Edge

def defaultRow : Row := (.halt, .halt)

def rowAt : List Row → Nat → Row
  | [], _ => defaultRow
  | r :: _, 0 => r
  | _ :: rows, n + 1 => rowAt rows n

private theorem rowAt_append (a b : List Row) (n : Nat) :
    rowAt (a ++ b) n =
      if n < a.length then rowAt a n else rowAt b (n - a.length) := by
  induction a generalizing n with
  | nil => simp
  | cons r a ih =>
      cases n with
      | zero => simp [rowAt]
      | succ n => simpa [rowAt] using ih n

/-- Cached left sizes make lookup cheap; validity is checked below. -/
inductive RowTree where
  | leaf (rows : List Row)
  | branch (leftSize : Nat) (left right : RowTree)

def flatten : RowTree → List Row
  | .leaf rows => rows
  | .branch _ left right => flatten left ++ flatten right

def Valid : RowTree → Prop
  | .leaf _ => True
  | .branch n left right => n = (flatten left).length ∧ Valid left ∧ Valid right

instance validDecidable : (tree : RowTree) → Decidable (Valid tree)
  | .leaf _ => isTrue trivial
  | .branch n left right =>
      letI := validDecidable left
      letI := validDecidable right
      inferInstanceAs (Decidable (n = (flatten left).length ∧ Valid left ∧ Valid right))

def lookup : RowTree → Nat → Row
  | .leaf rows, n => rowAt rows n
  | .branch cut left right, n =>
      if n < cut then lookup left n else lookup right (n - cut)

/-- Every row, including out-of-range defaults, agrees with the flat list. -/
theorem lookup_eq_flatten (tree : RowTree) (valid : Valid tree) (n : Nat) :
    lookup tree n = rowAt (flatten tree) n := by
  induction tree generalizing n with
  | leaf rows => rfl
  | branch cut left right ihl ihr =>
      rcases valid with ⟨hc, hl, hr⟩
      simp only [lookup, flatten, rowAt_append, hc]
      split
      · exact ihl hl n
      · exact ihr hr (n - (flatten left).length)

