/-- The 6459 original row pairs, in source order. -/
def literalRows : List Row := flatten literalTree

theorem literalTree_valid : Valid literalTree := by decide

theorem literalRows_length : literalRows.length = 6459 := by decide

def program : Program where
  nodes := lookup literalTree
  root := 0
  nnodes := 6459

/-- Exact public `p254` lookup: nth source pair, with (halt,halt) as default. -/
theorem nodes_eq_literal (n : Nat) :
    program.nodes n = rowAt literalRows n :=
  lookup_eq_flatten literalTree literalTree_valid n

def nodeBound : Edge → Bool
  | .node n => n < 6459
  | _ => true

def registerBound : Edge → Bool
  | .inc r | .decnz r => r < 9
  | _ => true

theorem all_node_targets_bounded :
    literalRows.all (fun row => nodeBound row.1 && nodeBound row.2) = true := by decide

theorem all_register_operands_bounded :
    literalRows.all (fun row => registerBound row.1 && registerBound row.2) = true := by decide

def haltCount (rows : List Row) : Nat :=
  rows.foldl (fun n row => n + (if row.1 = .halt then 1 else 0) +
    (if row.2 = .halt then 1 else 0)) 0

theorem literal_halt_count : haltCount literalRows = 1 := by decide

/-- Public R0: nextproof register 0 is 2; every other register is 0. -/
def initial : Configuration := ⟨[], update (fun _ => 0) 0 2⟩

