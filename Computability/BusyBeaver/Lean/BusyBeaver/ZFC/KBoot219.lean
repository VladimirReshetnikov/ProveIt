import BusyBeaver.ZFC.KBoot219Chunk023
import BusyBeaver.ZFC.KRuntimeCore

/-!
The 219's exact blank-tape bootstrap (port of K230's `Boot230.v`). After 312,617 steps the
machine is in state 84 with `[true]` to its left, a gap of 144 blank cells, and 139 register
blocks: the boot registers (`nextproof = 3`, `param1 = 3`) in physical order, then 130 spare
blocks holding 1. Checked in kernel blocks against the literal table.
Generated by `Research/ZFC/k225-formal/generate_boot219_lean.py`.
-/

namespace SetTheory.BusyBeaver.ZFC.KBoot219

open KZip KBoot KTableCore

set_option maxRecDepth 100000

def bootVs : List Nat := [0, 0, 0, 3, 0, 0, 3, 0, 0] ++ List.replicate 130 1

def bootRight : List Bool := List.replicate 144 false ++ true :: KRuntimeCore.sepsR bootVs

theorem cp_left : cp24.2.1 = [true] ++ List.replicate 9 false := by decide +kernel

theorem cp_right : cp24.2.2 = bootRight ++ List.replicate 0 false := by decide +kernel

theorem cp_state : cp24.1 = 84 := rfl

theorem boot_run : Reach tm219 (zc 0 [] []) (lconc cp24) :=
  (lblock_reach fast219 block1) |>.trans (lblock_reach fast219 block2) |>.trans (lblock_reach fast219 block3) |>.trans (lblock_reach fast219 block4) |>.trans (lblock_reach fast219 block5) |>.trans (lblock_reach fast219 block6) |>.trans (lblock_reach fast219 block7) |>.trans (lblock_reach fast219 block8) |>.trans (lblock_reach fast219 block9) |>.trans (lblock_reach fast219 block10) |>.trans (lblock_reach fast219 block11) |>.trans (lblock_reach fast219 block12) |>.trans (lblock_reach fast219 block13) |>.trans (lblock_reach fast219 block14) |>.trans (lblock_reach fast219 block15) |>.trans (lblock_reach fast219 block16) |>.trans (lblock_reach fast219 block17) |>.trans (lblock_reach fast219 block18) |>.trans (lblock_reach fast219 block19) |>.trans (lblock_reach fast219 block20) |>.trans (lblock_reach fast219 block21) |>.trans (lblock_reach fast219 block22) |>.trans (lblock_reach fast219 block23) |>.trans (lblock_reach fast219 block24)

theorem boot : Reach tm219 (zc 0 [] []) (zc 84 [true] bootRight) := by
  have h := boot_run
  simp only [lconc, cp_state, cp_left, cp_right, zc_padl, zc_padr] at h
  exact h

end SetTheory.BusyBeaver.ZFC.KBoot219
