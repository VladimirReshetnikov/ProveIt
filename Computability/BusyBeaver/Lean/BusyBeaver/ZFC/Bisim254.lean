/-- The per-entry check. -/
def F : Entry → Bool := entryOk t1 t2 cert

theorem start_ok : branchOk t1 t2 cert [] [] 0 = true := by decide +kernel

theorem ok0 : allC F c0 = true := by decide +kernel

theorem ok1 : allC F c1 = true := by decide +kernel

