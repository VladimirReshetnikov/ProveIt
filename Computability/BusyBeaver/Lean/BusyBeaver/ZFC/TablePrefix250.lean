theorem rawTablePrefix250_size : rawTablePrefix250.size = 250 := by decide +kernel

theorem rawTablePrefix250_transition_count :
    (rawTablePrefix250.toList.flatMap (fun row => [row.1, row.2])).length = 500 := by decide +kernel

theorem rawTablePrefix250_targets_bounded :
    rawTablePrefix250.toList.all (fun row =>
      decide (row.1.2.2 ≤ 250 ∧ row.2.2.2 ≤ 250)) = true := by decide +kernel

theorem rawTablePrefix250_halt_edge_count :
    ((rawTablePrefix250.toList.flatMap (fun row => [row.1.2.2, row.2.2.2])).filter
      (fun target => target == 250)).length = 1 := by decide +kernel

/-- The fallback cannot be reached by Fin 250 indices, by the size theorem. -/
def rawActionPrefix250 (state : Fin 250) (bit : Bool) : RawActionPrefix250 :=
  let row := rawTablePrefix250.getD state.val
    ((false, .right, 250), (false, .right, 250))
  if bit then row.2 else row.1

def actionPrefix250 (state : Fin 250) (bit : Bool) : Action 250 :=
  let raw := rawActionPrefix250 state bit
  { write := raw.1, move := raw.2.1,
    next := if h : raw.2.2 < 250 then some ⟨raw.2.2, h⟩ else none }

def machinePrefix250 : Machine 250 where
  transition := actionPrefix250

def typedMachinePrefix250 : TypedMachine (Fin 250) where
  transition state bit :=
    let a := actionPrefix250 state bit
    { write := a.write, move := a.move, next := a.next }

theorem rawActionPrefix250_target_bounded : ∀ (q : Fin 250) (b : Bool),
    (rawActionPrefix250 q b).2.2 ≤ 250 := by decide +kernel

