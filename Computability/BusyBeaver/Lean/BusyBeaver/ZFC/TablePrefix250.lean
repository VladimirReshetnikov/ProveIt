    oldStatePrefix250 (oldLabelPrefix250 q) = q := by decide +kernel

theorem oldLabelPrefix250_injective {q r : Fin 250}
    (h : oldLabelPrefix250 q = oldLabelPrefix250 r) : q = r := by
  calc
    q = oldStatePrefix250 (oldLabelPrefix250 q) := (oldStatePrefix250_oldLabel q).symm
    _ = oldStatePrefix250 (oldLabelPrefix250 r) := congrArg oldStatePrefix250 h
    _ = r := oldStatePrefix250_oldLabel r

