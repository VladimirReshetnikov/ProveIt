def fastMachine253 : Machine 253 where
  transition q b :=
    let row := fastTree253.lookup q.val
    if b then row.2 else row.1

theorem fast_transition_eq : ∀ (q : Fin 253) (b : Bool),
    fastMachine253.transition q b = machine253.transition q b := by decide

theorem fastMachine_eq : fastMachine253 = machine253 := by
  have h : fastMachine253.transition = machine253.transition := by
    funext q b
    exact fast_transition_eq q b
  exact congrArg Machine.mk h

#print axioms fast_transition_eq
#print axioms fastMachine_eq

