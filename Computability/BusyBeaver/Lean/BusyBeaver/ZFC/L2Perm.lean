/-- The fetch (node 133): a nonzero proof list is decremented; an exhausted
one loads the next candidate. -/
abbrev fetch_pos (st : AS) (v : Nat) (hv : st.pl = v + 1) := tr (n := 133) rfl (L2K.fetch_pos st v hv)

/-- The MP branch (node 150). -/
abbrev mp_branch (st : AS) (hc : Clean st) := tr (n := 150) rfl (L2K.mp_branch st hc)

/-- The NIP branch (node 152) when the cache is not the falsity code. -/
abbrev nip_branch (st : AS) (hc : Clean st) (hh : st.p2 ≠ 1) := tr (n := 152) rfl (L2K.nip_branch st hc hh)

/-- The NIP branch halts on the falsity code. -/
theorem nip_halt (st : AS) (hc : Clean st) (hh : st.p2 = 1) :
    ∃ R', Run dagPerm (.node 152) (enc st) .halt R' :=
  let ⟨R', h⟩ := L2K.nip_halt st hc hh
  ⟨R', tr rfl h⟩

