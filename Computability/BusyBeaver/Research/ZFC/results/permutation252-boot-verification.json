  "audit_source": "import BusyBeaver.ZFC.BootPerm252\nimport BusyBeaver.ZFC.RegisterBoxesPerm252\nimport BusyBeaver.ZFC.RegisterMarkPerm252\nimport BusyBeaver.ZFC.RegisterIncrementPerm252\nimport BusyBeaver.ZFC.RegisterDecrementPerm252\n\nopen SetTheory.BusyBeaver SetTheory.BusyBeaver.ZFC\nopen FiniteZipper BootPerm252\n\n#print axioms BootPerm252.zipInitialPerm252_rep\n#print axioms BootPerm252.bootSparesPerm252_values\n#print axioms BootPerm252.bootRegistersPerm252_primary\n#print axioms BootPerm252.bootSparesPerm252_length\n#print axioms BootPerm252.bootRegistersPerm252_length\n#print axioms BootPerm252.advance_boot_checkpoint\n#print axioms BootPerm252.bootChunk1\n#print axioms BootPerm252.bootChunk25\n#print axioms RegisterBoxesPerm252.zero_decrement_zip\n#print axioms RegisterBoxesPerm252.zero_decrement\n#print axioms RegisterMarkPerm252.mark_zip\n#print axioms RegisterMarkPerm252.mark\n#print axioms RegisterIncrementPerm252.increment_zip\n#print axioms RegisterIncrementPerm252.increment\n#print axioms RegisterDecrementPerm252.positive_decrement_zip\n#print axioms RegisterDecrementPerm252.positive_decrement\n\nexample : (machinePerm252.run 82552).state = some \u27e894, by decide\u27e9 :=\n  fullBootstrapPerm252_state\n\nexample (pos : Int) :\n    Tape.read (machinePerm252.run 82552).tape pos = frameRead bootTargetPerm252 pos :=\n  fullBootstrapPerm252_tape pos\n\nexample (elapsed : Nat) (h : elapsed \u2264 82552) :\n    (machinePerm252.run elapsed).state \u2260 none :=\n  fullBootstrapPerm252_active_through elapsed h\n\nexample : bootRegistersPerm252.take 9 = List.replicate 9 0 :=\n  bootRegistersPerm252_primary\n\nexample : Tape.read (machinePerm252.run 82552).tape 42 = true := by\n  rw [fullBootstrapPerm252_tape]\n  decide\n",
