  "audit_source": "import BusyBeaver.ZFC\nopen SetTheory SetTheory.BusyBeaver.ZFC\n#print axioms SeedInvariant254.eq_refl_code\n#print axioms SeedInvariant254.Formula.sound\n#print axioms SeedInvariant254.stack_good\n#print axioms SeedInvariant254.state_safe\n#print axioms SeedInvariant254.program_halts_iff\n#print axioms RMBisim.walk_tree\n#print axioms RMBisim.Bisim.halts\n#print axioms RMBisim.Bisim.symm\n#print axioms RMBisim.check_bisim\n#print axioms RMBisim.check_halts_iff\n#print axioms DirtyProgram254.iter_halts_iff_native_refutation\n#print axioms WellFoundedPart.wf_closure\nexample (N A D X Y L : Nat) :\n    RMDag.IterHalts Dag254.dag254 (L2.enc \u27e8N,3,9,A,D,6,X,Y,L\u27e9) \u2194\n      BProv NativeTheory254.NativeAx [] Form.fBot :=\n  SeedInvariant254.program_halts_iff N A D X Y L\n    (.eqRefl 0) (.all 1 .truth) [.truth, .all 0 .truth]\nexample (h : Enum254.Good 60) : Code254.C254 Code254.F := by\n  have hx := h 3\n  change Code254.C254 Code254.F at hx\n  exact hx\nexample (hc : \u00ac Code254.C254 Code254.F) :\n    \u00ac \u2203 p : SeedInvariant254.Formula, p.code = 1 := by\n  rintro \u27e8p, hp\u27e9\n  have h := p.sound\n  rw [hp] at h\n  exact hc h\n",
