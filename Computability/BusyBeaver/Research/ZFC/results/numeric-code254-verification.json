  "audit_source": "import BusyBeaver.ZFC.NumericCode254\n\nopen SetTheory.BusyBeaver.ZFC\n\n#print axioms NumericCode254.pairing_eq\n#print axioms NumericCode254.wim_eq\n#print axioms NumericCode254.wel_eq\n#print axioms NumericCode254.wal_eq\n#print axioms NumericCode254.weq_eq\n#print axioms NumericCode254.falsity_eq\n#print axioms NumericCode254.wn_eq\n#print axioms NumericCode254.wa_eq\n#print axioms NumericCode254.wex_eq\n#print axioms NumericCode254.rho1_eq\n#print axioms NumericCode254.rho2_eq\n#print axioms NumericCode254.rho3_eq\n#print axioms NumericCode254.rho4_eq\n#print axioms NumericCode254.rho5_eq\n#print axioms NumericCode254.rho6_eq\n#print axioms NumericCode254.rho7_eq\n#print axioms NumericCode254.rho8_eq\n#print axioms NumericCode254.bundleC_eq\n#print axioms NumericCode254.bundleG_eq\n#print axioms NumericCode254.bundle_eq\n#print axioms NumericCode254.c254_of_numThm\n#print axioms NumericCode254.numThm_of_c254\n#print axioms NumericCode254.numThm_iff_c254\n#print axioms NumericCode254.encode_eq\n#print axioms NumericCode254.q_iff_c254\n#print axioms NumericCode254.c254_of_named\n#print axioms NumericCode254.named_refutation_iff\n\nexample : Code254.C254 0 := NumericCode254.c254_of_numThm .truth\nexample {n : Nat} (h : Code254.C254 n) : Numeric254.NumThm n :=\n  NumericCode254.numThm_of_c254 h\nexample (a b c : Nat) (hca : c \u2260 a) (hcb : c \u2260 b) :\n    Code254.C254 (Numeric254.bundle a b c) :=\n  NumericCode254.c254_of_numThm (.bundle a b c hca hcb)\nexample : Tarski.Thm NamedNumeric254.Q Tarski.NF.bot \u2194 Code254.C254 1 :=\n  NumericCode254.named_refutation_iff\n",
