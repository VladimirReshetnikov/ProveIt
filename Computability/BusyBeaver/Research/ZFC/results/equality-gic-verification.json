  "audit_source": "import BusyBeaver.ZFC.EqualityGIC\nimport BusyBeaver.ZFC.NamedForm254\n\nopen SetTheory SetTheory.BusyBeaver.ZFC\n\n#print axioms EqualityGIC.sat_faithfulForm\n#print axioms EqualityGIC.equalityFree_equalityForm\n#print axioms EqualityGIC.sat_equalityForm\n#print axioms EqualityGIC.equalityFree_eraseEquality\n#print axioms EqualityGIC.sat_eraseEquality\n#print axioms EqualityGIC.collection_of_matrix\n#print axioms EqualityGIC.modelsFullGIC\n#print axioms EqualityGIC.faithful_of_singletons\n#print axioms EqualityGIC.faithful_of_pairing\n\nexample {V : Type} (mem : V → V → Prop)\n    (hPair : ∀ x y, ∃ p, ∀ z, mem z p ↔ z=x ∨ z=y)\n    (hGIC : ProfileModel.ModelsGIC mem) :\n    ∀ phi env, Sat mem env (ProfileSyntax.gicForm phi) :=\n  EqualityGIC.modelsFullGIC mem (EqualityGIC.faithful_of_pairing mem hPair) hGIC\n\nexample {V : Type} (mem : V → V → Prop) (env : Nat → V)\n    (hFaith : Sat mem env EqualityGIC.faithfulForm)\n    (hGIC : ProfileModel.ModelsGIC mem) :\n    ∀ phi env', Sat mem env' (ProfileSyntax.gicForm phi) :=\n  EqualityGIC.modelsFullGIC mem ((EqualityGIC.sat_faithfulForm mem env).mp hFaith) hGIC\n\nexample {V : Type} (mem : V → V → Prop) (hFaith : EqualityGIC.Faithful mem)\n    (hGIC : ProfileModel.ModelsGIC mem) (f : Tarski.NF) (a b : Nat) (env : Nat → V) :\n    ProfileCollection.CollectionInstance mem\n      (fun x y => Tarski.Sat mem (Tarski.update (Tarski.update env a x) b y) f) :=\n  ProfileModel.collectionInstance_congr mem _ _\n    (fun x y => NamedForm254.sat_matrix mem f a b env x y)\n    (EqualityGIC.collection_of_matrix mem hFaith hGIC (NamedForm254.matrix f a b) env)\n",
