+/-! ## Semantic site contracts
+
+`SiteContract` states exactly the effect used by the register simulation.  The
+entry configuration is a parameter: this permits a separately certified decoder
+prefix to be composed with a primitive-and-return proof.  The Boolean checker
+is one producer of contracts, not an assumption of the simulation theorem.
+
+The halt contract retains the same explicit terminal-row hypothesis as the
+legacy `runHalt_sound` and `halts_iff` APIs.  A successful old `runHalt` check only
+identifies state 230, so it cannot itself establish that both rows halt.
+-/
+
+def SiteContract (M : TMN) (entry : SConf) (Q : List Bool) : Edge → Prop
+  | .inc r => r < 9 ∧ ∀ n vs, Valid none vs →
+      Reach1 M (conc n vs entry)
+        (conc n vs (tgtConf (incPath Q) (allOnes Q) (.plain (.inc (physOf r)))))
+  | .decnz r => r < 9 ∧
+      (∀ n vs, Valid (some (physOf r, true)) vs →
+        Reach1 M (conc n vs entry)
+          (conc n vs (tgtConf (breakPath 1 Q) (allOnes (stripPath false 1 Q)) (.plain .none)))) ∧
+      (∀ n vs, Valid (some (physOf r, false)) vs →
+        Reach1 M (conc n vs entry)
+          (conc n vs (tgtConf (incPath Q) (allOnes Q) (.plain (.dec (physOf r))))))
+  | .brk k => ∀ n vs, Valid none vs →
+      Reach1 M (conc n vs entry)
+        (conc n vs (tgtConf (breakPath k Q) (allOnes (stripPath false k Q)) (.plain .none)))
+  | .cont k => ∀ n vs, Valid none vs →
+      Reach1 M (conc n vs entry)
+        (conc n vs (tgtConf (continuePath k Q) false (.plain .none)))
+  | .halt => (∀ b, M 230 b = none) → ∀ n vs, 10 ≤ vs.length → Halts M (conc n vs entry)
+  | .node _ => False
+
+structure SiteSpec (M : TMN) (Q : List Bool) (e : Edge) : Prop where
+  length : Q.length ≤ 48
+  effect : SiteContract M (start Q) Q e
+
+/-- A decoder prefix may take zero steps.  The primitive contract supplies
+strictly positive progress for every returning branch. -/
+theorem SiteContract.prepend {M : TMN} {entry port : SConf} {Q : List Bool} {e : Edge}
+    (hprefix : ∀ n vs, Reach M (conc n vs entry) (conc n vs port))
+    (tail : SiteContract M port Q e) : SiteContract M entry Q e := by
+  cases e with
+  | inc r =>
+      exact ⟨tail.1, fun n vs hv => (hprefix n vs).trans_reach1 (tail.2 n vs hv)⟩
+  | decnz r =>
+      exact ⟨tail.1,
+        fun n vs hv => (hprefix n vs).trans_reach1 (tail.2.1 n vs hv),
+        fun n vs hv => (hprefix n vs).trans_reach1 (tail.2.2 n vs hv)⟩
+  | brk k => exact fun n vs hv => (hprefix n vs).trans_reach1 (tail n vs hv)
+  | cont k => exact fun n vs hv => (hprefix n vs).trans_reach1 (tail n vs hv)
+  | halt => exact fun hNH n vs hv => Halts.of_reach (hprefix n vs) (tail hNH n vs hv)
+  | node k => exact tail
+
