def delta (rows : List Action) (q : State) (b : Bool) : Option Action :=
  rows[q.val * 2 + b.toNat]?

def old := delta oldRows
def new := delta newRows

def phi (q : State) : State := if q = 170 then 52 else q

def phiAction (a : Action) : Action := {a with next := phi a.next}

-- Certificates are Boolean list folds.  Unlike a nested Decidable forall,
-- this keeps the reduction certificate linear in the number of rows.
def incomingCondition (q : State) (b : Bool) (a : Action) : Prop :=
  (a.next = 52 → a.write = true ∧ a.right = true) ∧
  (a.next = 170 → (a.write = false ∧ a.right = true) ∨
    (q = 151 ∧ b = true ∧ a.right = true)) ∧
  (a.next = 151 → a.write = true ∧ a.right = false)

instance (q : State) (b : Bool) (a : Action) : Decidable (incomingCondition q b a) :=
  inferInstanceAs (Decidable ((a.next = 52 → a.write = true ∧ a.right = true) ∧
  (a.next = 170 → (a.write = false ∧ a.right = true) ∨
    (q = 151 ∧ b = true ∧ a.right = true)) ∧
  (a.next = 151 → a.write = true ∧ a.right = false)))

def commuteCheck (q : State) (b : Bool) : Bool :=
  decide (q = 52 ∨ q = 170 ∨ new (phi q) b = (old q b).map phiAction)

def haltCheck (q : State) (b : Bool) : Bool :=
  decide ((old q b = none) ↔ (new (phi q) b = none))

def incomingCheck (q : State) (b : Bool) : Bool :=
  match old q b with
  | none => true
  | some a => decide (incomingCondition q b a)

def rowCheck (q : State) (b : Bool) : Bool :=
  commuteCheck q b && haltCheck q b && incomingCheck q b

def checkedState (n : Nat) : State := ⟨n % 216, Nat.mod_lt _ (by decide)⟩

def blockCheck (start len : Nat) : Bool :=
  (List.range len).all (fun n => [false,true].all (rowCheck (checkedState (start+n))))

theorem certificate00 : blockCheck 0 16 = true := by decide +kernel
theorem certificate01 : blockCheck 16 16 = true := by decide +kernel
theorem certificate02 : blockCheck 32 16 = true := by decide +kernel
theorem certificate03 : blockCheck 48 16 = true := by decide +kernel
theorem certificate04 : blockCheck 64 16 = true := by decide +kernel
theorem certificate05 : blockCheck 80 16 = true := by decide +kernel
theorem certificate06 : blockCheck 96 16 = true := by decide +kernel
theorem certificate07 : blockCheck 112 16 = true := by decide +kernel
theorem certificate08 : blockCheck 128 16 = true := by decide +kernel
theorem certificate09 : blockCheck 144 16 = true := by decide +kernel
theorem certificate10 : blockCheck 160 16 = true := by decide +kernel
theorem certificate11 : blockCheck 176 16 = true := by decide +kernel
theorem certificate12 : blockCheck 192 16 = true := by decide +kernel
theorem certificate13 : blockCheck 208 8 = true := by decide +kernel

theorem checks_of_block (start len : Nat) (hc : blockCheck start len = true)
    (q : State) (b : Bool) (hlo : start ≤ q.val) (hhi : q.val < start + len) :
    rowCheck q b = true := by
  have hk : q.val - start < len := by omega
  have hq := List.all_eq_true.mp hc (q.val-start) (List.mem_range.mpr hk)
  have he : checkedState (start + (q.val-start)) = q := by
    apply Fin.ext
    have hn : start + (q.val-start) = q.val := by omega
    simp only [checkedState, hn]
    exact Nat.mod_eq_of_lt q.isLt
  rw [he] at hq
  exact List.all_eq_true.mp hq b (by cases b <;> simp)

theorem checks (q : State) (b : Bool) : rowCheck q b = true := by
  have hq := q.isLt
  by_cases h0 : q.val < 16
  · exact checks_of_block 0 16 certificate00 q b (by omega) (by omega)
  by_cases h1 : q.val < 32
  · exact checks_of_block 16 16 certificate01 q b (by omega) (by omega)
  by_cases h2 : q.val < 48
  · exact checks_of_block 32 16 certificate02 q b (by omega) (by omega)
  by_cases h3 : q.val < 64
  · exact checks_of_block 48 16 certificate03 q b (by omega) (by omega)
  by_cases h4 : q.val < 80
  · exact checks_of_block 64 16 certificate04 q b (by omega) (by omega)
  by_cases h5 : q.val < 96
  · exact checks_of_block 80 16 certificate05 q b (by omega) (by omega)
  by_cases h6 : q.val < 112
  · exact checks_of_block 96 16 certificate06 q b (by omega) (by omega)
  by_cases h7 : q.val < 128
  · exact checks_of_block 112 16 certificate07 q b (by omega) (by omega)
  by_cases h8 : q.val < 144
  · exact checks_of_block 128 16 certificate08 q b (by omega) (by omega)
  by_cases h9 : q.val < 160
  · exact checks_of_block 144 16 certificate09 q b (by omega) (by omega)
  by_cases h10 : q.val < 176
  · exact checks_of_block 160 16 certificate10 q b (by omega) (by omega)
  by_cases h11 : q.val < 192
  · exact checks_of_block 176 16 certificate11 q b (by omega) (by omega)
  by_cases h12 : q.val < 208
  · exact checks_of_block 192 16 certificate12 q b (by omega) (by omega)
  exact checks_of_block 208 8 certificate13 q b (by omega) (by omega)

theorem commute (q : State) (b : Bool) (h52 : q ≠ 52) (h170 : q ≠ 170) :
    new (phi q) b = (old q b).map phiAction := by
  have h := checks q b
  simp only [rowCheck, Bool.and_eq_true] at h
  have hc : q = 52 ∨ q = 170 ∨ new (phi q) b = (old q b).map phiAction :=
    of_decide_eq_true h.1.1
  rcases hc with h | h | h
  · exact (h52 h).elim
  · exact (h170 h).elim
  · exact h

theorem halt_agrees (q : State) (b : Bool) :
    (old q b = none) ↔ (new (phi q) b = none) := by
  have h := checks q b
  simp only [rowCheck, Bool.and_eq_true] at h
  exact of_decide_eq_true h.1.2

theorem incoming (q : State) (b : Bool) :
    match old q b with
    | none => True
    | some a => incomingCondition q b a := by
  have h := checks q b
  simp only [rowCheck, Bool.and_eq_true] at h
  have hi := h.2
  unfold incomingCheck at hi
  cases he : old q b with
  | none => trivial
  | some a =>
    simp only [he] at hi
    exact of_decide_eq_true hi

end CM215
