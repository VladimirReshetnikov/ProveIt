import PositiveSimulation

/-!
Exact all-tape halting equivalence between native K215 and the new FM215.
K215 is inherited; FM215 is a new four-row predecessor-marker transformation.
This file supplies a new compact formal proof of their equivalence.
Only Init (through PositiveSimulation) is needed.  No consistency premise.
-/
namespace FM215

abbrev State := Fin 512
abbrev Action := Bool × Bool × State
abbrev Table := State → Bool → Option Action
abbrev Tape := Int → Bool

structure Config where
  q : State
  head : Int
  tape : Tape

def put (t : Tape) (h : Int) (b : Bool) : Tape := fun i => if i = h then b else t i

def advance (c : Config) (a : Action) : Config :=
  ⟨a.2.2, c.head + (if a.2.1 then 1 else -1), put c.tape c.head a.1⟩

def step (M : Table) (c : Config) : Option Config :=
  (M c.q (c.tape c.head)).map (advance c)

def phi (q : State) : State := if q = 127 then 124 else q

def mapAction (a : Action) : Action := (a.1, a.2.1, phi a.2.2)

def lift (c : Config) : Config := { c with q := phi c.q }

def Inv (c : Config) : Prop :=
  (c.q = 124 → c.tape (c.head - 1) = true) ∧
  (c.q = 127 → c.tape (c.head - 1) = false)

theorem put_same {t : Tape} {h : Int} {b : Bool} (hb : t h = b) : put t h b = t := by
  funext i
  by_cases hi : i = h
  · subst i; simp [put, hb]
  · simp [put, hi]

theorem step_same {M : Table} {c : Config} {w right : Bool} {z : State}
    (hc : c.tape c.head = w) (hr : M c.q w = some (w, right, z)) :
    step M c = some ⟨z, c.head + (if right then 1 else -1), c.tape⟩ := by
  simp only [step, hc, hr, Option.map_some, advance, put_same hc]

