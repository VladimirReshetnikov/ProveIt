+/-! ## Semantic admission boundary
+
+The simulation consumes proof-valued edge contracts.  The bounded Boolean
+executor is one producer of such contracts; compositional primitive proofs may
+supply them directly.  No completeness of `runTo` or `runHalt` is assumed. -/
+
+/-- An edge must make positive physical progress for every allowed register
+valuation and every natural gap. -/
+def RunContract (M : TMN) (br : Branch) (source target : SConf) : Prop :=
+  ∀ (n : Nat) {vs : List Nat}, Valid br vs →
+    Reach1 M (conc n vs source) (conc n vs target)
+
+/-- The exact semantic obligations previously discharged inside `checkEdge`.
+The path is the full consumed source word, not a role suffix. -/
+def PortContract (M : TMN) (source : SConf) (Q : List Bool) : Edge → Prop
+  | .inc r => (Q.length ≤ 48 ∧ r < 9) ∧
+      RunContract M none source (tgtConf (incPath Q) (allOnes Q) (.plain (.inc (physOf r))))
+  | .decnz r => ((Q.length ≤ 48 ∧ r < 9) ∧
+      RunContract M (some (physOf r, true)) source
+        (tgtConf (breakPath 1 Q) (allOnes (stripPath false 1 Q)) (.plain .none))) ∧
+      RunContract M (some (physOf r, false)) source
+        (tgtConf (incPath Q) (allOnes Q) (.plain (.dec (physOf r))))
+  | .brk k => Q.length ≤ 48 ∧
+      RunContract M none source (tgtConf (breakPath k Q) (allOnes (stripPath false k Q)) (.plain .none))
+  | .cont k => Q.length ≤ 48 ∧
+      RunContract M none source (tgtConf (continuePath k Q) false (.plain .none))
+  | .halt => Q.length ≤ 48 ∧ HaltAt M source
+  | .node _ => False
+
+/-- Dispatch-entry specialization of a primitive-port contract. -/
+abbrev EdgeContract (M : TMN) (Q : List Bool) (e : Edge) : Prop :=
+  PortContract M (start Q) Q e
+
+/-- Decoder prefixes may take zero steps. Positive progress is supplied by
+nonhalting primitive contracts and is preserved under this composition. -/
+theorem PortContract.precompose {M : TMN} {source port : SConf} {Q : List Bool} {e : Edge}
+    (hprefix : ∀ n vs, Reach M (conc n vs source) (conc n vs port))
+    (suffix : PortContract M port Q e) : PortContract M source Q e := by
+  have next {br : Branch} {target : SConf} (h : RunContract M br port target) :
+      RunContract M br source target := by
+    intro n vs hv
+    exact (hprefix n vs).trans_reach1 (h n hv)
+  have halt (h : HaltAt M port) : HaltAt M source := by
+    intro n vs hv
+    obtain ⟨T, hr, hq⟩ := h n hv
+    exact ⟨T, (hprefix n vs).trans hr, hq⟩
+  cases e with
+  | node _ => exact suffix
+  | inc r => exact ⟨suffix.1, next suffix.2⟩
+  | decnz r => exact ⟨⟨suffix.1.1, next suffix.1.2⟩, next suffix.2⟩
+  | brk k | cont k => exact ⟨suffix.1, next suffix.2⟩
+  | halt => exact ⟨suffix.1, halt suffix.2⟩
+
+theorem EdgeContract.length {M : TMN} {Q : List Bool} {e : Edge}
+    (h : EdgeContract M Q e) : Q.length ≤ 48 := by
+  cases e <;> simp_all [EdgeContract, PortContract]
+
+/-- Compatibility adapter: every existing Boolean site certificate supplies
+semantic coverage, without changing a single checker computation. -/
+theorem checkEdge_contract {M : TMN} (B : BoxLemmas M) {Q : List Bool} {e : Edge}
+    (h : checkEdge M Q e = true) : EdgeContract M Q e := by
+  cases e with
+  | node _ => simp [checkEdge] at h
+  | inc r =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨h.1, fun n {vs} hv => runTo_sound B h.2 n hv⟩
+  | decnz r =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨⟨h.1.1, fun n {vs} hv => runTo_sound B h.1.2 n hv⟩,
+        fun n {vs} hv => runTo_sound B h.2 n hv⟩
+  | brk k =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨h.1, fun n {vs} hv => runTo_sound B h.2 n hv⟩
+  | cont k =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨h.1, fun n {vs} hv => runTo_sound B h.2 n hv⟩
+  | halt =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨h.1, runHalt_at B h.2⟩
 
