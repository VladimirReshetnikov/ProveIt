+  have closedC : Proof T [b, g, f] c :=
+    .mp (.ax (basisP h c u)) (discharge h hc)
+  have result : Proof T [] (Code254.rho8 a b c u) :=
+    discharge h (discharge h (discharge h closedC))
+  exact proof_sound h result (by intro x hx; cases hx)
+
+end
