import BusyBeaver.ZFC.RMAutoCertificate
import BusyBeaver.ZFC.KSource215Data

/-!
Executable staging for the inferred K215 correspondence.

This file proves nothing by executable evaluation. It writes a literal cache
that must subsequently pass the ordinary kernel-checked normalized checker.
The final semantic theorem must not assume cache equality with this generator.
-/

open SetTheory.BusyBeaver.ZFC
open RegisterPath RMBisim KSource215 RMAutoCertificate

private def showEntry : Entry → String
  | (a, b, c, d) => s!"({a}, {b}, {c}, {d})"

private def jsonEntry : Entry → String
  | (a, b, c, d) => s!"[{a},{b},{c},{d}]"

private def showTree : Nat → List Entry → String
  | 0, _ => "(.empty)"
  | _ + 1, [] => "(.empty)"
  | _ + 1, [x] => s!"(.leaf {showEntry x})"
  | f + 1, xs =>
      let cut := xs.length / 2
      s!"(.branch {cut} {showTree f (xs.take cut)} {showTree f (xs.drop cut)})"

private def showBlocks : Nat → List (Nat × String) → String
  | 0, _ => "(.empty)"
  | _ + 1, [] => "(.empty)"
  | _ + 1, [(_, name)] => name
  | f + 1, xs =>
      let half := xs.length / 2
      let left := xs.take half
      let right := xs.drop half
      let cut := left.foldl (fun n item => n + item.1) 0
      s!"(.branch {cut} {showBlocks f left} {showBlocks f right})"

private def header : String :=
  "import BusyBeaver.ZFC.RMNormalizedBisim\n" ++
  "import BusyBeaver.ZFC.KSource215Data\n\n" ++
  "/- Generated by KSource215AutoEmit.lean from the two literal source trees.\n" ++
  "   Untrusted certificate cache; acceptance requires the kernel checker.\n" ++
  "   No correctness of the executable generator is assumed. -/\n\n" ++
  "namespace SetTheory.BusyBeaver.ZFC.KSource215Auto\n" ++
  "open RegisterPath RMBisim RMNormalizedBisim KSource215\n\n"

def main (args : List String) : IO Unit := do
  let destination : System.FilePath := args.headD "generated"
  let rows := RMAutoCertificate.entries t215 tD
  let leftCount := RMAutoCertificate.checkpointCount t215
  let rightCount := RMAutoCertificate.checkpointCount tD
  if leftCount != 1426 || rightCount != 1426 || rows.length != 1426 then
    throw <| IO.userError s!"Unexpected checkpoint counts: {leftCount}, {rightCount}; rows={rows.length}"
  let indices := List.range ((rows.length + 89) / 90)
  let chunks := indices.map (fun i => (rows.drop (90 * i)).take 90)
  let declarations := indices.map (fun i =>
    s!"def block{i} : CTree := {showTree 32 (chunks.getD i [])}\n")
  let blocks := indices.map (fun i => ((chunks.getD i []).length, s!"block{i}"))
  let source := header ++ String.intercalate "\n" declarations ++
    s!"\ndef inferredCertificate : CTree := {showBlocks 32 blocks}\n\n" ++
    "def checkEntry : Entry → Bool :=\n" ++
    "  RMNormalizedBisim.entryOk t215 tD inferredCertificate\n\n" ++
    "end SetTheory.BusyBeaver.ZFC.KSource215Auto\n"
  IO.FS.createDirAll destination
  IO.FS.writeFile (destination / "KSource215AutoData.lean") source
  IO.FS.writeFile (destination / "entries.json")
    ("[\n" ++ String.intercalate ",\n" (rows.map jsonEntry) ++ "\n]\n")
  IO.FS.writeFile (destination / "emission.json")
    ("{\"rows\":" ++ toString rows.length ++
     ",\"left_checkpoints\":" ++ toString leftCount ++
     ",\"right_checkpoints\":" ++ toString rightCount ++
     ",\"blocks\":" ++ toString chunks.length ++
     ",\"acceptance_requires_kernel_check\":true}\n")
  IO.println s!"Emitted {rows.length} entries in {chunks.length} literal blocks to {destination}"
