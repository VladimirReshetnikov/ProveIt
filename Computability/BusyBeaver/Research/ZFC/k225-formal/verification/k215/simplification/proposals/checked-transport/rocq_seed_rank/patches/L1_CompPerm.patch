+(** One ranking argument replaces candidate drainage and repeated reach inductions.
+    It applies even when the initial proof-list pointer is nonzero. *)
+Definition candidate_rank (N : nat) (s : state) : nat :=
+  (N - np s) * (N + 1) + pl s.
+
+Lemma candidate_rank_step N s s' : np s <= N ->
+  ~ (pl s = 0 /\ np s = N) -> enum_step s = Some s' ->
+  np s' <= N /\ candidate_rank N s' < candidate_rank N s.
+Proof.
+  intros Hnp Hnot Estep. pose proof (step_pl s s' Estep) as [Hp Hn].
+  unfold candidate_rank. destruct (pl s) as [|p] eqn:Epl.
+  - cbn in Hp, Hn. assert (Hlt : np s < N) by lia.
+    split; [lia|]. assert (Hsub : N - np s' + 1 = N - np s) by lia. nia.
+  - cbn in Hp, Hn. rewrite Hn. split; [exact Hnp|lia].
+Qed.
+
+(** The witness is bounded by the initial rank; no invariant on formula registers
+    or the stack is needed for this scheduler theorem. *)
+Lemma find_candidate_bounded N s : np s <= N ->
+  exists n t, n <= candidate_rank N s /\ run n s = Some t /\
+    (enum_step t = None \/ (pl t = 0 /\ np t = N)).
+Proof.
+  intros Hnp. remember (candidate_rank N s) as m eqn:Em.
+  revert s Em Hnp. induction m using lt_wf_ind. intros s Em Hnp.
+  destruct (Nat.eq_dec (pl s + (N - np s)) 0) as [Eend|Enot].
+  - exists 0, s. split; [lia|]. split; [reflexivity|]. right; lia.
+  - destruct (enum_step s) as [s'|] eqn:E.
+    + destruct (candidate_rank_step N s s' Hnp ltac:(intros [Hp Hn]; lia) E)
+        as [Hnp' Hrank].
+      destruct (H (candidate_rank N s') ltac:(lia) s' eq_refl Hnp')
+        as [n [t [Hn [Hr Hend]]]].
+      exists (S n), t. split; [lia|]. split; [cbn; now rewrite E|exact Hend].
+    + exists 0, s. split; [lia|]. split; [reflexivity|]. now left.
+Qed.
+
