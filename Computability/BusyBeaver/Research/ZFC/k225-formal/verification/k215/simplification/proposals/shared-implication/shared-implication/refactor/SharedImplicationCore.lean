private theorem d63 (v0 v1 v2 : A) :
    T (wim (wim v0 (wim v1 v2)) (wim (wim v0 v1) (wim v0 v2))) :=
  h.mp (d62 h (wim v0 v1) (wim v0 (wim v1 v2)) (wim v0 v2)) (d61 h v0 v1 v2)

/-- Restricted rows and modus ponens alone derive every unrestricted row. -/
theorem rho8_all (a b c u : A) : T (rho8 L a b c u) :=
  d56 h c u a b

theorem composition (a b c : A) :
    T (L.imp (L.imp a b) (L.imp (L.imp b c) (L.imp a c))) :=
  d58 h a b c

/-- A proved implication lifts under any antecedent. -/
theorem lift_right {a b : A} (hab : T (L.imp a b)) (x : A) :
    T (L.imp (L.imp x a) (L.imp x b)) :=
  h.mp (d55 h a b x) hab

/-- The K basis is already node 12 of the shared derivation. -/
theorem k (a b : A) : T (L.imp a (L.imp b a)) :=
  d12 h a b

/-- Peirce is already node 18 of the shared derivation. -/
theorem peirce (a b : A) : T (L.imp (L.imp (L.imp a b) a) a) :=
  d18 h a b

/-- S follows using five additional modus-ponens steps. -/
theorem s (a b c : A) :
    T (L.imp (L.imp a (L.imp b c)) (L.imp (L.imp a b) (L.imp a c))) :=
  d63 h a b c

end
