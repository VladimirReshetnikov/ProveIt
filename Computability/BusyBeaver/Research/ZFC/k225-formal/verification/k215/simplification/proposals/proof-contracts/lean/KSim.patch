+/-! ## Semantic site specifications
+
+The simulator consumes these concrete contracts. The Boolean executor is one
+producer; decoder-prefix and primitive proofs may supply the same contracts.
+The positive clock in RunToSpec is essential to backward halting transfer.
+-/
+
+def RunToSpec (M : TMN) (br : Branch) (Q : List Bool) (target : SConf) : Prop :=
+  ∀ (n : Nat) {vs : List Nat}, Valid br vs →
+    Reach1 M (conc n vs (start Q)) (conc n vs target)
+
+def HaltPortSpec (M : TMN) (Q : List Bool) : Prop :=
+  ∀ (n : Nat) {vs : List Nat}, 10 ≤ vs.length →
+    ∃ c, Reach M (conc n vs (start Q)) c ∧ c.q = 230
+
+theorem HaltPortSpec.halts {M : TMN} {Q : List Bool}
+    (h : HaltPortSpec M Q) (hNH : ∀ b, M 230 b = none)
+    (n : Nat) {vs : List Nat} (hv : 10 ≤ vs.length) : Halts M (conc n vs (start Q)) := by
+  obtain ⟨c, hc, hq⟩ := h n hv
+  exact ⟨c, hc, by simp [KZip.step, hq, hNH]⟩
+
+def EdgeSpec (M : TMN) (Q : List Bool) : Edge → Prop
+  | .inc r => Q.length ≤ 48 ∧ r < 9 ∧
+      RunToSpec M none Q (tgtConf (incPath Q) (allOnes Q) (.plain (.inc (physOf r))))
+  | .decnz r => Q.length ≤ 48 ∧ r < 9 ∧
+      RunToSpec M (some (physOf r, true)) Q
+        (tgtConf (breakPath 1 Q) (allOnes (stripPath false 1 Q)) (.plain .none)) ∧
+      RunToSpec M (some (physOf r, false)) Q
+        (tgtConf (incPath Q) (allOnes Q) (.plain (.dec (physOf r))))
+  | .brk k => Q.length ≤ 48 ∧
+      RunToSpec M none Q (tgtConf (breakPath k Q) (allOnes (stripPath false k Q)) (.plain .none))
+  | .cont k => Q.length ≤ 48 ∧
+      RunToSpec M none Q (tgtConf (continuePath k Q) false (.plain .none))
+  | .halt => Q.length ≤ 48 ∧ HaltPortSpec M Q
+  | .node _ => False
+
+theorem EdgeSpec.length {M : TMN} {Q : List Bool} {e : Edge} (h : EdgeSpec M Q e) :
+    Q.length ≤ 48 := by
+  cases e <;> simp only [EdgeSpec] at h <;> first | exact h.1 | contradiction
+
+/-- The existing checker supplies semantic evidence, with no terminal-row
+hypothesis needed until the final halting theorem. -/
+theorem edgeSpec_of_checkEdge {M : TMN} (B : BoxLemmas M) {Q : List Bool} {e : Edge}
+    (h : checkEdge M Q e = true) : EdgeSpec M Q e := by
+  cases e with
+  | inc r =>
+    simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+    exact ⟨h.1.1, h.1.2, runTo_sound B h.2⟩
+  | decnz r =>
+    simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+    exact ⟨h.1.1.1, h.1.1.2, runTo_sound B h.1.2, runTo_sound B h.2⟩
+  | brk k | cont k =>
+    simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+    exact ⟨h.1, runTo_sound B h.2⟩
+  | halt =>
+    simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+    exact ⟨h.1, runHalt_port B h.2⟩
+  | node k => simp [checkEdge] at h
 
