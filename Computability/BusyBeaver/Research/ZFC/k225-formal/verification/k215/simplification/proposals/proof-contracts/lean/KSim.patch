+/-- Semantic coverage keeps the exact consumed path and decoder result. -/
+def SemanticCovered (M : TMN) (p : Program) : Prop :=
+  ∀ P, ∃ e d, walk p (p.nnodes + 1) p.root P 0 = some (e, d) ∧
+    EdgeSpec M (consume P d) e
+
+theorem covered_semantic {M : TMN} (B : BoxLemmas M) {p : Program}
+    (h : Covered M p) : SemanticCovered M p := by
+  intro P
+  obtain ⟨e, d, hw, hc⟩ := h P
+  exact ⟨e, d, hw, edgeSpec_of_checkEdge B hc⟩
 
