+/-! ## Semantic site contracts
+
+The simulator needs a positive physical realization of each edge, not evidence
+that one particular fuel-limited Boolean checker accepts it.  These contracts
+allow direct prefix/suffix proofs and symbolic-checker certificates to share
+the same simulation induction.  The existing Boolean API remains below.
+-/
+
+/-- The exact semantic conclusion of `runTo_sound`, retaining both the branch
+guard and uniform quantification over the gap and register-file parameters. -/
+def RunContract (M : TMN) (br : Branch) (Q : List Bool) (e : SConf) : Prop :=
+  ∀ (n : Nat) (vs : List Nat), Valid br vs →
+    Reach1 M (conc n vs (start Q)) (conc n vs e)
+
+/-- A halt contract retains the existing generic theorem's state-230 premise. -/
+def HaltContract (M : TMN) (Q : List Bool) : Prop :=
+  (∀ b, M 230 b = none) → ∀ (n : Nat) (vs : List Nat), 10 ≤ vs.length →
+    Halts M (conc n vs (start Q))
+
+/-- Exactly the length, register-index, branch, and positive-run information
+consumed by the simulation.  `node` is deliberately excluded. -/
+def EdgeContract (M : TMN) (Q : List Bool) : Edge → Prop
+  | .inc r => (Q.length ≤ 48 ∧ r < 9) ∧
+      RunContract M none Q (tgtConf (incPath Q) (allOnes Q) (.plain (.inc (physOf r))))
+  | .decnz r => ((Q.length ≤ 48 ∧ r < 9) ∧
+      RunContract M (some (physOf r, true)) Q
+        (tgtConf (breakPath 1 Q) (allOnes (stripPath false 1 Q)) (.plain .none))) ∧
+      RunContract M (some (physOf r, false)) Q
+        (tgtConf (incPath Q) (allOnes Q) (.plain (.dec (physOf r))))
+  | .brk k => Q.length ≤ 48 ∧
+      RunContract M none Q
+        (tgtConf (breakPath k Q) (allOnes (stripPath false k Q)) (.plain .none))
+  | .cont k => Q.length ≤ 48 ∧
+      RunContract M none Q (tgtConf (continuePath k Q) false (.plain .none))
+  | .halt => Q.length ≤ 48 ∧ HaltContract M Q
+  | .node _ => False
+
+theorem edgeContract_length {M : TMN} {Q : List Bool} {e : Edge}
+    (h : EdgeContract M Q e) : Q.length ≤ 48 := by
+  cases e <;> simp_all [EdgeContract]
+
+/-- The old checker is one producer of semantic edge contracts.  No
+completeness of its finite fuel bound is assumed or needed. -/
+theorem checkEdge_contract {M : TMN} (B : BoxLemmas M) {Q : List Bool} {e : Edge}
+    (h : checkEdge M Q e = true) : EdgeContract M Q e := by
+  cases e with
+  | inc r =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨h.1, fun n vs hv => runTo_sound B h.2 n hv⟩
+  | decnz r =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨⟨h.1.1, fun n vs hv => runTo_sound B h.1.2 n hv⟩,
+        fun n vs hv => runTo_sound B h.2 n hv⟩
+  | brk k | cont k =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨h.1, fun n vs hv => runTo_sound B h.2 n hv⟩
+  | halt =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨h.1, fun hNH n vs hv => runHalt_sound B hNH h.2 n hv⟩
+  | node _ => simp [checkEdge] at h
+
+/-- Every decoder input reaches a leaf with a semantic realization. -/
+def SemanticCovered (M : TMN) (p : Program) : Prop :=
+  ∀ P, ∃ e d, walk p (p.nnodes + 1) p.root P 0 = some (e, d) ∧
+    EdgeContract M (consume P d) e
+
+theorem Covered.semantic {M : TMN} (B : BoxLemmas M) {p : Program}
+    (h : Covered M p) : SemanticCovered M p := by
+  intro P
+  obtain ⟨e, d, hw, hc⟩ := h P
+  exact ⟨e, d, hw, checkEdge_contract B hc⟩
+
+/-- Generic finite coverage for any decidable producer of edge contracts. -/
+theorem semanticCovered_of_allSites (M : TMN) (p : Program) (t : RMBisim.Tree)
+    (ht : RMBisim.ptree p = t) (test : List Bool → Edge → Bool)
+    (sound : ∀ Q e, test Q e = true → EdgeContract M Q e)
+    (hs : SiteCoverage.allSites test [] t = true) : SemanticCovered M p := by
+  intro P
+  obtain ⟨e, d, hw⟩ := SiteCoverage.allSites_walk_total test p t ht hs P
+  exact ⟨e, d, hw, sound _ _ (SiteCoverage.allSites_walk test p t ht hs P e d hw)⟩
+
+/-- A selected family may use direct contracts while every remaining site
+keeps the existing symbolic checker.  The shared branch must be proved sound;
+merely selecting a leaf does not discharge its physical execution obligation. -/
+theorem semanticCovered_of_mixedSites {M : TMN} (B : BoxLemmas M)
+    (p : Program) (t : RMBisim.Tree) (ht : RMBisim.ptree p = t)
+    (shared : List Bool → Edge → Bool)
+    (sound : ∀ Q e, shared Q e = true → EdgeContract M Q e)
+    (hs : SiteCoverage.allSites (fun Q e => shared Q e || checkEdge M Q e) [] t = true) :
+    SemanticCovered M p := by
+  apply semanticCovered_of_allSites M p t ht (fun Q e => shared Q e || checkEdge M Q e) _ hs
+  intro Q e h
+  have hh : shared Q e = true ∨ checkEdge M Q e = true := by
+    simpa only [Bool.or_eq_true] using h
+  cases hh with
+  | inl hshared => exact sound Q e hshared
+  | inr hchecked => exact checkEdge_contract B hchecked
+
