+/-- Compatibility adapter: the existing finite checker produces a semantic
+contract without any completeness assumption about its fuel. -/
+theorem checkEdge_sound {Q : List Bool} {e : Edge} (h : checkEdge M Q e = true) :
+    SiteSpec M Q e := by
+  refine ⟨checkEdge_length h, ?_⟩
+  cases e with
+  | inc r =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨h.1.2, fun n vs hv => runTo_sound B h.2 n hv⟩
+  | decnz r =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact ⟨h.1.1.2,
+        fun n vs hv => runTo_sound B h.1.2 n hv,
+        fun n vs hv => runTo_sound B h.2 n hv⟩
+  | brk k =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact fun n vs hv => runTo_sound B h.2 n hv
+  | cont k =>
+      simp only [checkEdge, Bool.and_eq_true, decide_eq_true_eq] at h
+      exact fun n vs hv => runTo_sound B h.2 n hv
+  | halt =>
+      simp only [checkEdge, Bool.and_eq_true] at h
+      exact fun hNH n vs hv => runHalt_sound B hNH h.2 n hv
+  | node k => simp [checkEdge] at h
+
 end Sound
 
