+/-- Coverage by semantic contracts, independent of any finite evaluator. -/
+def SemanticCovered (M : TMN) (p : Program) : Prop :=
+  ∀ P, ∃ e d, walk p (p.nnodes + 1) p.root P 0 = some (e, d) ∧
+    SiteSpec M (consume P d) e
+
+/-- Legacy coverage remains usable without changing its statement. -/
+theorem Covered.to_semantic {M : TMN} (B : BoxLemmas M) {p : Program}
+    (h : Covered M p) : SemanticCovered M p := by
+  intro P
+  obtain ⟨e, d, hw, hc⟩ := h P
+  exact ⟨e, d, hw, checkEdge_sound B hc⟩
+
 theorem covered_of_allSites (M : TMN) (p : Program) (t : RMBisim.Tree) (ht : RMBisim.ptree p = t)
     (hs : SiteCoverage.allSites (checkEdge M) [] t = true) : Covered M p := by
   intro P
   obtain ⟨e, d, hw⟩ := SiteCoverage.allSites_walk_total (checkEdge M) p t ht hs P
   exact ⟨e, d, hw, SiteCoverage.allSites_walk (checkEdge M) p t ht hs P e d hw⟩
+
+/-- Any sound per-leaf certificate can feed the same simulation.  In particular,
+a checker may use shared contracts for selected primitives and the old finite
+checker for all remaining leaves. -/
+theorem semantic_covered_of_allSites (M : TMN) (p : Program) (t : RMBisim.Tree)
+    (ht : RMBisim.ptree p = t) (test : List Bool → Edge → Bool)
+    (hs : SiteCoverage.allSites test [] t = true)
+    (sound : ∀ Q e, test Q e = true → SiteSpec M Q e) : SemanticCovered M p := by
+  intro P
+  obtain ⟨e, d, hw⟩ := SiteCoverage.allSites_walk_total test p t ht hs P
+  exact ⟨e, d, hw, sound _ _ (SiteCoverage.allSites_walk test p t ht hs P e d hw)⟩
 
