+  T (imp (imp (imp (imp v0 v1) (imp v2 v1)) v3) (imp (imp v2 v0) v3)).
+Proof. exact (mp _ _ (d51 (imp v2 v0) (imp (imp v0 v1) (imp v2 v1)) v3) (d51 v2 v0 v1)). Qed.
+
+Lemma d53 v0 v1 v2 :
+  T (imp (imp v0 v1) (imp (imp v0 (imp v1 v2)) (imp v0 v2))).
