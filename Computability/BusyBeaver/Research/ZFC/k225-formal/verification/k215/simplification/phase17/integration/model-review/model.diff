-        Tarski.Sat mem (update (update e 0 x) 1 y) (KEind222.th ψ) := by
-      intro x y
-      rw [← he, update_mk, update_mk]
-      exact sat_mk mem ψ _
-    obtain ⟨C, h1, h2⟩ := hseed (KEind222.th ψ) (eqFree_th ψ) e
-    have h0 : e' 0 = mk mem (e 0) := by rw [← he]
