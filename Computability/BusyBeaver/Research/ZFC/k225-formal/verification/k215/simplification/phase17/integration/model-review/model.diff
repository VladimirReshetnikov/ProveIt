-  | all _ a => eqFree_th a
-
-theorem update_mk (mem : V → V → Prop) (e : Nat → V) (i : Nat) (x : V) :
-    update (fun n => mk mem (e n)) i (mk mem x) = fun n => mk mem (update e i x n) := by
-  funext n; by_cases h : n = i
-  · subst h; simp [update]
-  · simp [update, h]
