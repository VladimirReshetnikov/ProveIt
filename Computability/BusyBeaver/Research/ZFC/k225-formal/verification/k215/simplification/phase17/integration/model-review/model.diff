-      · intro h q
-        obtain ⟨d, rfl⟩ := mk_surj mem q
-        rw [update_mk]
-        exact (sat_mk mem a _).mpr (h d)
-
-/-- **The quotient has the seed property for every named relation.** -/
-theorem fullSeed_quotient (mem : V → V → Prop) (hirr : ∀ x, ¬ mem x x)
-    (hseed : ∀ ψ : NF, KThmK.EqFree ψ → ∀ e : Nat → V,
