-  rw [KEind222.biff, sat_wa]
-  exact ⟨fun ⟨h1, h2⟩ => ⟨h1, h2⟩, fun h => ⟨h.1, h.2⟩⟩
-
-theorem sat_Eind (mem : V → V → Prop) (e : Nat → V) (x y : Nat) :
-    Tarski.Sat mem e (KEind222.Eind x y) ↔ Ind mem (e x) (e y) := by
