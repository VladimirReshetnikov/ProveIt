theorem wim_congr {a b c d : Nat} (h : a = b) (k : c = d) : wim a c = wim b d := by
  cases h
  cases k
  rfl

theorem cast_T {T : Nat → Prop} {x y : Nat} (e : x = y) (h : T x) : T y := e ▸ h

