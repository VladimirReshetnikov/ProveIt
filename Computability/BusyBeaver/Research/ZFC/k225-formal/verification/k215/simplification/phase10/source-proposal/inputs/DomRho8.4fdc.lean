private theorem d14 (v0 v1 v2 : Nat) :
    T (wim v0 (wim (wim (wim v1 v2) v1) v1)) :=
  h.mp (d11 h (wim v1 v2) v1 v1 v0) (d4 h v1 v2 (wim (wim v1 v2) v1))

private theorem d15 (v0 v1 v2 v3 : Nat) :
    T (wim (wim (wim v0 (wim v1 v2)) v1) (wim v3 v1)) :=
  h.mp (h.rho8 (wim v0 (wim v1 v2)) v3 v1 v2 (le_r v0 (le_r v1 (Nat.le_refl _)))) (d12 h (wim v1 v2) v0)

private theorem d16 (v0 v1 v2 : Nat) :
    T (wim v0 (wim (wim v0 v1) (wim v2 v1))) :=
  h.mp (d13 h (wim v1 0) v0 (wim (wim v0 v1) (wim v2 v1))) (h.rho8 v0 v2 v1 0 (Nat.zero_le _))

private theorem d17 (v0 v1 v2 : Nat) :
    T (wim v0 (wim v1 (wim v2 v0))) :=
  h.mp (d13 h v2 v0 (wim v1 (wim v2 v0))) (d12 h (wim v2 v0) v1)

private theorem d18 (v0 v1 : Nat) :
    T (wim (wim (wim v0 v1) v0) v0) :=
  h.mp (d14 h 0 v0 v1) h.truth

private theorem d19 (v0 v1 v2 v3 v4 : Nat) :
    T (wim (wim (wim (wim (wim v0 v1) v2) (wim v3 v2)) v0) (wim v4 v0)) :=
  h.mp (h.rho8 (wim (wim (wim v0 v1) v2) (wim v3 v2)) v4 v0 v1 (le_l (wim v3 v2) (le_l v2 (le_r v0 (Nat.le_refl _))))) (d16 h (wim v0 v1) v2 v3)

private theorem d20 (v0 v1 v2 : Nat) :
    T (wim (wim v0 (wim v0 v1)) (wim v2 (wim v0 v1))) :=
