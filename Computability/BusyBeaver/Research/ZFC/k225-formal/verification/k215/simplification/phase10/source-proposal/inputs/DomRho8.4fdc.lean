private theorem d34 (v0 v1 v2 v3 : Nat) (hb0 : v3 ≤ wim v1 (wim v1 v2)) :
    T (wim (wim (wim (wim v0 (wim v1 v2)) v3) (wim v1 (wim v1 v2))) (wim v0 (wim v1 v2))) :=
  h.mp (d30 h (wim v1 (wim v1 v2)) (wim v0 (wim v1 v2)) v3 hb0) (d20 h v1 v2 v0)

private theorem d35 (v0 v1 : Nat) :
    T (wim v0 (wim (wim v0 v1) v1)) :=
  h.mp (d34 h v0 (wim v0 v1) v1 (wim (wim v0 v1) v1) (le_r (wim v0 v1) (Nat.le_refl _))) (d33 h v0 (wim (wim v0 v1) v1) (wim v0 v1) v1)

