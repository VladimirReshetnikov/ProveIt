private theorem d32 (v0 v1 v2 v3 : Nat) :
    T (wim (wim v0 (wim v1 v2)) (wim (wim (wim v0 v3) v2) (wim v1 v2))) :=
  h.mp (d31 h v0 (wim v1 v2) (wim (wim v0 v3) v2) v0 (Nat.le_refl _)) (d29 h (wim v0 (wim v1 v2)) v0 v3 v2 v1)

private theorem d33 (v0 v1 v2 v3 : Nat) :
    T (wim (wim (wim v0 v1) (wim v2 v3)) (wim (wim v0 v3) (wim v2 v3))) :=
