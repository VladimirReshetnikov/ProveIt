import BusyBeaver.ZFC.Code254

/-!
Dominated rho8 derives unrestricted rho8, for arbitrary natural codes.

`rho8 a b c u` is Lukasiewicz's single axiom ((c → u) → a) → ((a → c) → (b → c)) of the
implicational calculus; `DomImp` grants it only when `u ≤ a`. The 52 lemmas below are one
condensed-detachment derivation of the unrestricted row from truth, modus ponens and the
dominated rows, generated by `Research/ZFC/k225-formal/rho8cd/generate_domrho8_cd.py` from
`rho8cd/derivation.txt` (found by the untrusted search in `rho8cd/search/`; the Rocq lane's
`DomRho8.v` renders the same derivation). Each side condition `u ≤ a` holds because `u` is a
literal subterm of `a` (`le_l`, `le_r`), is the code 0, or is a hypothesis of the lemma.
-/

namespace SetTheory.BusyBeaver.ZFC.DomRho8

open Code254

/-- Truth, modus ponens and the dominated rho8 instances. -/
structure DomImp (T : Nat → Prop) : Prop where
  truth : T 0
  mp : ∀ {a b : Nat}, T (wim a b) → T a → T b
  rho8 : ∀ a b c u : Nat, u ≤ a → T (Code254.rho8 a b c u)

theorem le_l {u x : Nat} (y : Nat) (h : u ≤ x) : u ≤ wim x y :=
  Nat.le_trans h (by have := le_P_left x y; simp only [wim]; omega)

theorem le_r {u y : Nat} (x : Nat) (h : u ≤ y) : u ≤ wim x y :=
  Nat.le_trans h (by have := le_P_right x y; simp only [wim]; omega)

/-- A substitution: the valuation sending variable `i` to the `i`-th code. -/
def sub (l : List Nat) (i : Nat) : Nat := l.getD i 0

theorem wim00 : wim 0 0 = 0 := by simp [wim, P, Cantor.toNat, Cantor.tri]
attribute [local irreducible] wim

section
variable {T : Nat → Prop} (h : DomImp T)
include h

private theorem d1 (v0 v1 v2 v3 v4 : Nat) (hb0 : v3 ≤ v0) :
    T (wim (wim (wim (wim v0 v1) (wim v2 v1)) (wim v1 v3)) (wim v4 (wim v1 v3))) :=
  h.mp (h.rho8 (wim (wim v0 v1) (wim v2 v1)) v4 (wim v1 v3) v0 (le_l (wim v2 v1) (le_l v1 (Nat.le_refl _)))) (h.rho8 v0 v2 v1 v3 hb0)

private theorem d2 (v0 v1 v2 v3 v4 v5 : Nat) (hb0 : v2 ≤ v3) :
    T (wim (wim (wim v0 (wim v1 v2)) (wim (wim v3 v1) (wim v4 v1))) (wim v5 (wim (wim v3 v1) (wim v4 v1)))) :=
  h.mp (h.rho8 (wim v0 (wim v1 v2)) v5 (wim (wim v3 v1) (wim v4 v1)) (wim v1 v2) (le_r v0 (Nat.le_refl _))) (d1 h v3 v1 v4 v2 v0 hb0)

private theorem d3 (v0 v1 v2 v3 : Nat) :
    T (wim v0 (wim (wim (wim v1 v2) v1) (wim v3 v1))) :=
  h.mp (d2 h (wim v1 0) v1 v2 (wim v1 v2) v3 v0 (le_r v1 (Nat.le_refl _))) (h.rho8 (wim v1 v2) v3 v1 0 (Nat.zero_le _))

private theorem d4 (v0 v1 v2 : Nat) :
    T (wim (wim (wim v0 v1) v0) (wim v2 v0)) :=
  h.mp (d3 h 0 v0 v1 v2) h.truth

private theorem d5 (v0 v1 v2 v3 : Nat) :
    T (wim (wim (wim v0 v1) (wim v1 v2)) (wim v3 (wim v1 v2))) :=
  h.mp (h.rho8 (wim v0 v1) v3 (wim v1 v2) v1 (le_r v0 (Nat.le_refl _))) (d4 h v1 v2 v0)

private theorem d6 (v0 v1 v2 v3 v4 : Nat) :
    T (wim (wim (wim v0 (wim v1 v2)) (wim v3 v1)) (wim v4 (wim v3 v1))) :=
  h.mp (h.rho8 (wim v0 (wim v1 v2)) v4 (wim v3 v1) (wim v1 v2) (le_r v0 (Nat.le_refl _))) (d5 h v3 v1 v2 v0)

private theorem d7 (v0 v1 v2 v3 : Nat) :
    T (wim v0 (wim (wim (wim (wim v1 v2) v3) v2) (wim v1 v2))) :=
  h.mp (d6 h (wim v2 0) (wim v1 v2) v3 (wim (wim (wim v1 v2) v3) v2) v0) (h.rho8 (wim (wim v1 v2) v3) v1 v2 0 (Nat.zero_le _))

private theorem d8 (v0 v1 v2 v3 v4 v5 : Nat) :
    T (wim (wim (wim v0 (wim v1 v2)) (wim v3 (wim v2 v4))) (wim v5 (wim v3 (wim v2 v4)))) :=
  h.mp (h.rho8 (wim v0 (wim v1 v2)) v5 (wim v3 (wim v2 v4)) (wim v1 v2) (le_r v0 (Nat.le_refl _))) (d6 h v3 v2 v4 v1 v0)

private theorem d9 (v0 v1 v2 : Nat) :
    T (wim (wim (wim (wim v0 v1) v2) v1) (wim v0 v1)) :=
  h.mp (d7 h 0 v0 v1 v2) h.truth

private theorem d10 (v0 v1 v2 v3 : Nat) :
    T (wim v0 (wim (wim (wim v1 v2) v3) (wim v2 v3))) :=
  h.mp (d8 h (wim v3 0) v1 v2 (wim (wim v1 v2) v3) v3 v0) (h.rho8 (wim v1 v2) v2 v3 0 (Nat.zero_le _))

private theorem d11 (v0 v1 v2 v3 : Nat) :
    T (wim (wim (wim v0 v1) (wim (wim v0 v1) v2)) (wim v3 (wim (wim v0 v1) v2))) :=
  h.mp (h.rho8 (wim v0 v1) v3 (wim (wim v0 v1) v2) v1 (le_r v0 (Nat.le_refl _))) (d9 h v0 v1 v2)

private theorem d12 (v0 v1 : Nat) :
    T (wim v0 (wim v1 v0)) :=
  h.mp (d9 h v0 (wim v1 v0) v0) (d4 h v0 (wim v1 v0) v1)

private theorem d13 (v0 v1 v2 : Nat) :
    T (wim (wim (wim v0 v1) v2) (wim v1 v2)) :=
