  h.mp (d27 h (wim (wim v1 v2) v0) (wim v0 v1) v1) (h.rho8 v0 (wim (wim v1 v2) v0) v1 v2 hb0)

private theorem d31 (v0 v1 v2 v3 : Nat) (hb0 : v3 ≤ v0) :
    T (wim (wim (wim (wim (wim v0 v1) (wim v2 v1)) v3) v0) (wim (wim v0 v1) (wim v2 v1))) :=
