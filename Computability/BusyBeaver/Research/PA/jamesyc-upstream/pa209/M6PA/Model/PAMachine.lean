def dispatcher : Control := target 81
def halt : Control := none
def workingStates : List WorkingState := List.finRange 215
def active (q : WorkingState) : Prop := q.val≠50 ∧ q.val≠122 ∧ q.val≠150 ∧ q.val≠157 ∧ q.val≠205 ∧ q.val≠214
instance (q : WorkingState) : Decidable (active q) := inferInstanceAs (Decidable (_ ∧ _))
def activeStates : List WorkingState := workingStates.filter (fun q => decide (active q))
theorem active_count : activeStates.length=209 := by decide +kernel
theorem row_closed : ∀ q : WorkingState, active q → ∀ b,
    (row q b).next=none ∨ ∃ q', (row q b).next=some q' ∧ active q' := by decide +kernel
