theorem table_exact : (List.range 3947).map code = codes.toList.map some := by decide +kernel
theorem code_eq (i : Nat) : code i = codes[i]? := by
  by_cases hi : i<3947
  · have hh := congrArg (fun xs => xs[i]?) table_exact
    have hc : i<codes.size := by rw [codes_count]; exact hi
    simpa only [List.getElem?_map,List.getElem?_range hi,Option.map_some,
      Array.getElem?_toList,Array.getElem?_eq_getElem hc,Option.some.injEq] using hh
  · have hc : codes[i]?=none := Array.getElem?_eq_none_iff.mpr (by rw [codes_count]; omega)
    simp only [code,hi,ite_false,hc]
theorem baseline_resolve (i : Nat) : resolveAt exactSites i=code i :=
  (M6.Legacy213.SourceEquivalence.baseline_resolve i).trans (code_eq i).symm
