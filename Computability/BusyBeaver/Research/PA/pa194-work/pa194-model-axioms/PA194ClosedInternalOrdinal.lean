variable {M : Type} [Nonempty M] [Structure PRALanguage.language M] [Structure.Eq PRALanguage.language M] [M↓[PRALanguage.language] ⊧* PRA]
local notation "F" => Structure.func (L := PRALanguage.language) (M := M)
local instance boundSepZero : Zero M := ⟨F (Code.zero 0) Fin.elim0⟩
local instance boundSepOne : One M := ⟨F oneCode Fin.elim0⟩
local instance boundSepAdd : Add M := ⟨fun x y => F addCode ![x,y]⟩
local instance boundSepMul : Mul M := ⟨fun x y => F mulCode ![x,y]⟩
local instance boundSepLT : LT M := ⟨fun x y => Structure.rel (L := PRALanguage.language) Language.ORing.Rel.lt ![x,y]⟩
local instance boundSepIOpen : M↓[ℒₒᵣ] ⊧* 𝗜𝗢𝗽𝗲𝗻 := standardModelIOpen
variable [M↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

open M6.PA.RelationalSource M6.PA.RelationalSource.Ordinal

/-- The universally closed ordinal-induction code is provable even for nonstandard properties. -/
theorem closedOrdinalInductionInternalProvable (p : M) (hp : IsSemiformula SourceL 1 p) :
    letI := adjunctiveFullSepTheoryDelta
    Provable adjunctiveFullSepTheory (closedOrdinalInductionCode p) := by
  letI := adjunctiveFullSepTheoryDelta
  let T : InternalTheory M SourceL := fullSourceInternal
  have hopen : Provable T.theory (ordinalInductionCode p) := ordinalInductionInternalProvable p hp
  exact close_iterated_provable T _ _ (ordinalInductionCode_scoped p hp) hopen

#print axioms closedOrdinalInductionInternalProvable
