variable {M : Type} [Nonempty M] [Structure PRALanguage.language M] [Structure.Eq PRALanguage.language M] [M↓[PRALanguage.language] ⊧* PRA]
local notation "F" => Structure.func (L := PRALanguage.language) (M := M)
local instance ordinalFixedZero : Zero M := ⟨F (Code.zero 0) Fin.elim0⟩
local instance ordinalFixedOne : One M := ⟨F oneCode Fin.elim0⟩
local instance ordinalFixedAdd : Add M := ⟨fun x y => F addCode ![x,y]⟩
local instance ordinalFixedMul : Mul M := ⟨fun x y => F mulCode ![x,y]⟩
local instance ordinalFixedLT : LT M := ⟨fun x y => Structure.rel (L := PRALanguage.language) Language.ORing.Rel.lt ![x,y]⟩
local instance ordinalFixedIOpen : M↓[ℒₒᵣ] ⊧* 𝗜𝗢𝗽𝗲𝗻 := standardModelIOpen
variable [M↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

open PA194FixedSyntaxQuote PA194OrdinalFixed

/-- One fixed parameter-free graph, valid in every model under the section hypotheses. -/
noncomputable def ordinalInductionGraph : 𝚺₁.Semisentence 2 := .mkSigma
  “out p. ∃ d, !(fixedFormulaQuoteGraph PA194OrdinalBaseQuote.domainTemplate) d ∧
    ∃ z, !(fixedFormulaQuoteGraph zeroTemplate) z ∧
    ∃ d1, !(fixedFormulaQuoteGraph domainOne) d1 ∧
    ∃ d0, !(fixedFormulaQuoteGraph domainZero) d0 ∧
    ∃ s, !(fixedFormulaQuoteGraph successorTemplate) s ∧
      !ordinalStatementFromPropertyGraph out d z d1 d0 s p”

theorem ordinalInductionGraph_defined :
    𝚺₁.DefinedFunction (fun v : Fin 1 → M => ordinalInductionCode (v 0)) ordinalInductionGraph := .mk fun v => by
  haveI := ordinalStatementFromPropertyGraph_defined (M := M)
  simp [ordinalInductionGraph, fixedFormulaQuoteGraph_correct, ordinalInductionCode]

#print axioms ordinalInductionGraph_defined
