/-- Uniform Δ₁ test of a proof of one fixed closed source formula. -/
noncomputable def seedProofDelta (φ : Proposition M6.PA.RelationalSource.language) : 𝚫₁.Semisentence 1 := by
  letI := adjunctiveFullSepTheoryDelta
  exact .mkDelta
    (.mkSigma “d. ∃ q, !(fixedFormulaQuoteGraph φ) q ∧ !(proof adjunctiveFullSepTheory).sigma d q”)
    (.mkPi “d. ∀ q, !(fixedFormulaQuoteGraph φ) q → !(proof adjunctiveFullSepTheory).pi d q”)

theorem seedProofDelta_defined (φ : Proposition M6.PA.RelationalSource.language) :
    letI := adjunctiveFullSepTheoryDelta
    𝚫₁-Predicate (fun d : M => Proof adjunctiveFullSepTheory d (⌜φ⌝ : M)) via seedProofDelta φ := by
  letI := adjunctiveFullSepTheoryDelta
  refine ⟨?_⟩
  constructor
  · intro v
    simp [seedProofDelta,HierarchySymbol.Semiformula.val_sigma,HierarchySymbol.Defined.iff_delta_pi,
      HierarchySymbol.Defined.iff_delta_sigma,fixedFormulaQuoteGraph_correct]
  · intro v
    simp [seedProofDelta,HierarchySymbol.Semiformula.val_sigma,HierarchySymbol.Defined.iff_delta_sigma,
      fixedFormulaQuoteGraph_correct]

#print axioms seedProofDelta_defined
