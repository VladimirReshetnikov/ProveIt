variable [M↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

theorem typed_separation_axiom_member (p : Semiproposition M6.PA.RelationalSource.language 1) :
    letI := adjunctiveFullSepTheoryDelta
    (⌜(separationFormula p).univCl⌝ : M) ∈ adjunctiveFullSepTheory.Δ₁Class := by
  letI := adjunctiveFullSepTheoryDelta
  letI := adjunctiveTheoryDelta
  apply (adjunctiveFullSepTheory_class _).2
  exact Or.inr ⟨⌜p⌝, Semiformula.quote_isSemiformul₁ p, fullyClosedSeparation_quote p⟩

#print axioms typed_separation_axiom_member
