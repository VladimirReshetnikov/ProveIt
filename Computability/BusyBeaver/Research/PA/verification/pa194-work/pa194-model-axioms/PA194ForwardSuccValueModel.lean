noncomputable def successorValueNormalizationOpenProof :
    let T : InternalTheory M SourceL := ⟨adjunctiveFullSepTheory,adjunctiveFullSepTheoryDelta⟩
    T ⊢! (⌜successorValueNormalizationStatement⌝ : Formula M SourceL) := by
  let T : InternalTheory M SourceL := ⟨adjunctiveFullSepTheory,adjunctiveFullSepTheoryDelta⟩
  apply dischargeQuotedDerivation T successorValueEqualityAxioms successorValueNormalizationStatement successorValueNormalizationDerivation
  intro q hq
  by_cases h0 : q = reflexivityFormula
  · subst q; exact reflexivityProof
  by_cases h1 : q = symmetryFormula
  · subst q; exact symmetryProof
  by_cases h2 : q = congruenceFormula
  · subst q; exact PA194CongruenceSourceProof.congruenceProof
  have h3 : q = transitivityFormula := by simpa [successorValueEqualityAxioms,h0,h1,h2] using hq
  subst q
  exact transitivityProof

#print axioms successorValueNormalizationOpenProof
