  "wolfram_replay_body": "queue={{URLDownload[u],origin}}; seen={}; tms={}; zrecs={}; filesTotal=0; While[Length[queue]>0, item=First[queue];queue=Rest[queue]; zf=item[[1]];zp=item[[2]];zh=IntegerString[FileHash[zf,\"SHA256\"],16,64];If[MemberQ[seen,zh],Continue[]];AppendTo[seen,zh];d=CreateDirectory[];fs=ExtractArchive[zf,d];filesTotal+=Length[fs];AppendTo[zrecs,{zp,zh,Length[fs]}];Do[rel=StringDrop[f,StringLength[d]+1];If[StringEndsQ[f,\".zip\"],AppendTo[queue,{f,zp<>\"!\"<>rel}]];If[StringEndsQ[f,\".tm\"],AppendTo[tms,{f,zp<>\"!\"<>rel}]],{f,fs}]];groups=GatherBy[tms,FileHash[#[[1]],\"SHA256\"]&];recs=Table[t=First[g][[1]];s=StringReplace[Import[t,\"Text\"],RegularExpression[\"(?m)#.*$\"]->\"\"];rr=Select[StringSplit /@ StringSplit[s,\"\\n\"],Length[#]>0&];valid=Length[rr]>0&&AllTrue[rr,Length[#]==5&&StringMatchQ[#[[1]],DigitCharacter..]&&MemberQ[{\"0\",\"1\"},#[[2]]]&&MemberQ[{\"0\",\"1\"},#[[3]]]&&MemberQ[{\"L\",\"R\"},#[[4]]]&&StringMatchQ[#[[5]],DigitCharacter..]&];If[valid,st=DeleteDuplicates[rr[[All,1]]];valid=Length[rr]==2Length[st]&&Length[DeleteDuplicates[rr[[All,{1,2}]]]]==Length[rr]&&Length[Complement[DeleteDuplicates[rr[[All,5]]],st]]==1];{First[g][[2]],IntegerString[FileHash[t,\"SHA256\"],16,64],If[valid,Length[st],-1],Length[g]},{g,groups}];{Length[seen],filesTotal,Length[tms],Length[groups],If[Length[recs]>0,Counts[recs[[All,3]]],{}],Select[recs,0<#[[3]]<=194&],zrecs}"
