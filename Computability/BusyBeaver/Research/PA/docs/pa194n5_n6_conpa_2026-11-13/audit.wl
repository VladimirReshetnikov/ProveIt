u="https://raw.githubusercontent.com/VladimirReshetnikov/ProveIt/1e407ae841e4666f932777fad977ba784ebbcfd5/docs/incoming/";
zs={"pa194N_conpa_2026-11-13.zip","pa194q_conpa_2026-11-13.zip","pa194j_pa194d_conpa_2026-11-13.zip","pa194_radix_family_2026-11-13.zip","PA194R_research_2026-11-14.zip"};
all=Flatten[Table[p=URLDownload[u<>z];d=CreateDirectory[];ExtractArchive[p,d];Table[{f,z,StringDrop[f,StringLength[d]+1]},{f,Select[FileNames["*",d,Infinity],MemberQ[{"tm","txt","tsv","csv"},ToLowerCase[FileExtension[#]]]&]}],{z,zs}],1];
gs=GatherBy[all,FileHash[First[#],"SHA256"]&];
entries=Reap[Do[t=Import[gs[[i,1,1]],"Text"];ls=Select[StringSplit[t,"\n"],StringLength[#]>0&];If[Length[ls]==388&&AllTrue[ls,StringMatchQ[#,RegularExpression["[0-9]+\\s+[01]\\s+[01]\\s+[LR]\\s+[0-9]+"]]&],rr=StringSplit[#,Whitespace]&/@ls;states=Sort[DeleteDuplicates[ToExpression[rr[[All,1]]]]];If[Length[states]==194&&Length[DeleteDuplicates[rr[[All,{1,2}]]]]==388,hs=Complement[DeleteDuplicates[ToExpression[rr[[All,5]]]],states];If[Length[hs]==1,remap=AssociationThread[Join[states,hs]->Range[0,194]];rows=SortBy[Table[{remap[ToExpression[x[[1]]]],ToExpression[x[[2]]],ToExpression[x[[3]]],If[x[[4]]=="L",-1,1],remap[ToExpression[x[[5]]]]},{x,rr}],Take[#,2]&];rep=First[SortBy[gs[[i]],StringLength[#[[3]]]&]];Sow[<|"sha256"->IntegerString[FileHash[rep[[1]],"SHA256"],16,64],"occurrences"->Length[gs[[i]]],"zip"->rep[[2]],"path"->rep[[3]],"arr"->rows[[All,{3,4,5}]]|>]]]],{i,Length[gs]}]][[2,1]];
canonRoot=Compile[{{ar,_Integer,2},{root,_Integer},{flip,_Integer},{mir,_Integer}},Module[{n=Quotient[Length[ar],2],mp=Table[-1,{Quotient[Length[ar],2]+1}],queue=Table[0,{Quotient[Length[ar],2]}],out=Table[0,{3 Length[ar]}],head=1,tail=1,q=0,b=0,ix=0,target=0,k=1},mp[[root+1]]=0;mp[[n+1]]=n;queue[[1]]=root;While[head<=tail,q=queue[[head]];For[b=0,b<2,b++,ix=2 q+BitXor[b,flip]+1;target=ar[[ix,3]];If[mp[[target+1]]<0,tail++;mp[[target+1]]=tail-1;queue[[tail]]=target];out[[k]]=BitXor[ar[[ix,1]],flip];out[[k+1]]=ar[[ix,2]] mir;out[[k+2]]=mp[[target+1]];k+=3];head++];If[tail<n,out[[1]]=-2];out],RuntimeOptions->"Speed"];
canon[ar_]:=Module[{v=Select[Flatten[Table[canonRoot[ar,r,f,m],{r,0,193},{f,0,1},{m,{-1,1}}],2],First[#]>=0&]},If[Length[v]>0,First[Sort[v]],{}]];
entries=Map[Append[#,"canonical"->canon[#["arr"]]]&,entries];classes=GatherBy[entries,#["canonical"]&];
getCandidate[radix_]:=Module[{f,rr,ix,states,hs,remap,rows,ca,check},f=First[Select[all,StringEndsQ[#[[3]],"/machines/"<>ToString[radix]<>"/machine.native.tm"]&]][[1]];rr=StringSplit[#,Whitespace]&/@Select[StringSplit[Import[f,"Text"],"\n"],StringLength[#]>0&];ix=First[First[Position[rr,{"164","1",___},{1}]]];check=rr[[ix]];If[check=!={"164","1","1","R","98"},Abort[]];rr[[ix,5]]="114";states=Sort[DeleteDuplicates[ToExpression[rr[[All,1]]]]];hs=Complement[DeleteDuplicates[ToExpression[rr[[All,5]]]],states];remap=AssociationThread[Join[states,hs]->Range[0,194]];rows=SortBy[Table[{remap[ToExpression[x[[1]]]],ToExpression[x[[2]]],ToExpression[x[[3]]],If[x[[4]]=="L",-1,1],remap[ToExpression[x[[5]]]]},{x,rr}],Take[#,2]&];ca=canon[rows[[All,{3,4,5}]]];<|"name"->"PA194N"<>ToString[radix],"original_row"->check,"rows"->Length[rr],"states"->Length[states],"native_sha256"->IntegerString[Hash[StringRiffle[StringRiffle[#," "]&/@rr,"\n"]<>"\n","SHA256"],16,64],"canonical_array"->ca,"matches"->(#["path"]&/@Select[entries,#["canonical"]===ca&])|>];
new={getCandidate[5],getCandidate[6]};
Print[ExportString[<|"candidate_files"->Length[all],"candidate_byte_forms"->Length[gs],"194_byte_forms"->Length[entries],"194_occurrences"->Total[entries[[All,"occurrences"]]],"194_graph_classes"->Length[classes],"new_candidates"->(KeyDrop[#,"canonical_array"]&/@new),"new_candidates_distinct"->(new[[1,"canonical_array"]]=!=new[[2,"canonical_array"]]),"no_spanning_root"->Count[entries[[All,"canonical"]],{}],"short_groups"->({StringTake[#[[1,"sha256"]],12],Length[#],Total[#[[All,"occurrences"]]]}&/@classes)|>,"RawJSON","Compact"->True]];
