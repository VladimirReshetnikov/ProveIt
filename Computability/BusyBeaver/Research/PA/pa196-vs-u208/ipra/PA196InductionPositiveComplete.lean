import PA196InductionPositiveConditional
import PA196PAShiftGraphComplete

/-! The positive induction recognizer has bounded witnesses in every
candidate-PRA model. -/
set_option autoImplicit false
namespace PA196InductionPositiveComplete
open DiophantineConsistency
open LO LO.FirstOrder LO.FirstOrder.Arithmetic LO.FirstOrder.Arithmetic.Bootstrapping
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic
open PRAFiniteFunctionCodes PRALanguage PRATheory PRAAddOne PRAWitnessCalculus
variable {M : Type} [Nonempty M] [Structure language M] [Structure.Eq language M]
  [M↓[language] ⊧* PRA]
local instance : Zero M := ⟨Structure.func (L := language) (Code.zero 0) Fin.elim0⟩
local instance : One M := ⟨Structure.func (L := language) oneCode Fin.elim0⟩
local instance : Add M := ⟨fun x y => Structure.func (L := language) addCode ![x,y]⟩
local instance : Mul M := ⟨fun x y => Structure.func (L := language) mulCode ![x,y]⟩
local instance : LT M := ⟨fun x y => Structure.rel (L := language) Language.ORing.Rel.lt ![x,y]⟩

theorem wb_positive : WB M chUniv.sigma.val :=
  PA196InductionPositiveConditional.wb_positive PA196PAShiftGraphComplete.wb_shiftGraph

#print axioms wb_positive
end PA196InductionPositiveComplete
