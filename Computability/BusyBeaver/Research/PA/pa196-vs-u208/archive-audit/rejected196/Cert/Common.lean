def bad (c : Conf) : Bool := c.1 == 115 && c.2.2 % 2 == 1
def step (variant : Bool) (c : Conf) : Conf :=
  let (q,l,r) := c
  if q = 196 then c else
  let (w,d,n) := if variant && bad c then (1,1,108) else rows[(2*q)+(r%2)]!
  if d = 1 then (n,2*l+w,r/2) else (n,l/2,4*(r/2)+2*w+l%2)
def run (variant : Bool) : Nat → Conf → Conf
  | 0,c => c
  | k+1,c => run variant k (step variant c)
def safeRun : Nat → Conf → Option Conf
  | 0,c => some c
  | k+1,c => if bad c then none else safeRun k (step false c)
theorem same_step (c : Conf) (h : bad c = false) : step true c = step false c := by
  simp [step,h]
theorem safe_run_sound (n : Nat) (c d : Conf) (h : safeRun n c = some d) :
    run false n c = d ∧ run true n c = d := by
  induction n generalizing c with
  | zero =>
    simp only [safeRun, Option.some.injEq] at h
    subst d
    exact ⟨rfl,rfl⟩
  | succ n ih =>
    simp only [safeRun] at h
    split at h
    · contradiction
    · rename_i hbad
      have hz : bad c = false := by simpa using hbad
      obtain ⟨h1,h2⟩ := ih _ h
      simp only [run]
      rw [same_step c hz]
      exact ⟨h1,h2⟩
theorem safe_run_add (n m : Nat) (c : Conf) :
    safeRun (n+m) c = (safeRun n c).bind (safeRun m) := by
  induction n generalizing c with
  | zero => simp [safeRun]
  | succ n ih =>
    simp only [Nat.succ_add,safeRun]
    split <;> simp_all
end RejectAudit
