  have hsupport : rowSupport 18 = {⟨(29, 29), by decide⟩, ⟨(0, 29), by decide⟩, ⟨(0, 30), by decide⟩} := by rfl
  have hcoefficient : rowCoefficient ports 18 = (fun p => if p = ⟨(29, 29), by decide⟩ then (-1) else if p = ⟨(0, 29), by decide⟩ then (-2) else if p = ⟨(0, 30), by decide⟩ then 1 else 0) := by unfold rowCoefficient; rfl
  have hsource : shiftedRows ports x 18 = ((x 29 + 1) - ((x 28 + 1) * (x 28 + 1))) := by unfold shiftedRows sourceRows rowOrder; rfl
  rw [hsupport, hcoefficient, hsource]
  unfold rowValue
  repeat' rw [Finset.sum_insert]
  rw [Finset.sum_singleton]
  all_goals first | decide | skip
  have hp0 : padded x 0 = 1 := rfl
  have hp29 : padded x 29 = x 28 := rfl
  have hp30 : padded x 30 = x 29 := rfl
  norm_num [hp0, hp29, hp30]
  try simp (config := { decide := true }) only [ite_false]
  all_goals ring

