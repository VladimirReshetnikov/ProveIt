/-- The literal 480-operation natural DAG evaluates to the published scalar recipe.
The fixed leaves are the twelve explicit integer-polynomial recipes in the four
abstract native ports and the two independent height and threshold scales. -/
theorem naturalValue_eq_recipe (ports : Fin 4 → R) (height scale : R) (x : Fin 9 → R) :
    SplitCircuit59.naturalValue (fixedLeaves ports height scale) x =
      SplitNinePolynomial59.value ports height scale x := by
  let b := x 0+1
  let g := x 1+1
  let h := x 2+1
  let s := x 3+1
  let w := x 4+1
  let C := x 5+1
  let i := x 6+1
  let j := x 7
  let n := x 8+1
  let base := SplitNinePolynomial59.sourceBase height b
  let rank := SplitNinePolynomial59.sourceRank ports base b g
  let N := SplitNinePolynomial59.threshold scale base b
  let t := SplitNinePolynomial59.marginScale base b
  change naturalRegister (fixedLeaves ports height scale) x 514 =
    SplitNinePolynomial59.ratioValue rank N b g t h s w C i j n

  have h10 : naturalRegister (fixedLeaves ports height scale) x 10 = b := by
    simp [b,natural_step_10,natural_step_0,natural_step_9]

  have h11 : naturalRegister (fixedLeaves ports height scale) x 11 = g := by
    simp [g,natural_step_11,natural_step_1,natural_step_9]

  have h12 : naturalRegister (fixedLeaves ports height scale) x 12 = h := by
    simp [h,natural_step_12,natural_step_2,natural_step_9]

  have h13 : naturalRegister (fixedLeaves ports height scale) x 13 = s := by
    simp [s,natural_step_13,natural_step_3,natural_step_9]

  have h14 : naturalRegister (fixedLeaves ports height scale) x 14 = w := by
    simp [w,natural_step_14,natural_step_4,natural_step_9]

  have h15 : naturalRegister (fixedLeaves ports height scale) x 15 = C := by
    simp [C,natural_step_15,natural_step_5,natural_step_9]

  have h16 : naturalRegister (fixedLeaves ports height scale) x 16 = i := by
    simp [i,natural_step_16,natural_step_6,natural_step_9]

  have h7 : naturalRegister (fixedLeaves ports height scale) x 7 = j := by
    simp [j,natural_step_7]

  have h17 : naturalRegister (fixedLeaves ports height scale) x 17 = n := by
    simp [n,natural_step_17,natural_step_8,natural_step_9]

  have h36 : naturalRegister (fixedLeaves ports height scale) x 36 = base := by
    simpa only [natural_baseRegister,base,rank,N,t,b,g] using (natural_baseRegister ports height scale x)

  have h414 : naturalRegister (fixedLeaves ports height scale) x 414 = rank := by
    simpa only [natural_baseRegister,base,rank,N,t,b,g] using (natural_sourceRankRegister ports height scale x)

  have h409 : naturalRegister (fixedLeaves ports height scale) x 409 = N := by
    simpa only [natural_baseRegister,base,rank,N,t,b,g] using (natural_thresholdRegister ports height scale x)

  have h415 : naturalRegister (fixedLeaves ports height scale) x 415 = t := by
    simpa only [natural_baseRegister,base,rank,N,t,b,g] using (natural_marginScaleRegister ports height scale x)

  unfold SplitNinePolynomial59.ratioValue
  extract_lets U Y M P K a B1 W J Q D E F G H I k V0 V1 m omega theta
  clear_value
    (dU : U = N^2*w) (dY : Y = N^2*s) (dM : M = rank*Y)
    (dP : P = 2*M^2*U) (dK : K = rank+1+h*(P-1))
    (da : a = M*(U+1)) (dB1 : B1 = 2*rank+1) (dW : W = b*w)
    (dJ : J = 4*a-5) (dQ : Q = 3*W*C-2*(W^2-1))
    (dD : D = (a^2-1)*C^2+1) (dE : E = i*J*D*C^2)
    (dF : F = (a^2-1)*E^2+1) (dG : G = a+F*(C*D+1-a))
    (dH : H = C+F*(B1+j*C)) (dI : I = (G^2-1)*H^2+1)
    (dk : k = i*J*C) (dV0 : V0 = P*K)
    (dV1 : V1 = k*(8*D^2-4*D-1)*G*H)
    (dm : m = K^2*(4*t-g)-16*t*(C-K*Y)^2)
    (domega : omega = J*m)
    (dtheta : theta = J*(n+W^2)+Q-omega*(V0+V1))
    b g h s w C i j n base rank N t

  have h417 : naturalRegister (fixedLeaves ports height scale) x 417 = U := by
    simp only [natural_step_417,h14,natural_step_416,h409]

    rw [dU] <;> ring

  have h418 : naturalRegister (fixedLeaves ports height scale) x 418 = Y := by
    simp only [natural_step_418,h13,natural_step_416,h409]

    rw [dY] <;> ring

  have h419 : naturalRegister (fixedLeaves ports height scale) x 419 = M := by
    simp only [natural_step_419,h414,h418]

    rw [dM] <;> ring

  have h422 : naturalRegister (fixedLeaves ports height scale) x 422 = P := by
    simp only [natural_step_422,h417,natural_step_421,natural_step_21,natural_step_420,h419]

    rw [dP] <;> ring

  have h426 : naturalRegister (fixedLeaves ports height scale) x 426 = K := by
    simp only [natural_step_426,natural_step_424,h12,natural_step_423,h422,natural_step_9,natural_step_425,h414]

    rw [dK] <;> ring

  have h428 : naturalRegister (fixedLeaves ports height scale) x 428 = a := by
    simp only [natural_step_428,h419,natural_step_427,natural_step_9,h417]

    rw [da] <;> ring

  have h430 : naturalRegister (fixedLeaves ports height scale) x 430 = B1 := by
    simp only [natural_step_430,natural_step_9,natural_step_429,natural_step_21,h414]

    rw [dB1] <;> ring

  have h431 : naturalRegister (fixedLeaves ports height scale) x 431 = W := by
    simp only [natural_step_431,h10,h14]

    rw [dW] <;> ring

  have h435 : naturalRegister (fixedLeaves ports height scale) x 435 = J := by
    simp only [natural_step_435,natural_step_433,h428,natural_step_432,natural_step_434]

    rw [dJ] <;> ring

  have h441 : naturalRegister (fixedLeaves ports height scale) x 441 = Q := by
    simp only [natural_step_441,natural_step_21,natural_step_440,h431,natural_step_439,natural_step_437,h15,natural_step_436,natural_step_438]

    rw [dQ] <;> ring

  have h446 : naturalRegister (fixedLeaves ports height scale) x 446 = D := by
    simp only [natural_step_446,natural_step_9,natural_step_445,natural_step_443,natural_step_442,h428,natural_step_444,h15]

    rw [dD] <;> ring

  have h448 : naturalRegister (fixedLeaves ports height scale) x 448 = k := by
    simp only [natural_step_448,h15,natural_step_447,h16,h435]

    rw [dk] <;> ring

  have h450 : naturalRegister (fixedLeaves ports height scale) x 450 = E := by
    simp only [natural_step_450,h15,natural_step_449,h446,h448]

    rw [dE,dk] <;> ring

  have h453 : naturalRegister (fixedLeaves ports height scale) x 453 = F := by
    simp only [natural_step_453,natural_step_9,natural_step_452,natural_step_443,natural_step_442,h428,natural_step_451,h450]

    rw [dF] <;> ring

  have h458 : naturalRegister (fixedLeaves ports height scale) x 458 = G := by
    simp only [natural_step_458,h428,natural_step_457,h453,natural_step_456,natural_step_455,natural_step_9,natural_step_454,h15,h446]

    rw [dG] <;> ring

  have h462 : naturalRegister (fixedLeaves ports height scale) x 462 = H := by
    simp only [natural_step_462,h15,natural_step_461,h453,natural_step_460,h430,natural_step_459,h7]

    rw [dH] <;> ring

  have h467 : naturalRegister (fixedLeaves ports height scale) x 467 = I := by
    simp only [natural_step_467,natural_step_9,natural_step_466,natural_step_464,natural_step_463,h458,h462,natural_step_465]

    rw [dI] <;> ring

  have h468 : naturalRegister (fixedLeaves ports height scale) x 468 = V0 := by
    simp only [natural_step_468,h422,h426]

    rw [dV0] <;> ring

  have h472 : naturalRegister (fixedLeaves ports height scale) x 472 = (P^2-1)*K^2+1 := by
    simp only [natural_step_472,natural_step_9,natural_step_471,natural_step_469,h468,natural_step_470,h426]

    rw [dV0] <;> ring

  have h474 : naturalRegister (fixedLeaves ports height scale) x 474 = D*F*I := by
    simp only [natural_step_474,h467,natural_step_473,h446,h453]

    ring

  have h484 : naturalRegister (fixedLeaves ports height scale) x 484 = m := by
    simp only [natural_step_484,natural_step_477,natural_step_470,h426,natural_step_476,natural_step_475,h415,natural_step_432,h11,natural_step_483,natural_step_481,natural_step_480,h15,natural_step_479,h418,natural_step_482,natural_step_478]

    rw [dm] <;> ring

  have h492 : naturalRegister (fixedLeaves ports height scale) x 492 = V1 := by
    simp only [natural_step_492,natural_step_463,h458,h462,natural_step_491,h448,natural_step_490,natural_step_489,natural_step_487,natural_step_485,natural_step_486,h446,natural_step_488,natural_step_432,natural_step_9]

    rw [dV1] <;> ring

  have h493 : naturalRegister (fixedLeaves ports height scale) x 493 = omega := by
    simp only [natural_step_493,h435,h484]

    rw [domega] <;> ring

  have h500 : naturalRegister (fixedLeaves ports height scale) x 500 = theta := by
    simp only [natural_step_500,natural_step_497,h441,natural_step_496,h435,natural_step_495,h17,natural_step_494,h431,natural_step_499,h493,natural_step_498,h468,h492]

    rw [dtheta] <;> ring

  simp only [natural_step_514,natural_step_508,natural_step_507,natural_step_501,h500,natural_step_506,natural_step_502,h493,natural_step_505,h472,natural_step_504,h474,natural_step_503,natural_step_513,natural_step_512,natural_step_511,natural_step_509,natural_step_510,NearSquareFinalizer.norm]
  ring

/-- The independently certified 17-multiplication reduction preserves the same recipe. -/
theorem jointNaturalValue_eq_recipe (ports : Fin 4 → R) (height scale : R) (x : Fin 9 → R) :
    SplitJointCircuit59.naturalValue (fixedLeaves ports height scale) x =
      SplitNinePolynomial59.value ports height scale x := by
  rw [SplitJointPower59.naturalValue_eq_parent,naturalValue_eq_recipe]

/-- Ring homomorphisms preserve all twelve explicitly bound fixed leaves. -/
theorem map_fixedLeaves {S : Type*} [CommRing S] (f : R →+* S)
    (ports : Fin 4 → R) (height scale : R) :
    (fun i => f (fixedLeaves ports height scale i)) =
      fixedLeaves (fun i => f (ports i)) (f height) (f scale) := by
  funext i
  fin_cases i <;>
    simp [fixedLeaves,map_add,map_sub,map_mul,map_neg,map_pow,map_ofNat]

/-- Equality of the actual parent polynomial data, not merely agreement on
sampled integer inputs. The scale exponent is the sharp even-kappa convention. -/
theorem naturalPolynomial_eq_recipe (ports : Fin 4 → ℤ) (a : ℕ) :
    SplitCircuit59.naturalPolynomial (fixedLeaves ports ((2:ℤ)^a) ((2:ℤ)^(8*a+85))) =
      SplitNinePolynomial59.polynomial ports a := by
  change SplitCircuit59.naturalValue
    (fun i => MvPolynomial.C (fixedLeaves ports ((2:ℤ)^a) ((2:ℤ)^(8*a+85)) i))
    MvPolynomial.X = _
  rw [map_fixedLeaves]
  exact naturalValue_eq_recipe (fun i => MvPolynomial.C (ports i))
    (MvPolynomial.C ((2:ℤ)^a)) (MvPolynomial.C ((2:ℤ)^(8*a+85))) MvPolynomial.X

/-- The operation-reduced natural polynomial is exactly the source-equivalent
nine-variable polynomial for every supplied four-port tuple. -/
theorem jointNaturalPolynomial_eq_recipe (ports : Fin 4 → ℤ) (a : ℕ) :
    SplitJointCircuit59.naturalPolynomial (fixedLeaves ports ((2:ℤ)^a) ((2:ℤ)^(8*a+85))) =
      SplitNinePolynomial59.polynomial ports a := by
  rw [SplitJointPower59.naturalPolynomial_eq_parent,naturalPolynomial_eq_recipe]

end DiophantineConsistency.SplitCircuitRecipe59
