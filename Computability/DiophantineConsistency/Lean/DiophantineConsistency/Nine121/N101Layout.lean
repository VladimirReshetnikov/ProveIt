  exacts [chk2_ok_0, chk2_ok_1, chk2_ok_2, chk2_ok_3, chk2_ok_4, chk2_ok_5, chk2_ok_6, chk2_ok_7, chk2_ok_8, chk2_ok_9, chk2_ok_10, chk2_ok_11, chk2_ok_12, chk2_ok_13, chk2_ok_14, chk2_ok_15, chk2_ok_16, chk2_ok_17, chk2_ok_18, chk2_ok_19, chk2_ok_20, chk2_ok_21]

