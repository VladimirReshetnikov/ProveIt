private theorem sum_sum_mass {α β : Type*} [Fintype α] [Fintype β]
    (w : α ⊕ β → ℕ) (f : α → ℕ) (g : β → ℕ) (a b : ℕ)
    (hw : w = Sum.elim f g) (hf : (∑ i, f i) = a) (hg : (∑ j, g j) = b) :
    (∑ e, w e) = a + b := by
  rw [hw, Fintype.sum_sum_type]
  simp only [Sum.elim_inl, Sum.elim_inr, hf, hg]

