    simp [C,natural_step_15,natural_step_5,natural_step_9]

  have h16 : naturalRegister (fixedLeaves ports height scale) x 16 = i := by
    simp [i,natural_step_16,natural_step_6,natural_step_9]

  have h7 : naturalRegister (fixedLeaves ports height scale) x 7 = j := by
    simp [j,natural_step_7]

  have h17 : naturalRegister (fixedLeaves ports height scale) x 17 = n := by
    simp [n,natural_step_17,natural_step_8,natural_step_9]

  have h20 : naturalRegister (fixedLeaves ports height scale) x 20 = base := by
    simpa only [natural_baseRegister,base,rank,N,t,b,g] using (natural_baseRegister ports height scale x)

  have h383 : naturalRegister (fixedLeaves ports height scale) x 383 = rank := by
