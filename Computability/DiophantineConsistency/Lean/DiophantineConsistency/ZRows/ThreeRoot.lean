import DiophantineConsistency.ZRows.CoprimeSquares

/-! # The three-root norm

The norm of `Z − √x − √y − √z` over the field generated by the three square roots is the
polynomial

    N(Z; x, y, z) = ((Z² + x − y − z)² − 4 (Z² x + y z))² − 64 Z² x y z,

the product of the eight conjugates `Z − ε₁√x − ε₂√y − ε₃√z` (`norm3_squares`). It is symmetric
in `x, y, z` (`norm3_comm12`, `norm3_comm13`).

In the ring of differences of a model of `𝗜𝚺₁` a zero of the norm extracts the three roots
without any coprimality hypothesis:

* `square_of_norm3`: if `N(Z; x, y, z) = 0`, `Z ≠ 0`, `x ≠ y` and `x ≠ z`, then `x` is a
  square. The zero says `Y² = (8Z)² · xyz` with `Y = α² − 4Z²x − 4yz`, `α = Z² + x − y − z`, so
  `Y = 8Z·m` with `m² = xyz` (`b² ∣ a² ⇒ b ∣ a`,
  `ZRowsCoprimeSquares.dvd_of_sq_dvd_sq_ring`). Then `x·α² = (2(Zx + m))²`. If `α ≠ 0`, then
  `α ∣ 2(Zx + m)` and the quotient is a root of `x`. If `α = 0`, then `m = −Zx`, so
  `x·(x − y)·(x − z) = 0`, and `x = 0` is a square.
* `three_squares`: all three, for pairwise distinct `x, y, z`.
* `dvd_of_norm3_squares`: at a zero with `x = α²`, `y = β²`, `z = γ²`, a common divisor of
  `α, β, γ` divides `Z`, because one of the eight conjugates vanishes. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.ZRowsThreeRoot

section Generic
variable {𝔸 : Type*} [CommRing 𝔸]

/-- The three-root norm `N(Z; x, y, z)`. -/
def norm3 (Z x y z : 𝔸) : 𝔸 :=
  ((Z ^ 2 + x - y - z) ^ 2 - 4 * (Z ^ 2 * x + y * z)) ^ 2 - 64 * (Z ^ 2 * x * y * z)

theorem norm3_comm12 (Z x y z : 𝔸) : norm3 Z x y z = norm3 Z y x z := by
  unfold norm3; ring

theorem norm3_comm13 (Z x y z : 𝔸) : norm3 Z x y z = norm3 Z z y x := by
  unfold norm3; ring

/-- The norm at three squares is the product of the eight conjugates. -/
theorem norm3_squares (Z α β γ : 𝔸) : norm3 Z (α ^ 2) (β ^ 2) (γ ^ 2) =
    (Z - α - β - γ) * (Z - α - β + γ) * (Z - α + β - γ) * (Z - α + β + γ) *
      (Z + α - β - γ) * (Z + α - β + γ) * (Z + α + β - γ) * (Z + α + β + γ) := by
  unfold norm3; ring

/-- The sum of three roots is a zero of the norm. -/
theorem norm3_of_roots {Z x y z α β γ : 𝔸} (hx : x = α ^ 2) (hy : y = β ^ 2) (hz : z = γ ^ 2)
    (hZ : Z = α + β + γ) : norm3 Z x y z = 0 := by
  rw [hx, hy, hz, hZ]; unfold norm3; ring

/-- The norm with no radicand: `Z⁸`. -/
theorem norm3_zero_radicands (Z : 𝔸) : norm3 Z 0 0 0 = Z ^ 8 := by
  unfold norm3; ring

/-- The norm at `Z = 0`: `((x − y − z)² − 4yz)²`. -/
theorem norm3_zero_slot (x y z : 𝔸) : norm3 0 x y z = ((x - y - z) ^ 2 - 4 * (y * z)) ^ 2 := by
  unfold norm3; ring

end Generic

section Model
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open ModelDifferenceRing ZRowsCoprimeSquares

variable {V : Type} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- **One root.** At a zero of the norm with `Z ≠ 0`, a radicand different from the other two is
a square. -/
theorem square_of_norm3 {Z x y z : DiffRing V} (h : norm3 Z x y z = 0) (hZ : Z ≠ 0)
    (hxy : x ≠ y) (hxz : x ≠ z) : ∃ t : DiffRing V, x = t * t := by
  obtain ⟨α, hα⟩ : ∃ α : DiffRing V, α = Z ^ 2 + x - y - z := ⟨_, rfl⟩
  obtain ⟨Y, hY⟩ : ∃ Y : DiffRing V, Y = α ^ 2 - 4 * (Z ^ 2 * x + y * z) := ⟨_, rfl⟩
  have h' : Y ^ 2 - 64 * (Z ^ 2 * x * y * z) = 0 := by rw [hY, hα]; exact h
  have h8 : (8 * Z) * (8 * Z) ≠ 0 := mul_ne_zero (mul_ne_zero (by norm_num) hZ)
    (mul_ne_zero (by norm_num) hZ)
  obtain ⟨m, hm⟩ : (8 * Z) ∣ Y :=
    dvd_of_sq_dvd_sq_ring ⟨x * y * z, by linear_combination h'⟩
  have hm2 : m * m = x * y * z := by
    apply mul_left_cancel₀ h8
    linear_combination h' - (Y + 8 * Z * m) * hm
  have key : x * (α * α) = (2 * (Z * x + m)) * (2 * (Z * x + m)) := by
    linear_combination -x * hY + x * hm - 4 * hm2
  by_cases hα0 : α = 0
  · have h2 : Z * x + m = 0 := by
      have h3 : (2 * (Z * x + m)) * (2 * (Z * x + m)) = 0 := by rw [← key, hα0]; ring
      exact (mul_eq_zero.mp (mul_self_eq_zero.mp h3)).resolve_left (by norm_num)
    have h3 : x * ((x - y) * (x - z)) = 0 := by
      linear_combination -hm2 + (m - Z * x) * h2 + x ^ 2 * (hα.symm.trans hα0)
    rcases mul_eq_zero.mp h3 with h0 | h0
    · exact ⟨0, by rw [h0]; ring⟩
    · rcases mul_eq_zero.mp h0 with h1 | h1
      · exact absurd (sub_eq_zero.mp h1) hxy
      · exact absurd (sub_eq_zero.mp h1) hxz
  · obtain ⟨t, ht⟩ : α ∣ 2 * (Z * x + m) :=
      dvd_of_sq_dvd_sq_ring ⟨x, by linear_combination -key⟩
    refine ⟨t, ?_⟩
    apply mul_left_cancel₀ (mul_ne_zero hα0 hα0)
    linear_combination key + (2 * (Z * x + m) + α * t) * ht

/-- **Three roots.** At a zero of the norm with `Z ≠ 0`, pairwise distinct radicands are
squares. -/
theorem three_squares {Z x y z : DiffRing V} (h : norm3 Z x y z = 0) (hZ : Z ≠ 0)
    (hxy : x ≠ y) (hxz : x ≠ z) (hyz : y ≠ z) :
    (∃ t : DiffRing V, x = t * t) ∧ (∃ t : DiffRing V, y = t * t) ∧
      ∃ t : DiffRing V, z = t * t :=
  ⟨square_of_norm3 h hZ hxy hxz,
    square_of_norm3 ((norm3_comm12 Z y x z).trans h) hZ (Ne.symm hxy) hyz,
    square_of_norm3 ((norm3_comm13 Z z y x).trans h) hZ (Ne.symm hyz) (Ne.symm hxz)⟩

/-- **The linear relation.** At a zero of the norm at three squares, a common divisor of the
three roots divides `Z`: one of the eight conjugates vanishes. -/
theorem dvd_of_norm3_squares {S Z α β γ : DiffRing V} (hα : S ∣ α) (hβ : S ∣ β) (hγ : S ∣ γ)
    (h : norm3 Z (α ^ 2) (β ^ 2) (γ ^ 2) = 0) : S ∣ Z := by
  obtain ⟨a, rfl⟩ := hα
  obtain ⟨b, rfl⟩ := hβ
  obtain ⟨c, rfl⟩ := hγ
  rw [norm3_squares] at h
  simp only [mul_eq_zero] at h
  rcases h with ((((((h | h) | h) | h) | h) | h) | h) | h
  · exact ⟨a + b + c, by linear_combination h⟩
  · exact ⟨a + b - c, by linear_combination h⟩
  · exact ⟨a - b + c, by linear_combination h⟩
  · exact ⟨a - b - c, by linear_combination h⟩
  · exact ⟨-a + b + c, by linear_combination h⟩
  · exact ⟨-a + b - c, by linear_combination h⟩
  · exact ⟨-a - b + c, by linear_combination h⟩
  · exact ⟨-a - b - c, by linear_combination h⟩

end Model

#print axioms norm3_squares
#print axioms square_of_norm3
#print axioms three_squares
#print axioms dvd_of_norm3_squares

end DiophantineConsistency.ZRowsThreeRoot
