variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

set_option maxHeartbeats 2000000 in
/-- Third-order expansion of the Pell pair at base `b + 2 = 2P + 1`. -/
theorem third_order (b P n : V) (hb : b+1=2*P) :
    ∃ c1 c2 c3 a2 a3 W Z : V,
      3*c1+2*n=2*(n*n*n) ∧ 3*a2+2*(n*n)=2*(n*n*(n*n)) ∧
      15*c2+10*(n*n*n)=2*(n*n*(n*n)*n)+8*n ∧
      45*a3+20*(n*n*(n*n))=4*(n*n*(n*n)*(n*n))+16*(n*n) ∧
      315*c3+56*(n*n*(n*n)*n)+144*n=4*(n*n*(n*n)*(n*n)*n)+196*(n*n*n) ∧
      xcoord n b=1+2*P*(n*n)+P*P*a2+P*P*P*a3+P*P*P*P*W ∧
      ycoord n b=n+P*c1+P*P*c2+P*P*P*c3+P*P*P*P*Z := by
  have hbase : b+2=2*P+1 := by
    calc b+2=(b+1)+1 := by ring
      _=2*P+1 := by rw [hb]
  have hd : delta b=4*P*P+4*P := by
    unfold delta
    calc (b+1)*(b+3)=(b+1)*((b+1)+2) := by ring
      _=4*P*P+4*P := by rw [hb]; ring
  induction n using ISigma1.sigma1_succ_induction
  · definability
  case zero => exact ⟨0,0,0,0,0,0,0,by simp,by simp,by simp,by simp,by simp,by simp,by simp⟩
  case succ n ih =>
    obtain ⟨c1,c2,c3,a2,a3,W,Z,h1,h2,h4,h5,h6,hx,hy⟩ := ih
    have i1 := congrArg (ι : V →+* DiffRing V) h1
    have i2 := congrArg (ι : V →+* DiffRing V) h2
    have i4 := congrArg (ι : V →+* DiffRing V) h4
    have i5 := congrArg (ι : V →+* DiffRing V) h5
    have i6 := congrArg (ι : V →+* DiffRing V) h6
    simp only [map_add,map_mul,map_ofNat] at i1 i2 i4 i5 i6
    refine ⟨c1+2*(n*n)+2*n,c2+a2+2*c1,c3+a3+2*c2,a2+4*(n*n)+4*n+4*c1,a3+2*a2+4*c1+4*c2,
      W+2*a3+4*c2+4*c3+2*P*W+4*P*c3+4*P*Z+4*P*P*Z,W+2*c3+(2*P+1)*Z,?_,?_,?_,?_,?_,?_,?_⟩
    · apply ι_injective
      simp only [map_add,map_mul,map_ofNat,map_one]
      linear_combination i1
    · apply ι_injective
      simp only [map_add,map_mul,map_ofNat,map_one]
      linear_combination 4*i1+i2
    · apply ι_injective
      simp only [map_add,map_mul,map_ofNat,map_one]
      linear_combination 10*i1+5*i2+i4
    · apply ι_injective
      simp only [map_add,map_mul,map_ofNat,map_one]
      linear_combination 60*i1+30*i2+12*i4+i5
    · apply ι_injective
      simp only [map_add,map_mul,map_ofNat,map_one]
      linear_combination 42*i4+7*i5+i6
    · rw [x_succ,hx,hy,hbase,hd]; ring
    · rw [y_succ,hx,hy,hbase]; ring

/-- `third_order` read in the difference ring at `P = 44100 x`, combined with
`t3_congr`: `x⁴ ∣ T3(2 y_n, x) - 2 n`. -/
theorem pell_t3_congr (b x n : V) (hb : b+1=2*(44100*x)) :
    (ι x:DiffRing V)^4 ∣ T3 (2*(ι (ycoord n b):DiffRing V)) (ι x)-2*ι n := by
  obtain ⟨c1,c2,c3,_a2,_a3,_W,Z,h1,_h2,h4,_h5,h6,_hx,hy⟩ := third_order b (44100*x) n hb
  have i1 := congrArg (ι : V →+* DiffRing V) h1
  have i4 := congrArg (ι : V →+* DiffRing V) h4
  have i6 := congrArg (ι : V →+* DiffRing V) h6
  have iy := congrArg (ι : V →+* DiffRing V) hy
  simp only [map_add,map_mul,map_ofNat] at i1 i4 i6 iy
  apply t3_congr (ι n) (ι c1) (ι c2) (ι c3) (ι x) (ι Z)
  · linear_combination i1
  · linear_combination i4
  · linear_combination i6
  · rw [iy]; ring

