/-- Identity (2) of the package proof: `x⁴ ∣ T3(2 y, x) - 2 n`. -/
theorem t3_congr (n c1 c2 c3 x Z y : R)
    (h1 : 3*c1+2*n=2*n^3) (h4 : 15*c2+10*n^3=2*n^5+8*n)
    (h6 : 315*c3+56*n^5+144*n=4*n^7+196*n^3)
    (hy : y=n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3+(44100*x)^4*Z) :
    x^4 ∣ T3 (2*y) x-2*n := by
  have hlow : T3 (2*(n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3)) x-2*n=x^4*Wq n c1 c2 c3 x := by
    simp only [T3,corr,Wq,wc0,wc1,wc2,wc3,wc4,wc5,wc6,wc7,wc8,wc9,wc10,wc11,wc12,wc13,wc14,wc15,wc16,wc17,wc18,wc19,wc20]
    linear_combination (29400*x-864360000*(3*n^2-1)*x^2-
        2541218400000*(45*c1*n-105*n^4+45*n^2+2)*x^3)*h1+
      (259308000*x^2-7623655200000*(3*n^2-1)*x^3)*h4+544546800000*x^3*h6
  have hk : x^4 ∣ 2*y-2*(n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3) :=
    ⟨2*44100^4*Z,by rw [hy]; ring⟩
  have e : T3 (2*y) x-T3 (2*(n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3)) x=
      (3630312000000*x^3-172872000*x^2+29400*x+1)*
        (2*y-2*(n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3))+
      (-8258959800000*x^3-540225000*x^2-7350*x)*
        ((2*y)^3-(2*(n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3))^3)+
      (17153224200000*x^3+145860750*x^2)*
        ((2*y)^5-(2*(n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3))^5)+
      (-3828844687500*x^3)*
        ((2*y)^7-(2*(n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3))^7) := by
    simp only [T3,corr]; ring
  have hsplit : T3 (2*y) x-2*n=
      (T3 (2*y) x-T3 (2*(n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3)) x)+
      (T3 (2*(n+44100*x*c1+(44100*x)^2*c2+(44100*x)^3*c3)) x-2*n) := by ring
  rw [hsplit,e,hlow]
  refine dvd_add (dvd_add (dvd_add (dvd_add ?_ ?_) ?_) ?_) (dvd_mul_right _ _)
  · exact Dvd.dvd.mul_left hk _
  · exact Dvd.dvd.mul_left (dvd_trans hk (sub_dvd_pow_sub_pow _ _ 3)) _
  · exact Dvd.dvd.mul_left (dvd_trans hk (sub_dvd_pow_sub_pow _ _ 5)) _
  · exact Dvd.dvd.mul_left (dvd_trans hk (sub_dvd_pow_sub_pow _ _ 7)) _

end Ring

section Ordered
variable {R : Type*} [CommRing R] [LinearOrder R] [IsStrictOrderedRing R]

/-- The bracket of the correction is positive for `k² ≥ 4`, `x ≥ 1`. -/
theorem bracket_pos (k x : R) (hk : 4≤k*k) (hx : 1≤x) :
    0<x*(5672362500*x*(675*(k*k*(k*k))-324*(k*k)+160)-5402250*(27*(k*k)+8))+7350 := by
  set t := k*k with ht
  have ht0 : 0≤t := le_trans (by norm_num) hk
  have htt : 4*t≤t*t := mul_le_mul_of_nonneg_right hk ht0
  have ha3 : 27*t+8≤1050*(675*(t*t)-324*t+160) := by linarith
  have ha3pos : 0≤675*(t*t)-324*t+160 := by linarith
  have hx0 : 0≤x := le_trans zero_le_one hx
  have h1 : 5672362500*1*(675*(t*t)-324*t+160)≤5672362500*x*(675*(t*t)-324*t+160) :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hx (by norm_num)) ha3pos
  have h2 : 0≤5672362500*x*(675*(t*t)-324*t+160)-5402250*(27*t+8) := by linarith
  have h3 : 0≤x*(5672362500*x*(675*(t*t)-324*t+160)-5402250*(27*t+8)) := mul_nonneg hx0 h2
  linarith

/-- The sign bound (3): the correction is nonnegative for `k ≥ 2`, `x ≥ 1`. -/
theorem corr_nonneg (k x : R) (hk : 2≤k) (hx : 1≤x) : 0≤corr k x := by
  have hk0 : 0≤k := le_trans (by norm_num) hk
  have hk4 : 4≤k*k := by
    have := mul_le_mul hk hk (by norm_num) hk0
    linarith
  have hb := bracket_pos k x hk4 hx
  unfold corr
  have hxk : 0≤x*k := mul_nonneg (le_trans zero_le_one hx) hk0
  exact mul_nonneg (mul_nonneg hxk (by linarith)) (le_of_lt hb)

/-- A crude upper bound: `corr(k, x) ≤ x k³ (3828844687500 x² k⁴ + 7350)` for `k ≥ 2`, `x ≥ 1`. -/
theorem corr_le (k x : R) (hk : 2≤k) (hx : 1≤x) :
    corr k x≤x*(k*(k*k))*(3828844687500*(x*x)*(k*k*(k*k))+7350) := by
  have hk0 : 0≤k := le_trans (by norm_num) hk
  have hx0 : 0≤x := le_trans zero_le_one hx
  have hk4 : 4≤k*k := by
    have := mul_le_mul hk hk (by norm_num) hk0
    linarith
  have hb := bracket_pos k x hk4 hx
  unfold corr
  set t := k*k with ht
  have ht0 : 0≤t := le_trans (by norm_num) hk4
  have hbr : x*(5672362500*x*(675*(t*t)-324*t+160)-5402250*(27*t+8))+7350≤
      3828844687500*(x*x)*(t*t)+7350 := by
    have h1 : 675*(t*t)-324*t+160≤675*(t*t) := by linarith
    have h1' := mul_le_mul_of_nonneg_left h1 (show 0≤5672362500*x by positivity)
    have h2 : 5672362500*x*(675*(t*t)-324*t+160)-5402250*(27*t+8)≤5672362500*x*(675*(t*t)) := by
      linarith
    have h3 := mul_le_mul_of_nonneg_left h2 hx0
    linarith
  have hfac : 0≤x*k*(t-4) := mul_nonneg (mul_nonneg hx0 hk0) (by linarith)
  have hfac2 : x*k*(t-4)≤x*(k*t) := by
    have := mul_nonneg hx0 hk0
    linarith
  calc x*k*(t-4)*(x*(5672362500*x*(675*(t*t)-324*t+160)-5402250*(27*t+8))+7350)
      ≤x*k*(t-4)*(3828844687500*(x*x)*(t*t)+7350) := mul_le_mul_of_nonneg_left hbr hfac
    _≤x*(k*t)*(3828844687500*(x*x)*(t*t)+7350) :=
      mul_le_mul_of_nonneg_right hfac2 (by positivity)

end Ordered

