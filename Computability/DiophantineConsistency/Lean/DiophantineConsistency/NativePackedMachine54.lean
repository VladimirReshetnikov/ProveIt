import BusyBeaver.ZFC.KDense215

/-!
# The one-page compact54 seed is the actual Lean K215 table

The decimal numeral is the exact COMPACT54_SEED.txt payload, SHA256
5e745601d22ee2cce780db7bac7323ecb7141692c27852fce992f85758d2afab.
Its 430 base1024 digits encode next+256*write+512*moveRight,
with current state j/2 and read bit j%2. No native/Wang calibration is
assumed by the finite equality below.
-/

namespace DiophantineConsistency.NativePackedMachine54

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000
set_option exponentiation.threshold 1024

def seed : Nat := 

def digit (j : Nat) : Nat := (seed / 1024 ^ j) % 1024

def action (j : Nat) : Bool × Bool × Nat :=
  (decide (digit j / 256 % 2 = 1), decide (digit j / 512 = 1), digit j % 256)

def rows : List ((Bool × Bool × Nat) × (Bool × Bool × Nat)) :=
  List.ofFn (fun q : Fin 215 => (action (2*q.val), action (2*q.val+1)))

theorem rows_eq_dense : rows = SetTheory.BusyBeaver.ZFC.KDense215.rows215 := by
  rfl

def machine : SetTheory.BusyBeaver.Machine 215 where
  transition q b :=
    let r := rows.getD q.val ((false, true, 215), (false, true, 215))
    SetTheory.BusyBeaver.ZFC.KDense215.act (if b then r.2 else r.1)

theorem machine_eq_dense : machine = SetTheory.BusyBeaver.ZFC.KDense215.machine215 := by
  rfl

theorem blank_halts_iff_dense :
    SetTheory.BusyBeaver.ZFC.KDenseBridge.BlankHalts machine ↔
      SetTheory.BusyBeaver.ZFC.KDenseBridge.BlankHalts
        SetTheory.BusyBeaver.ZFC.KDense215.machine215 := by
  rfl

end DiophantineConsistency.NativePackedMachine54
