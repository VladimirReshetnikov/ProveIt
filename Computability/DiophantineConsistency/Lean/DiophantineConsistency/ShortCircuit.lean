import DiophantineConsistency.ShortEquation
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.Data.Fin.VecNotation

/-!
# The literal 69-operation polynomial and its local correctness

Generated by `tools/build_short_lean.py` from the two literal circuit DAGs.
P67 SHA-256: 732fecec5df8fecf98019f9aeadab7a63579c3ebfe6c179cbd7027dee24e9d08
P69 SHA-256: bdfeb63f0ad938a8e8e0c383ca6a1ebabf2628925ef6b1a02e36413ce604c786

There are fifteen positive unknowns and four fixed coefficient ports.
This module proves equality for the actual multivariate polynomial, then
its zero equivalence to the baseline P67. It supplies no native-window
compiler correctness theorem and makes no independent Con(ZFC) claim.
-/

namespace DiophantineConsistency.ShortCircuit

open MvPolynomial

variable {R S : Type*} [CommRing R] [CommRing S]

/-- Literal evaluations use these witness coordinates:
`J F alpha z f h i T s w tau eta zeta y gamma`.
The parameter coordinates are `beta K0 MC MF`, with MF shifted. -/
def value (p : Fin 4 → R) (v : Fin 15 → R) : R :=
  let J := v 0
  let F := v 1
  let alpha := v 2
  let z := v 3
  let f := v 4
  let h := v 5
  let i := v 6
  let T := v 7
  let s := v 8
  let w := v 9
  let tau := v 10
  let eta := v 11
  let zeta := v 12
  let y := v 13
  let gamma := v 14
  let beta := p 0
  let K0 := p 1
  let MC := p 2
  let MF := p 3
  let tau_square := tau * tau
  let repunit := beta * J
  let q := repunit + 1
  let Lbig := q * q
  let n2 := Lbig * q
  let wn2 := w * q
  let sn2 := s * n2
  let UM := wn2 * sn2
  let R10b := eta + zeta
  let ksn2 := R10b * sn2
  let first_root_base := UM * ksn2
  let first_next := first_root_base + R10b
  let first_product := first_root_base * first_next
  let norm_first := tau_square - first_product
  let R10a := ksn2 + eta
  let R12 := UM + sn2
  let cam2 := R10a * R12
  let D1 := wn2 + cam2
  let a4 := 4 * R12
  let a4m5 := a4 + 3
  let gam := gamma * a4m5
  let R14 := D1 + gam
  let L15 := R14 * R14
  let a_square := R12 * R12
  let A := a_square + a4m5
  let c2 := R10a * R10a
  let Ac2 := A * c2
  let norm_main := L15 - Ac2
  let norm_pair := norm_first * norm_main
  let q_minus_F := q - F
  let C := q_minus_F - alpha
  let aux_y2 := y * y
  let hpm1 := h * UM
  let index_difference := R10b - hpm1
  let gap_product := repunit * q_minus_F
  let gap := gap_product + alpha
  let Lm1 := Lbig - 1
  let rproduct := gap * Lm1
  let qMF := q * MF
  let mask_factor := MC + qMF
  let mask := mask_factor * J
  let r_lhs := rproduct + mask
  let norm_index := index_difference - r_lhs
  let kinner := K0 + w
  let innerC := kinner * C
  let transport_partial := innerC + q_minus_F
  let local_rhs := z * repunit
  let norm_transport := transport_partial - local_rhs
  let L16 := f * f
  let auxiliary_Tf := T * f
  let auxiliary_Tf_minus_one := auxiliary_Tf - 1
  let auxiliary_c_Tf := R10a * auxiliary_Tf_minus_one
  let auxiliary_R_f2 := r_lhs * L16
  let aux_u_rhs := auxiliary_c_Tf - auxiliary_R_f2
  let H2 := aux_u_rhs * aux_u_rhs
  let aux_square_gap := H2 - aux_y2
  let aux_coefficient_root := i * c2
  let R16 := aux_coefficient_root * aux_coefficient_root
  let strong_square_scaled := A * R16
  let norm_strong := L16 - strong_square_scaled
  let aux_f2_minus_one := L16 - 1
  let aux_reduced_coefficient := A * aux_f2_minus_one
  let L17 := aux_reduced_coefficient * aux_square_gap
  let norm_aux := L17 + aux_y2
  let norm_four := norm_pair * norm_aux
  let norm_product := norm_four * norm_index
  let all_units := norm_product * norm_transport
  let seven_units := all_units * norm_strong
  let polynomial := seven_units - 1
  polynomial

