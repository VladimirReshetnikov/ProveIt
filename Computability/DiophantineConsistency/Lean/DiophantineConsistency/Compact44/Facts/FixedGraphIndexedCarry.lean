import DiophantineConsistency.Compact44.Facts.FixedGraphTemporal

/-! `LeafFacts` copies of the forwarders of `FixedGraphIndexedCarry` (generated by factsgen.py;
    each proof is the original with `hz` retyped and leaf calls projected). -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace FixedGraphIndexedCarry
open DiophantineConsistency CompactBitRotation CompactSymbolicKernel CompactSymbolicKernelOpaque CompactSymbolicPorts
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic BigOperators
open AdaptiveEquationSyntax2011 ArithmeticSignedPairs Ordinary12FreeJ
open ArithmeticBinaryCarry ArithmeticRepunit ArithmeticWindowDigits CompactHeterogeneousCarry
open CompactGenericAlignedMass CompactConcreteIndexedMass CompactTwoBandFlatten
attribute [local irreducible] rho paramKernel CompactFixedBeta.betaNat lowNat highNat
attribute [local irreducible] Compact943Data.rows selectors copies
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

theorem graph_carry_facts (v : Fin 12 → V)
    (hv : ∀ j,0<v j)
    (hz : CompactLeafFacts.LeafFacts (ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat) v) :
    let p := ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
    let q : V := 1+v 0*(p 0:V)
    let R : V := ((q-1)*(q-v 1)+v 2)*(q^2-1)+((p 2:V)+q*(p 3:V))*v 0
    let C : V := q-v 1-v 2
    ∃ N w : V, 0<N ∧ q=Exp.exp ((67*8807)*N) ∧ v 0=rep (67*8807) N ∧
      (67*8807)*N≤R ∧ w=Exp.exp (R-(67*8807)*N) ∧ v 5=q*w ∧
      CarryInput 67 (8807*N) (v 1) 1
        (GenericBandCarryFamily.cap (ι:=Aligned (Fin 943) (Fin 41)))
        (GenericBandCarryFamily.coefficient (fun x => (alignedCoeff selectors copies x : V)))
        (GenericBandCarryFamily.word (8807*N) C (bandOffsets position)
          (temporalWord (8807*N) (R-67*(8807*N)) C)) := by
  obtain ⟨N,w,hN,hq,hJ,hle,hw,hv5,hpos,hbound,hgraph,hT,hTcap,hzero,hcap⟩ :=
    FixedGraphTemporal.fixed_graph_temporal_facts v hv hz
  dsimp only at *
  let p := ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
  let q : V := 1+v 0*(p 0:V)
  let R : V := ((q-1)*(q-v 1)+v 2)*(q^2-1)+((p 2:V)+q*(p 3:V))*v 0
  let C : V := q-v 1-v 2
  let n : V := 8807*N
  let T := temporalWord n (R-67*n) C
  have hn : 0<n := mul_pos (by norm_num) hN
  have hqexp : q=Exp.exp (67*n) := by dsimp [n]; rw [←mul_assoc]; exact hq
  have hmod : Exp.exp (67*n)-1=v 0*(p 0:V) := by
    rw [← hqexp]; dsimp [q]; rw [add_comm,add_tsub_cancel_right]
  have hM : 0<Exp.exp (67*n)-1 := by rw [hmod]; exact hpos
  have hF : v 1<Exp.exp (67*n)-1 := by rw [hmod]; exact hbound
  have hC : C<Exp.exp (67*n) := by
    dsimp [C]
    exact BandCarryInputs.source_word_bound q n (v 1) (v 2) hqexp (hv 1)
  refine ⟨N,w,hN,hq,hJ,hle,hw,hv5,?_⟩
  exact CompactTwoBandCarry.carry_input position n C T (v 1) hn hM hC hcap hT (fun k _ => hTcap k) hF hgraph

#print axioms FixedGraphIndexedCarry.graph_carry_facts
end FixedGraphIndexedCarry
