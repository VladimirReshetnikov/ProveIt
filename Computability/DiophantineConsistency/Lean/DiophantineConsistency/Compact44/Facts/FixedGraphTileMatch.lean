import DiophantineConsistency.Compact44.FixedGraphTileMatch
import DiophantineConsistency.Compact44.CompactLeafFacts
import DiophantineConsistency.Compact44.Facts.FixedGraphFieldMatch

/-! `LeafFacts` copies of the forwarders of `FixedGraphTileMatch` (generated by factsgen.py;
    each proof is the original with `hz` retyped and leaf calls projected). -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace FixedGraphTileMatch
open DiophantineConsistency CompactBitRotation CompactSymbolicKernel CompactSymbolicKernelOpaque CompactSymbolicPorts CompactPartialBand
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic BigOperators
open AdaptiveEquationSyntax2011 ArithmeticSignedPairs Ordinary12FreeJ
open ArithmeticBinaryCarry ArithmeticRepunit ArithmeticWindowDigits ArithmeticCyclicWord CompactHeterogeneousCarry ArithmeticPackingBlocks
open CompactGenericAlignedMass CompactConcreteIndexedMass CompactTwoBandFlatten
attribute [local irreducible] rho paramKernel CompactFixedBeta.betaNat lowNat highNat
attribute [local irreducible] Compact943Data.rows selectors copies
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

theorem graph_tile_match_facts (v : Fin 12 → V)
    (hv : ∀ j,0<v j)
    (hz : CompactLeafFacts.LeafFacts (ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat) v) :
    let p := ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
    let q : V := 1+v 0*(p 0:V)
    let R : V := ((q-1)*(q-v 1)+v 2)*(q^2-1)+((p 2:V)+q*(p 3:V))*v 0
    let C : V := q-v 1-v 2
    ∃ N W s : V, 0<N ∧ q=Exp.exp ((67*8807)*N) ∧ s<N ∧
      ((R-67*(8807*N))/67)%(8807*N)=8807*s ∧
      Blocks 10 (OrbitRowWord.row C N 1) N W ∧
      (∀ h<N, OrbitRowWord.row C N 1 h<943 ∧ OrbitRowWord.row C N 1 h≠1) ∧
      ∀ h<N, ∃ i j l : Fin 943,
        OrbitRowWord.row C N 1 h=(i.val:V) ∧
        OrbitRowWord.row C N 1 (cyc N h s)=(j.val:V) ∧
        OrbitRowWord.row C N 1 (cyc N h 1)=(l.val:V) ∧
        (Compact943Data.row i).2.2.2=(Compact943Data.row j).2.1 ∧
        (Compact943Data.row i).2.2.1=(Compact943Data.row l).1 := by
  obtain ⟨N,W,s,hN,hq,hs,hshift,hW,hbound,hfields⟩ := FixedGraphFieldMatch.graph_field_match_facts v hv hz
  refine ⟨N,W,s,hN,hq,hs,hshift,hW,hbound,?_⟩
  intro h hh
  obtain ⟨i,j,l,hi,hj,hl,hvert,hhor⟩ := hfields h hh
  have hiFields := TilePayloadFields.tile_fields (V:=V) i
  have hjFields := TilePayloadFields.tile_fields (V:=V) j
  have hlFields := TilePayloadFields.tile_fields (V:=V) l
  rw [hiFields.1,hjFields.2.1] at hvert
  rw [hiFields.2.2.1,hlFields.2.2.2] at hhor
  refine ⟨i,j,l,hi,hj,hl,?_,?_⟩
  · exact_mod_cast hvert
  · exact_mod_cast hhor

#print axioms FixedGraphTileMatch.graph_tile_match_facts
end FixedGraphTileMatch
