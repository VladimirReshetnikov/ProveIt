theorem graph_selected_decoder_facts (v : Fin 12 → V)
    (hv : ∀ j,0<v j)
    (hz : CompactLeafFacts.LeafFacts (ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat) v) :
    let p := ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
    let q : V := 1+v 0*(p 0:V)
    let R : V := ((q-1)*(q-v 1)+v 2)*(q^2-1)+((p 2:V)+q*(p 3:V))*v 0
    let C : V := q-v 1-v 2
    let a := GenericBandCarryFamily.coefficient (fun j : Aligned (Fin 943) (Fin 41) => (alignedCoeff selectors copies j:V))
    ∃ N w t : V, 0<N ∧ q=Exp.exp ((67*8807)*N) ∧ v 0=rep (67*8807) N ∧
      (67*8807)*N≤R ∧ w=Exp.exp (R-(67*8807)*N) ∧ v 5=q*w ∧
      let T := temporalWord (8807*N) (R-67*(8807*N)) C
      let X := GenericBandCarryFamily.word (8807*N) C (bandOffsets position) T
      CarryInput 67 (8807*N) (v 1) 1 (GenericBandCarryFamily.cap (ι:=Aligned (Fin 943) (Fin 41))) a X ∧
      dig 67 T t=0 ∧ dig 67 T (cyc (8807*N) t 1)≤Exp.exp 66 ∧
      carry 67 (8807*N) a X (cyc (8807*N) t 1)=0 ∧
      ((t=4393 ∧ dig 67 (v 1) t=FixedGraphRawBands.decoderBand position 4393 (8807*N) C t ∧
          Inputs (8807*N) C 4393 ∧ NoCarry (FixedGraphRawBands.decoderBand position 4393 (8807*N) C t) (Exp.exp 51-2) ∧
          SelectedBandDecoder.Conclusion (8807*N) C 4393) ∨
       (t=5495 ∧ dig 67 (v 1) t=FixedGraphRawBands.decoderBand position 5495 (8807*N) C t ∧
          Inputs (8807*N) C 5495 ∧ NoCarry (FixedGraphRawBands.decoderBand position 5495 (8807*N) C t) (Exp.exp 51-2) ∧
          SelectedBandDecoder.Conclusion (8807*N) C 5495)) := by
  obtain ⟨N,w,t,hN,hq,hJ,hle,hw,hv5,hcarry,hTzero,hTpred,hc,hband⟩ :=
    FixedGraphLocalNoCarry.graph_local_nocarry_facts v hv hz
  dsimp only at *
  refine ⟨N,w,t,hN,hq,hJ,hle,hw,hv5,hcarry,hTzero,hTpred,hc,?_⟩
  rcases hband with ⟨ht,hb,hin,hnc⟩ | ⟨ht,hb,hin,hnc⟩
  · left
    refine ⟨ht,hb,hin,hnc,?_⟩
    apply SelectedBandDecoder.decode _ _ 4393 hin
    rw [ht] at hnc
    simpa only [Nat.cast_ofNat] using hnc
  · right
    refine ⟨ht,hb,hin,hnc,?_⟩
    apply SelectedBandDecoder.decode _ _ 5495 hin
    rw [ht] at hnc
    simpa only [Nat.cast_ofNat] using hnc

