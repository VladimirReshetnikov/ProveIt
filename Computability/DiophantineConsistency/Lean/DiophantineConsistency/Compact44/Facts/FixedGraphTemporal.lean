import DiophantineConsistency.Compact44.FixedGraphTemporal
import DiophantineConsistency.Compact44.CompactLeafFacts
import DiophantineConsistency.Compact44.Facts.SymbolicGraphBand

/-! `LeafFacts` copies of the forwarders of `FixedGraphTemporal` (generated by factsgen.py;
    each proof is the original with `hz` retyped and leaf calls projected). -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace FixedGraphTemporal
open DiophantineConsistency CompactPartialBandRotation CompactBitRotation
open CompactSymbolicKernel CompactSymbolicKernelOpaque CompactSymbolicPorts
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic BigOperators
open AdaptiveEquationSyntax2011 ArithmeticSignedPairs Ordinary12FreeJ
open ArithmeticBinaryCarry ArithmeticRepunit ArithmeticWindowDigits
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]
attribute [local irreducible] rho paramKernel CompactFixedBeta.betaNat lowNat highNat

theorem fixed_graph_temporal_facts (v : Fin 12 → V)
    (hv : ∀ j,0<v j)
    (hz : CompactLeafFacts.LeafFacts (ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat) v) :
    let p := ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
    let q : V := 1+v 0*(p 0:V)
    let R : V := ((q-1)*(q-v 1)+v 2)*(q^2-1)+((p 2:V)+q*(p 3:V))*v 0
    let C : V := q-v 1-v 2
    ∃ N w : V, 0<N ∧ q=Exp.exp ((67*8807)*N) ∧ v 0=rep (67*8807) N ∧
      (67*8807)*N≤R ∧ w=Exp.exp (R-(67*8807)*N) ∧ v 5=q*w ∧
      0<v 0*(p 0:V) ∧ v 1<v 0*(p 0:V) ∧
      ((rotatedBand position 4393 (8807*N) C + rotatedBand position 5495 (8807*N) C +
        TwoBand.bareRotated (8807*N) C)+temporalWord (8807*N) (R-67*(8807*N)) C)
          % (Exp.exp (67*(8807*N))-1)=v 1 ∧
      temporalWord (8807*N) (R-67*(8807*N)) C < Exp.exp (67*(8807*N)) ∧
      (∀ k : V, dig 67 (temporalWord (8807*N) (R-67*(8807*N)) C) k ≤ Exp.exp 67-1) ∧
      dig 67 C 0=1 ∧ ∀ k<8807*N, dig 67 C k≤3 := by
  obtain ⟨N,w,hN,hq,hJ,hle,hw,hv5,hpos,hbound,hband,h0,hlim⟩ :=
    SymbolicGraphBand.fixed_symbolic_bands_facts v hv hz
  dsimp only at *
  let p := ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
  let q : V := 1+v 0*(p 0:V)
  let R : V := ((q-1)*(q-v 1)+v 2)*(q^2-1)+((p 2:V)+q*(p 3:V))*v 0
  let C : V := q-v 1-v 2
  let n : V := 8807*N
  let A : V := rotatedBand position 4393 n C + rotatedBand position 5495 n C + TwoBand.bareRotated n C
  have hn : 0<n := mul_pos (by norm_num) hN
  have hqexp : q=Exp.exp (67*n) := by dsimp [n]; rw [←mul_assoc]; exact hq
  have hmod : Exp.exp (67*n)-1=v 0*(p 0:V) := by
    rw [← hqexp]; dsimp [q]; rw [add_comm,add_tsub_cancel_right]
  have hM : 0<Exp.exp (67*n)-1 := by rw [hmod]; exact hpos
  have hwexp : w=Exp.exp (R-67*n) := by dsimp [n]; rw [←mul_assoc]; exact hw
  have ht := ActualTemporalBand.graph_temporal_word n q (v 1) (v 2) C R w A (v 1)
    hn hM hqexp (hv 1) rfl hwexp hband
  exact ⟨N,w,hN,hq,hJ,hle,hw,hv5,hpos,hbound,ht.1,ht.2.1,ht.2.2,h0,hlim⟩

#print axioms FixedGraphTemporal.fixed_graph_temporal_facts
end FixedGraphTemporal
