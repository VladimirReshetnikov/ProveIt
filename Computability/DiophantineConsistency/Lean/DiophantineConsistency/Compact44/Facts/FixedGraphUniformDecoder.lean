theorem graph_uniform_decoder_facts (v : Fin 12 → V)
    (hv : ∀ j,0<v j)
    (hz : CompactLeafFacts.LeafFacts (ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat) v) :
    let p := ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
    let q : V := 1+v 0*(p 0:V)
    let R : V := ((q-1)*(q-v 1)+v 2)*(q^2-1)+((p 2:V)+q*(p 3:V))*v 0
    let C : V := q-v 1-v 2
    let a := GenericBandCarryFamily.coefficient (fun j : Aligned (Fin 943) (Fin 41) => (alignedCoeff selectors copies j:V))
    ∃ N w s : V, 0<N ∧ q=Exp.exp ((67*8807)*N) ∧ v 0=rep (67*8807) N ∧
      (67*8807)*N≤R ∧ w=Exp.exp (R-(67*8807)*N) ∧ v 5=q*w ∧
      let E := R-67*(8807*N)
      let T := temporalWord (8807*N) E C
      let X := GenericBandCarryFamily.word (8807*N) C (bandOffsets position) T
      CarryInput 67 (8807*N) (v 1) 1 (GenericBandCarryFamily.cap (ι:=Aligned (Fin 943) (Fin 41))) a X ∧
      E%67=0 ∧ s<N ∧ (E/67)%(8807*N)=8807*s ∧
      (∀ k<8807*N, k%8807=4393 →
        dig 67 (v 1) k=FixedGraphRawBands.decoderBand position 4393 (8807*N) C k ∧
        UniformBandInputs.Inputs (8807*N) C k 4393 ∧
        NoCarry (FixedGraphRawBands.decoderBand position 4393 (8807*N) C k) (Exp.exp 51-2) ∧
        UniformBandDecoder.Conclusion (8807*N) C k 4393) ∧
      (∀ k<8807*N, k%8807=5495 →
        dig 67 (v 1) k=FixedGraphRawBands.decoderBand position 5495 (8807*N) C k ∧
        UniformBandInputs.Inputs (8807*N) C k 5495 ∧
        NoCarry (FixedGraphRawBands.decoderBand position 5495 (8807*N) C k) (Exp.exp 51-2) ∧
        UniformBandDecoder.Conclusion (8807*N) C k 5495) := by
  obtain ⟨N,w,s,hN,hq,hJ,hle,hw,hv5,hcarry,haligned,hs,hshift,hreset⟩ :=
    FixedGraphUniformReset.graph_uniform_reset_facts v hv hz
  obtain ⟨N',w',hN',hq',hJ',hle',hw',hv5',hcarry',h0',hzero,hbool⟩ :=
    FixedGraphSupportCarry.graph_support_carry_facts v hv hz
  obtain ⟨N'',w'',hN'',hq'',hJ'',hv5'',hcongr'',h0'',hslots,hhigh⟩ :=
    CompactPositionCarry.fixed_position_noCarry_facts (paramKernel rho) v hv hz
  dsimp only at *
  have hNN : N'=N := by
    apply mul_left_cancel₀ (by norm_num : ((67*8807):V)≠0)
    exact exp_inj (hq'.symm.trans hq)
  subst N'
  let p := ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
  let q : V := 1+v 0*(p 0:V)
  let R : V := ((q-1)*(q-v 1)+v 2)*(q^2-1)+((p 2:V)+q*(p 3:V))*v 0
  let C : V := q-v 1-v 2
  let n : V := 8807*N
  let E : V := R-67*n
  let T := temporalWord n E C
  have hqexp : q=Exp.exp (67*n) := by dsimp [n]; rw [←mul_assoc]; exact hq
  have hC : C<Exp.exp (67*n) := by
    dsimp [C]
    exact BandCarryInputs.source_word_bound q n (v 1) (v 2) hqexp (hv 1)
  have hhigh' : NoCarry (v 1) ((highNat:V)*rep (67*8807) N-1) := by rw [←hJ]; exact hhigh
  refine ⟨N,w,s,hN,hq,hJ,hle,hw,hv5,hcarry,haligned,hs,hshift,?_,?_⟩
  · intro k hk hp
    have hk0 : 0<k := by
      by_contra hh
      have hz0 : k=0 := nonpos_iff_eq_zero.mp (not_lt.mp hh)
      subst k
      norm_num at hp
    obtain ⟨hpred,hc0,htarget⟩ := hreset k hk (Or.inr (Or.inr (Or.inl hp)))
    have htemp := htarget (Or.inl hp)
    have hcol := UniformCleanColumn.at4393 N C T (v 1) k hN hk hC hzero hp hcarry htemp hpred
    have hin := UniformBandInputs.inputs N C k 4393 hN (by norm_num) (by norm_num) (by simpa using hp) hbool
    have hnc := UniformPhaseSupport.local_nocarry N (v 1) k hN hk hk0 (Or.inl hp) hhigh'
    rw [hcol] at hnc
    exact ⟨hcol,hin,hnc,UniformBandDecoder.decode n C k 4393 hin hnc⟩
  · intro k hk hp
    have hk0 : 0<k := by
      by_contra hh
      have hz0 : k=0 := nonpos_iff_eq_zero.mp (not_lt.mp hh)
      subst k
      norm_num at hp
    obtain ⟨hpred,hc0,htarget⟩ := hreset k hk (Or.inr (Or.inr (Or.inr hp)))
    have htemp := htarget (Or.inr hp)
    have hcol := UniformCleanColumn.at5495 N C T (v 1) k hN hk hC hzero hp hcarry htemp hpred
    have hin := UniformBandInputs.inputs N C k 5495 hN (by norm_num) (by norm_num) (by simpa using hp) hbool
    have hnc := UniformPhaseSupport.local_nocarry N (v 1) k hN hk hk0 (Or.inr hp) hhigh'
    rw [hcol] at hnc
    exact ⟨hcol,hin,hnc,UniformBandDecoder.decode n C k 5495 hin hnc⟩

