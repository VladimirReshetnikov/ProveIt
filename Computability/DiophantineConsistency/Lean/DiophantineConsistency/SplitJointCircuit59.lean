    i.val < positiveConsumers.getD i.val 0 ∧
    positiveConsumers.getD i.val 0 ≤ 490 ∧
    i.val ∈ (positiveNodes.getD (positiveConsumers.getD i.val 0) (.literal 0)).dependencies :=
