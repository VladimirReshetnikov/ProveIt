theorem evalRing_literal :
    (literal p).evalRing x = P131Value.value (fun i => (p i : 𝔸)) x :=
  e135 p x

end Eval

section Model
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic
open ModelDifferenceRing P138Ports
variable {V : Type} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- At the six fixed ports, zeros of the literal in `DiffRing V` are zeros of
`P131Value.value portsR`. -/
theorem literal_zero_iff (x : Fin 11 → DiffRing V) :
    (literal (fun i => (ports6 i : ℤ))).evalRing x = 0 ↔ P131Value.value portsR x = 0 := by
  rw [evalRing_literal]
  rfl

end Model

