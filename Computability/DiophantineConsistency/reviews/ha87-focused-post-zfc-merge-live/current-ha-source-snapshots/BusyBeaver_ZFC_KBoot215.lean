import BusyBeaver.ZFC.KBoot215Chunk012
import BusyBeaver.ZFC.KRuntimeCore

/-!
The 215's exact blank-tape bootstrap (port of K230's `Boot230.v`). After 95,714 steps the
machine is in state 84 with `[true]` to its left, a gap of 65 blank cells, and 49 register
blocks: the boot registers (`nextproof = 4`, all other registers zero) in physical order, then 40 spare
blocks holding 1. Checked in kernel blocks against the literal table.
Generated by `Research/ZFC/k225-formal/generate_boot215_lean.py`.
-/

namespace SetTheory.BusyBeaver.ZFC.KBoot215

open KZip KBoot KTableCore

set_option maxRecDepth 100000

def bootVs : List Nat := [0, 0, 0, 0, 0, 0, 4, 0, 0] ++ List.replicate 40 1

def bootRight : List Bool := List.replicate 65 false ++ true :: KRuntimeCore.sepsR bootVs

theorem cp_left : cp13.2.1 = [true] ++ List.replicate 9 false := by decide +kernel

theorem cp_right : cp13.2.2 = bootRight ++ List.replicate 0 false := by decide +kernel

theorem cp_state : cp13.1 = 84 := rfl

theorem boot_run : Reach tm215 (zc 0 [] []) (lconc cp13) :=
  (lblock_reach fast215 block1) |>.trans (lblock_reach fast215 block2) |>.trans (lblock_reach fast215 block3) |>.trans (lblock_reach fast215 block4) |>.trans (lblock_reach fast215 block5) |>.trans (lblock_reach fast215 block6) |>.trans (lblock_reach fast215 block7) |>.trans (lblock_reach fast215 block8) |>.trans (lblock_reach fast215 block9) |>.trans (lblock_reach fast215 block10) |>.trans (lblock_reach fast215 block11) |>.trans (lblock_reach fast215 block12) |>.trans (lblock_reach fast215 block13)

theorem boot : Reach tm215 (zc 0 [] []) (zc 84 [true] bootRight) := by
  have h := boot_run
  simp only [lconc, cp_state, cp_left, cp_right, zc_padl, zc_padr] at h
  exact h

end SetTheory.BusyBeaver.ZFC.KBoot215
