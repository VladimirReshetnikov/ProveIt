DiophantineConsistency.AdaptiveGap85ThirdMinimal.minimal_first_has_blocker.{u_1} {V : Type u_1} [LO.ORingStructure V]
  [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁] (p : Fin 4 → ℕ) (v : Fin 13 → V) (hp : 0 < ↑(p 0)) (hv : ∀ (i : Fin 13), 0 < v i)
  (hz :
    DiophantineConsistency.AdaptiveEquationSyntax2011.InternalZero
      (DiophantineConsistency.AdaptiveGap85Literal.expressionAt85 fun j => ↑(p j)) v)
  (hmin :
    ∀ (w : Fin 13 → V),
      (∀ (i : Fin 13), 0 < w i) →
        DiophantineConsistency.AdaptiveEquationSyntax2011.InternalZero
            (DiophantineConsistency.AdaptiveGap85Literal.expressionAt85 fun j => ↑(p j)) w →
          v 1 ≤ w 1) :
  have b := v 0 * ↑(p 0);
  have q := 1 + b;
  have A := v 6 + ↑(p 1) * q;
  have U := v 7 * (q * q);
  have c := v 9 + v 7 * (v 9 + v 10);
  v 1 ≤ A * (c * U) ∨ v 12 ≤ (q * q - 1) * (A + 1) * c
