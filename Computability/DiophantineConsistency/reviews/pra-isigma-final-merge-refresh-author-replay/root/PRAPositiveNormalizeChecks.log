DiophantineConsistency.PRAPositiveCode.positive_has_code (φ : LO.FirstOrder.ArithmeticSemiformula ℕ 1)
  (hφ : DiophantineConsistency.ParsonsBasePositive.Positive φ) :
  ∃ pred,
    ∀ (M : Type) [inst : Nonempty M] [inst_1 : LO.FirstOrder.Structure DiophantineConsistency.PRALanguage.language M]
      [LO.FirstOrder.Structure.Eq DiophantineConsistency.PRALanguage.language M]
      [M↓[DiophantineConsistency.PRALanguage.language] ⊧* DiophantineConsistency.PRATheory.PRA] (x : M) (e : ℕ → M),
      (LO.FirstOrder.Semiformula.Eval ![x] e)
          ((LO.FirstOrder.Semiformula.lMap DiophantineConsistency.PRALanguage.embedding) φ) ↔
        ∃ y,
          (LO.FirstOrder.Structure.func pred fun i => Fin.cases x (fun i => Fin.cases y (fun i => e ↑i) i) i) =
            LO.FirstOrder.Structure.func DiophantineConsistency.PRALanguage.oneCode Fin.elim0
