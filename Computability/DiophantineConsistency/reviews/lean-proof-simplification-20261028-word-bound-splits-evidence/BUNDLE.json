{
  "schema": "lean-proof-simplification-evidence-v1",
  "source_commit": "b5a3f9584e86a2b6838426da4b63a676042e02f6",
  "scope": "Non-adopted ArithmeticProofWordBound row-case split experiments and paired local timing",
  "validation": "Both alternatives compile; split_ifs has paired target and production-client validation, and four alternating baseline/variant benchmark pairs establish the observed local CPU costs. Independent source, archive, receipt, and patch reviews are included.",
  "limitations": [
    "No source change adopted; observed timing differences are local measurements in a cached environment, not universal performance results.",
    "The split alternative was compiled and timed but did not receive the full client and interface comparisons performed for split_ifs.",
    "Upstream inputs remained precompiled; direct-input receipts for client builds do not establish a clean transitive closure. The two failed setup attempts are retained and excluded from passing validation.",
    "Compiled objects and the original replay environment are excluded."
  ],
