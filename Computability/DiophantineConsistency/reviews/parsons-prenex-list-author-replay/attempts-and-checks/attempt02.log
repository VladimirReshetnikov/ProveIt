    (DiophantineConsistency.ParsonsPrenexTuple.block
      (DiophantineConsistency.ParsonsPrenexTree.matrix (aggregate ps).tree))
DiophantineConsistency.ParsonsPrenexList.backward (ps : List Packed)
  (h :
    Proof 𝗣𝗔⁻
      (DiophantineConsistency.ParsonsPrenexTuple.block
