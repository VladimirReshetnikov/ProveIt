'DiophantineConsistency.ParsonsPrenexList.matrix_bounded' depends on axioms: [propext, Classical.choice, Quot.sound]
'DiophantineConsistency.ParsonsPrenexList.forward' depends on axioms: [propext, Classical.choice, Quot.sound]
'DiophantineConsistency.ParsonsPrenexList.backward' depends on axioms: [propext, Classical.choice, Quot.sound]
DiophantineConsistency.ParsonsPrenexList.forward (ps : List Packed)
  (h : Proof 𝗣𝗔⁻ (DiophantineConsistency.ParsonsStructure.disjoin (List.map asFormula ps))) :
