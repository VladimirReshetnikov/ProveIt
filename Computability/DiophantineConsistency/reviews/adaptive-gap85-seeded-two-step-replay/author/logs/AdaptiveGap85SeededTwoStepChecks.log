DiophantineConsistency.AdaptiveGap85SeededTwoStep.seeded_gap_zero_two_step.{u_1} {V : Type u_1} [LO.ORingStructure V]
  [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁] (p : Fin 4 → ℕ) (z : Fin 13 → V) (R u iSeed : V) (hb : 0 < ↑(p 0)) (hb2 : 2 ≤ z 0 * ↑(p 0))
  (hz : ∀ (i : Fin 13), 0 < z i)
  (hzero :
    DiophantineConsistency.AdaptiveEquationSyntax2011.InternalZero
      (DiophantineConsistency.AdaptiveGap85Literal.expressionAt85 fun j => ↑(p j)) z)
  (hgapz : z 1 + z 2 < 1 + z 0 * ↑(p 0)) (hR : 5 ≤ R)
  (hc : z 9 + z 7 * (z 9 + z 10) = DiophantineConsistency.ArithmeticPellRecurrence.ycoord R (z 6 * z 7 + z 7))
  (hscale : z 4 = DiophantineConsistency.ArithmeticPellRecurrence.delta (z 6 * z 7 + z 7) * iSeed)
  (hux :
    have a := z 6 * z 7 + z 7;
    have c := z 9 + z 7 * (z 9 + z 10);
    have I := DiophantineConsistency.ArithmeticPellRecurrence.delta a * iSeed * c * c;
    DiophantineConsistency.ArithmeticPellRecurrence.xcoord R (I - 2) = I * u)
  (he :
    have c := z 9 + z 7 * (z 9 + z 10);
    z 3 * z 3 * c * z 5 = u + c + z 3 * z 3 * R) :
  ∃ a m,
    (∀ (i : Fin 13), 0 < a i) ∧
      (∀ (i : Fin 13), 0 < m i) ∧
        DiophantineConsistency.AdaptiveEquationSyntax2011.InternalZero
            (DiophantineConsistency.AdaptiveGap85Literal.expressionAt85 fun j => ↑(p j)) a ∧
          DiophantineConsistency.AdaptiveEquationSyntax2011.InternalZero
              (DiophantineConsistency.AdaptiveGap85Literal.expressionAt85 fun j => ↑(p j)) m ∧
            ¬a 1 + a 2 < 1 + a 0 * ↑(p 0) ∧
              ¬m 1 + m 2 < 1 + m 0 * ↑(p 0) ∧
                z 1 + z 2 < 1 + z 0 * ↑(p 0) ∧
                  DiophantineConsistency.AdaptiveGap85InverseEntry.PositiveBiStep p a m ∧
                    DiophantineConsistency.AdaptiveGap85InverseEntry.PositiveBiStep p m z ∧
                      ¬∃ x,
                          DiophantineConsistency.AdaptiveGap85InverseEntry.PositiveBiStep p a x ∧
                            x 1 + x 2 < 1 + x 0 * ↑(p 0)
