{
  "schema": "lean-proof-simplification-evidence-v1",
  "source_commit": "c54276ca56757e712355d8ec0caaef6f63f4873e",
  "source_parent": "559a5f1bfe86782cbf5049effeff9989ce9978d0",
  "scope": "Share packing-to-positive-zero construction",
  "validation": "Paired targets and two check clients pass over the refreshed carrier, seed and construction provider chain; both client objects match. Existing named endpoint reports, 55,579 global simp entries and 23,485 instances match. Tracked Lean source search found no references to the removed generated names.",
  "limitations": [
    "One public packing_positive_zero theorem and its generated proof are added; two unregistered generated endpoint _proof_1 names disappear. Their type/axiom reports equal the replacement generated proof. Searches covered all tracked Lean files and 12 selected endpoint source/replay files; a wider document search was interrupted and is not exhaustive.",
    "The initial ThirteenFreshSeed replay failed on a stale ThirteenCarrierSoundness provider; a later endpoint overlay failed before elaboration. Both were corrected and retained.",
    "The refreshed ThirteenCarrierSoundness still consumes cached SignedPellResidue object 45937a\u2026, recorded by an earlier manifest against old source 46afed\u2026 rather than current source ecd4df\u2026. Other transitive project and package dependencies remain cached; the replay is not a full current-source closure rebuild."
  ],
  "archive": "inputs-and-logs.zip",
