  have ha2 : quadraticCoefficient ports 19 = (fun p => if p = ⟨(0, 0), by decide +kernel⟩ then ((-(ports 0 * ports 3)) + ports 0 ^ 2) else if p = ⟨(0, 1), by decide +kernel⟩ then ((-(ports 0))) else if p = ⟨(0, 16), by decide +kernel⟩ then ((-(ports 0))) else if p = ⟨(1, 16), by decide +kernel⟩ then (1) else if p = ⟨(1, 24), by decide +kernel⟩ then (-1) else if p = ⟨(2, 24), by decide +kernel⟩ then (-1) else if p = ⟨(8, 19), by decide +kernel⟩ then (1) else 0) := by unfold quadraticCoefficient; rfl
  have hsource : deliveredRows ports x 19 = ((-1) * (x 26) + x 8 * x 19 + (-1) * (x 2 * x 24) + (-1) * (x 1) + (-1) * (x 1 * x 24) + x 1 * x 16 + ((-(ports 3)) + (-(ports 2)) + ports 0) * (x 0) + ((-(ports 0))) * (x 0 * x 16) + ((-(ports 0))) * (x 0 * x 1) + ((-(ports 0 * ports 3)) + ports 0 ^ 2) * (x 0 ^ 2)) := by
    unfold deliveredRows transformedRows rowOrder
    rfl
  rw [hs1,hs2,ha0,ha1,ha2,hsource]
  simp [value, linearValue, rowValue]
  <;> ring

private theorem rowIdentity_20 (ports : Fin 4 → R) (x : Fin 31 → R) :
    value (constantCoefficient ports 20) (linearSupport 20) (linearCoefficient ports 20)
      (quadraticSupport 20) (quadraticCoefficient ports 20) x = deliveredRows ports x 20 := by
  have hs1 : linearSupport 20 = {12, 13, 18} := rfl
  have hs2 : quadraticSupport 20 = {⟨(12, 17), by decide +kernel⟩, ⟨(17, 19), by decide +kernel⟩} := by decide +kernel
  have ha0 : constantCoefficient ports 20 = 0 := rfl
  have ha1 : linearCoefficient ports 20 = (fun i => if i = 12 then (-1) else if i = 13 then (-1) else if i = 18 then (1) else 0) := by unfold linearCoefficient; rfl
  have ha2 : quadraticCoefficient ports 20 = (fun p => if p = ⟨(12, 17), by decide +kernel⟩ then (1) else if p = ⟨(17, 19), by decide +kernel⟩ then (-1) else 0) := by unfold quadraticCoefficient; rfl
  have hsource : deliveredRows ports x 20 = (x 18 + (-1) * (x 17 * x 19) + (-1) * (x 13) + (-1) * (x 12) + x 12 * x 17) := by
    unfold deliveredRows transformedRows rowOrder
    rfl
  rw [hs1,hs2,ha0,ha1,ha2,hsource]
  simp [value, linearValue, rowValue]
  <;> ring

private theorem rowIdentity_21 (ports : Fin 4 → R) (x : Fin 31 → R) :
    value (constantCoefficient ports 21) (linearSupport 21) (linearCoefficient ports 21)
      (quadraticSupport 21) (quadraticCoefficient ports 21) x = deliveredRows ports x 21 := by
  have hs1 : linearSupport 21 = {17} := rfl
  have hs2 : quadraticSupport 21 = {⟨(17, 21), by decide +kernel⟩, ⟨(20, 21), by decide +kernel⟩} := by decide +kernel
  have ha0 : constantCoefficient ports 21 = 0 := rfl
  have ha1 : linearCoefficient ports 21 = (fun i => if i = 17 then (1) else 0) := by unfold linearCoefficient; rfl
  have ha2 : quadraticCoefficient ports 21 = (fun p => if p = ⟨(17, 21), by decide +kernel⟩ then (1) else if p = ⟨(20, 21), by decide +kernel⟩ then (-1) else 0) := by unfold quadraticCoefficient; rfl
  have hsource : deliveredRows ports x 21 = ((-1) * (x 20 * x 21) + x 17 + x 17 * x 21) := by
    unfold deliveredRows transformedRows rowOrder
    rfl
  rw [hs1,hs2,ha0,ha1,ha2,hsource]
  simp [value, linearValue, rowValue]
  <;> ring

theorem rowValue_eq_source (ports : Fin 4 → R) (x : Fin 31 → R) (k : Fin 22) :
    value (constantCoefficient ports k) (linearSupport k) (linearCoefficient ports k)
      (quadraticSupport k) (quadraticCoefficient ports k) x = deliveredRows ports x k := by
  fin_cases k

  · exact rowIdentity_0 ports x

  · exact rowIdentity_1 ports x

  · exact rowIdentity_2 ports x

  · exact rowIdentity_3 ports x

  · exact rowIdentity_4 ports x

  · exact rowIdentity_5 ports x

  · exact rowIdentity_6 ports x

  · exact rowIdentity_7 ports x

  · exact rowIdentity_8 ports x

  · exact rowIdentity_9 ports x

  · exact rowIdentity_10 ports x

  · exact rowIdentity_11 ports x

  · exact rowIdentity_12 ports x

  · exact rowIdentity_13 ports x

  · exact rowIdentity_14 ports x

  · exact rowIdentity_15 ports x

  · exact rowIdentity_16 ports x

  · exact rowIdentity_17 ports x

  · exact rowIdentity_18 ports x

  · exact rowIdentity_19 ports x

  · exact rowIdentity_20 ports x

  · exact rowIdentity_21 ports x

/-- Full same-degree extraction at all22 literal targets. -/
theorem coeff_source_rows (ports : Fin 4 → R) (x : Fin 31 → R) (k : Fin 22) :
    (product weights x (constantCoefficient ports) linearSupport (linearCoefficient ports)
      quadraticSupport (quadraticCoefficient ports) targets).coeff (targets k) =
        2 * deliveredRows ports x k := by
  rw [coeff_product weights weights_injective x (constantCoefficient ports)
    linearSupport (linearCoefficient ports) quadraticSupport (quadraticCoefficient ports)
    targets targets_injective linear_span linear_cross quadratic_span quadratic_isolated
    quadratic_cross k, rowValue_eq_source]

/-- These target coefficients vanish exactly at the authoritative old-z source zeros. -/
theorem coeff_zero_iff_source_zero (ports : Fin 4 → ℤ) (x : Fin 31 → ℤ) :
    (∀ k, (product weights x (constantCoefficient ports) linearSupport (linearCoefficient ports)
      quadraticSupport (quadraticCoefficient ports) targets).coeff (targets k) = 0) ↔
        ∀ k, sourceRows ports x k = 0 := by
  rw [← delivered_zero_iff]
  constructor
  · intro h k
    have hh := h k
    rw [coeff_source_rows] at hh
    exact (mul_eq_zero.mp hh).resolve_left (by norm_num : (2 : ℤ) ≠ 0)
  · intro h k
    rw [coeff_source_rows,h k,mul_zero]

end DiophantineConsistency.SplitCertificate59
