/-- All actual p215 rows in 36-bit slots, in false-first catalogue order. -/
def packed215 : Nat := 

def count : Nat := 4751

/-- No bits lie beyond the last complete 36-bit row slot. -/
theorem packed215_bound : packed215 < 2 ^ (36 * count) := by decide +kernel

def table215 : List Row := PackedTables.table packed215 count

def rows215 (c : Nat) : Option Row := PackedTables.rowsOf packed215 count c

/-- The actual existing program, not a copied node definition. -/
abbrev path : RegisterPath.Program := KSource215.p215

theorem table215_length : table215.length = 4751 := PackedTables.table_length _ _

private def catalogue : List Row :=
  (ControlCatalogue.leafEntries (KSource215.t215)).map
    (ArithmeticControlTable.rowOf (KSource215.t215))

/-- Index a tree without traversing a long list prefix. -/
private def entryAt : RMBisim.Tree → Nat → Option (List Bool × RegisterPath.Edge)
  | .none, _ => none
  | .leaf e, 0 => some ([], e)
  | .leaf _, _ + 1 => none
  | .node a b, n =>
      if n < SiteCoverage.leafCount a then
        (entryAt a n).map (fun e => (false :: e.1, e.2))
      else (entryAt b (n - SiteCoverage.leafCount a)).map (fun e => (true :: e.1, e.2))

/-- Generic exact indexing identity; neither table215 nor program is assumed. -/
private theorem entryAt_eq (t : RMBisim.Tree) (n : Nat) :
    entryAt t n = getElem? (ControlCatalogue.leafEntries t) n := by
  induction t generalizing n with
  | none => simp [entryAt, ControlCatalogue.leafEntries]
  | leaf e => cases n <;> simp [entryAt, ControlCatalogue.leafEntries]
  | node a b iha ihb =>
    simp only [entryAt, ControlCatalogue.leafEntries, List.getElem?_append,
      List.length_map, ControlCatalogue.leafEntries_length, List.getElem?_map,
      iha, ihb]

private def rowAt (n : Nat) : Option Row :=
  (entryAt (KSource215.t215) n).map (ArithmeticControlTable.rowOf (KSource215.t215))

private theorem rowAt_eq (n : Nat) : rowAt n = catalogue[n]? := by
  simp only [rowAt, catalogue, List.getElem?_map, entryAt_eq]

private def packedAt (n : Nat) : Option Row :=
  if n < count then some (PackedTables.decodeRow (PackedTables.slot packed215 n 36)) else none

private theorem packedAt_eq (n : Nat) : packedAt n = table215[n]? := by
  by_cases h : n < count
  · simp [packedAt, table215, PackedTables.table, h]
  · simp [packedAt, table215, PackedTables.table, h]

private theorem catalogue_length : catalogue.length = 4751 := by
  rw [catalogue, List.length_map, ControlCatalogue.leafEntries_length]
  decide +kernel

private abbrev block (i : Nat) : Prop :=
  ∀ j : Fin 64, 64 * i + j.val < count →
    packedAt (64 * i + j.val) = rowAt (64 * i + j.val)

