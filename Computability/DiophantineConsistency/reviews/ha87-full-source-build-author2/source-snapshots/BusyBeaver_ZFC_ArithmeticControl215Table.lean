/-- The quotient/remainder split covers every actual row, including the last 15. -/
private theorem all_rows (n : Nat) (hn : n < count) : packedAt n = rowAt n := by
  have hi : n / 64 < 75 := (Nat.div_lt_iff_lt_mul (by decide)).2 (by
    change n < 4751 at hn
    omega)
  have h := blocks_checked ⟨n / 64, hi⟩ ⟨n % 64, Nat.mod_lt _ (by decide)⟩
  simp only [Nat.div_add_mod] at h
  exact h hn

/-- Complete catalogue equality: all indices, not a sample or supplied premise. -/
theorem table215_eq_catalogue :
    table215 = (ControlCatalogue.leafEntries (KSource215.t215)).map
      (ArithmeticControlTable.rowOf (KSource215.t215)) := by
  change table215 = catalogue
  apply List.ext_getElem?
  intro n
  by_cases hn : n < count
  · rw [← packedAt_eq, ← rowAt_eq]
    exact all_rows n hn
  · have ht : table215.length ≤ n := by rw [table215_length]; change ¬n < 4751 at hn; omega
    have hc : catalogue.length ≤ n := by rw [catalogue_length]; change ¬n < 4751 at hn; omega
    rw [List.getElem?_eq_none ht, List.getElem?_eq_none hc]

/-- A concrete instruction from the actual table. -/
theorem first_row : rows215 1 = some ⟨2, 1, 3, 2⟩ := by decide +kernel

section Model

variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

noncomputable abbrev run215 (t x : V) : V := ArithmeticControlTable.controlRun table215 t x

theorem spec215 (c : Nat) (row : Row) (x : V) (h : rows215 c = some row) :
    ArithmeticControlTable.stepValue table215 (liveValue (c : V) x) =
      sem regValue write liveValue row x := by
  obtain ⟨hc, hg⟩ := PackedTables.rowsOf_some packed215 count c row h
  exact ArithmeticControlTable.spec_get table215 c row x hc hg

theorem run215_zero (x : V) : run215 0 x = x := ArithmeticControlTable.controlRun_zero table215 x

theorem run215_one (x : V) : run215 1 x = ArithmeticControlTable.stepValue table215 x :=
  ArithmeticControlTable.controlRun_one table215 x

theorem run215_add (t u x : V) : run215 (t + u) x = run215 u (run215 t x) :=
  ArithmeticControlTable.controlRun_add table215 t u x

theorem run215_halted (t : V) : run215 t 0 = 0 := ArithmeticControlTable.controlRun_halted table215 t

end Model
