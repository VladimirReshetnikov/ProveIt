'cubic_modulus' depends on axioms: [propext, Quot.sound]
'positivity_excludes' depends on axioms: [propext, Classical.choice, Quot.sound]
'positive_root_modulus' depends on axioms: [propext, Quot.sound]
'exclude_positive_template' depends on axioms: [propext, Classical.choice, Quot.sound]
exclude_positive_template (X Y q eta gamma B : ℤ) (hX : 1 ≤ X) (hY : 8 ≤ Y) (hEta : 0 < eta) (hq : q ∣ Y)
  (heta : eta = 4 * ((Y * (X + 1)) ^ 2 + 4 * Y * (X + 1) + 3) + 3 - Y * (8 * X * Y ^ 2 + 4))
  (hroot :
    Y * q ^ 2 * (4 * (Y * (X + 1) + 2) ^ 3 - 3 * (Y * (X + 1) + 2)) =
      Y * q ^ 2 * (X + Y * (X + 1) * (4 * ((Y * (X + 1)) ^ 2 + 4 * (Y * (X + 1)) + 3) + 3)) +
        (4 * Y * (X + 1) + 3) * (Y * q ^ 2 * gamma + B)) :
  False
