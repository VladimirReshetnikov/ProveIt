import BusyBeaver.ZFC.Dag219

/-!
The structured register program of the 217-state machine (`dagDom`), Source 149's dominated AX.

`dag219` with the prefix of the AX word (node 236's chain) replaced: the old prefix
`a, b, Q, READ_H, c, push, read, I, a, I, a, c, I, b, c, I, I, I` becomes
`a, b, Q, c, a, READ_H, READ_D, I, a, I, a, c, I, b, c, I, I, I` (`a, b, c` = `par1, par2, par3`,
`Q` = `wal`, `I` = `cons`, `READ_H, READ_D` = `read_p2, read_p1`; nodes 166, 121, 168, 180, 119,
176, 175). The new prefix is node 236 and nodes 467-483, continuing into the old chain at
node 319; every other node is dag219's. Generated by
`Research/ZFC/k225-formal/make_dagdom.py`.
-/

namespace SetTheory.BusyBeaver.ZFC.DagDom

open RMDag

/-- The new prefix of the AX word. -/
def axNodes : Nat → Option (Edge × Edge)
  | 236 => some (.node 166, .node 467)
  | 467 => some (.node 121, .node 468)
  | 468 => some (.node 180, .node 469)
  | 469 => some (.node 168, .node 470)
  | 470 => some (.node 166, .node 471)
  | 471 => some (.node 176, .node 472)
  | 472 => some (.node 175, .node 473)
  | 473 => some (.node 119, .node 474)
  | 474 => some (.node 166, .node 475)
  | 475 => some (.node 119, .node 476)
  | 476 => some (.node 166, .node 477)
  | 477 => some (.node 168, .node 478)
  | 478 => some (.node 119, .node 479)
  | 479 => some (.node 121, .node 480)
  | 480 => some (.node 168, .node 481)
  | 481 => some (.node 119, .node 482)
  | 482 => some (.node 119, .node 483)
  | 483 => some (.node 119, .node 319)
  | _ => none

def dagNodes (n : Nat) : Edge × Edge := (axNodes n).getD (Dag219.dagNodes n)

def dagDom : Prog := ⟨dagNodes, 0⟩

end SetTheory.BusyBeaver.ZFC.DagDom
