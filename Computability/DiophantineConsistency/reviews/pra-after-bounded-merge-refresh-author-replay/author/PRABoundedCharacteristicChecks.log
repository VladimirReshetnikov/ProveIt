  (φ : LO.FirstOrder.Semisentence DiophantineConsistency.PRALanguage.language (n + 1))
  (hbit : DiophantineConsistency.PRATheory.PRA ⊢ DiophantineConsistency.PRACharacteristicBit.bitSentence c)
