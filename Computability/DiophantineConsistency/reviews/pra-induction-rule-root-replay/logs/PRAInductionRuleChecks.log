'DiophantineConsistency.PRAInductionRule.open_induction_rule' depends on axioms: [propext, Classical.choice, Quot.sound]
DiophantineConsistency.PRAInductionRule.open_induction_rule (φ : Semiproposition language 1)
  (hOpen : Semiformula.Open φ) (hBase : PRA ⊢ Semiformula.univCl (base φ)) (hStep : PRA ⊢ Semiformula.univCl (step φ)) :
  PRA ⊢ Semiformula.univCl (∀⁰ φ)
