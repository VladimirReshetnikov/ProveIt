'DiophantineConsistency.PRABoundedWitness.characteristicMatrix_open' depends on axioms: [propext]
'DiophantineConsistency.PRABoundedWitness.PRA_boundedWitness' depends on axioms: [propext, Classical.choice, Quot.sound]
DiophantineConsistency.PRABoundedWitness.PRA_boundedWitness {n : ℕ} (φ : Semisentence language (n + 1))
  (hφ : Hierarchy 𝚺 0 φ) (h : PRA ⊢ ∀⁰* ∃⁰ φ) : ∃ w, Primrec (eval w) ∧ PRA ⊢ ∀⁰* openMatrixAt φ w
