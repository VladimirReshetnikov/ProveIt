'DiophantineConsistency.AdaptiveGap85PositiveModular.positive_root_cubic_congruence' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
DiophantineConsistency.AdaptiveGap85PositiveModular.positive_root_cubic_congruence.{u_1} {V : Type u_1}
  [LO.ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁] (X Y q gamma B : V) (hY : 1 ≤ Y) (hq : q ∣ Y)
  (hroot :
    Y * q * q *
        (4 * (Y * (X + 1)) * (Y * (X + 1)) * (Y * (X + 1)) + 24 * (Y * (X + 1)) * (Y * (X + 1)) + 45 * (Y * (X + 1)) +
          26) =
      Y * q * q * (X + Y * (X + 1) * (4 * (Y * (X + 1) * (Y * (X + 1)) + 4 * (Y * (X + 1)) + 3) + 3)) +
        (4 * (Y * (X + 1)) + 3) * (Y * q * q * gamma + B)) :
  27 * X % (4 * (Y * (X + 1)) + 3) = 27 * 8 % (4 * (Y * (X + 1)) + 3)
