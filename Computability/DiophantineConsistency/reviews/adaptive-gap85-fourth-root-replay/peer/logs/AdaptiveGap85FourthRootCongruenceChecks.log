DiophantineConsistency.AdaptiveGap85FourthRootCongruence.fourth_root_congruences.{u_1} {V : Type u_1}
  [LO.ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁] (X Y q A B : V) (hY : 1 ≤ Y) (hq : q ∣ Y)
  (hroot :
    Y * q * q * DiophantineConsistency.AdaptiveGap85FourthRootCongruence.fourthS (Y * (X + 1)) +
          (4 * (Y * (X + 1)) + 3) * B =
        Y * q * q * (X + Y * (X + 1) * DiophantineConsistency.AdaptiveGap85FourthRootCongruence.fourthC (Y * (X + 1))) +
          (4 * (Y * (X + 1)) + 3) * A ∨
      Y * q * q * DiophantineConsistency.AdaptiveGap85FourthRootCongruence.fourthS (Y * (X + 1)) +
            Y * q * q *
              (X + Y * (X + 1) * DiophantineConsistency.AdaptiveGap85FourthRootCongruence.fourthC (Y * (X + 1))) +
          (4 * (Y * (X + 1)) + 3) * A =
        (4 * (Y * (X + 1)) + 3) * B) :
  27 * X % (4 * (Y * (X + 1)) + 3) = 27 * 16 % (4 * (Y * (X + 1)) + 3) ∨ 27 * (16 * X + 1) % (4 * (Y * (X + 1)) + 3) = 0
