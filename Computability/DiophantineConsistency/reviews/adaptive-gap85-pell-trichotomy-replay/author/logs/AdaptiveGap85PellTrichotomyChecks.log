DiophantineConsistency.AdaptiveGap85PellTrichotomy.positive_norm_trichotomy.{u_1} {V : Type u_1} [LO.ORingStructure V]
  [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁] (q x k : V) (hk : 0 < k)
  (hn : x * x = 1 + DiophantineConsistency.ArithmeticPellFirstNorm.discriminant q * k * k) :
