{
  "schema": "lean-proof-simplification-evidence-v1",
  "source_commit": "2fd68625e5cf6db4466c4f5b6322f35d6df8bd40",
  "source_parent": "062d55baa10cee9a598b228452c6636ce9a7c57c",
  "scope": "Simplify Packing rotation identity arithmetic proof",
  "validation": "Paired target and both ArithmeticPackingCells and ArithmeticConstructionVariation direct-client builds pass. Current-source direct provider pairs match earlier source-built and mapping receipts. All 63 target, 88 PackingCells and six Variation namespace declaration/type/axiom reports and their global simp/instance reports match; each client probe pins target and client objects.",
  "limitations": [
    "ArithmeticConstructionVariation client object hashes match; ArithmeticPackingCells object hashes differ for an undetermined reason. Interface and registration reports do not establish equality of client proof bodies, serialized objects or every environment extension.",
    "An initial baseline build failed when an incomplete overlay shadowed the PackingBlocks provider; its structured receipt, log and time are retained. An earlier standalone probe error log survives but its exact pre-fix source was overwritten.",
    "Two independent-audit setup attempts misread the prior PackingBlocks receipt schema; their logs are preserved and the corrected post-commit audit passes. These script-only errors did not affect Lean builds.",
    "Direct provider pairs trace to prior producer and mapping receipts; broader project and package transitive closures remain cached. Single paired shared-load timings do not establish a general performance effect.",
    "Compiled objects are not included in the ZIP; object hashes and first-provider resolution are recorded in receipts, and external objects are needed for independent byte checks."
  ],
  "archive": "inputs-and-logs.zip",
