def oldFill : Fin 1 ⊕ Fin 49 → Expr (Fin 51)
  | .inl _ => .var 40 - .var 41
  | .inr i => .var (oldRest i)
def newFill : Fin 1 ⊕ Fin 49 → Expr (Fin 50)
  | .inl _ => .var 40
  | .inr i => .var (newRest i)
