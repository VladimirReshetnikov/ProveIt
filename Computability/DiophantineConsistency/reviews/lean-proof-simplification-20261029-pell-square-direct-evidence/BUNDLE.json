{
  "schema": "lean-proof-simplification-evidence-v1",
  "source_commit": "c66364f0e253ddb8acd543985be3181bd054d435",
  "source_parent": "2788bd4b56368b91f54f72c4f1a703ab53523c4f",
  "scope": "Replace three private square-order wrappers with the existing direct nonnegative square inequality lemma",
  "validation": "Both 15-module dependency-ordered lanes pass with phase-specific direct object pins and current-source external producer mappings. All eight distinct direct source clients are covered; all 12 unchanged downstream object pairs match. Combined probes pin all three changed objects and show 32 matching surviving declaration/type/axiom reports, exactly three removed private wrappers, no additions and identical global simp and instance reports.",
  "limitations": [
    "The three private square_le declarations disappear. A tracked Lean/Python qualified-name search in the research area found no references; untracked files, other file types, dynamic names and downstream environments are outside that search.",
    "Matching declaration and registration reports do not establish proof-body or all persistent-environment-extension equality. Wider project, Foundation and Mathlib dependencies remain cached; direct-source producer matches do not prove a complete fresh closure.",
    "The superseded iff-based variant compiled provisionally only for Classification, without contemporaneous before/after input pins. Its sources and exploratory log/time are preserved.",
    "One shared-load paired timing sample is not a general benchmark. The independent preliminary audit log terminates because final records did not yet exist; the completed postcommit independent audit supersedes it.",
    "Compiled objects are omitted; receipts preserve their hashes and first-provider paths, and independent byte verification requires external objects."
  ],
