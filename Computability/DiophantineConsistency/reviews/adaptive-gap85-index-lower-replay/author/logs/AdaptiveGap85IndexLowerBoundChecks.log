DiophantineConsistency.AdaptiveGap85IndexLowerBound.actual_zero_first_index_size.{u_1} {V : Type u_1}
  [LO.ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁] (p : Fin 4 → ℕ) (v : Fin 13 → V) (hb : 0 < ↑(p 0))
  (hv : ∀ (j : Fin 13), 0 < v j)
  (hz :
