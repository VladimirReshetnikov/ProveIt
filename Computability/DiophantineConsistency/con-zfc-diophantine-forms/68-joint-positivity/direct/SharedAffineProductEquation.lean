def stepRep := (Rep.equality stepPolynomial 0).existsBlock

-- External coordinates are t,x,y,m,M0; actual common multiple is M0+1.
def betaValue (x y i : ℕ) : ℕ := x % ((i + 1) * y + 1)
def betaGraph {σ : Type} {x y i : (σ → ℕ) → ℕ}
    (rx : GraphRep x) (ry : GraphRep y) (ri : GraphRep i) :
    GraphRep (fun v => betaValue (x v) (y v) (i v)) :=
  rx.mod (((ri.add (GraphRep.constant 1)).mul ry).add (GraphRep.constant 1))

def currentGraph : GraphRep (fun v : Option (Fin 5) → ℕ =>
    betaValue (v (some 1)) (v (some 2)) (v none)) :=
  betaGraph (GraphRep.coordinate (some 1)) (GraphRep.coordinate (some 2))
    (GraphRep.coordinate none)
def nextGraph : GraphRep (fun v : Option (Fin 5) → ℕ =>
    betaValue (v (some 1)) (v (some 2)) (v none + 1)) :=
  betaGraph (GraphRep.coordinate (some 1)) (GraphRep.coordinate (some 2))
    ((GraphRep.coordinate none).add (GraphRep.constant 1))
def stepInputs : Fin 4 → (Option (Fin 5) → ℕ) → ℕ :=
  ![fun v => betaValue (v (some 1)) (v (some 2)) (v none),
    fun v => betaValue (v (some 1)) (v (some 2)) (v none + 1),
    fun v => v (some 3), fun v => v (some 4)]
def stepGraphs : ∀ j : Fin 4, GraphRep (stepInputs j) :=
  Fin.cases currentGraph (Fin.cases nextGraph
    (Fin.cases (GraphRep.coordinate (some 3))
      (Fin.cases (GraphRep.coordinate (some 4)) (fun j => Fin.elim0 j))))
def everyStep := (Rep.compose stepRep stepGraphs).boundedForall (0 : Fin 5)

-- Every positive d<=m divides M0+1. This is a separate bounded block.
def multiplePolynomial : Expr ((Option (Fin 5)) ⊕ Fin 1) :=
  .var (.inl (some 4)) + 1 -
    (.var (.inl none) + 1) * .var (.inr 0)
def multipleAtIndex := (Rep.equality multiplePolynomial 0).existsBlock
def commonMultiple := multipleAtIndex.boundedForall (3 : Fin 5)

def initialGraph : GraphRep (fun v : Fin 5 → ℕ => betaValue (v 1) (v 2) 0) :=
  betaGraph (GraphRep.coordinate 1) (GraphRep.coordinate 2) (GraphRep.constant 0)
def finalGraph : GraphRep (fun v : Fin 5 → ℕ => betaValue (v 1) (v 2) (v 0)) :=
  betaGraph (GraphRep.coordinate 1) (GraphRep.coordinate 2) (GraphRep.coordinate 0)
def endpointInputs : Fin 3 → (Fin 5 → ℕ) → ℕ :=
  ![fun v => betaValue (v 1) (v 2) 0,
    fun v => betaValue (v 1) (v 2) (v 0), fun v => v 4]
def endpointGraphs : ∀ j : Fin 3, GraphRep (endpointInputs j) :=
  Fin.cases initialGraph (Fin.cases finalGraph
    (Fin.cases (GraphRep.coordinate 4) (fun j => Fin.elim0 j)))
def endpointPolynomial : Expr (Fin 3) :=
  (.var 0 - .var 2 - 2) * (.var 0 - .var 2 - 2) +
    (.var 1 - 1) * (.var 1 - 1)
def endpoints := Rep.compose (Rep.equality endpointPolynomial 0) endpointGraphs
def pathRep := (endpoints.conjunction everyStep).conjunction commonMultiple

def closedRep :=
  (pathRep.reindex (fun j : Fin 5 => (Sum.inr j : Empty ⊕ Fin 5))).existsBlock
noncomputable def result := QuarticCompiler.compile closedRep
noncomputable def equation := result.polynomial
end DiophantineConsistency.SharedAffineProductProposal
