        "direct/odd_y",
        "--cofinal-y"
      ]
    },
    {
      "args": [
        "direct/build.py",
        "direct/self_radix",
        "--self-radix"
      ]
    },
    {
      "args": [
        "direct/build.py",
        "direct/self_radix_qf",
        "--self-radix",
        "--quadratic-first"
      ]
    },
    {
      "args": [
        "direct/build.py",
        "direct/self_radix_min",
        "--self-radix",
        "--quadratic-first",
        "--max-support",
        "32"
      ]
    },
    {
      "args": [
        "direct/center.py",
        "direct/self_radix",
        "direct/centered310"
      ]
    },
    {
      "args": [
        "direct/center.py",
        "direct/self_radix_qf",
        "direct/centered308"
      ]
    },
    {
      "args": [
        "direct/center.py",
        "direct/self_radix_min",
        "direct/centered307"
      ]
    },
    {
      "args": [
        "direct/check.py"
      ],
      "stdout_reference": "direct/CHECK_NORMAL.json"
    },
    {
      "args": [
        "direct/check_diagnostics.py"
      ],
      "stdout_reference": "direct/DIAGNOSTICS.json"
    },
    {
      "args": [
        "direct/check_report.py"
      ],
      "stdout_reference": "direct/REPORT_FORMULA_CHECK.json"
    },
    {
      "args": [
        "lowdegree/build.py"
      ]
    },
    {
      "args": [
        "lowdegree/review/audit.py"
      ],
      "stdout_reference": "lowdegree/review/NORMAL_RECEIPT.txt"
    },
    {
      "args": [
        "lowdegree/thirteen/build.py"
      ]
    },
    {
      "args": [
        "lowdegree/thirteen/review/audit.py"
      ],
      "stdout_reference": "lowdegree/thirteen/review/NORMAL_RECEIPT.txt"
    },
    {
      "args": [
        "positive/build.py"
      ],
      "stdout_reference": "positive/BUILD_CHECK.txt"
    },
    {
      "args": [
        "positive/build.py",
        "--check"
      ],
      "stdout_reference": "positive/BUILD_CHECK.txt"
    },
    {
      "args": [
        "positive/verify.py"
      ],
      "stdout_reference": "positive/VERIFY.txt"
    },
    {
      "args": [
        "integer/build.py"
      ],
      "stdout_reference": "integer/BUILD.txt"
    },
    {
      "args": [
        "integer/check.py"
      ],
      "stdout_reference": "integer/CHECK_NORMAL.txt"
    },
    {
      "args": [
        "review/positive/independent_check.py"
      ],
      "stdout_reference": "review/positive/CHECK_NORMAL.json"
    },
    {
      "args": [
        "review/independent_norm_audit.py",
        "integer"
      ],
      "stdout_reference": "review/integer/INDEPENDENT_{mode_upper}.txt"
    },
    {
      "args": [
        "review/independent_norm_audit.py",
        "lowdegree"
      ],
      "stdout_reference": "review/lowdegree/INDEPENDENT_{mode_upper}.txt"
    },
    {
      "args": [
        "review/independent_norm_audit.py",
        "thirteen"
      ],
      "stdout_reference": "review/lowdegree/thirteen/INDEPENDENT_{mode_upper}.txt"
    },
    {
      "args": [
        "review/integer/lemma_diagnostics.py"
      ],
      "stdout_reference": "review/integer/LEMMAS_{mode_upper}.txt"
    },
    {
      "args": [
        "baseline/audit_downloaded_data.py"
      ],
      "stdout_reference": "baseline/AUDIT_STDOUT.json"
    },
    {
      "args": [
        "review/report/verify_report_data.py",
        "--root",
        "."
      ],
      "stdout_reference": "review/report/REPORT_DATA_CHECK.json"
    },
    {
      "args": [
        "report/check_report.py"
      ],
      "stdout_reference": "report/DATA_CHECK.json"
    }
  ],
  "negative_control_targets": {
    "equation": "lowdegree/thirteen/equation.json",
    "coefficient": "positive/coefficients/K.bin.gz"
  },
  "environment_for_exact_receipt_bytes": {
    "python": "3.12.14",
    "sympy": "1.14.0",
    "note": "Normal and optimized environment-bearing receipts use mode-specific references."
  }
