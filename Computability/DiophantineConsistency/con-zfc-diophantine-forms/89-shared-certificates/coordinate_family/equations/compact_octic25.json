{
  "definitions": {
    "J0": "3*J3+1",
    "W": "4*(3*w3+1)",
    "q": "beta*J0+1",
    "C": "q-F-alpha",
    "k": "eta+zeta",
    "X": "W*q",
    "Delta": "a**2+4*a+3",
    "D": "X+a*c+gamma*(4*a+3)",
    "P": "k+E*(c-eta)",
    "R": "(q-F)*(q**3-q)-C*(q**2-1)+(MC+q*MF)*J0",
    "G": "cone_A*F*cone_B*C-(q-cone_A*F-cone_B*C)**2",
    "Z": "eta*zeta"
  },
  "residuals": [
    "a-E-(2*v_scale+1)*q**3",
    "E+(E-a)*X",
    "c-eta+(E-a)*k",
    "tau**2-P**2+P*k-1",
    "D**2-Delta*c**2-1",
    "k-1-h*E-R",
    "(K0+W)*C-z*(q-1)-F",
    "V+c-f*o",
    "V-j*c+k-1-h*E",
    "I-(2*r+1)*c**2",
    "I**2-Delta*(f**2-1)",
    "y**2-1-I**2*(y**2-V**2)",
    "G*Z-(pair_root**2-G-Z+1)**2-1-pair_pos1**2-pair_pos2**2-pair_pos3*(pair_pos3+1)"
  ],
  "variables": [
    "J3",
    "F",
    "alpha",
    "z",
    "f",
    "h",
    "r",
    "v_scale",
    "w3",
    "tau",
    "eta",
    "zeta",
    "y",
    "gamma",
    "o",
    "j",
    "E",
    "c",
    "a",
    "V",
    "I",
    "pair_root",
    "pair_pos1",
    "pair_pos2",
    "pair_pos3"
  ],
  "coefficient_binding": "../COEFFICIENT_BINDING.json",
  "single_polynomial": "sum of squares of the listed residuals"
}
