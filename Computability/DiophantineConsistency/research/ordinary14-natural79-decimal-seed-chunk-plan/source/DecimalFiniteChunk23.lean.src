/-- All 32 proposed equalities are finite; this proof is untested. -/
theorem chunk23 : ∀ i : Fin 32,
    printedBlocks.getD (736+i.val) 0 = selectorAt (736+i.val) ∧
    printedBlocks.getD (736+i.val) 0 = seedBlockAt (736+i.val) := by
