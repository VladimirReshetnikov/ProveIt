import DecimalFiniteCommon

/-! Inert source-only suggestion for indices [640, 672). -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 16384
namespace Natural79DecimalSeedChunkDraft
open Natural79PrintedDecimalBlocksDraft

/-- All 32 proposed equalities are finite; this proof is untested. -/
theorem chunk20 : ∀ i : Fin 32,
    printedBlocks.getD (640+i.val) 0 = selectorAt (640+i.val) ∧
    printedBlocks.getD (640+i.val) 0 = seedBlockAt (640+i.val) := by
  decide

end Natural79DecimalSeedChunkDraft
#print axioms Natural79DecimalSeedChunkDraft.chunk20
