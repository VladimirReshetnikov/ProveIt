import DiophantineConsistency.ZRows.PellEvenChebyshev
import DiophantineConsistency.ArithmeticPellResidueClasses

/-! Source-only draft; no Lean elaboration or endpoint claim. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace PellOrdinateParityModelDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open DiophantineConsistency
open ArithmeticPellRecurrence ArithmeticPellPeriodicity ArithmeticPellResidueClasses
open ZRowsPellEvenChebyshev
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- The represented main Pell ordinate has the parity of its model index. -/
theorem ordinate_mod_two (n b : V) : ycoord n b % 2 = n % 2 := by
  obtain ⟨t, ht | ht⟩ := even_or_odd n
  · rw [ht, double_y]
    have hleft : (2 * xcoord t b * ycoord t b) % 2 = 0 :=
      mod_eq_zero_iff_dvd.mpr ⟨xcoord t b * ycoord t b, by ring⟩
    have hright : (2 * t) % 2 = 0 := mod_eq_zero_iff_dvd.mpr ⟨t, by ring⟩
    rw [hleft, hright]
  · rw [ht]
    have hd : (2 : V) ∣ 2 * (b + 3) := ⟨b + 3, by ring⟩
    have hp : (0 : V) < 2 := by norm_num
    have hl := mod_reduce (ycoord (2 * t + 1) b) 2 (2 * (b + 3)) hp hd
    have hr := mod_reduce (2 * t + 1) 2 (2 * (b + 3)) hp hd
    calc
      ycoord (2 * t + 1) b % 2 = (ycoord (2 * t + 1) b % (2 * (b + 3))) % 2 := hl.symm
      _ = ((2 * t + 1) % (2 * (b + 3))) % 2 := congrArg (fun z : V => z % 2) (sign_index b t).2
      _ = (2 * t + 1) % 2 := hr

end PellOrdinateParityModelDraft
