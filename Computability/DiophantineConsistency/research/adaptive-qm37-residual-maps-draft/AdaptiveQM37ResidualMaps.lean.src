  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 15)
        (extend (project v d)) := by simpa only [hlift] using hp 15
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same15 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 16)
        (extend (project v d)) := by simpa only [hlift] using hp 16
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same16 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 17)
        (extend (project v d)) := by simpa only [hlift] using hp 17
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same17 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 18)
        (extend (project v d)) := by simpa only [hlift] using hp 18
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same18 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 19)
        (extend (project v d)) := by simpa only [hlift] using hp 19
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same19 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 20)
        (extend (project v d)) := by simpa only [hlift] using hp 20
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
