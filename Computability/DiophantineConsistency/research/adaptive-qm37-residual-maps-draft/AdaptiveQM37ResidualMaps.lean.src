/-- The only altered retained residual differs by Q times the new
positive-difference residual. -/
theorem aux_relation (p : Fin 4 → ℤ) (v : Fin 37 → V) :
    (AdaptiveQM38ResidualsDraft.residuals p 2).evalRing (fun k => ι (extend v k)) =
      (AdaptiveQM37ResidualsDraft.residuals p 2).evalRing (fun k => ι (v k)) +
        ι (v 30) * (AdaptiveQM37ResidualsDraft.residuals p 4).evalRing (fun k => ι (v k)) := by
  simp [AdaptiveQM38ResidualsDraft.residuals, AdaptiveQM37ResidualsDraft.residuals,
    extend, Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add, map_mul] <;> ring

/-- Restoring the squares after projection gives back a parent satisfying the
parent square residuals. -/
theorem extend_project (v : Fin 38 → V) (d : V)
    (hs : v 13=v 25*v 25) (hy : v 30=v 11*v 11) :
    extend (project v d)=v := by
  funext i
  fin_cases i <;> simp [extend, project, hs, hy]

/-- The projected new difference residual is zero under the natural additive
square-difference equality; no signed natural subtraction is used. -/
theorem project_difference (p : Fin 4 → ℤ) (v : Fin 38 → V) (d : V)
    (hd : v 11*v 11=v 25*v 25+d) :
    InternalZero (AdaptiveQM37ResidualsDraft.residuals p 4) (project v d) := by
  rw [ModelDifferenceRing.internalZero_iff]
  have h := congrArg (ι : V →+* DiffRing V) hd
  simp only [map_add,map_mul] at h
  simp [AdaptiveQM37ResidualsDraft.residuals, project,
    Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add, map_mul, map_one] <;> linear_combination -h

/-- A child zero lifts to a parent zero, conditional only on the proposed
residual identities above, all of which are in this same source. -/
theorem extend_zero (p : Fin 4 → ℤ) (v : Fin 37 → V)
    (hz : InternalZero (AdaptiveQM37LiteralDraft.literal p) v) :
    InternalZero (AdaptiveQM38LiteralDraft.literal p) (extend v) := by
  have hc := (AdaptiveQM37ResidualZerosDraft.all_residuals p v).mp hz
  have hd := (ModelDifferenceRing.internalZero_iff _ _).mp (hc 4)
  apply (AdaptiveQM38ResidualZerosDraft.all_residuals p (extend v)).mpr
  intro i
  fin_cases i
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same00 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 0)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same01 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 1)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [aux_relation p v, hd, mul_zero, add_zero]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 2)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same03 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 3)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    exact dropped04 p v
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same05 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 5)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same06 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 6)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same07 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 7)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same08 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 8)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same09 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 9)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same10 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 10)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same11 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 11)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same12 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 12)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same13 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 13)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same14 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 14)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same15 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 15)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same16 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 16)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same17 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 17)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same18 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 18)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same19 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 19)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same20 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 20)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    exact dropped21 p v
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same21 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 21)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same22 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 22)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same23 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 23)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same24 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 24)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same25 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 25)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same26 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 26)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [same27 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 27)

/-- A parent zero and the explicit nonnegative difference project to a child
zero. Existence of the difference is supplied separately by parent_difference. -/
theorem project_zero (p : Fin 4 → ℤ) (v : Fin 38 → V) (d : V)
    (hz : InternalZero (AdaptiveQM38LiteralDraft.literal p) v)
    (hd : v 11*v 11=v 25*v 25+d) :
    InternalZero (AdaptiveQM37LiteralDraft.literal p) (project v d) := by
  have hp := (AdaptiveQM38ResidualZerosDraft.all_residuals p v).mp hz
  obtain ⟨hs,hy⟩ := parent_square_values p v hz
  have hlift := extend_project v d hs hy
  have hdiff := project_difference p v d hd
  have hdiffR := (ModelDifferenceRing.internalZero_iff _ _).mp hdiff
  apply (AdaptiveQM37ResidualZerosDraft.all_residuals p (project v d)).mpr
  intro i
  fin_cases i
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 0)
        (extend (project v d)) := by simpa only [hlift] using hp 0
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same00 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 1)
        (extend (project v d)) := by simpa only [hlift] using hp 1
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same01 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 2)
        (extend (project v d)) := by simpa only [hlift] using hp 2
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [aux_relation p (project v d), hdiffR, mul_zero, add_zero] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 3)
        (extend (project v d)) := by simpa only [hlift] using hp 3
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same03 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · exact hdiff
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 5)
        (extend (project v d)) := by simpa only [hlift] using hp 5
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same05 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 6)
        (extend (project v d)) := by simpa only [hlift] using hp 6
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same06 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 7)
        (extend (project v d)) := by simpa only [hlift] using hp 7
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same07 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 8)
        (extend (project v d)) := by simpa only [hlift] using hp 8
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same08 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 9)
        (extend (project v d)) := by simpa only [hlift] using hp 9
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same09 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 10)
        (extend (project v d)) := by simpa only [hlift] using hp 10
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same10 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 11)
        (extend (project v d)) := by simpa only [hlift] using hp 11
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same11 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 12)
        (extend (project v d)) := by simpa only [hlift] using hp 12
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same12 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 13)
        (extend (project v d)) := by simpa only [hlift] using hp 13
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same13 p (project v d)] at hr
