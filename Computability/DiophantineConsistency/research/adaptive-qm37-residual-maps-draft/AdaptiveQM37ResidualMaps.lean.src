    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 23)
        (extend (project v d)) := by simpa only [hlift] using hp 23
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same22 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 24)
        (extend (project v d)) := by simpa only [hlift] using hp 24
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same23 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 25)
        (extend (project v d)) := by simpa only [hlift] using hp 25
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same24 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 26)
        (extend (project v d)) := by simpa only [hlift] using hp 26
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same25 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 27)
        (extend (project v d)) := by simpa only [hlift] using hp 27
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same26 p (project v d)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM38ResidualsDraft.residuals p 28)
        (extend (project v d)) := by simpa only [hlift] using hp 28
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
