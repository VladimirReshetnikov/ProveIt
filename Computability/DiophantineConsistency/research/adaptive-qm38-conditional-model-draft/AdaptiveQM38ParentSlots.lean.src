import DiophantineConsistency.AdaptiveQM40Zeros
import DiophantineConsistency.ModelDifferenceRing

/-! Proposed recovery of the two deleted values from parent residuals.
All declarations in this source-only draft are unelaborated. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
noncomputable section
namespace DiophantineConsistency.AdaptiveQM38ParentSlotsDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ModelDifferenceRing
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- The parent sum-of-squares residual at index 20 binds slot 29. -/
theorem slot29_of_zero (p : Fin 4 → ℤ) (v : Fin 40 → V)
    (hz : InternalZero (AdaptiveQM40Context.literal p) v) :
    v 29 = v 17*(v 17+(v 9+v 10)) := by
  have h := (AdaptiveQM40Zeros.new_all p v).mp hz 20
  change InternalZero
    ((.var 29)-(.var 17)*((.var 17)+((.var 9)+(.var 10))) : Expr (Fin 40)) v at h
  have hr := (ModelDifferenceRing.internalZero_iff _ v).mp h
  simp only [Expr.evalRing_sub, Expr.evalRing_mul, Expr.evalRing_add, Expr.evalRing_var] at hr
  apply ι_injective
  simpa only [map_mul, map_add] using (sub_eq_zero.mp hr)

/-- The parent sum-of-squares residual at index 24 binds slot 33. -/
theorem slot33_of_zero (p : Fin 4 → ℤ) (v : Fin 40 → V)
    (hz : InternalZero (AdaptiveQM40Context.literal p) v) :
    v 33 = v 26*v 22 := by
  have h := (AdaptiveQM40Zeros.new_all p v).mp hz 24
  change InternalZero ((.var 33)-(.var 26)*(.var 22) : Expr (Fin 40)) v at h
  have hr := (ModelDifferenceRing.internalZero_iff _ v).mp h
  simp only [Expr.evalRing_sub, Expr.evalRing_mul, Expr.evalRing_var] at hr
  apply ι_injective
  simpa only [map_mul] using (sub_eq_zero.mp hr)

end DiophantineConsistency.AdaptiveQM38ParentSlotsDraft
#print axioms DiophantineConsistency.AdaptiveQM38ParentSlotsDraft.slot29_of_zero
#print axioms DiophantineConsistency.AdaptiveQM38ParentSlotsDraft.slot33_of_zero
