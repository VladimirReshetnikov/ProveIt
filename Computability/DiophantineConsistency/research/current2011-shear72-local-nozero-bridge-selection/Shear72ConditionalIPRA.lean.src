import OrdinarySphere7160IPRA
import DiophantineConsistency.Shear72Literal

/-! SOURCE ONLY. The literal import is prospective; no theorem in this
    client or its selected provider combination has been elaborated here. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.Shear72ConditionalIPRADraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic LO.Entailment
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 HAExpressionAssembly FoundationHANoZero
open PRALanguage IPRANativeTheory IPRAFoundationZFCMappedNegation FoundationZFCConsistencyNat

/-- Both expressions use the current four integer ports and positive shift. -/
def child : Expr (Fin 14) :=
  positiveShift (Shear72LiteralDraft.expressionAt CurrentWindowCarry2011.ports)
def parent : Expr (Fin 14) :=
  positiveShift (OrdinarySphere7160Literal.expressionAt CurrentWindowCarry2011.ports)

/-- Local copy of the exact all-model no-zero interface. -/
def SameNoZero {n m : ℕ} (e : Expr (Fin n)) (f : Expr (Fin m)) : Prop :=
  ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁],
    (∀ v : Fin n → V, ¬InternalZero e v) ↔ ∀ v : Fin m → V, ¬InternalZero f v

/-- Each direction may change the valuation; no same-witness assertion. -/
def ParentToChild : Prop :=
  ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁],
    ∀ v : Fin 14 → V, InternalZero parent v → ∃ w : Fin 14 → V, InternalZero child w

def ChildToParent : Prop :=
  ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁],
    ∀ v : Fin 14 → V, InternalZero child v → ∃ w : Fin 14 → V, InternalZero parent w

/-- Both valuation-changing maps yield the required all-model no-zero equivalence. -/
theorem same_no_zero (forward : ParentToChild) (reverse : ChildToParent) :
    SameNoZero child parent := by
  intro V _ _
  constructor
  · intro hc v hv
    obtain ⟨w,hw⟩ := forward V v hv
    exact hc w hw
  · intro hp v hv
    obtain ⟨w,hw⟩ := reverse V v hv
    exact hp w hw

/-- The bridge transports the checked parent polynomial endpoint. -/
theorem bridge72 (forward : ParentToChild) (reverse : ChildToParent) :
    PolynomialBridge child := by
  intro V _ _
  have eqv : (classicalNoZero child).Evalb (M := V) ![] ↔
      (classicalNoZero parent).Evalb (M := V) ![] := by
    rw [classicalNoZero_iff, classicalNoZero_iff]
    simpa only [InternalZero, ne_eq] using same_no_zero forward reverse V
  exact eqv.trans (OrdinarySphere7160IPRA.bridge71 V)

theorem native_equivalence72 (forward : ParentToChild) (reverse : ChildToParent) :
    nativeTheory ⊢ IPRAExpressionNative.nativeNoZero child 🡘
      ∼mappedNativeRefutation embedding :=
  IPRAExpressionNative.equivalence_of_bridge child (bridge72 forward reverse)

theorem standard_equivalence72 (forward : ParentToChild) (reverse : ChildToParent) :
    IPRAStandardTheory.standardTheory ⊢ IPRAExpressionNative.nativeNoZero child 🡘
      ∼mappedNativeRefutation embedding :=
  (IPRAStandardTheory.provable_iff _).2 (native_equivalence72 forward reverse)

theorem standard_translated_equivalence72 (forward : ParentToChild) (reverse : ChildToParent) :
    IPRAStandardTheory.standardTheory ⊢ IPRAExpressionNative.nativeNoZero child 🡘
      (Semiformula.lMap embedding sourceSentence)ᴺ := by
  apply (IPRAStandardTheory.provable_iff _).2
  obtain ⟨h⟩ := native_equivalence72 forward reverse
  have z := IPRABoundedRhoZFC.zfcEquiv
  exact ⟨Entailment.K_intro
    (Entailment.C_trans (Entailment.K_left h) (Entailment.K_right z))
    (Entailment.C_trans (Entailment.K_left z) (Entailment.K_right h))⟩

end DiophantineConsistency.Shear72ConditionalIPRADraft
#print axioms DiophantineConsistency.Shear72ConditionalIPRADraft.bridge72
#print axioms DiophantineConsistency.Shear72ConditionalIPRADraft.native_equivalence72
#print axioms DiophantineConsistency.Shear72ConditionalIPRADraft.standard_equivalence72
#print axioms DiophantineConsistency.Shear72ConditionalIPRADraft.standard_translated_equivalence72
