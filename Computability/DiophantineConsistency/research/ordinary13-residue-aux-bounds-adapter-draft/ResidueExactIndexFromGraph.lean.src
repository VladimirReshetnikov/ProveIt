import ResidueAuxBoundsAdapter
import ResidueExactIndexModel
import ResidueRankLower

/-! Proposed actual-graph composition through P72Exact.indices_ordinary.
The rank window and all source/provider/port obligations remain explicit. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
noncomputable section
namespace DiophantineConsistency.ResidueExactIndexFromGraphDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011
open Residue90GraphNormsDraft Residue90FyForceDraft
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- Conditional on the actual graph zero, J/beta/X positivity, positive C,
and rank window, propose the exact-index conclusions. No Bézout or q∣X
conclusion is supplied. Eta and zeta are the shifted positive coordinates. -/
theorem exact_indices_of_graph (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (Residue90LiteralDraft.literal (fun j => (p j:ℤ))) v)
    (hJ : 0<v 0) (hbeta : 0<(p 0:V)) (hX : 0<v 6)
    (hgap : (v 1+1)+(v 2+1)<q p v)
    (hwindow : rank p v+(q p v)^3+q p v+1≤(q p v)^4) :
    ∃ tau n s mainIndex u : V, 0<u ∧
      tau*tau=1+(m p v)*(m p v+1)*(k v)*(k v) ∧
      13≤n ∧ n<mainIndex ∧ mainIndex=rank p v ∧ 2*n=rank p v+1 ∧
      n≤k v ∧ k v=2*n+4*(m p v)*s := by
  obtain ⟨_,_,_,hU⟩ := Residue90CompactGraphGammaDraft.scale_facts p v hJ hbeta
  obtain ⟨d,hd⟩ := ResidueAuxBoundsAdapterDraft.main_natural_of_graph p v hz hU
  have hdelta : delta p v=ArithmeticPellRecurrence.delta (a p v) := by
    dsimp [delta,H,ArithmeticPellRecurrence.delta]
    ring
  have hg : d*d=1+ArithmeticPellRecurrence.delta (a p v)*c p v*c p v := by
    simpa only [hdelta] using hd
  obtain ⟨mainIndex,hmy⟩ := ResidueExactIndexModelDraft.main_index_of_natural_norm (a p v) (c p v) d hg
  have hZ := ResidueAuxBoundsAdapterDraft.ordinate_square_large p v hz hJ hbeta hX
  have hFq : v 1+1≤q p v := le_trans (by simp) (le_of_lt hgap)
  obtain ⟨u,hu,haux⟩ := ResidueAuxWitnessDraft.old_aux_of_direct_graph p v hz hFq hZ
  have haux' : ((3+4*a p v)+a p v*a p v)*(v 3*v 3-1)*
        (ArithmeticPellHalfIndex.absdiff (v 3*v 3*((v 5+1)*c p v)) (v 3*v 3*rank p v+c p v)*
         ArithmeticPellHalfIndex.absdiff (v 3*v 3*((v 5+1)*c p v)) (v 3*v 3*rank p v+c p v))+
        ArithmeticPellHalfIndex.absdiff (v 3*v 3*((v 5+1)*c p v)+u) (v 3*v 3*rank p v+c p v)*
        ArithmeticPellHalfIndex.absdiff (v 3*v 3*((v 5+1)*c p v)+u) (v 3*v 3*rank p v+c p v)=
      1+((3+4*a p v)+a p v*a p v)*(v 3*v 3-1)*
        (ArithmeticPellHalfIndex.absdiff (v 3*v 3*((v 5+1)*c p v)+u) (v 3*v 3*rank p v+c p v)*
         ArithmeticPellHalfIndex.absdiff (v 3*v 3*((v 5+1)*c p v)+u) (v 3*v 3*rank p v+c p v)) := by
    simpa only [ResidueAuxWitnessDraft.leftPart,ResidueAuxWitnessDraft.rightPart,delta,H] using haux
  have hi : 0<v 4+1 := lt_of_le_of_lt (Arithmetic.zero_le _) (lt_add_one _)
  have hf := (f_y_positive p v hz).1
  have hstrong := ResidueAuxWitnessDraft.ordinary_strong p v hz
  have hstrong' : ((v 4+1)*c p v*c p v)*((v 4+1)*c p v*c p v)+
      ArithmeticPellRecurrence.delta (a p v)=ArithmeticPellRecurrence.delta (a p v)*(v 3*v 3) := by
    simpa only [hdelta] using hstrong
  have hR26 := ResidueRankLowerDraft.graph_rank_at_least_26 p v hgap
  obtain ⟨tau,n,s,htau,hn13,hnlt,hindex,heq,hnk,hks⟩ :=
    ResidueExactIndexModelDraft.exact_indices_of_actual_graph p v d (v 4+1) u mainIndex
      hz hJ hbeta hX hgap hR26 hwindow hi hf hmy hg hstrong' haux'
  exact ⟨tau,n,s,mainIndex,u,hu,htau,hn13,hnlt,hindex,heq,hnk,hks⟩
end DiophantineConsistency.ResidueExactIndexFromGraphDraft
#print axioms DiophantineConsistency.ResidueExactIndexFromGraphDraft.exact_indices_of_graph
