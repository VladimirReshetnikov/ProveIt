  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 21)
        (extend beta (project v)) := by simpa only [hlift] using hp 21
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same21 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 22)
        (extend beta (project v)) := by simpa only [hlift] using hp 22
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same22 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 23)
        (extend beta (project v)) := by simpa only [hlift] using hp 23
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same23 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 24)
        (extend beta (project v)) := by simpa only [hlift] using hp 24
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same24 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 25)
        (extend beta (project v)) := by simpa only [hlift] using hp 25
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same25 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 27)
        (extend beta (project v)) := by simpa only [hlift] using hp 27
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same26 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr

/-- The earlier fixed-port graph obligations, conditional only on these
unelaborated residual/slot source proofs. -/
theorem graphZeroObligations : GraphZeroObligations := by
  intro V _ _ beta hbeta
  constructor
  · intro v _ hz
    exact project_zero CurrentWindowCarry2011.ports beta v hbeta hz
  · intro v _ hz
    exact extend_zero CurrentWindowCarry2011.ports beta v hbeta hz

end DiophantineConsistency.AdaptiveQM36ResidualMapsDraft
