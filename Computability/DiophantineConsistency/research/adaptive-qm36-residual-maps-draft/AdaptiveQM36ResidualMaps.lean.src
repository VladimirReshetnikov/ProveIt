/-- A parent zero projects to a child zero under the exact beta cast. -/
theorem project_zero (p : Fin 4 → ℤ) (beta : V) (v : Fin 37 → V)
    (hbeta : ((p 0 : ℤ) : DiffRing V)=ι beta)
    (hz : InternalZero (AdaptiveQM37LiteralDraft.literal p) v) :
    InternalZero (AdaptiveQM36Literal155Draft.literal p) (project v) := by
  have hp := (AdaptiveQM37ResidualZerosDraft.all_residuals p v).mp hz
  have h20 := product_slot p beta v hbeta hz
  have h33 := gamma_slot p v hz
  have hlift := extend_project beta v h20 h33
  have hcombined := project_combined p beta v hbeta hz
  have hcombinedR := (ModelDifferenceRing.internalZero_iff _ _).mp hcombined
  apply (AdaptiveQM36ResidualZerosDraft.all_residuals p (project v)).mpr
  intro i
  fin_cases i
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 0)
        (extend beta (project v)) := by simpa only [hlift] using hp 0
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same00 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 1)
        (extend beta (project v)) := by simpa only [hlift] using hp 1
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same01 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 2)
        (extend beta (project v)) := by simpa only [hlift] using hp 2
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same02 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 3)
        (extend beta (project v)) := by simpa only [hlift] using hp 3
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same03 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 4)
        (extend beta (project v)) := by simpa only [hlift] using hp 4
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same04 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 5)
        (extend beta (project v)) := by simpa only [hlift] using hp 5
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same05 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 6)
        (extend beta (project v)) := by simpa only [hlift] using hp 6
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same06 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 7)
        (extend beta (project v)) := by simpa only [hlift] using hp 7
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same07 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 8)
        (extend beta (project v)) := by simpa only [hlift] using hp 8
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same08 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 9)
        (extend beta (project v)) := by simpa only [hlift] using hp 9
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same09 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 10)
        (extend beta (project v)) := by simpa only [hlift] using hp 10
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same10 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · exact hcombined
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 12)
        (extend beta (project v)) := by simpa only [hlift] using hp 12
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same12 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 13)
        (extend beta (project v)) := by simpa only [hlift] using hp 13
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same13 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 14)
        (extend beta (project v)) := by simpa only [hlift] using hp 14
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same14 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 15)
        (extend beta (project v)) := by simpa only [hlift] using hp 15
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [d_relation p beta (project v) hbeta, hcombinedR, mul_zero, add_zero] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 16)
        (extend beta (project v)) := by simpa only [hlift] using hp 16
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same16 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 17)
        (extend beta (project v)) := by simpa only [hlift] using hp 17
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same17 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 18)
        (extend beta (project v)) := by simpa only [hlift] using hp 18
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same18 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 19)
        (extend beta (project v)) := by simpa only [hlift] using hp 19
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [same19 p beta (project v) hbeta] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveQM37ResidualsDraft.residuals p 20)
        (extend beta (project v)) := by simpa only [hlift] using hp 20
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
