import P72ExactEtaNatural
import PellOrdinateParity

/-! Source-only zeta-zero adaptation of EtaZeroIndexParityDraft. The general
eta-natural exact-index and parity imports are unelaborated; no graph binding,
provider replay or Lean proof is claimed. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 2000000
noncomputable section
namespace ZetaZeroIndexParityDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open DiophantineConsistency
open ArithmeticPellRecurrence
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- Exact index hypotheses with zeta zero are inconsistent with the Pell
ordinate parity theorem. This statement assumes no graph evaluation. -/
theorem zeta_zero_contradiction (q X Y k R g c a y0 i' f T u n s μ m : V)
    (hq3 : 3 ≤ q) (hX : 0 < X) (hy0 : 0 < y0) (hYq : Y = q * (q * q) * y0)
    (hc : c = k + Y * k) (hi' : 0 < i') (hf : 0 < f)
    (ha : a = X * Y + Y)
    (hR26 : 26 ≤ R)
    (hny : 2 * ycoord n (2 * ((X * Y) * Y - 1) + 1) = k)
    (hks : k = 2 * n + 4 * ((X * Y) * Y) * s) (hRμ : R + 1 < μ)
    (hnmod : (2 * n) % μ = R + 1)
    (hmy : ycoord m a = c)
    (hg : g * g = 1 + delta a * c * c)
    (hs' : (i' * c * c) * (i' * c * c) + delta a = delta a * (f * f))
    (haux : ((3 + 4 * a) + a * a) * (f * f - 1) *
        (absdiff (f * f * (T * c)) (f * f * R + c) * absdiff (f * f * (T * c)) (f * f * R + c)) +
        absdiff (f * f * (T * c) + u) (f * f * R + c) * absdiff (f * f * (T * c) + u) (f * f * R + c) =
      1 + ((3 + 4 * a) + a * a) * (f * f - 1) *
        (absdiff (f * f * (T * c) + u) (f * f * R + c) * absdiff (f * f * (T * c) + u) (f * f * R + c))) :
    False := by
  obtain ⟨_, _, hmR, hnR⟩ := P72ExactEtaNaturalDraft.indices_ordinary
    q X Y k R g c a y0 i' f T u n s μ m k hq3 hX hy0 hYq hc hi' hf ha
    hR26 hny hks hRμ hnmod hmy hg hs' haux
  have hplus : (R + 1) % 2 = 0 := by
    rw [← hnR]
    exact mod_eq_zero_iff_dvd.mpr ⟨n, by ring⟩
  have hRodd : R % 2 = 1 := by
    rcases mod_two R with hR0 | hR1
    · have hone : (R + 1) % 2 = 1 := by
        rw [mod_add (by norm_num : (0:V) < 2), hR0]
        simp
      exact False.elim (_root_.one_ne_zero (hone.symm.trans hplus))
    · exact hR1
  have hcdiv : (2 : V) ∣ c := by
    refine ⟨(1 + Y) * ycoord n (2 * ((X * Y) * Y - 1) + 1), ?_⟩
    rw [hc, ← hny]
    ring
  have hceven : c % 2 = 0 := mod_eq_zero_iff_dvd.mpr hcdiv
  have hcodd : c % 2 = 1 := calc
    c % 2 = ycoord m a % 2 := by rw [hmy]
    _ = m % 2 := PellOrdinateParityModelDraft.ordinate_mod_two m a
    _ = R % 2 := by rw [hmR]
    _ = 1 := hRodd
  exact _root_.one_ne_zero (hcodd.symm.trans hceven)

end ZetaZeroIndexParityDraft
