import DiophantineConsistency.Compact44.P72Root
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Linarith

/-! Source-only fact-level forcing of the first-root coordinate. The graph
must supply the signed branch and all listed arithmetic facts. No Lean check. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.Residue89RArithmeticDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open ModelDifferenceRing
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- Correct strict contradiction for the two possible square-root signs.
The essential bound is `k*(P-1)+t < 2*ell`, not `≤k*P`. -/
theorem r_positive_of_branches (r k P t m ell tau : V)
    (hk : 2≤k) (hP : 0<P) (hPm : P<m) (ht : 0<t) (htP : t≤P)
    (hell : ell=m*k) (htau : ell<tau)
    (hbranch : r=0 → (k*(P-1)+t+tau=ell ∨ k*(P-1)+t=ell+tau)) : 0<r := by
  by_contra hn
  have hr : r=0 := le_antisymm (le_of_not_gt hn) (Arithmetic.zero_le r)
  rcases hbranch hr with hp | hm
  · have hle : tau≤ell := by
      calc
        tau≤k*(P-1)+t+tau := by simp
        _=ell := hp
    exact (not_lt_of_ge hle) htau
  · have hkpos : 0<k := lt_of_lt_of_le (by simp : (0:V)<2) hk
    have hk1 : 1≤k := le_trans (by simp : (1:V)≤2) hk
    have hpred : P-1<m := lt_of_le_of_lt (tsub_le_self) hPm
    have hprod : k*(P-1)<ell := by
      rw [hell]
      simpa only [mul_comm] using (mul_lt_mul_of_pos_left hpred hkpos)
    have hmle : m≤ell := by rw [hell]; exact le_mul_of_one_le_right (Arithmetic.zero_le m) hk1
    have htlt : t<ell := lt_of_lt_of_le (lt_of_le_of_lt htP hPm) hmle
    have hsum : k*(P-1)+t<ell+ell := add_lt_add hprod htlt
    have hlt : ell+ell<ell+tau := add_lt_add_left htau ell
    exact (ne_of_lt (lt_trans hsum hlt)) hm

/-- At r=0, an exact signed root ±b*tau and represented P=b*t give
the two natural additive branches consumed above. -/
theorem branches_of_signed_root (b P t ell k tau : V) (z : DiffRing V)
    (hb : 0<b) (hP : 1≤P) (hPt : P=b*t)
    (hz : z=ι b*(ι ell+ι k-ι k*ι P)-ι P)
    (hsign : z=ι b*ι tau ∨ z= -(ι b*ι tau)) :
    k*(P-1)+t+tau=ell ∨ k*(P-1)+t=ell+tau := by
  have hbne : (ι b : DiffRing V)≠0 := by
    have h : (0:DiffRing V)<ι b := by simpa only [map_zero] using (ι_lt_ι.mpr hb)
    exact ne_of_gt h
  have hpcast : (ι P : DiffRing V)=ι b*ι t := by rw [hPt,map_mul]
  have hpred : (ι (P-1) : DiffRing V)=ι P-1 := by
    simpa only [map_one] using (P72Root.ι_tsub hP)
  rcases hsign with hs | hs
  · have he : (ι b : DiffRing V)*(ι k*(ι P-1)+ι t-ι ell+ι tau)=0 := by
      linear_combination hz-hs-hpcast
    have he0 := (mul_eq_zero.mp he).resolve_left hbne
    have heq : (ι k : DiffRing V)*(ι P-1)+ι t+ι tau=ι ell := by linear_combination he0
    left
    apply ι_injective
    simpa only [map_add,map_mul,hpred] using heq
  · have he : (ι b : DiffRing V)*(ι k*(ι P-1)+ι t-ι ell-ι tau)=0 := by
      linear_combination hz-hs-hpcast
    have he0 := (mul_eq_zero.mp he).resolve_left hbne
    have heq : (ι k : DiffRing V)*(ι P-1)+ι t=ι ell+ι tau := by linear_combination he0
    right
    apply ι_injective
    simpa only [map_add,map_mul,hpred] using heq

/-- A natural first norm gives tau>ell, without Pell classification. -/
theorem tau_gt_ell (m k ell tau : V) (hell : ell=m*k)
    (hnorm : tau*tau=1+m*(m+1)*k*k) : ell<tau := by
  apply lt_of_mul_self_lt_mul_self₀ (Arithmetic.zero_le _)
  rw [hnorm,hell]
  have hnonneg : (0:V)≤m*k*k := Arithmetic.zero_le _
  nlinarith

/-- Exact size cut used by the forced-r route. P is a positive represented
Bt with P+F=C*(X+K); all assumptions are explicit. -/
theorem P_below_m (q X Y K C F P m : V)
    (hq : 2≤q) (hX : 1≤X) (hY : q^3≤Y) (hK : K+1≤q^2)
    (hC : C<q) (hF : 0<F) (hP : P+F=C*(X+K)) (hm : m=X*Y*Y) : P<m := by
  have hq1 : 1≤q := le_trans (by simp : (1:V)≤2) hq
  have hXK : 0<X+K := lt_of_lt_of_le (lt_of_lt_of_le (by simp : (0:V)<1) hX) (by simp)
  have hstep1 : P<C*(X+K) := by rw [←hP]; exact lt_add_of_pos_right P hF
  have hstep2 : C*(X+K)<q*(X+K) := mul_lt_mul_of_pos_right hC hXK
  have hKX : K≤X*K := by
    simpa only [one_mul] using (mul_le_mul_of_nonneg_right hX (Arithmetic.zero_le K))
  have hsum : X+K≤X*(K+1) := by nlinarith
  have hstep3 : q*(X+K)≤X*q*(K+1) := by
    have h := mul_le_mul_of_nonneg_left hsum (Arithmetic.zero_le q)
    nlinarith
  have hstep4 : X*q*(K+1)≤X*q^3 := by
    have h := mul_le_mul_of_nonneg_left hK (Arithmetic.zero_le (X*q))
    nlinarith
  have hq3 : 1≤q^3 := one_le_pow₀ hq1
  have hY1 : 1≤Y := le_trans hq3 hY
  have hYsq : q^3≤Y*Y := le_trans hY (le_mul_of_one_le_right (Arithmetic.zero_le Y) hY1)
  have hstep5 : X*q^3≤m := by
    rw [hm]
    have h := mul_le_mul_of_nonneg_left hYsq (Arithmetic.zero_le X)
    nlinarith
  exact lt_of_lt_of_le (lt_trans hstep1 hstep2)
    (le_trans hstep3 (le_trans hstep4 hstep5))

end DiophantineConsistency.Residue89RArithmeticDraft
#print axioms DiophantineConsistency.Residue89RArithmeticDraft.r_positive_of_branches
#print axioms DiophantineConsistency.Residue89RArithmeticDraft.branches_of_signed_root
#print axioms DiophantineConsistency.Residue89RArithmeticDraft.tau_gt_ell
#print axioms DiophantineConsistency.Residue89RArithmeticDraft.P_below_m
