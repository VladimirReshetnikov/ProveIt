import Residue90GraphNorms
import Residue90GammaModel

/-! Conditional graph-to-gamma client. The graph norm proofs, arithmetic
client and this composition remain unelaborated source. Positive X,J, the
rank window and the displayed size/first-port inequalities are premises. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.Residue90GraphGammaDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ArithmeticSignedPairs
open Residue90GraphNormsDraft Residue90SignedNormsDraft
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- This client leaves the independent graph-to-positivity, C>0, size and
compact-rank arguments explicit; the two squared norms are extracted from the
graph's actual first/main residuals. -/
theorem gamma_positive_of_graph_facts (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (Residue90LiteralDraft.literal (fun j => (p j:ℤ))) v)
    (hb : 0<v 0*(p 0:V)) (hU : 0<U p v)
    (hq : 2≤q p v) (hX : 1≤v 6) (hY : (q p v)^3≤Y p v)
    (hFq : v 1+1≤q p v)
    (hR : rank p v+(q p v)^3+q p v+1≤(q p v)^4) : 0<v 12 := by
  have heta : 0<v 9+1 := lt_of_le_of_lt (Arithmetic.zero_le _) (lt_add_one _)
  have hzeta : 0<v 10+1 := lt_of_le_of_lt (Arithmetic.zero_le _) (lt_add_one _)
  obtain ⟨tau,htau⟩ := first_natural_norm (v 0*(p 0:V)) (m p v) (k v)
    (firstRoot p v) hb (first_ring_norm p v hz)
  by_contra hn
  have hg : v 12=0 := le_antisymm (le_of_not_gt hn) (Arithmetic.zero_le _)
  have hmain := main_ring_norm_at_zero p v hz hFq hg
  obtain ⟨d,hd⟩ := main_natural_norm (U p v) (delta p v) (c p v)
    (mainP p v) (mainN p v) hU hmain
  have hpair := main_pair_norm (U p v) (delta p v) (c p v) (mainP p v) (mainN p v) hmain
  have hdelta : (v 6*Y p v+Y p v+2)*(v 6*Y p v+Y p v+2)=delta p v+1 := by
    dsimp [delta,H,a]
    ring
  have hfirst : tau*tau=1+(v 6*Y p v*Y p v)*(v 6*Y p v*Y p v+1)*
      ((v 9+1)+(v 10+1))*((v 9+1)+(v 10+1)) := by
    simpa only [m,k] using htau
  have hmainnat : d*d=1+delta p v*((v 9+1)+Y p v*((v 9+1)+(v 10+1)))*
      ((v 9+1)+Y p v*((v 9+1)+(v 10+1))) := by
    simpa only [c,k] using hd
  have hcarrier : v 12=0 →
      let aa := v 6*Y p v+Y p v
      let cc := (v 9+1)+Y p v*((v 9+1)+(v 10+1))
      let HH := 3+4*aa
      let P := U p v*(v 6+aa*cc)+HH*(U p v*(0:V)+(rank p v+v 6*Y p v*q p v)+1)
      let N := HH*((v 9+1)+(v 10+1))
      magnitude (P,N)*magnitude (P,N)=U p v*U p v*(1+(HH+aa*aa)*(cc*cc)) := by
    intro _
    simpa only [mainP,mainN,delta,H,a,c,k,mul_zero,zero_add] using hpair
  have hp := Residue90GammaModelDraft.gamma_pos_of_fact_cut (q p v) (v 6) (Y p v)
    (v 9+1) (v 10+1) (rank p v) (U p v) tau d (delta p v) (v 12)
    hq hX hY heta hzeta hU hR hdelta hfirst hmainnat hcarrier
  exact (not_lt_of_ge (le_of_not_gt hn)) hp
end DiophantineConsistency.Residue90GraphGammaDraft
#print axioms DiophantineConsistency.Residue90GraphGammaDraft.gamma_positive_of_graph_facts
