import DiophantineConsistency.PellPeriodFullWB

/-! SOURCE ONLY: arithmetic replacement proposals and clients conditional on
    an explicit quoted-body evaluation bridge. No Lean run has occurred. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.PellPeriodFinalReplacementsDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic
open ArithmeticPellRecurrence PellPeriodFullWBDraft
open PRAWitnessBoundTerms PRAWitnessBoundTerms.BoundTerm

section Model
variable {V : Type} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- Keep r when c is positive; at c=0 replace it by zero. -/
theorem replaceR (c x r : V) (hx : x=1+c*c*r) :
    ∃ r' ≤ x, x=1+c*c*r' := by
  rcases eq_zero_or_pos c with hc | hc
  · refine ⟨0, by simp, ?_⟩
    simpa [hc] using hx
  · have hc2 : 1≤c*c := one_le_mul (pos_iff_one_le.mp hc) (pos_iff_one_le.mp hc)
    have hr : r≤c*c*r := by
      simpa [mul_assoc,mul_comm,mul_left_comm] using
        (le_mul_of_one_le_right (a := r) (by simp) hc2)
    refine ⟨r, ?_, hx⟩
    calc
      r ≤ c*c*r := hr
      _ ≤ 1+c*c*r := by simp
      _ = x := hx.symm

/-- Keep t when c is positive; at c=0 replace it by zero. -/
theorem replaceT (c y t : V) (hy : y=t*c*c) :
    ∃ t' ≤ y, y=t'*c*c := by
  rcases eq_zero_or_pos c with hc | hc
  · refine ⟨0, by simp, ?_⟩
    simpa [hc] using hy
  · have hc2 : 1≤c*c := one_le_mul (pos_iff_one_le.mp hc) (pos_iff_one_le.mp hc)
    refine ⟨t, ?_, hy⟩
    calc
      t ≤ t*(c*c) := le_mul_of_one_le_right (by simp) hc2
      _ = y := by simpa [mul_assoc] using hy.symm

/-- All graph and arithmetic conjuncts of the exact final period body. -/
def BodyData (t r y x h c m a : V) : Prop :=
  yDef.val.Evalb ![c,m,a] ∧ h=2*m*c ∧
    xDef.val.Evalb ![x,h,a] ∧ yDef.val.Evalb ![y,h,a] ∧
    x=1+c*c*r ∧ y=t*c*c
end Model

/-- Explicit unproved interpretation of the quoted finalBody. -/
def BodyEvaluationBridge : Prop :=
  ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁] (e : Fin 8 → V),
    finalBody.Eval e Empty.elim ↔
      BodyData (e 0) (e 1) (e 2) (e 3) (e 4) (e 5) (e 6) (e 7)

/-- Proposed t replacement, conditional only on that source-evaluation bridge. -/
theorem tReplacement (evalBody : BodyEvaluationBridge) : Replacement finalBody boundT := by
  intro V _ _ e t ht
  have hd := (evalBody V (t :> e)).mp ht
  change BodyData t (e 0) (e 1) (e 2) (e 3) (e 4) (e 5) (e 6) at hd
  rcases hd with ⟨hc,hh,hxg,hyg,hx,hy⟩
  obtain ⟨t',htle,hy'⟩ := replaceT (e 4) (e 1) t hy
  refine ⟨t', ?_, ?_⟩
  · simpa [boundT, PRAWitnessBoundTerms.BoundTerm.vval] using htle
  · apply (evalBody V (t' :> e)).mpr
    change BodyData t' (e 0) (e 1) (e 2) (e 3) (e 4) (e 5) (e 6)
    exact ⟨hc,hh,hxg,hyg,hx,hy'⟩

/-- Proposed r replacement, preserving the existential t and all graphs. -/
theorem rReplacement (evalBody : BodyEvaluationBridge) : Replacement bodyR boundR := by
  intro V _ _ e r hr
  change (∃⁰ finalBody).Eval (r :> e) Empty.elim at hr
  simp only [Semiformula.eval_ex] at hr
  obtain ⟨t, ht⟩ := hr
  have hd := (evalBody V (t :> r :> e)).mp ht
  change BodyData t r (e 0) (e 1) (e 2) (e 3) (e 4) (e 5) at hd
  rcases hd with ⟨hc,hh,hxg,hyg,hx,hy⟩
  obtain ⟨r',hrle,hx'⟩ := replaceR (e 3) (e 1) r hx
  refine ⟨r', ?_, ?_⟩
  · simpa [boundR, PRAWitnessBoundTerms.BoundTerm.vval] using hrle
  · change (∃⁰ finalBody).Eval (r' :> e) Empty.elim
    simp only [Semiformula.eval_ex]
    refine ⟨t, ?_⟩
    apply (evalBody V (t :> r' :> e)).mpr
    change BodyData t r' (e 0) (e 1) (e 2) (e 3) (e 4) (e 5)
    exact ⟨hc,hh,hxg,hyg,hx',hy⟩

end DiophantineConsistency.PellPeriodFinalReplacementsDraft
#print axioms DiophantineConsistency.PellPeriodFinalReplacementsDraft.replaceR
#print axioms DiophantineConsistency.PellPeriodFinalReplacementsDraft.replaceT
#print axioms DiophantineConsistency.PellPeriodFinalReplacementsDraft.tReplacement
#print axioms DiophantineConsistency.PellPeriodFinalReplacementsDraft.rReplacement
