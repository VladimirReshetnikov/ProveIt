import Residue90CompactPortBounds
import DiophantineConsistency.Compact44.CompactSymbolicModelIff

/-! Source-only tuple comparison. No graph bridge, file semantics or Lean
elaboration is claimed. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.Residue90CompactTupleDraft

/-- The particular symbolic compact kernel used by the retained endpoint. -/
def chosenKernel : ℕ :=
  CompactSymbolicKernelOpaque.paramKernel CompactSymbolicKernel.rho

/-- Integer cast of the residue-90 draft's natural port tuple. -/
def integerPorts (K : ℕ) : Fin 4 → ℤ :=
  fun j => (Residue90CompactPortBoundsDraft.ports K j : ℤ)

/-- The symbolic residue-90 tuple at the chosen K is the tuple used by
`CompactSymbolicModelIff.p` and the retained 87-operation endpoint. -/
theorem chosen_integer_ports :
    integerPorts chosenKernel = CompactSymbolicModelIff.p := by
  rfl

/-- An arbitrary K can be specialized only after proving its equality to the
chosen symbolic kernel; this does not identify any external file. -/
theorem integer_ports_of_kernel (K : ℕ) (hK : K = chosenKernel) :
    integerPorts K = CompactSymbolicModelIff.p := by
  subst K
  exact chosen_integer_ports

end DiophantineConsistency.Residue90CompactTupleDraft
#print axioms DiophantineConsistency.Residue90CompactTupleDraft.chosen_integer_ports
#print axioms DiophantineConsistency.Residue90CompactTupleDraft.integer_ports_of_kernel
