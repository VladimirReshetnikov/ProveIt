import EtaZetaNaturalXPositive
import Residue90SignedNorms
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring

/-! Actual eta/zeta-natural prototype graph-to-natural first/main norms.
Source-only; all graph/unit/provider and Lean obligations remain open. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
noncomputable section
namespace DiophantineConsistency.EtaZetaNaturalGraphNormsDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ModelDifferenceRing
open EtaZetaNaturalUnitGraphDraft EtaZetaNaturalXPositiveDraft
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

def X (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := q p v*v 6
def a (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := X p v*Y p v+Y p v
def delta (p : Fin 4 → ℕ) (v : Fin 13 → V) : V :=
  (3+4*a p v)+a p v*a p v
def m (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := X p v*Y p v*Y p v

def pp (p : Fin 4 → ℕ) : Fin 4 → ℤ := fun j => (p j:ℤ)
def emb (v : Fin 13 → V) : Fin 13 → DiffRing V := fun j => ι (v j)

/-- Literal graph fields bind to their model-natural representatives. These
are evaluation claims, not bounds or a graph-zero theorem. -/
theorem field_b (p : Fin 4 → ℕ) (v : Fin 13 → V) :
    (graph (pp p)).b.evalRing (emb v)=ι (v 0*(p 0:V)) := by
  simp [graph,Expr.evalRing_add,Expr.evalRing_mul,Expr.evalRing_var,
    Expr.evalRing_constant,Expr.evalRing_ofNat,pp,emb,P72Root.cast_port,map_mul]

theorem field_k (p : Fin 4 → ℕ) (v : Fin 13 → V) :
    (graph (pp p)).k.evalRing (emb v)=ι (k v) := by
  simp [graph,Expr.evalRing_add,Expr.evalRing_var,Expr.evalRing_ofNat,emb,k,map_add,map_one]

theorem field_ell (p : Fin 4 → ℕ) (v : Fin 13 → V) :
    (graph (pp p)).ell.evalRing (emb v)=ι (m p v*k v) := by
  simp [graph,Expr.evalRing_add,Expr.evalRing_mul,Expr.evalRing_var,
    Expr.evalRing_constant,Expr.evalRing_ofNat,pp,emb,P72Root.cast_port,
    X,Y,q,k,m,map_add,map_mul,map_one,map_ofNat] <;> ring

theorem field_U (p : Fin 4 → ℕ) (v : Fin 13 → V) :
    (graph (pp p)).u.evalRing (emb v)=ι (U p v) := by
  simp [graph,Expr.evalRing_add,Expr.evalRing_mul,Expr.evalRing_var,
    Expr.evalRing_constant,Expr.evalRing_ofNat,pp,emb,P72Root.cast_port,
    U,Y,q,map_add,map_mul,map_one,map_ofNat] <;> ring

theorem field_c (p : Fin 4 → ℕ) (v : Fin 13 → V) :
    (graph (pp p)).c.evalRing (emb v)=ι (c p v) := by
  simp [graph,Expr.evalRing_add,Expr.evalRing_mul,Expr.evalRing_var,
    Expr.evalRing_constant,Expr.evalRing_ofNat,pp,emb,P72Root.cast_port,
    c,k,Y,q,map_add,map_mul,map_one,map_ofNat] <;> ring

theorem field_delta (p : Fin 4 → ℕ) (v : Fin 13 → V) :
    (graph (pp p)).delta.evalRing (emb v)=ι (delta p v) := by
  simp [graph,Expr.evalRing_add,Expr.evalRing_mul,Expr.evalRing_var,
    Expr.evalRing_constant,Expr.evalRing_ofNat,pp,emb,P72Root.cast_port,
    delta,a,X,Y,q,map_add,map_mul,map_one,map_ofNat] <;> ring

/-- Positive first scale is explicit. The signed z is the actual graph field;
no original free-J core root or natural rank representation is assumed. -/
theorem first_natural_norm (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (graph (pp p)).output v) (hb : 0<v 0*(p 0:V)) :
    ∃ tau : V, tau*tau=1+(m p v)*(m p v+1)*(k v)*(k v) := by
  obtain ⟨hfirst,_,_,_⟩ := EtaZetaNaturalUnitBridgeDraft.signed_norms (pp p) v hz
  rw [field_b,field_k,field_ell] at hfirst
  let z : DiffRing V := (graph (pp p)).z.evalRing (emb v)
  have hn : z*z=ι (v 0*(p 0:V))*ι (v 0*(p 0:V))*
      ι (1+(m p v)*(m p v+1)*(k v)*(k v)) := by
    simp only [map_add,map_mul,map_one,map_ofNat] at hfirst ⊢
    dsimp [z]
    linear_combination hfirst
  exact Residue90SignedNormsDraft.first_natural_norm (v 0*(p 0:V)) (m p v) (k v) z hb hn

/-- The actual graph main root supplies a natural norm by the generic signed
square quotient. No gap, rank representation, or orientation is used. -/
theorem main_natural_norm (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (graph (pp p)).output v) (hU : 0<U p v) :
    ∃ g : V, g*g=1+delta p v*c p v*c p v := by
  obtain ⟨_,hmain,_,_⟩ := EtaZetaNaturalUnitBridgeDraft.signed_norms (pp p) v hz
  rw [field_U,field_delta,field_c] at hmain
  let z : DiffRing V := (graph (pp p)).d.evalRing (emb v)
  have hn : z*z=ι (U p v)*ι (U p v)*ι (1+delta p v*c p v*c p v) := by
    simp only [map_add,map_mul,map_one,map_ofNat] at hmain ⊢
    dsimp [z]
    linear_combination hmain
  obtain ⟨_,g,_,_,hg⟩ := Residue90SignedNormsDraft.signed_norm_quotient
    (U p v) (1+delta p v*c p v*c p v) z hU hn
  exact ⟨g,hg⟩

/-- With positive represented beta, the graph's J proof supplies b>0 and
q>0 supplies U>0. Eta and zeta remain natural inputs and can be zero. -/
theorem natural_norms_of_graph (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (graph (pp p)).output v) (hbeta : 0<(p 0:V)) :
    (∃ tau : V, tau*tau=1+(m p v)*(m p v+1)*(k v)*(k v)) ∧
      ∃ g : V, g*g=1+delta p v*c p v*c p v := by
  have hJ := EtaZetaNaturalJPositiveDraft.J_positive p v hz
  have hb : 0<v 0*(p 0:V) := mul_pos hJ hbeta
  have hq : 0<q p v := by dsimp [q]; simp
  have hs : 0<v 7+1 := lt_of_le_of_lt (Arithmetic.zero_le _) (lt_add_one _)
  have hY : 0<Y p v := by dsimp [Y]; exact mul_pos (mul_pos hq (mul_pos hq hq)) hs
  have hU : 0<U p v := by dsimp [U]; exact mul_pos hY (mul_pos hq hq)
  exact ⟨first_natural_norm p v hz hb,main_natural_norm p v hz hU⟩
end DiophantineConsistency.EtaZetaNaturalGraphNormsDraft
#print axioms DiophantineConsistency.EtaZetaNaturalGraphNormsDraft.first_natural_norm
#print axioms DiophantineConsistency.EtaZetaNaturalGraphNormsDraft.main_natural_norm
#print axioms DiophantineConsistency.EtaZetaNaturalGraphNormsDraft.natural_norms_of_graph
