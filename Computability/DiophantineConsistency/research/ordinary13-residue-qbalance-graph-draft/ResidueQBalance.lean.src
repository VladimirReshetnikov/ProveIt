import DiophantineConsistency.ArithmeticPellPowerRecovery
import Mathlib.Tactic.Ring

/-! Source-only natural oriented-balance calculation; no Lean execution. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.ResidueQBalanceDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- The exact-index witness w fixes W. Only positive q and Y are used to
cancel qY; no q∣X, coprimality, Bézout, or sign of a difference is assumed. -/
theorem q_balance (q X Y c k R gamma main s w : V)
    (hq : 0<q) (hYpos : 0<Y) (hY : Y=q*(q*q)*s)
    (hindex : k=R+1+4*(X*Y*Y)*w)
    (hroot : let a:=X*Y+Y; let H:=3+4*a; let U:=Y*(q*q)
      U*main+H*k=U*(X+a*c)+H*(U*gamma+X*Y*q+R+1)) :
    let a:=X*Y+Y; let H:=3+4*a; let W:=4*X*q*s*w
    q*(main+H*W)=q*(X+a*c+H*gamma)+H*X := by
  let a := X*Y+Y
  let H := 3+4*a
  let U := Y*(q*q)
  let W := 4*X*q*s*w
  have hscale : 4*(X*Y*Y)*w=U*W := by dsimp [U,W]; rw [hY]; ring
  have hroot' : U*main+H*(R+1+U*W)=
      U*(X+a*c)+H*(U*gamma+X*Y*q+R+1) := by
    simpa only [hindex,hscale] using hroot
  have hcancel : U*(main+H*W)=U*(X+a*c+H*gamma)+H*(X*Y*q) := by
    apply add_right_cancel (b:=H*(R+1))
    calc
      U*(main+H*W)+H*(R+1)=U*main+H*(R+1+U*W) := by ring
      _=U*(X+a*c)+H*(U*gamma+X*Y*q+R+1) := hroot'
      _=(U*(X+a*c+H*gamma)+H*(X*Y*q))+H*(R+1) := by ring
  have hqY : 0<q*Y := mul_pos hq hYpos
  apply mul_left_cancel₀ (ne_of_gt hqY)
  calc
    (q*Y)*(q*(main+H*W))=U*(main+H*W) := by dsimp [U]; ring
    _=U*(X+a*c+H*gamma)+H*(X*Y*q) := hcancel
    _=(q*Y)*(q*(X+a*c+H*gamma)+H*X) := by dsimp [U]; ring
end DiophantineConsistency.ResidueQBalanceDraft
#print axioms DiophantineConsistency.ResidueQBalanceDraft.q_balance
