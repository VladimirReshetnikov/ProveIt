import EtaZetaNaturalJPositive
import Residue90XZeroArithmetic
import Mathlib.Tactic.Ring

/-! Proposed exact eta/zeta-natural graph X>0. All providers and source proofs,
including the prototype factor-unit bridge, remain unelaborated. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
noncomputable section
namespace DiophantineConsistency.EtaZetaNaturalXPositiveDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ModelDifferenceRing
open EtaZetaNaturalUnitGraphDraft
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

def q (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := 1+v 0*(p 0:V)
def Y (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := q p v*(q p v*q p v)*(v 7+1)
def k (v : Fin 13 → V) : V := v 9+v 10
def c (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := v 9+Y p v*k v
def U (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := Y p v*(q p v*q p v)

/-- Exact signed rank; no truncated natural subtraction or C>0 is assumed. -/
def rankRing (p : Fin 4 → ℕ) (v : Fin 13 → V) : DiffRing V :=
  (ι (v 2+1)+(ι (q p v)-ι (v 1+1))*ι (v 0*(p 0:V)))*
    (ι (q p v)*ι (q p v)-1)+ι (v 0)*(ι (p 2:V)+ι (p 3:V)*ι (q p v))
def shiftRing (p : Fin 4 → ℕ) (v : Fin 13 → V) : DiffRing V :=
  ι (U p v)*ι (v 12)-((ι (v 9)+ι (v 10))-rankRing p v-1)

/-- With the prototype's own signed first and main factor norms, positive
represented beta and natural K0 imply v6>0. Since graph X=q*v6, X>0 follows.
The proof works also at eta=v9=0; zeta=v10 may be zero. -/
theorem witness_positive (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (graph (fun j => (p j:ℤ))).output v)
    (hbeta : 0<(p 0:V)) : 0<v 6 := by
  have hJ := EtaZetaNaturalJPositiveDraft.J_positive p v hz
  have hb : 0<v 0*(p 0:V) := mul_pos hJ hbeta
  have hq1 : 1<q p v := by dsimp [q]; exact lt_add_of_pos_right 1 hb
  have hq : 2≤q p v := by
    simpa only [show (1:V)+1=2 by ring] using lt_iff_succ_le.mp hq1
  have hs : 1≤v 7+1 := by simp
  have hYeq : Y p v=(q p v)^3*(v 7+1) := by dsimp [Y]; ring
  have hY : (q p v)^3≤Y p v := by
    rw [hYeq]
    exact le_mul_of_one_le_right (Arithmetic.zero_le _) hs
  by_contra hn
  have hx : v 6=0 := le_antisymm (le_of_not_gt hn) (Arithmetic.zero_le _)
  let pp : Fin 4 → ℤ := fun j => (p j:ℤ)
  let e : Fin 13 → DiffRing V := fun j => ι (v j)
  let z : DiffRing V := (graph pp).d.evalRing e
  have hshape : z=ι (Y p v*(q p v*q p v))*(ι (Y p v)*ι (c p v))+
      ι (3+4*Y p v)*shiftRing p v := by
    simp [z,graph,Expr.evalRing_add,Expr.evalRing_sub,Expr.evalRing_mul,
      Expr.evalRing_var,Expr.evalRing_constant,Expr.evalRing_ofNat,
      e,pp,P72Root.cast_port,hx,shiftRing,rankRing,U,Y,q,c,k,
      map_add,map_mul,map_one,map_ofNat,pow_succ] <;> ring
  have hnorms := EtaZetaNaturalUnitBridgeDraft.signed_norms pp v hz
  obtain ⟨_,hmain,_,_⟩ := hnorms
  have hnorm : z*z=ι (Y p v*(q p v*q p v))*ι (Y p v*(q p v*q p v))*
      (1+(ι (3+4*Y p v)+ι (Y p v)*ι (Y p v))*(ι (c p v)*ι (c p v))) := by
    simpa [z,graph,Expr.evalRing_add,Expr.evalRing_sub,Expr.evalRing_mul,
      Expr.evalRing_var,Expr.evalRing_constant,Expr.evalRing_ofNat,
      e,pp,P72Root.cast_port,hx,Y,q,c,k,map_add,map_mul,map_one,map_ofNat,pow_succ]
      using hmain
  exact Residue90XZeroArithmeticDraft.xzero_impossible (q p v) (Y p v) (c p v)
    z (shiftRing p v) hq hY hshape hnorm

/-- Prototype X is q*v6; q and the witness are both positive. -/
theorem X_positive (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (graph (fun j => (p j:ℤ))).output v)
    (hbeta : 0<(p 0:V)) : 0<q p v*v 6 := by
  have hJ := EtaZetaNaturalJPositiveDraft.J_positive p v hz
  have hq : 0<q p v := by dsimp [q]; exact add_pos_of_pos_of_nonneg (by simp) (le_of_lt (mul_pos hJ hbeta))
  exact mul_pos hq (witness_positive p v hz hbeta)
end DiophantineConsistency.EtaZetaNaturalXPositiveDraft
#print axioms DiophantineConsistency.EtaZetaNaturalXPositiveDraft.witness_positive
#print axioms DiophantineConsistency.EtaZetaNaturalXPositiveDraft.X_positive
