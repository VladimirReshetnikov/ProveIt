import ResidueThreeProjection
import ResidueExactIndexFromGraph
import ResidueMainCongruence

/-! Proposed actual-graph q∣3X client. Every source, imported provider and
model step remains unelaborated; no eta-zero or endpoint claim. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.ResidueThreeProjectionGraphDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ArithmeticSignedPairs
open Residue90GraphNormsDraft
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- The actual signed main root gives the required oriented balance with the
residue-adjusted X*Y*q term. Its graph identity and orientation source are
not Lean checked here. -/
theorem actual_main_balance (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (Residue90LiteralDraft.literal (fun j => (p j:ℤ))) v)
    (hU : 0<U p v) (hY8 : 8≤Y p v) (hk : 0<k v) (hFq : v 1+1≤q p v) :
    ∃ main : V, 0<main ∧
      U p v*main+H p v*k v=U p v*(v 6+a p v*c p v)+
        H p v*(U p v*v 12+v 6*Y p v*q p v+rank p v+1) := by
  have hmag := ResidueMainCongruenceDraft.actual_main_magnitude_norm p v hz hFq
  obtain ⟨main,hmain,hbalance,_⟩ := DirectMainNorm.direct_main_orientation
    (U p v) (v 6) (Y p v) (k v) (v 9+1) (v 12)
    (rank p v+v 6*Y p v*q p v) hU hY8 hk (by
      simpa only [ResidueMainCongruenceDraft.positivePart,
        ResidueMainCongruenceDraft.negativePart,delta,H,a,c,k] using hmag)
  refine ⟨main,hmain,?_⟩
  linear_combination -hbalance

/-- The actual graph's conditional exact index and main balance imply q∣3X.
The graph zero, positive J/beta/X, positive C and the rank window are explicit.
This theorem says nothing about q∣X, a q-power, or an endpoint. -/
theorem q_dvd_threeX_of_graph (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (Residue90LiteralDraft.literal (fun j => (p j:ℤ))) v)
    (hJ : 0<v 0) (hbeta : 0<(p 0:V)) (hX : 0<v 6)
    (hgap : (v 1+1)+(v 2+1)<q p v)
    (hwindow : rank p v+(q p v)^3+q p v+1≤(q p v)^4) : q p v ∣ 3*v 6 := by
  obtain ⟨_,hq2,hY,hU⟩ := Residue90CompactGraphGammaDraft.scale_facts p v hJ hbeta
  have hqpos : 0<q p v := lt_of_lt_of_le (by simp : (0:V)<2) hq2
  have hq8 : (8:V)≤(q p v)^3 := by
    have hh := pow_le_pow_left₀ (by simp : (0:V)≤2) hq2 3
    simpa using hh
  have hY8 : 8≤Y p v := le_trans hq8 hY
  have hk : 0<k v := add_pos
    (lt_of_le_of_lt (Arithmetic.zero_le _) (lt_add_one _))
    (lt_of_le_of_lt (Arithmetic.zero_le _) (lt_add_one _))
  have hFq : v 1+1≤q p v := le_trans (by simp) (le_of_lt hgap)
  obtain ⟨main,_,hbalance⟩ := actual_main_balance p v hz hU hY8 hk hFq
  obtain ⟨_,n,w,_,_,_,_,_,_,_,heq,_,hks⟩ :=
    ResidueExactIndexFromGraphDraft.exact_indices_of_graph p v hz hJ hbeta hX hgap hwindow
  have hindex : k v=rank p v+1+4*(v 6*Y p v*Y p v)*w := by
    simpa only [m,heq] using hks
  have hs : 0<v 7+1 := lt_of_le_of_lt (Arithmetic.zero_le _) (lt_add_one _)
  have hYeq : Y p v=q p v*(q p v*q p v)*(v 7+1) := rfl
  apply ResidueThreeProjectionDraft.q_dvd_threeX (q p v) (v 6) (Y p v) (c p v)
    (k v) (rank p v) (v 12) main (v 7+1) w hqpos hs hYeq hindex
  simpa only [a,H,U] using hbalance
end DiophantineConsistency.ResidueThreeProjectionGraphDraft
#print axioms DiophantineConsistency.ResidueThreeProjectionGraphDraft.actual_main_balance
#print axioms DiophantineConsistency.ResidueThreeProjectionGraphDraft.q_dvd_threeX_of_graph
