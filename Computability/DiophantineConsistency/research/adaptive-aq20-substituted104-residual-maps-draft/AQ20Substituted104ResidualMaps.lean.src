import AQ20Substituted104ConditionalTransfer
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination

/-! Proposed AQ20 residual identities and graph maps. No Lean check. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
noncomputable section
namespace DiophantineConsistency.AQ20Substituted104ResidualMapsDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ModelDifferenceRing
open AQ20Substituted104ConditionalTransferDraft
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- Parent residual 0 (A0) after scale extension. -/
theorem relation00 (p : Fin 4 → ℤ) (beta : V) (v : Fin 20 → V)
    (hb : ((p 0 : ℤ) : DiffRing V)=ι beta) :
    (AQ22Quotient110ResidualsDraft.residuals p 0).evalRing (fun k => ι (extend beta v k)) =
      (AQ20Substituted104ResidualsDraft.residuals p 0).evalRing (fun k => ι (v k)) := by
  simp [AQ22Quotient110ResidualsDraft.residuals, AQ20Substituted104ResidualsDraft.residuals,
    extend, Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    hb, map_add, map_mul, map_one] <;> ring

