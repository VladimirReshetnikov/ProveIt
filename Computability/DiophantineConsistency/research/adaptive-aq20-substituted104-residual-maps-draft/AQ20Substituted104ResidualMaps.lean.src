theorem relation10 (p : Fin 4 → ℤ) (beta : V) (v : Fin 20 → V)
    (hb : ((p 0 : ℤ) : DiffRing V)=ι beta) :
    (AQ22Quotient110ResidualsDraft.residuals p 12).evalRing (fun k => ι (extend beta v k)) =
