import DiophantineConsistency.ArithmeticPellPowerRecovery
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

/-! Conditional sign-free model arithmetic. The assumptions are explicit;
this source and its imports have not been elaborated together. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.ResidueSignFreePowerDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open ArithmeticPellRecurrence ArithmeticPellPowerRecovery
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- No cancellation of the factor 3 modulo q is used. -/
theorem sixteen_of_three_projection (q X : V)
    (hq : 46≤q) (hX : 0<X) (hdvd : q∣3*X) : 16≤X := by
  have hle : q≤3*X := Arithmetic.le_of_dvd (mul_pos (by simp) hX) hdvd
  by_contra hn
  have hlt : X<16 := lt_of_not_ge hn
  have h15 : X≤15 := by
    apply lt_succ_iff_le.mp
    simpa only [show (15:V)+1=16 by ring] using hlt
  have hm : 3*X≤(45:V) := by
    have hh := mul_le_mul_of_nonneg_left h15 (by simp : (0:V)≤3)
    simpa only [show (3:V)*15=45 by ring] using hh
  have hb : (46:V)≤45 := le_trans hq (le_trans hle hm)
  exact (not_lt_of_ge hb) (by norm_num : (45:V)<46)

/-- Fact-level growth. The actual recurrence coordinates and the paired
index are explicit: the present graph exact-index client does not export them. -/
theorem growth_of_coordinates (q X Y R n k c eta zeta : V)
    (hq : 46≤q) (hX : 0<X) (hdvd : q∣3*X) (hY : 1≤Y)
    (hn : 13≤n) (hR : 2*n=R+1)
    (hck : c=k*Y+eta) (hk : k=eta+zeta) (hzeta : 0<zeta)
    (hc : c=ycoord R (Y*(X+1)))
    (hfirst : k=2*ycoord n (2*(X*Y*Y-1)+1)) : Exp.exp R<Y := by
  have h16 := sixteen_of_three_projection q X hq hX hdvd
  let r := n-1
  have hn1 : 1≤n := le_trans (by simp : (1:V)≤13) hn
  have hrn : r+1=n := tsub_add_cancel_of_le hn1
  have hr : 2≤r := by
    apply (add_le_add_iff_right (1:V)).mp
    rw [hrn]
    have h3 : (3:V)≤13 := by
      simpa only [show (3:V)+10=13 by ring] using (show (3:V)≤3+10 by simp)
    simpa only [show (2:V)+1=3 by ring] using le_trans h3 hn
  have hR' : R=2*r+1 := by
    apply add_right_cancel (b:=(1:V))
    calc
      R+1=2*n := hR.symm
      _=2*(r+1) := by rw [hrn]
      _=(2*r+1)+1 := by ring
  rw [hR']
  apply power_bound X Y r k c eta zeta h16 hY hr hck hk hzeta
  · simpa only [hR'] using hc
  · simpa only [hrn] using hfirst

/-- Recover the power from the oriented q-balance and two Pell coordinates.
The witness W and balance must be supplied from the actual graph; no Bézout
or q∣X premise is used. -/
theorem power_of_oriented_balance (q X Y R c main gamma W : V)
    (hY : Exp.exp R<Y)
    (hx : xcoord R (Y*(X+1))=main)
    (hy : ycoord R (Y*(X+1))=c)
    (hYq : ∃ s : V, Y=q*(q*q)*s)
    (hbalance : let a:=Y*(X+1); let H:=3+4*a
      q*(main+H*W)=q*(X+a*c+H*gamma)+H*X) : X=Exp.exp R := by
  let a := Y*(X+1)
  let H := 3+4*a
  obtain ⟨s,hs⟩ := hYq
  let d := 4*(q*q)*s*(X+1)
  have hH : H=3+q*d := by dsimp [H,a,d]; rw [hs]; ring
  have hm : (q*d)*(main+H*W)=(q*d)*(X+a*c+H*gamma)+H*d*X := calc
    _=d*(q*(main+H*W)) := by ring
    _=d*(q*(X+a*c+H*gamma)+H*X) := by rw [hbalance]
    _=_ := by ring
  have hbal0 : H*(main+H*W)+3*(X+a*c+H*gamma)=
      3*(main+H*W)+H*(X+a*c+H*gamma)+H*d*X := calc
    _=3*(main+H*W)+(q*d)*(main+H*W)+3*(X+a*c+H*gamma) := by rw [hH]; ring
    _=3*(main+H*W)+((q*d)*(X+a*c+H*gamma)+H*d*X)+3*(X+a*c+H*gamma) := by rw [hm]
    _=_ := by rw [hH]; ring
  have hbal : 3*(X+a*c)+H*(main+H*W+3*gamma)=
      3*main+H*(3*W+X+a*c+H*gamma+d*X) := by
    calc
      _=H*(main+H*W)+3*(X+a*c+H*gamma) := by ring
      _=3*(main+H*W)+H*(X+a*c+H*gamma)+H*d*X := hbal0
      _=_ := by ring
  have hHp : 0<H := by dsimp [H]; simp
  have hmod : (3*(X+a*c))%H=(3*main)%H := by
    have h := congrArg (fun z : V => z%H) hbal
    rw [mod_add_mul' _ _ hHp,mod_add_mul' _ _ hHp] at h
    exact h
  obtain ⟨w,hw⟩ := projection_quotient a R
  have hproj : main=Exp.exp R+a*c+H*w := by
    have hh := hw
    rw [hx,hy] at hh
    dsimp [H]
    simpa only [show 3+4*a=4*a+3 by ring] using hh
  have hres : (3*X+3*a*c)%H=(3*Exp.exp R+3*a*c)%H := calc
    _=(3*(X+a*c))%H := by congr 1; ring
    _=(3*main)%H := hmod
    _=(3*Exp.exp R+3*a*c+H*(3*w))%H := by rw [hproj]; congr 1; ring
    _=(3*Exp.exp R+3*a*c)%H := mod_add_mul' _ _ hHp
  have h3mod : (3*X)%H=(3*Exp.exp R)%H := mod_cancel hHp hres
  have hY1 : 1≤Y := le_trans (one_le_exp R) (le_of_lt hY)
  have hXa : X<a := lt_of_lt_of_le (lt_add_one X)
    (le_mul_of_one_le_left (by simp) hY1)
  have hYa : Y≤a := le_mul_of_one_le_right (by simp) (by simp)
  have h3a : 3*a<H := calc
    3*a<3*a+(a+3) := lt_add_of_pos_right _ (by simp)
    _=H := by dsimp [H]; ring
  have h3X : 3*X<H := lt_trans (mul_lt_mul_of_pos_left hXa (by simp)) h3a
  have h3exp : 3*Exp.exp R<H :=
    lt_trans (mul_lt_mul_of_pos_left (lt_of_lt_of_le hY hYa) (by simp)) h3a
  rw [mod_eq_self_of_lt h3X,mod_eq_self_of_lt h3exp] at h3mod
  exact mul_left_cancel₀ (by simp : (3:V)≠0) h3mod
end DiophantineConsistency.ResidueSignFreePowerDraft
#print axioms DiophantineConsistency.ResidueSignFreePowerDraft.sixteen_of_three_projection
#print axioms DiophantineConsistency.ResidueSignFreePowerDraft.growth_of_coordinates
#print axioms DiophantineConsistency.ResidueSignFreePowerDraft.power_of_oriented_balance
