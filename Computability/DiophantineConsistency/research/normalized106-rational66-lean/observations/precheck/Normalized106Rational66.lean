import DiophantineConsistency.ModelCarrierSyntax

/-! Literal 64 and 65 row graphs; generated by generate.py from the frozen JSON. -/
namespace DiophantineConsistency.Normalized106Rational66

variable {R : Type*} [CommRing R]

structure Head (R : Type*) where
  qm : R
  q : R
  q2 : R
  q3 : R
  X : R
  Y : R
  E : R
  k : R
  kY : R
  ell : R
  c : R
  a : R
  four_a : R
  H : R
  a2 : R
  Delta : R
  ac : R
  main_base : R
  gammaH : R
  main_root : R
  c2 : R
  Dc2 : R
  main_square : R
  N1 : R
  qF : R
  C : R
  gap_product : R
  gap : R

def head (p : Fin 4 → R) (v : Fin 14 → R) : Head R :=
  let beta := p 0
  let J := v 0
  let F := v 1
  let alpha := v 2
  let s := v 7
  let w := v 8
  let eta := v 10
  let zeta := v 11
  let gamma := v 13
  let qm := beta * J
  let q := qm + 1
  let q2 := q * q
  let q3 := q2 * q
  let X := w * q
  let Y := s * q3
  let E := X * Y
  let k := eta + zeta
  let kY := k * Y
  let ell := E * kY
  let c := kY + eta
  let a := E + Y
  let four_a := 4 * a
  let H := four_a + 3
  let a2 := a * a
  let Delta := a2 + H
  let ac := a * c
  let main_base := X + ac
  let gammaH := gamma * H
  let main_root := main_base + gammaH
  let c2 := c * c
  let Dc2 := Delta * c2
  let main_square := main_root * main_root
  let N1 := main_square - Dc2
  let qF := q - F
  let C := qF - alpha
  let gap_product := qm * qF
  let gap := gap_product + alpha
  ⟨qm, q, q2, q3, X, Y, E, k, kY, ell, c, a, four_a, H, a2, Delta, ac, main_base, gammaH, main_root, c2, Dc2, main_square, N1, qF, C, gap_product, gap⟩

def rank66 (h : Head R) (J Urank Wrank : R) : R :=
  let q2 := h.q2
  let gap := h.gap
  let q2minus1 := q2 - 1
  let shifted_gap := gap + Urank
  let rank_product := q2minus1 * shifted_gap
  let rank_linear := J * Wrank
  let R := rank_product + rank_linear
  R

def rank67 (h : Head R) (J MC MF : R) : R :=
  let q := h.q
  let q2 := h.q2
  let gap := h.gap
  let q2minus1 := q2 - 1
  let rproduct := gap * q2minus1
  let qMF := q * MF
  let maskfactor := MC + qMF
  let mask := maskfactor * J
  let R := rproduct + mask
  R

def suffix (p : Fin 4 → R) (v : Fin 14 → R) (h : Head R) (rank : R) : R :=
  let R := rank
  let K0 := p 1
  let z := v 3
  let f := v 4
  let i := v 5
  let T := v 6
  let w := v 8
  let n := v 9
  let y := v 12
  let qm := h.qm
  let E := h.E
  let k := h.k
  let ell := h.ell
  let c := h.c
  let Delta := h.Delta
  let c2 := h.c2
  let Dc2 := h.Dc2
  let N1 := h.N1
  let qF := h.qF
  let C := h.C
  let En := E * n
  let tau_partial := En + k
  let tau := tau_partial - R
  let tau2 := tau * tau
  let ell_plus_k := ell + k
  let first_product := ell * ell_plus_k
  let N0 := tau2 - first_product
  let Kw := K0 + w
  let transport := Kw * C
  let transport_partial := transport + qF
  let zqm := z * qm
  let Nt := transport_partial - zqm
  let f2 := f * f
  let cT := c * T
  let cTminusR := cT - R
  let f2inner := f2 * cTminusR
  let V := f2inner - c
  let i2 := i * i
  let i2Dc2 := i2 * Dc2
  let strong_term := i2Dc2 * c2
  let Z := f2 - strong_term
  let V2 := V * V
  let y2 := y * y
  let square_gap := V2 - y2
  let f2minus1 := f2 - 1
  let Theta := Delta * f2minus1
  let auxiliary := Theta * square_gap
  let U := auxiliary + y2
  let product0 := N0 * N1
  let product1 := product0 * U
  let product2 := product1 * Nt
  let product3 := product2 * Z
  let polynomial := product3 - 1
  polynomial

def value66 (p : Fin 4 → R) (v : Fin 14 → R) (Urank Wrank : R) : R :=
  let h := head p v
  suffix p v h (rank66 h (v 0) Urank Wrank)

def value67 (p : Fin 4 → R) (v : Fin 14 → R) : R :=
  let h := head p v
  suffix p v h (rank67 h (v 0) (p 2) (p 3))

/-- Pure commutative-ring identity; neither division nor cancellation is used. -/
theorem rank_identity (beta J gap Urank MC MF : R) (h : beta * Urank = MF) :
    ((beta * J + 1)^2 - 1) * (gap + Urank) + J * (MC - MF) =
      gap * ((beta * J + 1)^2 - 1) + (MC + (beta * J + 1) * MF) * J := by
  have hz : beta * Urank - MF = 0 := sub_eq_zero.mpr h
  calc
    _ = gap * ((beta * J + 1)^2 - 1) + (MC + (beta * J + 1) * MF) * J +
        J * ((beta * J + 1) + 1) * (beta * Urank - MF) := by ring
    _ = _ := by rw [hz, mul_zero, add_zero]

theorem ranks_equal (p : Fin 4 → R) (v : Fin 14 → R) (Urank Wrank : R)
    (hu : p 0 * Urank = p 3) (hw : Wrank = p 2 - p 3) :
    rank66 (head p v) (v 0) Urank Wrank =
      rank67 (head p v) (v 0) (p 2) (p 3) := by
  subst Wrank
  change (((p 0 * v 0 + 1) * (p 0 * v 0 + 1)) - 1) *
      ((head p v).gap + Urank) + v 0 * (p 2 - p 3) =
    (head p v).gap * (((p 0 * v 0 + 1) * (p 0 * v 0 + 1)) - 1) +
      (p 2 + (p 0 * v 0 + 1) * p 3) * v 0
  simpa only [pow_two] using rank_identity (p 0) (v 0) (head p v).gap Urank (p 2) (p 3) hu

/-- Pointwise equality of the complete literal-row outputs. -/
theorem values_equal (p : Fin 4 → R) (v : Fin 14 → R) (Urank Wrank : R)
    (hu : p 0 * Urank = p 3) (hw : Wrank = p 2 - p 3) :
    value66 p v Urank Wrank = value67 p v := by
  simp only [value66, value67, ranks_equal p v Urank Wrank hu hw]

theorem zero_iff (p : Fin 4 → R) (v : Fin 14 → R) (Urank Wrank : R)
    (hu : p 0 * Urank = p 3) (hw : Wrank = p 2 - p 3) :
    value66 p v Urank Wrank = 0 ↔ value67 p v = 0 := by
  rw [values_equal p v Urank Wrank hu hw]

/-- Bind the literal 67-row graph to the historical 106 expression. -/
theorem value67_eq_syntax (p : Fin 4 → ℤ) (v : Fin 14 → R) :
    value67 (fun j => (p j : R)) v =
      (ModelCarrierCurrent.expressionAt106 p).evalRing v := by
  simp only [value67, head, rank67, suffix, ModelCarrierCurrent.expressionAt106,
    Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul, Expr.evalRing_pow,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    Nat.cast_ofNat, Nat.cast_one, pow_succ, pow_zero, one_mul, mul_assoc]

/-- Literal 66 output equals the 106 syntax under the two fixed-leaf equations. -/
theorem value66_eq_syntax (p : Fin 4 → ℤ) (v : Fin 14 → R) (Urank Wrank : R)
    (hu : (p 0 : R) * Urank = (p 3 : R)) (hw : Wrank = (p 2 : R) - (p 3 : R)) :
    value66 (fun j => (p j : R)) v Urank Wrank =
      (ModelCarrierCurrent.expressionAt106 p).evalRing v := by
  rw [values_equal _ _ Urank Wrank hu hw, value67_eq_syntax]

#print axioms values_equal
#print axioms value67_eq_syntax
#print axioms value66_eq_syntax

end DiophantineConsistency.Normalized106Rational66
