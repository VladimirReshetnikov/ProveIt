import Positive83To84Bridge
import ResidueThreeProjection
import ModifiedCarrierFacts

/-! Conditional positive-84 q∣X: exact modified-carrier projection plus the
compact Mersenne cancellation. Neither graph calibration cut is proved here. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.Positive84DivisionDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 Residue90CompactPortBoundsDraft
open Positive83To84TransportDraft Positive83To84BridgeDraft
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

def q84 (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := 1+v 0*(p 0:V)
def Y84 (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := q84 p v*(q84 p v*q84 p v)*v 7
def k84 (v : Fin 13 → V) : V := v 9+v 10
def c84 (p : Fin 4 → ℕ) (v : Fin 13 → V) : V := v 9+Y84 p v*k84 v

/-- Oriented, same-witness source facts for the *actual 84* carrier with
extra X*Y*q. No q∣X, 83 zero, or direct-carrier premise is assumed. -/
def OrientedIndexCut (p : Fin 4 → ℕ) (v : Fin 13 → V) : Prop :=
  ∃ R main w : V,
    k84 v=R+1+4*(v 6*Y84 p v*Y84 p v)*w ∧
    let a:=v 6*Y84 p v+Y84 p v
    let H:=3+4*a
    let U:=Y84 p v*(q84 p v*q84 p v)
    U*main+H*k84 v=U*(v 6+a*c84 p v)+
      H*(U*v 12+v 6*Y84 p v*q84 p v+R+1)

/-- Source-only q∣3X extraction from those fact-level exact inputs. -/
theorem three_of_oriented (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hv : ∀ i, 0<v i) (hi : OrientedIndexCut p v) : q84 p v∣3*v 6 := by
  obtain ⟨R,main,w,hindex,hbalance⟩ := hi
  have hq : 0<q84 p v := by
    dsimp [q84]
    exact add_pos_of_pos_of_nonneg (by simp) (Arithmetic.zero_le _)
  exact ResidueThreeProjectionDraft.q_dvd_threeX (q84 p v) (v 6) (Y84 p v)
    (c84 p v) (k84 v) R (v 12) main (v 7) w hq (hv 7) rfl hindex hbalance

def IndexGraphCut (K : ℕ) : Prop :=
  ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁] (v : Fin 13 → V),
    (∀ i, 0<v i) →
    InternalZero (PositiveUnscaled84GraphDraft.graph (fun j => (ports K j:ℤ))).output v →
      OrientedIndexCut (ports K) v

/-- The exponential exponent is supplied separately for this exact 84 zero.
It need not be identified with the index-cut rank to apply cancellation. -/
def PowerGraphCut (K : ℕ) : Prop :=
  ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁] (v : Fin 13 → V),
    (∀ i, 0<v i) →
    InternalZero (PositiveUnscaled84GraphDraft.graph (fun j => (ports K j:ℤ))).output v →
      ∃ R : V, v 6=Exp.exp R

/-- Assuming both graph cuts, recover precisely the q∣X cut needed by the
84→83 positive witness map, via the actual compact beta identity. -/
theorem divCut_of_index_and_power (K : ℕ) (hi : IndexGraphCut K) (hp : PowerGraphCut K) :
    Positive83To84BridgeDraft.DivCut K := by
  intro V _ _ v hv hz
  obtain ⟨R,hpow⟩ := hp V v hv hz
  have hthree := three_of_oriented (ports K) v hv (hi V v hv hz)
  have hp0 : (ports K 0:V)=(CompactFixedBeta.betaNat:V) := rfl
  have hthree' : (1+v 0*(CompactFixedBeta.betaNat:V))∣3*v 6 := by
    simpa only [q84,hp0] using hthree
  have hh := ModifiedCarrierFactsDraft.compact_beta_divides_X (v 0) R (v 6) hpow hthree'
  simpa only [Positive83To84TransportDraft.q,hp0] using hh
end DiophantineConsistency.Positive84DivisionDraft
#print axioms DiophantineConsistency.Positive84DivisionDraft.three_of_oriented
#print axioms DiophantineConsistency.Positive84DivisionDraft.divCut_of_index_and_power
