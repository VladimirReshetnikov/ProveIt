import DiophantineConsistency.ModelRelationCombining
import DiophantineConsistency.BFS943.Trace75IntegralTransport
import DiophantineConsistency.ArithmeticAdaptiveFactorThree2011
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring

/-! Proposed fact-level k=0 obstruction. Actual graph units, main shape,
rank representation/window, compact casts and all providers are unvalidated. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.IndependentKZeroMainRankDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open ModelDifferenceRing ArithmeticAdaptiveFactorThree2011
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- At k=0, the actual no-extra-term main norm and a represented natural
rank with R+1<q⁴ are incompatible. No main-root sign is assumed. -/
theorem zero_k_impossible (q X Y s R eta gamma : V) (z : DiffRing V)
    (hq : 0<q) (hs : 0<s) (hY : Y=q^3*s) (hR : R+1<q^4)
    (hshape : let a:=X*Y+Y; let H:=3+4*a; let U:=Y*(q*q)
      z=ι U*(ι X+ι a*ι eta)+ι H*(ι U*ι gamma+ι (R+1)))
    (hnorm : let a:=X*Y+Y; let H:=3+4*a; let U:=Y*(q*q)
      z*z=ι U*ι U*(1+(ι H+ι a*ι a)*(ι eta*ι eta))) : False := by
  let a : V := X*Y+Y
  let H : V := 3+4*a
  let U : V := Y*(q*q)
  have hYpos : 0<Y := by rw [hY]; exact mul_pos (pow_pos hq _) hs
  have hUpos : 0<U := by dsimp [U]; exact mul_pos hYpos (mul_pos hq hq)
  have hUne : (ι U : DiffRing V)≠0 := by
    have hh : (0:DiffRing V)<ι U := by simpa only [map_zero] using (ι_lt_ι.mpr hUpos)
    exact ne_of_gt hh
  have hsquare : (ι U : DiffRing V)^2 ∣ z^2 := by
    refine ⟨1+(ι H+ι a*ι a)*(ι eta*ι eta),?_⟩
    simpa only [pow_two] using hnorm
  have hdivz : (ι U : DiffRing V)∣z := ModelRelationCombining.sq_dvd_sq _ _ hUne hsquare
  obtain ⟨w,hw⟩ := hdivz
  have hdiv : (ι U : DiffRing V)∣ι (H*(R+1)) := by
    refine ⟨w-(ι X+ι a*ι eta)-ι H*ι gamma,?_⟩
    simp only [map_add,map_mul,map_one] at hshape ⊢
    linear_combination hw-hshape
  have hUeq : U=q^5*s := by dsimp [U]; rw [hY]; ring
  have hq5Signed : (ι (q^5) : DiffRing V)∣ι (H*(R+1)) := by
    obtain ⟨t,ht⟩ := hdiv
    refine ⟨ι s*t,?_⟩
    rw [ht,hUeq]
    simp only [map_mul]
    ring
  have hq5 : q^5∣H*(R+1) :=
    Trace75IntegralTransport.natural_dvd_of_signed (q^5) (H*(R+1)) hq5Signed
  have hYdiv : q^3∣Y := ⟨s,hY⟩
  have hq4 : q^4∣R+1 := by
    apply cancel_factor_three q Y X (R+1) hq hYdiv
    simpa only [H,a,show X*Y+Y=Y*(X+1) by ring] using hq5
  have hpos : 0<R+1 := lt_of_le_of_lt (Arithmetic.zero_le R) (lt_add_one R)
  have hle : q^4≤R+1 := Arithmetic.le_of_dvd hpos hq4
  exact (not_le_of_gt hR) hle
end DiophantineConsistency.IndependentKZeroMainRankDraft
#print axioms DiophantineConsistency.IndependentKZeroMainRankDraft.zero_k_impossible
