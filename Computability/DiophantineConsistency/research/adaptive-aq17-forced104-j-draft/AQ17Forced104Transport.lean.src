import AQ17Forced104JForce
import AQ17Forced105Evaluation
import AQ17Forced105CutExtraction
import Mathlib.Tactic.Ring

/-! Proposed 104→105 J-shift transport; none has been Lean elaborated. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
noncomputable section
namespace DiophantineConsistency.AQ17Forced104TransportDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic LO.Entailment
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ModelDifferenceRing HAExpressionAssembly HAExpressionNoZeroEquiv
open PRALanguage IPRANativeTheory IPRAFoundationZFCMappedNegation

def raiseJ {V : Type*} [Add V] [One V] (v : Fin 17 → V) (i : Fin 17) : V :=
  if i=0 then v i+1 else v i

def lowerJ {V : Type*} [Sub V] (v : Fin 17 → V) (i : Fin 17) : V :=
  if i=0 then v i-1 else v i

variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

theorem raise_lower (v : Fin 17 → V) (h : 0<v 0) : raiseJ (lowerJ v)=v := by
  funext i
  fin_cases i <;> simp [raiseJ,lowerJ,tsub_add_cancel_of_le (pos_iff_one_le.mp h)]

theorem relation00 (p : Fin 4 → ℤ) (v : Fin 17 → V) :
    (AQ17Forced105ResidualsDraft.residuals p 0).evalRing (fun k => ι (v k)) =
      (AQ17Forced104ResidualsDraft.residuals p 0).evalRing (fun k => ι (raiseJ v k)) := by
  simp [AQ17Forced105ResidualsDraft.residuals, AQ17Forced104ResidualsDraft.residuals,
    raiseJ, Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add,map_mul,map_one] <;> ring

theorem relation01 (p : Fin 4 → ℤ) (v : Fin 17 → V) :
    (AQ17Forced105ResidualsDraft.residuals p 1).evalRing (fun k => ι (v k)) =
      (AQ17Forced104ResidualsDraft.residuals p 1).evalRing (fun k => ι (raiseJ v k)) := by
  simp [AQ17Forced105ResidualsDraft.residuals, AQ17Forced104ResidualsDraft.residuals,
    raiseJ, Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add,map_mul,map_one] <;> ring

