    (AdaptiveQM40Context.residuals p 24).evalRing (fun k => ι (extend v k)) = 0 := by
  simp [AdaptiveQM40Context.residuals, AdaptiveQM38ResidualsDraft.residuals,
    extend, Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add, map_mul] <;> ring

/-- The 29 matching residuals and the two vanished residuals yield the
whole graph identity over the difference ring, for arbitrary ports. -/
theorem evaluation_identity (p : Fin 4 → ℤ) (v : Fin 38 → V) :
    (AdaptiveQM40Context.literal p).evalRing (fun k => ι (extend v k)) =
      (AdaptiveQM38LiteralDraft.literal p).evalRing (fun k => ι (v k)) := by
  rw [← AdaptiveQM40Context.literal_eq, ← AdaptiveQM38ResidualsDraft.sum_eq_literal]
  simp only [AdaptiveQM40Context.sum, AdaptiveQM38ResidualsDraft.sum,
    Expr.evalRing_add, Expr.evalRing_mul]
  have h00 := residual00 p v
  have h01 := residual01 p v
  have h02 := residual02 p v
  have h03 := residual03 p v
  have h04 := residual04 p v
  have h05 := residual05 p v
  have h06 := residual06 p v
  have h07 := residual07 p v
  have h08 := residual08 p v
  have h09 := residual09 p v
  have h10 := residual10 p v
  have h11 := residual11 p v
  have h12 := residual12 p v
  have h13 := residual13 p v
  have h14 := residual14 p v
  have h15 := residual15 p v
  have h16 := residual16 p v
  have h17 := residual17 p v
  have h18 := residual18 p v
  have h19 := residual19 p v
  have h20 := residual20 p v
  have h21 := residual21 p v
  have h22 := residual22 p v
  have h23 := residual23 p v
  have h24 := residual24 p v
  have h25 := residual25 p v
  have h26 := residual26 p v
  have h27 := residual27 p v
  have h28 := residual28 p v
  have hdrop20 := dropped20 p v
  have hdrop24 := dropped24 p v
  simp only [h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, h24, h25, h26, h27, h28, hdrop20, hdrop24, zero_mul, add_zero]

theorem evaluation_cut : AdaptiveQM38EvaluationCutDraft.EvaluationCut := by
  intro V _ _ v
  exact evaluation_identity CurrentWindowCarry2011.ports v

end DiophantineConsistency.AdaptiveQM38ResidualEvaluationDraft
#print axioms DiophantineConsistency.AdaptiveQM38ResidualEvaluationDraft.evaluation_identity
#print axioms DiophantineConsistency.AdaptiveQM38ResidualEvaluationDraft.evaluation_cut
