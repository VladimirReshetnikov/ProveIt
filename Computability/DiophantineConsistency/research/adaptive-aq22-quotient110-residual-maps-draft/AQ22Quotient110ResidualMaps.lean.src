/-- Projection followed by extension restores both roots. -/
theorem extend_project (v : Fin 22 → V) (u t : V)
    (hu : v 18=v 13*u) (ht : v 19=v 14*t) :
    extend (project v u t)=v := by
  funext i
  fin_cases i <;> simp [extend, project, ←hu, ←ht]

/-- The two new norm residuals vanish from the quotient norm equations. -/
theorem project_norm0 (p : Fin 4 → ℤ) (v : Fin 22 → V) (u t : V)
    (hu : u*u=1+v 16*(v 16+(v 9+v 10))) :
    InternalZero (AQ22Quotient110ResidualsDraft.residuals p 0) (project v u t) := by
  rw [ModelDifferenceRing.internalZero_iff]
  have h := congrArg (ι : V →+* DiffRing V) hu
  simp only [map_add,map_mul,map_one] at h
  simp [AQ22Quotient110ResidualsDraft.residuals, project,
    Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add,map_mul,map_one] <;> linear_combination h

theorem project_norm1 (p : Fin 4 → ℤ) (v : Fin 22 → V) (u t : V)
    (ht : t*t=1+v 21*v 17) :
    InternalZero (AQ22Quotient110ResidualsDraft.residuals p 1) (project v u t) := by
  rw [ModelDifferenceRing.internalZero_iff]
  have h := congrArg (ι : V →+* DiffRing V) ht
  simp only [map_add,map_mul,map_one] at h
  simp [AQ22Quotient110ResidualsDraft.residuals, project,
    Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add,map_mul,map_one] <;> linear_combination h

/-- Every child zero extends to a parent zero; the scales need not be
positive in this direction. -/
theorem extend_zero (p : Fin 4 → ℤ) (v : Fin 22 → V)
    (hz : InternalZero (AQ22Quotient110LiteralDraft.literal p) v) :
    InternalZero (AdaptiveAQ22Literal.literal p) (extend v) := by
  have hc := (AQ22Quotient110ResidualZerosDraft.all_residuals p v).mp hz
  apply (AdaptiveAQ22Zeros.sum_zero p (extend v)).mpr
  intro i
  fin_cases i
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation00 p v, (ModelDifferenceRing.internalZero_iff _ _).mp (hc 0), mul_zero]
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation01 p v, (ModelDifferenceRing.internalZero_iff _ _).mp (hc 1), mul_zero]
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation02 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 2)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation03 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 3)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation04 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 4)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation05 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 5)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation06 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 6)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation07 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 7)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation08 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 8)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation09 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 9)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation10 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 10)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation11 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 11)
  · apply (ModelDifferenceRing.internalZero_iff _ _).mpr
    rw [relation12 p v]
    exact (ModelDifferenceRing.internalZero_iff _ _).mp (hc 12)

/-- A parent zero projects using the two exact quotient equations and
norm equations; existence and positivity are proved separately. -/
theorem project_zero (p : Fin 4 → ℤ) (v : Fin 22 → V) (u t : V)
    (hz : InternalZero (AdaptiveAQ22Literal.literal p) v)
    (hzu : v 18=v 13*u) (hdt : v 19=v 14*t)
    (hun : u*u=1+v 16*(v 16+(v 9+v 10))) (htn : t*t=1+v 21*v 17) :
    InternalZero (AQ22Quotient110LiteralDraft.literal p) (project v u t) := by
  have hp := (AdaptiveAQ22Zeros.sum_zero p v).mp hz
  have hlift := extend_project v u t hzu hdt
  apply (AQ22Quotient110ResidualZerosDraft.all_residuals p (project v u t)).mpr
  intro i
  fin_cases i
  · exact project_norm0 p v u t hun
  · exact project_norm1 p v u t htn
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 2)
        (extend (project v u t)) := by simpa only [hlift] using hp 2
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation02 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 3)
        (extend (project v u t)) := by simpa only [hlift] using hp 3
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation03 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 4)
        (extend (project v u t)) := by simpa only [hlift] using hp 4
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation04 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 5)
        (extend (project v u t)) := by simpa only [hlift] using hp 5
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation05 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 6)
        (extend (project v u t)) := by simpa only [hlift] using hp 6
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation06 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 7)
        (extend (project v u t)) := by simpa only [hlift] using hp 7
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation07 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 8)
        (extend (project v u t)) := by simpa only [hlift] using hp 8
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation08 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 9)
        (extend (project v u t)) := by simpa only [hlift] using hp 9
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation09 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 10)
        (extend (project v u t)) := by simpa only [hlift] using hp 10
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation10 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 11)
        (extend (project v u t)) := by simpa only [hlift] using hp 11
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation11 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr
  · have hparent : InternalZero (AdaptiveAQ22Zeros.residuals p 12)
        (extend (project v u t)) := by simpa only [hlift] using hp 12
    have hr := (ModelDifferenceRing.internalZero_iff _ _).mp hparent
    rw [relation12 p (project v u t)] at hr
    exact (ModelDifferenceRing.internalZero_iff _ _).mpr hr

/-- Proposed discharge of both earlier graph obligations. This theorem,
like all source in the packet, remains unelaborated. -/
theorem graphZeroObligations : GraphZeroObligations := by
  intro V _ _
  constructor
  · intro v u t _ hz hzu hdt hun htn
    exact project_zero CurrentWindowCarry2011.ports v u t hz hzu hdt hun htn
  · intro v _ hz
    exact extend_zero CurrentWindowCarry2011.ports v hz

/-- Proposed closed client; quotient extraction and parent bridge are supplied
by the earlier source and its imported provider chain. -/
theorem native_equivalence : nativeTheory ⊢
    IPRAExpressionNative.nativeNoZero (positiveShift child) 🡘
      ∼mappedNativeRefutation embedding :=
  AQ22Quotient110ConditionalTransferDraft.native_equivalence graphZeroObligations

end DiophantineConsistency.AQ22Quotient110ResidualMapsDraft
