/-- Parent residual 0 (A0) after extension. -/
theorem relation00 (p : Fin 4 → ℤ) (v : Fin 22 → V) :
    (AdaptiveAQ22Zeros.residuals p 0).evalRing (fun k => ι (extend v k)) =
      ι (v 13) * ι (v 13) * (AQ22Quotient110ResidualsDraft.residuals p 0).evalRing (fun k => ι (v k)) := by
  simp [AdaptiveAQ22Zeros.residuals, AQ22Quotient110ResidualsDraft.residuals,
    extend, Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add, map_mul] <;> ring

