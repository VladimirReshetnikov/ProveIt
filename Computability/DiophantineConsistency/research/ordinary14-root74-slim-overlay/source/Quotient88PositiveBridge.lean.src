import Parent88Equivalence
import P88FourSquareModel
import CompactPortBoundsSlim

/-! Source-only proposed positive-model bridge for the 14-input quotient
88 graph. Every new graph/witness/model dependency remains unelaborated. -/
set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace DiophantineConsistency.Quotient88PositiveBridgeDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ModelDifferenceRing
open CompactSymbolicKernel CompactSymbolicKernelOpaque CompactSymbolicPorts
open IPRAOrdinary12 (PositiveModelBridge)
attribute [local irreducible] rho paramKernel CompactFixedBeta.betaNat lowNat highNat

def expression : Expr (Fin 14) := (P88QuotientGuarded.graph CompactSymbolicModelIff.p).output

/-- Proposed positive-model bridge obtained by composing the same symbolic
natural-port graph comparison with the parent positive-model bridge. -/
theorem positiveBridge : PositiveModelBridge expression := by
  intro V _ _
  let p : Fin 4 → ℕ := ports CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
  have hb := CompactPortBoundsSlimDraft.port_bounds (V:=V) CompactFixedBeta.betaNat (paramKernel rho) lowNat highNat
    CompactFixedBeta.beta_identity rfl rfl
  have hpair := Parent88EquivalenceDraft.positive_zero_iff (V:=V) p hb.1
  change (∃ v : Fin 13 → V, (∀ j, 0<v j) ∧ InternalZero P88FourSquareModel.expression v) ↔
    (∃ w : Fin 14 → V, (∀ j, 0<w j) ∧ InternalZero expression w) at hpair
  exact hpair.symm.trans (P88FourSquareModel.positiveBridge V)

end DiophantineConsistency.Quotient88PositiveBridgeDraft

#print axioms DiophantineConsistency.Quotient88PositiveBridgeDraft.positiveBridge
