    (i : Fin 484) (hi : naturalPowerLabel i.val ≠ 0) :
    naturalRegister p x i.val = naturalRegister p x 20 ^ naturalPowerLabel i.val := by
  apply run_power p x GapCircuit66.naturalNodes GapCircuit66.natural_topological
    naturalPowerLabel 20 (by decide +kernel)
  · intro j hj
    exact naturalPowerSteps ⟨j, by simpa only [GapCircuit66.natural_length] using hj⟩
  · simpa only [GapCircuit66.natural_length] using i.isLt
  · exact hi

