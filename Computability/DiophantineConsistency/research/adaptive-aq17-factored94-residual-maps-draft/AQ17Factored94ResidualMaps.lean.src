import AQ17Factored94ConditionalTransfer
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination

/-! Proposed AQ17/94 residual comparisons and graph maps; no Lean check. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
noncomputable section
namespace DiophantineConsistency.AQ17Factored94ResidualMapsDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ModelDifferenceRing
open AQ17Factored94ConditionalTransferDraft
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- Parent residual 0 (A0) after extension. -/
theorem relation00 (p : Fin 4 → ℤ) (v : Fin 17 → V) :
    (AQ20Substituted104ResidualsDraft.residuals p 0).evalRing (fun k => ι (extend v k)) =
      (AQ17Factored94ResidualsDraft.residuals p 0).evalRing (fun k => ι (v k)) := by
  simp [AQ20Substituted104ResidualsDraft.residuals, AQ17Factored94ResidualsDraft.residuals,
    extend, Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add,map_mul] <;> ring

