/-- Parent binding residual 5 (ellDifference) vanishes after extension. -/
theorem binding05 (p : Fin 4 → ℤ) (v : Fin 17 → V) :
    (AQ20Substituted104ResidualsDraft.residuals p 5).evalRing (fun k => ι (extend v k)) = 0 := by
  simp [AQ20Substituted104ResidualsDraft.residuals, AQ17Factored94ResidualsDraft.residuals,
    extend, Expr.evalRing_add, Expr.evalRing_sub, Expr.evalRing_mul,
    Expr.evalRing_var, Expr.evalRing_constant, Expr.evalRing_ofNat,
    map_add,map_mul] <;> ring

