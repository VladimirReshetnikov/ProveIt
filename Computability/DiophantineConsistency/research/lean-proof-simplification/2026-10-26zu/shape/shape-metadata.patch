+/-- The common node count of the two raw natural trees. -/
+def halfSize {σ : Type*} : Expr σ → ℕ
+  | .constant _ | .var _ => 1
+  | .add p q | .sub p q => 1 + halfSize p + halfSize q
+  | .mul p q => 3 + 2 * halfSize p + 2 * halfSize q
