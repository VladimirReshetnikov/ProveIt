def label (i : ℕ) : ℕ := labelsData.getD i 0

private theorem label_steps : ∀ i : Fin 484, i.val ≠ 20 → label i.val ≠ 0 →
    PowerStep GapData.naturalNodes label i.val := by
  decide +kernel

theorem power {R : Type*} [CommRing R] (p : Fin 11 → R) (x : Fin 9 → R)
    (i : ℕ) (hi : i < 484) (hp : label i ≠ 0) :
    value GapData.naturalNodes i p x =
      value GapData.naturalNodes 20 p x ^ label i := by
  apply run_power p x GapData.naturalNodes GapData.natural_topological label 20
    (by decide +kernel) (fun j hj => label_steps ⟨j, by
      simpa only [GapData.natural_length] using hj⟩) i
  · simpa only [GapData.natural_length] using hi
  · exact hp

-- An unchanged high-exponent fact, obtained without a chain of ring proofs.
example {R : Type*} [CommRing R] (p : Fin 11 → R) (x : Fin 9 → R) :
    value GapData.naturalNodes 375 p x =
      value GapData.naturalNodes 20 p x ^ 2200 :=
  power p x 375 (by decide) (by decide)

#print axioms power
end DiophantineConsistency.ProofSimplification.GapPowerCertificate

namespace DiophantineConsistency.ProofSimplification.GapFixtureDispatch
open ArithmeticDAG
set_option maxRecDepth 30000
set_option maxHeartbeats 1000000

variable {R : Type*} [CommRing R]

def reg (p : Fin 11 → R) (x : Fin 9 → R) (i : ℕ) : R :=
  value GapData.naturalNodes i p x

theorem step (p : Fin 11 → R) (x : Fin 9 → R) (i : ℕ) (hi : i < 484) :
    reg p x i = (GapData.naturalNodes.getD i (.literal 0)).evalAt p x (reg p x) :=
  run_node_equation p x GapData.naturalNodes GapData.natural_topological i
    (by simpa only [GapData.natural_length] using hi)

-- The statement has exactly the same content as natural_step_20.
example (p : Fin 11 → R) (x : Fin 9 → R) :
    reg p x 20 = reg p x 18 * reg p x 19 :=
  step p x 20 (by decide)

-- Selective specialization keeps the base as the intended cut point.
theorem base_identity (p : Fin 11 → R) (x : Fin 9 → R) :
    reg p x 20 = p 0 * (x 0 + 1)^2 := by
  simp only [step p x 20 (by decide), step p x 18 (by decide),
    step p x 19 (by decide), step p x 10 (by decide),
    step p x 0 (by decide), step p x 9 (by decide),
    GapData.naturalNodes, List.getD_cons_zero, List.getD_cons_succ, Node.evalAt, Fin.mk_zero]
  ring

#print axioms base_identity
end DiophantineConsistency.ProofSimplification.GapFixtureDispatch
