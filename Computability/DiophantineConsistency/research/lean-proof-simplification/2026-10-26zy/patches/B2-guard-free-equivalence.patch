+/-! ## Guard recovered from membership in the positive zero sets -/
+
+theorem gap_positive_beta (ports : Fin 4 → ℤ) (x : Fin 31 → ℤ)
+    (hx : Positive x) (hz : ∀ k, rows ports x k = 0) : 0 < ports 0 :=
+  SourceGuard.gap_rows_beta_pos (hx 0).le (hx 24) (hx 16) (hz 0) (hz 1)
+
+theorem old_positive_beta (ports : Fin 4 → ℤ) (x : Fin 31 → ℤ)
+    (hx : Positive x) (hz : ∀ k, SplitCertificate59.sourceRows ports x k = 0) :
+    0 < ports 0 :=
+  SourceGuard.old_rows_beta_pos (hx 0).le (hx 24) (hx 16) (hz 0) (hz 1)
+
+/-- The source equations supply beta positivity separately at each element.
+The old guarded API is retained for compatibility. -/
+def positiveZeroEquiv_all (ports : Fin 4 → ℤ) :
+    {x : Fin 31 → ℤ // Positive x ∧ ∀ k, rows ports x k=0} ≃
+      {x : Fin 31 → ℤ // Positive x ∧ ∀ k, SplitCertificate59.sourceRows ports x k=0} :=
+  SourceGuard.discharge (positiveZeroEquiv ports)
+    (fun x => gap_positive_beta ports x x.property.1 x.property.2)
+    (fun x => old_positive_beta ports x x.property.1 x.property.2)
+
+theorem exists_positive_zero_iff_all (ports : Fin 4 → ℤ) :
+    (∃ x : Fin 31 → ℤ, Positive x ∧ ∀ k, rows ports x k=0) ↔
+      ∃ x : Fin 31 → ℤ, Positive x ∧ ∀ k, SplitCertificate59.sourceRows ports x k=0 :=
+  (positiveZeroEquiv_all ports).exists_subtype_congr
+
+theorem exists_positive_nat_zero_iff_all (ports : Fin 4 → ℤ) :
+    (∃ x : Fin 31 → ℕ, (∀ i,0<x i) ∧ ∀ k, rows ports (fun i => (x i:ℤ)) k=0) ↔
+      ∃ x : Fin 31 → ℕ, (∀ i,0<x i) ∧ ∀ k,
+        SplitCertificate59.sourceRows ports (fun i => (x i:ℤ)) k=0 :=
+  (positive_nat_iff (fun x => ∀ k,rows ports x k=0)).trans
+    ((exists_positive_zero_iff_all ports).trans
+      (positive_nat_iff (fun x => ∀ k,SplitCertificate59.sourceRows ports x k=0)).symm)
+
 end DiophantineConsistency.GapSource66
