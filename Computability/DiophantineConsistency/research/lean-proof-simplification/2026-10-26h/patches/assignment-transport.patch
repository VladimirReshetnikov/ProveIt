+
+/-- Renaming input and witness coordinates commutes with natural assignment. -/
+theorem natAssignment_map {σ τ α β : Type*} (v : τ → ℕ) (w : β → ℕ)
+    (f : σ → τ) (g : α → β) :
+    natAssignment v w ∘ Sum.map f g =
+      natAssignment (v ∘ f) (w ∘ g) := by
+  funext i
+  cases i <;> rfl
+
+/-- Evaluate a coordinate renaming through its two assignment blocks. -/
+theorem Expr.eval_rename_natAssignment {σ τ α β : Type*} (e : Expr (σ ⊕ α))
+    (f : σ → τ) (g : α → β) (v : τ → ℕ) (w : β → ℕ) :
+    (e.rename (Sum.map f g)).eval (natAssignment v w) =
+      e.eval (natAssignment (v ∘ f) (w ∘ g)) := by
+  rw [Expr.eval_rename, natAssignment_map]
 
