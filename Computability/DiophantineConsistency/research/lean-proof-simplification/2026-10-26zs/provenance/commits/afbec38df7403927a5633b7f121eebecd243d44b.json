public","site_admin":false},"parents":[{"sha":"4fc484d4c834b9b5d59391139432710507984a81","url":"https://api.github.com/repos/VladimirReshetnikov/ProveIt/commits/4fc484d4c834b9b5d59391139432710507984a81","html_url":"https://github.com/VladimirReshetnikov/ProveIt/commit/4fc484d4c834b9b5d59391139432710507984a81"}],"stats":{"total":23,"additions":3,"deletions":20},"files":[{"sha":"d393766e1f4fc63c86fcdb2aec011b02dbc0ff08","filename":"Computability/DiophantineConsistency/Lean/DiophantineConsistency/NativeCyclicRotation.lean","status":"modified","additions":3,"deletions":20,"changes":23,"blob_url":"https://github.com/VladimirReshetnikov/ProveIt/blob/afbec38df7403927a5633b7f121eebecd243d44b/Computability%2FDiophantineConsistency%2FLean%2FDiophantineConsistency%2FNativeCyclicRotation.lean","raw_url":"https://github.com/VladimirReshetnikov/ProveIt/raw/afbec38df7403927a5633b7f121eebecd243d44b/Computability%2FDiophantineConsistency%2FLean%2FDiophantineConsistency%2FNativeCyclicRotation.lean","contents_url":"https://api.github.com/repos/VladimirReshetnikov/ProveIt/contents/Computability%2FDiophantineConsistency%2FLean%2FDiophantineConsistency%2FNativeCyclicRotation.lean?ref=afbec38df7403927a5633b7f121eebecd243d44b","patch":"@@ -17,26 +17,9 @@ def rotate (c : ZMod n → ℕ) (t k : ZMod n) : ℕ := c (k - t)\n \n theorem word_rotate {ρ : ℕ} (hρ : 1 ≤ ρ) (c : ZMod n → ℕ) (t : ZMod n) :\n     word ρ (rotate c t) ≡ ρ ^ t.val * word ρ c [MOD ρ ^ n - 1] := by\n-  have he : word ρ (rotate c t) = ∑ i : ZMod n, c i * ρ ^ (t + i).val := by\n-    symm\n-    apply Fintype.sum_equiv (Equiv.addLeft t)\n-    intro i\n-    simp only [rotate, Equiv.coe_addLeft, add_sub_cancel_left]\n-  rw [he]\n-  calc\n-    (∑ i : ZMod n, c i * ρ ^ (t + i).val) ≡\n-        ∑ i : ZMod n, c i * ρ ^ (t.val + i.val) [MOD ρ ^ n - 1] := by\n-      apply Nat.ModEq.sum\n-      intro i _\n-      have hp := (pow_mod_length (n := n) hρ (t.val + i.val)).symm\n-      rw [← ZMod.val_add] at hp\n-      exact hp.mul_left _\n-    _ = ρ ^ t.val * word ρ c := by\n-      rw [word, Finset.mul_sum]\n-      apply Finset.sum_congr rfl\n-      intro i _\n-      rw [pow_add]\n-      ring\n+  classical\n+  simpa [word, convolution, rotate, Pi.single_apply, ite_mul] using\n+    word_convolution hρ (Pi.single t 1) c\n \n /-- Carry the high part of each scaled radix digit into its successor,\n including the last-to-first cyclic carry. -/"}]}
