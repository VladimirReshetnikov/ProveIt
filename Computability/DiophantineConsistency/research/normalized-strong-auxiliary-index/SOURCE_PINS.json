  "theorem_conclusions": [
    "f=chi_A(m), i*c^2=psi_A(m) for a unique positive m",
    "c=psi_A(r) for a unique odd r with 3<=r<m",
    "r*c divides m; c odd; 0<r<c/2",
    "R congruent to +r or -r modulo c",
    "0<R<c/2 additionally implies r=R"
  ],
  "theorem_hypotheses": {
    "A": "integer >=3",
    "R": "arbitrary integer",
    "S": "(A^2-1)*i*c^2",
    "T": "arbitrary integer",
    "V": "f^2*(c*T-R)-c",
    "V_sign": "unrestricted; V nonzero follows from auxiliary norm",
    "auxiliary_norm": "S^2*(V^2-y^2)+y^2=1",
    "c": "integer >=2",
    "f": "positive integer",
    "i": "positive integer",
    "strong_norm": "f^2-(A^2-1)*i^2*c^4=1",
    "y": "arbitrary integer"
  },
