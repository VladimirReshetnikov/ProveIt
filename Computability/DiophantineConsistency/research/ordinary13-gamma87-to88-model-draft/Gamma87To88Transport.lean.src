import GammaShifted88Graph
import W86To87Transport
import GammaPrototypePositiveEta
import Mathlib.Tactic.Ring

/-! Source-only gamma shift and inherited model-zero transport. The 88
parent bridge remains a hypothesis; no Lean or provider build has run. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
noncomputable section
namespace DiophantineConsistency.Gamma87To88TransportDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic LO.Entailment
open scoped LO.FirstOrder LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ModelDifferenceRing HAExpressionAssembly HAExpressionNoZeroEquiv
open PRALanguage IPRANativeTheory IPRAFoundationZFCMappedNegation
open Residue90CompactPortBoundsDraft

def raiseGamma {V : Type*} [Add V] [One V] (v : Fin 13 → V) (i : Fin 13) : V :=
  if i=12 then v i+1 else v i
def lowerGamma {V : Type*} [Sub V] [One V] (v : Fin 13 → V) (i : Fin 13) : V :=
  if i=12 then v i-1 else v i
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

theorem raise_lower (v : Fin 13 → V) (h : 0<v 12) : raiseGamma (lowerGamma v)=v := by
  funext i
  fin_cases i <;> simp [raiseGamma,lowerGamma,tsub_add_cancel_of_le (pos_iff_one_le.mp h)]

theorem evaluation (p : Fin 4 → ℤ) (v : Fin 13 → V) :
    (GammaShifted88GraphDraft.literal p).evalRing (fun j => ι (v j)) =
      (WShifted87GraphDraft.literal p).evalRing (fun j => ι (raiseGamma v j)) := by
  simp [GammaShifted88GraphDraft.literal,WShifted87GraphDraft.literal,raiseGamma,
    Expr.evalRing_add,Expr.evalRing_sub,Expr.evalRing_mul,
    Expr.evalRing_var,Expr.evalRing_constant,Expr.evalRing_ofNat,
    map_add,map_mul,map_one] <;> ring

theorem zero_iff (p : Fin 4 → ℤ) (v : Fin 13 → V) :
    InternalZero (GammaShifted88GraphDraft.literal p) v ↔
      InternalZero (WShifted87GraphDraft.literal p) (raiseGamma v) := by
  rw [ModelDifferenceRing.internalZero_iff,ModelDifferenceRing.internalZero_iff,evaluation p v]

/-- From an 87 zero, raise w and then eta; these maps preserve gamma while
making eta positive. Neither reverse map nor ForcedEta is used. -/
theorem gamma_positive (K : ℕ) (v : Fin 13 → V)
    (hz : InternalZero (WShifted87GraphDraft.literal (fun j => (ports K j:ℤ))) v) : 0<v 12 := by
  let w := W86To87TransportDraft.raiseW v
  let e := EtaUnshift85TransportDraft.raiseEta w
  have hz86 := (W86To87TransportDraft.zero_iff (fun j => (ports K j:ℤ)) v).mp hz
  have hz85 := (EtaUnshift85TransportDraft.zero_iff (fun j => (ports K j:ℤ)) w).mp hz86
  have heta : 0<e 9 := by dsimp [e,EtaUnshift85TransportDraft.raiseEta]; simp
  have hg := GammaPrototypePositiveEtaDraft.gamma_positive K e hz85 heta
  simpa only [e,w,EtaUnshift85TransportDraft.raiseEta,W86To87TransportDraft.raiseW,
    show (12:Fin 13)≠9 by decide,show (12:Fin 13)≠6 by decide,if_false] using hg

theorem compact_no_zero_iff (K : ℕ) :
    (∀ v : Fin 13 → V, ¬InternalZero (WShifted87GraphDraft.literal (fun j => (ports K j:ℤ))) v) ↔
      ∀ v : Fin 13 → V, ¬InternalZero (GammaShifted88GraphDraft.literal (fun j => (ports K j:ℤ))) v := by
  constructor
  · intro h v hz
    exact h (raiseGamma v) ((zero_iff _ v).mp hz)
  · intro h v hz
    have hp := gamma_positive K v hz
    have he := raise_lower v hp
    apply h (lowerGamma v)
    apply (zero_iff _ (lowerGamma v)).mpr
    simpa only [he] using hz

theorem compact_sameNoZero (K : ℕ) : SameNoZero
    (WShifted87GraphDraft.literal (fun j => (ports K j:ℤ)))
    (GammaShifted88GraphDraft.literal (fun j => (ports K j:ℤ))) := by
  intro V _ _
  exact compact_no_zero_iff (V:=V) K

theorem bridge87 (K : ℕ)
    (h88 : PolynomialBridge (GammaShifted88GraphDraft.literal (fun j => (ports K j:ℤ)))) :
    PolynomialBridge (WShifted87GraphDraft.literal (fun j => (ports K j:ℤ))) :=
  HAExpressionNoZeroEquiv.bridge _ _ (compact_sameNoZero K) h88

theorem native85 (K : ℕ) (heta : EtaUnshift85TransportDraft.ForcedEta K)
    (h88 : PolynomialBridge (GammaShifted88GraphDraft.literal (fun j => (ports K j:ℤ)))) : nativeTheory ⊢
    IPRAExpressionNative.nativeNoZero (EtaNaturalUnitGraphDraft.graph (fun j => (ports K j:ℤ))).output 🡘
      ∼mappedNativeRefutation embedding :=
  W86To87TransportDraft.child85_native K heta (bridge87 K h88)
end DiophantineConsistency.Gamma87To88TransportDraft
#print axioms DiophantineConsistency.Gamma87To88TransportDraft.gamma_positive
#print axioms DiophantineConsistency.Gamma87To88TransportDraft.compact_sameNoZero
#print axioms DiophantineConsistency.Gamma87To88TransportDraft.native85
