import EtaZetaNaturalUnitBridge
import DiophantineConsistency.Compact44.P72Root
import Mathlib.Tactic.Linarith

/-! Source-only proposed J=0 contradiction for the exact generated
eta/zeta-natural prototype. The factor-unit bridge and all providers remain
unelaborated; the ports are casts of an explicit natural tuple. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
noncomputable section
namespace DiophantineConsistency.EtaZetaNaturalJPositiveDraft
open LO LO.FirstOrder LO.FirstOrder.Arithmetic
open scoped LO.FirstOrder.Arithmetic
open AdaptiveEquationSyntax2011 ModelDifferenceRing
open EtaZetaNaturalUnitGraphDraft
variable {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

/-- At J=0 the actual prototype has q=1, X=v6, b=0 and
Z=F-(1-F-alpha)*(X+K0)>0. Natural port p1 supplies K0≥0;
no positive beta, eta, X, or zeta assumption is used. -/
theorem J_positive (p : Fin 4 → ℕ) (v : Fin 13 → V)
    (hz : InternalZero (graph (fun j => (p j:ℤ))).output v) : 0<v 0 := by
  by_contra hn
  have hj : v 0=0 := le_antisymm (le_of_not_gt hn) (Arithmetic.zero_le _)
  let e : Fin 13 → DiffRing V := fun j => ι (v j)
  let pp : Fin 4 → ℤ := fun j => (p j:ℤ)
  have hb : (graph pp).b.evalRing e=0 := by
    simp [graph,Expr.evalRing_mul,Expr.evalRing_var,e,hj]
  have hZ : (graph pp).z.evalRing e=
      ι (v 1+1)-((1:DiffRing V)-ι (v 1+1)-ι (v 2+1))*
        (ι (v 6)+ι (p 1:V)) := by
    simp [graph,Expr.evalRing_add,Expr.evalRing_sub,Expr.evalRing_mul,
      Expr.evalRing_var,Expr.evalRing_constant,Expr.evalRing_ofNat,
      e,pp,P72Root.cast_port,hj,map_add,map_one]
  have hF1 : (1:DiffRing V)≤ι (v 1+1) := by
    have hh : (1:V)≤v 1+1 := by simp
    simpa only [map_one] using (ι_le_ι.mpr hh)
  have hc : (1:DiffRing V)-ι (v 1+1)-ι (v 2+1)≤0 := by
    have ha := ι_nonneg (v 2+1)
    linarith
  have hxk : (0:DiffRing V)≤ι (v 6)+ι (p 1:V) :=
    add_nonneg (ι_nonneg (v 6)) (ι_nonneg (p 1:V))
  have hcp := mul_nonpos_of_nonpos_of_nonneg hc hxk
  have hF : (0:DiffRing V)<ι (v 1+1) := by
    have hh := lt_of_le_of_lt (Arithmetic.zero_le (v 1)) (lt_add_one (v 1))
    simpa only [map_zero] using (ι_lt_ι.mpr hh)
  have hZpos : 0<(graph pp).z.evalRing e := by rw [hZ]; linarith
  have hnorms := EtaZetaNaturalUnitBridgeDraft.signed_norms pp v hz
  obtain ⟨hfirst,_,_,_⟩ := hnorms
  have hsquare : (graph pp).z.evalRing e*(graph pp).z.evalRing e=0 := by
    simpa only [hb,zero_mul] using hfirst
  have hzero : (graph pp).z.evalRing e=0 := mul_self_eq_zero.mp hsquare
  exact (ne_of_gt hZpos) hzero
end DiophantineConsistency.EtaZetaNaturalJPositiveDraft
#print axioms DiophantineConsistency.EtaZetaNaturalJPositiveDraft.J_positive
