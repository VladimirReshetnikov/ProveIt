+def _gates(gates: Sequence[Gate], inputs: int, parameters: int) -> tuple[Gate, ...]:
+    if type(gates) not in (tuple, list):
+        raise ValueError('gates must be a finite list or tuple of Gate descriptors')
+    out = []
+    for index, gate in enumerate(tuple(gates)):
+        available = inputs + index
+        if type(gate) is not Gate or type(gate.output) is not int or gate.output != available:
+            raise ValueError('gate outputs must be consecutive in topological order')
+        left, right = _atom(gate.left, available, parameters), _atom(gate.right, available, parameters)
+        out.append(Gate(gate.operation, left, right, gate.output))
