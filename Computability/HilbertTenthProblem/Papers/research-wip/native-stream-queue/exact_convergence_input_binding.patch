 from math import lcm
 
 
+def natural(value, name, positive=False):
+    if type(value) is not int or value < int(positive):
+        raise ValueError(f'{name} must be an exact {"positive" if positive else "nonnegative"} integer')
+    return value
+
+
+def rational(value, name):
+    if type(value) not in (str, int):
+        raise ValueError(f'{name} must be an exact rational string or integer')
+    return Fraction(value)
+
+
+def metadata(meta):
+    N = natural(meta['states'], 'states', True)
+    b = natural(meta['binary_states'], 'binary states')
+    T = natural(meta['horizon'], 'horizon')
+    if b > N:
+        raise ValueError('Too many binary states')
+    D = natural(meta['probability_denominator'], 'probability denominator', True)
+    step = natural(meta['step_denominator'], 'step denominator', True)
+    anum = natural(meta['discount_numerator'], 'discount numerator', True)
+    den = natural(meta['initial_denominator'], 'initial denominator', True)
+    scale = natural(meta['witness_scale'], 'witness scale', True)
+    if step % D:
+        raise ValueError('Invalid step denominator')
+    discount = Fraction(anum, step // D)
+    if not 0 < discount < 1 or discount.numerator != anum or discount.denominator * D != step:
+        raise ValueError('Discount metadata must be reduced and consistent')
+    reward = rational(meta['common_reward'], 'common reward')
+    mode = meta['terminal_mode']
+    if type(mode) is not str or mode not in ('point', 'pair', 'consensus') or reward < 0:
+        raise ValueError('Invalid reward or terminal mode')
+    target = rational(meta['target'], 'target') if mode == 'point' else None
+    if (target is not None and target < 0) or (mode != 'point' and meta['target'] is not None):
+        raise ValueError('Invalid target')
+    multiplier = lcm(reward.denominator, 1 if target is None else target.denominator)
+    inputs, initial = meta['input_numerators'], meta['initial_numerators']
+    if type(inputs) is not list or type(initial) is not list or len(inputs) != N or len(initial) != N:
+        raise ValueError('Wrong initial-vector dimension')
+    for value in inputs + initial:
+        natural(value, 'initial numerator')
+    if scale != den * multiplier or initial != [multiplier * value for value in inputs]:
+        raise ValueError('Scaled initial vector does not encode the declared input')
+    pair = meta['observed_pair']
+    if type(pair) is not list or len(pair) != 2:
+        raise ValueError('Invalid observed pair')
+    if any(natural(i, 'observed state') >= N for i in pair):
+        raise ValueError('Observed state out of range')
+    endpoints = N if mode == 'point' else N - 1 if mode == 'consensus' else 1
+    expected = dict(witnesses=(N+2*b)*T, squares=(N+b)*T+endpoints,
+                    products=b*T, endpoint_squares=endpoints, degree_at_most=2)
+    for key, value in expected.items():
+        if natural(meta[key], key) != value:
+            raise ValueError(f'Incorrect {key} metadata')
+    return N, b, T, D, discount, reward
+
