+def valid_chain(chain: list[ExpPoly]) -> bool:
+    """Authenticate every E-a step for some positive integer a and terminal zero.
+
+    If f is nonzero, a is recovered from one nonzero coefficient of f and
+    checked against every coefficient. No horizon values or power sampling
+    are used. A zero parent must have a zero child.
+    """
+    if not chain or any(type(f) is not ExpPoly for f in chain) or chain[-1].terms:
+        return False
+    for f, g in zip(chain, chain[1:]):
+        if not f.terms:
+            if g.terms:
+                return False
+            continue
+        if any(b not in f.terms for b in g.terms):
+            return False
+        candidate = None
+        for b, cs in f.terms.items():
+            gs = g.terms.get(b, ())
+            if len(gs) > len(cs):
+                return False
+            for k, c in enumerate(cs):
+                delta = b*sum(comb(h, k)*cs[h] for h in range(k, len(cs)))
+                delta -= gs[k] if k < len(gs) else 0
+                if not c:
+                    if delta:
+                        return False
+                else:
+                    a, remainder = divmod(delta, c)
+                    if remainder or a < 1 or (candidate is not None and a != candidate):
+                        return False
+                    candidate = a
+    return True
+
