  "assessment": {
    "candidate_bottleneck": "For finite bounded integer coefficient words, construct and charge a fixed-arity positive-integer graph for Hadamard/coefficient extraction and representation validity; first-order definability and set-sized evaluation tables do not provide these gates.",
    "new_scope_obstructions": [
      {
        "id": "ordinary_integer_square_ratio",
        "kind": "elementary exact counterexample to an unclaimed domain transfer",
        "statement": "The omnific order formula with nonzero p,q and (b-a)q^2=p^2 does not express positive order after restricting witnesses to ordinary integers: b-a=2 has no solution."
      },
      {
        "id": "decoder_zero_test",
        "kind": "independent exact computability obstruction, conditional on that evaluator interface",
        "statement": "On uniformly computable presentations, the total real decoder sends the append-until-halt/prepend-afterward order to omega when the machine never halts and to zero otherwise; a total effective decoder with decidable zero would decide halting."
      }
    ],
