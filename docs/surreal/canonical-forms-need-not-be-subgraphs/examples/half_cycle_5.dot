digraph form {
  rankdir=TB;
  node [shape=box];
  n0 [label="0: 0 (h=0)"];
  n1 [label="1: 1 (h=1)"];
  n1 -> n0 [label="L"];
  n2 [label="2: 0 (h=2)"];
  n2 -> n1 [label="R", style=dashed];
  n3 [label="3: 1 (h=3)"];
  n3 -> n2 [label="L"];
  n4 [label="4: 1/2 (h=4)"];
  n4 -> n0 [label="L"];
  n4 -> n3 [label="R", style=dashed];
}
