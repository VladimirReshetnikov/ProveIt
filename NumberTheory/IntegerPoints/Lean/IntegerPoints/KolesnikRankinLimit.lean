import IntegerPoints.Kolesnik

/-!
# Rankin's interval implies Kolesnik's zeta-method limit

This module proves the elementary logical passage from the interval for
Rankin's exponent-pair constant quoted by Kolesnik to the resulting lower
limit on zeta exponents obtainable by the one-dimensional van der Corput
method.  Rankin's deep interval theorem remains an explicit hypothesis.

The order-theoretic step uses an independently proved lower bound for the set
of sums `κ + λ`: every pair generated from `(0, 1)` by the A- and B-processes
satisfies `0 ≤ κ` and `1/2 ≤ λ`.
-/

namespace LeanProofs.IntegerPoints

/-- The elementary coordinate bounds preserved by both one-dimensional van
der Corput processes. -/
theorem IsVdCExponentPair.nonneg_and_half_le {k l : ℝ}
    (h : IsVdCExponentPair k l) : 0 ≤ k ∧ 1 / 2 ≤ l := by
  induction h with
  | trivial =>
      norm_num
  | @procA k l _h ih =>
      have hden : 0 < 2 * k + 2 := by linarith [ih.1]
      have hl : 0 ≤ l := by linarith [ih.2]
      constructor
      · exact div_nonneg ih.1 hden.le
      · have hquot : 0 ≤ l / (2 * k + 2) := div_nonneg hl hden.le
        linarith
  | @procB k l _h ih =>
      constructor
      · linarith [ih.2]
      · linarith [ih.1]

/-- The set of sums `κ + λ` of exponent pairs generated by the classical
one-dimensional A- and B-processes. -/
def vdCExponentPairSums : Set ℝ :=
  {s | ∃ k l : ℝ, IsVdCExponentPair k l ∧ s = k + l}

/-- The sums of van der Corput exponent pairs are bounded below by `1/2`.
This supplies the genuine boundedness hypothesis needed to compare a member
of the set with its infimum. -/
theorem vdCExponentPairSums_bddBelow : BddBelow vdCExponentPairSums := by
  refine ⟨1 / 2, ?_⟩
  intro s hs
  change ∃ k l : ℝ, IsVdCExponentPair k l ∧ s = k + l at hs
  rcases hs with ⟨k, l, hpair, rfl⟩
  have hbounds := hpair.nonneg_and_half_le
  linarith [hbounds.1, hbounds.2]

/-- The lower endpoint in Rankin's quoted interval bounds the sum of every
generated exponent pair.  This theorem assumes, but does not assert, Rankin's
deep interval result. -/
theorem rankin_sum_lower_bound_of_rankinConstant
    (hRankin : kolesnik_rankinConstant) {k l : ℝ} (hpair : IsVdCExponentPair k l) :
    (0.829021356 : ℝ) ≤ k + l := by
  change
    (0.829021356 : ℝ) ≤ sInf vdCExponentPairSums ∧
      sInf vdCExponentPairSums < (0.829021357 : ℝ) at hRankin
  have hmem : k + l ∈ vdCExponentPairSums := ⟨k, l, hpair, rfl⟩
  have hinf_le : sInf vdCExponentPairSums ≤ k + l :=
    csInf_le vdCExponentPairSums_bddBelow hmem
  exact hRankin.1.trans hinf_le

/-- Rankin's quoted interval implies Kolesnik's lower limit for zeta exponents
obtainable from the one-dimensional exponent-pair method. -/
theorem kolesnik_rankinConstant_implies_rankinZetaLimit :
    kolesnik_rankinConstant → kolesnik_rankinZetaLimit := by
  intro hRankin
  unfold kolesnik_rankinZetaLimit
  intro k l hpair
  have hsum : (0.829021356 : ℝ) ≤ k + l :=
    rankin_sum_lower_bound_of_rankinConstant hRankin hpair
  linarith

end LeanProofs.IntegerPoints
