      "repository_path": "Combinatorics/Ramsey/Lean/GowersSzemeredi/Sections17_18.lean",
      "source_sha256": "74027961cd05b94022c2e298ae96bc5ddd5b17425143725c2ba2fbc24c68922f",
      "start_line": 184,
      "text": "def szemerediThreshold (delta : Real) (k : Nat) : Real :=\n  (2 : Real) ^\n    ((2 : Real) ^\n      (delta⁻¹ ^ ((2 : Real) ^ ((2 : Real) ^ (k + 9 : Nat)))))\n",
      "url": "https://github.com/VladimirReshetnikov/ProveIt/blob/af74fb522c24a6331886b11db76942642a6a0e42/Combinatorics/Ramsey/Lean/GowersSzemeredi/Sections17_18.lean#L184-L187"
    },
    {
      "end_line": 194,
      "excerpt_sha256": "cabe218e0cd9a0b5f7103bc0c9027ac8797b6128c36f419dad22def8764ffc1f",
      "name": "theorem_18_2",
      "repository_path": "Combinatorics/Ramsey/Lean/GowersSzemeredi/Sections17_18.lean",
      "source_sha256": "74027961cd05b94022c2e298ae96bc5ddd5b17425143725c2ba2fbc24c68922f",
      "start_line": 190,
      "text": "def theorem_18_2 : Prop :=\n  ∀ (delta : Real) (k N : Nat), 0 < delta → delta ≤ 1 / 2 → 0 < k →\n    szemerediThreshold delta k ≤ N →\n    ∀ A : Finset Nat, A ⊆ Finset.Icc 1 N → delta * N ≤ A.card →\n      HasNatAP A k\n",
      "url": "https://github.com/VladimirReshetnikov/ProveIt/blob/af74fb522c24a6331886b11db76942642a6a0e42/Combinatorics/Ramsey/Lean/GowersSzemeredi/Sections17_18.lean#L190-L194"
    },
    {
      "end_line": 106,
      "excerpt_sha256": "65b4eef82340dfe4f499b01935032cba175f6321fa3b0875c854816f691f5333",
      "name": "HasNatAP",
      "repository_path": "Combinatorics/Ramsey/Lean/GowersSzemeredi/Definitions.lean",
      "source_sha256": "17241a9ffa53e2c6b335eb326920952a7f3da25e5e5a601a7aca5606462f5e4b",
      "start_line": 105,
      "text": "def HasNatAP (A : Finset Nat) (k : Nat) : Prop :=\n  exists a d : Nat, 0 < d /\\ ∀ i, i < k → a + i * d ∈ A\n",
      "url": "https://github.com/VladimirReshetnikov/ProveIt/blob/af74fb522c24a6331886b11db76942642a6a0e42/Combinatorics/Ramsey/Lean/GowersSzemeredi/Definitions.lean#L105-L106"
    }
