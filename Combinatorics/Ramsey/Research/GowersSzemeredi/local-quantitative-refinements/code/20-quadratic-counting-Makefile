.PHONY: all pdf verify verify-gauss clean
all: pdf verify
pdf:
	pdflatex -interaction=nonstopmode -halt-on-error article.tex
	pdflatex -interaction=nonstopmode -halt-on-error article.tex
	pdflatex -interaction=nonstopmode -halt-on-error article.tex
verify:
	python3 -S verify.py --output exact_verification_report.json
verify-gauss:
	python3 verify.py --gauss --output verification_report.json
clean:
	rm -f article.aux article.log article.out article.toc
