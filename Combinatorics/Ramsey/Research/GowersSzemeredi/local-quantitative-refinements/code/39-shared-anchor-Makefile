PYTHON ?= python3
PDFLATEX ?= pdflatex

.PHONY: all pdf verify constants clean
all: verify pdf

pdf:
	$(PDFLATEX) -interaction=nonstopmode -halt-on-error article.tex
	$(PDFLATEX) -interaction=nonstopmode -halt-on-error article.tex

verify:
	$(PYTHON) code/verify.py
	$(PYTHON) code/verify_balanced.py

constants:
	$(PYTHON) code/poisson_constants.py

clean:
	rm -f article.aux article.log article.out article.toc article.fls article.fdb_latexmk
	rm -rf code/__pycache__
