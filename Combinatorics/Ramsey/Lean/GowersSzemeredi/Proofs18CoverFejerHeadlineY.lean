import GowersSzemeredi.Proofs18CoverFejerHeadlineZ

/-! **Every threshold one lower: the polynomial partition constant charged at
`2^(k+9)`** (Notes L.16p).

The step lemma charges `32·polynomialPartitionConstant (k+2) ≤ 2^(4(k+3)²+5)`
at `X^(2^(4(k+3)²+4))`, through `4(k+3)²+5 ≤ 2^(4(k+3)²+4)`. That costs
`4(k+3)²` per step in the doubly logarithmic scale. Since
`4(k+3)² + 5 ≤ 2^(k+9)` (`four_sq_add_five_le`), `X^(2^(k+9))` suffices, and
a step then costs `k + 19` there instead of `4(k+3)² + 14`. This module
contains the envelope of `Proofs18CoverFejerHeadlineZ` with that charge
(generated by `assemble_y.py`), with closed forms from `k = 15` and
kernel-evaluated envelopes from `k = 5`. It gives Theorem 18.1 at `d + 2` from `d = 15`, `d + 3` from `d = 10` and
`d + 4` from `d = 7`. The Theorem 18.2 envelope does not gain: its inverse-step
threshold raises the refinement constant to the power `polynomialPartitionConstant`
(`inv_thr_le_ex`), so there `4(k+3)²` is a genuine cost. -/
set_option autoImplicit false
noncomputable section
open scoped BigOperators
namespace LeanProofs.GowersSzemeredi

/-- The partition constant fits `2^(2^(k+9))`: `4(k+3)² + 5 ≤ 2^(k+9)`. -/
theorem four_sq_add_five_le (k : Nat) : 4 * (k + 3) ^ 2 + 5 ≤ 2 ^ (k + 9) := by
  rcases Nat.lt_or_ge k 4 with h | h
  · interval_cases k <;> norm_num
  · have h1 := sq_le_two_pow_four k h
    have h2 : (k + 3) ^ 2 ≤ (k + 4) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have h9 : 2 ^ (k + 9) = 512 * 2 ^ k := by rw [pow_add]; ring
    have h3 : 1 ≤ 2 ^ k := Nat.one_le_two_pow
    omega

/-- The envelope after one step (no threshold). -/
def envStepY (k μ0 μK μ : Nat) : Nat :=
  max (GenParamsZ.densDegZ k μ0 + μ + k + 19) (GenParamsZ.expDegZ k μ0 μK + 6)

/-- **The single-piece step with polynomial envelopes.** -/
theorem polyEnvBound_stepY (P : GenParamsZ) {μV μK μ : Nat} (H : P.CHyp μV μK) (hk : 1 ≤ P.k)
    (hcov : ∀ l, 1 ≤ l → l ≤ P.k → PolyCoverAt l (uCount P.V (uDegZ l)) (uExp P.V (uDegZ l)))
    (hrec : Section16RecurrenceProfileWith P.k (familyRecThr P.k P.K P.p) (familyRecExp P.k P.p))
    (hlow : PolyEnvBound (P.k + 1) μ) : PolyEnvBound (P.k + 2) (envStepY P.k P.μ0 μK μ) := by
  intro alpha ha ha2
  have hX := two_div_ge_two ha ha2
  -- the input parameter, the lower-degree bound, the step and `Eloc`
  obtain ⟨he0, he8, hei, hy0, hyle, hyi⟩ := P.yIn_boundsZ ha ha2 H.hV H.hVμ H.hμ0
  have hy2 : P.yIn alpha ≤ 1 / 2 := hyle.trans ha2
  obtain ⟨β, σ, T, hB, b0, b1, s0, s16, bi, si⟩ := hlow _ hy0 hy2
  have hstep := P.inverse_step H.hV H.hK H.hp hk hcov hrec ha ha2 hB b0 s0 s16
  obtain ⟨hEl0, hEli⟩ := P.Eloc_inv_leZ H ha ha2
  obtain ⟨-, hEl2, -⟩ := P.Eloc_pos_le H.hV H.hp ha ha2
  set k := P.k with hkdef
  set E := GenParamsZ.expDegZ k P.μ0 μK with hEdef
  set dd := GenParamsZ.densDegZ k P.μ0 with hdddef
  set M1 := dd + 1 + μ with hM1def
  obtain ⟨-, hYμ⟩ := input_scale_le (μ := μ) ha ha2 hy0 hyi
  have bi' : β⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) := bi.trans hYμ
  have si' : σ⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) := si.trans hYμ
  have hei' : (P.eta alpha)⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) :=
    pw_mono hX hei (by rw [hM1def, hdddef]; unfold GenParamsZ.densDegZ; omega)
  have heta1 : P.eta alpha ≤ 1 := by linarith
  obtain ⟨σ0', σ16', σeq⟩ := sigma_step (d := k + 1) hEl0 hEl2 s0 s16
  have h32P : 32 * (polynomialPartitionConstant (k + 1 + 1) : Real) ≤
      (2 / alpha) ^ (2 ^ (k + 9)) := by
    refine pw_const hX ?_
    have hP := polyPartConst_le (k + 1 + 1)
    rw [show k + 1 + 1 + 1 = k + 3 by ring] at hP
    have hn : 4 * (k + 3) ^ 2 + 5 ≤ 2 ^ (k + 9) := four_sq_add_five_le k
    have hnat : 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ (2 ^ (k + 9)) := by
      calc 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ 5 * 2 ^ (4 * (k + 3) ^ 2) :=
            Nat.mul_le_mul (by norm_num) hP
        _ = 2 ^ (4 * (k + 3) ^ 2 + 5) := by rw [← pow_add]; ring_nf
        _ ≤ 2 ^ (2 ^ (k + 9)) := Nat.pow_le_pow_right (by norm_num) hn
    exact_mod_cast hnat
  set S := max (max (k + 9) (E + 3) + 1) M1 + 1 with hSdef
  have hσ' : (inverseStepExponent (k + 1) (P.Eloc alpha) σ)⁻¹ ≤ (2 / alpha) ^ (2 ^ S) := by
    rw [σeq]
    have hx0 : 0 ≤ 32 * (polynomialPartitionConstant (k + 1 + 1) : Real) * (P.Eloc alpha)⁻¹ :=
      mul_nonneg (mul_nonneg (by norm_num) (Nat.cast_nonneg _)) (inv_pos.mpr hEl0).le
    have h1 := pw_mul' hX (mul_nonneg (by norm_num) (Nat.cast_nonneg _)) (inv_pos.mpr hEl0).le
      h32P hEli
    exact pw_mul' hX hx0 (inv_pos.mpr s0).le h1 si'
  -- assemble
  refine ⟨P.eta alpha * β / 4, _, _, hstep, div_pos (mul_pos he0 b0) (by norm_num), ?_, σ0', σ16',
    ?_, pw_mono hX hσ' ?_⟩
  · have : P.eta alpha * β ≤ 1 := mul_le_one₀ heta1 b0.le b1
    linarith
  · rw [show (P.eta alpha * β / 4)⁻¹ = 4 * ((P.eta alpha)⁻¹ * β⁻¹) by field_simp]
    have h1 := pw_mul hX (inv_pos.mpr he0).le (inv_pos.mpr b0).le hei' bi'
    have h4 : (4 : Real) ≤ (2 / alpha) ^ (2 ^ (M1 + 1)) :=
      (four_le_pw_one hX).trans (pw_mono hX le_rfl (by omega))
    refine (pw_mul hX (by norm_num) (mul_nonneg (inv_pos.mpr he0).le (inv_pos.mpr b0).le) h4 h1).trans
      (pw_mono hX le_rfl ?_)
    unfold envStepY; rw [← hdddef]; omega
  · unfold envStepY; rw [← hdddef, ← hEdef]; omega


/-- The Theorem 18.1 envelope at the tight base budget. -/
def polyGenMuY : Nat → Nat
  | 0 => 74
  | 1 => 74
  | k + 2 => envStepY (k + 2) (tightMu0Z (k + 2)) (genMuKZ (k + 2)) (polyGenMuY (k + 1))

theorem polyGenMuY_succ {k : Nat} (hk : 1 ≤ k) :
    polyGenMuY (k + 1) = envStepY (k + 1) (tightMu0Z (k + 1)) (genMuKZ (k + 1)) (polyGenMuY k) := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  rfl


theorem polyEnvBound_allY (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k) (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16)))
    {Kφ : Real} {pφ : Nat} (hpp : ProgressionPhasePartition Kφ pφ) (hpφ : 0 < pφ)
    (hKφ : Kφ ≤ 2 ^ pφ) (hpφB : (pφ : Real) ≤ (2 : Real) ^ ((2 : Nat) ^ 64)) :
    ∀ k, 2 ≤ k → PolyEnvBound (k + 2) (polyGenMuY k) := by
  have hlem : ∀ k, 1 ≤ k → AbstractFamilyLemma166At k
      (section16PowerWidth (familyWidthPrefactor (Kc k)) (familyWidthDivisor k (pc k))) :=
    fun k hk => abstractFamilyLemma166At_of k (hK k) (hp k) (hrec k hk)
  have hK1 : ∀ k, 1 ≤ Kc k := fun k => le_trans (by norm_num) (hK k)
  have hstep : ∀ k, 2 ≤ k → ∀ μ, PolyEnvBound (k + 1) μ →
      PolyEnvBound (k + 2) (envStepY k (tightMu0Z k) (genMuKZ k) μ) := by
    intro k hk μ hlow
    let P : GenParamsZ := ⟨classV Kc pc k, k, Kc k, pc k, tightMu0Z k⟩
    have H : P.CHyp (tightMuW k) (genMuKZ k) := tightHyp_of_profiles_fejerZ Kc pc hK hp hconst hk
    have hcov : ∀ l, 1 ≤ l → l ≤ P.k →
        PolyCoverAt l (uCount P.V (uDegZ l)) (uExp P.V (uDegZ l)) := by
      intro l hl1 hlk
      have hcl := polyCoverAt_classZ Kc pc hK1 hp hlem hl1
      exact hcl.uniform_mono (one_le_classV Kc pc l) (classV_mono Kc pc hlk) le_rfl
    exact polyEnvBound_stepY P H (by show 1 ≤ k; omega) hcov (hrec k (by omega)) hlow
  intro k hk
  induction k, hk using Nat.le_induction with
  | base =>
    exact hstep 2 le_rfl 74 (polyEnvBound_three_of_phase_partition hpp hpφ hKφ hpφB)
  | succ k hk ih =>
    rw [polyGenMuY_succ (by omega)]
    exact hstep (k + 1) (by omega) (polyGenMuY k) ih


/-! ### Closed forms -/

theorem envStepY_le_tight {k : Nat} (hk : 15 ≤ k) (μ : Nat) :
    envStepY k (tightMu0Z k) (genMuKZ k) μ ≤
      μ + 15 * 2 ^ (k - 1) + 9 * (k + 4) ^ 2 + 7 * k + 64 := by
  unfold envStepY GenParamsZ.densDegZ GenParamsZ.expDegZ GenParamsZ.rhoDegZ tightMu0Z tightMuW
    genMuKZ pDeg
  rw [tDegZ_eq_of_ge hk]
  have := Nat.lt_two_pow_self (n := k - 1)
  generalize (k + 4) ^ 2 = s
  generalize 2 ^ (k - 1) = y at *
  omega

theorem polyGenMuY_fifteen : polyGenMuY 15 + 4 * 15 + 128 ≤ 16 * 2 ^ 15 := by decide +kernel

theorem polyGenMuY_le16 : ∀ k, 15 ≤ k → polyGenMuY k + 4 * k + 128 ≤ 16 * 2 ^ k := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => exact polyGenMuY_fifteen
  | succ k hk ih =>
    rw [polyGenMuY_succ (by omega)]
    have h1 := envStepY_le_tight (k := k + 1) (by omega) (polyGenMuY k)
    have h2 := thirtytwo_sq_le_two_pow_fourteen k (by omega)
    have h4 : 7 * k + 80 ≤ (k + 5) ^ 2 := by nlinarith
    rw [show k + 1 + 4 = k + 5 by ring, show k + 1 - 1 = k by omega] at h1
    rw [pow_succ]
    generalize (k + 5) ^ 2 = s5 at *
    generalize 2 ^ k = x at *
    omega

/-! The envelopes in dimensions `5, …, 14`, kernel-evaluated. -/

theorem polyGenMuY_small16 {k : Nat} (h1 : 13 ≤ k) (h2 : k ≤ 14) :
    polyGenMuY k + 1 ≤ 16 * 2 ^ k := by
  interval_cases k <;> decide +kernel

theorem polyGenMuY_fit16 {k : Nat} (hk : 13 ≤ k) : polyGenMuY k + 1 ≤ 16 * 2 ^ k := by
  rcases Nat.lt_or_ge k 15 with h | h
  · exact polyGenMuY_small16 hk (by omega)
  · have := polyGenMuY_le16 k h
    have h16 : 16 * 2 ^ k ≤ 16 * 2 ^ k := Nat.mul_le_mul_right _ (by norm_num)
    omega

theorem polyGenMuY_small32 {k : Nat} (h1 : 8 ≤ k) (h2 : k ≤ 14) :
    polyGenMuY k + 1 ≤ 32 * 2 ^ k := by
  interval_cases k <;> decide +kernel

theorem polyGenMuY_fit32 {k : Nat} (hk : 8 ≤ k) : polyGenMuY k + 1 ≤ 32 * 2 ^ k := by
  rcases Nat.lt_or_ge k 15 with h | h
  · exact polyGenMuY_small32 hk (by omega)
  · have := polyGenMuY_le16 k h
    have h16 : 16 * 2 ^ k ≤ 32 * 2 ^ k := Nat.mul_le_mul_right _ (by norm_num)
    omega

theorem polyGenMuY_small64 {k : Nat} (h1 : 5 ≤ k) (h2 : k ≤ 14) :
    polyGenMuY k + 1 ≤ 64 * 2 ^ k := by
  interval_cases k <;> decide +kernel

theorem polyGenMuY_fit64 {k : Nat} (hk : 5 ≤ k) : polyGenMuY k + 1 ≤ 64 * 2 ^ k := by
  rcases Nat.lt_or_ge k 15 with h | h
  · exact polyGenMuY_small64 hk (by omega)
  · have := polyGenMuY_le16 k h
    have h16 : 16 * 2 ^ k ≤ 64 * 2 ^ k := Nat.mul_le_mul_right _ (by norm_num)
    omega

/-! ### The headline statements -/

/-- **Theorem 18.1 at every degree `d ≥ 15` with `d + 2`**, from the profiles
with polynomial family constants. -/
theorem theorem_18_1_d2_fifteen_le_of_profiles_poly (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k)
    (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16)))
    {Kφ : Real} {pφ : Nat} (hpp : ProgressionPhasePartition Kφ pφ) (hpφ : 0 < pφ)
    (hKφ : Kφ ≤ 2 ^ pφ) (hpφB : (pφ : Real) ≤ (2 : Real) ^ ((2 : Nat) ^ 64))
    {d : Nat} (hd : 15 ≤ d) : Theorem181AtSharp 2 d := by
  have henv := polyEnvBound_allY Kc pc hK hp hrec hconst hpp hpφ hKφ hpφB (d - 2) (by omega)
  rw [show d - 2 + 2 = d by omega] at henv
  refine theorem181AtSharp_of_polyEnvBound henv ?_
  have hle := polyGenMuY_fit16 (k := d - 2) (by omega)
  have h2 : 2 ^ (d + 2) = 16 * 2 ^ (d - 2) := by
    rw [show d + 2 = (d - 2) + 4 by omega, pow_add]; ring
  rw [h2]
  exact hle

/-- **Theorem 18.1 at every degree `d ≥ 10` with `d + 3`**, from the profiles
with polynomial family constants. -/
theorem theorem_18_1_d3_ten_le_of_profiles_poly (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k)
    (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16)))
    {Kφ : Real} {pφ : Nat} (hpp : ProgressionPhasePartition Kφ pφ) (hpφ : 0 < pφ)
    (hKφ : Kφ ≤ 2 ^ pφ) (hpφB : (pφ : Real) ≤ (2 : Real) ^ ((2 : Nat) ^ 64))
    {d : Nat} (hd : 10 ≤ d) : Theorem181AtSharp 3 d := by
  have henv := polyEnvBound_allY Kc pc hK hp hrec hconst hpp hpφ hKφ hpφB (d - 2) (by omega)
  rw [show d - 2 + 2 = d by omega] at henv
  refine theorem181AtSharp_of_polyEnvBound henv ?_
  have hle := polyGenMuY_fit32 (k := d - 2) (by omega)
  have h2 : 2 ^ (d + 3) = 32 * 2 ^ (d - 2) := by
    rw [show d + 3 = (d - 2) + 5 by omega, pow_add]; ring
  rw [h2]
  exact hle

/-- **Theorem 18.1 at every degree `d ≥ 7` with `d + 4`**, from the profiles
with polynomial family constants. -/
theorem theorem_18_1_d4_seven_le_of_profiles_poly (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k)
    (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16)))
    {Kφ : Real} {pφ : Nat} (hpp : ProgressionPhasePartition Kφ pφ) (hpφ : 0 < pφ)
    (hKφ : Kφ ≤ 2 ^ pφ) (hpφB : (pφ : Real) ≤ (2 : Real) ^ ((2 : Nat) ^ 64))
    {d : Nat} (hd : 7 ≤ d) : Theorem181AtSharp 4 d := by
  have henv := polyEnvBound_allY Kc pc hK hp hrec hconst hpp hpφ hKφ hpφB (d - 2) (by omega)
  rw [show d - 2 + 2 = d by omega] at henv
  refine theorem181AtSharp_of_polyEnvBound henv ?_
  have hle := polyGenMuY_fit64 (k := d - 2) (by omega)
  have h2 : 2 ^ (d + 4) = 64 * 2 ^ (d - 2) := by
    rw [show d + 4 = (d - 2) + 6 by omega, pow_add]; ring
  rw [h2]
  exact hle


end LeanProofs.GowersSzemeredi
