import GowersSzemeredi.Proofs18LengthSixScale
import GowersSzemeredi.Proofs18SinglePieceCoverInverse
import GowersSzemeredi.Proofs18TightClasses

/-! The scale conditions of the single-piece step with the joint-cover
remainder (Notes L.12).

`GenParamsG.modulus_conditions` with the graded nest replaced by the joint
cover of the vertex faces: the remainder density is `coverRho1` and the
remainder width is `⌈N^coverExp⌉`, both at the face degrees `uDeg68 l`.
* `coverExp_pos_le` and `coverRemWidth_powerLB`: the remainder width is a
  power of `N` with no threshold.
* `GenParamsC`: the data `(V, k, K, p, μ₀)`. `ranges`, `Eloc_pos_le` and
  `modulus_conditions` are the graded proofs, generated by
  `mk_cover_modulus.py`. -/
set_option autoImplicit false
noncomputable section
namespace LeanProofs.GowersSzemeredi

/-! ### The cover remainder width -/

theorem coverExp_pos_le (Eb : Nat → Real → Real → Real → Real)
    (hEb : ∀ l g t s, 0 < Eb l g t s ∧ Eb l g t s ≤ 1) (theta gamma : Real) (k : Nat) :
    0 < coverExp Eb theta gamma k ∧ coverExp Eb theta gamma k ≤ 1 := by
  unfold coverExp
  have hf : ∀ e : Fin k → Bool,
      0 < Eb (section16VertexDirections e).card gamma (globalBudget theta gamma k)
          (coverPrec theta gamma k) / 16 ^ (k + 1 - (section16VertexDirections e).card) ∧
        Eb (section16VertexDirections e).card gamma (globalBudget theta gamma k)
          (coverPrec theta gamma k) / 16 ^ (k + 1 - (section16VertexDirections e).card) ≤ 1 := by
    intro e
    obtain ⟨h0, h1⟩ := hEb (section16VertexDirections e).card gamma (globalBudget theta gamma k)
      (coverPrec theta gamma k)
    have h16 : (1 : Real) ≤ 16 ^ (k + 1 - (section16VertexDirections e).card) :=
      one_le_pow₀ (by norm_num)
    refine ⟨by positivity, ?_⟩
    rw [div_le_one (by positivity)]
    linarith
  refine ⟨Finset.prod_pos fun e _ => (hf e).1, ?_⟩
  calc _ ≤ ∏ _e ∈ Finset.univ.filter (fun e : Fin k → Bool => e ≠ fun _ => true), (1 : Real) :=
        Finset.prod_le_prod (fun e _ => (hf e).1.le) fun e _ => (hf e).2
    _ = 1 := by simp

/-- The remainder width is `N^coverExp`, with no threshold. -/
theorem coverRemWidth_powerLB (Eb : Nat → Real → Real → Real → Real) (theta gamma : Real)
    (k : Nat) :
    WidthPowerLB (fun L => coverRemWidth Eb theta gamma k L) (coverExp Eb theta gamma k) 1 :=
  fun _ _ => Nat.le_ceil _

/-! ### The parameters -/

/-- The data of the single-piece step with the joint-cover remainder in dimension `k`. -/
structure GenParamsC where
  /-- The base of the cover controls. -/
  V : Real
  /-- The dimension of the step. -/
  k : Nat
  /-- The recurrence threshold constant in dimension `k`. -/
  K : Nat
  /-- The recurrence exponent constant in dimension `k`. -/
  p : Nat
  /-- The fixed-parameter exponent. -/
  μ0 : Nat

namespace GenParamsC

variable (P : GenParamsC) (alpha : Real)

/-- The budget `globalBudget α (α/2) k`. -/
def B : Real := globalBudget alpha (alpha / 2) P.k
/-- The width exponent of the base cover in face dimension `l`. -/
def Ewg (l : Nat) : Real → Real := uExp P.V (uDeg68 l) (alpha / 2) (P.B alpha)
/-- `θ₂/2`. -/
def T2 : Real := globalTheta2 alpha (alpha / 2) P.k
/-- The joint-cover remainder density `ρ₁`. -/
def Rho1 : Real := coverRho1 (fun l => uCount P.V (uDeg68 l)) alpha (alpha / 2) P.k
/-- `δ(θ₁)`. -/
def Delta : Real := section16Delta (section16ThetaOne alpha (alpha / 2) P.k)
/-- The exponent of the spectrum-scale cover. -/
def Em : Real := uExp P.V (uDeg68 P.k) (P.Delta alpha) (P.B alpha) (P.Rho1 alpha / 2 / 2)
/-- The exponent of the remainder width. -/
def NestExp : Real := coverExp (fun l => uExp P.V (uDeg68 l)) alpha (alpha / 2) P.k
/-- The exponent of `m` in `N`. -/
def MExp : Real := P.NestExp alpha * (P.Em alpha / 2)
/-- The threshold for `m ≥ N^MExp`. -/
def MThr : Real := max ((1 : Real)) (64 ^ (1 / P.NestExp alpha))
/-- The worst spectrum count. -/
def QM : Nat :=
  ⌊singlePieceGlobalQmaxC (fun l => uCount P.V (uDeg68 l)) alpha (alpha / 2)
    P.k⌋₊
/-- The exponent of `m` in the spectrum cell width. -/
def Bexp : Real := familyRecExp P.k P.p (P.QM alpha) / 2
/-- The Bohr radius. -/
def Zeta : Real := section16Zeta alpha (alpha / 2) P.k
/-- The spectrum density. -/
def Rho : Real := spectrumPieceRho (fun t => t / 2) (P.Rho1 alpha)
/-- The slice density. -/
def ThS : Real := singlePieceTheta (P.Rho alpha) 1
/-- The slice control. -/
def CS : Real :=
  singlePieceGlobalC (fun l => uCount P.V (uDeg68 l)) alpha (alpha / 2) P.k (P.ThS alpha)
/-- The first slice exponent. -/
def Eth : Real := uExp P.V (uDeg68 P.k) (alpha / 2) (P.B alpha) (P.ThS alpha / 2)
/-- The second slice exponent. -/
def Ec : Real := uExp P.V (uDeg68 P.k) (alpha / 2) (P.B alpha) (P.CS alpha / 2)
/-- The exponent of the final width in `N`. -/
def F : Real := P.MExp alpha * (P.Bexp alpha * (P.Eth alpha * P.Ec alpha) / 2)
/-- The localization exponent. -/
def Eloc : Real := P.F alpha / 8
/-- How large `m` must be. -/
def MReq : Real :=
  max (familyRecThr P.k P.K P.p (P.QM alpha) : Real)
    (max ((8 / P.Zeta alpha) ^ (1 / P.Bexp alpha))
      (max ((4 / (P.Zeta alpha * P.Rho alpha ^ 3)) ^ (1 / P.Bexp alpha))
        ((16 / P.Zeta alpha) ^ (2 / P.Bexp alpha))))
/-- **The modulus threshold of the step.** -/
def Tloc : Real :=
  max (max 3 (lemma156ExplicitThreshold P.k (alpha / 2) (alpha / 2)))
    (max (P.MThr alpha)
      (max (P.MReq alpha ^ (1 / P.MExp alpha)) (6 ^ (1 / P.Eloc alpha))))

/-! ### Ranges -/

/-- The ranges of the parameters, for `0 < α ≤ 1/2`, `V ≥ 1`, `p > 0`. -/
theorem ranges (hV : 1 ≤ P.V) (hp : 0 < P.p) {alpha : Real} (ha : 0 < alpha)
    (haHalf : alpha ≤ 1 / 2) :
    (0 < P.B alpha ∧ P.B alpha ≤ 1) ∧ (0 < P.Delta alpha ∧ P.Delta alpha ≤ 1) ∧
    (0 < P.T2 alpha ∧ P.T2 alpha ≤ 1) ∧ (0 < P.Rho1 alpha ∧ P.Rho1 alpha ≤ 1) ∧
    (0 < P.Rho alpha ∧ P.Rho alpha ≤ 1) ∧ (0 < P.ThS alpha ∧ P.ThS alpha ≤ 1) ∧
    (0 < P.CS alpha ∧ P.CS alpha ≤ 1) ∧ (0 < P.Em alpha ∧ P.Em alpha ≤ 1) ∧
    (0 < P.Eth alpha ∧ P.Eth alpha ≤ 1) ∧ (0 < P.Ec alpha ∧ P.Ec alpha ≤ 1) ∧
    (0 < P.NestExp alpha ∧ P.NestExp alpha ≤ 1 ∧ 1 ≤ (1 : Real)) ∧
    (0 < P.Bexp alpha ∧ P.Bexp alpha ≤ 1) ∧ (0 < P.Zeta alpha) ∧
    (∀ l s, 0 < s → s ≤ 1 → 0 < P.Ewg alpha l s ∧ P.Ewg alpha l s ≤ 1) := by
  have ha1 : alpha ≤ 1 := by linarith
  have hg : 0 < alpha / 2 := half_pos ha
  have hg1 : alpha / 2 ≤ 1 := by linarith
  obtain ⟨hθ₂, hθ₂1⟩ := section16ThetaTwo_pos_le (gamma := alpha / 2) P.k ha ha1 hg hg1
  have hB : 0 < P.B alpha ∧ P.B alpha ≤ 1 := by
    unfold B globalBudget
    have hden : (1 : Real) ≤ 2 * (2 ^ P.k + 1) := by
      have : (1 : Real) ≤ 2 ^ P.k := one_le_pow₀ (by norm_num)
      linarith
    refine ⟨by positivity, ?_⟩
    rw [div_le_one (by positivity)]
    linarith
  obtain ⟨-, -, hd0, hd1⟩ := section16_theta_delta_bounds P.k ha ha1 hg hg1
  have hT2 : 0 < P.T2 alpha ∧ P.T2 alpha ≤ 1 := by
    unfold T2 globalTheta2; exact ⟨by positivity, by linarith⟩
  have hEw : ∀ l s, 0 < s → s ≤ 1 → 0 < P.Ewg alpha l s ∧ P.Ewg alpha l s ≤ 1 :=
    fun l s _ _ => uExp_pos_le P.V (uDeg68 l) (alpha / 2) (P.B alpha) s
  have hR1 : 0 < P.Rho1 alpha ∧ P.Rho1 alpha ≤ 1 :=
    coverRho1_pos_le _ (fun l g t s _ _ => one_le_uCount P.V (uDeg68 l) g t s) alpha (alpha / 2)
      P.k ha ha1 hg hg1
  have hR : 0 < P.Rho alpha ∧ P.Rho alpha ≤ 1 := by
    unfold Rho spectrumPieceRho
    exact ⟨by have := hR1.1; positivity,
      mul_le_one₀ (by linarith [hR1.2]) (by linarith [hR1.1]) (by linarith [hR1.2])⟩
  have hS : 0 < P.ThS alpha ∧ P.ThS alpha ≤ 1 :=
    ⟨singlePieceTheta_pos hR.1 (by norm_num),
      singlePieceTheta_le_one hR.1 hR.2 (by norm_num)⟩
  have hCS : 0 < P.CS alpha ∧ P.CS alpha ≤ 1 := by
    have hq := one_le_uCount P.V (uDeg68 P.k) (alpha / 2) (P.B alpha) (P.ThS alpha / 2)
    have hq0 := lt_of_lt_of_le zero_lt_one hq
    exact ⟨div_pos (half_pos hS.1) hq0, (div_le_one hq0).mpr (by linarith [hS.2])⟩
  have hEm : 0 < P.Em alpha ∧ P.Em alpha ≤ 1 :=
    uExp_pos_le P.V (uDeg68 P.k) (P.Delta alpha) (P.B alpha) (P.Rho1 alpha / 2 / 2)
  have hEth : 0 < P.Eth alpha ∧ P.Eth alpha ≤ 1 :=
    uExp_pos_le P.V (uDeg68 P.k) (alpha / 2) (P.B alpha) (P.ThS alpha / 2)
  have hEc : 0 < P.Ec alpha ∧ P.Ec alpha ≤ 1 :=
    uExp_pos_le P.V (uDeg68 P.k) (alpha / 2) (P.B alpha) (P.CS alpha / 2)
  obtain ⟨n0, n1⟩ := coverExp_pos_le (fun l => uExp P.V (uDeg68 l))
    (fun l g t s => uExp_pos_le P.V (uDeg68 l) g t s) alpha (alpha / 2) P.k
  have nt : (1 : Real) ≤ 1 := le_rfl
  have hBx : 0 < P.Bexp alpha ∧ P.Bexp alpha ≤ 1 := by
    have h0 := familyRecExp_pos P.k P.p (P.QM alpha) hp
    have h1 := familyRecExp_le_one P.k P.p (P.QM alpha) hp
    unfold Bexp
    exact ⟨by positivity, by linarith⟩
  obtain ⟨hz, -⟩ := section16Zeta_pos_le_half P.k ha ha1 hg hg1
  exact ⟨hB, ⟨hd0, hd1⟩, hT2, hR1, hR, hS, hCS, hEm, hEth, hEc, ⟨n0, n1, nt⟩, hBx, hz, hEw⟩

/-- The localization exponent lies in `(0, 1/2]`. -/
theorem Eloc_pos_le (hV : 1 ≤ P.V) (hp : 0 < P.p) {alpha : Real} (ha : 0 < alpha)
    (haHalf : alpha ≤ 1 / 2) :
    0 < P.Eloc alpha ∧ P.Eloc alpha ≤ 1 / 2 ∧ 0 < P.F alpha ∧ P.F alpha ≤ 1 ∧
      0 < P.MExp alpha ∧ P.MExp alpha ≤ 1 := by
  obtain ⟨-, -, -, -, -, -, -, hEm, hEth, hEc, ⟨n0, n1, -⟩, hBx, -, -⟩ :=
    P.ranges hV hp ha haHalf
  simpa only [Eloc, F, MExp] using
    localization_exponents_pos_le ⟨n0, n1⟩ hEm hBx hEth hEc

/-- **The scale conditions of the step hold above `Tloc`.** -/
theorem modulus_conditions (hV : 1 ≤ P.V) (hK : 2 ≤ P.K) (hp : 0 < P.p) {alpha : Real}
    (ha : 0 < alpha) (haHalf : alpha ≤ 1 / 2)
    (N : Nat) [NeZero N] [Fact N.Prime] (hN : P.Tloc alpha ≤ N) :
    SinglePieceModulusConditionsC (fun l => uCount P.V (uDeg68 l)) (fun l => uExp P.V (uDeg68 l))
      alpha P.k (familyRecExp P.k P.p) (familyRecThr P.k P.K P.p)
      (P.Eloc alpha) N := by
  classical
  obtain ⟨⟨hB0, hB1⟩, ⟨hd0, hd1⟩, ⟨ht2, ht21⟩, ⟨hρ1, hρ1'⟩, ⟨hρ, hρ'⟩, ⟨hthS, hthS'⟩,
    ⟨hcS, hcS'⟩, ⟨hEm, hEm'⟩, ⟨hEth, hEth'⟩, ⟨hEc, hEc'⟩, ⟨haN, haN', hNT⟩, ⟨hb, hb'⟩, hζ,
    hEw⟩ := P.ranges hV hp ha haHalf
  obtain ⟨he, -, hF, -, hmE, -⟩ := P.Eloc_pos_le hV hp ha haHalf
  -- the modulus is large
  have hNpos : (0 : Real) < N := by exact_mod_cast NeZero.pos N
  simp only [Tloc, max_le_iff] at hN
  obtain ⟨⟨hN3, hN156⟩, hNM, hNR, hN6⟩ := hN
  have hprime : N.Prime := Fact.out
  have hodd : Odd N := hprime.odd_of_ne_two (by
    intro h2; rw [h2] at hN3; norm_num at hN3)
  -- the nested width and `m`
  let NW : Nat := coverRemWidth (fun l => uExp P.V (uDeg68 l)) alpha (alpha / 2) P.k N
  have hnest := coverRemWidth_powerLB (fun l => uExp P.V (uDeg68 l)) alpha (alpha / 2) P.k
  have hNWpow : (N : Real) ^ P.NestExp alpha ≤ NW :=
    hnest N (hNM.trans' (le_max_left _ _))
  have hNW4 : (4 : Real) ≤ NW :=
    (by norm_num : (4 : Real) ≤ 64).trans
      ((le_rpow_of_rpow_inv_le haN (by norm_num) ((le_max_right _ _).trans hNM)).trans hNWpow)
  let m : Nat := coverWidth (uExp P.V (uDeg68 P.k) (P.Delta alpha) (P.B alpha))
    (P.Rho1 alpha / 2) ⌈(NW : Real) / 8⌉₊
  have hmpow : (N : Real) ^ P.MExp alpha ≤ m := by
    have hcov := coverWidth_div8_powerLB (uExp P.V (uDeg68 P.k) (P.Delta alpha) (P.B alpha))
      (P.Rho1 alpha / 2) hEm
    have hcomp := WidthPowerLB.comp hnest hcov haN (by positivity) hNT (by norm_num)
    exact hcomp N hNM
  have hm1 : (1 : Real) ≤ m :=
    (Real.one_le_rpow (by linarith) hmE.le).trans hmpow
  have hmReq : P.MReq alpha ≤ m :=
    (le_rpow_of_rpow_inv_le hmE ((Nat.cast_nonneg _).trans (le_max_left _ _)) hNR).trans hmpow
  have hmb8 : 8 / P.Zeta alpha ≤ (m : Real) ^ P.Bexp alpha :=
    le_rpow_of_rpow_inv_le hb (by positivity)
      (((le_max_left _ _).trans (le_max_right _ _)).trans hmReq)
  have hmbρ : 4 / (P.Zeta alpha * P.Rho alpha ^ 3) ≤ (m : Real) ^ P.Bexp alpha :=
    le_rpow_of_rpow_inv_le hb (by positivity)
      (((le_max_left _ _).trans ((le_max_right _ _).trans (le_max_right _ _))).trans hmReq)
  have hmb16 : 16 / P.Zeta alpha ≤ (m : Real) ^ (P.Bexp alpha / 2) := by
    have h := ((le_max_right _ _).trans ((le_max_right _ _).trans (le_max_right _ _))).trans hmReq
    apply le_rpow_of_rpow_inv_le (by positivity) (by positivity)
    simpa only [one_div_div] using h
  have hthr : (familyRecThr P.k P.K P.p (P.QM alpha) : Real) ≤ m := (le_max_left _ _).trans hmReq
  -- the final exponent
  have hρ1eq : coverRho1 (fun l => uCount P.V (uDeg68 l)) alpha (alpha / 2) P.k = P.Rho1 alpha := rfl
  have hthSeq : singlePieceTheta (spectrumPieceRho (fun t => t / 2) (P.Rho1 alpha)) 1 =
      P.ThS alpha := rfl
  have hcSeq : singlePieceGlobalC (fun l => uCount P.V (uDeg68 l)) alpha (alpha / 2) P.k (P.ThS alpha) =
      P.CS alpha := rfl
  have hBudeq : globalBudget alpha (alpha / 2) P.k = P.B alpha := rfl
  have hZeq : section16Zeta alpha (alpha / 2) P.k = P.Zeta alpha := rfl
  have hDeq : section16Delta (section16ThetaOne alpha (alpha / 2) P.k) = P.Delta alpha := rfl
  have hFin : ∀ q : Nat,
      (q : Real) ≤ singlePieceGlobalQmaxC (fun l => uCount P.V (uDeg68 l)) alpha (alpha / 2) P.k →
      (N : Real) ^ P.F alpha ≤
        coverWidth (uExp P.V (uDeg68 P.k) (alpha / 2) (P.B alpha)) (P.CS alpha)
          (coverWidth (uExp P.V (uDeg68 P.k) (alpha / 2) (P.B alpha)) (P.ThS alpha)
            ⌈spectrumCellWidth (P.Zeta alpha) m (familyRecExp P.k P.p q) / 8⌉₊) ∧
      2 * P.Bexp alpha ≤ familyRecExp P.k P.p q := by
    intro q hq
    have hqM : q ≤ P.QM alpha := Nat.le_floor hq
    have heps : 2 * P.Bexp alpha ≤ familyRecExp P.k P.p q := by
      unfold Bexp
      have := familyRecExp_antitone (k := P.k) hp hqM
      linarith
    refine ⟨?_, heps⟩
    have hSCW : (m : Real) ^ (P.Bexp alpha / 2) ≤
        spectrumCellWidth (P.Zeta alpha) m (familyRecExp P.k P.p q) / 8 :=
      spectrumCellWidth_div8_ge_rpow hζ (by exact_mod_cast hm1) heps hmb16
    let L : Nat := ⌈spectrumCellWidth (P.Zeta alpha) m (familyRecExp P.k P.p q) / 8⌉₊
    have hLge : (m : Real) ^ (P.Bexp alpha / 2) ≤ L := hSCW.trans (Nat.le_ceil _)
    have hin := coverWidth_powerLB (uExp P.V (uDeg68 P.k) (alpha / 2) (P.B alpha)) (P.ThS alpha)
      hEth.le L (by positivity)
    let X : Nat := coverWidth (uExp P.V (uDeg68 P.k) (alpha / 2) (P.B alpha)) (P.ThS alpha) L
    have hout := coverWidth_powerLB (uExp P.V (uDeg68 P.k) (alpha / 2) (P.B alpha)) (P.CS alpha)
      hEc.le X (by positivity)
    have hNL := rpow_le_comp hNpos.le (half_pos hb).le hmpow hLge
    have hNX := rpow_le_comp hNpos.le hEth.le hNL hin
    have hNY := rpow_le_comp hNpos.le hEc.le hNX hout
    have hexp : P.F alpha =
        ((P.MExp alpha * (P.Bexp alpha / 2)) * P.Eth alpha) * P.Ec alpha := by
      unfold F; ring
    rw [hexp]
    exact hNY
  have h6pow : (6 : Real) ≤ (N : Real) ^ P.Eloc alpha :=
    le_rpow_of_rpow_inv_le he (by norm_num) hN6
  have hloc {L : Nat} (hL : (N : Real) ^ P.F alpha ≤ L) :
      2 ≤ L ∧ (N : Real) ^ P.Eloc alpha ≤ ((Nat.sqrt (L - 1) - 1 : Nat) : Real) :=
    localization_width_bounds (by linarith only [hN3]) hF.le h6pow hL
  unfold SinglePieceModulusConditionsC SinglePieceGlobalScaleC singlePieceGlobalWidthC
  simp only [hρ1eq, hthSeq, hcSeq, hBudeq, hZeq, hDeq]
  refine ⟨hodd, hN156, ?_, m, ⟨by exact_mod_cast hNW4, by exact_mod_cast hm1,
    le_rfl, ?_⟩, ?_⟩
  · -- `4 ≤ N^e`
    linarith only [h6pow]
  · intro q hq
    obtain ⟨hFq, heps⟩ := hFin q hq
    have hqM : q ≤ P.QM alpha := Nat.le_floor hq
    have hthrq : (familyRecThr P.k P.K P.p q : Real) ≤ familyRecThr P.k P.K P.p (P.QM alpha) :=
      Nat.cast_le.mpr (familyRecThr_mono (by omega) hqM)
    obtain ⟨hcell4, hcellrho⟩ :=
      spectrumCellWidth_scale_bounds hζ hρ (by exact_mod_cast hm1) heps hmb8 hmbρ
    exact ⟨Nat.cast_le.mp (hthrq.trans hthr), hcell4, hcellrho, (hloc hFq).1⟩
  · intro q hq
    obtain ⟨hFq, -⟩ := hFin q hq
    exact (hloc hFq).2

end GenParamsC

end LeanProofs.GowersSzemeredi
