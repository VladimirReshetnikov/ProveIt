import GowersSzemeredi.Proofs18CoverBudget
import GowersSzemeredi.Proofs18PolyDegrees
import GowersSzemeredi.Proofs18GenericLengths
import GowersSzemeredi.Proofs18EnvelopeInduction

/-! **Theorem 18.1, Theorem 18.2 and Corollary 18.7 in every degree and
length**, from the recurrence profiles, with the joint-cover remainder
(Notes L.12).

The envelope steps are the graded ones (`Proofs18GradedDegrees`,
`Proofs18GradedLengths`) for `GenParamsC`, with no bound on `k`
(generated by `mk_cover_degrees.py`). The step costs
`densDegC = rhoDegC + 136·2^k + 13`, which is `O(2^k)`
(`envStepC_le`, `envStepCT_le`), so the envelopes have closed forms:
* `polyGenMuC_le`: `polyGenMuC k ≤ 1000·2^k`, against the budget
  `2^(d+10) = 4096·2^k` of Theorem 18.1 at degree `d = k + 2`;
* `genMuC_le`: `genMuC k ≤ 2000·2^k`, against the budget
  `2^(L+9) = 8192·2^k` of Theorem 18.2 at length `L = k + 4`.
Hence `theorem_18_1_of_profiles_cover` (every `d ≥ 4`),
`theorem_18_2_of_profiles_cover` and `corollary_18_7_of_profiles_cover`
(every `L ≥ 6`). -/
set_option autoImplicit false
noncomputable section
namespace LeanProofs.GowersSzemeredi

/-- The envelope after one step (no threshold). -/
def envStepC (k μ0 μK μ : Nat) : Nat :=
  max (GenParamsC.densDegC k μ0 + μ + 4 * (k + 3) ^ 2 + 14) (GenParamsC.expDegC k μ0 μK + 6)

/-- **The single-piece step with polynomial envelopes.** -/
theorem polyEnvBound_stepC (P : GenParamsC) {μV μK μ : Nat} (H : P.CHyp μV μK) (hk : 1 ≤ P.k)
    (hcov : ∀ l, 1 ≤ l → l ≤ P.k → PolyCoverAt l (uCount P.V (uDeg68 l)) (uExp P.V (uDeg68 l)))
    (hrec : Section16RecurrenceProfileWith P.k (familyRecThr P.k P.K P.p) (familyRecExp P.k P.p))
    (hlow : PolyEnvBound (P.k + 1) μ) : PolyEnvBound (P.k + 2) (envStepC P.k P.μ0 μK μ) := by
  intro alpha ha ha2
  have hX := two_div_ge_two ha ha2
  -- the input parameter, the lower-degree bound, the step and `Eloc`
  obtain ⟨he0, he8, hei, hy0, hyle, hyi⟩ := P.yIn_boundsC ha ha2 H.hV H.hVμ H.hμ0
  have hy2 : P.yIn alpha ≤ 1 / 2 := hyle.trans ha2
  obtain ⟨β, σ, T, hB, b0, b1, s0, s16, bi, si⟩ := hlow _ hy0 hy2
  have hstep := P.inverse_step H.hV H.hK H.hp hk hcov hrec ha ha2 hB b0 s0 s16
  obtain ⟨hEl0, hEli⟩ := P.Eloc_inv_leC H ha ha2
  obtain ⟨-, hEl2, -⟩ := P.Eloc_pos_le H.hV H.hp ha ha2
  set k := P.k with hkdef
  set E := GenParamsC.expDegC k P.μ0 μK with hEdef
  set dd := GenParamsC.densDegC k P.μ0 with hdddef
  set M1 := dd + 1 + μ with hM1def
  obtain ⟨-, hYμ⟩ := input_scale_le (μ := μ) ha ha2 hy0 hyi
  have bi' : β⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) := bi.trans hYμ
  have si' : σ⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) := si.trans hYμ
  have hei' : (P.eta alpha)⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) :=
    pw_mono hX hei (by rw [hM1def, hdddef]; unfold GenParamsC.densDegC; omega)
  have heta1 : P.eta alpha ≤ 1 := by linarith
  obtain ⟨σ0', σ16', σeq⟩ := sigma_step (d := k + 1) hEl0 hEl2 s0 s16
  have h32P : 32 * (polynomialPartitionConstant (k + 1 + 1) : Real) ≤
      (2 / alpha) ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := by
    refine pw_const hX ?_
    have hP := polyPartConst_le (k + 1 + 1)
    rw [show k + 1 + 1 + 1 = k + 3 by ring] at hP
    have hn : 4 * (k + 3) ^ 2 + 5 ≤ 2 ^ (4 * (k + 3) ^ 2 + 4) :=
      Nat.lt_two_pow_self (n := 4 * (k + 3) ^ 2 + 4)
    have hnat : 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := by
      calc 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ 5 * 2 ^ (4 * (k + 3) ^ 2) :=
            Nat.mul_le_mul (by norm_num) hP
        _ = 2 ^ (4 * (k + 3) ^ 2 + 5) := by rw [← pow_add]; ring_nf
        _ ≤ 2 ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := Nat.pow_le_pow_right (by norm_num) hn
    exact_mod_cast hnat
  set S := max (max (4 * (k + 3) ^ 2 + 4) (E + 3) + 1) M1 + 1 with hSdef
  have hσ' : (inverseStepExponent (k + 1) (P.Eloc alpha) σ)⁻¹ ≤ (2 / alpha) ^ (2 ^ S) := by
    rw [σeq]
    have hx0 : 0 ≤ 32 * (polynomialPartitionConstant (k + 1 + 1) : Real) * (P.Eloc alpha)⁻¹ :=
      mul_nonneg (mul_nonneg (by norm_num) (Nat.cast_nonneg _)) (inv_pos.mpr hEl0).le
    have h1 := pw_mul' hX (mul_nonneg (by norm_num) (Nat.cast_nonneg _)) (inv_pos.mpr hEl0).le
      h32P hEli
    exact pw_mul' hX hx0 (inv_pos.mpr s0).le h1 si'
  -- assemble
  refine ⟨P.eta alpha * β / 4, _, _, hstep, div_pos (mul_pos he0 b0) (by norm_num), ?_, σ0', σ16',
    ?_, pw_mono hX hσ' ?_⟩
  · have : P.eta alpha * β ≤ 1 := mul_le_one₀ heta1 b0.le b1
    linarith
  · rw [show (P.eta alpha * β / 4)⁻¹ = 4 * ((P.eta alpha)⁻¹ * β⁻¹) by field_simp]
    have h1 := pw_mul hX (inv_pos.mpr he0).le (inv_pos.mpr b0).le hei' bi'
    have h4 : (4 : Real) ≤ (2 / alpha) ^ (2 ^ (M1 + 1)) :=
      (four_le_pw_one hX).trans (pw_mono hX le_rfl (by omega))
    refine (pw_mul hX (by norm_num) (mul_nonneg (inv_pos.mpr he0).le (inv_pos.mpr b0).le) h4 h1).trans
      (pw_mono hX le_rfl ?_)
    unfold envStepC; rw [← hdddef]; omega
  · unfold envStepC; rw [← hdddef, ← hEdef]; omega

/-- The polynomial envelope of the degree-`(k+2)` bound. -/
def polyGenMuC : Nat → Nat
  | 0 => 74
  | 1 => 74
  | k + 2 => envStepC (k + 2) (genMu0 (k + 2)) (genMuK (k + 2)) (polyGenMuC (k + 1))

theorem polyGenMuC_succ {k : Nat} (hk : 1 ≤ k) :
    polyGenMuC (k + 1) = envStepC (k + 1) (genMu0 (k + 1)) (genMuK (k + 1)) (polyGenMuC k) := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  rfl

/-- **polynomial discrepancy bounds in every degree `k + 2 ≥ 4`**, from
the recurrence profiles and a phase partition. -/
theorem polyEnvBound_allC (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k) (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ ((2 : Nat) ^ (k + 5))))
    {Kφ : Real} {pφ : Nat} (hpp : ProgressionPhasePartition Kφ pφ) (hpφ : 0 < pφ)
    (hKφ : Kφ ≤ 2 ^ pφ) (hpφB : (pφ : Real) ≤ (2 : Real) ^ ((2 : Nat) ^ 64)) :
    ∀ k, 2 ≤ k → PolyEnvBound (k + 2) (polyGenMuC k) := by
  have hstep : ∀ k, 2 ≤ k → ∀ μ, PolyEnvBound (k + 1) μ →
      PolyEnvBound (k + 2) (envStepC k (genMu0 k) (genMuK k) μ) := by
    intro k hk μ hlow
    obtain ⟨hV, hVμ, hμ0, -, -, hk0, hKk, hKμ, hpk, hpμ⟩ := stdHyp_of_profiles Kc pc hK hp hconst hk
    let P : GenParamsC := ⟨classV Kc pc k, k, Kc k, pc k, genMu0 k⟩
    have H : P.CHyp (genMuV k) (genMuK k) := ⟨hV, hVμ, hμ0, hk0, hKk, hKμ, hpk, hpμ⟩
    have hcov := classCovers_of_profiles Kc pc hK hp hrec (degree := uDeg68) (k := k)
      (fun hK1 => polyCoverAt_class68 Kc pc hK1 hp)
    exact polyEnvBound_stepC P H (by show 1 ≤ k; omega) hcov (hrec k (by omega)) hlow
  intro k hk
  exact envelope_induction (P := PolyEnvBound) (budget := polyGenMuC) hstep
    (polyEnvBound_three_of_phase_partition hpp hpφ hKφ hpφB) (fun _ h => polyGenMuC_succ h) k (by omega)

/-- The envelope after one step, with the threshold. -/
def envStepCT (k μ0 μK μ : Nat) : Nat :=
  max (GenParamsC.densDegC k μ0 + μ + 4 * (k + 3) ^ 2 + 14)
    (max (GenParamsC.threshDegC k μ0 μK + 3) (40 * (k + 2) ^ 3 + 1095))

/-- **The single-piece step, with envelopes.** -/
theorem envBound_stepC (P : GenParamsC) {μV μK μ : Nat} (H : P.CHyp μV μK) (hk : 1 ≤ P.k)
    (hcov : ∀ l, 1 ≤ l → l ≤ P.k → PolyCoverAt l (uCount P.V (uDeg68 l)) (uExp P.V (uDeg68 l)))
    (hrec : Section16RecurrenceProfileWith P.k (familyRecThr P.k P.K P.p) (familyRecExp P.k P.p))
    (hlow : EnvBound (P.k + 1) μ) : EnvBound (P.k + 2) (envStepCT P.k P.μ0 μK μ) := by
  intro alpha ha ha2
  have hX := two_div_ge_two ha ha2
  -- everything that mentions `P.k`, before naming it
  obtain ⟨he0, he8, hei, hy0, hyle, hyi⟩ := P.yIn_boundsC ha ha2 H.hV H.hVμ H.hμ0
  have hy2 : P.yIn alpha ≤ 1 / 2 := hyle.trans ha2
  obtain ⟨β, σ, T, hB, b0, b1, s0, s16, bi, si, Ti⟩ := hlow _ hy0 hy2
  have hstep := P.inverse_step H.hV H.hK H.hp hk hcov hrec ha ha2 hB b0 s0 s16
  obtain ⟨hEl0, hEli⟩ := P.Eloc_inv_leC H ha ha2
  obtain ⟨-, hEl2, -⟩ := P.Eloc_pos_le H.hV H.hp ha ha2
  have hTl := P.Tloc_le_expC H hk ha ha2
  set k := P.k with hkdef
  set E := GenParamsC.expDegC k P.μ0 μK with hEdef
  set Th := GenParamsC.threshDegC k P.μ0 μK with hThdef
  set dd := GenParamsC.densDegC k P.μ0 with hdddef
  set M1 := dd + 1 + μ with hM1def
  have hETh : E + 4 ≤ Th := by rw [hThdef]; unfold GenParamsC.threshDegC; exact le_max_left _ _
  have hk3 : k + 2 ≤ (k + 2) ^ 3 := Nat.le_self_pow (by norm_num) _
  obtain ⟨-, hYμ⟩ := input_scale_le (μ := μ) ha ha2 hy0 hyi
  have bi' : β⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) := bi.trans hYμ
  have si' : σ⁻¹ ≤ Real.exp ((2 / alpha) ^ (2 ^ M1)) := si.trans (Real.exp_le_exp.mpr hYμ)
  have Ti' : T ≤ Real.exp (Real.exp ((2 / alpha) ^ (2 ^ M1))) :=
    Ti.trans (Real.exp_le_exp.mpr (Real.exp_le_exp.mpr hYμ))
  have hei' : (P.eta alpha)⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) :=
    pw_mono hX hei (by rw [hM1def, hdddef]; unfold GenParamsC.densDegC; omega)
  have heta1 : P.eta alpha ≤ 1 := by linarith
  -- the localization exponent and `σ′`
  obtain ⟨σ0', σ16', σeq⟩ := sigma_step (d := k + 1) hEl0 hEl2 s0 s16
  have h32P : 32 * (polynomialPartitionConstant (k + 1 + 1) : Real) ≤
      (2 / alpha) ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := by
    refine pw_const hX ?_
    have hP := polyPartConst_le (k + 1 + 1)
    rw [show k + 1 + 1 + 1 = k + 3 by ring] at hP
    have hn : 4 * (k + 3) ^ 2 + 5 ≤ 2 ^ (4 * (k + 3) ^ 2 + 4) :=
      Nat.lt_two_pow_self (n := 4 * (k + 3) ^ 2 + 4)
    have hnat : 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := by
      calc 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ 5 * 2 ^ (4 * (k + 3) ^ 2) :=
            Nat.mul_le_mul (by norm_num) hP
        _ = 2 ^ (4 * (k + 3) ^ 2 + 5) := by rw [← pow_add]; ring_nf
        _ ≤ 2 ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := Nat.pow_le_pow_right (by norm_num) hn
    exact_mod_cast hnat
  set S := max (max (4 * (k + 3) ^ 2 + 4) (E + 3) + 1) M1 + 1 with hSdef
  have hσ' : (inverseStepExponent (k + 1) (P.Eloc alpha) σ)⁻¹ ≤
      Real.exp ((2 / alpha) ^ (2 ^ S)) := by
    rw [σeq]
    have h1 := pw_mul' hX (mul_nonneg (by norm_num) (Nat.cast_nonneg _)) (inv_pos.mpr hEl0).le
      h32P hEli
    exact ex_mul' hX (inv_pos.mpr s0).le (ex_of_pw h1) si'
  -- the thresholds
  have hc : 6 * ((k + 1 : Nat) : Real) ≤ 2 ^ (2 ^ (k + 3)) := by
    have := small_nat_le_pw (le_refl (2 : Real)) (k := k) (c := 6 * (k + 1)) (by omega)
    push_cast at this ⊢; linarith
  have hd : (((k + 1 + 2 : Nat) : Real) ^ (2 : Nat)) ≤ 2 ^ (2 ^ (k + 3)) := by
    have h1 : k + 1 + 2 ≤ 2 ^ (k + 3) := by
      have := Nat.lt_two_pow_self (n := k + 3); omega
    have h2 : 2 * (k + 3) ≤ 2 ^ (k + 3) := by
      have := Nat.lt_two_pow_self (n := k + 2); rw [pow_succ]; omega
    have hnat : (k + 1 + 2) ^ 2 ≤ 2 ^ (2 ^ (k + 3)) :=
      calc (k + 1 + 2) ^ 2 ≤ (2 ^ (k + 3)) ^ 2 := Nat.pow_le_pow_left h1 2
        _ = 2 ^ (2 * (k + 3)) := by rw [← pow_mul]; ring_nf
        _ ≤ 2 ^ (2 ^ (k + 3)) := Nat.pow_le_pow_right (by norm_num) h2
    exact_mod_cast hnat
  have hshort := short_thr_le hX (d := k + 1) (j := k + 3) hEl0 hEli (by positivity) hc Ti' hTl hd
  have hinv := inv_thr_le hX (k := k) he0 heta1 b0 b1 hei' bi' s0 s16 σ0' hσ'
  -- assemble
  refine ⟨P.eta alpha * β / 4, _, _, hstep, div_pos (mul_pos he0 b0) (by norm_num), ?_, σ0', σ16',
    ?_, ex_mono hX hσ' ?_, ?_⟩
  · have : P.eta alpha * β ≤ 1 := mul_le_one₀ heta1 b0.le b1
    linarith
  · rw [show (P.eta alpha * β / 4)⁻¹ = 4 * ((P.eta alpha)⁻¹ * β⁻¹) by field_simp]
    have h1 := pw_mul hX (inv_pos.mpr he0).le (inv_pos.mpr b0).le hei' bi'
    have h4 : (4 : Real) ≤ (2 / alpha) ^ (2 ^ (M1 + 1)) :=
      (four_le_pw_one hX).trans (pw_mono hX le_rfl (by omega))
    refine (pw_mul hX (by norm_num) (mul_nonneg (inv_pos.mpr he0).le (inv_pos.mpr b0).le) h4 h1).trans
      (pw_mono hX le_rfl ?_)
    unfold envStepCT; rw [← hdddef]; omega
  · unfold envStepCT; rw [← hdddef, ← hThdef]; omega
  · refine max_le (dex_mono hX hshort ?_) (dex_mono hX hinv ?_)
    · unfold envStepCT; rw [← hdddef, ← hThdef]; omega
    · unfold envStepCT; rw [← hdddef, ← hThdef]; omega

/-- The envelope of the degree-`(k+2)` bound after the steps in
dimensions `2, …, k`. -/
def genMuC : Nat → Nat
  | 0 => 62
  | 1 => 62
  | k + 2 => envStepCT (k + 2) (genMu0 (k + 2)) (genMuK (k + 2)) (genMuC (k + 1))

theorem genMuC_succ {k : Nat} (hk : 1 ≤ k) :
    genMuC (k + 1) = envStepCT (k + 1) (genMu0 (k + 1)) (genMuK (k + 1)) (genMuC k) := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  rfl

/-- **discrepancy bounds in every degree `k + 2 ≥ 4`**, from the
recurrence profiles. -/
theorem envBound_allC (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k) (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ ((2 : Nat) ^ (k + 5)))) :
    ∀ k, 2 ≤ k → EnvBound (k + 2) (genMuC k) := by
  have hstep : ∀ k, 2 ≤ k → ∀ μ, EnvBound (k + 1) μ →
      EnvBound (k + 2) (envStepCT k (genMu0 k) (genMuK k) μ) := by
    intro k hk μ hlow
    obtain ⟨hV, hVμ, hμ0, -, -, hk0, hKk, hKμ, hpk, hpμ⟩ := stdHyp_of_profiles Kc pc hK hp hconst hk
    let P : GenParamsC := ⟨classV Kc pc k, k, Kc k, pc k, genMu0 k⟩
    have H : P.CHyp (genMuV k) (genMuK k) := ⟨hV, hVμ, hμ0, hk0, hKk, hKμ, hpk, hpμ⟩
    have hcov := classCovers_of_profiles Kc pc hK hp hrec (degree := uDeg68) (k := k)
      (fun hK1 => polyCoverAt_class68 Kc pc hK1 hp)
    exact envBound_stepC P H (by show 1 ≤ k; omega) hcov (hrec k (by omega)) hlow
  intro k hk
  exact envelope_induction (P := EnvBound) (budget := genMuC) hstep
    envBound_three (fun _ h => genMuC_succ h) k (by omega)


/-! ### Closed-form envelopes -/

/-- One step costs `268·2^k` plus a polynomial (Theorem 18.1 envelope). -/
theorem envStepC_le (k μ : Nat) :
    envStepC k (genMu0 k) (genMuK k) μ ≤ μ + 268 * 2 ^ k + 4 * (k + 3) ^ 2 + k + 32 := by
  unfold envStepC GenParamsC.densDegC GenParamsC.expDegC GenParamsC.rhoDegC genMu0 genMuK genMuV
    fixDeg
  rw [two_pow_six_mul, two_pow_five_mul]
  have := Nat.lt_two_pow_self (n := k)
  generalize 4 * (k + 3) ^ 2 = q
  generalize 2 ^ k = x at *
  omega

/-- One step costs `268·2^k` plus a polynomial (Theorem 18.2 envelope). -/
theorem envStepCT_le (k μ : Nat) :
    envStepCT k (genMu0 k) (genMuK k) μ ≤
      max (μ + 268 * 2 ^ k + 4 * (k + 3) ^ 2 + k + 32) (40 * (k + 2) ^ 3 + 1095) := by
  unfold envStepCT GenParamsC.densDegC GenParamsC.threshDegC GenParamsC.expDegC
    GenParamsC.rhoDegC genMu0 genMuK genMuV fixDeg
  rw [two_pow_six_mul, two_pow_five_mul]
  have := Nat.lt_two_pow_self (n := k)
  generalize 4 * (k + 3) ^ 2 = q
  generalize 40 * (k + 2) ^ 3 = c
  generalize 2 ^ k = x at *
  omega

/-- The step never decreases the envelope, and adds at least `268·2^k`. -/
theorem envStepCT_ge (k μ : Nat) : μ + 268 * 2 ^ k ≤ envStepCT k (genMu0 k) (genMuK k) μ := by
  unfold envStepCT GenParamsC.densDegC GenParamsC.rhoDegC genMu0 genMuV fixDeg
  rw [two_pow_six_mul, two_pow_five_mul]
  generalize 4 * (k + 3) ^ 2 = q
  generalize 2 ^ k = x at *
  omega

/-- `4(k+4)² + k + 33 ≤ 290·2^k`. -/
theorem quad_le_two_pow (k : Nat) : 4 * (k + 1 + 3) ^ 2 + (k + 1) + 32 ≤ 290 * 2 ^ k := by
  have h1 := GenParams.sq_add_three_lt (k + 1)
  rw [show k + 1 + 5 = k + 6 by ring, two_pow_six_mul] at h1
  have h2 := Nat.lt_two_pow_self (n := k)
  have h3 : (k + 1 + 3) ^ 2 = (k + 1 + 3) * (k + 1 + 3) := by ring
  rw [h3]
  omega

/-- `(k+3)³ ≤ 64·2^k`. -/
theorem cube_le_two_pow (k : Nat) : (k + 3) ^ 3 ≤ 64 * 2 ^ k := by
  induction k with
  | zero => norm_num
  | succ k ih =>
    rcases Nat.eq_zero_or_pos k with h | h
    · subst h; norm_num
    · have hstep : (k + 1 + 3) ^ 3 ≤ 2 * (k + 3) ^ 3 := by
        have hk : 1 ≤ k := h
        nlinarith [sq_nonneg (k : Nat), hk]
      calc (k + 1 + 3) ^ 3 ≤ 2 * (k + 3) ^ 3 := hstep
        _ ≤ 2 * (64 * 2 ^ k) := Nat.mul_le_mul_left _ ih
        _ = 64 * 2 ^ (k + 1) := by rw [pow_succ]; ring

/-- **The Theorem 18.1 envelope is `O(2^k)`.** -/
theorem polyGenMuC_le : ∀ k, 1 ≤ k → polyGenMuC k ≤ 1000 * 2 ^ k := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => show 74 ≤ 1000 * 2 ^ 1; norm_num
  | succ k hk ih =>
    rw [polyGenMuC_succ hk]
    have h1 := envStepC_le (k + 1) (polyGenMuC k)
    have h2 := quad_le_two_pow k
    rw [pow_succ] at h1 ⊢
    omega

/-- **The Theorem 18.2 envelope is `O(2^k)`.** -/
theorem genMuC_le : ∀ k, 1 ≤ k → genMuC k ≤ 2000 * 2 ^ k := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => show 62 ≤ 2000 * 2 ^ 1; norm_num
  | succ k hk ih =>
    rw [genMuC_succ hk]
    have h1 := envStepCT_le (k + 1) (genMuC k)
    have h2 := quad_le_two_pow k
    have h3 := cube_le_two_pow k
    rw [show k + 1 + 2 = k + 3 by ring] at h1
    rw [pow_succ] at h1 ⊢
    refine h1.trans (max_le (by omega) (by omega))

theorem genMuC_ge : ∀ k, 2 ≤ k → 268 * 2 ^ k ≤ genMuC k := by
  intro k hk
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  rw [genMuC_succ (by omega)]
  have := envStepCT_ge (j + 1) (genMuC j)
  omega

/-- **Theorem 18.1 in every degree `d ≥ 4`**, from the recurrence profiles and
a phase partition. -/
theorem theorem_18_1_of_profiles_cover (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k)
    (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ ((2 : Nat) ^ (k + 5))))
    {Kφ : Real} {pφ : Nat} (hpp : ProgressionPhasePartition Kφ pφ) (hpφ : 0 < pφ)
    (hKφ : Kφ ≤ 2 ^ pφ) (hpφB : (pφ : Real) ≤ (2 : Real) ^ ((2 : Nat) ^ 64))
    {d : Nat} (hd4 : 4 ≤ d) : Theorem181At d := by
  have henv := polyEnvBound_allC Kc pc hK hp hrec hconst hpp hpφ hKφ hpφB (d - 2) (by omega)
  rw [show d - 2 + 2 = d by omega] at henv
  refine theorem181At_of_polyEnvBound henv ?_
  have h := polyGenMuC_le (d - 2) (by omega)
  have h2 : 2 ^ (d + 10) = 4096 * 2 ^ (d - 2) := by
    rw [show d + 10 = (d - 2) + 12 by omega, pow_add]; ring
  rw [h2]
  have := Nat.one_le_two_pow (n := d - 2)
  omega

/-- **Theorem 18.2 in every length `L ≥ 6`**, from the recurrence profiles. -/
theorem theorem_18_2_of_profiles_cover (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k)
    (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ ((2 : Nat) ^ (k + 5))))
    {L : Nat} (hL6 : 6 ≤ L) : Theorem182At L := by
  have henv := envBound_allC Kc pc hK hp hrec hconst (L - 4) (by omega)
  rw [show L - 4 + 2 = L - 2 by omega] at henv
  have hle := genMuC_le (L - 4) (by omega)
  have hge := genMuC_ge (L - 4) (by omega)
  have hk := Nat.lt_two_pow_self (n := L - 4)
  have h42 : 42 ≤ genMuC (L - 4) := by omega
  have hLμ : 4 * L + 20 ≤ 2 ^ genMuC (L - 4) := by
    have := Nat.lt_two_pow_self (n := genMuC (L - 4))
    omega
  have h2 : 2 ^ (L + 9) = 8192 * 2 ^ (L - 4) := by
    rw [show L + 9 = (L - 4) + 13 by omega, pow_add]; ring
  refine theorem182At_of_envBound (by omega) henv h42 hLμ ?_
  rw [h2]
  omega

/-- **Corollary 18.7 in every length `L ≥ 6`**, from the recurrence profiles. -/
theorem corollary_18_7_of_profiles_cover (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k)
