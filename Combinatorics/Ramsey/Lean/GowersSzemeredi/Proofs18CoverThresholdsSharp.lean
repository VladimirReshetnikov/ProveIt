import GowersSzemeredi.Proofs18CoverLongThresholds
import GowersSzemeredi.Proofs18CoverSharperShortLengths

/-! **The phase-refinement threshold at the exponential level; Theorem 18.2
and Corollary 18.7 at `L + 5` in every length** (Notes L.15e).

`inv_thr_le` bounds the threshold of the inverse step through
`phaseInverseConstant ≤ X^(2^Q)` with `Q ≥ 40(k+2)³ + 1090`: the two pure
constants inside it, `section5LocalRefinementConstant d 1 ≤ 2^(2^(40d³+2))`
and `boundaryRefinementConstant (1/16) ≤ 2^(2^1083)`, are charged at the
`X`-power level. The threshold is only needed below `exp(exp(X^(2^μ)))`, and
a constant tower `2^(2^m)` is at most `exp(X^(2^j))` once `m ≤ 2^j`
(`two_tower_le_ex`). So `inv_thr_le_ex` has `k + 16` in place of the cubic
term, and the length envelope loses its cubic branch (`envStepCTx`).

At the tight base budget the envelope is then at most `500·2^k` for
`k ≥ 4` (`genMuX_le`), and fits `2^(L+5)` at every `L ≥ 6`
(`theorem_18_2_L5_all_of_profiles_cover`). The short lengths `L ≤ 5` keep
fitting at `c = 5` (`theorem_18_2_L5_le_five`). Generated by
`mk_cover_thresholds.py`. -/
set_option autoImplicit false
noncomputable section
namespace LeanProofs.GowersSzemeredi

/-- **Corollary 18.7 at every length `L ≥ 6` with `L + 5`**, from the profiles. -/
theorem corollary_18_7_L5_all_of_profiles_cover (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k)
    (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ ((2 : Nat) ^ (k + 5))))
    {L : Nat} (hL6 : 6 ≤ L) : Corollary187AtSharp 5 L :=
  (theorem_18_2_L5_all_of_profiles_cover Kc pc hK hp hrec hconst hL6).corollary_18_7

theorem roth_threshold_le_szemerediThresholdAt_five (k : Nat) {delta : Real}
    (hδ : 0 < delta) (hδ2 : delta ≤ 1 / 2) :
    Real.exp (Real.exp (1000000000000 * delta⁻¹)) ≤ szemerediThresholdAt 5 delta k := by
  exact (roth_threshold_le_szemerediThresholdAt_three k hδ hδ2).trans
    (szemerediThresholdAt_mono (by norm_num) hδ (by linarith))

theorem quadraticIntervalClosedThreshold_le_at_five {delta : Real}
    (hδ : 0 < delta) (hδhalf : delta ≤ 1 / 2) :
    quadraticIntervalClosedThreshold delta ≤ szemerediThresholdAt 5 delta 4 := by
  exact (quadraticIntervalClosedThreshold_le_at_three hδ hδhalf).trans
    (szemerediThresholdAt_mono (by norm_num) hδ (by linarith))

theorem fejerFiveTermThreshold_le_at_five {delta : Real}
    (hδ : 0 < delta) (hδhalf : delta ≤ 1 / 2) :
    fejerFiveTermThreshold delta ≤ szemerediThresholdAt 5 delta 5 := by
  exact (fejerFiveTermThreshold_le_at_three hδ hδhalf).trans
    (szemerediThresholdAt_mono (by norm_num) hδ (by linarith))

/-- **Theorem 18.2 with `L + 5` at every length `L ≤ 5`.** -/
theorem theorem_18_2_L5_le_five {k : Nat} (hk : k ≤ 5) : Theorem182AtSharp 5 k := by
  exact (theorem_18_2_L3_le_five hk).mono (by norm_num)

/-- **Corollary 18.7 with `L + 5` at every length `L ≤ 5`.** -/
theorem corollary_18_7_L5_le_five {k : Nat} (hk : k ≤ 5) : Corollary187AtSharp 5 k :=
  (theorem_18_2_L5_le_five hk).corollary_18_7

end LeanProofs.GowersSzemeredi
