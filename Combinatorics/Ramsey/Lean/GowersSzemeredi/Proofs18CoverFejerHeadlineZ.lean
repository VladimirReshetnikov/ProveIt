import GowersSzemeredi.Proofs18CoverExponentsFejerZ
import GowersSzemeredi.Proofs18CoverFejerHeadlineX

/-! **Theorem 18.1 at `d + 2` for every `d ≥ 16`, and Theorem 18.2 /
Corollary 18.7 with no offset for every `L ≥ 18`** (Notes L.16o).

`Proofs18CoverFejerHeadlineX` with the class table exact to dimension `14`
(`tDegZ`, `Proofs18TightClassesFejerZ`). The closed forms hold from
`k = 15`, and `decide +kernel` certifies the base of the invariant
`μ_k + 4k + 128 ≤ 16·2^k` at `k = 14`. That lowers both thresholds by one
(generated by `assemble_z.py`). -/
set_option autoImplicit false
noncomputable section
open scoped BigOperators
namespace LeanProofs.GowersSzemeredi

/-- The polynomial base budget. -/
def tightMu0Z (k : Nat) : Nat := max (tightMuW k) (pDeg k) + 2

/-- The envelope after one step (no threshold). -/
def envStepZ (k μ0 μK μ : Nat) : Nat :=
  max (GenParamsZ.densDegZ k μ0 + μ + 4 * (k + 3) ^ 2 + 14) (GenParamsZ.expDegZ k μ0 μK + 6)

/-- **The single-piece step with polynomial envelopes.** -/
theorem polyEnvBound_stepZ (P : GenParamsZ) {μV μK μ : Nat} (H : P.CHyp μV μK) (hk : 1 ≤ P.k)
    (hcov : ∀ l, 1 ≤ l → l ≤ P.k → PolyCoverAt l (uCount P.V (uDegZ l)) (uExp P.V (uDegZ l)))
    (hrec : Section16RecurrenceProfileWith P.k (familyRecThr P.k P.K P.p) (familyRecExp P.k P.p))
    (hlow : PolyEnvBound (P.k + 1) μ) : PolyEnvBound (P.k + 2) (envStepZ P.k P.μ0 μK μ) := by
  intro alpha ha ha2
  have hX := two_div_ge_two ha ha2
  -- the input parameter, the lower-degree bound, the step and `Eloc`
  obtain ⟨he0, he8, hei, hy0, hyle, hyi⟩ := P.yIn_boundsZ ha ha2 H.hV H.hVμ H.hμ0
  have hy2 : P.yIn alpha ≤ 1 / 2 := hyle.trans ha2
  obtain ⟨β, σ, T, hB, b0, b1, s0, s16, bi, si⟩ := hlow _ hy0 hy2
  have hstep := P.inverse_step H.hV H.hK H.hp hk hcov hrec ha ha2 hB b0 s0 s16
  obtain ⟨hEl0, hEli⟩ := P.Eloc_inv_leZ H ha ha2
  obtain ⟨-, hEl2, -⟩ := P.Eloc_pos_le H.hV H.hp ha ha2
  set k := P.k with hkdef
  set E := GenParamsZ.expDegZ k P.μ0 μK with hEdef
  set dd := GenParamsZ.densDegZ k P.μ0 with hdddef
  set M1 := dd + 1 + μ with hM1def
  obtain ⟨-, hYμ⟩ := input_scale_le (μ := μ) ha ha2 hy0 hyi
  have bi' : β⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) := bi.trans hYμ
  have si' : σ⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) := si.trans hYμ
  have hei' : (P.eta alpha)⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) :=
    pw_mono hX hei (by rw [hM1def, hdddef]; unfold GenParamsZ.densDegZ; omega)
  have heta1 : P.eta alpha ≤ 1 := by linarith
  obtain ⟨σ0', σ16', σeq⟩ := sigma_step (d := k + 1) hEl0 hEl2 s0 s16
  have h32P : 32 * (polynomialPartitionConstant (k + 1 + 1) : Real) ≤
      (2 / alpha) ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := by
    refine pw_const hX ?_
    have hP := polyPartConst_le (k + 1 + 1)
    rw [show k + 1 + 1 + 1 = k + 3 by ring] at hP
    have hn : 4 * (k + 3) ^ 2 + 5 ≤ 2 ^ (4 * (k + 3) ^ 2 + 4) :=
      Nat.lt_two_pow_self (n := 4 * (k + 3) ^ 2 + 4)
    have hnat : 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := by
      calc 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ 5 * 2 ^ (4 * (k + 3) ^ 2) :=
            Nat.mul_le_mul (by norm_num) hP
        _ = 2 ^ (4 * (k + 3) ^ 2 + 5) := by rw [← pow_add]; ring_nf
        _ ≤ 2 ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := Nat.pow_le_pow_right (by norm_num) hn
    exact_mod_cast hnat
  set S := max (max (4 * (k + 3) ^ 2 + 4) (E + 3) + 1) M1 + 1 with hSdef
  have hσ' : (inverseStepExponent (k + 1) (P.Eloc alpha) σ)⁻¹ ≤ (2 / alpha) ^ (2 ^ S) := by
    rw [σeq]
    have hx0 : 0 ≤ 32 * (polynomialPartitionConstant (k + 1 + 1) : Real) * (P.Eloc alpha)⁻¹ :=
      mul_nonneg (mul_nonneg (by norm_num) (Nat.cast_nonneg _)) (inv_pos.mpr hEl0).le
    have h1 := pw_mul' hX (mul_nonneg (by norm_num) (Nat.cast_nonneg _)) (inv_pos.mpr hEl0).le
      h32P hEli
    exact pw_mul' hX hx0 (inv_pos.mpr s0).le h1 si'
  -- assemble
  refine ⟨P.eta alpha * β / 4, _, _, hstep, div_pos (mul_pos he0 b0) (by norm_num), ?_, σ0', σ16',
    ?_, pw_mono hX hσ' ?_⟩
  · have : P.eta alpha * β ≤ 1 := mul_le_one₀ heta1 b0.le b1
    linarith
  · rw [show (P.eta alpha * β / 4)⁻¹ = 4 * ((P.eta alpha)⁻¹ * β⁻¹) by field_simp]
    have h1 := pw_mul hX (inv_pos.mpr he0).le (inv_pos.mpr b0).le hei' bi'
    have h4 : (4 : Real) ≤ (2 / alpha) ^ (2 ^ (M1 + 1)) :=
      (four_le_pw_one hX).trans (pw_mono hX le_rfl (by omega))
    refine (pw_mul hX (by norm_num) (mul_nonneg (inv_pos.mpr he0).le (inv_pos.mpr b0).le) h4 h1).trans
      (pw_mono hX le_rfl ?_)
    unfold envStepZ; rw [← hdddef]; omega
  · unfold envStepZ; rw [← hdddef, ← hEdef]; omega


/-- The envelope after one step, with the threshold, without the cubic branch. -/
def envStepZTx (k μ0 μK μ : Nat) : Nat :=
  max (GenParamsZ.densDegZ k μ0 + μ + 4 * (k + 3) ^ 2 + 14)
    (max (GenParamsZ.threshDegZ k μ0 μK + 3) (k + 20))

/-- **The single-piece step, with envelopes and the sharper phase-refinement
threshold.** -/
theorem envBound_stepZx (P : GenParamsZ) {μV μK μ : Nat} (H : P.CHyp μV μK) (hk : 1 ≤ P.k)
    (hcov : ∀ l, 1 ≤ l → l ≤ P.k → PolyCoverAt l (uCount P.V (uDegZ l)) (uExp P.V (uDegZ l)))
    (hrec : Section16RecurrenceProfileWith P.k (familyRecThr P.k P.K P.p) (familyRecExp P.k P.p))
    (hlow : EnvBound (P.k + 1) μ) : EnvBound (P.k + 2) (envStepZTx P.k P.μ0 μK μ) := by
  intro alpha ha ha2
  have hX := two_div_ge_two ha ha2
  -- everything that mentions `P.k`, before naming it
  obtain ⟨he0, he8, hei, hy0, hyle, hyi⟩ := P.yIn_boundsZ ha ha2 H.hV H.hVμ H.hμ0
  have hy2 : P.yIn alpha ≤ 1 / 2 := hyle.trans ha2
  obtain ⟨β, σ, T, hB, b0, b1, s0, s16, bi, si, Ti⟩ := hlow _ hy0 hy2
  have hstep := P.inverse_step H.hV H.hK H.hp hk hcov hrec ha ha2 hB b0 s0 s16
  obtain ⟨hEl0, hEli⟩ := P.Eloc_inv_leZ H ha ha2
  obtain ⟨-, hEl2, -⟩ := P.Eloc_pos_le H.hV H.hp ha ha2
  have hTl := P.Tloc_le_expZ H hk ha ha2
  set k := P.k with hkdef
  set E := GenParamsZ.expDegZ k P.μ0 μK with hEdef
  set Th := GenParamsZ.threshDegZ k P.μ0 μK with hThdef
  set dd := GenParamsZ.densDegZ k P.μ0 with hdddef
  set M1 := dd + 1 + μ with hM1def
  have hETh : E + 4 ≤ Th := by rw [hThdef]; unfold GenParamsZ.threshDegZ; exact le_max_left _ _
  have hk3 : k + 2 ≤ (k + 2) ^ 3 := Nat.le_self_pow (by norm_num) _
  obtain ⟨-, hYμ⟩ := input_scale_le (μ := μ) ha ha2 hy0 hyi
  have bi' : β⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) := bi.trans hYμ
  have si' : σ⁻¹ ≤ Real.exp ((2 / alpha) ^ (2 ^ M1)) := si.trans (Real.exp_le_exp.mpr hYμ)
  have Ti' : T ≤ Real.exp (Real.exp ((2 / alpha) ^ (2 ^ M1))) :=
    Ti.trans (Real.exp_le_exp.mpr (Real.exp_le_exp.mpr hYμ))
  have hei' : (P.eta alpha)⁻¹ ≤ (2 / alpha) ^ (2 ^ M1) :=
    pw_mono hX hei (by rw [hM1def, hdddef]; unfold GenParamsZ.densDegZ; omega)
  have heta1 : P.eta alpha ≤ 1 := by linarith
  -- the localization exponent and `σ′`
  obtain ⟨σ0', σ16', σeq⟩ := sigma_step (d := k + 1) hEl0 hEl2 s0 s16
  have h32P : 32 * (polynomialPartitionConstant (k + 1 + 1) : Real) ≤
      (2 / alpha) ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := by
    refine pw_const hX ?_
    have hP := polyPartConst_le (k + 1 + 1)
    rw [show k + 1 + 1 + 1 = k + 3 by ring] at hP
    have hn : 4 * (k + 3) ^ 2 + 5 ≤ 2 ^ (4 * (k + 3) ^ 2 + 4) :=
      Nat.lt_two_pow_self (n := 4 * (k + 3) ^ 2 + 4)
    have hnat : 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := by
      calc 32 * polynomialPartitionConstant (k + 1 + 1) ≤ 2 ^ 5 * 2 ^ (4 * (k + 3) ^ 2) :=
            Nat.mul_le_mul (by norm_num) hP
        _ = 2 ^ (4 * (k + 3) ^ 2 + 5) := by rw [← pow_add]; ring_nf
        _ ≤ 2 ^ (2 ^ (4 * (k + 3) ^ 2 + 4)) := Nat.pow_le_pow_right (by norm_num) hn
    exact_mod_cast hnat
  set S := max (max (4 * (k + 3) ^ 2 + 4) (E + 3) + 1) M1 + 1 with hSdef
  have hσ' : (inverseStepExponent (k + 1) (P.Eloc alpha) σ)⁻¹ ≤
      Real.exp ((2 / alpha) ^ (2 ^ S)) := by
    rw [σeq]
    have h1 := pw_mul' hX (mul_nonneg (by norm_num) (Nat.cast_nonneg _)) (inv_pos.mpr hEl0).le
      h32P hEli
    exact ex_mul' hX (inv_pos.mpr s0).le (ex_of_pw h1) si'
  -- the thresholds
  have hc : 6 * ((k + 1 : Nat) : Real) ≤ 2 ^ (2 ^ (k + 3)) := by
    have := small_nat_le_pw (le_refl (2 : Real)) (k := k) (c := 6 * (k + 1)) (by omega)
    push_cast at this ⊢; linarith
  have hd : (((k + 1 + 2 : Nat) : Real) ^ (2 : Nat)) ≤ 2 ^ (2 ^ (k + 3)) := by
    have h1 : k + 1 + 2 ≤ 2 ^ (k + 3) := by
      have := Nat.lt_two_pow_self (n := k + 3); omega
    have h2 : 2 * (k + 3) ≤ 2 ^ (k + 3) := by
      have := Nat.lt_two_pow_self (n := k + 2); rw [pow_succ]; omega
    have hnat : (k + 1 + 2) ^ 2 ≤ 2 ^ (2 ^ (k + 3)) :=
      calc (k + 1 + 2) ^ 2 ≤ (2 ^ (k + 3)) ^ 2 := Nat.pow_le_pow_left h1 2
        _ = 2 ^ (2 * (k + 3)) := by rw [← pow_mul]; ring_nf
        _ ≤ 2 ^ (2 ^ (k + 3)) := Nat.pow_le_pow_right (by norm_num) h2
    exact_mod_cast hnat
  have hshort := short_thr_le hX (d := k + 1) (j := k + 3) hEl0 hEli (by positivity) hc Ti' hTl hd
  have hinv := inv_thr_le_ex hX (k := k) he0 heta1 b0 b1 hei' bi' s0 s16 σ0' hσ'
  -- assemble
  refine ⟨P.eta alpha * β / 4, _, _, hstep, div_pos (mul_pos he0 b0) (by norm_num), ?_, σ0', σ16',
    ?_, ex_mono hX hσ' ?_, ?_⟩
  · have : P.eta alpha * β ≤ 1 := mul_le_one₀ heta1 b0.le b1
    linarith
  · rw [show (P.eta alpha * β / 4)⁻¹ = 4 * ((P.eta alpha)⁻¹ * β⁻¹) by field_simp]
    have h1 := pw_mul hX (inv_pos.mpr he0).le (inv_pos.mpr b0).le hei' bi'
    have h4 : (4 : Real) ≤ (2 / alpha) ^ (2 ^ (M1 + 1)) :=
      (four_le_pw_one hX).trans (pw_mono hX le_rfl (by omega))
    refine (pw_mul hX (by norm_num) (mul_nonneg (inv_pos.mpr he0).le (inv_pos.mpr b0).le) h4 h1).trans
      (pw_mono hX le_rfl ?_)
    unfold envStepZTx; rw [← hdddef]; omega
  · unfold envStepZTx; rw [← hdddef, ← hThdef]; omega
  · refine max_le (dex_mono hX hshort ?_) (dex_mono hX hinv ?_)
    · unfold envStepZTx; rw [← hdddef, ← hThdef]; omega
    · unfold envStepZTx; rw [← hdddef, ← hThdef]; omega



/-- The polynomial bound on the family constants: `K, p ≤ 2^(2^(4k+16))`. -/
def genMuKZ (k : Nat) : Nat := 4 * k + 16

/-- The standing hypotheses at the polynomial base budget. -/
theorem tightHyp_of_profiles_fejerZ (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k) (hp : ∀ k, 0 < pc k)
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16))) {k : Nat}
    (hk : 2 ≤ k) :
    (⟨classV Kc pc k, k, Kc k, pc k, tightMu0Z k⟩ : GenParamsZ).CHyp (tightMuW k) (genMuKZ k) := by
  have hKr : (Kc k : Real) ≤ 2 ^ ((2 : Nat) ^ genMuKZ k) := by
    have := hconst k; unfold genMuKZ; linarith [Nat.cast_nonneg (α := Real) (pc k)]
  have hpr : (pc k : Real) ≤ 2 ^ ((2 : Nat) ^ genMuKZ k) := by
    have := hconst k; unfold genMuKZ; linarith [Nat.cast_nonneg (α := Real) (Kc k)]
  refine ⟨one_le_classV Kc pc k, classV_le_poly Kc pc hconst k, le_rfl, ?_, hK k, ?_, hp k, ?_⟩
  · show k ≤ 2 ^ tightMu0Z k
    calc k ≤ 2 ^ k := Nat.lt_two_pow_self.le
      _ ≤ 2 ^ tightMu0Z k := Nat.pow_le_pow_right (by norm_num) (by
          unfold tightMu0Z; have := five_k_le_pDeg k
          have := le_max_right (tightMuW k) (pDeg k); omega)
  · have : ((Kc k : Nat) : Real) ≤ ((2 ^ 2 ^ genMuKZ k : Nat) : Real) := by push_cast; exact hKr
    exact_mod_cast this
  · have : ((pc k : Nat) : Real) ≤ ((2 ^ 2 ^ genMuKZ k : Nat) : Real) := by push_cast; exact hpr
    exact_mod_cast this


/-- The Theorem 18.1 envelope at the tight base budget. -/
def polyGenMuZ : Nat → Nat
  | 0 => 74
  | 1 => 74
  | k + 2 => envStepZ (k + 2) (tightMu0Z (k + 2)) (genMuKZ (k + 2)) (polyGenMuZ (k + 1))

theorem polyGenMuZ_succ {k : Nat} (hk : 1 ≤ k) :
    polyGenMuZ (k + 1) = envStepZ (k + 1) (tightMu0Z (k + 1)) (genMuKZ (k + 1)) (polyGenMuZ k) := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  rfl


theorem polyEnvBound_allZ (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k) (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16)))
    {Kφ : Real} {pφ : Nat} (hpp : ProgressionPhasePartition Kφ pφ) (hpφ : 0 < pφ)
    (hKφ : Kφ ≤ 2 ^ pφ) (hpφB : (pφ : Real) ≤ (2 : Real) ^ ((2 : Nat) ^ 64)) :
    ∀ k, 2 ≤ k → PolyEnvBound (k + 2) (polyGenMuZ k) := by
  have hlem : ∀ k, 1 ≤ k → AbstractFamilyLemma166At k
      (section16PowerWidth (familyWidthPrefactor (Kc k)) (familyWidthDivisor k (pc k))) :=
    fun k hk => abstractFamilyLemma166At_of k (hK k) (hp k) (hrec k hk)
  have hK1 : ∀ k, 1 ≤ Kc k := fun k => le_trans (by norm_num) (hK k)
  have hstep : ∀ k, 2 ≤ k → ∀ μ, PolyEnvBound (k + 1) μ →
      PolyEnvBound (k + 2) (envStepZ k (tightMu0Z k) (genMuKZ k) μ) := by
    intro k hk μ hlow
    let P : GenParamsZ := ⟨classV Kc pc k, k, Kc k, pc k, tightMu0Z k⟩
    have H : P.CHyp (tightMuW k) (genMuKZ k) := tightHyp_of_profiles_fejerZ Kc pc hK hp hconst hk
    have hcov : ∀ l, 1 ≤ l → l ≤ P.k →
        PolyCoverAt l (uCount P.V (uDegZ l)) (uExp P.V (uDegZ l)) := by
      intro l hl1 hlk
      have hcl := polyCoverAt_classZ Kc pc hK1 hp hlem hl1
      exact hcl.uniform_mono (one_le_classV Kc pc l) (classV_mono Kc pc hlk) le_rfl
    exact polyEnvBound_stepZ P H (by show 1 ≤ k; omega) hcov (hrec k (by omega)) hlow
  intro k hk
  induction k, hk using Nat.le_induction with
  | base =>
    exact hstep 2 le_rfl 74 (polyEnvBound_three_of_phase_partition hpp hpφ hKφ hpφB)
  | succ k hk ih =>
    rw [polyGenMuZ_succ (by omega)]
    exact hstep (k + 1) (by omega) (polyGenMuZ k) ih


/-- The Theorem 18.2 envelope at the tight base budget, without the cubic branch. -/
def genMuXZ : Nat → Nat
  | 0 => 62
  | 1 => 62
  | k + 2 => envStepZTx (k + 2) (tightMu0Z (k + 2)) (genMuKZ (k + 2)) (genMuXZ (k + 1))

theorem genMuXZ_succ {k : Nat} (hk : 1 ≤ k) :
    genMuXZ (k + 1) = envStepZTx (k + 1) (tightMu0Z (k + 1)) (genMuKZ (k + 1)) (genMuXZ k) := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  rfl

theorem envBound_allXZ (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k) (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16))) :
    ∀ k, 2 ≤ k → EnvBound (k + 2) (genMuXZ k) := by
  have hlem : ∀ k, 1 ≤ k → AbstractFamilyLemma166At k
      (section16PowerWidth (familyWidthPrefactor (Kc k)) (familyWidthDivisor k (pc k))) :=
    fun k hk => abstractFamilyLemma166At_of k (hK k) (hp k) (hrec k hk)
  have hK1 : ∀ k, 1 ≤ Kc k := fun k => le_trans (by norm_num) (hK k)
  have hstep : ∀ k, 2 ≤ k → ∀ μ, EnvBound (k + 1) μ →
      EnvBound (k + 2) (envStepZTx k (tightMu0Z k) (genMuKZ k) μ) := by
    intro k hk μ hlow
    let P : GenParamsZ := ⟨classV Kc pc k, k, Kc k, pc k, tightMu0Z k⟩
    have H : P.CHyp (tightMuW k) (genMuKZ k) := tightHyp_of_profiles_fejerZ Kc pc hK hp hconst hk
    have hcov : ∀ l, 1 ≤ l → l ≤ P.k →
        PolyCoverAt l (uCount P.V (uDegZ l)) (uExp P.V (uDegZ l)) := by
      intro l hl1 hlk
      have hcl := polyCoverAt_classZ Kc pc hK1 hp hlem hl1
      exact hcl.uniform_mono (one_le_classV Kc pc l) (classV_mono Kc pc hlk) le_rfl
    exact envBound_stepZx P H (by show 1 ≤ k; omega) hcov (hrec k (by omega)) hlow
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => exact hstep 2 le_rfl 62 envBound_three
  | succ k hk ih =>
    rw [genMuXZ_succ (by omega)]
    exact hstep (k + 1) (by omega) (genMuXZ k) ih




/-! ### Closed forms -/

/-- Beyond the table one step costs `15·2^(k−1)` plus a polynomial. -/
theorem envStepZ_le_tight {k : Nat} (hk : 15 ≤ k) (μ : Nat) :
    envStepZ k (tightMu0Z k) (genMuKZ k) μ ≤
      μ + 15 * 2 ^ (k - 1) + 9 * (k + 4) ^ 2 + 4 * (k + 3) ^ 2 + 6 * k + 59 := by
  unfold envStepZ GenParamsZ.densDegZ GenParamsZ.expDegZ GenParamsZ.rhoDegZ tightMu0Z tightMuW
    genMuKZ pDeg
  rw [tDegZ_eq_of_ge hk]
  have := Nat.lt_two_pow_self (n := k - 1)
  generalize 4 * (k + 3) ^ 2 = q
  generalize (k + 4) ^ 2 = s
  generalize 2 ^ (k - 1) = y at *
  omega

/-- `32(k+5)² ≤ 2^k` for `k ≥ 14`. -/
theorem thirtytwo_sq_le_two_pow_fourteen : ∀ k, 14 ≤ k → 32 * (k + 5) ^ 2 ≤ 2 ^ k := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => norm_num
  | succ k hk ih =>
    have hstep : (k + 1 + 5) ^ 2 ≤ 2 * (k + 5) ^ 2 := by nlinarith
    calc 32 * (k + 1 + 5) ^ 2 ≤ 2 * (32 * (k + 5) ^ 2) := by omega
      _ ≤ 2 * 2 ^ k := Nat.mul_le_mul_left _ ih
      _ = 2 ^ (k + 1) := by rw [pow_succ]; ring

theorem polyGenMuZ_fourteen : polyGenMuZ 14 + 4 * 14 + 128 ≤ 16 * 2 ^ 14 := by decide +kernel

/-- **The Theorem 18.1 envelope at class constant `5/2`**: `μ_k + 4k + 128 ≤ 16·2^k`
for `k ≥ 14`. -/
theorem polyGenMuZ_le16 : ∀ k, 14 ≤ k → polyGenMuZ k + 4 * k + 128 ≤ 16 * 2 ^ k := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => exact polyGenMuZ_fourteen
  | succ k hk ih =>
    rw [polyGenMuZ_succ (by omega)]
    have h1 := envStepZ_le_tight (k := k + 1) (by omega) (polyGenMuZ k)
    have h2 := thirtytwo_sq_le_two_pow_fourteen k hk
    have h3 : (k + 4) ^ 2 ≤ (k + 5) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have h4 : 6 * k + 70 ≤ (k + 5) ^ 2 := by nlinarith
    rw [show k + 1 + 4 = k + 5 by ring, show k + 1 + 3 = k + 4 by ring,
      show k + 1 - 1 = k by omega] at h1
    rw [pow_succ]
    generalize (k + 5) ^ 2 = s5 at *
    generalize (k + 4) ^ 2 = s4 at *
    generalize 2 ^ k = x at *
    omega

/-! ### The headline statement -/

/-- **Theorem 18.1 at every degree `d ≥ 16` with exponent `α^(2^(2^(d+2)))`**,
from the recurrence profiles with polynomial family constants. -/
theorem theorem_18_1_d2_sixteen_le_of_profiles_poly (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k)
    (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16)))
    {Kφ : Real} {pφ : Nat} (hpp : ProgressionPhasePartition Kφ pφ) (hpφ : 0 < pφ)
    (hKφ : Kφ ≤ 2 ^ pφ) (hpφB : (pφ : Real) ≤ (2 : Real) ^ ((2 : Nat) ^ 64))
    {d : Nat} (hd : 16 ≤ d) : Theorem181AtSharp 2 d := by
  have henv := polyEnvBound_allZ Kc pc hK hp hrec hconst hpp hpφ hKφ hpφB (d - 2) (by omega)
  rw [show d - 2 + 2 = d by omega] at henv
  refine theorem181AtSharp_of_polyEnvBound henv ?_
  have hle := polyGenMuZ_le16 (d - 2) (by omega)
  have h2 : 2 ^ (d + 2) = 16 * 2 ^ (d - 2) := by
    rw [show d + 2 = (d - 2) + 4 by omega, pow_add]; ring
  rw [h2]
  omega


/-! ### Theorem 18.2 without offset -/

theorem envStepZTx_le_tight {k : Nat} (hk : 15 ≤ k) (μ : Nat) :
    envStepZTx k (tightMu0Z k) (genMuKZ k) μ ≤
      μ + 15 * 2 ^ (k - 1) + 9 * (k + 4) ^ 2 + 4 * (k + 3) ^ 2 + 6 * k + 59 := by
  unfold envStepZTx GenParamsZ.densDegZ GenParamsZ.threshDegZ GenParamsZ.expDegZ
    GenParamsZ.rhoDegZ tightMu0Z tightMuW genMuKZ pDeg
  rw [tDegZ_eq_of_ge hk]
  have := Nat.lt_two_pow_self (n := k - 1)
  generalize 4 * (k + 3) ^ 2 = q
  generalize (k + 4) ^ 2 = s
  generalize 2 ^ (k - 1) = y at *
  omega

theorem envStepZTx_ge (k μ0 μK μ : Nat) : 5 * k + 33 ≤ envStepZTx k μ0 μK μ := by
  unfold envStepZTx GenParamsZ.threshDegZ
  omega

theorem genMuXZ_fourteen : genMuXZ 14 + 4 * 14 + 128 ≤ 16 * 2 ^ 14 := by decide +kernel

/-- **The Theorem 18.2 envelope at class constant `5/2`**: `μ_k + 4k + 128 ≤ 16·2^k`
for `k ≥ 14`. -/
theorem genMuXZ_le16 : ∀ k, 14 ≤ k → genMuXZ k + 4 * k + 128 ≤ 16 * 2 ^ k := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => exact genMuXZ_fourteen
  | succ k hk ih =>
    rw [genMuXZ_succ (by omega)]
    have h1 := envStepZTx_le_tight (k := k + 1) (by omega) (genMuXZ k)
    have h2 := thirtytwo_sq_le_two_pow_fourteen k hk
    have h3 : (k + 4) ^ 2 ≤ (k + 5) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have h4 : 6 * k + 70 ≤ (k + 5) ^ 2 := by nlinarith
    rw [show k + 1 + 4 = k + 5 by ring, show k + 1 + 3 = k + 4 by ring,
      show k + 1 - 1 = k by omega] at h1
    rw [pow_succ]
    generalize (k + 5) ^ 2 = s5 at *
    generalize (k + 4) ^ 2 = s4 at *
    generalize 2 ^ k = x at *
    omega

theorem genMuXZ_ge {k : Nat} (hk : 2 ≤ k) : 5 * k + 33 ≤ genMuXZ k := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  rw [genMuXZ_succ (by omega)]
  exact envStepZTx_ge _ _ _ _

/-- **Theorem 18.2 at every length `L ≥ 18` with no offset**: threshold
`2^2^δ^-1^(2^2^L)` (printed: `L + 9`), from the recurrence profiles with
polynomial family constants. -/
theorem theorem_18_2_L0_eighteen_le_of_profiles_poly (Kc pc : Nat → Nat) (hK : ∀ k, 2 ≤ Kc k)
    (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16)))
    {L : Nat} (hL : 18 ≤ L) : Theorem182AtSharp 0 L := by
  have henv := envBound_allXZ Kc pc hK hp hrec hconst (L - 4) (by omega)
  rw [show L - 4 + 2 = L - 2 by omega] at henv
  have hge := genMuXZ_ge (k := L - 4) (by omega)
  have hle := genMuXZ_le16 (L - 4) (by omega)
  have h42 : 42 ≤ genMuXZ (L - 4) := by omega
  have hLμ : 4 * L + 20 ≤ 2 ^ genMuXZ (L - 4) := by
    have := Nat.lt_two_pow_self (n := genMuXZ (L - 4))
    omega
  refine theorem182AtSharp_of_envBound (by omega) henv h42 hLμ ?_
  have h2 : 2 ^ (L + 0) = 16 * 2 ^ (L - 4) := by
    rw [show L + 0 = (L - 4) + 4 by omega, pow_add]; ring
  rw [h2]
  omega

/-- **Corollary 18.7 at every length `L ≥ 18` with no offset.** -/
theorem corollary_18_7_L0_eighteen_le_of_profiles_poly (Kc pc : Nat → Nat)
    (hK : ∀ k, 2 ≤ Kc k) (hp : ∀ k, 0 < pc k)
    (hrec : ∀ k, 1 ≤ k →
      Section16RecurrenceProfileWith k (familyRecThr k (Kc k) (pc k)) (familyRecExp k (pc k)))
    (hconst : ∀ k, (Kc k : Real) + pc k ≤ 2 ^ ((2 : Nat) ^ (4 * k + 16)))
    {L : Nat} (hL : 18 ≤ L) : Corollary187AtSharp 0 L :=
  (theorem_18_2_L0_eighteen_le_of_profiles_poly Kc pc hK hp hrec hconst hL).corollary_18_7

