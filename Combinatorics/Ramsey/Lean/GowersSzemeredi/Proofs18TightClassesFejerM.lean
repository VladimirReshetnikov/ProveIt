import GowersSzemeredi.Proofs18TightClassesFejerZ

/-! **The split step combined by `max`** (Notes L.16w).

The split step bounds the count, the width exponent and the threshold of the
next class separately, and then takes one family exponent and one parameter
degree for all three. `splitStepA = sCountN + sExpN` and
`splitStepDFejer = countW + expW + thrDeg` add them. Since every control of a
split class is monotone in `(a, D)`, the `max` suffices:
* `splitUniformClass_succ_fejer_max`: the step at `splitStepAMax`,
  `splitStepDMaxF`;
* `splitPairMax`, `split_pair_max_quad`, `split_pair_max_half` (the
  invariants at class constants `4` and `5/2`, through
  `splitStepAMax_le_sum`, `splitStepDMaxWith_le_sum`), and
  `splitUniformClass_all_max`;
* `tDegM`: the exact table up to `l = 14`
  (`…, 842, 1472, 2684, 5057, 9746, 19064, 37637`, against
  `…, 881, 1550, 2841, 5371, 10375, 20323, 40154` for the sum), then
  `5·2^(l−1) + 3(l+4)² + 2`; `split_pair_max_le_uDegM`,
  `polyCoverAt_classM`, `tDegM_le_tDegZ`
(generated by `assemble_m.py`). -/
set_option autoImplicit false
noncomputable section
namespace LeanProofs.GowersSzemeredi

/-- The family exponent of the next split class, combined by `max`. -/
def splitStepAMax (k a : Nat) : Nat := max (sCountN k a) (sExpN k a)

/-- The parameter degree of the next split class (Fejér inputs), combined by `max`. -/
def splitStepDMaxF (k a D : Nat) : Nat :=
  max (max (fsCountW k a D) (fsExpW k a D)) (fejerStepThrDeg k D)

/-- The parameter degree with general step inputs, combined by `max`. -/
def splitStepDMaxWith (P T k a D : Nat) : Nat :=
  max (max (wCountW P k a D) (wExpW P T k a D)) (wThrDeg P D)

theorem splitStepAMax_le_sum (k a : Nat) : splitStepAMax k a ≤ splitStepA k a := by
  unfold splitStepAMax splitStepA
  exact max_le (Nat.le_add_right _ _) (Nat.le_add_left _ _)

theorem splitStepDMaxWith_le_sum (P T k a D : Nat) :
    splitStepDMaxWith P T k a D ≤ splitStepDWith P T k a D := by
  unfold splitStepDMaxWith splitStepDWith
  refine max_le (max_le ?_ ?_) ?_ <;> omega

theorem splitStepDMaxF_eq (k a D : Nat) :
    splitStepDMaxF k a D = splitStepDMaxWith (fejerStepP k) (fejerStepT k) k a D := by
  unfold splitStepDMaxWith wCountW wExpW wThrDeg wZW wLW wBqW wErW wEbW wPbW wSW wStepY
    splitStepDMaxF fsCountW fsExpW fejerStepThrDeg fsZW fsLW fsBqW fsErW fsEbW fsPbW fsSW fsQrW fsStepY
  rfl

/-- The split recursion with the Fejér inputs, combined by `max`. -/
def splitPairMax (seedA seedD : Nat) : Nat → Nat × Nat
  | 0 => (seedA, seedD)
  | k + 1 => if k < 2 then (seedA, seedD)
      else (splitStepAMax k (splitPairMax seedA seedD k).1,
        splitStepDMaxWith (fejerStepP k) (fejerStepT k) k
          (splitPairMax seedA seedD k).1 (splitPairMax seedA seedD k).2)

theorem splitPairMax_two (seedA seedD : Nat) : splitPairMax seedA seedD 2 = (seedA, seedD) := by
  simp [splitPairMax]

theorem splitPairMax_succ (seedA seedD : Nat) {k : Nat} (hk : 2 ≤ k) :
    splitPairMax seedA seedD (k + 1) =
      (splitStepAMax k (splitPairMax seedA seedD k).1,
        splitStepDMaxWith (fejerStepP k) (fejerStepT k) k
          (splitPairMax seedA seedD k).1 (splitPairMax seedA seedD k).2) := by
  rw [splitPairMax, if_neg (by omega)]

theorem splitUniformClass_succ_fejer_max {k : Nat} (hk : 1 ≤ k) {V : Real} (hV : 1 ≤ V) {a D : Nat}
    (ha : 1 ≤ a) (hD : 1 ≤ D) (C : SplitUniformClass k V a D) {K p : Nat} (hK : 1 ≤ K)
    (hp : 0 < p)
    (hlemma6 : AbstractFamilyLemma166At k
      (section16PowerWidth (familyWidthPrefactor K) (familyWidthDivisor k p)))
    {V' : Real} (hVV : V ≤ V') (hKV : (K : Real) ≤ V') (hpV : (p : Real) ≤ V') :
    Nonempty (SplitUniformClass (k + 1) V' (splitStepAMax k a) (splitStepDMaxF k a D)) := by
  classical
  obtain ⟨hCnt, hExp, hCntMono, hExpAnti⟩ := splitCnt_controls hV a D
  refine ⟨{
    U := fun N _ theta gamma Gamma =>
      ∃ P : Fin (classPiecesFejer gamma theta k) → StepPieceFejer C N theta gamma,
        Gamma ⊆ stepPieceFejerGraphs C P
    mono := fun N _ theta gamma Gamma Gamma' hsub ⟨P, hP⟩ => ⟨P, hsub.trans hP⟩
    empty := fun N _ theta gamma =>
      ⟨fun _ => ClassPiece.empty C _ _ _ _ _ _, Finset.empty_subset _⟩
    decomp := ?_
    cover := ?_ }⟩
  · intro theta gamma ht ht1 hg hg1 N _ _ hN Gamma hsize hprod
    obtain ⟨hu2, -, -, -, -⟩ := prod_scale_basic hg hg1 ht ht1
    have hVu : 1 ≤ V' * (2 / (gamma * theta)) :=
      one_le_mul_of_one_le_of_one_le (hV.trans hVV) (le_trans (by norm_num) hu2)
    have hN' : classStepThrFejer (fun theta gamma => (V * (2 / (gamma * theta))) ^ D) theta gamma k ≤ N := by
      rw [← classStepThresholdFejer_eq]
      refine (step_thr_le_fejer hk hV hVV hg hg1 ht ht1).trans (le_trans ?_ hN)
      exact pow_le_pow_right₀ hVu (by unfold splitStepDMaxF; first | omega | simp only [le_max_iff, le_refl, true_or, or_true])
    obtain ⟨J, hJ, P, hP⟩ := class_step_decomp_fejer C hk ht ht1 hg hg1 hN' Gamma hsize hprod
    exact ⟨J, hJ, P, hP⟩
  · intro theta gamma ht ht1 hg hg1 N _ _ n Gamma hU
    choose P hP using hU
    have h := class_step_cover_gen_fejer C hk hCnt hExp hCntMono hExpAnti (familyWidthPrefactor_pos hK)
      (familyWidthDivisor_pos hp) hlemma6 ht ht1 hg hg1 Gamma P hP
    refine h.weaken ?_ ?_ ?_
    · intro rho hr hr1
      have hc := split_count_le_fejer (k := k) ha hD hV hVV hg hg1 ht ht1 hr hr1 n
      obtain ⟨hw2, -, -, -, -⟩ := split_w_facts hV hVV hg hg1 ht ht1 hr hr1
      have hν : (1 : Real) ≤ (n : Real) + 1 := by
        have := Nat.cast_nonneg (α := Real) n; linarith
      refine hc.trans (tb_mono hν (by linarith) (by unfold splitStepAMax; first | omega | simp only [le_max_iff, le_refl, true_or, or_true])
        (by unfold splitStepDMaxF; first | omega | simp only [le_max_iff, le_refl, true_or, or_true]))
    · intro rho hr hr1
      obtain ⟨hw2, -, -, -, -⟩ := split_w_facts hV hVV hg hg1 ht ht1 hr hr1
      have hν : (1 : Real) ≤ (n : Real) + 1 := by
        have := Nat.cast_nonneg (α := Real) n; linarith
      exact inv_pos.mpr (lt_of_lt_of_le zero_lt_one (tb_one_le hν (by linarith)))
    · intro rho hr hr1
      obtain ⟨he0, hei⟩ := split_exp_inv_le_fejer (k := k) ha hD hV hVV hK hp hKV hpV hg hg1 ht ht1 hr hr1 n
      obtain ⟨hw2, -, -, -, -⟩ := split_w_facts hV hVV hg hg1 ht ht1 hr hr1
      have hν : (1 : Real) ≤ (n : Real) + 1 := by
        have := Nat.cast_nonneg (α := Real) n; linarith
      have hmono := tb_mono (a := sExpN k a) (b := fsExpW k a D) (a' := splitStepAMax k a)
        (b' := splitStepDMaxF k a D) hν (by linarith) (by unfold splitStepAMax; first | omega | simp only [le_max_iff, le_refl, true_or, or_true])
        (by unfold splitStepDMaxF; first | omega | simp only [le_max_iff, le_refl, true_or, or_true])
      have h1 := inv_anti₀ (lt_of_lt_of_le zero_lt_one (tb_one_le hν (by linarith))) hmono
      have h2 := inv_anti₀ (inv_pos.mpr he0) hei
      rw [inv_inv] at h2
      exact h1.trans h2


/-- **The split invariants at class constant `4` in every dimension `l ≥ 2`**,
from the small seed `(32, 2^48)`. -/
theorem split_pair_max_quad : ∀ l, 2 ≤ l →
    1 ≤ (splitPairMax splitSeedSmallA splitSeedSmallD l).1 ∧
      1 ≤ (splitPairMax splitSeedSmallA splitSeedSmallD l).2 ∧
      2 ^ (l + 6) * (splitPairMax splitSeedSmallA splitSeedSmallD l).1 ≤ 2 ^ (4 * 2 ^ l) ∧
      (splitPairMax splitSeedSmallA splitSeedSmallD l).2 ≤
        2 ^ (4 * 2 ^ l + 3 * (l + 4) ^ 2 + 30) := by
  intro l hl
  induction l, hl using Nat.le_induction with
  | base =>
    rw [splitPairMax_two]
    unfold splitSeedSmallA splitSeedSmallD
    refine ⟨by norm_num, Nat.one_le_two_pow, by norm_num, ?_⟩
    exact Nat.pow_le_pow_right (by norm_num) (by norm_num)
  | succ k hk ih =>
    obtain ⟨ha, hDp, hAb, hDb⟩ := ih
    rw [splitPairMax_succ _ _ hk]
    set a := (splitPairMax splitSeedSmallA splitSeedSmallD k).1
    set D := (splitPairMax splitSeedSmallA splitSeedSmallD k).2
    obtain ⟨h1, h2⟩ := fejer_split_step_quad4 ha hAb hDb ((splitStepAMax_le_sum k a).trans (splitStepA_le ha))
      ((splitStepDMaxWith_le_sum _ _ k a D).trans (splitStepDWith_le ha hDp (fejerStepP_ge k))) (fejerStepP_le k) (fejerStepT_le k)
    refine ⟨?_, ?_, h1, h2⟩
    · exact (show 1 ≤ sCountN k a by unfold sCountN; omega).trans (le_max_left _ _)
    · exact (show 1 ≤ wCountW (fejerStepP k) k a D by unfold wCountW; omega).trans
        ((le_max_left _ _).trans (le_max_left _ _))

/-- **A split uniform class in every dimension `k ≥ 2` from the small seed**,
at degrees `splitPairMax 32 (2^48) k`. -/
theorem splitUniformClass_all_max (Kc pc : Nat → Nat) (hK : ∀ k, 1 ≤ Kc k) (hp : ∀ k, 0 < pc k)
    (hlem : ∀ k, 1 ≤ k → AbstractFamilyLemma166At k
      (section16PowerWidth (familyWidthPrefactor (Kc k)) (familyWidthDivisor k (pc k)))) :
    ∀ k, 2 ≤ k →
      Nonempty (SplitUniformClass k (classV Kc pc k)
        (splitPairMax splitSeedSmallA splitSeedSmallD k).1
        (splitPairMax splitSeedSmallA splitSeedSmallD k).2) := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base =>
    have hV1 := one_le_classV Kc pc 2
    have hc1 := const_le_classV_succ Kc pc 1
    rw [splitPairMax_two]
    exact splitUniformClass_two_small (hK 1) (hp 1) (hlem 1 le_rfl) hV1 (hc1.1.trans le_rfl)
      (hc1.2.trans le_rfl)
  | succ k hk ih =>
    obtain ⟨C⟩ := ih
    obtain ⟨ha, hD, -, -⟩ := split_pair_max_quad k hk
    have hV1 := one_le_classV Kc pc k
    have hc := const_le_classV_succ Kc pc k
    rw [splitPairMax_succ _ _ hk, ← splitStepDMaxF_eq]
    exact splitUniformClass_succ_fejer_max (by omega) hV1 ha hD C (hK k) (hp k) (hlem k (by omega))
      (classV_le_succ Kc pc k) hc.1 hc.2

/-- The exact twelfth dimension fits the invariant at constant `5/2`. -/
theorem split_pair_max_twelve_half :
    2 ^ (12 + 6) * (splitPairMax splitSeedSmallA splitSeedSmallD 12).1 ≤ 2 ^ (5 * 2 ^ (12 - 1)) ∧
      (splitPairMax splitSeedSmallA splitSeedSmallD 12).2 ≤
        2 ^ (5 * 2 ^ (12 - 1) + 3 * (12 + 4) ^ 2) := by
  constructor <;> decide +kernel

/-- **The split invariants at class constant `5/2` in every dimension `l ≥ 12`.** -/
theorem split_pair_max_half : ∀ l, 12 ≤ l →
    1 ≤ (splitPairMax splitSeedSmallA splitSeedSmallD l).1 ∧
      1 ≤ (splitPairMax splitSeedSmallA splitSeedSmallD l).2 ∧
      2 ^ (l + 6) * (splitPairMax splitSeedSmallA splitSeedSmallD l).1 ≤ 2 ^ (5 * 2 ^ (l - 1)) ∧
      (splitPairMax splitSeedSmallA splitSeedSmallD l).2 ≤
        2 ^ (5 * 2 ^ (l - 1) + 3 * (l + 4) ^ 2) := by
  intro l hl
  induction l, hl using Nat.le_induction with
  | base =>
    obtain ⟨ha, hD, -, -⟩ := split_pair_max_quad 12 (by norm_num)
    exact ⟨ha, hD, split_pair_max_twelve_half⟩
  | succ k hk ih =>
    obtain ⟨ha, hDp, hAb, hDb⟩ := ih
    rw [splitPairMax_succ _ _ (by omega)]
    set a := (splitPairMax splitSeedSmallA splitSeedSmallD k).1
    set D := (splitPairMax splitSeedSmallA splitSeedSmallD k).2
    obtain ⟨h1, h2⟩ := split_step_gen ha hAb hDb ((splitStepAMax_le_sum k a).trans (splitStepA_le ha))
      ((splitStepDMaxWith_le_sum _ _ k a D).trans (splitStepDWith_le ha hDp (fejerStepP_ge k))) (fejerStepP_le k) (fejerStepT_le k)
    have he : 2 * (5 * 2 ^ (k - 1)) = 5 * 2 ^ (k + 1 - 1) := by
      rw [show k + 1 - 1 = (k - 1) + 1 by omega, pow_succ]; ring
    refine ⟨?_, ?_, he ▸ h1, h2.trans (Nat.pow_le_pow_right (by norm_num) ?_)⟩
    · exact (show 1 ≤ sCountN k a by unfold sCountN; omega).trans (le_max_left _ _)
    · exact (show 1 ≤ wCountW (fejerStepP k) k a D by unfold wCountW; omega).trans
        ((le_max_left _ _).trans (le_max_left _ _))
    · have hs : 3 * (k + 1 + 4) ^ 2 = 3 * (k + 4) ^ 2 + 6 * k + 27 := by ring
      rw [← he, hs]
      omega

/-- The exact class log-degrees in dimensions `0, …, 14`. -/
def tTableM : List Nat :=
  [17, 17, 49, 85, 134, 205, 317, 505, 842, 1472, 2684, 5057, 9746, 19064, 37637]

/-- The class log-degree: exact up to dimension `14`, constant `5/2` beyond. -/
def tDegM (l : Nat) : Nat := if l ≤ 14 then tTableM.getD l 0 else 5 * 2 ^ (l - 1) + 3 * (l + 4) ^ 2 + 2

/-- The class degree from the table to dimension `14`. -/
def uDegM (l : Nat) : Nat := 2 ^ tDegM l

theorem uDegM_eq (l : Nat) : uDegM l = 2 ^ tDegM l := rfl

theorem tDegM_eq_of_ge {l : Nat} (hl : 15 ≤ l) :
    tDegM l = 5 * 2 ^ (l - 1) + 3 * (l + 4) ^ 2 + 2 := by
  unfold tDegM; rw [if_neg (by omega)]

theorem seventeen_le_tDegM (l : Nat) : 17 ≤ tDegM l := by
  rcases Nat.lt_or_ge l 15 with h | h
  · interval_cases l <;> decide
  · rw [tDegM_eq_of_ge h]
    have : 16 ≤ (l + 4) ^ 2 := by nlinarith
    omega

theorem tDegM_le_succ (l : Nat) : tDegM l ≤ tDegM (l + 1) := by
  rcases Nat.lt_or_ge l 15 with h | h
  · interval_cases l <;> decide
  · rw [tDegM_eq_of_ge h, tDegM_eq_of_ge (by omega)]
    have h1 : 2 ^ (l - 1) ≤ 2 ^ (l + 1 - 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
    have h2 : (l + 4) ^ 2 ≤ (l + 1 + 4) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    omega

theorem tDegM_mono {l k : Nat} (hl : l ≤ k) : tDegM l ≤ tDegM k := by
  induction k, hl using Nat.le_induction with
  | base => exact le_rfl
  | succ k _ ih => exact ih.trans (tDegM_le_succ k)

theorem uDegM_le_pow {l k : Nat} (hl : l ≤ k) : uDegM l ≤ 2 ^ tDegM k := by
  rw [uDegM_eq]; exact Nat.pow_le_pow_right (by norm_num) (tDegM_mono hl)

/-- The η side condition `3(k+4)²` fits the class degree. -/
theorem sq_le_three_tDegM (k : Nat) : 3 * (k + 4) ^ 2 ≤ 3 * tDegM k + 5 * k + 37 := by
  rcases Nat.lt_or_ge k 15 with h | h
  · interval_cases k <;> decide
  · rw [tDegM_eq_of_ge h]; omega

/-- **The max-split degrees fit `uDegM`**, kernel-evaluated up to dimension `14`. -/
theorem split_pair_max_le_uDegM {l : Nat} (hl : 2 ≤ l) :
    (splitPairMax splitSeedSmallA splitSeedSmallD l).1 +
      (splitPairMax splitSeedSmallA splitSeedSmallD l).2 + l + 1 ≤ uDegM l := by
  rcases Nat.lt_or_ge l 15 with h | h
  · interval_cases l <;> decide +kernel
  · obtain ⟨-, -, hA, hD⟩ := split_pair_max_half l (by omega)
    unfold uDegM
    rw [tDegM_eq_of_ge h]
    set a := (splitPairMax splitSeedSmallA splitSeedSmallD l).1
    set D := (splitPairMax splitSeedSmallA splitSeedSmallD l).2
    set Y := 2 ^ (5 * 2 ^ (l - 1) + 3 * (l + 4) ^ 2) with hYdef
    have ha : a ≤ Y := by
      have h1 : a ≤ 2 ^ (5 * 2 ^ (l - 1)) :=
        le_trans (Nat.le_mul_of_pos_left a (Nat.two_pow_pos _)) hA
      exact h1.trans (Nat.pow_le_pow_right (by norm_num) (by omega))
    have hl1 : l + 1 ≤ Y := by
      have h1 : l + 1 ≤ 2 ^ (l + 1) := Nat.lt_two_pow_self.le
      have h2 : l + 1 ≤ 5 * 2 ^ (l - 1) + 3 * (l + 4) ^ 2 := by
        have : l + 1 ≤ (l + 4) ^ 2 := by nlinarith
        omega
      exact h1.trans (Nat.pow_le_pow_right (by norm_num) h2)
    have h4 : 2 ^ (5 * 2 ^ (l - 1) + 3 * (l + 4) ^ 2 + 2) = 4 * Y := by
      rw [hYdef, pow_add]; ring
    rw [h4]
    omega

/-- **The class cover in dimension `l` at degree `uDegM l`.** -/
theorem polyCoverAt_classM (Kc pc : Nat → Nat) (hK : ∀ k, 1 ≤ Kc k) (hp : ∀ k, 0 < pc k)
    (hlem : ∀ k, 1 ≤ k → AbstractFamilyLemma166At k
      (section16PowerWidth (familyWidthPrefactor (Kc k)) (familyWidthDivisor k (pc k))))
    {l : Nat} (hl1 : 1 ≤ l) :
    PolyCoverAt l (uCount (classV Kc pc l) (uDegM l)) (uExp (classV Kc pc l) (uDegM l)) := by
  have hVl := one_le_classV Kc pc l
  rcases Nat.lt_or_ge l 2 with hl | hl
  · obtain rfl : l = 1 := by omega
    refine polyCoverAt_one_uniform_low hVl ?_
    unfold uDegM
    exact Nat.pow_le_pow_right (by norm_num) (seventeen_le_tDegM 1)
  · obtain ⟨C⟩ := splitUniformClass_all_max Kc pc hK hp hlem l hl
    have hfit := split_pair_max_le_uDegM hl
    have P0 := (C.toPower hVl).polyCoverAt (by omega) hVl (D := uDegM l) (by omega) (by omega)
      (by omega)
    refine P0.weaken ?_ ?_ ?_
    · intro g t s hg hg1 ht ht1 hs hs1
      rw [uCount_eq hVl _ hg hg1 ht ht1 hs hs1]
    · intro g t s _ _ _ _ _ _
      exact (uExp_pos_le _ _ g t s).1
    · intro g t s hg hg1 ht ht1 hs hs1
      show (uCount _ _ g t s)⁻¹ ≤ _
      rw [uCount_eq hVl _ hg hg1 ht ht1 hs hs1]

/-- `tDegM ≤ tDegZ`: the max step never loses against the sum step. -/
theorem tDegM_le_tDegZ (l : Nat) : tDegM l ≤ tDegZ l := by
  rcases Nat.lt_or_ge l 15 with h | h
  · interval_cases l <;> decide
  · rw [tDegM_eq_of_ge h, tDegZ_eq_of_ge h]

end LeanProofs.GowersSzemeredi
