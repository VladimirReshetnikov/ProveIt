    omega
  refine theorem182AtSharp_of_envBound (by omega) henv h42 hLμ ?_
  have h2 : 2 ^ (L + 0) = 16 * 2 ^ (L - 4) := by
    rw [show L + 0 = (L - 4) + 4 by omega, pow_add]; ring
  rw [h2]
  omega

