import GowersSzemeredi.Proofs16ClassStep
import GowersSzemeredi.Proofs16PolyCoverTwoFejer

/-! **The class step under the Fejér θ₁ and the tight radius** (Notes L.16d).

The Fejér instance of `Proofs16ClassStep`, the step of route (II) from a
uniform class in dimension `k` to the next. It is generated by a script
with a guard that no printed parameter survives, and uses:
* the explicit Fejér Lemma 15.6 (`fejer_product_of_density_lower_explicit`),
  so the arrangement density is `fejerThetaOne θ γ k = (θγ/4)^(E(k))` with
  `E(k) = fejerProductExponent k ≤ 2^(5k+14)`;
* the tight radius `tightZeta (θ₁′/4)`;
* `class_piece_data_with` (`Proofs16ClassPieces`).

The step's controls (`class_step_cover_fejer`) are the corpus's, with
`classBudgetW θ₁′ k`, `δ(θ₁′)` and the tight radius in place of the printed
budget, δ and ζ. Their degrees, with `fejerStepP` and `fejerStepT` in place
of `stepP` and `stepT`, are the next module.

`class_step_cover_fejer` is in `Proofs16ClassStepFejerSide`, outside the final
route. -/
set_option autoImplicit false
noncomputable section
open scoped BigOperators
namespace LeanProofs.GowersSzemeredi
open BaseCase

variable {k : Nat} {Thr : Real → Real → Real} {Cnt Exp : Real → Real → Nat → Real → Real}

/-- The Fejér arrangement density lies in `(0, 1/36]` after division by `4`,
in every dimension. -/
theorem fejerThetaOne_bounds (k : Nat) {theta gamma : Real} (ht : 0 < theta) (ht1 : theta ≤ 1)
    (hg : 0 < gamma) (hg1 : gamma ≤ 1) :
    0 < fejerThetaOne theta gamma k / 4 ∧ fejerThetaOne theta gamma k / 4 ≤ 1 / 36 := by
  have hp : 0 < theta * gamma / 4 := by positivity
  have hp1 : theta * gamma / 4 ≤ 1 / 4 := by nlinarith
  have hE : 2 ≤ fejerProductExponent k := by
    unfold fejerProductExponent fejerSelectionExponent
    have h1 : 2 ≤ 2 ^ (3 * k + 7) :=
      le_trans (by norm_num : 2 ≤ 2 ^ 1) (Nat.pow_le_pow_right (by norm_num) (by omega))
    have h2 : 1 ≤ 2 ^ (k + 4) * (k + 6) := Nat.one_le_iff_ne_zero.mpr (by positivity)
    exact h1.trans (Nat.le_mul_of_pos_right _ h2)
  refine ⟨by unfold fejerThetaOne; positivity, ?_⟩
  have h : fejerThetaOne theta gamma k ≤ (1 / 4 : Real) ^ 2 := by
    unfold fejerThetaOne
    calc (theta * gamma / 4) ^ fejerProductExponent k
        ≤ (1 / 4 : Real) ^ fejerProductExponent k := pow_le_pow_left₀ hp.le hp1 _
      _ ≤ (1 / 4 : Real) ^ 2 := pow_le_pow_of_le_one (by norm_num) (by norm_num) hE
  norm_num at h ⊢
  linarith

theorem fejerThetaOne_half_eq (theta gamma : Real) (k : Nat) :
    fejerThetaOne theta gamma k = (theta / 2 * gamma / 2) ^ fejerProductExponent k := by
  unfold fejerThetaOne
  congr 1
  ring

/-- The class thresholds of a piece for power controls, at density `t1`. -/
def classPieceThresholdW (V : Real) (dT : Nat) (t1 gamma : Real) (k : Nat) : Real :=
  max ((V * (2 / (section16Delta t1 * classBudgetW t1 k))) ^ dT)
    ((V * (2 / (gamma * classBudgetW t1 k))) ^ dT)

/-! ### Parameters of the step -/

/-- Pieces per relation: `⌊γ⁻²/θ′⌋`. -/
def classPiecesFejer (gamma theta : Real) (k : Nat) : Nat :=
  ⌊gamma ^ (-(2 : Int)) / classBudgetW (fejerThetaOne theta gamma k) k⌋₊

/-- The modulus threshold of the step. -/
def classStepThrFejer (Thr : Real → Real → Real) (theta gamma : Real) (k : Nat) : Real :=
  max 3 (max (fejerProductThreshold k (theta / 2) gamma) (classPieceThrW Thr (fejerThetaOne theta gamma k) gamma k))

/-- The modulus threshold of the step, for power controls. -/
def classStepThresholdFejer (V : Real) (dT : Nat) (theta gamma : Real) (k : Nat) : Real :=
  max 3 (max (fejerProductThreshold k (theta / 2) gamma) (classPieceThresholdW V dT (fejerThetaOne theta gamma k) gamma k))

theorem classStepThresholdFejer_eq (V : Real) (dT : Nat) (theta gamma : Real) (k : Nat) :
    classStepThresholdFejer V dT theta gamma k =
      classStepThrFejer (fun theta gamma => (V * (2 / (gamma * theta))) ^ dT) theta gamma k := rfl

/-- The pieces of the next class: relative to the universal relation, mass `0`. -/
abbrev StepPieceFejer (C : UniformClassWith k Thr Cnt Exp) (N : Nat) [NeZero N] (theta gamma : Real) :=
  ClassPiece C (Finset.univ : Finset (Point N (k + 1) × ZMod N)) (tightZeta (fejerThetaOne theta gamma k / 4)) 0
    (classBudgetW (fejerThetaOne theta gamma k) k) (section16Delta (fejerThetaOne theta gamma k)) (classBudgetW (fejerThetaOne theta gamma k) k) gamma

/-- The graph of a family of step pieces. -/
def stepPieceFejerGraphs (C : UniformClassWith k Thr Cnt Exp) {N : Nat} [NeZero N] {theta gamma : Real}
    {m : Nat} (P : Fin m → StepPieceFejer C N theta gamma) : Finset (Point N (k + 1) × ZMod N) :=
  Finset.univ.biUnion fun c => partialGraph (P c).D (P c).phi

/-! ### One piece of a sub-relation -/

/-- **Every dense sub-relation contains a piece.** -/
theorem class_piece_of_subrelation_fejer (C : UniformClassWith k Thr Cnt Exp) (hk : 1 ≤ k)
    {theta gamma : Real} (ht : 0 < theta) (ht1 : theta ≤ 1) (hg : 0 < gamma) (hg1 : gamma ≤ 1)
    {N : Nat} [NeZero N] [Fact N.Prime] (hN : classStepThrFejer Thr theta gamma k ≤ N)
    {Gamma : Finset (Point N (k + 1) × ZMod N)} (hprod : RelationProductProperty gamma Gamma)
    (Delta : Finset (Point N (k + 1) × ZMod N)) (hDelta : Delta ⊆ Gamma)
    (hproj : theta * (N : Real) ^ (k + 1) ≤ (relationProjection Delta).card) :
    Nonempty (ClassPiece C Delta (tightZeta (fejerThetaOne theta gamma k / 4)) (classBudgetW (fejerThetaOne theta gamma k) k)
      (classBudgetW (fejerThetaOne theta gamma k) k) (section16Delta (fejerThetaOne theta gamma k)) (classBudgetW (fejerThetaOne theta gamma k) k) gamma) := by
  let phi : Point N (k + 1) → ZMod N := fun x =>
    if h : ∃ y, (x, y) ∈ Delta then Classical.choose h else 0
  have hsel : GraphContained (relationProjection Delta) phi Delta := by
    intro x hx
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hx
    have hex : ∃ y, (z.1, y) ∈ Delta := ⟨z.2, by simpa using hz⟩
    simp only [phi, dif_pos hex]
    exact Classical.choose_spec hex
  have hprodB : HasProductProperty (relationProjection Delta) phi gamma :=
    (RelationProductProperty.mono hprod hDelta) _ phi hsel
  have hN3 : (3 : Real) ≤ N := (le_max_left _ _).trans hN
  have hNthr : fejerProductThreshold k (theta / 2) gamma ≤ N :=
    ((le_max_left _ _).trans (le_max_right _ _)).trans hN
  have hNpiece : classPieceThrW Thr (fejerThetaOne theta gamma k) gamma k ≤ N :=
    ((le_max_right _ _).trans (le_max_right _ _)).trans hN
  have hprime : N.Prime := Fact.out
  have hodd : Odd N := hprime.odd_of_ne_two (by
    intro h2
    rw [h2] at hN3
    norm_num at hN3)
  have hβ : theta / 2 * (N : Real) ^ (k + 1) ≤ (relationProjection Delta).card := by linarith
  obtain ⟨hfa0, hfaS⟩ := fejerThetaOne_bounds k ht ht1 hg hg1
  obtain ⟨B', hB'sub, harr1, harr2⟩ := fejer_product_of_density_lower_explicit k (theta / 2) gamma
    hk (by positivity) (by linarith) hg hg1 N hNthr hprime hodd
    (relationProjection Delta) phi hβ hprodB
  have hBarr : fejerThetaOne theta gamma k * (N : Real) ^ (17 * k + 15) ≤
        generalArrangementCount 8 B' ∧
      (1 - (2 : Real) ^ (-(44 : Real))) * generalArrangementCount 8 B' ≤
        respectedGeneralArrangementCount 8 B' phi := by
    refine ⟨?_, ?_⟩
    · rw [fejerThetaOne_half_eq]; exact harr1
    · rw [two_rpow_neg_44]; exact harr2
  have hgraph : partialGraph B' phi ⊆ Delta := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hz
    exact hsel x (hB'sub hx)
  exact class_piece_data_with C hfa0 hfaS (tightZeta_condition hfa0)
    (tightZeta_pos_le_half hfa0 (by linarith)).1 hg hg1 hNpiece Delta B' phi hgraph hBarr
    (hprodB.mono hB'sub)

/-! ### The greedy decomposition -/

/-- **Off a good set, a product relation is covered by `classPiecesFejer γ θ k` pieces.** -/
theorem class_step_decomp_fejer (C : UniformClassWith k Thr Cnt Exp) (hk : 1 ≤ k)
    {theta gamma : Real} (ht : 0 < theta) (ht1 : theta ≤ 1) (hg : 0 < gamma) (hg1 : gamma ≤ 1)
    {N : Nat} [NeZero N] [Fact N.Prime] (hN : classStepThrFejer Thr theta gamma k ≤ N)
    (Gamma : Finset (Point N (k + 1) × ZMod N))
    (hsize : (Gamma.card : Real) ≤ gamma ^ (-(2 : Int)) * (N : Real) ^ (k + 1))
    (hprod : RelationProductProperty gamma Gamma) :
    ∃ J : Finset (Point N (k + 1)), (1 - theta) * (N : Real) ^ (k + 1) ≤ J.card ∧
      ∃ P : Fin (classPiecesFejer gamma theta k) → StepPieceFejer C N theta gamma,
        restrictRelation Gamma J ⊆ stepPieceFejerGraphs C P := by
  obtain ⟨h0, h1⟩ := fejerThetaOne_bounds k ht ht1 hg hg1
  obtain ⟨hθ'pos, -⟩ := classBudgetW_pos_le k h0 h1
  have hN0 : (0 : Real) < N := by exact_mod_cast NeZero.pos N
  obtain ⟨q, G, J, hG, hq, hJ, hcov⟩ := section16_greedy_relation_decomposition
    (fun G => ∃ P : StepPieceFejer C N theta gamma, G = partialGraph P.D P.phi) theta
    (classBudgetW (fejerThetaOne theta gamma k) k * (N : Real) ^ (k + 1)) (by positivity) Gamma
    fun Delta hDelta hproj => by
      obtain ⟨P⟩ := class_piece_of_subrelation_fejer C hk ht ht1 hg hg1 hN hprod Delta hDelta hproj
      exact ⟨_, P.graph_sub, by rw [partialGraph_card]; exact P.card_ge,
        (P.toMassZero C).widen C (Finset.subset_univ _), rfl⟩
  have hqm : q ≤ classPiecesFejer gamma theta k := Nat.le_floor <| (le_div_iff₀ hθ'pos).2 <|
    le_of_mul_le_mul_right (by linarith [hq.trans hsize]) (pow_pos hN0 (k + 1))
  choose P hPG using fun i => (hG i).2
  refine ⟨J, hJ, fun j => if h : j.val < q then P ⟨j, h⟩ else ClassPiece.empty C _ _ _ _ _ _,
    fun z hz => ?_⟩
  obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.mp (hcov hz)
  refine Finset.mem_biUnion.mpr ⟨⟨i, i.isLt.trans_le hqm⟩, Finset.mem_univ _, ?_⟩
  simpa [i.isLt, hPG i] using hi

/-! ### The cover of the next class -/

/-- **Any `n` relations covered by step pieces have one cover**, for any class. -/
theorem class_step_cover_gen_fejer (C : UniformClassWith k Thr Cnt Exp) (hk : 1 ≤ k)
    (hCnt : ∀ theta gamma n s, 0 < theta → theta ≤ 1 → 0 < gamma → gamma ≤ 1 → 0 < s → s ≤ 1 →
      1 ≤ Cnt theta gamma n s)
    (hExp : ∀ theta gamma n s, 0 < theta → theta ≤ 1 → 0 < gamma → gamma ≤ 1 → 0 < s → s ≤ 1 →
      0 < Exp theta gamma n s ∧ Exp theta gamma n s ≤ 1)
    (hCntMono : ∀ theta gamma s, 0 < theta → theta ≤ 1 → 0 < gamma → gamma ≤ 1 → 0 ≤ s →
      Monotone fun n => Cnt theta gamma n s)
    (hExpAnti : ∀ theta gamma s, 0 < theta → theta ≤ 1 → 0 < gamma → gamma ≤ 1 → 0 < s →
      Antitone fun n => Exp theta gamma n s)
    {A Bq : Nat → Real} (hA : ∀ q, 0 < A q) (hB : ∀ q, 0 < Bq q)
    (hlemma6 : AbstractFamilyLemma166At k (section16PowerWidth A Bq))
    {theta gamma : Real} (ht : 0 < theta) (ht1 : theta ≤ 1) (hg : 0 < gamma) (hg1 : gamma ≤ 1)
    {N : Nat} [NeZero N] [Fact N.Prime] {n : Nat}
    (Gamma : Fin n → Finset (Point N (k + 1) × ZMod N))
    (P : Fin n → Fin (classPiecesFejer gamma theta k) → StepPieceFejer C N theta gamma)
    (hP : ∀ i, Gamma i ⊆ stepPieceFejerGraphs C (P i)) :
    let M := n * classPiecesFejer gamma theta k
    let tS := classBudgetW (fejerThetaOne theta gamma k) k
    let gS := section16Delta (fejerThetaOne theta gamma k)
    MultiplyLinearWith
      (fun rho => max (famPieceGraphBound (clsQr Cnt k M tS gamma) (clsPb Cnt M tS gamma) M rho)
        ((3 ^ (k + 1) * M : Nat) : Real))
      (fun rho => section16CappedWidthExponent
        (pieceLineExponent Bq (Cnt tS gS M) (Exp tS gS M) (clsEr Exp k M tS gamma) rho *
          famPieceSliceExponent (clsQr Cnt k M tS gamma) (clsEs Exp M tS gamma) M rho / 4)
        (section16RoundedPowerThreshold
          (pieceWidthScale A (Cnt tS gS M) (tightZeta (fejerThetaOne theta gamma k / 4)) rho)
          (pieceLineExponent Bq (Cnt tS gS M) (Exp tS gS M) (clsEr Exp k M tS gamma) rho)
          (famPieceSliceExponent (clsQr Cnt k M tS gamma) (clsEs Exp M tS gamma) M rho)))
      (Finset.univ.biUnion Gamma) := by
  obtain ⟨h0, h1⟩ := fejerThetaOne_bounds k ht ht1 hg hg1
  obtain ⟨htS, htS1⟩ := classBudgetW_pos_le k h0 h1
  obtain ⟨-, -, hgS, hgS1⟩ := section16_theta_delta_bounds_with h0 h1
  obtain ⟨hz, hzHalf⟩ := tightZeta_pos_le_half h0 (by linarith)
  refine (class_piece_family_cover_gen hk C hCnt hExp hCntMono hExpAnti hA hB hlemma6 hz hzHalf
    htS htS1 hgS hgS1 htS htS1 hg hg1 fun c =>
      P (finProdFinEquiv.symm c).1 (finProdFinEquiv.symm c).2).subset fun z hz' => ?_
  obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.mp hz'
  obtain ⟨c, -, hc⟩ := Finset.mem_biUnion.mp (hP i hi)
  exact Finset.mem_biUnion.mpr ⟨finProdFinEquiv (i, c), Finset.mem_univ _, by simpa using hc⟩

end LeanProofs.GowersSzemeredi
