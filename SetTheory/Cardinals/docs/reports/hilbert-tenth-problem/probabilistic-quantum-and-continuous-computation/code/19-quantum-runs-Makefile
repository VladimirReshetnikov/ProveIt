.PHONY: all pdf check clean
all: check pdf

pdf:
	pdflatex -interaction=nonstopmode -halt-on-error article.tex
	pdflatex -interaction=nonstopmode -halt-on-error article.tex
	pdflatex -interaction=nonstopmode -halt-on-error article.tex

check:
	python code/run_checks.py
	python code/verify_certificate.py examples/coherent_qubit_all_moments_certificate.json

clean:
	rm -f article.aux article.log article.out article.toc article.fdb_latexmk article.fls
	rm -rf code/__pycache__
