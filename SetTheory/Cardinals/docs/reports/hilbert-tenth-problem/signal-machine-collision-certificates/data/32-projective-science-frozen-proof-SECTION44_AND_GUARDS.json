{
  "coordinates": [
    "D",
    "x",
    "y"
  ],
  "initial": "L and Q0 at 0 outgoing; stationary X at x, Y at y, R at D",
  "parameter": "v rational >1",
  "guards": [
    "x>0",
    "y-x>0",
    "D-y>0",
    "3*v*D+(1-4*v)*y>0"
  ],
  "r": "(v+2)/(3*v)",
  "return": [
    [
      "1",
      "0",
      "-(v-1)/v"
    ],
    [
      "0",
      "r",
      "0"
    ],
    [
      "0",
      "0",
      "r"
    ]
  ],
  "infinite_validity": "0<x<y<D and D>=3*y/2",
  "zeno": "0<x<y<D and D=3*y/2",
  "non_zeno_valid": "0<x<y<D and D>3*y/2"
}
