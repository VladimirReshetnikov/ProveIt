PYTHON ?= python3
LATEX ?= pdflatex

.PHONY: all pdf test example clean
all: test pdf

pdf:
	$(LATEX) -interaction=nonstopmode -halt-on-error article.tex
	$(LATEX) -interaction=nonstopmode -halt-on-error article.tex
	$(LATEX) -interaction=nonstopmode -halt-on-error article.tex

test:
	$(PYTHON) code/test_certificates.py
	$(PYTHON) code/test_linear_memory.py

example:
	$(PYTHON) code/canonical_memory.py artifacts/example/events.json artifacts/rebuilt_example --expanded
	$(PYTHON) code/linear_memory.py artifacts/example/events.json artifacts/rebuilt_linear_example --expanded

clean:
	rm -f article.aux article.log article.out article.toc article.fls article.fdb_latexmk
	rm -rf code/__pycache__
