00: N(N(x,N(N(y,x),x)),N(y,N(z,x))) = y
01: d = N(d,N(d,d))
02: V(P(x,s),d) = x
03: V(P(x,s),A(j,d)) = V(s,j)
04: p_eps(s,P(a,b)) = N(p_eps(s,a),p_eps(s,b))
05: p_eps(s,A(i,j)) = p_E(V(s,i),V(s,j))
06: p_eps(s,Q(a)) = p_eps(P(W(s,a),s),a)
07: d = N(p_eps(P(z,s),a),N(d,p_eps(s,Q(a))))
08: d = N(N(d,p_G(b)),N(d,p_eps(P(Next(b,z),P(Target(b),b)),V(b,d))))
09: d = N(N(d,p_G(b)),N(d,p_E(Mem(b,z),Next(b,z))))
10: d = N(N(d,p_G(b)),p_E(Mem(b,z),z))
11: d = N(p_G(b),N(d,N(N(d,p_E(W(x,d),x)),N(d,N(p_eps(P(y,P(x,b)),V(b,d)),N(d,p_E(y,Target(b))))))))
12: d = N(p_G(b),N(d,N(p_E(x,Target(b)),N(d,N(p_eps(P(y,P(x,b)),V(b,d)),N(d,p_E(y,Target(b))))))))
13: d = N(p_G(b),N(d,N(p_E(y,Target(b)),N(d,p_eps(P(y,P(Next(b,y),b)),V(b,d))))))
