00: N(N(x,N(N(y,x),x)),N(y,N(z,x))) = y
01: top = N(d,N(d,d))
02: V(P(x,s),d) = x
03: V(P(x,s),A(j,d)) = V(s,j)
04: p_eps(s,J(a,b)) = N(p_eps(s,a),p_eps(s,b))
05: p_eps(s,A(i,j)) = p_E(V(s,i),V(s,j))
06: p_eps(s,Q(a)) = p_eps(P(W(s,a),s),a)
07: top = N(p_eps(P(z,s),a),N(top,p_eps(s,Q(a))))
08: top = N(N(top,p_G(b)),N(top,p_eps(P(Next(b,z),P(Target(b),b)),V(b,d))))
09: top = N(N(top,p_G(b)),N(top,p_E(Mem(b,z),Next(b,z))))
10: top = N(N(top,p_G(b)),p_E(Mem(b,z),z))
11: top = N(p_G(b),N(top,N(N(top,p_E(Pick(x),x)),N(top,N(p_eps(P(y,P(x,b)),V(b,d)),N(top,p_E(y,Target(b))))))))
12: top = N(p_G(b),N(top,N(p_E(x,Target(b)),N(top,N(p_eps(P(y,P(x,b)),V(b,d)),N(top,p_E(y,Target(b))))))))
13: top = N(p_G(b),N(top,N(p_E(y,Target(b)),N(top,p_eps(P(y,P(Next(b,y),b)),V(b,d))))))
