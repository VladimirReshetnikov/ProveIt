TEX_SOURCES := report.tex $(wildcard sections/*.tex)

.PHONY: all check full-check clean
all: report.pdf

report.pdf: $(TEX_SOURCES) figures/sparse_history.pdf
	pdflatex -interaction=nonstopmode -halt-on-error report.tex
	pdflatex -interaction=nonstopmode -halt-on-error report.tex
	pdflatex -interaction=nonstopmode -halt-on-error report.tex

figures/sparse_history.pdf: code/make_figure.py data/sparse_checker_tests.json
	python3 code/make_figure.py

check:
	python3 reproduce.py

full-check:
	python3 reproduce.py --full-searches

clean:
	rm -f report.aux report.log report.out report.toc
