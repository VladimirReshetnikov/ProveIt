.PHONY: all report verify extended clean

all: report

report:
	pdflatex -interaction=nonstopmode -halt-on-error zfc_fused_transport.tex
	pdflatex -interaction=nonstopmode -halt-on-error zfc_fused_transport.tex
	pdflatex -interaction=nonstopmode -halt-on-error zfc_fused_transport.tex

verify:
	python3 -B reproduce.py

extended:
	python3 -B reproduce.py --extended

clean:
	rm -f zfc_fused_transport.aux zfc_fused_transport.log zfc_fused_transport.out zfc_fused_transport.toc
