.PHONY: all pdf check clean

all: check pdf

pdf:
	pdflatex -interaction=nonstopmode -halt-on-error article.tex
	pdflatex -interaction=nonstopmode -halt-on-error article.tex

check:
	python3 code/verify.py --max-n 200 --bfs-max-n 11 > data/console.txt
	python3 code/independent_check.py > data/independent_console.txt

clean:
	rm -f article.aux article.log article.out article.toc
