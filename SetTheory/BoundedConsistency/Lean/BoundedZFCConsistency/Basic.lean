import FirstOrder.Completeness
import ZF.Zf

/-!
# Quantifier-group-bounded derivations over the language of set theory

This file fixes a polarity-aware syntactic meaning of "at most `n` quantifier
groups" for the formulas of `FirstOrder.Fol` and applies it to the
natural-deduction calculus of `FirstOrder.Calculus`.

`sigmaRank` and `piRank` are the least levels generated by the usual
hierarchy rules, read off the parse tree without first passing to prenex
normal form.  Conjunction and disjunction take componentwise maxima.  In an
implication the antecedent changes polarity.  A universal quantifier preserves
the Pi side and costs one extra level on the Sigma side; an existential does
the dual.  `quantifierGroups` is the smaller of the two ranks.  So an
existential formula and a universal formula can each have rank one, while
their conjunction normally has rank two.  This is a parse-tree rank, not a
theorem asserting that some prenex-normalization procedure was carried out.

## Relation to the Levy hierarchy

The formula type here has no primitive bounded quantifier: `fAll` and `fEx`
are the only binders, and a set-theoretic bounded quantifier `∀ x ∈ y` is the
derived form `fAll (fImp (fMem 0 (y+1)) …)`, whose `fAll` this rank charges in
full.  The rank is therefore strictly *finer* than the Levy hierarchy
`Sigma_n`/`Pi_n` of set theory, which counts bounded quantifiers as
level-preserving.  Every Levy-`Sigma_n` formula written with bounded
quantifiers has some rank here, but usually a larger one, and `Delta_0`
formulas need not have rank zero.

The consequence is honest and worth stating: each restricted provability
notion `RestrictedProv n`, and hence each consistency statement one could
later build from it, is correspondingly *weaker* than the Levy-indexed
statement of the same name would be.  What the family retains is the property
that actually matters for the bounded-consistency programme — for a fixed
derivation the rank is a concrete natural number, so every derivation is
restricted at some bound (`restrictedProv_cofinal`), and the family of
restricted relations exhausts ordinary provability as `n` grows.

## Where the bound is imposed

The restriction is imposed at *every judgement node* of a derivation,
including its displayed context and every formula-valued rule parameter.
Restricting only the final formula would say nothing about a contradiction:
`fBot` has rank zero, so conclusion-only restricted consistency is
definitionally ordinary consistency.  `conclusionRestrictedProv_bot_iff`
records that collapse formally.

Nothing in this file asserts, or presupposes, consistency of any set theory.
Unlike arithmetic, ZFC has no standard model available inside Lean, so the
external soundness argument that settles the arithmetical case has no
counterpart here; any consistency statement must be conditional and is left
to a separate module.
-/

namespace LeanProofs
namespace BoundedZFCConsistency

open SetTheory

/-! ## Polarity-aware formula ranks -/

mutual
  /-- Least Sigma-hierarchy level generated compositionally with `piRank`. -/
  def sigmaRank : Form → Nat
    | .fMem _ _ => 0
    | .fEq _ _ => 0
    | .fBot => 0
    | .fImp a b => Nat.max (piRank a) (sigmaRank b)
    | .fAnd a b => Nat.max (sigmaRank a) (sigmaRank b)
    | .fOr a b => Nat.max (sigmaRank a) (sigmaRank b)
    | .fAll a => Nat.max 1 (piRank a) + 1
    | .fEx a => Nat.max 1 (sigmaRank a)

  /-- Least Pi-hierarchy level generated compositionally with `sigmaRank`. -/
  def piRank : Form → Nat
    | .fMem _ _ => 0
    | .fEq _ _ => 0
    | .fBot => 0
    | .fImp a b => Nat.max (sigmaRank a) (piRank b)
    | .fAnd a b => Nat.max (piRank a) (piRank b)
    | .fOr a b => Nat.max (piRank a) (piRank b)
    | .fAll a => Nat.max 1 (piRank a)
    | .fEx a => Nat.max 1 (sigmaRank a) + 1
end

/-- The least of the generated Sigma and Pi levels. -/
def quantifierGroups (phi : Form) : Nat :=
  Nat.min (sigmaRank phi) (piRank phi)

/-- A formula lies below the externally fixed hierarchy bound `n`. -/
def QuantifierBounded (n : Nat) (phi : Form) : Prop :=
  quantifierGroups phi ≤ n

/-- Renaming preserves both polarity ranks simultaneously.  Packaging the two
equalities together gives the induction hypotheses needed at implication and
at the two quantifiers, where Sigma and Pi refer to each other.

The signature of set theory is purely relational, so quantifier instantiation
in the calculus is a renaming rather than a term substitution.  This single
invariance statement therefore covers every rule that moves under a binder;
there is no separate substitution lemma to prove. -/
theorem hierarchyRanks_rename (r : Nat → Nat) (phi : Form) :
    sigmaRank (rename r phi) = sigmaRank phi ∧
      piRank (rename r phi) = piRank phi := by
  induction phi generalizing r with
  | fMem i j => simp [rename, sigmaRank, piRank]
  | fEq i j => simp [rename, sigmaRank, piRank]
  | fBot => simp [rename, sigmaRank, piRank]
  | fImp a b iha ihb =>
      obtain ⟨haSigma, haPi⟩ := iha r
      obtain ⟨hbSigma, hbPi⟩ := ihb r
      simp [rename, sigmaRank, piRank, haSigma, haPi, hbSigma, hbPi]
  | fAnd a b iha ihb =>
      obtain ⟨haSigma, haPi⟩ := iha r
      obtain ⟨hbSigma, hbPi⟩ := ihb r
      simp [rename, sigmaRank, piRank, haSigma, haPi, hbSigma, hbPi]
  | fOr a b iha ihb =>
      obtain ⟨haSigma, haPi⟩ := iha r
      obtain ⟨hbSigma, hbPi⟩ := ihb r
      simp [rename, sigmaRank, piRank, haSigma, haPi, hbSigma, hbPi]
  | fAll a ih =>
      obtain ⟨haSigma, haPi⟩ := ih (SetTheory.up r)
      simp [rename, sigmaRank, piRank, haPi]
  | fEx a ih =>
      obtain ⟨haSigma, haPi⟩ := ih (SetTheory.up r)
      simp [rename, sigmaRank, piRank, haSigma]

@[simp] theorem sigmaRank_rename (r : Nat → Nat) (phi : Form) :
    sigmaRank (rename r phi) = sigmaRank phi :=
  (hierarchyRanks_rename r phi).1

@[simp] theorem piRank_rename (r : Nat → Nat) (phi : Form) :
    piRank (rename r phi) = piRank phi :=
  (hierarchyRanks_rename r phi).2

@[simp] theorem quantifierGroups_rename (r : Nat → Nat) (phi : Form) :
    quantifierGroups (rename r phi) = quantifierGroups phi := by
  simp [quantifierGroups]

@[simp] theorem quantifierBounded_rename_iff (n : Nat) (r : Nat → Nat)
    (phi : Form) :
    QuantifierBounded n (rename r phi) ↔ QuantifierBounded n phi := by
  simp [QuantifierBounded]

@[simp] theorem quantifierGroups_bot :
    quantifierGroups Form.fBot = 0 := rfl

@[simp] theorem quantifierBounded_bot (n : Nat) :
    QuantifierBounded n Form.fBot := by
  simp [QuantifierBounded]

theorem quantifierBounded_mono {m n : Nat} (hmn : m ≤ n) {phi : Form}
    (hphi : QuantifierBounded m phi) : QuantifierBounded n phi :=
  Nat.le_trans hphi hmn

/- Small reductions pin down the hierarchy convention. -/

/-- A quantifier-free atom, used only to exhibit the rank convention. -/
def rankAtom : Form := .fEq 0 0

theorem quantifierGroups_existential_atom :
    quantifierGroups (.fEx rankAtom) = 1 := rfl

theorem quantifierGroups_universal_atom :
    quantifierGroups (.fAll rankAtom) = 1 := rfl

theorem quantifierGroups_mixed_branches :
    quantifierGroups (.fAnd (.fEx rankAtom) (.fAll rankAtom)) = 2 := rfl

theorem quantifierGroups_implication_polarity :
    quantifierGroups (.fImp (.fEx rankAtom) (.fAll rankAtom)) = 1 := rfl

/-- A membership atom guarded by a universal quantifier — the shape a bounded
quantifier `∀ x ∈ y` unfolds to — already has rank one, whereas the Levy
hierarchy would leave it at level zero.  This is the concrete witness of the
discrepancy described in the module header. -/
theorem quantifierGroups_bounded_shape :
    quantifierGroups (.fAll (.fImp (.fMem 0 1) (.fMem 0 2))) = 1 := rfl

/-! ## Every-occurrence proof bounds -/

/-- Maximum hierarchy rank displayed in a proof context. -/
def contextRank : List Form → Nat
  | [] => 0
  | phi :: G => Nat.max (quantifierGroups phi) (contextRank G)

/-- Maximum of a node's ambient context and its explicit formula annotations. -/
def nodeRank (G annotations : List Form) : Nat :=
  Nat.max (contextRank G) (contextRank annotations)

/-- A data-carrying mirror of `SetTheory.Prov`.

The library derivation relation lives in `Prop`.  Proof irrelevance therefore
prevents a faithful numeric recursion over its proof shape: two derivations of
the same judgement are indistinguishable as indices.  `ProvTree` lives in
`Type`, retains exactly the same seventeen rules with the same indices, and
can consequently be inspected to enforce an every-occurrence complexity
bound. -/
inductive ProvTree : List Form → Form → Type
  | ass : ∀ G a, a ∈ G → ProvTree G a
  | impI : ∀ G a b, ProvTree (a :: G) b → ProvTree G (.fImp a b)
  | impE : ∀ G a b, ProvTree G (.fImp a b) → ProvTree G a → ProvTree G b
  | botE : ∀ G a, ProvTree G .fBot → ProvTree G a
  | lem : ∀ G a, ProvTree G (.fOr a (.fImp a .fBot))
  | andI : ∀ G a b, ProvTree G a → ProvTree G b → ProvTree G (.fAnd a b)
  | andE1 : ∀ G a b, ProvTree G (.fAnd a b) → ProvTree G a
  | andE2 : ∀ G a b, ProvTree G (.fAnd a b) → ProvTree G b
  | orI1 : ∀ G a b, ProvTree G a → ProvTree G (.fOr a b)
  | orI2 : ∀ G a b, ProvTree G b → ProvTree G (.fOr a b)
  | orE : ∀ G a b c, ProvTree G (.fOr a b) → ProvTree (a :: G) c →
      ProvTree (b :: G) c → ProvTree G c
  | allI : ∀ G a, ProvTree (G.map (rename Nat.succ)) a → ProvTree G (.fAll a)
  | allE : ∀ G a k, ProvTree G (.fAll a) → ProvTree G (rename (inst k) a)
  | exI : ∀ G a k, ProvTree G (rename (inst k) a) → ProvTree G (.fEx a)
  | exE : ∀ G a c, ProvTree G (.fEx a) →
      ProvTree (a :: G.map (rename Nat.succ)) (rename Nat.succ c) →
      ProvTree G c
  | eqRefl : ∀ G k, ProvTree G (.fEq k k)
  | eqElim : ∀ G i j a, ProvTree G (.fEq i j) →
      ProvTree G (rename (inst i) a) → ProvTree G (rename (inst j) a)

namespace ProvTree

/-- Forget the data-carrying tree and recover the library derivation. -/
theorem erase : {G : List Form} → {phi : Form} → ProvTree G phi → Prov G phi
  | _, _, .ass G a membership => .P_ass G a membership
  | _, _, .impI G a b premise => .P_impI G a b premise.erase
  | _, _, .impE G a b major minor => .P_impE G a b major.erase minor.erase
  | _, _, .botE G a premise => .P_botE G a premise.erase
  | _, _, .lem G a => .P_lem G a
  | _, _, .andI G a b left right => .P_andI G a b left.erase right.erase
  | _, _, .andE1 G a b premise => .P_andE1 G a b premise.erase
  | _, _, .andE2 G a b premise => .P_andE2 G a b premise.erase
  | _, _, .orI1 G a b premise => .P_orI1 G a b premise.erase
  | _, _, .orI2 G a b premise => .P_orI2 G a b premise.erase
  | _, _, .orE G a b c disjunction left right =>
      .P_orE G a b c disjunction.erase left.erase right.erase
  | _, _, .allI G a premise => .P_allI G a premise.erase
  | _, _, .allE G a k premise => .P_allE G a k premise.erase
  | _, _, .exI G a k premise => .P_exI G a k premise.erase
  | _, _, .exE G a c existential body =>
      .P_exE G a c existential.erase body.erase
  | _, _, .eqRefl G k => .P_eqRefl G k
  | _, _, .eqElim G i j a equality instanceProof =>
      .P_eqElim G i j a equality.erase instanceProof.erase

/-- Maximum rank of every context, conclusion, rule annotation, and premise
subtree in a data-carrying derivation.

At each node the annotation list contains the conclusion together with every
formula-valued parameter of the rule, including the ones that occur only in a
premise judgement (the discharged hypothesis of an implication introduction,
the two disjuncts of a case split, the quantified matrix, the shifted body of
an existential elimination, and the Leibniz property of equality
elimination).  Each premise contributes its own occurrence rank, which in turn
covers its context; hence the number really does dominate every formula
occurrence in the whole tree. -/
def occurrenceRank : {G : List Form} → {phi : Form} → ProvTree G phi → Nat
  | _, _, .ass G a _ => nodeRank G [a]
  | _, _, .impI G a b premise =>
      Nat.max (nodeRank G [.fImp a b, a, b]) premise.occurrenceRank
  | _, _, .impE G a b major minor =>
      Nat.max (nodeRank G [b, a, .fImp a b])
        (Nat.max major.occurrenceRank minor.occurrenceRank)
  | _, _, .botE G a premise =>
      Nat.max (nodeRank G [a, .fBot]) premise.occurrenceRank
  | _, _, .lem G a => nodeRank G [.fOr a (.fImp a .fBot), a]
  | _, _, .andI G a b left right =>
      Nat.max (nodeRank G [.fAnd a b, a, b])
        (Nat.max left.occurrenceRank right.occurrenceRank)
  | _, _, .andE1 G a b premise =>
      Nat.max (nodeRank G [a, b, .fAnd a b]) premise.occurrenceRank
  | _, _, .andE2 G a b premise =>
      Nat.max (nodeRank G [b, a, .fAnd a b]) premise.occurrenceRank
  | _, _, .orI1 G a b premise =>
      Nat.max (nodeRank G [.fOr a b, a, b]) premise.occurrenceRank
  | _, _, .orI2 G a b premise =>
      Nat.max (nodeRank G [.fOr a b, a, b]) premise.occurrenceRank
  | _, _, .orE G a b c disjunction left right =>
      Nat.max (nodeRank G [c, a, b, .fOr a b])
        (Nat.max disjunction.occurrenceRank
          (Nat.max left.occurrenceRank right.occurrenceRank))
  | _, _, .allI G a premise =>
      Nat.max (nodeRank G [.fAll a, a]) premise.occurrenceRank
  | _, _, .allE G a k premise =>
      Nat.max (nodeRank G [rename (inst k) a, .fAll a, a])
        premise.occurrenceRank
  | _, _, .exI G a k premise =>
      Nat.max (nodeRank G [.fEx a, rename (inst k) a, a])
        premise.occurrenceRank
  | _, _, .exE G a c existential body =>
      Nat.max (nodeRank G [c, .fEx a, a, rename Nat.succ c])
        (Nat.max existential.occurrenceRank body.occurrenceRank)
  | _, _, .eqRefl G k => nodeRank G [.fEq k k]
  | _, _, .eqElim G i j a equality instanceProof =>
      Nat.max (nodeRank G [rename (inst j) a, .fEq i j, rename (inst i) a, a])
        (Nat.max equality.occurrenceRank instanceProof.occurrenceRank)

end ProvTree

/-- Public unnamespaced spelling of the every-occurrence rank. -/
def proofOccurrenceRank {G : List Form} {phi : Form}
    (proof : ProvTree G phi) : Nat :=
  proof.occurrenceRank

/-- Public erasure spelling. -/
theorem eraseProvTree {G : List Form} {phi : Form}
    (proof : ProvTree G phi) : Prov G phi :=
  proof.erase

/-- Every library derivation has a data-carrying representative.  The result
is `Nonempty` because eliminating a `Prop`-valued derivation into `Type` would
violate proof irrelevance, while eliminating it into this proposition is
sound. -/
theorem provTree_complete {G : List Form} {phi : Form} (proof : Prov G phi) :
    Nonempty (ProvTree G phi) := by
  induction proof with
  | P_ass G a membership => exact ⟨.ass G a membership⟩
  | P_impI G a b _ ih =>
      rcases ih with ⟨premise⟩
      exact ⟨.impI G a b premise⟩
  | P_impE G a b _ _ ihMajor ihMinor =>
      rcases ihMajor with ⟨major⟩
      rcases ihMinor with ⟨minor⟩
      exact ⟨.impE G a b major minor⟩
  | P_botE G a _ ih =>
      rcases ih with ⟨premise⟩
      exact ⟨.botE G a premise⟩
  | P_lem G a => exact ⟨.lem G a⟩
  | P_andI G a b _ _ ihLeft ihRight =>
      rcases ihLeft with ⟨left⟩
      rcases ihRight with ⟨right⟩
      exact ⟨.andI G a b left right⟩
  | P_andE1 G a b _ ih =>
      rcases ih with ⟨premise⟩
      exact ⟨.andE1 G a b premise⟩
  | P_andE2 G a b _ ih =>
      rcases ih with ⟨premise⟩
      exact ⟨.andE2 G a b premise⟩
  | P_orI1 G a b _ ih =>
      rcases ih with ⟨premise⟩
      exact ⟨.orI1 G a b premise⟩
  | P_orI2 G a b _ ih =>
      rcases ih with ⟨premise⟩
      exact ⟨.orI2 G a b premise⟩
  | P_orE G a b c _ _ _ ihDisjunction ihLeft ihRight =>
      rcases ihDisjunction with ⟨disjunction⟩
      rcases ihLeft with ⟨left⟩
      rcases ihRight with ⟨right⟩
      exact ⟨.orE G a b c disjunction left right⟩
  | P_allI G a _ ih =>
      rcases ih with ⟨premise⟩
      exact ⟨.allI G a premise⟩
  | P_allE G a k _ ih =>
      rcases ih with ⟨premise⟩
      exact ⟨.allE G a k premise⟩
  | P_exI G a k _ ih =>
      rcases ih with ⟨premise⟩
      exact ⟨.exI G a k premise⟩
  | P_exE G a c _ _ ihExistential ihBody =>
      rcases ihExistential with ⟨existential⟩
      rcases ihBody with ⟨body⟩
      exact ⟨.exE G a c existential body⟩
  | P_eqRefl G k => exact ⟨.eqRefl G k⟩
  | P_eqElim G i j a _ _ ihEquality ihInstance =>
      rcases ihEquality with ⟨equality⟩
      rcases ihInstance with ⟨instanceProof⟩
      exact ⟨.eqElim G i j a equality instanceProof⟩

/-! ## Restricted provability -/

/-- Every formula occurrence in a concrete proof tree respects `n`. -/
def ProofAllBounded {G : List Form} {phi : Form} (n : Nat)
    (proof : ProvTree G phi) : Prop :=
  proofOccurrenceRank proof ≤ n

/-- There is a derivation all of whose formula occurrences have at most `n`
quantifier groups.  The bound `n` is meta-theoretical. -/
def RestrictedProv (n : Nat) (G : List Form) (phi : Form) : Prop :=
  ∃ proof : ProvTree G phi, ProofAllBounded n proof

/-- Theory-relative restricted provability.  A finite list selects the
background axioms used, exactly as in `SetTheory.BProv`; instantiating `B` at
`ZFax` or at the sealed sentence theory `ZFax_s` gives the two standard
presentations of ZF used in this repository. -/
def RestrictedBProv (n : Nat) (B : Form → Prop) (G : List Form)
    (phi : Form) : Prop :=
  ∃ L : List Form, (∀ x, x ∈ L → B x) ∧ RestrictedProv n (L ++ G) phi

/-- Erase the proof-tree complexity certificate. -/
theorem restrictedProv_erase {n : Nat} {G : List Form} {phi : Form}
    (h : RestrictedProv n G phi) : Prov G phi :=
  h.choose.erase

/-- Erasing a restricted relative proof yields an ordinary relative proof. -/
theorem restrictedBProv_erase {n : Nat} {B : Form → Prop} {G : List Form}
    {phi : Form} (h : RestrictedBProv n B G phi) : BProv B G phi := by
  rcases h with ⟨L, hL, proof, _⟩
  exact ⟨L, hL, proof.erase⟩

theorem proofAllBounded_mono {m n : Nat} (hmn : m ≤ n) {G : List Form}
    {phi : Form} {proof : ProvTree G phi} (hproof : ProofAllBounded m proof) :
    ProofAllBounded n proof :=
  Nat.le_trans hproof hmn

theorem restrictedProv_mono {m n : Nat} (hmn : m ≤ n) {G : List Form}
    {phi : Form} (h : RestrictedProv m G phi) : RestrictedProv n G phi := by
  rcases h with ⟨proof, hproof⟩
  exact ⟨proof, proofAllBounded_mono hmn hproof⟩

theorem restrictedBProv_mono {m n : Nat} (hmn : m ≤ n) {B : Form → Prop}
    {G : List Form} {phi : Form} (h : RestrictedBProv m B G phi) :
    RestrictedBProv n B G phi := by
  rcases h with ⟨L, hL, hproof⟩
  exact ⟨L, hL, restrictedProv_mono hmn hproof⟩

/-- Every finite ordinary derivation has some external hierarchy bound.  This
is a metatheorem about the datatypes: the bound is read off a concrete tree
and is not uniform in the derivation. -/
theorem restrictedProv_cofinal {G : List Form} {phi : Form}
    (proof : Prov G phi) : ∃ n : Nat, RestrictedProv n G phi := by
  rcases provTree_complete proof with ⟨tree⟩
  exact ⟨tree.occurrenceRank, tree, Nat.le_refl _⟩

/-- Every finite theory-relative derivation has some external bound as well. -/
theorem restrictedBProv_cofinal {B : Form → Prop} {G : List Form}
    {phi : Form} (h : BProv B G phi) :
    ∃ n : Nat, RestrictedBProv n B G phi := by
  rcases h with ⟨L, hL, proof⟩
  rcases restrictedProv_cofinal proof with ⟨n, hrestricted⟩
  exact ⟨n, L, hL, hrestricted⟩

/-! ## Why the restriction must cover the proof -/

/-- The deliberately inadequate restriction which inspects only the final
formula of a bare derivation. -/
def ConclusionRestrictedProv (n : Nat) (G : List Form) (phi : Form) : Prop :=
  Prov G phi ∧ QuantifierBounded n phi

/-- The conclusion-only version of theory-relative provability. -/
def ConclusionRestrictedBProv (n : Nat) (B : Form → Prop) (G : List Form)
    (phi : Form) : Prop :=
  BProv B G phi ∧ QuantifierBounded n phi

/-- Since falsity has no quantifiers, bounding only the conclusion does not
weaken a claim that falsity is derivable. -/
theorem conclusionRestrictedProv_bot_iff (n : Nat) (G : List Form) :
    ConclusionRestrictedProv n G Form.fBot ↔ Prov G Form.fBot := by
  simp [ConclusionRestrictedProv]

/-- The same collapse for proofs relative to an arbitrary background theory. -/
theorem conclusionRestrictedBProv_bot_iff (n : Nat) (B : Form → Prop)
    (G : List Form) :
    ConclusionRestrictedBProv n B G Form.fBot ↔ BProv B G Form.fBot := by
  simp [ConclusionRestrictedBProv]

/-! ## The ZF instantiation

These definitions only specialize the background axiom predicate.  They record
that restricted ZF derivations really are ZF derivations, and that the
restricted family exhausts `ZFprov`; no consistency claim is made or implied,
and none is available externally, since Lean has no standard model of ZF.
-/

/-- Restricted provability from the open ZF axioms, matching the shape of
`SetTheory.ZFprov`. -/
def RestrictedZFprov (n : Nat) (phi : Form) : Prop :=
  RestrictedBProv n ZFax [] phi

/-- A restricted ZF derivation erases to an ordinary one. -/
theorem restrictedZFprov_erase {n : Nat} {phi : Form}
    (h : RestrictedZFprov n phi) : ZFprov phi := by
  rcases h with ⟨L, hL, proof, _⟩
  refine ⟨L, hL, ?_⟩
  simpa using proof.erase

theorem restrictedZFprov_mono {m n : Nat} (hmn : m ≤ n) {phi : Form}
    (h : RestrictedZFprov m phi) : RestrictedZFprov n phi :=
  restrictedBProv_mono hmn h

/-- Every ZF derivation is restricted at some external bound. -/
theorem restrictedZFprov_cofinal {phi : Form} (h : ZFprov phi) :
    ∃ n : Nat, RestrictedZFprov n phi := by
  rcases h with ⟨G, hG, hp⟩
  have hp' : Prov (G ++ []) phi := by simpa using hp
  rcases restrictedProv_cofinal hp' with ⟨n, hn⟩
  exact ⟨n, G, hG, hn⟩

end BoundedZFCConsistency
end LeanProofs
