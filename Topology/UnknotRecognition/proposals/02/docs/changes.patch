-    boundary: dict = defaultdict(set)
-    for pair in a:
-        p = next(iter(pair))
-        boundary[_dsu_find(parent, ('L', ab[p]))].add(ac[p])
-    for pair in c:
-        p = next(iter(pair))
-        boundary[_dsu_find(parent, ('R', bc[p]))].add(ac[p])
