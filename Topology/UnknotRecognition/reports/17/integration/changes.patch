+        result = PIPELINE.recognize(knotted, jones_backend="potts-exact", **FORCE_FILTER)
+        self.assertEqual((result.status, result.method), ("KNOTTED", "jones-potts-exact"))
+        self.assertEqual(result.evidence["jones"]["q"], 6)
