+
+    def test_mirrors_shading_and_unknot_examples(self):
+        for name in ("hard_unknot_8", "grid_scrambled_unknot", "unknot_braid40", "unknot"):
+            diagram = Diagram.from_json(json.loads((EXAMPLES / (name + ".json")).read_text()))
