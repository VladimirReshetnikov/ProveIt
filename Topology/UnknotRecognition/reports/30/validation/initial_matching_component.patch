+            return None
+        a.tick()
+        a.stats['lcs_near_prefix_queries'] = a.stats.get('lcs_near_prefix_queries', 0)+1
+        head = self.small_interval(x, 0, count-1)
+        tail_start = max(0, prefix-count)
