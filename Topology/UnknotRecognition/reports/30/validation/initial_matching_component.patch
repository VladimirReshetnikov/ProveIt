+    def small_interval(self, node, start, stop):
+        """Read only a caller-bounded seed or tail, without expanding its root."""
+        a, result = self.arena, []
+        pending = [(node, start, stop)]
+        while pending:
+            a.tick()
+            current, lo, hi = pending.pop()
+            if lo == hi:
+                continue
+            rule = a.rules[current]
+            if rule[0] == 't':
+                result.append(rule[1])
+                continue
+            left, right = rule[1:]
+            cut = a.lengths[left]
+            if hi > cut:
+                pending.append((right, max(0, lo-cut), hi-cut))
+            if lo < cut:
+                pending.append((left, lo, min(hi, cut)))
+        a.stats['lcs_seed_letters'] = a.stats.get('lcs_seed_letters', 0)+len(result)
+        return result
+
+    def periodic_prefix(self, root, pattern):
+        """Exact LCP with an infinite periodic word, by a cycle automaton.
+
+        A state is (grammar node, phase modulo len(pattern)); its value is
+        the matching prefix length. There are at most g*len(pattern) states.
+        The caller supplies a short explicit pattern, never a large expansion.
+        """
+        if not pattern:
+            raise ValueError('periodic pattern must be nonempty')
+        a, period, done = self.arena, len(pattern), {}
+        pending = [(root, 0)]
+        while pending:
+            a.tick()
+            node, phase = pending[-1]
+            key = node, phase
+            if key in done:
+                pending.pop()
+                continue
+            if not node:
+                value = 0
+            else:
+                rule = a.rules[node]
+                if rule[0] == 't':
+                    value = int(rule[1] == pattern[phase])
+                else:
+                    left, right = rule[1:]
+                    first = left, phase
+                    if first not in done:
+                        pending.append(first)
+                        continue
+                    value = done[first]
+                    if value == a.lengths[left]:
+                        second = right, (phase+a.lengths[left]) % period
+                        if second not in done:
+                            pending.append(second)
+                            continue
+                        value += done[second]
+            if len(done) >= a.max_nodes:
+                raise CompressedLimit('compressed-LCS periodic state allowance exhausted')
+            done[key] = value
+            pending.pop()
+        a.stats['lcs_periodic_states'] = a.stats.get('lcs_periodic_states', 0)+len(done)
+        return done[root, 0]
+
+    def near_prefix(self, x, y, prefix, limit, max_alignments=32):
