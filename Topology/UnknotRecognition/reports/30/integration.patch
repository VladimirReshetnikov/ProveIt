+                # One reflection orbit has at most two points.  It therefore
+                # restricts the root to at most two *values*, not 2^q branches.
+                sign, offset, y, shift = reflections[0]
+                candidates = set()
+                for image in (y, (shift-y) % n):
+                    constraint = _linear_congruence(
