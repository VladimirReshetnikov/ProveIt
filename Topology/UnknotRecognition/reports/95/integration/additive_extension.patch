diff --git a/Topology/UnknotRecognition/fast/fastunknot/column_peeling.py b/Topology/UnknotRecognition/fast/fastunknot/column_peeling.py
new file mode 100644
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/column_peeling.py
@@ -0,0 +1,109 @@
+"""Complete full-row positive cancellation by immutable column peeling.
+
+This module decides one precisely delimited incidence problem.  A permitted
+positive pivot has entry one, deletes its row and column, and updates surviving
+entries by A[i,h] + A[i,c] * A[r,h].  The question is whether every source row
+can be removed.  No free reduction or signed algebraic cancellation is allowed.
+
+The rectangular criterion is the transpose/empty-seed consequence of the
+source-closure theorem in ProveIt report 56.  It is not a general handlebody
+recognizer: a geometric application must authenticate the incidence matrix.
+"""
+
+from collections import deque
+
+
+SCHEMA = 'full-row-column-peeling-v1'
+
+
+def column_peeling_plan(counts, *, check=lambda: None):
+    """Return a complete decision and a sparse replay certificate.
+
+    ``counts`` maps nonnegative integer row IDs to dictionaries of nonnegative
+    integer column IDs and nonnegative integer occurrence counts.  Boolean
+    labels/counts are rejected.  Rows with no positive entries are retained.
+    Large counts are capped at two because only geometric multiplicities zero,
+    one and at least two matter to the singleton predicate.
+
+    A row is deleted when some column has exactly one occurrence among all
+    currently live rows.  This pivot adds no surviving entries.  Queuing each
+    column when its total first becomes one makes incidence processing linear.
+    Pivot order depends on source dictionary order; the residual row set is
+    independent of that order and of every legal column-peeling choice.
+
+    ``OBSTRUCTED`` means that no positive-pivot sequence removes all rows.  It
+    does not mean that no individual pivot is available, that the output is a
+    maximum partial cancellation, or that a topological object is nontrivial.
+    """
+    check()
+    if type(counts) is not dict:
+        raise ValueError('occurrence counts must be a dictionary')
+    row_ids = []
+    source_rows = []
+    totals = {}
+    row_xors = {}
+    source_entries = 0
+    nonzero_entries = 0
+    for r, values in counts.items():
+        check()
+        if type(r) is not int or r < 0 or type(values) is not dict:
+            raise ValueError('invalid occurrence row')
+        index = len(row_ids)
+        row_ids.append(r)
+        row = {}
+        for c, value in values.items():
+            check()
+            source_entries += 1
+            if type(c) is not int or c < 0 or type(value) is not int or value < 0:
+                raise ValueError('invalid occurrence entry')
+            if value:
+                value = min(2, value)
+                row[c] = value
+                totals[c] = totals.get(c, 0) + value
+                row_xors[c] = row_xors.get(c, 0) ^ index
+                nonzero_entries += 1
+        source_rows.append(row)
+
+    queue = deque(c for c, total in totals.items() if total == 1)
+    queue_pushes = len(queue)
+    queue_pops = 0
+    visits = 0
+    live = [True] * len(row_ids)
+    eliminations = []
+    while queue:
+        check()
+        c = queue.popleft()
+        queue_pops += 1
+        if totals[c] != 1:
+            continue
+        index = row_xors[c]
+        # A total of one identifies exactly one live source occurrence.  The
+        # xor is therefore its dense row index, including the valid index 0.
+        if not live[index] or source_rows[index].get(c, 0) != 1:
+            raise AssertionError('column counter invariant failed')
+        live[index] = False
+        eliminations.append([row_ids[index], c])
+        for h, value in source_rows[index].items():
+            check()
+            visits += 1
+            totals[h] -= value
+            row_xors[h] ^= index
+            if totals[h] == 1:
+                queue.append(h)
+                queue_pushes += 1
+
+    remaining = sorted(row_ids[i] for i, active in enumerate(live) if active)
+    certificate = dict(schema=SCHEMA, eliminations=eliminations,
+                       residual_rows=remaining)
+    check()
+    return dict(status='OBSTRUCTED' if remaining else 'COMPLETE',
+                cancellations=eliminations, remaining_rows=remaining,
+                certificate=certificate,
+                stats=dict(source_rows=len(row_ids),
+                           active_source_columns=len(totals),
+                           source_entries=source_entries,
+                           nonzero_entries=nonzero_entries,
+                           removal_incidence_visits=visits,
+                           queue_pushes=queue_pushes,
+                           queue_pops=queue_pops,
+                           entry_updates=0))
diff --git a/Topology/UnknotRecognition/fast/fastunknot/column_peeling_verify.py b/Topology/UnknotRecognition/fast/fastunknot/column_peeling_verify.py
new file mode 100644
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/column_peeling_verify.py
@@ -0,0 +1,110 @@
+"""Independent immutable verification of column-peeling certificates.
+
+This checker imports no producer function and does not maintain its counters,
+xors, queue, or mutable matrix.  Deletion timestamps verify every proposed
+column leaf in one source scan.  A second assertion in the same scan verifies
+that the residual rows form a stopping set.
+"""
+
+
+def verify_column_peeling_certificate(counts, certificate, *, check=lambda: None):
+    """Verify a complete peeling trace and its canonical residual set.
+
+    Return ``False`` for malformed or false certificates.  Caller callback
+    exceptions propagate.  A nonempty verified residual proves impossibility
+    of cancelling every row by the positive-pivot model, conditional on the
+    supplied occurrence matrix being the intended authenticated source.
+    """
+    check()
+    if type(counts) is not dict or type(certificate) is not dict:
+        return False
+    if set(certificate) != {'schema', 'eliminations', 'residual_rows'}:
+        return False
+    if certificate['schema'] != 'full-row-column-peeling-v1':
+        return False
+    moves = certificate['eliminations']
+    residual = certificate['residual_rows']
+    if type(moves) is not list or type(residual) is not list:
+        return False
+    if any(type(r) is not int or r < 0 for r in counts):
+        return False
+    if any(type(r) is not int or r < 0 for r in residual):
+        return False
+    if residual != sorted(set(residual)):
+        return False
+
+    removed_at = {}
+    pivot_of = {}
+    for time, move in enumerate(moves):
+        check()
+        if type(move) is not list or len(move) != 2:
+            return False
+        r, c = move
+        if type(r) is not int or type(c) is not int or r < 0 or c < 0:
+            return False
+        if r not in counts or r in removed_at or c in pivot_of:
+            return False
+        removed_at[r] = time
+        pivot_of[c] = (r, time)
+    if set(residual) != set(counts) - set(removed_at):
+        return False
+
+    witnessed = set()
+    residual_totals = {}
+    for r, row in counts.items():
+        check()
+        if type(row) is not dict:
+            return False
+        for c, value in row.items():
+            check()
+            if type(c) is not int or c < 0 or type(value) is not int or value < 0:
+                return False
+            if not value:
+                continue
+            if c in pivot_of:
+                donor, time = pivot_of[c]
+                if r == donor:
+                    if value != 1:
+                        return False
+                    witnessed.add(c)
+                elif r not in removed_at or removed_at[r] >= time:
+                    return False
+            if r not in removed_at:
+                residual_totals[c] = min(2, residual_totals.get(c, 0) + value)
+    if witnessed != set(pivot_of):
+        return False
+    if any(total == 1 for total in residual_totals.values()):
+        return False
+    check()
+    return True
+
+
+def verify_column_obstruction(counts, residual_rows, *, check=lambda: None):
+    """Check a nonempty stopping subset without claiming it is maximal.
+
+    This smaller certificate suffices for a negative answer to *full-row raw
+    cancellation*.  It is intentionally not a negative topological verdict.
+    """
+    check()
+    if type(counts) is not dict or type(residual_rows) is not list:
+        return False
+    if not residual_rows or any(type(r) is not int or r < 0 for r in residual_rows):
+        return False
+    if len(set(residual_rows)) != len(residual_rows):
+        return False
+    selected = set(residual_rows)
+    if not selected <= set(counts):
+        return False
+    totals = {}
+    for r, row in counts.items():
+        check()
+        if type(r) is not int or r < 0 or type(row) is not dict:
+            return False
+        for c, value in row.items():
+            check()
+            if type(c) is not int or c < 0 or type(value) is not int or value < 0:
+                return False
+            if r in selected and value:
+                totals[c] = min(2, totals.get(c, 0) + value)
+    check()
+    return not any(total == 1 for total in totals.values())
diff --git a/Topology/UnknotRecognition/fast/fastunknot/normal_cut_saturation.py b/Topology/UnknotRecognition/fast/fastunknot/normal_cut_saturation.py
new file mode 100644
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/normal_cut_saturation.py
@@ -0,0 +1,147 @@
+"""Source-certified whole-cut censuses through relative bundle incidence.
+
+This opt-in research operator consumes the pinned fastunknot source geometry.
+It never returns an unknot or a non-handlebody verdict.  COMPLETE is a proved
+handlebody genus census.  A certified raw obstruction is INCONCLUSIVE for
+topology and only rules out full cancellation in the stated positive model.
+"""
+
+from .normal_parallelity import normal_cut_parallelity
+from .parallelity_boundary_words import normal_parallelity_boundary_words
+
+from .column_peeling import column_peeling_plan
+from .relative_bundles import (compile_relative_bundles,
+                              census_after_complete_cancellation)
+
+
+def _original_core_model(core, check):
+    """Compile the fixed original-core forest and unsigned source incidences.
+
+    The source parallelity operator authenticates these charts.  This local
+    finite compiler has no bundle-boundary dependency and creates no new
+    geometric incidences.  Forest order agrees with the relative compiler.
+    """
+    vertices, edges, discs = [core['handles' + str(i)] for i in range(3)]
+    if any(type(h['id']) is not int or h['id'] != i
+           for handles in (vertices, edges, discs) for i, h in enumerate(handles)):
+        raise ValueError('noncanonical original-core handles')
+    parent = list(range(len(vertices)))
+
+    def root(v):
+        while parent[v] != v:
+            parent[v] = parent[parent[v]]
+            v = parent[v]
+        return v
+
+    forest = []
+    for handle in edges:
+        check()
+        a, b = handle['ends']
+        if any(type(v) is not int or not 0 <= v < len(vertices) for v in (a, b)):
+            raise ValueError('invalid original-core one-handle ends')
+        x, y = root(a), root(b)
+        if x != y:
+            parent[max(x, y)] = min(x, y)
+            forest.append(handle['id'])
+    tree = set(forest)
+    counts = {}
+    for disc in discs:
+        check()
+        row = {}
+        for flag in disc['cycle']:
+            if flag['dimension'] == 1 and flag['handle'] not in tree:
+                column = flag['handle']
+                row[column] = min(2, row.get(column, 0) + 1)
+        counts[disc['id']] = row
+    proof = dict(forest=forest,
+                 rows=[dict(id=r, counts=[[c, v] for c, v in sorted(row.items())])
+                       for r, row in sorted(counts.items())])
+    return counts, proof
+
+
+def normal_cut_saturation(triangulation, coordinates, *, max_cycles=None,
+                          record_certificate=False, precheck_core=False,
+                          check=lambda: None):
+    """Classify a supplied normal cut, including saturated bordered bundles.
+
+    Up to six upstream orbit discoveries share one optional cycle allowance.
+    Genus and normal-coordinate magnitudes remain binary encoded.  Resource
+    exhaustion, closed bundle bases, core three-handles, and positive-model
+    obstructions have no negative topological meaning.
+
+    ``precheck_core=True`` first checks the original core rows after the four
+    source parallelity queries.  An original-core stopping set remains a
+    stopping set after appending relative bundle rows.  It therefore permits
+    a certified INCONCLUSIVE return before the two ordered-boundary queries.
+    The default False preserves the original operator and certificate schema.
+    """
+    check()
+    if type(record_certificate) is not bool:
+        raise ValueError('record_certificate must be bool')
+    if type(precheck_core) is not bool:
+        raise ValueError('precheck_core must be bool')
+    if max_cycles is not None and (type(max_cycles) is not int or max_cycles < 0):
+        raise ValueError('max_cycles must be a nonnegative integer or None')
+    result = dict(status='INCONCLUSIVE', stats={},
+                  trust='whole supplied cut; no standalone knot verdict')
+    parallelity = normal_cut_parallelity(
+        triangulation, coordinates, max_cycles=max_cycles,
+        record_certificate=record_certificate, check=check)
+    result['stats']['parallelity'] = parallelity.get('stats', {})
+    if parallelity['status'] != 'COMPLETE':
+        return dict(result, reason='parallelity_budget_exhausted')
+    if parallelity['geometry']['core']['handles3']:
+        return dict(result, reason='core_has_three_handles')
+    if any(p['boundary_components'] == 0
+           for p in parallelity['summary']['base_profiles']):
+        return dict(result, reason='closed_bundle_base')
+    if precheck_core:
+        core_counts, core_proof = _original_core_model(parallelity['geometry']['core'], check)
+        core_peeling = column_peeling_plan(core_counts, check=check)
+        result['stats']['core_precheck'] = core_peeling['stats']
+        if core_peeling['status'] == 'OBSTRUCTED':
+            conclusion = dict(status='INCONCLUSIVE', reason='original_core_raw_obstruction',
+                              remaining_two_handles=core_peeling['remaining_rows'])
+            result.update(conclusion)
+            result['stats']['avoided_boundary_queries'] = (
+                2 if parallelity['geometry']['ports'] else 0)
+            if record_certificate:
+                result['certificate'] = dict(
+                    schema='normal-cut-core-obstruction-v1',
+                    parallelity=parallelity['certificate'], core=core_proof,
+                    peeling=core_peeling['certificate'], conclusion=conclusion)
+            check()
+            return result
+    remaining = max_cycles
+    if remaining is not None:
+        remaining -= sum(s['orbit_cycles'] for s in parallelity['stats'].values())
+    boundary = normal_parallelity_boundary_words(
+        triangulation, coordinates, max_cycles=remaining,
+        record_certificate=record_certificate, check=check)
+    result['stats']['boundary'] = boundary.get('stats', {})
+    if boundary['status'] != 'COMPLETE':
+        return dict(result, reason='boundary_budget_exhausted')
+    model = compile_relative_bundles(
+        parallelity['geometry'], parallelity['summary'], boundary['skeleton'],
+        check=check)
+    if model['status'] != 'READY':
+        return dict(result, reason=model['reason'])
+    result['stats']['relative'] = model['stats']
+    peeling = column_peeling_plan(model['counts'], check=check)
+    result['stats']['peeling'] = peeling['stats']
+    if peeling['status'] == 'COMPLETE':
+        census = census_after_complete_cancellation(model, check=check)
+        conclusion = dict(status='COMPLETE', census=census)
+    else:
+        conclusion = dict(status='INCONCLUSIVE',
+                          reason='full_raw_cancellation_obstructed',
+                          remaining_two_handles=peeling['remaining_rows'])
+    result.update(conclusion)
+    if record_certificate:
+        result['certificate'] = dict(
+            schema='normal-cut-saturated-bundles-v1',
+            parallelity=parallelity['certificate'], boundary=boundary['certificate'],
+            relative=model['certificate'], peeling=peeling['certificate'],
+            conclusion=conclusion)
+    check()
+    return result
diff --git a/Topology/UnknotRecognition/fast/fastunknot/normal_cut_saturation_verify.py b/Topology/UnknotRecognition/fast/fastunknot/normal_cut_saturation_verify.py
new file mode 100644
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/normal_cut_saturation_verify.py
@@ -0,0 +1,230 @@
+"""Producer-independent replay of whole-cut relative bundle certificates.
+
+True authenticates the exact conclusion in the certificate.  In particular,
+an INCONCLUSIVE conclusion with a stopping core is not a non-handlebody proof.
+The verifier imports neither the relative compiler nor the peeling producer.
+"""
+
+from collections import Counter
+
+from .integer_codec import encoded_integer, certificate_equal
+from .normal_parallelity_verify import verify_normal_cut_parallelity
+from .parallelity_boundary_words_verify import verify_parallelity_boundary_words
+
+from .column_peeling_verify import verify_column_peeling_certificate
+from .relative_bundles_verify import replay_relative_bundle_compilation
+
+
+class _CallbackFailure(Exception):
+    def __init__(self, original):
+        self.original = original
+
+
+def _decode(value):
+    if isinstance(value, dict):
+        return {key: _decode(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [_decode(item) for item in value]
+    if isinstance(value, str) and value.lower().lstrip('+-').startswith('0x'):
+        return encoded_integer(value)
+    return value
+
+
+def _orbit_operations(parallelity, boundary=None):
+    total = 0
+    for name in ('vertex_selector', 'boundary_selector', 'polygon_weights', 'fibre_cover'):
+        proof = parallelity[name]
+        if name.endswith('selector'):
+            proof = proof['weighted_certificate']
+        total += len(proof['orbit_proof']['operations'])
+    if boundary is not None:
+        for name in ('vertex_partition', 'gap_cover'):
+            proof = boundary[name]
+            if proof is not None:
+                total += len(proof['orbit_proof']['operations'])
+    return total
+
+
+def _independent_original_core(core, proof, check):
+    """Rebuild source incidences and the deterministic forest without a producer.
+
+    Connectivity search on previously selected forest edges deliberately
+    replaces the producer's disjoint-set algorithm.  Raw alternating source
+    cycles are checked and read directly; asserted occurrence counts are not
+    trusted.  The source geometry itself has already passed upstream replay.
+    """
+    if type(proof) is not dict or set(proof) != {'forest', 'rows'}:
+        return None
+    vertices, edges, discs = [core['handles' + str(i)] for i in range(3)]
+    if any(type(h['id']) is not int or h['id'] != i
+           for handles in (vertices, edges, discs) for i, h in enumerate(handles)):
+        return None
+    adjacency = {v: set() for v in range(len(vertices))}
+    forest = []
+    for e, handle in enumerate(edges):
+        check()
+        a, b = handle['ends']
+        if any(type(v) is not int or not 0 <= v < len(vertices) for v in (a, b)):
+            return None
+        todo, seen = [a], set()
+        while todo:
+            check()
+            current = todo.pop()
+            if current in seen:
+                continue
+            seen.add(current)
+            todo.extend(adjacency[current] - seen)
+        if b not in seen:
+            forest.append(e)
+            adjacency[a].add(b)
+            adjacency[b].add(a)
+    if not certificate_equal(proof['forest'], forest):
+        return None
+    tree = set(forest)
+    matrix = {}
+    for r, handle in enumerate(discs):
+        check()
+        cycle = handle['cycle']
+        if type(cycle) is not list or not cycle or len(cycle) % 2:
+            return None
+        row = {}
+        for j in range(0, len(cycle), 2):
+            check()
+            point, crossing = cycle[j], cycle[j + 1]
+            if point['dimension'] != 0 or crossing['dimension'] != 1:
+                return None
+            v, e = point['handle'], crossing['handle']
+            following = cycle[(j + 2) % len(cycle)]['handle']
+            if any(type(x) is not int for x in (v, e, following)):
+                return None
+            if not (0 <= v < len(vertices) and 0 <= following < len(vertices)
+                    and 0 <= e < len(edges)):
+                return None
+            if sorted((v, following)) != sorted(edges[e]['ends']):
+                return None
+            if e not in tree:
+                row[e] = min(2, row.get(e, 0) + 1)
+        matrix[r] = row
+    expected = [dict(id=r, counts=[[c, v] for c, v in sorted(row.items())])
+                for r, row in sorted(matrix.items())]
+    if not certificate_equal(proof['rows'], expected):
+        return None
+    return matrix
+
+
+def _replay_core_obstruction(triangulation, coordinates, certificate, max_operations, check):
+    fields = {'schema', 'parallelity', 'core', 'peeling', 'conclusion'}
+    if set(certificate) != fields:
+        return False
+    p = certificate['parallelity']
+    if type(p) is not dict:
+        return False
+    if max_operations is not None and _orbit_operations(p) > max_operations:
+        return False
+    if not verify_normal_cut_parallelity(triangulation, coordinates, p, check=check):
+        return False
+    geometry, summary = _decode(p['geometry']), _decode(p['summary'])
+    if geometry['core']['handles3']:
+        return False
+    if any(profile['boundary_components'] == 0 for profile in summary['base_profiles']):
+        return False
+    counts = _independent_original_core(geometry['core'], _decode(certificate['core']), check)
+    if counts is None:
+        return False
+    peeling = _decode(certificate['peeling'])
+    if not verify_column_peeling_certificate(counts, peeling, check=check):
+        return False
+    residual = peeling['residual_rows']
+    if not residual:
+        return False
+    expected = dict(status='INCONCLUSIVE', reason='original_core_raw_obstruction',
+                    remaining_two_handles=residual)
+    check()
+    return certificate_equal(certificate['conclusion'], expected)
+
+
+def _replay(triangulation, coordinates, certificate, max_operations, check):
+    if type(certificate) is not dict:
+        return False
+    if certificate.get('schema') == 'normal-cut-core-obstruction-v1':
+        return _replay_core_obstruction(
+            triangulation, coordinates, certificate, max_operations, check)
+    fields = {'schema', 'parallelity', 'boundary', 'relative', 'peeling', 'conclusion'}
+    if type(certificate) is not dict or set(certificate) != fields:
+        return False
+    if certificate['schema'] != 'normal-cut-saturated-bundles-v1':
+        return False
+    p, b = certificate['parallelity'], certificate['boundary']
+    if type(p) is not dict or type(b) is not dict:
+        return False
+    if max_operations is not None and _orbit_operations(p, b) > max_operations:
+        return False
+    if not verify_normal_cut_parallelity(triangulation, coordinates, p, check=check):
+        return False
+    if not verify_parallelity_boundary_words(triangulation, coordinates, b, check=check):
+        return False
+    geometry, summary, skeleton = _decode(p['geometry']), _decode(p['summary']), _decode(b['skeleton'])
+    model = replay_relative_bundle_compilation(
+        geometry, summary, skeleton, _decode(certificate['relative']), check=check)
+    if model is None:
+        return False
+    peeling = _decode(certificate['peeling'])
+    if not verify_column_peeling_certificate(model['counts'], peeling, check=check):
+        return False
+    residual = peeling['residual_rows']
+    if residual:
+        expected = dict(status='INCONCLUSIVE', reason='full_raw_cancellation_obstructed',
+                        remaining_two_handles=residual)
+    else:
+        histogram = Counter()
+        for component in model['joined_components']:
+            check()
+            rank = len(component['active_one_handles']) + component['private_one_handles']
+            genus = rank - len(component['two_handle_rows'])
+            if genus < 0:
+                return False
+            histogram[genus] += 1
+        for bundle in model['isolated_bundles']:
+            check()
+            if bundle['genus'] < 0 or bundle['multiplicity'] <= 0:
+                return False
+            histogram[bundle['genus']] += bundle['multiplicity']
+        euler = sum((1 - genus) * copies for genus, copies in histogram.items())
+        if euler != model['certificate']['source_euler_characteristic']:
+            return False
+        census = dict(histogram=[dict(genus=g, multiplicity=m)
+                                 for g, m in sorted(histogram.items())],
+                      components=sum(histogram.values()), ball_components=histogram.get(0, 0),
+                      all_balls=all(g == 0 for g in histogram), euler_characteristic=euler)
+        expected = dict(status='COMPLETE', census=census)
+    check()
+    return certificate_equal(certificate['conclusion'], expected)
+
+
+def verify_normal_cut_saturation(triangulation, coordinates, certificate, *,
+                                  max_operations=None, check=lambda: None):
+    """Authenticate source, relative bands, cancellation, and the stated result.
+
+    The optional early core-obstruction schema replays four source traces and
+    no ordered-boundary query.  The ordinary schema also authenticates the two
+    boundary-query slots when present; zero-port sources have no such traces.
+    max_operations caps total supplied orbit-trace operations.  It is not a
+    hard time or memory limit on the source verifier or on malformed input.
+    All caller callback exceptions propagate with their original type.
+    """
+    check()
+    if max_operations is not None and (type(max_operations) is not int or max_operations < 0):
+        raise ValueError('max_operations must be a nonnegative integer or None')
+
+    def guarded_check():
+        try:
+            check()
+        except BaseException as exc:
+            raise _CallbackFailure(exc) from exc
+
+    try:
+        return _replay(triangulation, coordinates, certificate, max_operations, guarded_check)
+    except _CallbackFailure as failure:
+        raise failure.original.with_traceback(failure.original.__traceback__)
+    except (KeyError, IndexError, TypeError, ValueError, ArithmeticError, AttributeError):
+        return False
