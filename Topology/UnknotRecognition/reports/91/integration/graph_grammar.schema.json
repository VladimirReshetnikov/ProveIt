{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProveIt edge-owned graph grammar v1",
  "type": "object",
  "required": [
    "schema",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "proveit.graph-grammar.v1"
    },
    "root": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/leaf"
          },
          {
            "$ref": "#/$defs/join"
          },
          {
            "$ref": "#/$defs/map"
          }
        ]
      }
    }
  },
  "$defs": {
    "leaf": {
      "type": "object",
      "required": [
        "kind",
        "vertices",
        "edges",
        "terminals"
      ],
      "properties": {
        "kind": {
          "const": "leaf"
        },
        "vertices": {
          "type": "integer",
          "minimum": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "minItems": 3,
            "maxItems": 3
          }
        },
        "terminals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "isolated_vertices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      }
    },
    "join": {
      "type": "object",
      "required": [
        "kind",
        "left",
        "right",
        "left_map",
        "right_map",
        "terminals"
      ],
      "properties": {
        "kind": {
          "const": "join"
        },
        "left": {
          "type": "integer",
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "minimum": 0
        },
        "left_map": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "right_map": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "terminals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      }
    },
    "map": {
      "type": "object",
      "required": [
        "kind",
        "child",
        "mapping",
        "terminals"
      ],
      "properties": {
        "kind": {
          "const": "map"
        },
        "child": {
          "type": "integer",
          "minimum": 0
        },
        "mapping": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "terminals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      }
    }
  }
}
