+                              ('quadrilaterals', [0, 0, 0])):
+            bad = deepcopy(positive)
+            bad[field] = value
+            self.assertFalse(verify_sector_euler_certificate(raw, bad))
+        bad = deepcopy(positive)
+        bad['coordinates'][0][0] += 1
+        self.assertFalse(verify_sector_euler_certificate(raw, bad))
+        bad = deepcopy(negative)
