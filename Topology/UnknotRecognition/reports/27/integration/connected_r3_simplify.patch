From: Report 25 causal-branch prototype
Subject: [PATCH] add opt-in birth-front RIII unlock search
Base-commit: 23893144e3aafd074a23cfb633222ab7e03e6d2e
Target-blob: Topology/UnknotRecognition/fast/fastunknot/simplify.py
Target-blob-sha1: 2fcaabb51eaa45cf84bdee32cd1b4e18acf2c478

This patch is intentionally opt-in.  It preserves the current `last` search as
its default and adds `clustered`, whose `r3_births=1` mode searches all moves
meeting the accumulated RIII footprint instead of only the last move's local
neighbourhood.  Values above one admit a bounded number of independent birth
branches in the birth-front normal form proved in the accompanying article.

The new helper file is supplied separately as `clustered_r3_snippet.py`; copy it
to `fast/fastunknot/clustered_r3.py` before applying this edit.

--- a/Topology/UnknotRecognition/fast/fastunknot/simplify.py
+++ b/Topology/UnknotRecognition/fast/fastunknot/simplify.py
@@
-def simplify(diagram: Diagram, r3: bool = True, check_faces: bool = True,
-             r3_depth: int = 4, r3_budget: int | None = 10) -> tuple[Diagram, list[Move]]:
+def simplify(diagram: Diagram, r3: bool = True, check_faces: bool = True,
+             r3_depth: int = 4, r3_budget: int | None = 10,
+             r3_search: str = "last", r3_births: int = 1) -> tuple[Diagram, list[Move]]:
@@
     if type(r3_depth) is not int or r3_depth < 1:
         raise ValueError("r3_depth must be a positive integer")
+    if r3_search not in {"last", "clustered"}:
+        raise ValueError("r3_search must be 'last' or 'clustered'")
+    if type(r3_births) is not int or r3_births < 1:
+        raise ValueError("r3_births must be a positive integer")
@@
         for depth in range(1, r3_depth + 1):
             path: list = []
-            found = _unlock(state, depth, range(4 * len(state.alive)), None, path, check_faces)
+            if r3_search == "clustered":
+                # Lazy import: applying this opt-in patch must not add dataclass
+                # or module-import cost to the maintained default path.
+                from .clustered_r3 import search_clustered_unlock
+                found = search_clustered_unlock(
+                    state,
+                    depth,
+                    max_births=r3_births,
+                    check_faces=check_faces,
+                    path=path,
+                )
+            else:
+                found = _unlock(
+                    state,
+                    depth,
+                    range(4 * len(state.alive)),
+                    None,
+                    path,
+                    check_faces,
+                )
             if found is not None:
                 trace.extend(Move("R3", tuple(sorted(x // 4 for x in triangle))) for triangle in path)
                 stack = found
                 break
