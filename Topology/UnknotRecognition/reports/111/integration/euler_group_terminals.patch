+
+def normal_cut_handlebodies(triangulation, coordinates, *, max_cycles=None,
+                           record_certificate=False, precheck_core=True, boundary_method='masks',
+                           top_forest='max_weight', group_fallback=False, check=lambda: None):
+    """Run geometric cancellation, optionally followed by an Euler/group terminal.
+
+    The optional fallback preserves every geometric success.  Its accepted
+    census is unmarked and uses the complete source cut, a verified free-group
+    certificate, and the exact Euler check.  It does not produce a geometric
+    cancellation schedule or a marked successor map.  The two stages each
+    receive max_cycles, so the enabled portfolio has at most twice that orbit
+    discovery allowance.  Cooperative callbacks cover both stages.
+    """
+    if type(group_fallback) is not bool:
+        raise ValueError('group_fallback must be bool')
+    result = _geometric_cut_handlebodies(triangulation, coordinates,
+        max_cycles=max_cycles, record_certificate=record_certificate,
+        precheck_core=precheck_core, boundary_method=boundary_method,
+        top_forest=top_forest, check=check)
+    if not group_fallback or result['status'] == 'COMPLETE':
+        return result
+    from .normal_cut_groups import normal_cut_group_handlebodies
+    alternative = normal_cut_group_handlebodies(triangulation, coordinates,
+        max_cycles=max_cycles, record_certificate=record_certificate, check=check)
+    alternative['stats']['geometric_attempt'] = result['stats']
+    alternative['stats']['geometric_reason'] = result.get('reason')
+    return alternative
