+    def test_no_false_rejection_on_short_closed_braids(self):
+        from fastunknot.recognize import recognize
+        checked, hits = 0, 0
+        for length in (2, 4, 6):
+            for word in product((1, -1, 2, -2), repeat=length):
+                if length == 6 and word[0:2] not in ((1, 2), (-1, -2)):
+                    continue
+                try:
