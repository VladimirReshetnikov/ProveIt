diff --git a/Topology/UnknotRecognition/fast/fastunknot/source_core_dual.py b/Topology/UnknotRecognition/fast/fastunknot/source_core_dual.py
new file mode 100644
index 0000000000000000000000000000000000000000..a503276985925d3e775243cd6b7490669bd3f144
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/source_core_dual.py
@@ -0,0 +1,108 @@
+"""Cancel native core 2/3 pairs using the actual endpoint incidence graph.
+
+The input is a source-authenticated parallelity geometry, not an arbitrary
+boundary matrix.  Interior vertex link triangles identify the 3-handles.  An
+interior edge gap of weight zero has both original endpoint caps; a positive
+weight extreme gap has one original cap and one exposed normal-surface cap.
+The exposed boundary is one formal root.  Its rooted spanning tree specifies
+geometric 2/3 cancellations while leaving the remaining 0/1 charts and their
+exposed port labels available to the existing finite boundary kernel.
+"""
+
+from collections import deque
+
+
+_EDGES = ((0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3))
+_DISJOINT_QUAD = (0, 1, 2, 2, 1, 0)
+
+
+def source_core_dual_graph(geometry, *, check=lambda: None):
+    """Return occurrence-level dual edges; -1 denotes exposed boundary.
+
+    The edge number in the authenticated source is its signed union-find root.
+    It is therefore a local representative with orientation parity zero.  This
+    fact determines which original endpoint belongs to rank zero, including
+    loop edges whose two global vertices happen to coincide.  No normal sheet
+    or parallelity-base instance is expanded.
+    """
+    check()
+    core, rows = geometry['core'], geometry['coordinates']
+    owner = [-1] * (4 * len(rows))
+    flag_visits = 0
+    for h in core['handles3']:
+        check()
+        for t, v in h['link_triangles']:
+            check()
+            owner[4*t + v] = h['id']
+            flag_visits += 1
+    edges = []
+    for h in core['handles2']:
+        check()
+        t, slot = divmod(h['edge'], 6)
+        a, b = _EDGES[slot]
+        row = rows[t]
+        weight = row[a] + row[b] + sum(row[4:]) - row[4 + _DISJOINT_QUAD[slot]]
+        left, right = owner[4*t + a], owner[4*t + b]
+        if weight == 0:
+            if h['rank'] != 0:
+                raise ArithmeticError('zero-weight core gap has nonzero rank')
+        elif h['rank'] == 0:
+            right = -1
+        elif h['rank'] == weight:
+            left = -1
+        else:
+            raise ArithmeticError('a native core gap is not an extreme edge gap')
+        edges.append(dict(two_handle=h['id'], ends=[left, right]))
+    return dict(three_handles=len(core['handles3']), boundary_root=-1, edges=edges,
+                stats=dict(vertex_flag_visits=flag_visits,
+                           dual_edge_visits=len(edges)))
+
+
+def source_core_dual_reduction(geometry, *, check=lambda: None):
+    """Compile one rooted forest and delete its 2-handles and all 3-handles.
+
+    Return (reduced_geometry, certificate, statistics), or None if a dual
+    component cannot reach exposed boundary.  The latter is conservative;
+    it is not a non-handlebody verdict.  A connected finite torus-boundary
+    source satisfies root reachability, but the explicit check is retained.
+    """
+    check()
+    graph = source_core_dual_graph(geometry, check=check)
+    n = graph['three_handles']
+    # Python's -1 index is the last slot, reserved for the boundary root.
+    adjacent = [[] for _ in range(n + 1)]
+    for edge in graph['edges']:
+        check()
+        a, b = edge['ends']
+        adjacent[a].append((b, edge['two_handle']))
+        adjacent[b].append((a, edge['two_handle']))
+    reached = [False] * (n + 1)
+    reached[-1] = True
+    reached_count, queue, picked = 1, deque([-1]), []
+    visits = 0
+    while queue:
+        check()
+        a = queue.popleft()
+        for b, e in adjacent[a]:
+            check()
+            visits += 1
+            if not reached[b]:
+                reached[b] = True
+                reached_count += 1
+                queue.append(b)
+                picked.append(e)
+    if reached_count != n + 1:
+        return None
+    old = geometry['core']
+    removed = [False] * len(old['handles2'])
+    for e in picked:
+        removed[e] = True
+    kept = [h for h in old['handles2'] if not removed[h['id']]]
+    reduced = dict(geometry, core=dict(old, handles3=[],
+        handles2=[dict(h, id=i) for i, h in enumerate(kept)]))
+    proof = dict(schema='source-core-dual-forest-v1', forest=picked)
+    statistics = dict(graph['stats'], adjacency_visits=visits,
+                      removed_three_handles=n, removed_two_handles=len(picked),
+                      retained_two_handles=len(kept))
+    check()
+    return reduced, proof, statistics
diff --git a/Topology/UnknotRecognition/fast/fastunknot/source_core_dual_verify.py b/Topology/UnknotRecognition/fast/fastunknot/source_core_dual_verify.py
new file mode 100644
index 0000000000000000000000000000000000000000..bef23afa38f9a57a047fd068b8c1b1a08ead5b3f
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/source_core_dual_verify.py
@@ -0,0 +1,98 @@
+"""Independent replay of source geometric dual 2/3 cancellation forests.
+
+Source and geometry authentication belongs to normal_parallelity_verify.
+This checker reconstructs cap occurrences and imports no forest producer.
+It does not infer cap incidence from signed algebraic boundary coefficients.
+"""
+
+from .integer_codec import encoded_integer
+
+
+def replay_source_core_dual(geometry, certificate, *, check=lambda: None):
+    """Return the reduced chart on success and None for a malformed proof."""
+    check()
+    if (type(certificate) is not dict or set(certificate) != {'schema', 'forest'}
+            or certificate['schema'] != 'source-core-dual-forest-v1'
+            or type(certificate['forest']) is not list):
+        return None
+    selected = []
+    for value in certificate['forest']:
+        try:
+            selected.append(encoded_integer(value))
+        except ValueError:
+            return None
+    core, coordinates = geometry['core'], geometry['coordinates']
+    three, two = core['handles3'], core['handles2']
+    n, m = len(three), len(two)
+    if len(selected) != n:
+        return None
+    if any(e < 0 or e >= m for e in selected):
+        return None
+    locations = [n] * (4 * len(coordinates))
+    for i, handle in enumerate(three):
+        check()
+        if type(handle['id']) is not int or handle['id'] != i:
+            return None
+        for t, corner in handle['link_triangles']:
+            check()
+            if (type(t) is not int or type(corner) is not int or
+                    not 0 <= t < len(coordinates) or not 0 <= corner < 4 or
+                    locations[4*t + corner] != n):
+                return None
+            locations[4*t + corner] = i
+    for i, handle in enumerate(two):
+        check()
+        if type(handle['id']) is not int or handle['id'] != i:
+            return None
+
+    parent = list(range(n + 1))
+    sizes = [1] * (n + 1)
+
+    def find(v):
+        while parent[v] != v:
+            parent[v] = parent[parent[v]]
+            v = parent[v]
+        return v
+
+    # n is the exposed-boundary root in this independent replay.  Source edge
+    # roots are local representatives of parity zero, so their smaller local
+    # endpoint is rank zero even when the global edge is a loop.
+    representatives = ((0, 1, 0), (0, 2, 1), (0, 3, 2),
+                       (1, 2, 2), (1, 3, 1), (2, 3, 0))
+    for e in selected:
+        check()
+        h = two[e]
+        if (type(h['edge']) is not int or
+                not 0 <= h['edge'] < 6 * len(coordinates) or
+                type(h['rank']) is not int or h['rank'] < 0):
+            return None
+        t, position = divmod(h['edge'], 6)
+        a, b, q = representatives[position]
+        row = coordinates[t]
+        w = row[a] + row[b] + row[4] + row[5] + row[6] - row[4 + q]
+        left, right = locations[4*t + a], locations[4*t + b]
+        if w == 0:
+            if h['rank'] != 0:
+                return None
+        elif h['rank'] == 0:
+            right = n
+        elif h['rank'] == w:
+            left = n
+        else:
+            return None
+        a, b = find(left), find(right)
+        if a == b:
+            return None
+        if sizes[a] < sizes[b]:
+            a, b = b, a
+        parent[b] = a
+        sizes[a] += sizes[b]
+    if any(find(v) != find(n) for v in range(n)):
+        return None
+    removed = [False] * m
+    for e in selected:
+        removed[e] = True
+    remaining = [dict(h, id=j) for j, h in enumerate(
+        handle for handle in two if not removed[handle['id']])]
+    check()
+    return dict(geometry, core=dict(core, handles2=remaining, handles3=[]))
diff --git a/Topology/UnknotRecognition/fast/source_core_dual_research/README.md b/Topology/UnknotRecognition/fast/source_core_dual_research/README.md
