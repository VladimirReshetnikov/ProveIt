new file mode 100644
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/core_top_reduction_verify.py
@@ -0,0 +1,106 @@
+"""Independent source endpoint reconstruction and relative 2/3 move replay.
+
+The enclosing verifier first authenticates the ORIGINAL source geometry and
+marked boundary.  This replay never calls the endpoint producer or scheduler.
+It derives oriented endpoints by checking every local source-edge occurrence.
+"""
+
+from .integer_codec import certificate_equal
+from .normal_surface_geometry import _prepare, _coordinates, _fingerprint, _EDGES
+
+
+def replay_core_top_reduction(triangulation, coordinates, geometry, certificate,
+                              *, check=lambda: None):
+    """Return the reduced authenticated geometry, or None for a bad proof.
+
+Source geometry errors and callback exceptions propagate, as in the enclosing
+normal-cut verifier.  The source-parallelity verifier must already have checked
+all surviving attaching charts and the complete marked interface.
+"""
+    check()
+    fields = {'schema', 'input_sha256', 'moves', 'surviving_two_handles'}
+    if (type(certificate) is not dict or set(certificate) != fields or
+            certificate['schema'] != 'normal-core-top-reduction-v1'):
+        return None
+    moves, surviving = certificate['moves'], certificate['surviving_two_handles']
+    if type(moves) is not list or type(surviving) is not list:
+        return None
+    prepared = _prepare(triangulation, check)
+    analysed = _coordinates(prepared, coordinates, check)
+    if certificate['input_sha256'] != _fingerprint(triangulation, analysed, check):
+        return None
+    if (not certificate_equal(geometry['source'], triangulation) or
+            not certificate_equal(geometry['coordinates'], analysed['rows'])):
+        return None
+    boundary = set()
+    for t, f in prepared['boundary_faces']:
+        check()
+        boundary.update(prepared['vertex_roots'][4*t+v] for v in range(4) if v != f)
+    vertices = sorted(set(prepared['vertex_roots']) - boundary)
+    core = geometry['core']
+    if len(core['handles3']) != len(vertices):
+        return None
+    vertex_handle = {}
+    for i, (vertex, handle) in enumerate(zip(vertices, core['handles3'])):
+        check()
+        if (type(handle['id']) is not int or handle['id'] != i or
+                type(handle['vertex']) is not int or handle['vertex'] != vertex):
+            return None
+        vertex_handle[vertex] = i
+
+    # Reconstruct a consistently oriented endpoint pair from ALL local edges,
+    # independently of the producer's single canonical representative.
+    endpoints = {}
+    for t in range(len(prepared['tetrahedra'])):
+        for j, (a, b) in enumerate(_EDGES):
+            check()
+            local = 6*t+j
+            edge = prepared['edge_roots'][local]
+            pair = [prepared['vertex_roots'][4*t+a], prepared['vertex_roots'][4*t+b]]
+            if prepared['edge_orientations'][local]:
+                pair.reverse()
+            if edge in endpoints and endpoints[edge] != pair:
+                return None
+            endpoints[edge] = pair
+    contacts = []
+    for edge in sorted(endpoints):
+        check()
+        if edge in prepared['boundary_incidence']:
+            continue
+        weight = analysed['weights'][edge]
+        ranks = (0,) if weight == 0 else (0, weight)
+        for rank in ranks:
+            i = len(contacts)
+            if i >= len(core['handles2']):
+                return None
+            handle = core['handles2'][i]
+            if (any(type(handle[k]) is not int for k in ('id', 'edge', 'rank')) or
+                    (handle['id'], handle['edge'], handle['rank']) != (i, edge, rank)):
+                return None
+            pair = endpoints[edge]
+            adjacent = pair if weight == 0 else [pair[0 if rank == 0 else 1]]
+            contacts.append([vertex_handle[v] for v in adjacent if v in vertex_handle])
+    if len(contacts) != len(core['handles2']) or len(moves) != len(vertices):
+        return None
+    alive = set(range(len(vertices)))
+    unused = set(range(len(contacts)))
+    for move in moves:
+        check()
+        if (type(move) is not list or len(move) != 2 or
+                any(type(v) is not int for v in move)):
+            return None
+        edge, vertex = move
+        if edge not in unused or vertex not in alive:
+            return None
+        # Multiplicity matters. In particular [vertex, vertex] cannot pass.
+        if [v for v in contacts[edge] if v in alive] != [vertex]:
+            return None
+        unused.remove(edge)
+        alive.remove(vertex)
+    expected = [e for e in range(len(contacts)) if e in unused]
+    if alive or any(type(i) is not int for i in surviving) or surviving != expected:
+        return None
+    reduced_core = dict(core, handles3=[], handles2=[
+        dict(core['handles2'][old], id=i) for i, old in enumerate(surviving)])
+    check()
+    return dict(geometry, core=reduced_core)
diff --git a/Topology/UnknotRecognition/fast/fastunknot/core_top_template.py b/Topology/UnknotRecognition/fast/fastunknot/core_top_template.py
new file mode 100644
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/core_top_template.py
@@ -0,0 +1,132 @@
+"""One source vertex tree specializes to every admissible normal cut.
+
+The reusable object contains only source vertex and edge labels.  Positive
+edge weights break a parent edge at the normal surface; its child end then
+roots directly on the new boundary.  Zero-weight edges use the parent that
+was already rooted.  This is a planner, not a source geometry verifier.
+Its specialized certificates are checked by core_top_reduction_verify.
+"""
+
+from collections import deque
+import hashlib
+import json
+
+from .core_top_reduction import source_core_top_incidence
+from .normal_surface_geometry import _prepare, _EDGES
+
+
+def _source_hash(triangulation):
+    return hashlib.sha256(json.dumps(triangulation, sort_keys=True,
+                                     separators=(',', ':')).encode()).hexdigest()
+
+
+def _vertex_data(prepared, check):
+    boundary = {prepared['vertex_roots'][4*t+v]
+                for t, f in prepared['boundary_faces'] for v in range(4) if v != f}
+    ends = {}
+    for edge in sorted(set(prepared['edge_roots'])):
+        check()
+        t, j = divmod(edge, 6)
+        ends[edge] = tuple(prepared['vertex_roots'][4*t+v] for v in _EDGES[j])
+    vertices = set(prepared['vertex_roots'])
+    return boundary, vertices, ends
+
+
+def compile_source_top_tree(triangulation, *, check=lambda: None):
+    """Compile a boundary-rooted source tree, independent of normal coordinates."""
+    check()
+    prepared = _prepare(triangulation, check)
+    boundary, vertices, ends = _vertex_data(prepared, check)
+    adjacency = {v: [] for v in vertices}
+    for edge, (a, b) in ends.items():
+        check()
+        if a != b:
+            adjacency[a].append((b, edge))
+            adjacency[b].append((a, edge))
+    seen, queue = set(boundary), deque(sorted(boundary))
+    parents = []
+    while queue:
+        check()
+        parent = queue.popleft()
+        for vertex, edge in adjacency[parent]:
+            if vertex in seen:
+                continue
+            seen.add(vertex)
+            queue.append(vertex)
+            parents.append(dict(vertex=vertex, parent=parent, edge=edge))
+    if seen != vertices:
+        raise ArithmeticError('source vertex graph does not reach the boundary')
+    return dict(schema='source-core-top-tree-v1',
+                source_sha256=_source_hash(triangulation), parents=parents)
+
+
+def verify_source_top_tree(triangulation, template, *, check=lambda: None):
+    """Validate a supplied tree by parent precedence and exact source edges.
+
+    This never calls the BFS compiler.  Any valid boundary-rooted tree order
+    is accepted, so it can also check externally chosen source templates.
+    """
+    check()
+    if (type(template) is not dict or
+            set(template) != {'schema', 'source_sha256', 'parents'} or
+            template['schema'] != 'source-core-top-tree-v1' or
+            template['source_sha256'] != _source_hash(triangulation) or
+            type(template['parents']) is not list):
+        return False
+    prepared = _prepare(triangulation, check)
+    boundary, vertices, ends = _vertex_data(prepared, check)
+    reached, used = set(boundary), set()
+    for record in template['parents']:
+        check()
+        if (type(record) is not dict or set(record) != {'vertex', 'parent', 'edge'} or
+                any(type(v) is not int for v in record.values())):
+            return False
+        vertex, parent, edge = record['vertex'], record['parent'], record['edge']
+        if (vertex not in vertices or vertex in reached or parent not in reached or
+                edge not in ends or edge in used or
+                sorted(ends[edge]) != sorted((vertex, parent))):
+            return False
+        reached.add(vertex)
+        used.add(edge)
+    check()
+    return reached == vertices
+
+
+def specialize_source_top_tree(triangulation, coordinates, geometry, template,
+                               *, check=lambda: None):
+    """Return a normal-core-top-reduction-v1 proof for this supplied cut.
+
+    Source and coordinate validation are retained at this public entry point.
+    The enclosing cut verifier independently checks the specialized proof;
+    correctness does not depend on trusting this planner or its template.
+    """
+    check()
+    if not verify_source_top_tree(triangulation, template, check=check):
+        raise ValueError('invalid source top-handle tree')
+    incidence = source_core_top_incidence(triangulation, coordinates, geometry,
+                                          check=check)
+    by_vertex = {v: i for i, v in enumerate(incidence['three_handles'])}
+    by_edge = {}
+    for edge in incidence['two_handles']:
+        check()
+        by_edge.setdefault(edge['edge'], []).append(edge)
+    moves, selected = [], set()
+    for record in template['parents']:
+        check()
+        vertex = by_vertex[record['vertex']]
+        candidates = by_edge[record['edge']]
+        if len(candidates) == 1:
+            chosen = candidates[0]
+        else:
+            candidates = [edge for edge in candidates if vertex in edge['ends']]
+            if len(candidates) != 1:
+                raise ArithmeticError('a source tree edge has ambiguous child end')
+            chosen = candidates[0]
+        if chosen['id'] in selected:
+            raise ArithmeticError('source tree specialization reused a two-handle')
+        moves.append([chosen['id'], vertex])
+        selected.add(chosen['id'])
+    return dict(schema='normal-core-top-reduction-v1',
+                input_sha256=incidence['input_sha256'], moves=moves,
+                surviving_two_handles=[edge['id'] for edge in incidence['two_handles']
+                                       if edge['id'] not in selected])
diff --git a/Topology/UnknotRecognition/fast/fastunknot/core_forest_exchange.py b/Topology/UnknotRecognition/fast/fastunknot/core_forest_exchange.py
new file mode 100644
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/core_forest_exchange.py
@@ -0,0 +1,311 @@
+"""Polynomial forest choice for a specified class of raw handle systems.
+
+This is a graph planner, not a source authenticator or a topology recognizer.
+The caller supplies the geometric 3-handle endpoint occurrences and unsigned
+1-handle crossing rows after a fixed primal forest quotient. Missing endpoints
+are exterior boundary. Two equal endpoints are retained as a loop.
+
+Rows whose entrywise saturation at two has sum greater than two are required
+to be deleted by 2/3 cancellation. The other rows are edges of a second graph:
+two unit crossings join their columns; a single crossing joins the ground;
+a repeated crossing is a loop; an empty row is a ground loop. Such rows peel
+exactly when their edges form a forest. Edmonds--Fulkerson matroid partition
+therefore gives a complete polynomial planner for this restricted strategy.
+
+No maintained recognizer dispatch is changed. All failures are INCONCLUSIVE
+for topology. The separate verifier imports none of this implementation.
+"""
+
+from collections import deque
+from heapq import heappop, heappush
+
+
+class _DisjointSets:
+    def __init__(self, size):
+        self.parents = list(range(size))
+
+    def root(self, vertex):
+        while self.parents[vertex] != vertex:
+            self.parents[vertex] = self.parents[self.parents[vertex]]
+            vertex = self.parents[vertex]
+        return vertex
+
+    def join(self, a, b):
+        a, b = self.root(a), self.root(b)
+        if a == b:
+            return False
+        self.parents[max(a, b)] = min(a, b)
+        return True
+
+
+def _rank(vertices, edges, selected):
+    components = _DisjointSets(vertices)
+    return sum(components.join(*edges[e]) for e in selected)
+
+
+def _prepare(three_handles, endpoints, occurrences, check):
+    check()
+    three = list(three_handles)
+    if any(type(v) is not int or v < 0 for v in three):
+        raise ValueError('three-handle labels must be nonnegative integers')
+    if len(set(three)) != len(three):
+        raise ValueError('duplicate three-handle label')
+    if type(endpoints) is not dict or type(occurrences) is not dict:
+        raise ValueError('endpoint and occurrence maps must be dictionaries')
+    if set(endpoints) != set(occurrences):
+        raise ValueError('endpoint and occurrence row labels differ')
+    if any(type(e) is not int or e < 0 for e in endpoints):
+        raise ValueError('row labels must be nonnegative integers')
+    labels = sorted(endpoints)
+    three.sort()
+    dual_index = {v: i + 1 for i, v in enumerate(three)}
+    dual_edges, rows, columns = [], [], set()
+    for e in labels:
+        check()
+        ends = endpoints[e]
+        if type(ends) not in (list, tuple) or len(ends) > 2:
+            raise ValueError('each row needs zero, one or two endpoint occurrences')
+        if any(type(v) is not int or v not in dual_index for v in ends):
+            raise ValueError('unknown three-handle endpoint')
+        mapped = [dual_index[v] for v in ends]
+        dual_edges.append(tuple(mapped + [0] * (2 - len(mapped))))
+        raw = occurrences[e]
+        if type(raw) is not dict:
+            raise ValueError('an occurrence row must be a dictionary')
+        row = {}
+        for c, value in raw.items():
+            if type(c) is not int or c < 0 or type(value) is not int or value < 0:
+                raise ValueError('invalid nonnegative geometric occurrence')
+            if value:
+                row[c] = min(value, 2)
+                columns.add(c)
+        rows.append(row)
+    return three, labels, dual_edges, rows, sorted(columns)
+
+
+def _forest_path(adjacency, start, end, check):
+    """Return the unique path's edge IDs, or None for different components."""
+    if start == end:
+        return []
+    previous = [None] * len(adjacency)
+    previous[start] = (-1, -1)
+    queue = deque([start])
+    while queue:
+        check()
+        vertex = queue.popleft()
+        for neighbour, edge in adjacency[vertex]:
+            if previous[neighbour] is not None:
+                continue
+            previous[neighbour] = (vertex, edge)
+            if neighbour == end:
+                path = []
+                while neighbour != start:
+                    neighbour, edge = previous[neighbour]
+                    path.append(edge)
+                return path
+            queue.append(neighbour)
+    return None
+
+
+def _graphic_partition(vertex_counts, graphs, check, stats):
+    """Partition a shared edge set into two forests, or return a rank witness.
+
+    Breadth-first search uses shortest augmenting paths in the two-matroid
+    exchange graph. At failure, the reached edge set Y satisfies
+    |Y| > rank_G(Y) + rank_H(Y). Loops have empty exchange circuits.
+    """
+    count = len(graphs[0])
+    colours = [-1] * count
+    while -1 in colours:
+        check()
+        stats['searches'] += 1
+        adjacency = [[[] for _ in range(n)] for n in vertex_counts]
+        for e, colour in enumerate(colours):
+            if colour >= 0:
+                a, b = graphs[colour][e]
+                adjacency[colour][a].append((b, e))
+                adjacency[colour][b].append((a, e))
+        previous = [None] * count
+        queue = deque()
+        for e, colour in enumerate(colours):
+            if colour == -1:
+                previous[e] = -1
+                queue.append(e)
+        terminal = None
+        while queue and terminal is None:
+            check()
+            e = queue.popleft()
+            for colour in (0, 1):
+                if colours[e] == colour:
+                    continue
+                a, b = graphs[colour][e]
+                path = _forest_path(adjacency[colour], a, b, check)
+                if path is None:
+                    terminal = (e, colour)
+                    break
+                for f in sorted(path):
+                    stats['exchange_arcs'] += 1
+                    if previous[f] is None:
+                        previous[f] = e
+                        queue.append(f)
+        if terminal is None:
+            reached = [e for e in range(count) if previous[e] is not None]
+            ranks = [_rank(n, g, reached) for n, g in zip(vertex_counts, graphs)]
+            if len(reached) <= sum(ranks):
+                raise ArithmeticError('invalid matroid-union obstruction')
+            return colours, reached, ranks
+        e, target = terminal
+        path = [e]
+        while previous[path[-1]] != -1:
+            path.append(previous[path[-1]])
+        path.reverse()
+        old = colours[:]
+        colours[path[-1]] = target
+        for j in range(len(path) - 1):
+            colours[path[j]] = old[path[j + 1]]
+        stats['augmentations'] += 1
+        stats['recoloured_edges'] += len(path) - 1
+    return colours, None, None
+
+
+def _dual_schedule(three, labels, edges, forest, check):
+    adjacency = [[] for _ in range(len(three) + 1)]
+    for e in sorted(forest):
+        a, b = edges[e]
+        adjacency[a].append((b, e))
+        adjacency[b].append((a, e))
+    seen, queue, schedule = {0}, deque([0]), []
+    while queue:
+        check()
+        v = queue.popleft()
+        for w, e in sorted(adjacency[v], key=lambda item: item[1]):
+            if w not in seen:
+                seen.add(w)
+                queue.append(w)
+                schedule.append([labels[e], three[w - 1]])
+    if len(schedule) != len(three):
+        raise ArithmeticError('dual forest did not reach every three-handle')
+    return schedule
+
+
+def _column_schedule(labels, rows, retained, check):
+    totals, incident = {}, {}
+    for e in sorted(retained):
+        for column, weight in rows[e].items():
+            totals[column] = totals.get(column, 0) + weight
+            incident.setdefault(column, set()).add(e)
+    queue = [c for c in sorted(totals) if totals[c] == 1]
+    # An ascending list is a valid heap.
+    alive, schedule = set(retained), []
+    while queue:
+        check()
+        c = heappop(queue)
+        if totals[c] != 1:
+            continue
+        e = next(iter(incident[c]))
+        alive.remove(e)
+        schedule.append([labels[e], c])
+        for h, weight in rows[e].items():
+            totals[h] -= weight
+            incident[h].remove(e)
+            if totals[h] == 1:
+                heappush(queue, h)
+    if alive:
+        raise ArithmeticError('a purported occurrence forest did not peel')
+    return schedule
+
+
+def plan_forest_exchange(three_handles, endpoints, occurrences, *, check=lambda: None):
+    """Return a full graph schedule or a certified obstruction to this strategy.
+
+    ``three_handles`` lists source 3-handle IDs. ``endpoints`` maps every
+    2-handle ID to a list of 0..2 3-handle endpoint occurrences; missing ends
+    mean exterior boundary. ``occurrences`` maps the same IDs to sparse
+    nonnegative integer counts on a fixed set of surviving 1-handles.
+
+    COMPLETE refers only to this combinatorial cancellation model. The source
+    geometric gate, component census, boundary-pattern transport and knot
+    interpretation are responsibilities of an authenticated caller.
+    """
+    three, labels, dual_edges, rows, columns = _prepare(
+        three_handles, endpoints, occurrences, check)
+    stats = dict(searches=0, augmentations=0, exchange_arcs=0, recoloured_edges=0)
+    result = dict(status='INCONCLUSIVE', scope='supplied graph cancellation strategy',
+                  stats=stats)
+    proof = dict(schema='core-forest-exchange-v1')
+    vertices = len(three) + 1
+    all_components = _DisjointSets(vertices)
+    for a, b in dual_edges:
+        check()
+        all_components.join(a, b)
+    missing = [i for i in range(1, vertices) if all_components.root(i) != 0]
+    if missing:
+        component = all_components.root(missing[0])
+        proof.update(kind='boundary_disconnected',
+                     vertices=[three[i - 1] for i in missing
+                               if all_components.root(i) == component])
+        result.update(reason=proof['kind'], certificate=proof)
+        return result
+
+    forced = [e for e, row in enumerate(rows) if sum(row.values()) > 2]
+    contraction = _DisjointSets(vertices)
+    cyclic = False
+    for e in forced:
+        check()
+        if not contraction.join(*dual_edges[e]):
+            cyclic = True
+    if cyclic:
+        proof.update(kind='forced_long_cycle', rows=[labels[e] for e in forced],
+                     rank=_rank(vertices, dual_edges, forced))
+        result.update(reason=proof['kind'], certificate=proof)
+        return result
+
+    forced_set = set(forced)
+    short = [e for e in range(len(labels)) if e not in forced_set]
+    roots = sorted({contraction.root(v) for v in range(vertices)})
+    root_index = {v: i for i, v in enumerate(roots)}
+    contracted = [(root_index[contraction.root(a)], root_index[contraction.root(b)])
+                  for e in short for a, b in [dual_edges[e]]]
+    column_index = {c: i + 1 for i, c in enumerate(columns)}
+    occurrence_edges = []
+    for e in short:
+        ends = [column_index[c] for c in sorted(rows[e]) for _ in range(rows[e][c])]
+        occurrence_edges.append(tuple(ends + [0] * (2 - len(ends))))
+    stats.update(forced_long_rows=len(forced), short_rows=len(short))
+    colours, witness, ranks = _graphic_partition(
+        (len(roots), len(columns) + 1), (contracted, occurrence_edges), check, stats)
+    # A maximum partial partition also extends to a dual spanning tree using
+    # occurrence-forest edges: an unassigned edge joining dual components
+    # would itself augment the partition and contradict maximality.
+    span = _DisjointSets(len(roots))
+    for e, colour in enumerate(colours):
+        if colour == 0:
+            span.join(*contracted[e])
+    for e in range(len(short)):
+        check()
+        if span.join(*contracted[e]):
+            if colours[e] == -1:
+                raise ArithmeticError('unassigned edge augmented a maximum partition')
+            colours[e] = 0
+    forest = forced_set | {short[e] for e, colour in enumerate(colours) if colour == 0}
+    retained = set(range(len(labels))) - forest
+    top_schedule = _dual_schedule(three, labels, dual_edges, forest, check)
+    if witness is not None:
+        unassigned = [short[e] for e, colour in enumerate(colours) if colour == -1]
+        proof.update(kind='short_row_rank_obstruction',
+                     rows=[labels[short[e]] for e in witness], ranks=ranks,
+                     deficiency=len(unassigned),
+                     dual_forest=[labels[e] for e in sorted(forest)],
+                     two_three_cancellations=top_schedule,
+                     occurrence_forest=[labels[short[e]] for e, colour in enumerate(colours)
+                                        if colour == 1],
+                     unassigned_rows=[labels[e] for e in unassigned])
+        result.update(reason=proof['kind'], certificate=proof)
+        return result
+    proof.update(kind='complete', dual_forest=[labels[e] for e in sorted(forest)],
+                 two_three_cancellations=top_schedule,
+                 one_two_cancellations=_column_schedule(labels, rows, retained, check))
+    result.update(status='COMPLETE', certificate=proof,
+                  retained_rows=[labels[e] for e in sorted(retained)])
+    check()
+    return result
diff --git a/Topology/UnknotRecognition/fast/fastunknot/core_forest_exchange_verify.py b/Topology/UnknotRecognition/fast/fastunknot/core_forest_exchange_verify.py
new file mode 100644
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/core_forest_exchange_verify.py
@@ -0,0 +1,213 @@
+"""Independent graph replay for restricted dual/occurrence forest certificates.
+
+This verifier does not import the planner, its graph constructor, its exchange
+search or its leaf queue. It authenticates a certificate relative to supplied
+endpoint occurrences and crossing rows. It does not authenticate the geometric
+source of those data and does not return a knot or handlebody verdict.
+"""
+
+
+def _nonnegative_label(value):
+    return type(value) is int and value >= 0
+
+
+def _read_source(three_handles, endpoints, occurrences, check):
+    three = list(three_handles)
+    if not all(_nonnegative_label(v) for v in three) or len(set(three)) != len(three):
+        raise ValueError('invalid three-handles')
+    if type(endpoints) is not dict or type(occurrences) is not dict:
+        raise ValueError('invalid source maps')
+    if set(endpoints) != set(occurrences):
+        raise ValueError('source row labels differ')
+    edges, rows = {}, {}
+    for e, ends in endpoints.items():
+        check()
+        if not _nonnegative_label(e) or type(ends) not in (list, tuple) or len(ends) > 2:
+            raise ValueError('invalid endpoint row')
+        if any(not _nonnegative_label(v) or v not in three for v in ends):
+            raise ValueError('unknown endpoint')
+        edges[e] = tuple(list(ends) + [-1] * (2 - len(ends)))
+        raw = occurrences[e]
+        if type(raw) is not dict:
+            raise ValueError('invalid occurrence row')
+        row = {}
+        for c, value in raw.items():
+            if not _nonnegative_label(c) or not _nonnegative_label(value):
+                raise ValueError('invalid occurrence')
+            if value:
+                row[c] = 1 if value == 1 else 2
+        rows[e] = row
+    return set(three) | {-1}, edges, rows
+
+
+def _rank(vertices, edge_pairs, check):
+    """Graphic rank by literal component traversal, including isolated vertices."""
+    adjacency = {v: [] for v in vertices}
+    for a, b in edge_pairs:
+        adjacency[a].append(b)
+        adjacency[b].append(a)
+    seen, components = set(), 0
+    for start in sorted(vertices):
+        if start in seen:
+            continue
+        components += 1
+        stack = [start]
+        seen.add(start)
+        while stack:
+            check()
+            for other in adjacency[stack.pop()]:
+                if other not in seen:
+                    seen.add(other)
+                    stack.append(other)
+    return len(vertices) - components
+
+
+def _label_list(value, allowed):
+    return (type(value) is list and all(_nonnegative_label(x) for x in value)
+            and len(set(value)) == len(value) and set(value) <= allowed)
+
+
+def _pairs(value):
+    return (type(value) is list and all(type(pair) is list and len(pair) == 2
+            and all(_nonnegative_label(x) for x in pair) for pair in value))
+
+
+def _dual_complete(vertices, edges, rows, forced, certificate, check):
+    forest = certificate['dual_forest']
+    if not _label_list(forest, set(rows)) or not forced <= set(forest):
+        return False
+    top = certificate['two_three_cancellations']
+    if not _pairs(top):
+        return False
+    alive, deleted = vertices - {-1}, set()
+    for r, v in top:
+        check()
+        if r not in forest or r in deleted or v not in alive:
+            return False
+        # Counting occurrences rejects a loop meeting one 3-handle twice.
+        if [w for w in edges[r] if w in alive] != [v]:
+            return False
+        alive.remove(v)
+        deleted.add(r)
+    return not alive and deleted == set(forest)
+
+
+def _complete(vertices, edges, rows, forced, certificate, check):
+    expected = {'schema', 'kind', 'dual_forest', 'two_three_cancellations',
+                'one_two_cancellations'}
+    if set(certificate) != expected:
+        return False
+    if not _dual_complete(vertices, edges, rows, forced, certificate, check):
+        return False
+
+    bottom = certificate['one_two_cancellations']
+    if not _pairs(bottom):
+        return False
+    retained = set(rows) - set(certificate['dual_forest'])
+    ordered_rows = [r for r, _ in bottom]
+    ordered_columns = [c for _, c in bottom]
+    if (len(set(ordered_rows)) != len(ordered_rows) or set(ordered_rows) != retained
+            or len(set(ordered_columns)) != len(ordered_columns)):
+        return False
+    row_time = {r: i for i, r in enumerate(ordered_rows)}
+    column_time = {c: (i, r) for i, (r, c) in enumerate(bottom)}
+    for r, c in bottom:
+        if rows[r].get(c, 0) != 1:
+            return False
+    # Source timestamps check each no-fill condition without repeating a queue.
+    for r in retained:
+        check()
+        for c in rows[r]:
+            if c in column_time:
+                timestamp, pivot_row = column_time[c]
+                if r != pivot_row and row_time[r] >= timestamp:
+                    return False
+    return True
+
+
+def _occurrence_graph(rows, selected):
+    edge_pairs = []
+    for e in selected:
+        ends = []
+        for c, value in rows[e].items():
+            ends.extend([c] * value)
+        if len(ends) > 2:
+            raise ValueError('long row in occurrence graph')
+        edge_pairs.append(tuple(ends + [-1] * (2 - len(ends))))
+    return edge_pairs
+
+
+def verify_forest_exchange(three_handles, endpoints, occurrences, certificate,
+                           *, check=lambda: None):
+    """Check a full schedule or an obstruction to the stated restricted strategy.
+
+    A true return for a refusal proof establishes only graph-model infeasibility.
+    Neither that return nor a complete graph schedule authenticates native
+    geometry, marked-curve transport, or any ambient knot interpretation.
+    """
+    check()
+    try:
+        vertices, edges, rows = _read_source(three_handles, endpoints, occurrences, check)
+        if type(certificate) is not dict or certificate.get('schema') != 'core-forest-exchange-v1':
+            return False
+        kind = certificate.get('kind')
+        forced = {r for r, row in rows.items() if sum(row.values()) > 2}
+        if kind == 'complete':
+            return _complete(vertices, edges, rows, forced, certificate, check)
+        if kind == 'boundary_disconnected':
+            if set(certificate) != {'schema', 'kind', 'vertices'}:
+                return False
+            separated = certificate['vertices']
+            if not separated or not _label_list(separated, vertices - {-1}):
+                return False
+            part = set(separated)
+            return all((a in part) == (b in part) for a, b in edges.values())
+        if kind == 'forced_long_cycle':
+            if set(certificate) != {'schema', 'kind', 'rows', 'rank'}:
+                return False
+            selected = certificate['rows']
+            if not selected or not _label_list(selected, forced):
+                return False
+            rank = _rank(vertices, [edges[e] for e in selected], check)
+            return (_nonnegative_label(certificate['rank'])
+                    and certificate['rank'] == rank < len(selected))
+        if kind != 'short_row_rank_obstruction':
+            return False
+        expected = {'schema', 'kind', 'rows', 'ranks', 'deficiency', 'dual_forest',
+                    'two_three_cancellations', 'occurrence_forest', 'unassigned_rows'}
+        if set(certificate) != expected:
+            return False
+        selected = certificate['rows']
+        if not selected or not _label_list(selected, set(rows) - forced):
+            return False
+        if _rank(vertices, [edges[e] for e in forced], check) != len(forced):
+            return False
+        dual_rank = _rank(vertices, [edges[e] for e in forced | set(selected)], check)
+        dual_rank -= len(forced)
+        columns = {c for row in rows.values() for c in row} | {-1}
+        occurrence_rank = _rank(columns, _occurrence_graph(rows, selected), check)
+        ranks = certificate['ranks']
+        deficiency = certificate['deficiency']
+        if not (type(ranks) is list and len(ranks) == 2
+                and all(_nonnegative_label(r) for r in ranks)
+                and ranks == [dual_rank, occurrence_rank]
+                and _nonnegative_label(deficiency) and deficiency > 0
+                and len(selected) - sum(ranks) == deficiency):
+            return False
+        if not _dual_complete(vertices, edges, rows, forced, certificate, check):
+            return False
+        retained = set(rows) - set(certificate['dual_forest'])
+        occurrence_forest = certificate['occurrence_forest']
+        unassigned = certificate['unassigned_rows']
+        if (not _label_list(occurrence_forest, retained)
+                or not _label_list(unassigned, retained)
+                or set(occurrence_forest) & set(unassigned)
+                or set(occurrence_forest) | set(unassigned) != retained
+                or len(unassigned) != deficiency):
+            return False
+        forest_rank = _rank(columns, _occurrence_graph(rows, occurrence_forest), check)
+        residual_rank = _rank(columns, _occurrence_graph(rows, retained), check)
+        return (forest_rank == len(occurrence_forest)
+                and len(retained) - residual_rank == deficiency)
+    except (KeyError, TypeError, ValueError, IndexError):
+        return False
