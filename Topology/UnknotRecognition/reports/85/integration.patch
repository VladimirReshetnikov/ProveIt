--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/core_handlebody.py
@@ -0,0 +1,187 @@
+"""Small certificates that an authenticated geometric handle core is a handlebody.
+
+Only a spanning forest and raw geometric 1/2 cancellations are used.  The
+attaching curves must come from the source-parallelity handle charts: an
+arbitrary group presentation is not an acceptable substitute for this input.
+All belt-intersection counts are saturated at two.  No words are expanded,
+freely reduced, or replaced by algebraic exponent sums.
+"""
+
+from heapq import heappop, heappush
+
+
+def _forest(core, check):
+    count = len(core['handles0'])
+    parent = list(range(count))
+
+    def root(a):
+        while parent[a] != a:
+            parent[a] = parent[parent[a]]
+            a = parent[a]
+        return a
+
+    edges = []
+    for handle in core['handles1']:
+        check()
+        a, b = map(root, handle['ends'])
+        if a != b:
+            parent[max(a, b)] = min(a, b)
+            edges.append(handle['id'])
+    roots = [root(a) for a in range(count)]
+    return edges, roots
+
+
+def _occurrences(core, tree, check):
+    tree = set(tree)
+    rows = {}
+    for handle in core['handles2']:
+        check()
+        row = {}
+        for flag in handle['cycle']:
+            if flag['dimension'] == 1 and flag['handle'] not in tree:
+                h = flag['handle']
+                row[h] = min(2, row.get(h, 0) + 1)
+        rows[handle['id']] = row
+    return rows
+
+
+def capped_cancellation_plan(counts, *, check=lambda: None):
+    """Return a sound raw singleton schedule for nonnegative occurrence rows.
+
+    This deterministic greedy producer is deliberately incomplete.  The
+    independent verifier accepts any supplied successful schedule.  Values
+    zero, one and at least two carry all information needed for admissibility.
+    Row and column labels must be nonnegative integers.
+    """
+    rows = {}
+    for r, values in counts.items():
+        check()
+        if type(r) is not int or r < 0 or type(values) is not dict:
+            raise ValueError('invalid occurrence row')
+        row = {}
+        for c, value in values.items():
+            if type(c) is not int or c < 0 or type(value) is not int or value < 0:
+                raise ValueError('invalid occurrence entry')
+            if value:
+                row[c] = min(2, value)
+        rows[r] = row
+    schedule, updates, scans = [], 0, 0
+    while rows:
+        check()
+        totals = {}
+        for row in rows.values():
+            for c, value in row.items():
+                totals[c] = totals.get(c, 0) + value
+                scans += 1
+        candidates = []
+        for r, row in rows.items():
+            size = sum(row.values())
+            for c, value in row.items():
+                scans += 1
+                if value == 1:
+                    candidates.append(((size - 1) * (totals[c] - 1), size, r, c))
+        if not candidates:
+            break
+        _, _, r, c = min(candidates)
+        donor = rows.pop(r)
+        donor.pop(c)
+        for row in rows.values():
+            check()
+            multiplicity = row.pop(c, 0)
+            if multiplicity:
+                for h, value in donor.items():
+                    row[h] = min(2, row.get(h, 0) + multiplicity * value)
+                    updates += 1
+        schedule.append([r, c])
+    return dict(cancellations=schedule, remaining_rows=sorted(rows),
+                stats=dict(entry_scans=scans, entry_updates=updates))
+
+
+def leaf_cancellation_plan(counts, *, check=lambda: None):
+    """Peel source rows having one remaining crossing, without fill or words.
+
+    For a square occurrence matrix this is complete for raw singleton
+    eliminability: permanent one is equivalent to this leaf ordering.  For
+    rectangular matrices a stalled pass is only a conservative failure.
+    """
+    rows = {r: {c: min(2, v) for c, v in values.items() if v}
+            for r, values in counts.items()}
+    incident = {}
+    for r, row in rows.items():
+        for c in row:
+            incident.setdefault(c, []).append(r)
+    queue = []
+    for r, row in rows.items():
+        if len(row) == 1 and next(iter(row.values())) == 1:
+            heappush(queue, r)
+    schedule, visits = [], 0
+    while queue:
+        check()
+        r = heappop(queue)
+        if r not in rows:
+            continue
+        row = rows[r]
+        if len(row) != 1 or next(iter(row.values())) != 1:
+            continue
+        rows.pop(r)
+        c = next(iter(row))
+        schedule.append([r, c])
+        for i in incident[c]:
+            check()
+            visits += 1
+            if i in rows:
+                rows[i].pop(c, None)
+                if len(rows[i]) == 1 and next(iter(rows[i].values())) == 1:
+                    heappush(queue, i)
+    return dict(cancellations=schedule, remaining_rows=sorted(rows),
+                stats=dict(incidence_visits=visits))
+
+
+def core_handlebody_certificate(core, *, check=lambda: None):
+    """Plan certified cancellations on a source-authenticated geometric core.
+
+    A COMPLETE result gives a handlebody for each core component.  Three-handles
+    and stalled raw cancellation produce INCONCLUSIVE, never a negative result.
+    Authenticating the source and its handle charts belongs to the enclosing
+    normal-cut certificate.  The small certificate is checked independently by
+    ``verify_core_handlebody_certificate``.
+    """
+    check()
+    result = dict(status='INCONCLUSIVE',
+                  trust='geometric core cancellation; requires authenticated handle charts')
+    if core['handles3']:
+        result['reason'] = 'core_has_three_handles'
+        return result
+    tree, component = _forest(core, check)
+    counts = _occurrences(core, tree, check)
+    planned = leaf_cancellation_plan(counts, check=check)
+    method = 'leaf'
+    if planned['remaining_rows']:
+        columns = len(core['handles1']) - len(tree)
+        if columns == len(core['handles2']):
+            result.update(reason='raw_ball_cancellation_obstruction',
+                          remaining_two_handles=planned['remaining_rows'],
+                          stats=planned['stats'])
+            return result
+        planned = capped_cancellation_plan(counts, check=check)
+        method = 'capped'
+    result['stats'] = planned['stats']
+    if planned['remaining_rows']:
+        result.update(reason='raw_cancellation_stalled',
+                      remaining_two_handles=planned['remaining_rows'])
+        return result
+    survivors = set(range(len(core['handles1']))) - set(tree)
+    survivors.difference_update(c for _, c in planned['cancellations'])
+    components = []
+    for representative in sorted(set(component)):
+        check()
+        vertices = [i for i, r in enumerate(component) if r == representative]
+        loops = [i for i in sorted(survivors)
+                 if component[core['handles1'][i]['ends'][0]] == representative]
+        components.append(dict(id=representative, zero_handles=vertices,
+                               remaining_one_handles=loops, genus=len(loops)))
+    proof = dict(schema='normal-core-handlebody-v1', method=method, forest=tree,
+                 cancellations=planned['cancellations'], components=components)
+    result.update(status='COMPLETE', certificate=proof, components=components)
+    check()
+    return result
diff --git a/Topology/UnknotRecognition/fast/fastunknot/core_handlebody_verify.py b/Topology/UnknotRecognition/fast/fastunknot/core_handlebody_verify.py
new file mode 100644
index 000000000..9819307ac
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/core_handlebody_verify.py
@@ -0,0 +1,131 @@
+"""Independent replay of forest contraction and geometric singleton cancellations.
+
+The source-parallelity checker authenticates the handle charts.  This checker
+reconstructs all counts from those charts, accepts no count summaries, and
+imports no producer code or group-presentation simplifier.
+"""
+
+from .integer_codec import certificate_equal
+
+
+def verify_core_handlebody_certificate(core, certificate, *, check=lambda: None):
+    """Check a core certificate, conditional on authenticated geometric charts."""
+    check()
+    required = {'schema', 'method', 'forest', 'cancellations', 'components'}
+    if type(certificate) is not dict or set(certificate) != required:
+        return False
+    if certificate['schema'] != 'normal-core-handlebody-v1' or core['handles3']:
+        return False
+    if certificate['method'] not in ('leaf', 'capped'):
+        return False
+    forest, moves = certificate['forest'], certificate['cancellations']
+    if type(forest) is not list or type(moves) is not list:
+        return False
+    vertices, edges, discs = [core[f'handles{i}'] for i in range(3)]
+    for handles in (vertices, edges, discs):
+        if any(type(h['id']) is not int or h['id'] != i for i, h in enumerate(handles)):
+            return False
+    if not vertices:
+        return False
+    n, m = len(vertices), len(edges)
+    sets = [{i} for i in range(n)]
+    owner = list(range(n))
+    seen = set()
+    for e in forest:
+        check()
+        if type(e) is not int or e < 0 or e >= m or e in seen:
+            return False
+        seen.add(e)
+        a, b = edges[e]['ends']
+        if type(a) is not int or type(b) is not int or not (0 <= a < n and 0 <= b < n):
+            return False
+        x, y = owner[a], owner[b]
+        if x == y:
+            return False
+        low, high = min(x, y), max(x, y)
+        for point in sets[high]:
+            owner[point] = low
+        sets[low].update(sets[high])
+        sets[high].clear()
+    for edge in edges:
+        check()
+        a, b = edge['ends']
+        if type(a) is not int or type(b) is not int or not (0 <= a < n and 0 <= b < n):
+            return False
+        if owner[a] != owner[b]:
+            return False  # The supplied forest must span every 0/1 component.
+
+    # Reconstruct the raw intersection matrix, including repeated occurrences.
+    matrix = []
+    for disc in discs:
+        check()
+        cycle = disc['cycle']
+        if type(cycle) is not list or not cycle or len(cycle) % 2:
+            return False
+        row = {}
+        for j in range(0, len(cycle), 2):
+            point, crossing = cycle[j], cycle[j + 1]
+            if point['dimension'] != 0 or crossing['dimension'] != 1:
+                return False
+            v, e = point['handle'], crossing['handle']
+            following = cycle[(j + 2) % len(cycle)]['handle']
+            if any(type(x) is not int for x in (v, e, following)):
+                return False
+            if not (0 <= v < n and 0 <= following < n and 0 <= e < m):
+                return False
+            if sorted((v, following)) != sorted(edges[e]['ends']):
+                return False
+            if e not in seen:
+                row[e] = min(2, row.get(e, 0) + 1)
+        matrix.append(row)
+    live_rows = set(range(len(discs)))
+    live_columns = set(range(m)) - seen
+    if certificate['method'] == 'leaf':
+        # Independently check a triangular source pattern.  Earlier leaf
+        # removals add no other crossings, so timestamps replace all updates.
+        removed_at = {}
+        for time, move in enumerate(moves):
+            check()
+            if type(move) is not list or len(move) != 2:
+                return False
+            r, c = move
+            if type(r) is not int or type(c) is not int:
+                return False
+            if r not in live_rows or c not in live_columns:
+                return False
+            if matrix[r].get(c, 0) != 1:
+                return False
+            if any(h != c and h not in removed_at for h in matrix[r]):
+                return False
+            live_rows.remove(r)
+            live_columns.remove(c)
+            removed_at[c] = time
+        moves = []
+    else:
+        matrix = [[row.get(c, 0) for c in range(m)] for row in matrix]
+    for move in moves:
+        check()
+        if type(move) is not list or len(move) != 2:
+            return False
+        r, c = move
+        if type(r) is not int or type(c) is not int:
+            return False
+        if r not in live_rows or c not in live_columns or matrix[r][c] != 1:
+            return False
+        live_rows.remove(r)
+        live_columns.remove(c)
+        for i in live_rows:
+            check()
+            for h in live_columns:
+                matrix[i][h] = min(2, matrix[i][h] + matrix[i][c] * matrix[r][h])
+            matrix[i][c] = 0
+    if live_rows:
+        return False
+    expected = []
+    for component in sorted(set(owner)):
+        points = [v for v in range(n) if owner[v] == component]
+        loops = [e for e in sorted(live_columns) if owner[edges[e]['ends'][0]] == component]
+        expected.append(dict(id=component, zero_handles=points,
+                             remaining_one_handles=loops, genus=len(loops)))
+    check()
+    return certificate_equal(certificate['components'], expected)
diff --git a/Topology/UnknotRecognition/fast/fastunknot/normal_cut_handlebodies.py b/Topology/UnknotRecognition/fast/fastunknot/normal_cut_handlebodies.py
new file mode 100644
index 000000000..d76c2ba3a
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/normal_cut_handlebodies.py
@@ -0,0 +1,150 @@
+"""Source-certified handlebody census for disk-attached normal-cut pieces.
+
+This conservative terminal operator combines the complete source parallelity
+decomposition, ordered core attachments, and geometric core cancellations.
+It never infers a ball from homology or a sphere boundary alone.  Annular
+attachments, closed bundle bases, or stalled core cancellations are unresolved.
+"""
+
+from collections import Counter
+
+from .core_handlebody import core_handlebody_certificate
+from .normal_parallelity import normal_cut_parallelity
+from .parallelity_boundary_words import normal_parallelity_boundary_words
+
+
+def _census(geometry, summary, skeleton, components, check):
+    if skeleton['circle_attachments']:
+        return None, 'annular_core_attachment'
+    profiles = summary['base_profiles']
+    if any(p['boundary_components'] == 0 for p in profiles):
+        return None, 'closed_bundle_base'
+    owner = {v: c['id'] for c in components for v in c['zero_handles']}
+    port_base = {p: i for i, profile in enumerate(profiles)
+                 for p in profile['core_ports']}
+    port_core = {}
+    for port in geometry['ports']:
+        check()
+        dimension, handle = port['core_dimension'], port['core_handle']
+        if dimension == 0:
+            vertex = handle
+        elif dimension == 1:
+            vertex = geometry['core']['handles1'][handle]['ends'][0]
+        else:
+            raise ArithmeticError('invalid core-facing port owner')
+        port_core[port['id']] = owner[vertex]
+    nodes = [('core', c['id']) for c in components]
+    nodes += [('base', i) for i, p in enumerate(profiles) if p['core_ports']]
+    parent = {v: v for v in nodes}
+    genera = {('core', c['id']): c['genus'] for c in components}
+    genera.update({('base', i): 1 - p['euler_characteristic']
+                   for i, p in enumerate(profiles) if p['core_ports']})
+
+    def root(v):
+        while parent[v] != v:
+            parent[v] = parent[parent[v]]
+            v = parent[v]
+        return v
+
+    edges = []
+    for i, attachment in enumerate(skeleton['attachment_components']):
+        check()
+        ports = [abs(p) - 1 for p in attachment['word']]
+        bases = {port_base[p] for p in ports}
+        cores = {port_core[p] for p in ports}
+        if attachment['kind'] != 'interval' or len(bases) != 1 or len(cores) != 1:
+            raise ArithmeticError('one connected disk attachment has inconsistent owners')
+        b, c = next(iter(bases)), next(iter(cores))
+        left, right = ('base', b), ('core', c)
+        a, z = root(left), root(right)
+        if a != z:
+            parent[max(a, z)] = min(a, z)
+        edges.append(dict(attachment=i, base_profile=b, core_component=c))
+    groups = {}
+    for v in nodes:
+        groups.setdefault(root(v), []).append(v)
+    histogram = Counter()
+    joined = []
+    for key, vertices in sorted(groups.items()):
+        check()
+        selected = [i for i, e in enumerate(edges)
+                    if root(('base', e['base_profile'])) == key]
+        cycle_rank = len(selected) - len(vertices) + 1
+        genus = sum(genera[v] for v in vertices) + cycle_rank
+        if genus < 0 or cycle_rank < 0:
+            raise ArithmeticError('invalid disk-gluing graph genus')
+        histogram[genus] += 1
+        joined.append(dict(core_components=sorted(v[1] for v in vertices if v[0] == 'core'),
+                           base_profiles=sorted(v[1] for v in vertices if v[0] == 'base'),
+                           attachments=selected, cycle_rank=cycle_rank, genus=genus))
+    isolated = []
+    for i, profile in enumerate(profiles):
+        check()
+        if not profile['core_ports']:
+            genus = 1 - profile['euler_characteristic']
+            if genus < 0:
+                raise ArithmeticError('a bordered bundle has negative handlebody genus')
+            copies = profile['multiplicity']
+            histogram[genus] += copies
+            isolated.append(dict(base_profile=i, genus=genus, multiplicity=copies))
+    euler = sum((1 - genus) * copies for genus, copies in histogram.items())
+    expected = (summary['core_euler_characteristic'] +
+                summary['bundle_euler_characteristic'] -
+                summary['attachment_euler_characteristic'])
+    if euler != expected:
+        raise ArithmeticError('handlebody census violates source-cut Euler identity')
+    return dict(histogram=[dict(genus=g, multiplicity=n) for g, n in sorted(histogram.items())],
+                components=sum(histogram.values()), ball_components=histogram[0],
+                all_balls=all(g == 0 for g in histogram), euler_characteristic=euler,
+                joined_components=joined, isolated_bundles=isolated, attachments=edges), None
+
+
+def normal_cut_handlebodies(triangulation, coordinates, *, max_cycles=None,
+                           record_certificate=False, check=lambda: None):
+    """Classify the whole supplied cut when the disk-gluing criterion succeeds.
+
+    A COMPLETE result is an exact binary multiplicity census of handlebodies.
+    An INCONCLUSIVE result is neither a knottedness nor a non-handlebody proof.
+    Source validity is the established compact orientable one-torus contract.
+    The six orbit discoveries share the cycle allowance; cancellation callbacks
+    also cover the polynomial core and finite interface computations.
+    """
+    check()
+    if type(record_certificate) is not bool:
+        raise ValueError('record_certificate must be bool')
+    if max_cycles is not None and (type(max_cycles) is not int or max_cycles < 0):
+        raise ValueError('max_cycles must be a nonnegative integer or None')
+    result = dict(status='INCONCLUSIVE', stats={},
+                  trust='source cut handlebodies; no standalone knot verdict')
+    parallelity = normal_cut_parallelity(triangulation, coordinates,
+        max_cycles=max_cycles, record_certificate=record_certificate, check=check)
+    result['stats']['parallelity'] = parallelity['stats']
+    if parallelity['status'] != 'COMPLETE':
+        result['reason'] = 'parallelity_budget_exhausted'
+        return result
+    core = core_handlebody_certificate(parallelity['geometry']['core'], check=check)
+    result['stats']['core'] = core.get('stats', {})
+    if core['status'] != 'COMPLETE':
+        result['reason'] = core['reason']
+        return result
+    remaining = max_cycles
+    if remaining is not None:
+        remaining -= sum(s['orbit_cycles'] for s in parallelity['stats'].values())
+    boundary = normal_parallelity_boundary_words(triangulation, coordinates,
+        max_cycles=remaining, record_certificate=record_certificate, check=check)
+    result['stats']['boundary'] = boundary['stats']
+    if boundary['status'] != 'COMPLETE':
+        result['reason'] = 'boundary_budget_exhausted'
+        return result
+    census, reason = _census(parallelity['geometry'], parallelity['summary'],
+                            boundary['skeleton'], core['components'], check)
+    if census is None:
+        result['reason'] = reason
+        return result
+    result.update(status='COMPLETE', census=census)
+    if record_certificate:
+        result['certificate'] = dict(schema='normal-cut-handlebodies-v1',
+            parallelity=parallelity['certificate'], boundary=boundary['certificate'],
+            core=core['certificate'], census=census)
+    check()
+    return result
diff --git a/Topology/UnknotRecognition/fast/fastunknot/normal_cut_handlebodies_verify.py b/Topology/UnknotRecognition/fast/fastunknot/normal_cut_handlebodies_verify.py
new file mode 100644
index 000000000..5a42536e5
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/normal_cut_handlebodies_verify.py
@@ -0,0 +1,139 @@
+"""Independent source and disk-gluing replay for normal-cut handlebody censuses."""
+
+from collections import Counter
+
+from .core_handlebody_verify import verify_core_handlebody_certificate
+from .integer_codec import encoded_integer, certificate_equal
+from .normal_parallelity_verify import verify_normal_cut_parallelity
+from .parallelity_boundary_words_verify import verify_parallelity_boundary_words
+
+
+def _decode(value):
+    if isinstance(value, dict):
+        return {key: _decode(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [_decode(item) for item in value]
+    if isinstance(value, str) and value.startswith(('0x', '-0x')):
+        return encoded_integer(value)
+    return value
+
+
+def _recount(g, summary, skeleton, components, check):
+    profiles = summary['base_profiles']
+    if any(p['boundary_components'] <= 0 for p in profiles):
+        return None
+    if any(a['kind'] != 'interval' for a in skeleton['attachment_components']):
+        return None
+    vertex_component = {}
+    for c in components:
+        for v in c['zero_handles']:
+            vertex_component[v] = c['id']
+    by_port = {}
+    for i, p in enumerate(profiles):
+        for port in p['core_ports']:
+            by_port[port] = i
+    core_port = {}
+    for port in g['ports']:
+        if port['core_dimension'] == 0:
+            v = port['core_handle']
+        elif port['core_dimension'] == 1:
+            v = g['core']['handles1'][port['core_handle']]['ends'][0]
+        else:
+            return None
+        core_port[port['id']] = vertex_component[v]
+    genus = {('core', c['id']): c['genus'] for c in components}
+    genus.update({('base', i): 1 - p['euler_characteristic']
+                  for i, p in enumerate(profiles) if p['core_ports']})
+    neighbors = {node: [] for node in genus}
+    edges = []
+    for i, a in enumerate(skeleton['attachment_components']):
+        check()
+        ports = [abs(x) - 1 for x in a['word']]
+        choices = {(by_port[p], core_port[p]) for p in ports}
+        if len(choices) != 1:
+            return None
+        b, c = choices.pop()
+        edges.append(dict(attachment=i, base_profile=b, core_component=c))
+        neighbors['base', b].append(('core', c))
+        neighbors['core', c].append(('base', b))
+    unseen = set(neighbors)
+    joined, histogram = [], Counter()
+    while unseen:
+        check()
+        start = min(unseen)
+        todo, visited = [start], set()
+        while todo:
+            node = todo.pop()
+            if node in visited:
+                continue
+            visited.add(node)
+            todo.extend(neighbors[node])
+        unseen.difference_update(visited)
+        attached = [i for i, e in enumerate(edges) if ('base', e['base_profile']) in visited]
+        beta = len(attached) - len(visited) + 1
+        value = sum(genus[v] for v in visited) + beta
+        if beta < 0 or value < 0:
+            return None
+        histogram[value] += 1
+        joined.append(dict(core_components=sorted(v[1] for v in visited if v[0] == 'core'),
+                           base_profiles=sorted(v[1] for v in visited if v[0] == 'base'),
+                           attachments=attached, cycle_rank=beta, genus=value))
+    isolated = []
+    for i, p in enumerate(profiles):
+        if not p['core_ports']:
+            value = 1 - p['euler_characteristic']
+            if value < 0:
+                return None
+            histogram[value] += p['multiplicity']
+            isolated.append(dict(base_profile=i, genus=value, multiplicity=p['multiplicity']))
+    euler = sum(n * (1 - g) for g, n in histogram.items())
+    source = summary['core_euler_characteristic'] + summary['bundle_euler_characteristic']
+    if euler != source - summary['attachment_euler_characteristic']:
+        return None
+    return dict(histogram=[dict(genus=g, multiplicity=n) for g, n in sorted(histogram.items())],
+                components=sum(histogram.values()), ball_components=histogram[0],
+                all_balls=all(g == 0 for g in histogram), euler_characteristic=euler,
+                joined_components=joined, isolated_bundles=isolated, attachments=edges)
+
+
+def verify_normal_cut_handlebodies(triangulation, coordinates, certificate, *,
+                                  max_operations=None, check=lambda: None):
+    """Replay all six orbit proofs and the independent finite geometric checks."""
+    check()
+    if max_operations is not None and (type(max_operations) is not int or max_operations < 0):
+        raise ValueError('max_operations must be a nonnegative integer or None')
+    fields = {'schema', 'parallelity', 'boundary', 'core', 'census'}
+    if type(certificate) is not dict or set(certificate) != fields:
+        return False
+    if certificate['schema'] != 'normal-cut-handlebodies-v1':
+        return False
+    p, b = certificate['parallelity'], certificate['boundary']
+    if type(p) is not dict or type(b) is not dict:
+        return False
+    if max_operations is not None:
+        try:
+            operations = 0
+            for name in ('vertex_selector', 'boundary_selector', 'polygon_weights', 'fibre_cover'):
+                proof = p[name]
+                if name.endswith('selector'):
+                    proof = proof['weighted_certificate']
+                operations += len(proof['orbit_proof']['operations'])
+            for name in ('vertex_partition', 'gap_cover'):
+                if b[name] is not None:
+                    operations += len(b[name]['orbit_proof']['operations'])
+        except (KeyError, TypeError):
+            return False
+        if operations > max_operations:
+            return False
+    if not verify_normal_cut_parallelity(triangulation, coordinates, p, check=check):
+        return False
+    if not verify_parallelity_boundary_words(triangulation, coordinates, b, check=check):
+        return False
+    # Large source integers may use the established exact hexadecimal codec.
+    geometry, summary = _decode(p['geometry']), _decode(p['summary'])
+    skeleton = _decode(b['skeleton'])
+    if not verify_core_handlebody_certificate(geometry['core'], certificate['core'], check=check):
+        return False
+    expected = _recount(geometry, summary, skeleton, certificate['core']['components'], check)
+    check()
+    return expected is not None and certificate_equal(certificate['census'], expected)
