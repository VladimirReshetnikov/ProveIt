+    for position, generator in enumerate(word):
+        if check is not None and position % 1024 == 0:
+            check()
+        for token in _IMAGE[generator]:
+            token_operations += 1
+            if stack and (stack[-1] == 0) == (token == 0):
+                previous = stack.pop()
+                if token != 0:
+                    product = (previous + token) % 3
+                    if product:
