+                             (('seams', 0, 'right'), [1, 0])]:
+            bad = deepcopy(raw)
+            current = bad
+            for key in path[:-1]:
+                current = current[key]
+            current[path[-1]] = value
+            mutations.append(bad)
+        mutations.append({**raw, 'extra': 0})
+        bad = deepcopy(raw)
+        bad['seams'].append(deepcopy(bad['seams'][0]))
