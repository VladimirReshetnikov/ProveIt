+        self.assertIsNotNone(find_scalar_split(scan, list(range(scan.live)), primary=True)[0])
+
+    def test_real_diagrams_and_capped_contract(self):
+        for name in ('conway', 'kinoshita_terasaka', 'hard_unknot_8'):
