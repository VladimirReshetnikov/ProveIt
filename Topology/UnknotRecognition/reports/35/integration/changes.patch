+        for path, value in [(('sheets',), 0), (('sheets',), True),
+                             (('pieces',), []), (('seams', 0, 'direction'), 0),
+                             (('seams', 0, 'map', 'sign'), True),
+                             (('seams', 0, 'map', 'sign'), 1),
