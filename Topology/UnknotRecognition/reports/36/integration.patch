+                        arena.stats.get('lcs_endpoint_period_bits', 0), low.bit_length())
+                    arena.stats['lcs_endpoint_count_bits'] = max(
+                        arena.stats.get('lcs_endpoint_count_bits', 0), count.bit_length())
+                result = _small_overlaps(arena, x, y, q)
+                if good is not None:
+                    result.append(good)
+            arena.stats['lcs_endpoint_hits'] = arena.stats.get('lcs_endpoint_hits', 0)+1
+            arena.stats['lcs_endpoint_anchor_max'] = max(arena.stats.get('lcs_endpoint_anchor_max', 0), q)
+            direction = 'suffix_anchor' if from_y else 'prefix_anchor'
+            counter = 'lcs_endpoint_'+direction+'_hits'
+            arena.stats[counter] = arena.stats.get(counter, 0)+1
+            return result
+    return None
