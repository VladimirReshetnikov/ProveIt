+                elif passed == count-1:
+                    self.assertEqual(tests, 3)
+                self.assertLessEqual(tests, 4+2*(count-passed+1).bit_length())
+                self.assertLessEqual(arena.stats['lcs_endpoint_rank_nodes'], 2*height*tests)
