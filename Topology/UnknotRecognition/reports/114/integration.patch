diff --git a/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_basis.py b/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_basis.py
new file mode 100644
index 00000000..6085577f
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_basis.py
@@ -0,0 +1,100 @@
+"""Basis certificates for authenticated passive annuli after core cancellation.
+
+The source compiler supplies signed words.  No coordinate multiplicity or
+expanded substituted word is allocated.  The new terminal argument is Gordon's
+simultaneous primitive-multicurve theorem, conditional on the existing source
+geometry and geometric core certificate.
+"""
+
+from .compressed_words import CompressedLimit, WordArena
+from .cyclic_basis import concatenate, cyclic_basis_blocks
+from .signed_annulus_source import signed_annulus_source
+
+
+def compile_signed_quotient(arena, packet):
+    """Compile a column-private or row-leaf cancellation into a shared map.
+
+    The input packet is conditional on authenticated geometry and a complete
+    geometric core proof.  Extra algebraic checks here also protect standalone
+    experiments from a false triangular schedule.
+    """
+    rows = {r['two_handle']: r['word'] for r in packet['active']}
+    generators = sorted(g for c in packet['components'] for g in c['generators'])
+    surviving = sorted(g for c in packet['components']
+                       for g in c['surviving_generators'])
+    schedule = packet['cancellations']
+    if (len(rows) != len(packet['active']) or len(schedule) != len(rows) or
+            {r for r, _ in schedule} != set(rows) or
+            len({g for _, g in schedule}) != len(schedule) or
+            set(generators) != set(surviving) | {g for _, g in schedule} or
+            set(surviving) & {g for _, g in schedule}):
+        raise ValueError('invalid complete signed cancellation schedule')
+    images = {g: arena.letter(g) for g in surviving}
+    images.update({-g: arena.inverse(images[g]) for g in surviving})
+    if packet['method'] == 'leaf':
+        removed = set()
+        for row, g in schedule:
+            arena.tick()
+            word = rows[row]
+            if (sum(abs(x) == g for x in word) != 1 or
+                    any(abs(x) != g and abs(x) not in removed for x in word)):
+                raise ValueError('false source row-leaf schedule')
+            removed.add(g)
+            images[g] = images[-g] = 0
+    elif packet['method'] == 'column_leaf':
+        for row, g in reversed(schedule):
+            arena.tick()
+            word = rows[row]
+            positions = [i for i, letter in enumerate(word) if abs(letter) == g]
+            if len(positions) != 1:
+                raise ValueError('source donor does not have a unique pivot')
+            pos = positions[0]
+            donor = word[pos + 1:] + word[:pos]
+            if any(letter not in images for letter in donor):
+                raise ValueError('source dependencies are not triangular')
+            value = concatenate(arena, (images[letter] for letter in donor))
+            if word[pos] > 0:
+                value = arena.inverse(value)
+            images[g], images[-g] = value, arena.inverse(value)
+    else:
+        raise ValueError('unsupported signed cancellation method')
+    if set(images) != set(generators) | {-g for g in generators}:
+        raise ValueError('incomplete source quotient map')
+    roots = [concatenate(arena, (images[x] for x in row['word']))
+             for row in packet['passive']]
+    return roots
+
+
+def signed_annulus_basis(g, summary, skeleton, augmented, core_proof, *,
+                         max_nodes=1000000, max_work=10000000, check=lambda: None):
+    """Return (evidence, attachment owners, stats), or None on method refusal."""
+    packet = signed_annulus_source(g, summary, skeleton, augmented, core_proof,
+                                   check=check)
+    if packet is None:
+        return None
+    arena = WordArena(max_nodes=max_nodes, max_work=max_work, check=check)
+    try:
+        roots = compile_signed_quotient(arena, packet)
+        records, owners = [], {}
+        for component in packet['components']:
+            arena.tick()
+            slots = [i for i, row in enumerate(packet['passive'])
+                     if row['core_component'] == component['id']]
+            chosen = [roots[i] for i in slots]
+            result = cyclic_basis_blocks(arena, chosen, component['surviving_generators'])
+            if result['status'] != 'COMPLETE':
+                return None
+            records.append(dict(core_component=component['id'], slots=slots,
+                                basis=result['certificate']))
+            for i in slots:
+                owners[packet['passive'][i]['attachment']] = component['id']
+        certificate = dict(schema='signed-primitive-annuli-v1', source=packet,
+                           components=records)
+        stats = dict(arena.stats, grammar_nodes=len(arena.rules) - 1,
+                     source_letters=sum(len(r['word']) for r in packet['active'] +
+                                        packet['passive']),
+                     annuli=len(packet['passive']),
+                     nielsen_moves=sum(len(c['basis']['moves']) for c in records))
+        return certificate, owners, stats
+    except CompressedLimit:
+        return None
diff --git a/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_basis_verify.py b/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_basis_verify.py
new file mode 100644
index 00000000..1828ed5b
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_basis_verify.py
@@ -0,0 +1,118 @@
+"""Independent signed-source, quotient, and common-basis replay for annuli."""
+
+from .compressed_words import CompressedLimit, WordArena
+from .cyclic_basis_verify import verify_cyclic_basis
+from .signed_annulus_source_verify import verify_signed_annulus_source
+
+
+def _quotient_words(arena, packet):
+    """Independent source-recursion evaluation; do not import the producer."""
+    rows = {item['two_handle']: item['word'] for item in packet['active']}
+    moves = packet['cancellations']
+    if len(rows) != len(packet['active']) or len(moves) != len(rows):
+        return None
+    eliminated = [g for _, g in moves]
+    if len(set(eliminated)) != len(eliminated) or {r for r, _ in moves} != set(rows):
+        return None
+    alive = [g for c in packet['components'] for g in c['surviving_generators']]
+    all_labels = [g for c in packet['components'] for g in c['generators']]
+    if (len(set(all_labels)) != len(all_labels) or set(alive) & set(eliminated) or
+            set(all_labels) != set(alive) | set(eliminated)):
+        return None
+    substitution = {g: arena.letter(g) for g in alive}
+    if packet['method'] == 'leaf':
+        dead = set()
+        for row, g in moves:
+            word = rows[row]
+            if (sum(abs(x) == g for x in word) != 1 or
+                    any(abs(x) not in dead | {g} for x in word)):
+                return None
+            substitution[g] = 0
+            dead.add(g)
+    elif packet['method'] == 'column_leaf':
+        # A pivot may occur only in rows removed no later than its own row.
+        # Scan incidences once instead of scanning all rows for every pivot.
+        deleted_at = {r: i for i, (r, _) in enumerate(moves)}
+        pivot_at = {g: i for i, (_, g) in enumerate(moves)}
+        for row, word in rows.items():
+            arena.tick()
+            for letter in word:
+                arena.tick()
+                time = pivot_at.get(abs(letter))
+                if time is not None and deleted_at[row] > time:
+                    return None
+        for row, g in moves:
+            if sum(abs(x) == g for x in rows[row]) != 1:
+                return None
+        for row, g in moves[::-1]:
+            word = rows[row]
+            location = next(i for i, letter in enumerate(word) if abs(letter) == g)
+            letters = word[location + 1:] + word[:location]
+            if word[location] > 0:
+                letters = [-x for x in reversed(letters)]
+            value = 0
+            for letter in letters:
+                if abs(letter) not in substitution:
+                    return None
+                piece = substitution[abs(letter)]
+                if letter < 0:
+                    piece = arena.inverse(piece)
+                value = arena.concat(value, piece)
+            substitution[g] = value
+    else:
+        return None
+    roots = []
+    for record in packet['passive']:
+        value = 0
+        for letter in record['word']:
+            if abs(letter) not in substitution:
+                return None
+            piece = substitution[abs(letter)]
+            value = arena.concat(value, piece if letter > 0 else arena.inverse(piece))
+        roots.append(value)
+    return roots
+
+
+def replay_signed_annulus_basis(g, summary, skeleton, augmented, core_proof,
+                                certificate, *, max_nodes=1000000,
+                                max_work=10000000, check=lambda: None):
+    """Return the reconstructed attachment owners, or None on failed replay.
+
+    Source geometry, disk absorption, and the geometric core certificate must
+    already have been authenticated by the enclosing whole-cut verifier.
+    """
+    try:
+        if (type(certificate) is not dict or set(certificate) !=
+                {'schema', 'source', 'components'} or
+                certificate['schema'] != 'signed-primitive-annuli-v1' or
+                type(certificate['components']) is not list):
+            return None
+        packet = certificate['source']
+        if not verify_signed_annulus_source(g, summary, skeleton, augmented,
+                                            core_proof, packet, check=check):
+            return None
+        arena = WordArena(max_nodes=max_nodes, max_work=max_work, check=check)
+        roots = _quotient_words(arena, packet)
+        if roots is None or len(certificate['components']) != len(packet['components']):
+            return None
+        owners = {}
+        for component, proof in zip(packet['components'], certificate['components']):
+            if (type(proof) is not dict or set(proof) !=
+                    {'core_component', 'slots', 'basis'} or
+                    type(proof['core_component']) is not int or
+                    proof['core_component'] != component['id']):
+                return None
+            slots = [i for i, row in enumerate(packet['passive'])
+                     if row['core_component'] == component['id']]
+            if (type(proof['slots']) is not list or
+                    any(type(i) is not int for i in proof['slots']) or proof['slots'] != slots):
+                return None
+            if not verify_cyclic_basis(arena, [roots[i] for i in slots],
+                                        component['surviving_generators'], proof['basis']):
+                return None
+            for i in slots:
+                row = packet['passive'][i]
+                owners[row['attachment']] = component['id']
+        return owners
+    except (KeyError, TypeError, ValueError, IndexError, CompressedLimit):
+        return None
diff --git a/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_source.py b/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_source.py
new file mode 100644
index 00000000..8cd5c7b5
--- /dev/null
+++ b/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_source.py
@@ -0,0 +1,128 @@
+"""Signed source words for passive annuli on an authenticated handlebody core.
+
+This adapter makes no topological conclusion and does no word reduction.
+The enclosing caller must authenticate the parallelity geometry, boundary
+skeleton, disk absorption, and successful core proof.  In particular, signs
+come from oriented source face flags, not from endpoint order: a one-handle
+can have equal endpoints and still has two distinct oriented face flags.
+"""
+
+from .disk_bundle_absorption import source_core_circle
+from .integer_codec import certificate_equal
+
+
+def signed_annulus_source(g, summary, skeleton, augmented, core_proof, *,
+                          check=lambda: None):
+    """Return a raw signed source packet, or None for an unsupported input.
+
+    Letters are ``sign * (one_handle_id + 1)``.  A forest crossing contributes
+    the empty word.  Both active relators and passive annular curves retain
+    their cyclic starting point and orientation; no free or cyclic reduction
+    occurs here.  Only leaf and column-leaf core proofs are supported.  All
+    supplied inputs are conditional on the enclosing source authentication.
+    """
+    check()
+    if ((core_proof.get('schema'), core_proof.get('method')) not in (
+            ('normal-core-handlebody-v1', 'leaf'),
+            ('normal-core-handlebody-v2', 'column_leaf'))):
+        return None
+    core = g['core']
+    if core['handles3'] or augmented['handles3']:
+        return None
+    tree = set(core_proof['forest'])
+    owner = {v: c['id'] for c in core_proof['components']
+             for v in c['zero_handles']}
+    profiles = summary['base_profiles']
+    base_owner = {port: i for i, p in enumerate(profiles)
+                  for port in p['core_ports']}
+    for dimension in (0, 1, 3):
+        if not certificate_equal(augmented[f'handles{dimension}'],
+                                 core[f'handles{dimension}']):
+            return None
+    original_count = len(core['handles2'])
+    if not certificate_equal(augmented['handles2'][:original_count],
+                             core['handles2']):
+        return None
+
+    active = []
+    for row in core['handles2']:
+        check()
+        word = []
+        component = owner[row['cycle'][0]['handle']]
+        for flag in row['cycle']:
+            check()
+            if flag['dimension'] != 1:
+                if owner[flag['handle']] != component:
+                    return None
+                continue
+            h = core['handles1'][flag['handle']]
+            source = (h['tetrahedron'], h['face'])
+            target = (h['target_tetrahedron'], h['target_face'])
+            occurrence = (flag['tetrahedron'], flag['face'])
+            if source == target:
+                return None
+            if occurrence == source:
+                sign = 1
+            elif occurrence == target:
+                sign = -1
+            else:
+                return None
+            if h['id'] not in tree:
+                word.append(sign * (h['id'] + 1))
+        active.append(dict(two_handle=row['id'], core_component=component,
+                           word=word))
+
+    passive, added, absorbed = [], [], set()
+    for index, attachment in enumerate(skeleton['attachment_components']):
+        check()
+        if attachment['kind'] == 'interval':
+            continue
+        if attachment['kind'] != 'circle' or not attachment['word']:
+            return None
+        ports = [abs(x) - 1 for x in attachment['word']]
+        bases = {base_owner[p] for p in ports}
+        if len(bases) != 1:
+            return None
+        base = bases.pop()
+        profile = profiles[base]
+        components = set()
+        for p in ports:
+            port = g['ports'][p]
+            vertex = (port['core_handle'] if port['core_dimension'] == 0 else
+                      core['handles1'][port['core_handle']]['ends'][0])
+            components.add(owner[vertex])
+        if len(components) != 1:
+            return None
+        component = components.pop()
+        crossings, cycle = source_core_circle(g, attachment['word'], check=check)
+        word = [x['sign'] * (x['handle'] + 1) for x in crossings
+                if x['handle'] not in tree]
+        if (profile['euler_characteristic'], profile['boundary_components']) == (1, 1):
+            if (base in absorbed or profile['multiplicity'] != 1 or not profile['orientable'] or
+                    not profile['product'] or set(profile['core_ports']) != set(ports)):
+                return None
+            absorbed.add(base)
+            number = original_count + len(added)
+            added.append(dict(id=number, cycle=cycle))
+            active.append(dict(two_handle=number, core_component=component,
+                               word=word))
+        else:
+            if profile['multiplicity'] != 1 or profile['boundary_components'] < 1:
+                return None
+            passive.append(dict(attachment=index, base_profile=base,
+                                core_component=component, word=word))
+    if not certificate_equal(augmented['handles2'][original_count:], added):
+        return None
+
+    components = []
+    for c in core_proof['components']:
+        check()
+        generators = [h['id'] + 1 for h in core['handles1']
+                      if h['id'] not in tree and owner[h['ends'][0]] == c['id']]
+        components.append(dict(id=c['id'], generators=generators,
+                               surviving_generators=[h + 1 for h in
+                                                     c['remaining_one_handles']]))
+    return dict(schema='signed-core-annulus-source-v1',
+                method=core_proof['method'], forest=list(core_proof['forest']),
+                active=active, passive=passive, components=components,
+                cancellations=[[r, h + 1] for r, h in core_proof['cancellations']])
diff --git a/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_source_verify.py b/Topology/UnknotRecognition/fast/fastunknot/signed_annulus_source_verify.py
