# SPDX-License-Identifier: MIT-0

# --- LaTeX build products ---------------------------------------------------
# Rebuilt PDFs (synthesis/report.pdf, the archives' reports, the preprint) are
# tracked on purpose; only auxiliary files are ignored.  Log files are ignored
# only for LaTeX builds: the archives' recorded test/benchmark logs under
# reports/*/ and fast/results/benchmark.log are evidence and stay tracked.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex
*.synctex.gz
*.synctex(busy)
*.toc
*.vrb
*.xdv
*-blx.bib
*.dvi
missfont.log
synthesis/report.log
synthesis/build.log
docs/arXiv-2607.23350v1/*.log

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Archives supplied as inputs (their extracted contents are tracked) ------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# --- Editors and operating systems ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini
