# SPDX-License-Identifier: MIT-0

# --- LaTeX build products ---------------------------------------------------
# Rebuilt PDFs (synthesis/report.pdf, the archives' reports, the preprint) are
# tracked on purpose; only auxiliary files are ignored.  No *.log file is
# ignored: the archives' recorded test/benchmark logs, fast/results/benchmark.log
# and the LaTeX build logs are all tracked.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex
*.synctex.gz
*.synctex(busy)
*.toc
*.vrb
*.xdv
*-blx.bib
*.dvi

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Archives supplied as inputs (their extracted contents are tracked) ------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# --- Editors and operating systems ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini
