Leant (Haskell) - a GHCi-style REPL for Lean 4.  Type :help for help, :quit to exit.
λ> :synth (A × (B ⊕ C) → (A × B) ⊕ (A × C))
preparing synthesis environment (session imports + Lean)...
  it1  fun ⟨x, y⟩ => match y with | .inl z => .inl ⟨x, z⟩ | .inr w => .inr ⟨x, w⟩
λ> :synth ((A → B → C) → (A → B) → A → C)
  it1  fun f g x => f x (g x)
λ> :synth (((A → B) → A) → A)
  it1  Classical.byContradiction (fun k => k (fun f => absurd (fun _ => f (fun a => absurd (fun _ => a) k)) k))
λ> :synth (∀ a b : Type, a → b)
provably uninhabited — no closed term of this polymorphic type exists
λ> :synth (a → a → a)
  it1  fun _ x => x
  it2  fun x _ => x
λ> :synth (Nat → Nat)
  it1  Nat.succ
  it2  fun x => x
  it3  fun _ => Nat.zero
  it4  fun _ => Nat.succ Nat.zero
  it5  fun x => Nat.succ x
λ> :synth (∀ p q : Prop, (p ↔ q) → ¬p → ¬q)
  it1  fun _ _ ⟨_, f⟩ k x => k (f x)
λ> :synth (((A → B) → A) → (A → A))
  it1  fun _ x => x
λ> :quit
