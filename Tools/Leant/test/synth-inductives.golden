Leant (Haskell) - a GHCi-style REPL for Lean 4.  Type :help for help, :quit to exit.
λ> :synth Bool
preparing synthesis environment (session imports + Lean)...
  it1  .false
  it2  .true
λ> :synth Ordering
  it1  .lt
  it2  .eq
  it3  .gt
λ> :synth (∀ a : Type, Option a → a ⊕ Unit)
  it1  fun _ _ => .inr ⟨⟩
  it2  fun _ x => match x with | .none => .inr ⟨⟩ | .some y => .inl y
λ> :synth (∀ a b : Type, a → b → a × Option b)
  it1  fun _ _ x _ => ⟨x, .none⟩
  it2  fun _ _ x y => ⟨x, .some y⟩
λ> :synth (∀ a : Type, Option (Option a) → Option a)
  it1  fun _ _ => .none
  it2  fun _ x => match x with | .none => (.none) | .some y => y
λ> :synth (∀ e a b : Type, Except e a → (a → b) → Except e b)
  it1  fun _ _ _ x f => match x with | .error y => .error y | .ok z => .ok (f z)
λ> :synth (∀ p : Prop, Decidable p → Decidable (¬ p))
  it1  fun _ x => match x with | .isFalse k => .isTrue k | .isTrue y => .isFalse (fun k1 => k1 y)
λ> :synth (∀ a b : Type, Option a → b)
provably uninhabited — no closed term of this polymorphic type exists
λ> inductive Traffic | red | amber | green
λ> 
λ> :synth Traffic
  it1  .red
  it2  .amber
  it3  .green
λ> structure Pair (A B : Type) where
…>   fst : A
…>   snd : B
…> 
λ> :synth (∀ a b : Type, a → b → Pair a b)
  it1  fun _ _ x y => ⟨x, y⟩
λ> :synth (∀ a b : Type, Pair a b → a)
  it1  fun _ _ x => match x with | ⟨y, _⟩ => y
λ> :synth (∀ a b : Type, Pair a b → Empty)
provably uninhabited — no closed term of this polymorphic type exists
λ> :synth (∀ a : Type, (Bool → a) → a)
  it1  fun _ f => f (.false)
  it2  fun _ f => f (.true)
λ> :quit
