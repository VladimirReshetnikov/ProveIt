*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
venv/

# Logs and operating-system metadata
*.log
/tmp-pwsh-*.json
.DS_Store
Thumbs.db

